{
  "@context": "https://openvex.dev/ns/v0.2.0",
  "@id": "https://openvex.dev/docs/public/vex-report-updater-operator-trivy",
  "author": "Deckhouse <contact@deckhouse.io>",
  "version": 2,
  "statements": [
    {
      "vulnerability": {
        "@id": "https://nvd.nist.gov/vuln/detail/CVE-2026-54448",
        "description": "Trivy: Helm chart tar bomb causes OOM via unbounded io.ReadAll in parser",
        "name": "CVE-2026-54448",
        "aliases": [ "GHSA-q3fv-x8vg-qqm4", "GO-2026-5983" ]
      },
      "products": [
        {
          "@id": "pkg:golang/github.com/aquasecurity/trivy@v0.55.2"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_present",
      "impact_statement": "Trivy's custom Helm-chart (.tgz) tar unpacker reads entries via io.ReadAll with no size limit prior to 0.71.0, allowing a decompression-bomb DoS. Deckhouse Kubernetes Platform is not affected as operator-trivy report-updater only imports github.com/aquasecurity/trivy/pkg/fanal/types for shared type definitions - it never invokes Trivy's artifact/Helm-chart scanning or tar-unpacking code, so the vulnerable code path is not reachable from this binary.",
      "timestamp": "2026-08-13T00:00:00Z"
    },
    {
      "vulnerability": {
        "@id": "https://nvd.nist.gov/vuln/detail/CVE-2026-55092",
        "description": "Trivy: path traversal via a crafted vulnerability database or another OCI artifact",
        "name": "CVE-2026-55092"
      },
      "products": [
        {
          "@id": "pkg:golang/github.com/aquasecurity/trivy@v0.55.2"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_present",
      "impact_statement": "The defect lets a crafted vulnerability database, or another crafted OCI artifact, write files outside the directory that Trivy unpacks it into. It can only be triggered when Trivy downloads and unpacks such an artifact. The report-updater runs no scan and downloads no vulnerability database; it only rewrites the reports that the operator has already produced. Of Trivy it includes the report data types and nothing else, so the affected download code is not part of the image.",
      "timestamp": "2026-09-23T12:00:00Z"
    },
    {
      "vulnerability": {
        "@id": "https://nvd.nist.gov/vuln/detail/CVE-2026-63328",
        "description": "Trivy: path traversal in the plugin manager allows arbitrary file write",
        "name": "CVE-2026-63328"
      },
      "products": [
        {
          "@id": "pkg:golang/github.com/aquasecurity/trivy@v0.55.2"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_present",
      "impact_statement": "The defect lets a crafted Trivy plugin write files outside the directory it is installed into. It can only be triggered by installing a plugin. The report-updater has no command line interface and no plugin support; it only rewrites the reports that the operator has already produced. Of Trivy it includes the report data types and nothing else, so the affected plugin manager is not part of the image.",
      "timestamp": "2026-09-23T12:00:00Z"
    }
  ],
  "timestamp": "2026-08-13T00:00:00Z",
  "last_updated": "2026-09-23T12:00:00Z"
}
