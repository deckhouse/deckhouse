  "statements": [
    {
      "vulnerability": {
        "@id": "https://nvd.nist.gov/vuln/detail/CVE-2026-54448",
        "description": "Trivy: Helm chart tar bomb causes OOM via unbounded io.ReadAll in parser",
        "name": "CVE-2026-54448",
        "aliases": [
          "GHSA-q3fv-x8vg-qqm4",
          "GO-2026-5983"
        ]
      },
      "products": [
        {
          "@id": "pkg:golang/github.com/aquasecurity/trivy@v0.55.2"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_present",
      "impact_statement": "Trivy's custom Helm-chart (.tgz) tar unpacker reads entries via io.ReadAll with no size limit prior to 0.71.0, allowing a decompression-bomb DoS. Deckhouse Kubernetes Platform is not affected as operator-trivy report-updater only imports github.com/aquasecurity/trivy/pkg/fanal/types for shared type definitions - it never invokes Trivy's artifact/Helm-chart scanning or tar-unpacking code, so the vulnerable code path is not reachable from this binary.",
      "timestamp": "2026-08-13T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-27145",
        "description": "crypto/x509: Denial of Service via excessive processing of DNS SAN entries"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "crypto/x509: Denial of Service via excessive processing of DNS SAN entries. Образ report-updater собран с Go stdlib v1.25.8 (Deckhouse builder golang:1.25.8, GOTOOLCHAIN=local). Исправление требует bump Go toolchain выше версии builder; будет выполнено в рамках планового апгрейда builder-образа. В текущей конфигурации модуля входные данные для уязвимых путей stdlib ограничены доверенным control-plane/административными сценариями, что исключает практическую эксплуатацию со стороны недоверенного нарушителя.",
      "timestamp": "2026-09-07T12:00:00Z"
    },
