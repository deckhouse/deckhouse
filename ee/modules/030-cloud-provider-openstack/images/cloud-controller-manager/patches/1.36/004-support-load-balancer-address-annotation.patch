+func Test_getLoadBalancerIP(t *testing.T) {
+	tests := []struct {
+		name     string
+		service  *corev1.Service
+		expected string
+	}{
+		{
+			name: "returns Deckhouse annotation value",
+			service: &corev1.Service{
+				ObjectMeta: v1.ObjectMeta{
+					Annotations: map[string]string{
+						DeckhouseAnnotationLoadBalancerAddress: "203.0.113.10",
+					},
+				},
+			},
+			expected: "203.0.113.10",
+		},
+		{
+			name: "Deckhouse annotation takes precedence over spec loadBalancerIP",
+			service: &corev1.Service{
+				ObjectMeta: v1.ObjectMeta{
+					Annotations: map[string]string{
+						DeckhouseAnnotationLoadBalancerAddress: "203.0.113.10",
+					},
+				},
+				Spec: corev1.ServiceSpec{
+					LoadBalancerIP: "203.0.113.20",
+				},
+			},
+			expected: "203.0.113.10",
+		},
+		{
+			name: "falls back to spec loadBalancerIP",
+			service: &corev1.Service{
+				Spec: corev1.ServiceSpec{
+					LoadBalancerIP: "203.0.113.20",
+				},
+			},
+			expected: "203.0.113.20",
+		},
+		{
+			name: "empty Deckhouse annotation falls back to spec loadBalancerIP",
+			service: &corev1.Service{
+				ObjectMeta: v1.ObjectMeta{
+					Annotations: map[string]string{
+						DeckhouseAnnotationLoadBalancerAddress: "",
+					},
+				},
+				Spec: corev1.ServiceSpec{
+					LoadBalancerIP: "203.0.113.20",
+				},
+			},
+			expected: "203.0.113.20",
+		},
+		{
+			name: "ignores upstream load balancer address annotation",
+			service: &corev1.Service{
+				ObjectMeta: v1.ObjectMeta{
+					Annotations: map[string]string{
+						ServiceAnnotationLoadBalancerAddress: "203.0.113.10",
+					},
+				},
+			},
+			expected: "",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			assert.Equal(t, test.expected, getLoadBalancerIP(test.service))
+		})
+	}
+}
