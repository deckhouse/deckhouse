+// refresh fetches the vApp once and populates both indexes with every VM in it.
+//
+// Looking up one VM through FindVMByName/FindVMByUUID also downloads the whole
+// vApp. The cloud node controller initializes a burst of Nodes one by one, so
+// doing that lookup per Node turns one vApp download into N downloads while the
+// cache lock is held. Keep the lock (the VCD client is shared and mutable), but
+// use the data already returned by VCD to satisfy all VM lookups in the burst.
+func (vmic *VmInfoCache) refresh(captureTime time.Time) error {
+	if err := vmic.client.RefreshBearerToken(); err != nil {
+		return fmt.Errorf("error while obtaining access token: [%v]", err)
+	}
+	vdcManager, err := vcdsdk.NewVDCManager(vmic.client, vmic.client.ClusterOrgName, vmic.client.ClusterOVDCName)
+	if err != nil {
+		return fmt.Errorf("error creating VDCManager object: [%v]", err)
+	}
+	vms, err := vdcManager.FindAllVMsInVapp(vmic.clusterVAppName)
+	if err != nil {
+		return fmt.Errorf("unable to find VMs in vApp [%s]: [%v]", vmic.clusterVAppName, err)
+	}
+
+	nameMap := make(map[string]*VmInfo, len(vms))
+	uuidMap := make(map[string]*VmInfo, len(vms))
+	for _, vm := range vms {
+		vmInfo, err := vmic.vcdVMToVMInfo(vm, captureTime)
+		if err != nil {
+			return fmt.Errorf("unable to convert vm struct [%v] to vmInfo: [%v]", vm, err)
+		}
+		nameMap[vmInfo.Name] = vmInfo
+		vmUUID := normalizeUUID(vmInfo.UUID)
+		if vmUUID == "" {
+			vmUUID = normalizeUUID(vm.HREF)
+		}
+		if vmUUID != "" {
+			uuidMap[vmUUID] = vmInfo
+		}
+	}
+
+	vmic.nameMap = nameMap
+	vmic.uuidMap = uuidMap
+	return nil
+}
+
+func (vmic *VmInfoCache) vcdVMToVMInfo(vcdVM *types.Vm, captureTime time.Time) (*VmInfo, error) {
+	if vcdVM == nil {
+		return nil, fmt.Errorf("vm parameter should not be nil")
+	}
+
+	// Keep a govcd VM wrapper for InstanceShutdownByProviderID. The vApp
+	// response already contains the VM data and its HREF, so no per-VM GET is
+	// needed merely to build the cache entry.
+	vm := govcd.NewVM(&vmic.client.VCDClient.Client)
+	vm.VM = vcdVM
+	return vmic.vmToVMInfo(vm, captureTime)
+}
+
+var uuidPattern = regexp.MustCompile(`([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})`)
+
+// normalizeUUID extracts the bare UUID used as a cache key from any VCD ID form.
+func normalizeUUID(id string) string {
+	match := uuidPattern.FindStringSubmatch(strings.ToLower(id))
+	if len(match) > 1 {
+		return match[1]
+	}
+	return ""
+}
