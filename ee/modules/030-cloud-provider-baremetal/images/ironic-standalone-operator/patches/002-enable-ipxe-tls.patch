From 9fd5160f293001a6e318c161dcc980992735a34f Mon Sep 17 00:00:00 2001
From: Flant JSC <support@flant.com>
Date: Wed, 23 Sep 2026 12:30:00 +0300
Subject: [PATCH] Enable TLS iPXE firmware provisioning

Mount the Ironic TLS Secret at /certs/ipxe, expose the iPXE TLS port, and
make dnsmasq chain iPXE to HTTPS instead of the default HTTP image-server URL.
Project ca.crt into a separate volume for custom firmware download init
containers. Preserve custom init-container args while merging pod overrides.

---
diff --git a/pkg/ironic/containers.go b/pkg/ironic/containers.go
index 45490702a0..d50ef01950 100644
--- a/pkg/ironic/containers.go
+++ b/pkg/ironic/containers.go
@@ -33,9 +33,10 @@ const (
 	keepalivedUser  int64 = 65532
 	keepalivedGroup int64 = 65532
 
-	authDir   = "/auth"
-	certsDir  = "/certs"
-	sharedDir = "/shared"
+	authDir     = "/auth"
+	certsDir    = "/certs"
+	sharedDir   = "/shared"
+	ipxeTLSPort = 8084
 
 	metricsPort            = 9608
 	defaultMetricsBindAddr = "0.0.0.0"
@@ -121,6 +122,11 @@ func buildCommonEnvVars(ironic *metal3api.Ironic) []corev1.EnvVar {
 			},
 		}...)
 
+		// dnsmasq uses this URL when chaining from iPXE. Its image default is HTTP :6180.
+		result = appendStringEnv(result, "IRONIC_HTTP_URL", "https://$(PROVISIONING_IP):"+strconv.Itoa(ipxeTLSPort))
+		// dnsmasq copies the CA-enabled firmware from this shared directory into TFTP.
+		result = appendStringEnv(result, "IPXE_CUSTOM_FIRMWARE_DIR", sharedDir+"/custom_ipxe_firmware")
+
 		if !ironic.Spec.TLS.DisableVirtualMediaTLS {
 			result = append(result,
 				corev1.EnvVar{
@@ -554,6 +558,16 @@ func buildIronicVolumesAndMounts(resources Resources) (volumes []corev1.Volume,
 					},
 				},
 			},
+			corev1.Volume{
+				Name: "cert-ipxe-ca",
+				VolumeSource: corev1.VolumeSource{
+					Secret: &corev1.SecretVolumeSource{
+						SecretName:  resources.TLSSecret.Name,
+						DefaultMode: ptr.To(corev1.SecretVolumeSourceDefaultMode),
+						Items:       []corev1.KeyToPath{{Key: "ca.crt", Path: "ca.crt"}},
+					},
+				},
+			},
 		)
 		mounts = append(mounts,
 			corev1.VolumeMount{
@@ -571,6 +585,11 @@ func buildIronicVolumesAndMounts(resources Resources) (volumes []corev1.Volume,
 				},
 			)
 		}
+		mounts = append(mounts, corev1.VolumeMount{
+			Name:      "cert-ironic",
+			MountPath: certsDir + "/ipxe",
+			ReadOnly:  true,
+		})
 	}
 
 	if maybeVolume := volumeForSecretOrConfigMap(bmcCAVolumeName, resources.BMCCASecret, resources.BMCCAConfigMap); maybeVolume != nil {
@@ -633,6 +652,12 @@ func buildIronicHttpdPorts(ironic *metal3api.Ironic) (ironicPorts []corev1.Conta
 				HostPort:      ironic.Spec.Networking.ImageServerTLSPort,
 			})
 		}
+		httpdPorts = append(httpdPorts, corev1.ContainerPort{
+			Name:          "ipxe-tls",
+			Protocol:      corev1.ProtocolTCP,
+			ContainerPort: ipxeTLSPort,
+			HostPort:      ipxeTLSPort,
+		})
 	}
 
 	return ironicPorts, httpdPorts
diff --git a/pkg/ironic/utils.go b/pkg/ironic/utils.go
index 728bb6536e..5d98b5560b 100644
--- a/pkg/ironic/utils.go
+++ b/pkg/ironic/utils.go
@@ -75,6 +75,7 @@ func mergeContainers(target, source []corev1.Container) []corev1.Container {
 		dest.Name = src.Name
 		dest.Image = src.Image
 		dest.Command = src.Command
+		dest.Args = src.Args
 		dest.Ports = src.Ports
 		dest.Env = src.Env
 		dest.EnvFrom = src.EnvFrom
diff --git a/pkg/ironic/utils_test.go b/pkg/ironic/utils_test.go
index 27653c472b..1f828a1948 100644
--- a/pkg/ironic/utils_test.go
+++ b/pkg/ironic/utils_test.go
@@ -416,3 +416,38 @@ func TestApplyOverridesToPod(t *testing.T) {
 		})
 	}
 }
+
+func TestMergePodTemplatesPreservesInitContainerArgs(t *testing.T) {
+	target := corev1.PodTemplateSpec{}
+	source := corev1.PodTemplateSpec{
+		Spec: corev1.PodSpec{
+			InitContainers: []corev1.Container{{
+				Name:    "firmware-downloader",
+				Image:   "test-image",
+				Command: []string{"/bin/sh", "-c"},
+				Args:    []string{"download firmware"},
+			}},
+		},
+	}
+
+	mergePodTemplates(&target, source)
+
+	assert.Equal(t, []string{"download firmware"}, target.Spec.InitContainers[0].Args)
+}
+
+func TestTLSUsesHTTPSForIPXEBootScript(t *testing.T) {
+	ironic := &metal3api.Ironic{
+		Spec: metal3api.IronicSpec{
+			TLS: metal3api.TLS{CertificateName: "test-tls"},
+			Networking: metal3api.Networking{IPAddress: "192.0.2.10"},
+		},
+	}
+
+	env := map[string]string{}
+	for _, envVar := range buildCommonEnvVars(ironic) {
+		env[envVar.Name] = envVar.Value
+	}
+
+	assert.Equal(t, "https://$(PROVISIONING_IP):8084", env["IRONIC_HTTP_URL"])
+	assert.Equal(t, "/shared/custom_ipxe_firmware", env["IPXE_CUSTOM_FIRMWARE_DIR"])
+}
