      "matchFileNames": ["go_lib/controlplane/**", "ee/go_lib/controlplane/**"],
      "groupName": "go-lib-controlplane dependencies",
      "groupSlug": "go-lib-controlplane"
    },
    {
      "description": "Group go_lib/registry dependency updates",
      "matchFileNames": ["go_lib/registry/**", "ee/go_lib/registry/**"],
      "groupName": "go-lib-registry dependencies",
      "groupSlug": "go-lib-registry"
    },
    {
      "description": "Group helm_lib dependency updates",
      "matchFileNames": ["helm_lib/**", "ee/helm_lib/**"],
      "groupName": "helm-lib dependencies",
      "groupSlug": "helm-lib"
    },
    {
      "description": "Group openapi dependency updates",
