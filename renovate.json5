      "matchFileNames": ["**/modules/031-local-path-provisioner/**"],
      "groupName": "031-local-path-provisioner dependencies",
      "groupSlug": "031-local-path-provisioner"
    },
    {
      "description": "Group 035-cni-flannel dependency updates",
      "matchFileNames": ["**/modules/035-cni-flannel/**"],
      "groupName": "035-cni-flannel dependencies",
      "groupSlug": "035-cni-flannel"
    },
    {
