{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>p-tfprod/infra/renovate/presets//base.json5"
  ],
  "baseBranchPatterns": [
    "$default",
    "release-1.76",
    "release-1.77"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "autoApprove": true,
  "prConcurrentLimit": 1,
  "schedule": ["* 4 1-31/2 * *"],
  "packageRules": [
    {
      "description": "Skip version bumps for internal Go modules",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "github.com/deckhouse/deckhouse/go_lib/registry",
        "github.com/deckhouse/deckhouse/go_lib/registry-bundle"
      ],
      "enabled": false
    },
    {
      "description": "Group 000-common dependency updates",
      "matchFileNames": ["**/modules/000-common/**"],
      "groupName": "000-common dependencies",
      "groupSlug": "000-common"
    },
    {
      "description": "Group 002-deckhouse dependency updates",
      "matchFileNames": ["**/modules/002-deckhouse/**"],
      "groupName": "002-deckhouse dependencies",
      "groupSlug": "002-deckhouse"
    },
    {
      "description": "Group 007-registrypackages dependency updates",
      "matchFileNames": ["**/modules/007-registrypackages/**"],
      "groupName": "007-registrypackages dependencies",
      "groupSlug": "007-registrypackages"
    },
    {
      "description": "Group 015-admission-policy-engine dependency updates",
      "matchFileNames": ["**/modules/015-admission-policy-engine/**"],
      "groupName": "015-admission-policy-engine dependencies",
      "groupSlug": "015-admission-policy-engine"
    },
    {
      "description": "Group 021-cni-cilium dependency updates",
