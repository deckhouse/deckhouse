{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>p-tfprod/infra/renovate/presets//base.json5"
  ],
  "packageRules": [
    {
      "description": "Skip version bumps for internal Go modules in dependency lists",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/deckhouse/deckhouse/go_lib/registry",
        "github.com/deckhouse/deckhouse/go_lib/registry-bundle"
      ],
      "enabled": false
    }
  ]
}
