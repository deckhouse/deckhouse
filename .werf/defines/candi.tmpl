{{- define "git_without_install_dependencies" }}
{{- $config := printf "git:\n%s" . | fromYaml }}
{{- if $config.git }}
{{- $entries := list }}
{{- range $rawEntry := $config.git }}
{{- $entry := $rawEntry | toYaml | fromYaml }}
{{- if $entry.stageDependencies }}
{{- $dependencies := $entry.stageDependencies | toYaml | fromYaml }}
{{- $_ := unset $dependencies "install" }}
{{- if $dependencies }}
{{- $_ := set $entry "stageDependencies" $dependencies }}
{{- else }}
{{- $_ := unset $entry "stageDependencies" }}
{{- end }}
{{- end }}
{{- $entries = append $entries $entry }}
{{- end }}
{{- toYaml $entries }}
{{- end }}
{{- end }}

# render imports for candi images
# . is dict with next params
#   Env - werf env
{{- define "candi_generic_imports" }}
{{- $context := . -}}

- from: dev/candi
  add: /deckhouse
  to: /deckhouse
  before: setup
- from: dev-prebuild
  add: /deckhouse
  to: /deckhouse
  includePaths:
  - modules/*/openapi/config-values.yaml
  - modules/*/openapi/conversions/*.yaml
  - global-hooks/openapi/config-values.yaml
  - candi/terraform_versions.yml
  after: setup
- from: version-map-artifact
  add: /version_map_{{ $context.Env }}.yml
  to: /deckhouse/candi/version_map.yml
  before: setup
{{- end }}

# render shell scripts for preparing candi image
# . is dict with keys:
#   CI_COMMIT_TAG - CI_COMMIT_TAG env
{{- define "candi_prepare_with_shell" }}
{{- $context := . -}}

shell:
  install:
  - echo '{{- $context.CI_COMMIT_TAG }}' > /deckhouse/version
{{- end }}
