# render git imports include paths
{{- define "dev_prebuild_git_imports_include_paths" }}
- candi
- global-hooks
- shell_lib.sh
- shell_lib
- deckhouse-controller/crds/*.yaml
- jq_lib
- helm_lib
- python_lib
{{- end }}


#  render shell operator import
{{- define "dev_prebuild_git_shell_operator" }}
- url: {{ .SOURCE_REPO }}/flant/shell-operator
  tag: v1.4.10
  add: /frameworks/shell
  to: /deckhouse/shell-operator/frameworks/shell
{{- end }}

# render imports from images
# . is dict with keys:
#   Env - werf env
{{- define "dev_prebuild_images_imports" }}
{{- $context := . -}}

- from: deckhouse-controller-artifact
  add: /out
  to: /usr/bin
  after: install
  includePaths:
  - deckhouse-controller
  - caps-deckhouse-controller
- from: version-map-artifact
  add: /version_map_{{ $context.Env }}.yml
  to: /deckhouse/candi/version_map.yml
  after: setup
{{- end }}


#  render general part of setup script
# . is dict with keys:
#   Env - edition set up from ci
#   CI_COMMIT_TAG - CI_COMMIT_TAG env
{{- define "dev_prebuild_setup_script_general_part" }}
{{- $context := . -}}

# Add version info
cat <<"EOD" > /deckhouse/version
{{ $context.CI_COMMIT_TAG}}
EOD
# Add edition info
cat <<"EOD" > /deckhouse/edition
{{ $context.Env | default "unknown"}}
EOD
# Create symlink to grant entrypoint.sh write permission
ln -fs /tmp/values.yaml /deckhouse/modules/values.yaml
# Run deckhouse from dedicated user
chown deckhouse:deckhouse -R /deckhouse
{{- end }}

# render docker parameters for installer image
{{- define "dev_prebuild_docker_properties" }}
imageSpec:
  config:
    env: { "MODULES_DIR": "/deckhouse/modules", "GLOBAL_HOOKS_DIR": "/deckhouse/global-hooks", "PYTHONPATH": "/deckhouse/python_lib", "LC_ALL": "C" }
{{- end }}



# render deckhouse controller image
{{- define "dev_image" }}
image: dev
from: dev-prebuild
import:
- from: images-digests
  add: /images_digests.json
  to: /deckhouse/modules/images_digests.json
  after: setup
- from: images-digests
  add: /images_digests.json
  to: /deckhouse/modules/040-node-manager/images_digests.json
  after: setup
- from: minget-artifact
  add: /usr/bin/minget
  to: /deckhouse/candi/bashible/bootstrap/minget
  after: setup
git:
- add: /tools/mounts/mountdir
  to: /.kube
  owner: 64535
  group: 64535
- add: /tools/mounts/mountdir
  to: /certs
  owner: 64535
  group: 64535
- add: /tools/mounts/mountdir
  to: /deckhouse/downloaded
  owner: 64535
  group: 64535
{{- end }}

#  render create ln part of setup script
# . is dict with keys:
#   TF - $.TF
#   Editions - $.Editions
{{- define "dev_prebuild_setup_ln_node_manager" }}
{{- $context := . -}}
{{- $providers := list }}
{{- range $_, $edition := $context.Editions }}
  {{- if $edition.terraformProviders }}
    {{- range $_, $tfProvider := $edition.terraformProviders }}
      {{- $tf := index $context.TF $tfProvider }}
        {{- $cloudName := lower $tf.cloudName }}
        {{- $providers = append $providers (dict "dir" (printf "030-cloud-provider-%s" $cloudName) "provider" $cloudName) }}
    {{- end }}
  {{- end }}
{{- end }}
{{- $providers = append $providers (dict "dir" "030-cloud-provider-yandex" "provider" "yandex") }}
{{- $providers = append $providers (dict "dir" "030-cloud-provider-dvp" "provider" "dvp") }}
{{- $providers = append $providers (dict "dir" "030-cloud-provider-zvirt" "provider" "zvirt") }}
{{- $providers = append $providers (dict "dir" "030-infra-provider-baremetal" "provider" "baremetal") }}
rm /deckhouse/modules/040-node-manager/capi/* /deckhouse/modules/040-node-manager/cloud-providers/*
{{- range $_, $item := $providers }}
{{- $dir := index $item "dir" }}
{{- $provider := index $item "provider" }}
if [ -d /deckhouse/modules/{{ $dir }}/capi ]; then
  ln -s /deckhouse/modules/{{ $dir }}/capi /deckhouse/modules/040-node-manager/capi/{{ $provider }}
  fi
if [ -d /deckhouse/modules/{{ $dir }}/cloud-instance-manager ]; then
  ln -s /deckhouse/modules/{{ $dir }}/cloud-instance-manager/ /deckhouse/modules/040-node-manager/cloud-providers/{{ $provider }}
  fi
{{- end }}
{{- end }}
