{% unless site.d8Revision == 'CSE' %}
{% comment %}
This partial is included onto the module page in the custom_hooks.rb.
It shows the list of extensions the module is included in (with or without restrictions).
Data: _data/modules/embedded_modules_extensions.json; titles: _data/site-helpers.yaml (docs/site/backends/docs-builder-template/data/helpers.yaml).
{% endcomment %}
{%- assign moduleKebabName = page['module-kebab-name'] %}
{%- assign extensionsInfo = site.data.modules.embedded_modules_extensions[moduleKebabName] %}
{%- assign extensionsDict = site.data['site-helpers'].extensions %}

{%- if extensionsInfo and extensionsInfo.extensions and extensionsInfo.extensions.size > 0 and extensionsDict %}
{%- assign extensionsWithRestrictions = extensionsInfo.extensionsWithRestrictions %}
{%- assign extensionsComments = extensionsInfo.extensionsWithRestrictionsComments %}
{%- assign extensionsWithoutRestrictions = "#" | split: "#" %}
{%- for extension in extensionsInfo.extensions %}
  {%- if extensionsWithRestrictions contains extension %}{% continue %}{% endif %}
  {%- assign extensionsWithoutRestrictions = extensionsWithoutRestrictions | push: extension %}
{%- endfor %}
<div class="info alert__wrap">
  <svg class="alert__icon icon--info">
    <use xlink:href="/images/sprite.svg#info-icon"></use>
  </svg>
  <div markdown="0">
{%- if extensionsWithRestrictions and extensionsWithRestrictions.size > 0 %}
<p>
{%- if extensionsComments['all'] -%}
  <span data-tippy-content='{{ extensionsComments['all'][page.lang] }}' class='alert__info'>
    {{- site.data.i18n.common['module_available_extensions_with_limitations_prefix'][page.lang] -}}
  </span>: 
{%- else -%}
  {{- site.data.i18n.common['module_available_extensions_with_limitations_prefix'][page.lang] }}: 
{%- endif -%}
<strong>
{%- for extension in extensionsWithRestrictions %}
  {%- assign extensionTitle = extensionsDict[extension].title[page.lang] | default: extensionsDict[extension].title.en | default: extension %}
  {%- if extensionsComments[extension] -%}
    <span data-tippy-content='{{ extensionsComments[extension][page.lang] }}' class='alert__info'>{{ extensionTitle }}</span>
  {%- else -%}
    {{ extensionTitle }}
  {%- endif -%}
  {%- unless forloop.last %}, {% endunless %}
{%- endfor %}
</strong>
</p>
  {%- if extensionsWithoutRestrictions.size > 0 %}
  <p>
    {{- site.data.i18n.common['module_available_extensions_without_limitations_prefix'][page.lang] }}: 
    <strong>
    {%- for extension in extensionsWithoutRestrictions %}
      {%- assign extensionTitle = extensionsDict[extension].title[page.lang] | default: extensionsDict[extension].title.en | default: extension %}
      {{ extensionTitle }}
      {%- unless forloop.last %}, {% endunless %}
    {%- endfor %}
    </strong>
  </p>
  {%- endif %}
{%- else %}
  <p>{{ site.data.i18n.common['module_available_extensions_prefix'][page.lang] }}:
  <strong>
  {%- for extension in extensionsWithoutRestrictions %}
    {%- assign extensionTitle = extensionsDict[extension].title[page.lang] | default: extensionsDict[extension].title.en | default: extension %}
    {{ extensionTitle }}
    {%- unless forloop.last %}, {% endunless %}
  {%- endfor %}
  </strong>
  </p>
{%- endif %}
</div>
</div>
{%- endif %}
{%- endunless %}
