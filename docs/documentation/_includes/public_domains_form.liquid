{%- assign i18n = site.data.i18n.common %}
{%- assign domains = site.data.reference.public-domains %}
{%- assign public_domain_template_pattern = site.data.schemas.modules.global.config-values.properties.modules.properties.publicDomainTemplate.pattern %}
<div markdown="0" class="form">
<div class="form__row">
  <label class="label" for="public-domain-template-input">{{ i18n.public_domains_form_template_label[page.lang] }}</label>
  <input id="public-domain-template-input" class="textfield" type="text"
         placeholder="{{ i18n.public_domains_form_placeholder[page.lang] }}" autocomplete="off" />
  <span class="info invalid-message invalid-message-template">{{ i18n.public_domains_form_invalid[page.lang] }}</span>
</div>
<div class="form__row">
  <label class="label" for="public-ip-input">{{ i18n.public_domains_form_ip_label[page.lang] }}</label>
  <input id="public-ip-input" class="textfield" type="text"
         placeholder="{{ i18n.public_domains_form_ip_placeholder[page.lang] }}" autocomplete="off" />
  <span class="info invalid-message invalid-message-ip">{{ i18n.public_domains_form_ip_invalid[page.lang] }}</span>
</div>
<div class="form__row">
  <button id="generate-hosts-button" class="button button_alt button_disabled" type="button" disabled>{{ i18n.public_domains_form_generate[page.lang] }}</button>
</div>

{%- comment -%}
The <pre> blocks are initialized by the site-wide codeblock.js on DOMContentLoaded (line numbers, wrap and copy buttons),
so the generated lines must follow its markup: span.line > span.line-number[data-copy="ignore"] + span.cl.
{%- endcomment %}
<div id="hosts-output" style="display: none; margin-top: 16px;">
{% tabs public_domains_hosts %}
{% tab "Linux / macOS" %}
<p>{{ i18n.public_domains_form_hosts_intro_unix[page.lang] }}</p>
<div class="highlight"><pre class="highlight"><code id="hosts-output-code-unix"></code></pre></div>
{% endtab %}
{% tab "Windows" %}
<p>{{ i18n.public_domains_form_hosts_intro_windows[page.lang] }}</p>
<div class="highlight"><pre class="highlight"><code id="hosts-output-code-windows"></code></pre></div>
{% endtab %}
{% endtabs %}
</div>

<script type="text/javascript">
(function () {
  var publicDomains = [{% for domain in domains %}"{{ domain.name }}"{% unless forloop.last %}, {% endunless %}{% endfor %}];
  // The pattern is taken from the global ModuleConfig OpenAPI schema (modules.publicDomainTemplate).
  var templatePattern = new RegExp({{ public_domain_template_pattern | jsonify }});

  // IPv4: four decimal octets. IPv6: hex groups with optional :: compression; an IPv4-mapped tail is normalized in isValidIp.
  var ipv4Pattern = /^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$/;
  var ipv6Pattern = /^(([0-9a-f]{1,4}:){7}[0-9a-f]{1,4}|([0-9a-f]{1,4}:){1,7}:|([0-9a-f]{1,4}:){1,6}:[0-9a-f]{1,4}|([0-9a-f]{1,4}:){1,5}(:[0-9a-f]{1,4}){1,2}|([0-9a-f]{1,4}:){1,4}(:[0-9a-f]{1,4}){1,3}|([0-9a-f]{1,4}:){1,3}(:[0-9a-f]{1,4}){1,4}|([0-9a-f]{1,4}:){1,2}(:[0-9a-f]{1,4}){1,5}|[0-9a-f]{1,4}:(:[0-9a-f]{1,4}){1,6}|:((:[0-9a-f]{1,4}){1,7}|:))$/i;

  var input = document.getElementById('public-domain-template-input');
  var ipInput = document.getElementById('public-ip-input');
  var button = document.getElementById('generate-hosts-button');
  var invalidMessage = input.parentElement.querySelector('.invalid-message-template');
  var ipInvalidMessage = ipInput.parentElement.querySelector('.invalid-message-ip');
  var output = document.getElementById('hosts-output');
  var outputCodeUnix = document.getElementById('hosts-output-code-unix');
  var outputCodeWindows = document.getElementById('hosts-output-code-windows');

  function isValidIp(value) {
    if (ipv4Pattern.test(value)) {
      return true;
    }
    var mapped = value.match(/^(.*:)(\d{1,3}(\.\d{1,3}){3})$/);
    if (mapped) {
      if (!ipv4Pattern.test(mapped[2])) {
        return false;
      }
      value = mapped[1] + '0:0';
    }
    return ipv6Pattern.test(value);
  }

  // The message is shown until the field contains a valid value (an empty field is invalid too);
  // the red border is applied only to non-empty invalid input.
  function validateField(field, message, isValid) {
    var value = field.value.trim();
    var valid = value.length > 0 && isValid(value);
    field.classList.toggle('invalid', value.length > 0 && !valid);
    message.classList.toggle('active', !valid);
    return valid;
  }

  // The schema pattern also accepts a bare template without a domain part (for example, "%s");
  // such a template is useless for DNS records, so at least one domain label after the template part is required.
  function isValidTemplate(value) {
    return templatePattern.test(value) && value.indexOf('.') !== -1;
  }

  function validate() {
    var templateValid = validateField(input, invalidMessage, isValidTemplate);
    var ipValid = validateField(ipInput, ipInvalidMessage, isValidIp);
    var ready = templateValid && ipValid;
    // .button_alt has no :disabled style on the site, so the visual state is carried by .button_disabled.
    button.disabled = !ready;
    button.classList.toggle('button_disabled', !ready);
  }

  function createLine(index, text) {
    var line = document.createElement('span');
    line.classList.add('line');

    var lineNumber = document.createElement('span');
    lineNumber.setAttribute('data-copy', 'ignore');
    lineNumber.classList.add('line-number');
    lineNumber.textContent = String(index);

    var content = document.createElement('span');
    content.classList.add('cl');
    content.textContent = text;

    line.appendChild(lineNumber);
    line.appendChild(content);
    return line;
  }

  function renderLines(code, lines) {
    code.innerHTML = '';
    lines.forEach(function (text, index) {
      if (index > 0) {
        code.appendChild(document.createTextNode('\n'));
      }
      code.appendChild(createLine(index + 1, text));
    });
  }

  function render() {
    var template = input.value.trim();
    var ip = ipInput.value.trim();
    if (!isValidTemplate(template) || !isValidIp(ip)) {
      return;
    }

    var entries = publicDomains.map(function (name) {
      return ip + ' ' + template.replace('%s', name);
    });

    renderLines(outputCodeUnix, ['sudo bash -c "cat <<EOF >> /etc/hosts'].concat(entries, ['EOF', '"']));
    renderLines(outputCodeWindows, ['Add-Content -Path "$env:SystemRoot\\System32\\drivers\\etc\\hosts" -Value @"'].concat(entries, ['"@']));
    output.style.display = '';
  }

  function renderOnEnter(event) {
    if (event.key === 'Enter' && !button.disabled) {
      event.preventDefault();
      render();
    }
  }

  input.addEventListener('input', validate);
  ipInput.addEventListener('input', validate);
  input.addEventListener('keydown', renderOnEnter);
  ipInput.addEventListener('keydown', renderOnEnter);
  button.addEventListener('click', render);
  validate();
})();
</script>
</div>
