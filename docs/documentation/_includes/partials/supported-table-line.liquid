{%- assign osVersions = include.osVersions | default: osItem[1] %}
{%- assign commonVersions = "" | split: "," %}
{%- assign cseOnlyVersions = "" | split: "," %}
{%- assign ceOnlyVersions = "" | split: "," %}
{%- assign bePlusVersions = "" | split: "," %}
{%- assign otherVersions = "" | split: "," %}

{%- for versionItem in osVersions %}
  {%- assign editions = versionItem.editions %}
  {%- if page.lang == 'en' %}
    {%- assign commonVersions = commonVersions | push: versionItem %}
  {%- elsif editions contains 'ce' and editions contains 'cse' %}
    {%- assign commonVersions = commonVersions | push: versionItem %}
  {%- elsif editions contains 'ce' %}
    {%- assign ceOnlyVersions = ceOnlyVersions | push: versionItem %}
  {%- elsif editions contains 'cse' %}
    {%- assign cseOnlyVersions = cseOnlyVersions | push: versionItem %}
  {%- elsif editions contains 'be' or editions contains 'se' or editions contains 'se-plus' or editions contains 'ee' %}
    {%- assign bePlusVersions = bePlusVersions | push: versionItem %}
  {%- else %}
    {%- assign otherVersions = otherVersions | push: versionItem %}
  {%- endif %}
{%- endfor %}

{%- assign supportGroups = "" | split: "," | push: commonVersions | push: cseOnlyVersions | push: ceOnlyVersions | push: bePlusVersions | push: otherVersions %}
{%- assign rows = "" | split: "," %}
{%- for groupVersions in supportGroups %}
  {%- assign versionsWithoutNotes = "" | split: "," %}
  {%- for versionItem in groupVersions %}
    {%- unless versionItem.note_content %}
      {%- assign versionsWithoutNotes = versionsWithoutNotes | push: versionItem %}
    {%- endunless %}
  {%- endfor %}

  {%- assign versionsWithoutNotesAdded = false %}
  {%- for versionItem in groupVersions %}
    {%- if versionItem.note_content %}
      {%- assign rowVersions = "" | split: "," | push: versionItem %}
      {%- assign rows = rows | push: rowVersions %}
    {%- elsif versionsWithoutNotesAdded == false %}
      {%- assign rows = rows | push: versionsWithoutNotes %}
      {%- assign versionsWithoutNotesAdded = true %}
    {%- endif %}
  {%- endfor %}
{%- endfor %}

{%- for rowVersions in rows %}
{%- assign firstVersion = rowVersions | first %}
{%- assign editions = firstVersion.editions %}
<tr>
  {%- if forloop.first %}
  <td class="name" {% if rows.size > 1 %}rowspan="{{ rows.size }}"{% endif %}>
    <span>
      {%- if site.data.supported_versions.osDistributions[osKey].url %}
        <a href="{{ site.data.supported_versions.osDistributions[osKey].url }}" target="_blank">{{ osName }}</a>
      {%- else %}{{ osName }}
      {%- endif %}
    </span>
  </td>
  {%- endif %}
  <td class="versions">
    {%- for versionItem in rowVersions %}
    {{ versionItem.version }}{%- unless forloop.last %},{% endunless %}
    {%- endfor %}
  </td>
  {%- if page.lang == 'ru' %}
  <td>
    <div class="icon">
      {%- if editions contains 'ce' %}
      <span>{{ include.supported_img_inline }}</span>
      {%- elsif editions contains 'cse' or editions contains 'be' or editions contains 'se' or editions contains 'se-plus' or editions contains 'ee' %}
      <span data-tippy-content="Работоспособность в Community Edition не гарантируется.">{{ include.partially_supported_img_inline }}</span>
      {%- elsif site.data.supported_versions.osDistributions[osKey]['ru_support'] == true %}
      <span data-tippy-content="Работоспособность в Community Edition не гарантируется.">{{ include.partially_supported_img_inline }}</span>
      {%- else %}
      <span>{{ include.supported_img_inline }}</span>
      {%- endif %}
    </div>
  </td>
  <td>
    <div class="icon">
      {%- if editions contains 'cse' %}
      <span>{{ include.supported_img_inline }}</span>
      {%- else %}
      <span>{{ include.not_supported_img_inline }}</span>
      {%- endif %}
    </div>
  </td>
  <td><div class="icon"><span>{{ include.supported_img_inline }}</span></div></td>
  {%- else %}
  <td style="text-align: center; width: 170px;">
    <div class="icon">
      <span>{{ include.supported_img_inline }}</span>
    </div>
  </td>
  {%- endif %}
  <td style="text-align: center;">
    <div class="icon">
      {%- assign notesContent = firstVersion.note_content[page.lang] | strip %}
      {%- if notesContent != "" %}
      <span data-tippy-content="{{ notesContent | escape }}">{{ include.notes_img_inline }}</span>
      {%- endif %}
    </div>
  </td>
</tr>
{%- endfor %}
