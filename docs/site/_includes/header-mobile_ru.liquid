      <a data-open-modal="request_callback" href="#" class="header__btn header__btn--primary">{{ site.data.i18n.common['contact_us_button'][page.lang] }}</a>
      <a href="/docs/" class="header__btn header__btn--ghost">{{ site.data.i18n.common['documentation'][page.lang] }}</a>
