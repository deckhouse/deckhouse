{
  "ce": {
    "name": "Open/CE",
    "versionMapFile": "candi/version_map.yml",
    "modulesDir": "modules",
    "terraformProviders": [
      "aws",
      "azure",
      "gcp",
      "yandex"
    ],
    "skipFixingImports": true,
    "buildIncludes": {
      "skipCandi": true
    },
    "title": "Open/Community Edition"
  },
  "be": {
    "name": "BE",
    "modulesDir": "ee/be/modules",
    "excludeModules": [
      "sds-replicated-volume",
      "sds-node-configurator",
      "sds-local-volume",
      "virtualization",
      "csi-ceph",
      "csi-nfs"
    ],
    "title": "Basic Edition"
  },
  "se": {
    "name": "SE",
    "modulesDir": "ee/se/modules",
    "excludeModules": [
      "dashboard"
    ],
    "title": "Standard Edition"
  },
  "se-plus": {
    "name": "SE+",
    "modulesDir": "ee/se-plus/modules",
    "terraformProviders": [
      "vsphere",
      "ovirt"
    ],
    "excludeModules": [
      "cloud-provider-dynamix",
      "cloud-provider-openstack",
      "cloud-provider-vcd",
      "dashboard",
      "keepalived",
      "network-gateway",
      "operator-trivy",
      "runtime-audit-engine",
      "static-routing-manager"
    ],
    "title": "Standard Edition+",
    "includeModules": [
      "cloud-provider-vsphere",
      "cloud-provider-zvirt"
    ]
  },
  "ee": {
    "name": "Ultimate/EE",
    "versionMapFile": "ee/candi/version_map.yml",
