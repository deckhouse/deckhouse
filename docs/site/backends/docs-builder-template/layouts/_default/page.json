{{- if and (eq .Section "search") (eq .Type "search") -}}
{{- $modulesData := hugo.Data.modules_all -}}
{{- $currentLang := site.Language.Lang -}}
{"documents": [
    {{- $modulesStablestList := partial "get-stablest-modules-list.html" . }}
    {{- $first := true -}}
    {{- range $modulesStablestList }}
      {{- $moduleName := index . "name" }}
      {{- $moduleChannel := index . "channel" }}
      {{- $moduleData := index $modulesData $moduleName -}}
      {{- $moduleSection := printf "modules/%s/%s" $moduleName $moduleChannel }}
      {{- range $.Site.Pages }}
        {{- $relPermalinkWithoutLang := replaceRE `/(ru/|en/)` "/" .RelPermalink }}
        {{- if and (hasPrefix $relPermalinkWithoutLang (printf "/%s/" $moduleSection)) (eq .Section "modules") (ne .Kind "section") (ne .Kind "home") (not (hasSuffix $relPermalinkWithoutLang "/configuration.html")) (not (hasSuffix $relPermalinkWithoutLang "/cr.html")) }}
          {{- if .File }}
            {{- if not $first -}},{{- end -}}
            {{- $first = false -}}
            { "title": {{ .Title | jsonify }},
              "url": {{ $relPermalinkWithoutLang | replaceRE "/(readme.html?|index.html?)$" "/" |jsonify }},
              {{- $keywords := slice -}}
              {{- if and $moduleData $moduleData.tags -}}
                {{- $keywords = $keywords | append $moduleData.tags -}}
              {{- end -}}
              {{- if .Params.search -}}
                {{- $keywords = $keywords | append (split .Params.search ",") -}}
              {{- end -}}
              {{- if gt (len $keywords) 0 -}}
              "keywords": {{ $keywords | jsonify }},
              {{- end -}}
              {{- with .Params.searchBoost -}}
              "searchBoost": {{ . | jsonify }},
              {{- end -}}
              "module": {{ $moduleName | jsonify }},
              "moduletype": "source",
              "summary": {{ if .Summary }}{{ .Summary | plainify | jsonify }}{{ else if .Description }}{{ .Description | plainify | jsonify }}{{ else }}""{{ end }},
              "content": {{ .Content | plainify | jsonify }}
            }
          {{- end }}
        {{- end }}
      {{- end }}
    {{- end -}}
  ],
  "parameters": [
  {{- $modulesStablestList := partial "get-stablest-modules-list.html" . }}
  {{- $allParameters := slice }}
  {{- range $modulesStablestList }}
    {{- $moduleName := index . "name" }}
    {{- $moduleChannel := index . "channel" }}
    {{- $moduleData := index (index hugo.Data.modules $moduleName) $moduleChannel }}
    {{- if not $moduleData }}
      {{- continue -}}
    {{- end }}
    {{- $moduleParams := partial "openapi/module-search-index.json" (dict "name" $moduleName "channel" $moduleChannel "data" $moduleData "lang" $.Lang "firstModule" false) }}
    {{- if $moduleParams }}
      {{- $allParameters = $allParameters | append $moduleParams }}
    {{- end }}
  {{- end -}}
  {{- $first := true }}
  {{- range $allParameters }}
    {{- if not $first }},{{- end }}
    {{- $first = false }}
    {{ . | jsonify }}
  {{- end -}}
  ]
}
{{- else if eq .Type "ai" -}}
{{- /*
  Manifest of the AI export, consumed by `internal/aiexport` of docs-builder:
  it renders no content itself, it only tells the Go side which HTML files to
  convert to Markdown and what metadata to attach to them. Unlike the search
  index above, `configuration.html` and `cr.html` are included — for an agent
  they are the most valuable reference pages a module has.
*/ -}}
{{- $modulesData := hugo.Data.modules_all -}}
{{- $documents := slice -}}
{{- range partial "get-stablest-modules-list.html" . -}}
  {{- $moduleName := .name -}}
  {{- $moduleChannel := .channel -}}
  {{- $moduleVersion := .version -}}
  {{- $moduleData := index $modulesData $moduleName -}}

  {{- $editions := slice -}}
  {{- $tags := slice -}}
  {{- with $moduleData -}}
    {{- with .editions }}{{ $editions = . }}{{ end -}}
    {{- with .tags }}{{ $tags = . }}{{ end -}}
  {{- end -}}

  {{- $stage := "" -}}
  {{- with index hugo.Data.modules $moduleName -}}
    {{- with index . $moduleChannel -}}
      {{- with index . "module" -}}
        {{- with .stage }}{{ $stage = . }}{{ end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- $moduleSection := printf "/modules/%s/%s/" $moduleName $moduleChannel -}}
  {{- range $.Site.Pages -}}
    {{- $url := replaceRE `^/(ru|en)/` "/" .RelPermalink -}}
    {{- if and .File (eq .Section "modules") (ne .Kind "section") (ne .Kind "home") (hasPrefix $url $moduleSection) -}}
      {{- /* `plainify` drops the tags but leaves the entities behind, and
             `&rsquo;` in a description helps nobody. */ -}}
      {{- $description := "" -}}
      {{- with .Description -}}
        {{- $description = . | plainify | htmlUnescape -}}
      {{- else -}}
        {{- with .Summary }}{{ $description = . | plainify | htmlUnescape | truncate 200 "" }}{{ end -}}
      {{- end -}}

      {{- $keywords := slice -}}
      {{- range (split (default "" .Params.search) ",") -}}
        {{- with trim . " " }}{{ $keywords = $keywords | append . }}{{ end -}}
      {{- end -}}

      {{- /* Every language is published under its own baseURL, so RelPermalink
             carries no language prefix — but on disk the page always lands in
             `public/<lang>/`, which is what the exporter reads. */ -}}
      {{- $documents = $documents | append (dict
          "title" .Title
          "url" $url
          "htmlPath" (path.Join "/" site.Language.Lang $url)
          "module" $moduleName
          "channel" $moduleChannel
          "version" $moduleVersion
          "description" (chomp $description)
          "keywords" $keywords
          "tags" $tags
          "editions" $editions
          "stage" $stage
          "searchBoost" (default 0 .Params.searchBoost)
        ) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- dict
    "version" 1
    "productCode" "external-modules"
    "generator" "hugo"
    "lang" site.Language.Lang
    "baseUrl" site.BaseURL
    "title" site.Title
    "description" (default "" site.Params.description)
    "documents" $documents
  | jsonify -}}
{{- else -}}
{}
{{- end -}}
