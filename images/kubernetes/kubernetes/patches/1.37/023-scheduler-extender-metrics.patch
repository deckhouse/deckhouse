+package scheduler
+
+// Deckhouse: metrics of HTTP extenders. Upstream has none: a slow or failing
+// extender is visible only as a longer scheduling cycle.
+
+import (
+	"net/http/httptrace"
+	"strconv"
+	"sync/atomic"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	extenderv1 "k8s.io/kube-scheduler/extender/v1"
+	schedulerapi "k8s.io/kubernetes/pkg/scheduler/apis/config"
+	"k8s.io/kubernetes/pkg/scheduler/metrics"
+)
+
+// deckhouseRecordExtenderInfo publishes the configuration of an extender as
+// scheduler_extender_info: its name and URL prefix. Tests create extenders
+// without registered metrics.
+func deckhouseRecordExtenderInfo(config *schedulerapi.Extender) {
+	if metrics.ExtenderInfo == nil {
+		return
+	}
+	metrics.ExtenderInfo.WithLabelValues(
+		deckhouseExtenderName(config.URLPrefix),
+		config.URLPrefix,
+		config.FilterVerb,
+		config.PrioritizeVerb,
+		config.PreemptVerb,
+		config.BindVerb,
+		strconv.FormatInt(config.Weight, 10),
+		strconv.FormatBool(config.Ignorable),
+	).Set(1)
+}
+
+// deckhouseIsSimulation reports whether the Pod is a copy made by the
+// simulate endpoint: its extender requests are not recorded.
+func deckhouseIsSimulation(pod *v1.Pod) bool {
+	return pod != nil && pod.Annotations[DeckhouseSimulationAnnotation] == "true"
+}
+
+// requestPhases splits a request with an answer into encode (json.Marshal), conn (waiting for a
+// connection or an HTTP/2 stream), write (the request on the wire), wait (until the first byte of
+// the response: the network, the extender and waking up the transport's reader) and read (the
+// headers, the body and json decoding). The marks are monotonic offsets from the start of the
+// request, 0 when the transport did not report them.
+type requestPhases struct {
+	start                              time.Time
+	encoded                            time.Duration
+	getConn, gotConn, wrote, firstByte atomic.Int64 // the transport calls the trace from its goroutines
+}
+
+func newRequestPhases(start time.Time) *requestPhases {
+	return &requestPhases{start: start, encoded: time.Since(start)}
+}
+
+func (p *requestPhases) trace() *httptrace.ClientTrace {
+	mark := func(t *atomic.Int64) { t.Store(max(1, int64(time.Since(p.start)))) }
+	return &httptrace.ClientTrace{
+		GetConn:              func(string) { mark(&p.getConn) },
+		GotConn:              func(httptrace.GotConnInfo) { mark(&p.gotConn) },
+		WroteRequest:         func(httptrace.WroteRequestInfo) { mark(&p.wrote) },
+		GotFirstResponseByte: func() { mark(&p.firstByte) },
+	}
+}
+
+func (p *requestPhases) observe(extender, verb string) {
+	done := int64(time.Since(p.start))
+	get, got, wrote, first := p.getConn.Load(), p.gotConn.Load(), p.wrote.Load(), p.firstByte.Load()
+	if get == 0 || got < get || first < got {
+		return // the transport did not report a connection or an answer
+	}
+	// An extender may answer before the whole request is written (a large filter body):
+	// writing then ends at the first byte of the answer and waiting takes no time.
+	if wrote == 0 || wrote > first {
+		wrote = first
+	}
+	for _, x := range []struct {
+		phase    string
+		from, to int64
+	}{
+		{"encode", 0, int64(p.encoded)},
+		{"conn", get, got},
+		{"write", got, wrote},
+		{"wait", wrote, first},
+		{"read", first, done},
+	} {
+		metrics.ExtenderRequestPhaseDuration.WithLabelValues(extender, verb, x.phase).Observe(float64(x.to-x.from) / 1e9)
+	}
+}
+
+// deckhouseOutcome is the result of a request the extender answered: an
+// error it reported in the answer (filter, bind) is "extender_error".
+func deckhouseOutcome(result interface{}) string {
+	switch r := result.(type) {
+	case *extenderv1.ExtenderFilterResult:
+		if r.Error != "" {
+			return "extender_error"
+		}
+	case *extenderv1.ExtenderBindingResult:
+		if r.Error != "" {
+			return "extender_error"
+		}
+	}
+	return "success"
+}
+
+// deckhouseRecordFilterNodes counts the nodes a filter answer passed, failed
+// and failed as unresolvable.
+func (h *HTTPExtender) deckhouseRecordFilterNodes(pod *v1.Pod, result *extenderv1.ExtenderFilterResult) {
+	if deckhouseIsSimulation(pod) || metrics.ExtenderFilterNodes == nil {
+		return
+	}
+	passed := 0
+	if result.NodeNames != nil {
+		passed = len(*result.NodeNames)
+	} else if result.Nodes != nil {
+		passed = len(result.Nodes.Items)
+	}
+	for outcome, n := range map[string]int{"passed": passed, "failed": len(result.FailedNodes), "unresolvable": len(result.FailedAndUnresolvableNodes)} {
+		if n > 0 {
+			metrics.ExtenderFilterNodes.WithLabelValues(h.name, outcome).Add(float64(n))
+		}
+	}
+}
