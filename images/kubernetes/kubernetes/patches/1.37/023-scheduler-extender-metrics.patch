+
+package scheduler
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/component-base/metrics/testutil"
+	fwk "k8s.io/kube-scheduler/framework"
+	schedulerapi "k8s.io/kubernetes/pkg/scheduler/apis/config"
+	"k8s.io/kubernetes/pkg/scheduler/framework"
+	"k8s.io/kubernetes/pkg/scheduler/metrics"
+)
+
+// withExtenderNames replaces the names read from the environment until the
+// test ends.
+func withExtenderNames(t *testing.T, names map[string]string) {
+	saved := deckhouseExtenderNames
+	deckhouseExtenderNames = func() map[string]string { return names }
+	t.Cleanup(func() { deckhouseExtenderNames = saved })
+}
+
+func TestDeckhouseParseExtenderNames(t *testing.T) {
+	cases := []struct {
+		env  string
+		want map[string]string
+	}{
+		{env: "", want: map[string]string{}},
+		{
+			env:  "https://usage.d8-usage.svc.cluster.local:8443/usage=usage,https://sds.d8-sds.svc:8099/scheduler=sds/1",
+			want: map[string]string{"https://usage.d8-usage.svc.cluster.local:8443/usage": "usage", "https://sds.d8-sds.svc:8099/scheduler": "sds/1"},
+		},
+		// A URL prefix may hold "=", a name cannot: the last "=" splits.
+		{env: "https://a.svc/x?y=z=a", want: map[string]string{"https://a.svc/x?y=z": "a"}},
+		// Malformed pairs are skipped, the others kept; a repeated URL prefix keeps its first name.
+		{
+			env:  "noname,https://b.svc/=,relative/path=c,=d,https://a.svc,x=a,https://e.svc=e,https://e.svc=f",
+			want: map[string]string{"https://e.svc": "e"},
+		},
+	}
+	for _, tc := range cases {
+		if got := parseDeckhouseExtenderNames(tc.env); !reflect.DeepEqual(got, tc.want) {
+			t.Errorf("%q: %v, want %v", tc.env, got, tc.want)
+		}
+	}
+}
+
+// The extender metrics carry the name; scheduler_extender_info also carries
+// the URL prefix, and Name() stays the URL prefix.
+func TestDeckhouseExtenderNameLabels(t *testing.T) {
+	metrics.Register()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte(`{"nodenames":["n"]}`))
+	}))
+	defer srv.Close()
+	// A name of its own per server: go test -count=2 runs the test twice.
+	name := "usage/" + srv.URL[strings.LastIndexByte(srv.URL, ':')+1:]
+	withExtenderNames(t, map[string]string{srv.URL: name})
+
+	e, err := NewHTTPExtender(&schedulerapi.Extender{URLPrefix: srv.URL, FilterVerb: "filter", PrioritizeVerb: "prioritize", Weight: 1, Ignorable: true, NodeCacheCapable: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := e.(*HTTPExtender)
+	if e.Name() != srv.URL || h.name != name {
+		t.Fatalf("Name() %q, name %q", e.Name(), h.name)
+	}
+	node := framework.NewNodeInfo()
+	node.SetNode(&v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n"}})
+	if _, _, _, err := e.Filter(&v1.Pod{}, []fwk.NodeInfo{node}); err != nil {
+		t.Fatal(err)
+	}
+
+	if n, err := testutil.GetHistogramMetricCount(metrics.ExtenderRequestDuration.WithLabelValues(name, "filter", "success")); err != nil || n != 1 {
+		t.Errorf("request duration by name: %d (%v), want 1", n, err)
+	}
+	if n, err := testutil.GetHistogramMetricCount(metrics.ExtenderRequestPhaseDuration.WithLabelValues(name, "filter", "wait")); err != nil || n != 1 {
+		t.Errorf("phase duration by name: %d (%v), want 1", n, err)
+	}
+	if v, err := testutil.GetCounterMetricValue(metrics.ExtenderFilterNodes.WithLabelValues(name, "passed")); err != nil || v != 1 {
+		t.Errorf("filter nodes by name: %v (%v), want 1", v, err)
+	}
+	if v, err := testutil.GetGaugeMetricValue(metrics.ExtenderInfo.WithLabelValues(name, srv.URL, "filter", "prioritize", "", "", "1", "true")); err != nil || v != 1 {
+		t.Errorf("extender info with name and url: %v (%v), want 1", v, err)
+	}
+	if _, err := NewHTTPExtender(&schedulerapi.Extender{URLPrefix: "https://manual.example/x", FilterVerb: "filter"}); err != nil {
+		t.Fatal(err)
+	}
+	if v, err := testutil.GetGaugeMetricValue(metrics.ExtenderInfo.WithLabelValues("https://manual.example/x", "https://manual.example/x", "filter", "", "", "", "0", "false")); err != nil || v != 1 {
+		t.Errorf("an extender without a name keeps its URL prefix: %v (%v)", v, err)
+	}
+}
