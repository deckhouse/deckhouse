+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package scheduler
+
+// Deckhouse: readable names of extenders. Upstream knows an extender only by
+// its URL prefix. Deckhouse renders DECKHOUSE_EXTENDER_NAMES, comma-separated
+// <urlPrefix>=<name> pairs (the name of the KubeSchedulerWebhookConfiguration,
+// with /<n> when the object has several webhooks). The extender metrics carry
+// the name in the label extender; scheduler_extender_info also carries the URL
+// prefix in the label url. An extender without a name (the variable is unset,
+// an older Deckhouse, a manual configuration) keeps its URL prefix as the name.
+// Everything else (Name(), requests, logs) keeps the URL prefix.
+
+import (
+	"net/url"
+	"os"
+	"strings"
+	"sync"
+
+	"k8s.io/klog/v2"
+)
+
+const deckhouseExtenderNamesEnv = "DECKHOUSE_EXTENDER_NAMES"
+
+// deckhouseExtenderNames returns the names from the environment, read once.
+// A variable so that tests can replace it.
+var deckhouseExtenderNames = sync.OnceValue(func() map[string]string {
+	return parseDeckhouseExtenderNames(os.Getenv(deckhouseExtenderNamesEnv))
+})
+
+// parseDeckhouseExtenderNames reads <urlPrefix>=<name>,... A name contains
+// neither "=" nor ",", so a pair is split at its last "=". A pair without a
+// name, with a URL prefix that is not an absolute URL (for example a fragment
+// of a URL with a comma) or with a URL prefix seen before is skipped; the
+// skipped pairs are logged once.
+func parseDeckhouseExtenderNames(s string) map[string]string {
+	names := map[string]string{}
+	if s == "" {
+		return names
+	}
+	var skipped []string
+	for _, pair := range strings.Split(s, ",") {
+		i := strings.LastIndexByte(pair, '=')
+		if i < 0 {
+			skipped = append(skipped, pair)
+			continue
+		}
+		prefix, name := pair[:i], pair[i+1:]
+		u, err := url.Parse(prefix)
+		if _, seen := names[prefix]; name == "" || err != nil || u.Scheme == "" || u.Host == "" || seen {
+			skipped = append(skipped, pair)
+			continue
+		}
+		names[prefix] = name
+	}
+	if len(skipped) > 0 {
+		klog.Warningf("Ignoring entries of %s, want <urlPrefix>=<name> with a new URL prefix: %q", deckhouseExtenderNamesEnv, skipped)
+	}
+	return names
+}
+
+// deckhouseExtenderName is the name of the extender with this URL prefix, or
+// the URL prefix itself when it has none.
+func deckhouseExtenderName(urlPrefix string) string {
+	if name, ok := deckhouseExtenderNames()[urlPrefix]; ok {
+		return name
+	}
+	return urlPrefix
+}
