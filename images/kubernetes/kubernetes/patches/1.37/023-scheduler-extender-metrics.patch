+)
+
+// Every extender request is observed with its result, a request the extender
+// answered also with its phases; a filter answer counts its nodes.
+func TestExtenderRequestDuration(t *testing.T) {
+	metrics.Register()
+	cases := []struct {
+		name, result string
+		handler      http.HandlerFunc
+		timeout      time.Duration
+		phases       uint64
+	}{
+		{name: "success", result: "success", phases: 1, handler: func(w http.ResponseWriter, _ *http.Request) {
+			_, _ = w.Write([]byte(`{"nodenames":["n"],"failedNodes":{"m":"full"}}`))
+		}},
+		{name: "extender error", result: "extender_error", phases: 1, handler: func(w http.ResponseWriter, _ *http.Request) {
+			_, _ = w.Write([]byte(`{"error":"volume group unavailable"}`))
+		}},
+		{name: "status", result: "status", handler: func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusInternalServerError) }},
+		{name: "decode", result: "decode", handler: func(w http.ResponseWriter, _ *http.Request) { _, _ = w.Write([]byte(`{`)) }},
+		{name: "timeout", result: "timeout", timeout: 50 * time.Millisecond, handler: func(_ http.ResponseWriter, _ *http.Request) { time.Sleep(200 * time.Millisecond) }},
+		{name: "timeout in the body", result: "timeout", timeout: 100 * time.Millisecond, handler: func(w http.ResponseWriter, _ *http.Request) {
+			_, _ = w.Write([]byte(`{"nodenames":`))
+			w.(http.Flusher).Flush()
+			time.Sleep(400 * time.Millisecond)
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := httptest.NewServer(tc.handler)
+			defer srv.Close()
+			cfg := &schedulerapi.Extender{URLPrefix: srv.URL, FilterVerb: "filter", Weight: 1, NodeCacheCapable: true}
+			if tc.timeout > 0 {
+				cfg.HTTPTimeout = metav1.Duration{Duration: tc.timeout}
+			}
+			ext, err := NewHTTPExtender(cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			node := framework.NewNodeInfo()
+			node.SetNode(&v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n"}})
+			_, _, _, _ = ext.Filter(&v1.Pod{}, []fwk.NodeInfo{node})
+
+			h := metrics.ExtenderRequestDuration.WithLabelValues(srv.URL, "filter", tc.result)
+			if got, err := testutil.GetHistogramMetricCount(h); err != nil || got != 1 {
+				t.Errorf("%d observations with result %s (%v), want 1", got, tc.result, err)
+			}
+			for _, phase := range []string{"encode", "conn", "write", "wait", "read"} {
+				p := metrics.ExtenderRequestPhaseDuration.WithLabelValues(srv.URL, "filter", phase)
+				if got, err := testutil.GetHistogramMetricCount(p); err != nil || got != tc.phases {
+					t.Errorf("phase %s: %d observations (%v), want %d", phase, got, err, tc.phases)
+				}
+			}
+			if tc.result == "success" {
+				for outcome, want := range map[string]float64{"passed": 1, "failed": 1, "unresolvable": 0} {
+					got, _ := testutil.GetCounterMetricValue(metrics.ExtenderFilterNodes.WithLabelValues(srv.URL, outcome))
+					if got != want {
+						t.Errorf("filter nodes %s = %v, want %v", outcome, got, want)
+					}
+				}
+			}
+		})
+	}
+}
+
+// A simulation (deckhouse_simulate.go) calls extenders like a real cycle, but
+// its requests are not recorded.
+func TestDeckhouseExtenderSimulationNotRecorded(t *testing.T) {
+	metrics.Register()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { _, _ = w.Write([]byte(`[]`)) }))
+	defer srv.Close()
+	ext, err := NewHTTPExtender(&schedulerapi.Extender{URLPrefix: srv.URL, PrioritizeVerb: "prioritize", Weight: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	node := framework.NewNodeInfo()
+	node.SetNode(&v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n"}})
+	sim := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Annotations: map[string]string{DeckhouseSimulationAnnotation: "true"}}}
+	if _, _, err := ext.Prioritize(sim, []fwk.NodeInfo{node}); err != nil {
+		t.Fatal(err)
+	}
+	h := metrics.ExtenderRequestDuration.WithLabelValues(srv.URL, "prioritize", "success")
+	if got, _ := testutil.GetHistogramMetricCount(h); got != 0 {
+		t.Errorf("simulation: %d observations, want 0", got)
+	}
+	if _, _, err := ext.Prioritize(&v1.Pod{}, []fwk.NodeInfo{node}); err != nil {
+		t.Fatal(err)
+	}
+	if got, _ := testutil.GetHistogramMetricCount(h); got != 1 {
+		t.Errorf("real cycle: %d observations, want 1", got)
+	}
+
+	phase := metrics.ExtenderRequestPhaseDuration.WithLabelValues(srv.URL, "prioritize", "wait")
+	if got, _ := testutil.GetHistogramMetricCount(phase); got != 1 {
+		t.Errorf("phases: %d observations, want 1 from the real cycle only", got)
+	}
+
+	fsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { _, _ = w.Write([]byte(`{"nodenames":["n"]}`)) }))
+	defer fsrv.Close()
+	fext, err := NewHTTPExtender(&schedulerapi.Extender{URLPrefix: fsrv.URL, FilterVerb: "filter", Weight: 1, NodeCacheCapable: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err := fext.Filter(sim, []fwk.NodeInfo{node}); err != nil {
+		t.Fatal(err)
+	}
+	fh := metrics.ExtenderRequestDuration.WithLabelValues(fsrv.URL, "filter", "success")
+	passed, _ := testutil.GetCounterMetricValue(metrics.ExtenderFilterNodes.WithLabelValues(fsrv.URL, "passed"))
+	if got, _ := testutil.GetHistogramMetricCount(fh); got != 0 || passed != 0 {
+		t.Errorf("simulated filter: %d observations, %v nodes counted; want none", got, passed)
+	}
+}
+
+// Every configured extender is listed with its verbs, weight and ignorable flag.
+func TestDeckhouseExtenderInfo(t *testing.T) {
+	metrics.Register()
+	if _, err := NewHTTPExtender(&schedulerapi.Extender{
+		URLPrefix: "https://sds.example/scheduler", FilterVerb: "filter", PrioritizeVerb: "prioritize", Weight: 5, Ignorable: true,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	g := metrics.ExtenderInfo.WithLabelValues("https://sds.example/scheduler", "https://sds.example/scheduler", "filter", "prioritize", "", "", "5", "true")
+	if got, err := testutil.GetGaugeMetricValue(g); err != nil || got != 1 {
+		t.Errorf("extender info = %v (%v), want 1", got, err)
+	}
+}
