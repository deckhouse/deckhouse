+)
+
+// The queue keeps the order, puts a failed request back in front, drops the
+// oldest placements over the limit and the expired ones when they are taken.
+func TestDeckhousePlacementsQueue(t *testing.T) {
+	metrics.Register()
+	dropped := func(reason string) float64 {
+		v, _ := testutil.GetCounterMetricValue(metrics.ExtenderPlacementsDropped.WithLabelValues("q", reason))
+		return v
+	}
+	overflowBefore, expiredBefore := dropped("overflow"), dropped("expired")
+	now := time.Unix(0, 0)
+	q := &placements{extender: "q", now: func() time.Time { return now }}
+	q.add(placement{Name: "a"})
+	q.add(placement{Name: "b"})
+	got := q.take()
+	if len(got) != 2 || got[0].Name != "a" || got[1].Name != "b" || q.take() != nil {
+		t.Fatalf("take = %+v", got)
+	}
+	q.add(placement{Name: "c"})
+	q.requeue(got...)
+	if l := q.take(); len(l) != 3 || l[0].Name != "a" || l[2].Name != "c" {
+		t.Fatalf("requeued in front: %+v", l)
+	}
+
+	for i := 0; i < maxPendingPlacements+5; i++ {
+		q.add(placement{Name: "x"})
+	}
+	if l := q.take(); len(l) != maxPendingPlacements {
+		t.Errorf("over the limit: %d queued, want %d", len(l), maxPendingPlacements)
+	}
+	if n := dropped("overflow") - overflowBefore; n != 5 {
+		t.Errorf("overflow drops = %v, want 5", n)
+	}
+
+	q.add(placement{Name: "old"})
+	now = now.Add(placementTTL + time.Second)
+	q.add(placement{Name: "new"})
+	if l := q.take(); len(l) != 1 || l[0].Name != "new" {
+		t.Errorf("after the TTL: %+v, want only new", l)
+	}
+	if n := dropped("expired") - expiredBefore; n != 1 {
+		t.Errorf("expired drops = %v, want 1", n)
+	}
+
+	var off *placements
+	off.add(placement{})
+	off.requeue(placement{})
+	if off.take() != nil {
+		t.Error("a nil queue must take nothing")
+	}
+}
+
+// Only the listed prioritizing extenders take placements.
+func TestDeckhouseNewPlacements(t *testing.T) {
+	t.Setenv(deckhousePlacementsEnv, "https://usage/x,https://other")
+	if newPlacements("https://usage/x", "prioritize") == nil {
+		t.Error("a listed extender must take placements")
+	}
+	if newPlacements("https://usage/x", "") != nil {
+		t.Error("an extender without prioritize must not")
+	}
+	if newPlacements("https://sds", "prioritize") != nil {
+		t.Error("an unlisted extender must not")
+	}
+}
+
+// A listed extender gets the queued placements in the next prioritize request,
+// gets them again after a failed request, and a simulation takes none. An
+// unlisted extender gets the upstream request.
+func TestDeckhousePlacementsInPrioritize(t *testing.T) {
+	metrics.Register()
+	var mu sync.Mutex
+	var bodies []map[string]json.RawMessage
+	fail := false
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		raw, _ := io.ReadAll(r.Body)
+		var b map[string]json.RawMessage
+		_ = json.Unmarshal(raw, &b)
+		bodies = append(bodies, b)
+		if fail {
+			w.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		_, _ = w.Write([]byte(`[]`))
+	}))
+	defer srv.Close()
+	t.Setenv(deckhousePlacementsEnv, srv.URL+"/listed")
+
+	newExt := func(path string) *HTTPExtender {
+		e, err := NewHTTPExtender(&schedulerapi.Extender{URLPrefix: srv.URL + path, PrioritizeVerb: "prioritize", Weight: 1})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return e.(*HTTPExtender)
+	}
+	listed, unlisted := newExt("/listed"), newExt("/unlisted")
+	sched := &Scheduler{Extenders: []fwk.Extender{listed, unlisted}}
+	node := framework.NewNodeInfo()
+	node.SetNode(&v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n"}})
+	nodes := []fwk.NodeInfo{node}
+	placed := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "vm", Namespace: "ns", UID: "u1"}}
+	scored := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "next", Namespace: "ns"}}
+	sim := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "sim", Namespace: "ns", Annotations: map[string]string{DeckhouseSimulationAnnotation: "true"}}}
+	assumed := func(i int) string {
+		mu.Lock()
+		defer mu.Unlock()
+		return string(bodies[i]["assumed"])
+	}
+
+	sched.notifyExtenders(false, placed, "n")
+	if unlisted.pending != nil {
+		t.Fatal("an unlisted extender must have no queue")
+	}
+	_, _, _ = listed.Prioritize(sim, nodes)
+	if assumed(0) != "" {
+		t.Errorf("a simulation took the placements: %s", assumed(0))
+	}
+	setFail := func(v bool) { mu.Lock(); fail = v; mu.Unlock() }
+	setFail(true)
+	_, _, _ = listed.Prioritize(scored, nodes)
+	setFail(false)
+	_, _, _ = listed.Prioritize(scored, nodes)
+	want := `[{"uid":"u1","namespace":"ns","name":"vm","node":"n"}]`
+	if assumed(1) != want || assumed(2) != want {
+		t.Errorf("failed request %s, retry %s; want %s in both", assumed(1), assumed(2), want)
+	}
+	_, _, _ = listed.Prioritize(scored, nodes)
+	_, _, _ = unlisted.Prioritize(scored, nodes)
+	if assumed(3) != "" || assumed(4) != "" {
+		t.Errorf("sent twice %q, or to an unlisted extender %q", assumed(3), assumed(4))
+	}
+}
+
+// A dropped reservation goes out with forget, and only extenders interested in
+// the Pod (managed resources) get its placements.
+func TestDeckhousePlacementsForgetAndInterest(t *testing.T) {
+	t.Setenv(deckhousePlacementsEnv, "https://gpu,https://all")
+	newExt := func(url string, managed ...schedulerapi.ExtenderManagedResource) *HTTPExtender {
+		e, err := NewHTTPExtender(&schedulerapi.Extender{URLPrefix: url, PrioritizeVerb: "prioritize", Weight: 1, ManagedResources: managed})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return e.(*HTTPExtender)
+	}
+	gpu, all := newExt("https://gpu", schedulerapi.ExtenderManagedResource{Name: "example.com/gpu"}), newExt("https://all")
+	sched := &Scheduler{Extenders: []fwk.Extender{gpu, all}}
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "vm", Namespace: "ns", UID: "u1"}, Spec: v1.PodSpec{Containers: []v1.Container{{Name: "c"}}}}
+
+	sched.notifyExtenders(false, pod, "n1")
+	sched.notifyExtenders(true, pod, "n1")
+	if l := gpu.pending.take(); len(l) != 0 {
+		t.Errorf("an extender not interested in the Pod got %+v", l)
+	}
+	l := all.pending.take()
+	raw, err := json.Marshal(l)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `[{"uid":"u1","namespace":"ns","name":"vm","node":"n1"},{"uid":"u1","namespace":"ns","name":"vm","node":"n1","forget":true}]`
+	if string(raw) != want {
+		t.Errorf("placements = %s, want %s", raw, want)
+	}
+}
