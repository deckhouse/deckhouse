diff --git a/pkg/scheduler/deckhouse_extender_placements.go b/pkg/scheduler/deckhouse_extender_placements.go
new file mode 100644
index 00000000000..babbd4b7607
--- /dev/null
+++ b/pkg/scheduler/deckhouse_extender_placements.go
@@ -0,0 +1,163 @@
+/*
+Copyright 2026 Flant JSC
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package scheduler
+
+// Deckhouse: placements piggybacked on prioritize requests. An extender that
+// scores nodes by their load learns about a placed Pod only when the binding
+// reaches its informer, about a second later under load, so a burst of Pods is
+// scored as if none of them were placed. For the extenders listed in
+// DECKHOUSE_EXTENDER_PLACEMENTS (URL prefixes, comma-separated) the scheduler
+// queues every reservation of a Pod on a node and every dropped reservation,
+// and sends them in the next prioritize request in "assumed". The
+// scheduling cycle is serial, so every Pod is scored with all the Pods placed
+// before it. Other extenders get the upstream request.
+
+import (
+	"os"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/types"
+	extenderv1 "k8s.io/kube-scheduler/extender/v1"
+	"k8s.io/kubernetes/pkg/scheduler/metrics"
+)
+
+const (
+	deckhousePlacementsEnv = "DECKHOUSE_EXTENDER_PLACEMENTS"
+	// maxPendingPlacements bounds the queue while no prioritize request goes out
+	// or the extender fails; the oldest placements are dropped first.
+	maxPendingPlacements = 1000
+	// placementTTL: by then the binding has reached the extender's informer, and
+	// an older hint could only make it count the Pod twice.
+	placementTTL = 30 * time.Second
+)
+
+// placement is a Pod reserved on a node, or with Forget a dropped reservation.
+type placement struct {
+	UID       types.UID `json:"uid"`
+	Namespace string    `json:"namespace"`
+	Name      string    `json:"name"`
+	Node      string    `json:"node"`
+	Forget    bool      `json:"forget,omitempty"`
+	at        time.Time
+}
+
+// argsWithPlacements is a prioritize request with the placements since the
+// previous one.
+type argsWithPlacements struct {
+	*extenderv1.ExtenderArgs
+	Assumed []placement `json:"assumed,omitempty"`
+}
+
+// placements is the queue of one extender.
+type placements struct {
+	extender string // the name in metrics (deckhouse_extender_names.go)
+	now      func() time.Time
+
+	mu   sync.Mutex
+	list []placement
+}
+
+// newPlacements returns the queue of the extender, or nil when the extender is
+// not listed in DECKHOUSE_EXTENDER_PLACEMENTS or does not prioritize.
+func newPlacements(urlPrefix, prioritizeVerb string) *placements {
+	if prioritizeVerb == "" || !slices.Contains(strings.Split(os.Getenv(deckhousePlacementsEnv), ","), urlPrefix) {
+		return nil
+	}
+	return &placements{extender: deckhouseExtenderName(urlPrefix), now: time.Now}
+}
+
+// add queues a placement.
+func (q *placements) add(p placement) {
+	if q == nil {
+		return
+	}
+	p.at = q.now()
+	q.put(false, p)
+}
+
+// requeue puts the placements of a failed request back in front: the extender
+// may have applied them already, and applying a placement twice changes nothing.
+func (q *placements) requeue(l ...placement) {
+	if q == nil || len(l) == 0 {
+		return
+	}
+	q.put(true, l...)
+}
+
+func (q *placements) put(front bool, l ...placement) {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if front {
+		q.list = append(slices.Clone(l), q.list...)
+	} else {
+		q.list = append(q.list, l...)
+	}
+	if over := len(q.list) - maxPendingPlacements; over > 0 {
+		q.list = q.list[over:]
+		q.dropped("overflow", over)
+	}
+}
+
+// take empties the queue and returns the placements younger than placementTTL.
+func (q *placements) take() []placement {
+	if q == nil {
+		return nil
+	}
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	l := q.list
+	q.list = nil
+	cutoff := q.now().Add(-placementTTL)
+	fresh := slices.DeleteFunc(l, func(p placement) bool { return p.at.Before(cutoff) })
+	q.dropped("expired", len(l)-len(fresh))
+	return fresh
+}
+
+func (q *placements) dropped(reason string, n int) {
+	if n > 0 && metrics.ExtenderPlacementsDropped != nil {
+		metrics.ExtenderPlacementsDropped.WithLabelValues(q.extender, reason).Add(float64(n))
+	}
+}
+
+// prioritizeBody adds the queued placements to a prioritize request. A
+// simulation (deckhouse_simulate.go) takes none: they belong to the next real
+// request.
+func (h *HTTPExtender) prioritizeBody(pod *v1.Pod, args *extenderv1.ExtenderArgs) (any, []placement) {
+	if deckhouseIsSimulation(pod) {
+		return args, nil
+	}
+	sent := h.pending.take()
+	if len(sent) == 0 {
+		return args, nil
+	}
+	return &argsWithPlacements{ExtenderArgs: args, Assumed: sent}, sent
+}
+
+// notifyExtenders queues the reservation of the Pod on the node, or with
+// forget the dropped reservation, for the extenders that take placements and
+// are interested in the Pod.
+func (sched *Scheduler) notifyExtenders(forget bool, pod *v1.Pod, node string) {
+	for _, e := range sched.Extenders {
+		if h, ok := e.(*HTTPExtender); ok && h.pending != nil && h.IsInterested(pod) {
+			h.pending.add(placement{UID: pod.UID, Namespace: pod.Namespace, Name: pod.Name, Node: node, Forget: forget})
+		}
+	}
+}
