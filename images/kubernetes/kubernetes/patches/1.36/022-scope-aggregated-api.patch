+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			resolvers := &scopefilter.Resolvers{
+				Classify:        &scopeTestClassify{set: nsSet("a", "b", "c")},
+				Floor:           &scopeTestFloor{set: nsSet("a", "b")},
+				RefreshInterval: time.Hour,
