+// TestProxyScope_ErrorsReadByClientGo: the answers of the proxy itself are
+// Status objects in the media type the client asked for, which client-go
+// reads as the API error they are, not as an unknown one. The 404 for an
+// object outside the set is the 404 of a missing object.
+func TestProxyScope_ErrorsReadByClientGo(t *testing.T) {
+	base := "/apis/" + scopeTestGroup + "/v1"
+	for _, mediaType := range []string{runtime.ContentTypeJSON, runtime.ContentTypeProtobuf} {
+		for _, tc := range []struct {
+			name      string
+			path      string
+			floorErr  error
+			check     func(error) bool
+			wantInMsg string
+		}{
+			{name: "outside the set", path: base + "/namespaces/z/widgets/w", check: apierrors.IsNotFound, wantInMsg: `widgets.proxied.example.io "w" not found`},
+			{name: "not opted in", path: base + "/namespaces/a/gadgets/w", check: apierrors.IsForbidden},
+			{name: "permission service unavailable", path: base + "/namespaces/a/widgets/w", floorErr: scopefilter.ErrPermissionServiceUnavailable, check: apierrors.IsServiceUnavailable},
+		} {
+			t.Run(mediaType+"/"+tc.name, func(t *testing.T) {
+				resolvers := &scopefilter.Resolvers{
+					Classify: &scopeTestClassify{set: nsSet("a", "b")},
+					Floor:    &scopeTestFloor{set: nsSet("a"), err: tc.floorErr},
+				}
+				p := newScopeProxy(t, resolvers, scopeTestAPIService("v1", "widgets"), scopeTag{req: scopeSystem, bypass: true})
+				client, err := restclient.RESTClientFor(&restclient.Config{
+					Host:    p.server.URL,
+					APIPath: "/apis",
+					ContentConfig: restclient.ContentConfig{
+						GroupVersion:         &schema.GroupVersion{Group: scopeTestGroup, Version: "v1"},
+						NegotiatedSerializer: aggregatorscheme.Codecs.WithoutConversion(),
+						ContentType:          mediaType,
+					},
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+				result := client.Get().AbsPath(tc.path).Do(context.Background())
+				err = result.Error()
+				var statusErr *apierrors.StatusError
+				if !errors.As(err, &statusErr) || !tc.check(err) {
+					t.Fatalf("client-go read %T %v", err, err)
+				}
+				if tc.wantInMsg != "" && statusErr.ErrStatus.Message != tc.wantInMsg {
+					t.Fatalf("message = %q, want %q", statusErr.ErrStatus.Message, tc.wantInMsg)
+				}
+				var contentType string
+				result.ContentType(&contentType)
+				if contentType != mediaType {
+					t.Fatalf("content type = %q, want %q", contentType, mediaType)
+				}
+				if calls, _, _ := p.backend.snapshot(); calls != 0 {
+					t.Fatal("the backend was called")
+				}
+			})
+		}
+	}
+}
