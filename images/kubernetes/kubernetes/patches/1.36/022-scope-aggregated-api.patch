+	// what an extension server actually receives.
+	proxiedAnnotation     = "scope.deckhouse.io/resources"
+	scopeModeHeader       = "X-Deckhouse-Scope-Mode"
+	scopeNamespacesHeader = "X-Deckhouse-Scope-Namespaces"
