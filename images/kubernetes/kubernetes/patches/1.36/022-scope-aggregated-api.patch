+package apiserver
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"mime"
+	"net/http"
+	"sync"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/watch"
+	"k8s.io/klog/v2"
+	aggregatorscheme "k8s.io/kube-aggregator/pkg/apiserver/scheme"
+)
+
+// Deckhouse: the client writer of a scoped plain watch, see
+// handler_proxy_scopewatch.go. It forwards the stream of the extension server
+// one whole event frame at a time, so that when the refresher ends the stream
+// the proxy can append an ERROR event without splitting a frame: the bytes of
+// a frame still incomplete then are dropped, as the end of the stream would
+// have dropped them.
+//
+// It knows the framing of the two watch media types client-go asks for:
+// JSON, a sequence of JSON values, and protobuf, length-prefixed frames
+// (application/vnd.kubernetes.protobuf;stream=watch). Any other stream --
+// another media type, a compressed body, an error answer, a stream it cannot
+// parse, or a frame larger than maxBufferedWatchFrame -- is forwarded as it
+// comes and only ends, as before.
+
+type watchFraming int
+
+const (
+	watchFramingUndecided watchFraming = iota
+	watchFramingNone
+	watchFramingJSON
+	watchFramingProtobuf
+)
+
+// maxBufferedWatchFrame bounds the frame the writer holds back until it is
+// complete; a larger frame switches it to forwarding as it comes.
+const maxBufferedWatchFrame = 16 << 20
+
+// maxIdleWatchBuffer is the capacity of pending the writer keeps once it has
+// forwarded everything; a larger buffer, left by a large frame, is released.
+const maxIdleWatchBuffer = 64 << 10
+
+type scopeWatchWriter struct {
+	http.ResponseWriter
+
+	mu        sync.Mutex
+	framing   watchFraming
+	mediaType string
+
+	// pending holds the bytes of the frame that is not complete yet.
+	pending []byte
+
+	// The state of the JSON scan of pending: the bytes scanned and where
+	// the scan is within a value.
+	scanned  int
+	depth    int
+	inString bool
+	escaped  bool
+}
+
+func (w *scopeWatchWriter) WriteHeader(code int) {
+	// An informational answer, such as 103 Early Hints that ReverseProxy
+	// forwards, comes before the final one, which is what decides.
+	if code >= http.StatusOK {
+		w.mu.Lock()
+		w.decideLocked(code)
+		w.mu.Unlock()
+	}
+	w.ResponseWriter.WriteHeader(code)
+}
+
+// Unwrap returns the client writer, for http.ResponseController.
+func (w *scopeWatchWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriter
+}
+
+// decideLocked picks the framing from the final response headers, once.
+func (w *scopeWatchWriter) decideLocked(code int) {
+	if w.framing != watchFramingUndecided {
+		return
+	}
+	w.framing = watchFramingNone
+	h := w.ResponseWriter.Header()
+	if code != http.StatusOK {
+		return
+	}
+	if enc := h.Get("Content-Encoding"); enc != "" && enc != "identity" {
+		return
+	}
+	mediaType, params, err := mime.ParseMediaType(h.Get("Content-Type"))
+	if err != nil {
+		return
+	}
+	switch {
+	case mediaType == runtime.ContentTypeJSON:
+		w.framing = watchFramingJSON
+	case mediaType == runtime.ContentTypeProtobuf && params["stream"] == "watch":
+		w.framing = watchFramingProtobuf
+	default:
+		return
+	}
+	w.mediaType = mediaType
+}
+
+func (w *scopeWatchWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.decideLocked(http.StatusOK)
+	if w.framing == watchFramingNone {
+		return w.ResponseWriter.Write(p)
+	}
+	w.pending = append(w.pending, p...)
+	complete := w.completeLocked()
+	if complete == 0 {
+		return len(p), nil
+	}
+	_, err := w.ResponseWriter.Write(w.pending[:complete])
+	if complete == len(w.pending) && cap(w.pending) > maxIdleWatchBuffer {
+		w.pending = nil
+	} else {
+		w.pending = append(w.pending[:0], w.pending[complete:]...)
+	}
+	w.scanned -= complete
+	if err != nil {
+		return 0, err
+	}
+	return len(p), nil
+}
+
+// Flush flushes what was written: the frames forwarded whole.
+func (w *scopeWatchWriter) Flush() {
+	_ = http.NewResponseController(w.ResponseWriter).Flush()
+}
+
+// completeLocked returns the length of the whole frames at the start of
+// pending. A stream it cannot parse, or a frame that grows past
+// maxBufferedWatchFrame, switches the writer to forwarding as it comes,
+// everything pending included.
+func (w *scopeWatchWriter) completeLocked() int {
+	var complete int
+	var ok bool
+	switch w.framing {
+	case watchFramingJSON:
+		complete, ok = w.scanJSONLocked()
+		if ok && len(w.pending)-complete > maxBufferedWatchFrame {
+			ok = false
+		}
+	case watchFramingProtobuf:
+		complete, ok = scanProtobufFrames(w.pending)
+	}
+	if !ok {
+		klog.V(2).InfoS("scopefilter: cannot follow the frames of a proxied watch; forwarding it as it comes", "mediaType", w.mediaType)
+		w.framing = watchFramingNone
+		return len(w.pending)
+	}
+	return complete
+}
+
+// scanJSONLocked continues the scan of pending, a sequence of JSON objects
+// separated by whitespace, and returns the end of the last one complete. It
+// only follows the nesting and the strings: the extension server sends valid
+// JSON, and anything at the top level but an object or whitespace is not a
+// stream it can follow.
+func (w *scopeWatchWriter) scanJSONLocked() (int, bool) {
+	complete := 0
+	for i := w.scanned; i < len(w.pending); i++ {
+		c := w.pending[i]
+		if w.inString {
+			switch {
+			case w.escaped:
+				w.escaped = false
+			case c == '\\':
+				w.escaped = true
+			case c == '"':
+				w.inString = false
+			}
+			continue
+		}
+		switch c {
+		case '{', '[':
+			if w.depth == 0 && c != '{' {
+				return 0, false
+			}
+			w.depth++
+		case '}', ']':
+			if w.depth == 0 {
+				return 0, false
+			}
+			w.depth--
+			if w.depth == 0 {
+				complete = i + 1
+			}
+		case '"':
+			if w.depth == 0 {
+				return 0, false
+			}
+			w.inString = true
+		case ' ', '\t', '\r', '\n':
+			if w.depth == 0 {
+				complete = i + 1
+			}
+		default:
+			if w.depth == 0 {
+				return 0, false
+			}
+		}
+	}
+	w.scanned = len(w.pending)
+	return complete, true
+}
+
+// scanProtobufFrames returns the length of the whole length-prefixed frames
+// at the start of p.
+func scanProtobufFrames(p []byte) (int, bool) {
+	complete := 0
+	for len(p)-complete >= 4 {
+		size := binary.BigEndian.Uint32(p[complete:])
+		if size > maxBufferedWatchFrame {
+			return 0, false
+		}
+		if uint64(len(p)-complete) < 4+uint64(size) {
+			break
+		}
+		complete += 4 + int(size)
+	}
+	return complete, true
+}
+
+// finish completes the response once the proxy is done with it. cause is
+// why the refresher ended the stream, nil when it did not: the stream then
+// ended on its own, and what is pending goes out as it came.
+func (w *scopeWatchWriter) finish(cause error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	framed := w.framing == watchFramingJSON || w.framing == watchFramingProtobuf
+	if cause == nil || !framed {
+		if len(w.pending) > 0 {
+			_, _ = w.ResponseWriter.Write(w.pending)
+			w.pending = nil
+		}
+		w.Flush()
+		return
+	}
+	w.pending = nil
+	event, err := encodeExpiredWatchEvent(w.mediaType, cause)
+	if err != nil {
+		klog.ErrorS(err, "scopefilter: cannot encode the ERROR event that ends a proxied watch")
+		return
+	}
+	if _, err := w.ResponseWriter.Write(event); err != nil {
+		return
+	}
+	w.Flush()
+}
+
+// encodeExpiredWatchEvent encodes the event that ends a watch whose set the
+// refresher found changed: ERROR with a 410 Expired Status, which client-go's
+// reflector answers with a new list. It is framed as the watch handler of an
+// API server frames an event of mediaType: the Status encoded by the
+// serializer of the media type, embedded in a WatchEvent encoded by its stream
+// serializer and framer.
+func encodeExpiredWatchEvent(mediaType string, cause error) ([]byte, error) {
+	info, ok := runtime.SerializerInfoForMediaType(aggregatorscheme.Codecs.SupportedMediaTypes(), mediaType)
+	if !ok || info.StreamSerializer == nil || info.StreamSerializer.Framer == nil {
+		return nil, errors.New("no stream serializer for " + mediaType)
+	}
+	status := apierrors.NewResourceExpired(cause.Error() + "; list again").Status()
+	embedded, err := runtime.Encode(aggregatorscheme.Codecs.EncoderForVersion(info.Serializer, metav1.Unversioned), &status)
+	if err != nil {
+		return nil, err
+	}
+	event := &metav1.WatchEvent{Type: string(watch.Error), Object: runtime.RawExtension{Raw: embedded}}
+	// Encoded first and framed with one write, as the watch handler does: a
+	// framer frames each write it is given.
+	var encoded, out bytes.Buffer
+	if err := info.StreamSerializer.Serializer.Encode(event, &encoded); err != nil {
+		return nil, err
+	}
+	if _, err := info.StreamSerializer.Framer.NewFrameWriter(&out).Write(encoded.Bytes()); err != nil {
+		return nil, err
+	}
+	return out.Bytes(), nil
+}
