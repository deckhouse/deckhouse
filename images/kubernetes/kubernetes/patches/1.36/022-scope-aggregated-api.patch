+	pbGroup    = "authorization.deckhouse.io"
+	pbVersion  = "v1alpha1"
+	pbResource = "selfscopedaccessreviews"
+
+	backendNamespace = "scopeext-backends"
+	extServiceName   = "extension"
+	pbServiceName    = "permission-browser"
+
+	// testIDHeader tags every request a case sends, so the backends' records
+	// can be matched to it. kube-aggregator forwards it unchanged.
