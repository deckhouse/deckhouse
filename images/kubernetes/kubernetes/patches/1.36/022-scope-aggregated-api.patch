+// TestProxyScope_WatchSetChangeEndsStream: a change of the allowed set ends
+// the stream on every combination of protocols, the extension server sees its
+// request end, the client sees the response end normally, and the refresher
+// exits.
+func TestProxyScope_WatchSetChangeEndsStream(t *testing.T) {
+	for _, frontendHTTP2 := range []bool{false, true} {
+		for _, backendHTTP2 := range []bool{false, true} {
+			t.Run(fmt.Sprintf("frontendHTTP2=%v/backendHTTP2=%v", frontendHTTP2, backendHTTP2), func(t *testing.T) {
+				waitNoRefreshers(t)
+				closedBefore := proxiedWatchClosed(t, scopefilter.ProxiedWatchClosedSetChanged)
+				floor := &liveAnswer{set: nsSet("a", "b")}
+				p := newWatchProxy(t, filteredWatchResolvers(floor), filteredWatchTag, frontendHTTP2, backendHTTP2)
+				s := p.watch(t, "/apis/"+scopeTestGroup+"/v1/widgets?watch=true")
+
+				wantProto := map[bool]string{false: "HTTP/1.1", true: "HTTP/2.0"}
+				if s.resp.Proto != wantProto[frontendHTTP2] {
+					t.Fatalf("client proto = %s, want %s", s.resp.Proto, wantProto[frontendHTTP2])
+				}
+				if proto, _ := p.backend.snapshot(); proto != wantProto[backendHTTP2] {
+					t.Fatalf("backend proto = %s, want %s", proto, wantProto[backendHTTP2])
+				}
+
+				changed, calls := time.Now(), floor.callCount()
+				floor.update(nsSet("a"), nil)
+				select {
+				case err := <-s.ended:
+					if err != nil {
+						t.Errorf("the stream ended with %v, want a normal end", err)
+					}
+					// One recomputation may have been under way when the
+					// set changed; the next one sees the change.
+					if n := floor.callCount() - calls; n > 2 {
+						t.Errorf("the stream ended after %d recomputations, want at most 2", n)
+					}
+					t.Logf("the stream ended %s after the set changed", time.Since(changed))
+				case <-time.After(scopeWatchDeadline):
+					t.Fatal("the stream is still open after the set changed")
+				}
+				waitFor(t, p.backend.ended, "the backend request to end")
+				waitNoRefreshers(t)
+				if got := proxiedWatchClosed(t, scopefilter.ProxiedWatchClosedSetChanged) - closedBefore; got != 1 {
+					t.Errorf("set_changed closes = %v, want 1", got)
+				}
+			})
+		}
+	}
+}
+
+// TestProxyScope_WatchStaysOpen: an unchanged set, and recomputations that
+// fail one at a time, keep the stream open while the refresher keeps running;
+// the end of the request stops the refresher.
+func TestProxyScope_WatchStaysOpen(t *testing.T) {
+	for _, transient := range []bool{false, true} {
+		t.Run(fmt.Sprintf("transientError=%v", transient), func(t *testing.T) {
+			waitNoRefreshers(t)
+			floor := &liveAnswer{set: nsSet("a", "b")}
+			resolvers := filteredWatchResolvers(floor)
+			// Failures that were never reset would add up past the grace
+			// period within the window below.
+			const grace = 3 * scopeWatchInterval
+			resolvers.ProxiedWatchRefreshGrace = grace
+			p := newWatchProxy(t, resolvers, filteredWatchTag, false, true)
+			s := p.watch(t, "/apis/"+scopeTestGroup+"/v1/widgets?watch=true")
+			if n := activeScopeRefreshers.Load(); n != 1 {
+				t.Fatalf("active refreshers = %d, want 1", n)
+			}
+			for window := time.Now().Add(5 * grace); time.Now().Before(window); {
+				if transient {
+					floor.fail(1)
+				}
+				calls := floor.callCount()
+				waitUntil(t, "the refresher to recompute the set", func() bool { return floor.callCount() >= calls+2 })
+			}
+			select {
+			case err := <-s.ended:
+				t.Fatalf("the stream ended (%v) with an unchanged set", err)
+			default:
+			}
+
+			_ = s.resp.Body.Close()
+			waitFor(t, p.backend.ended, "the backend request to end")
+			waitNoRefreshers(t)
+			after := floor.callCount()
+			time.Sleep(5 * scopeWatchInterval)
+			if floor.callCount() != after {
+				t.Fatal("the set is still recomputed after the request ended")
+			}
+		})
+	}
+}
