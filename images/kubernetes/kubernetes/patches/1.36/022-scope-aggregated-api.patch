+// TestProxyScope_Decision: the set sent to the extension server, or the answer
+// of the proxy itself, for filtered and narrowed reads.
+func TestProxyScope_Decision(t *testing.T) {
+	base := "/apis/" + scopeTestGroup + "/v1"
+	tests := []struct {
+		name           string
+		bypass         bool
+		req            *scopefilter.Request
+		path           string
+		wantVerb       string
+		wantCode       int
+		wantMode       string
+		wantNamespaces string
+		wantNoHeaders  bool
+	}{
+		{name: "filtered list", bypass: true, req: scopeSystem, path: base + "/widgets", wantVerb: "list", wantCode: 200, wantMode: "filtered", wantNamespaces: "a,b"},
+		{name: "filtered list in a namespace of the set", bypass: true, req: scopeSystem, path: base + "/namespaces/b/widgets", wantVerb: "list", wantCode: 200, wantMode: "filtered", wantNamespaces: "b"},
+		{name: "filtered list outside the set: empty set", bypass: true, req: scopeSystem, path: base + "/namespaces/c/widgets", wantVerb: "list", wantCode: 200, wantMode: "filtered", wantNamespaces: ""},
+		{name: "filtered get in the set", bypass: true, req: scopeSystem, path: base + "/namespaces/a/widgets/w", wantVerb: "get", wantCode: 200, wantMode: "filtered", wantNamespaces: "a"},
+		{name: "filtered get outside the set: not found", bypass: true, req: scopeSystem, path: base + "/namespaces/z/widgets/w", wantVerb: "get", wantCode: 404},
+		{name: "filtered get of . in the set: not found", bypass: true, req: scopeSystem, path: base + "/namespaces/a/widgets/.", wantVerb: "get", wantCode: 404},
+		{name: "filtered get of .. in the set: not found", bypass: true, req: scopeSystem, path: base + "/namespaces/a/widgets/..", wantVerb: "get", wantCode: 404},
+		{name: "filtered cluster-wide get of ..: not found", bypass: true, req: scopeSystem, path: base + "/widgets/..", wantVerb: "get", wantCode: 404},
+		{name: "filtered watch", bypass: true, req: scopeSystem, path: base + "/widgets?watch=true", wantVerb: "watch", wantCode: 200, wantMode: "filtered", wantNamespaces: "a,b"},
+		{name: "filtered watch in the set", bypass: true, req: scopeSystem, path: base + "/namespaces/a/widgets?watch=true", wantVerb: "watch", wantCode: 200, wantMode: "filtered", wantNamespaces: "a"},
+		{name: "filtered watch outside the set: empty set", bypass: true, req: scopeSystem, path: base + "/namespaces/c/widgets?watch=true", wantVerb: "watch", wantCode: 200, wantMode: "filtered", wantNamespaces: ""},
+		{name: "filtered accessible: floor only", bypass: true, req: scopeAccessible, path: base + "/widgets", wantVerb: "list", wantCode: 200, wantMode: "filtered", wantNamespaces: "a,b,x"},
+		{name: "narrowed list", req: scopeSystem, path: base + "/widgets", wantCode: 200, wantMode: "narrowed", wantNamespaces: "a,b,c"},
+		{name: "narrowed get in the set", req: scopeSystem, path: base + "/namespaces/c/widgets/w", wantCode: 200, wantMode: "narrowed", wantNamespaces: "c"},
+		{name: "narrowed get outside the set: empty set", req: scopeSystem, path: base + "/namespaces/z/widgets/w", wantCode: 200, wantMode: "narrowed", wantNamespaces: ""},
+		{name: "narrowed watch outside the set: empty set", req: scopeSystem, path: base + "/namespaces/z/widgets?watch=true", wantCode: 200, wantMode: "narrowed", wantNamespaces: ""},
+		{name: "narrowed accessible: nothing to filter", req: scopeAccessible, path: base + "/widgets", wantCode: 200, wantNoHeaders: true},
+		{name: "filtered subresource is refused", bypass: true, req: scopeSystem, path: base + "/namespaces/a/widgets/w/status", wantCode: 403},
+		{name: "filtered resource not opted in is refused", bypass: true, req: scopeSystem, path: base + "/gadgets", wantCode: 403},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			floor := &scopeTestFloor{set: nsSet("a", "b", "x")}
+			resolvers := &scopefilter.Resolvers{
+				Classify: &scopeTestClassify{set: nsSet("a", "b", "c")},
+				Floor:    floor,
+			}
+			p := newScopeProxy(t, resolvers, scopeTestAPIService("v1", "widgets"), scopeTag{req: tc.req, bypass: tc.bypass})
+			resp := p.get(t, tc.path, nil)
+			if resp.StatusCode != tc.wantCode {
+				body, _ := io.ReadAll(resp.Body)
+				t.Fatalf("status = %d, want %d: %s", resp.StatusCode, tc.wantCode, body)
+			}
+			calls, headers, proto := p.backend.snapshot()
+			if tc.wantCode != http.StatusOK {
+				if calls != 0 {
+					t.Fatalf("the backend was called for a refused read")
+				}
+				s := readStatus(t, resp)
+				if s.Code != int32(tc.wantCode) {
+					t.Fatalf("Status code = %d", s.Code)
+				}
+				// The answer names neither the scope nor the set.
+				for _, leak := range []string{"system", `"a"`, `"b"`, `"c"`, `"x"`, `"z"`, "scope"} {
+					if tc.wantCode == http.StatusNotFound && strings.Contains(s.Message, leak) {
+						t.Errorf("message %q contains %s", s.Message, leak)
+					}
+				}
+				return
+			}
+			if calls != 1 {
+				t.Fatalf("backend calls = %d, want 1", calls)
+			}
+			if tc.wantNoHeaders {
+				if _, ok := headers[scopefilter.HeaderScopeMode]; ok {
+					t.Fatalf("trusted headers sent for an unrestricted read: %v", headers)
+				}
+				return
+			}
+			if got := headers.Get(scopefilter.HeaderScopeMode); got != tc.wantMode {
+				t.Errorf("mode = %q, want %q", got, tc.wantMode)
+			}
+			namespaces, ok := headers[scopefilter.HeaderScopeNamespaces]
+			if !ok || len(namespaces) != 1 || namespaces[0] != tc.wantNamespaces {
+				t.Errorf("namespaces = %q (present %v), want %q over %s", namespaces, ok, tc.wantNamespaces, proto)
+			}
+			if tc.bypass {
+				want := floorCall{gvr: schema.GroupVersionResource{Group: scopeTestGroup, Version: "v1", Resource: "widgets"}, verb: tc.wantVerb}
+				if len(floor.calls) != 1 || floor.calls[0] != want {
+					t.Errorf("floor calls = %v, want [%v]", floor.calls, want)
+				}
+			} else if len(floor.calls) != 0 {
+				t.Errorf("the floor was computed for an allowed read: %v", floor.calls)
+			}
+		})
+	}
+}
