+// scopeTarget reports whether a scoped read of gr can be filtered, and
+// whether by an aggregated API server rather than by storage. A resource with
+// a storage Decorator wins: IsProxied is consulted only on a registry miss, so
+// a bypass is never routed by the proxied set to a resource this server
+// stores.
+func scopeTarget(gr schema.GroupResource) (ok, proxied bool) {
+	if scopefilter.EnsureRegistered(gr) {
+		return true, false
+	}
+	if scopefilter.IsProxied(gr) {
+		return true, true
+	}
+	return false, false
+}
