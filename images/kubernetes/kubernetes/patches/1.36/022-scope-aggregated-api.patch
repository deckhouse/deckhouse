+var scopeTestUser = &user.DefaultInfo{Name: "alice", Groups: []string{"devs"}}
+
+// scopeBackend is the extension server: it records what the proxy forwarded.
+type scopeBackend struct {
+	mu      sync.Mutex
+	calls   int
+	headers http.Header
+	proto   string
+}
+
+func (b *scopeBackend) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	b.mu.Lock()
+	b.calls++
+	b.headers = r.Header.Clone()
+	b.proto = r.Proto
+	b.mu.Unlock()
+	if strings.EqualFold(r.Header.Get("Upgrade"), "websocket") {
+		websocket.Handler(func(ws *websocket.Conn) { _ = ws.Close() }).ServeHTTP(w, r)
+		return
+	}
+	w.WriteHeader(http.StatusOK)
+}
+
+func (b *scopeBackend) snapshot() (int, http.Header, string) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.calls, b.headers, b.proto
+}
+
+func newScopeBackend(t *testing.T) (*scopeBackend, *httptest.Server) {
+	t.Helper()
+	b := &scopeBackend{}
+	srv := httptest.NewUnstartedServer(b)
+	cert, err := tls.X509KeyPair(svcCrt, svcKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv.TLS = &tls.Config{Certificates: []tls.Certificate{cert}}
+	srv.EnableHTTP2 = true
+	srv.StartTLS()
+	t.Cleanup(srv.Close)
+	return b, srv
+}
+
+func scopeTestAPIService(version, annotation string) *apiregistration.APIService {
+	s := &apiregistration.APIService{
+		ObjectMeta: metav1.ObjectMeta{Name: version + "." + scopeTestGroup},
+		Spec: apiregistration.APIServiceSpec{
+			CABundle: testCACrt,
+			Group:    scopeTestGroup,
+			Version:  version,
+			Service:  &apiregistration.ServiceReference{Name: "test-service", Namespace: "test-ns", Port: ptr.To[int32](443)},
+		},
+		Status: apiregistration.APIServiceStatus{Conditions: []apiregistration.APIServiceCondition{
+			{Type: apiregistration.Available, Status: apiregistration.ConditionTrue},
+		}},
+	}
+	if annotation != "" {
+		s.Annotations = map[string]string{scopefilter.AnnotationProxiedResources: annotation}
+	}
+	return s
+}
+
+// scopeTag tags a request the way the authorization filter does.
+type scopeTag struct {
+	req    *scopefilter.Request
+	bypass bool
+}
+
+func withScopeTag(h http.Handler, tag scopeTag) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ctx := r.Context()
+		if tag.req != nil {
+			ctx = scopefilter.WithRequest(ctx, *tag.req)
+		}
+		if tag.bypass {
+			ctx = scopefilter.WithBypass(ctx)
+		}
+		h.ServeHTTP(w, r.WithContext(ctx))
+	})
+}
+
+type scopeProxy struct {
+	handler *proxyHandler
+	server  *httptest.Server
+	backend *scopeBackend
+}
+
+func newScopeProxy(t *testing.T, resolvers *scopefilter.Resolvers, apiService *apiregistration.APIService, tag scopeTag) *scopeProxy {
+	t.Helper()
+	backend, backendServer := newScopeBackend(t)
+	h := &proxyHandler{
+		localDelegate:              http.NewServeMux(),
+		serviceResolver:            &mockedRouter{destinationHost: backendServer.Listener.Addr().String()},
+		proxyCurrentCertKeyContent: func() ([]byte, []byte) { return emptyCert(), emptyCert() },
+		scopeResolvers:             resolvers,
+	}
+	h.updateAPIService(apiService)
+	srv := httptest.NewServer(contextHandler(withScopeTag(h, tag), scopeTestUser))
+	t.Cleanup(srv.Close)
+	return &scopeProxy{handler: h, server: srv, backend: backend}
+}
+
+func (p *scopeProxy) get(t *testing.T, path string, header http.Header) *http.Response {
+	t.Helper()
+	req, err := http.NewRequest(http.MethodGet, p.server.URL+path, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for k, vv := range header {
+		req.Header[k] = vv
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = resp.Body.Close() })
+	return resp
+}
+
+func (p *scopeProxy) upgrade(t *testing.T, path string, header http.Header) {
+	t.Helper()
+	cfg, err := websocket.NewConfig("ws://"+p.server.Listener.Addr().String()+path, "http://127.0.0.1/")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.Header = header
+	ws, err := websocket.DialConfig(cfg)
+	if err != nil {
+		t.Fatalf("websocket dial: %v", err)
+	}
+	_ = ws.Close()
+}
+
+// floorCall records what the RBAC floor was asked.
+type floorCall struct {
+	gvr  schema.GroupVersionResource
+	verb string
+}
+
+type scopeTestFloor struct {
+	mu    sync.Mutex
+	set   map[string]struct{}
+	err   error
+	calls []floorCall
+}
+
+func (f *scopeTestFloor) Resolve(_ context.Context, _ user.Info, gvr schema.GroupVersionResource, _, verb string) (map[string]struct{}, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.calls = append(f.calls, floorCall{gvr: gvr, verb: verb})
+	return f.set, f.err
+}
+
+type scopeTestClassify struct {
+	set map[string]struct{}
+	err error
+}
+
+func (c *scopeTestClassify) Resolve(context.Context, scopefilter.Kind, string) (map[string]struct{}, error) {
+	return c.set, c.err
+}
+
+func nsSet(names ...string) map[string]struct{} {
+	out := make(map[string]struct{}, len(names))
+	for _, n := range names {
+		out[n] = struct{}{}
+	}
+	return out
+}
