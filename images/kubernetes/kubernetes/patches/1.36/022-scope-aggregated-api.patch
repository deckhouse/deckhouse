+// TestProxyScope_WatchTimeoutRewrite: the timeoutSeconds the extension server
+// gets for every form of a filtered watch, and none added to what is not one.
+func TestProxyScope_WatchTimeoutRewrite(t *testing.T) {
+	base := "/apis/" + scopeTestGroup + "/v1"
+	tests := []struct {
+		name string
+		tag  scopeTag
+		path string
+		want string // "" means no timeoutSeconds
+	}{
+		{name: "watch=true, unset", tag: filteredWatchTag, path: base + "/widgets?watch=true", want: "300"},
+		{name: "watch=1, unset", tag: filteredWatchTag, path: base + "/widgets?watch=1", want: "300"},
+		{name: "legacy watch path", tag: filteredWatchTag, path: base + "/watch/widgets", want: "300"},
+		{name: "namespaced watch", tag: filteredWatchTag, path: base + "/namespaces/a/widgets?watch=true", want: "300"},
+		{name: "smaller is kept", tag: filteredWatchTag, path: base + "/widgets?watch=true&timeoutSeconds=10", want: "10"},
+		{name: "larger is capped", tag: filteredWatchTag, path: base + "/widgets?watch=true&timeoutSeconds=100000", want: "300"},
+		{name: "narrowed watch outside the set: the empty set is sent", tag: scopeTag{req: scopeSystem}, path: base + "/namespaces/z/widgets?watch=true", want: "300"},
+		{name: "list is not touched", tag: filteredWatchTag, path: base + "/widgets?timeoutSeconds=100000", want: "100000"},
+		{name: "unfiltered narrowed watch is not touched", tag: scopeTag{req: scopeAccessible}, path: base + "/widgets?watch=true"},
+		{name: "unscoped watch is not touched", path: base + "/widgets?watch=true"},
