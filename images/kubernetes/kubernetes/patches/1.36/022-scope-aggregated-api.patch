+func dialWatch(t *testing.T, p *watchProxy, path string) *websocket.Conn {
+	t.Helper()
+	cfg, err := websocket.NewConfig("ws://"+p.server.Listener.Addr().String()+path, "http://127.0.0.1/")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ws, err := websocket.DialConfig(cfg)
+	if err != nil {
+		t.Fatalf("websocket dial: %v", err)
+	}
+	t.Cleanup(func() { _ = ws.Close() })
+	waitFor(t, p.backend.started, "the backend to start streaming")
+	return ws
+}
+
+// readUntilError reads the websocket until it fails, reporting the error.
+func readUntilError(ws *websocket.Conn) <-chan error {
+	ended := make(chan error, 1)
+	go func() {
+		buf := make([]byte, 64)
+		for {
+			if _, err := ws.Read(buf); err != nil {
+				ended <- err
+				return
+			}
+		}
+	}()
+	return ended
+}
