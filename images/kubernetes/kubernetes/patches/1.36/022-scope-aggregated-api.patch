+// listCounter is the list side of the reflector test: a list served directly,
+// counted.
+type listCounter struct {
+	mu    sync.Mutex
+	lists int
+}
+
+func (l *listCounter) list(context.Context, metav1.ListOptions) (runtime.Object, error) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.lists++
+	return &apiregistration.APIServiceList{ListMeta: metav1.ListMeta{ResourceVersion: "1"}}, nil
+}
+
+func (l *listCounter) count() int {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.lists
+}
