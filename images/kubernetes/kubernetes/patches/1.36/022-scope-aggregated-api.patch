+func newAPIService(group, version, service string, annotations map[string]string) *apiregistrationv1.APIService {
+	port := int32(443)
+	return &apiregistrationv1.APIService{
+		ObjectMeta: metav1.ObjectMeta{Name: version + "." + group, Annotations: annotations},
+		Spec: apiregistrationv1.APIServiceSpec{
+			Service: &apiregistrationv1.ServiceReference{
+				Namespace: backendNamespace,
+				Name:      service,
+				Port:      &port,
+			},
+			Group:                group,
+			Version:              version,
+			GroupPriorityMinimum: 1000,
+			VersionPriority:      15,
+			// The httptest certificate does not name <service>.<namespace>.svc.
+			InsecureSkipTLSVerify: true,
+		},
+	}
+}
+
+func waitAPIServiceAvailable(ctx context.Context, t *testing.T, aggregator aggregatorclient.Interface, name string) {
+	t.Helper()
+	pollUntil(ctx, t, "APIService "+name+" to become Available", func() (bool, string) {
+		apiService, err := aggregator.ApiregistrationV1().APIServices().Get(ctx, name, metav1.GetOptions{})
+		if err != nil {
+			return false, err.Error()
+		}
+		for _, cond := range apiService.Status.Conditions {
+			if cond.Type == apiregistrationv1.Available {
+				return cond.Status == apiregistrationv1.ConditionTrue, fmt.Sprintf("%+v", cond)
+			}
+		}
+		return false, "no Available condition"
+	})
+}
