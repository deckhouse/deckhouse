+		ws := dialWatch(t, p, base+"/widgets?watch=true&timeoutSeconds=100000")
+		_ = ws.Close()
+		waitNoRefreshers(t)
+		if _, query := p.backend.snapshot(); query.Get("timeoutSeconds") != "300" {
+			t.Errorf("timeoutSeconds = %q, want 300", query["timeoutSeconds"])
+		}
+	})
+}
