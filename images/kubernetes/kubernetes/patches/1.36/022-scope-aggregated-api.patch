+// TestProxyScope_ReflectorListsAgain: client-go's reflector, watching through
+// the proxy, lists again when the refresher ends the watch, instead of
+// resuming from its last resourceVersion with a cache that misses the
+// namespaces that joined the set.
+func TestProxyScope_ReflectorListsAgain(t *testing.T) {
+	clientfeaturestesting.SetFeatureDuringTest(t, clientfeatures.WatchListClient, false)
+	for _, mediaType := range []string{runtime.ContentTypeJSON, runtime.ContentTypeProtobuf} {
+		t.Run(mediaType, func(t *testing.T) {
+			waitNoRefreshers(t)
+			contentType := mediaType
+			if mediaType == runtime.ContentTypeProtobuf {
+				contentType = protobufWatchMediaType
+			}
+			floor := &liveAnswer{set: nsSet("a", "b")}
+			p := newFrameProxy(t, filteredWatchResolvers(floor), &frameBackend{
+				contentType: contentType,
+				chunks:      [][]byte{encodeTestWatchEvent(t, contentType, watch.Added, testWatchObject("first"))},
+			})
+			client, err := restclient.RESTClientFor(&restclient.Config{
+				Host:    p.server.URL,
+				APIPath: "/apis",
+				ContentConfig: restclient.ContentConfig{
+					GroupVersion:         &schema.GroupVersion{Group: scopeTestGroup, Version: "v1"},
+					NegotiatedSerializer: aggregatorscheme.Codecs.WithoutConversion(),
+					ContentType:          mediaType,
+				},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			lists := &listCounter{}
+			lw := &cache.ListWatch{
+				ListWithContextFunc: lists.list,
+				WatchFuncWithContext: func(ctx context.Context, options metav1.ListOptions) (watch.Interface, error) {
+					return client.Get().Resource("widgets").Param("watch", "true").Param("resourceVersion", options.ResourceVersion).Watch(ctx)
+				},
+			}
+			store := cache.NewStore(cache.MetaNamespaceKeyFunc)
+			r := cache.NewReflector(lw, &apiregistration.APIService{}, store, 0)
+			ctx, cancel := context.WithCancel(context.Background())
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				r.RunWithContext(ctx)
+			}()
+			defer func() {
+				cancel()
+				<-done
+				waitNoRefreshers(t)
+			}()
+			waitFor(t, p.backend.started, "the reflector to watch")
+			waitUntil(t, "the event in the store", func() bool { return len(store.ListKeys()) == 1 })
+			if n := lists.count(); n != 1 {
+				t.Fatalf("lists = %d before the set changed, want 1", n)
+			}
+
+			floor.update(nsSet("a"), nil)
+			waitUntil(t, "the reflector to list again", func() bool { return lists.count() == 2 })
+			waitFor(t, p.backend.started, "the reflector to watch again")
+		})
+	}
+}
