+// TestProxyScope_HeaderLimit: a set that does not fit the header limit of the
+// extension server is refused with 400; one that fits is forwarded whole.
+func TestProxyScope_HeaderLimit(t *testing.T) {
+	names := func(n int) map[string]struct{} {
+		out := make(map[string]struct{}, n)
+		for i := range n {
+			out[fmt.Sprintf("%s-%06d", strings.Repeat("n", 55), i)] = struct{}{}
+		}
+		return out
+	}
+	path := "/apis/" + scopeTestGroup + "/v1/widgets"
+
+	big := names(20000) // about 1.2 MB joined
+	p := newScopeProxy(t, &scopefilter.Resolvers{Classify: &scopeTestClassify{set: big}}, scopeTestAPIService("v1", "widgets"), scopeTag{req: scopeSystem})
+	resp := p.get(t, path, nil)
+	if resp.StatusCode != http.StatusBadRequest {
+		t.Fatalf("status = %d, want 400", resp.StatusCode)
+	}
+	if s := readStatus(t, resp); !strings.Contains(s.Message, "20000 namespaces") || !strings.Contains(s.Message, "--scope") {
+		t.Errorf("message = %q", s.Message)
+	}
+	if calls, _, _ := p.backend.snapshot(); calls != 0 {
+		t.Fatal("the backend was called")
+	}
+
+	fits := names(10000) // about 620 KB joined
+	p = newScopeProxy(t, &scopefilter.Resolvers{Classify: &scopeTestClassify{set: fits}}, scopeTestAPIService("v1", "widgets"), scopeTag{req: scopeSystem})
+	if resp := p.get(t, path, nil); resp.StatusCode != http.StatusOK {
+		t.Fatalf("status = %d, want 200", resp.StatusCode)
+	}
+	_, headers, _ := p.backend.snapshot()
+	if got := strings.Count(headers.Get(scopefilter.HeaderScopeNamespaces), ",") + 1; got != len(fits) {
+		t.Fatalf("backend got %d namespaces, want %d", got, len(fits))
+	}
+}
