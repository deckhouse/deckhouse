+		&metrics.CounterOpts{
+			Namespace:      "apiserver",
+			Subsystem:      "scopefilter",
+			Name:           "proxied_watch_closed_total",
+			Help:           "Scoped watches of an aggregated API ended by kube-apiserver so that the client reconnects with a new allowed set of namespaces, by reason (set_changed: the recomputed set differs from the one sent, or the read is not filtered or allowed any more; refresh_failed: the set could not be recomputed for the grace period; opt_in_withdrawn: the APIService does not opt the resource in any more, or was removed).",
+			StabilityLevel: metrics.ALPHA,
+		},
+		[]string{"reason"},
+	)
+
+	proxiedHeaderLimitRejections = metrics.NewCounter(
+		&metrics.CounterOpts{
+			Namespace:      "apiserver",
+			Subsystem:      "scopefilter",
+			Name:           "proxied_header_limit_rejections_total",
+			Help:           "Scoped reads of an aggregated API refused because the allowed set of namespaces does not fit the header limit of the aggregated API server.",
+			StabilityLevel: metrics.ALPHA,
+		},
+	)
 )
 
+// RecordProxiedSet records the size of an allowed set sent to an aggregated
+// API server.
+func RecordProxiedSet(size int) { proxiedSetSize.Observe(float64(size)) }
+
+// RecordProxiedHeaderLimitRejection records a scoped read of an aggregated API
+// refused because its allowed set does not fit the header limit.
+func RecordProxiedHeaderLimitRejection() { proxiedHeaderLimitRejections.Inc() }
+
+// Reasons of RecordProxiedWatchClosed.
+const (
+	ProxiedWatchClosedSetChanged     = "set_changed"
+	ProxiedWatchClosedRefreshFailed  = "refresh_failed"
+	ProxiedWatchClosedOptInWithdrawn = "opt_in_withdrawn"
+)
+
+// RecordProxiedWatchClosed records a scoped watch of an aggregated API ended
+// by kube-apiserver for reason.
+func RecordProxiedWatchClosed(reason string) { proxiedWatchClosed.WithLabelValues(reason).Inc() }
+
+// RecordWatchRefreshFailure records a failed recomputation of the allowed set
+// of an open scoped watch of an aggregated API.
+func RecordWatchRefreshFailure() { watchRefreshFailures.Inc() }
+
 func init() {
-	legacyregistry.MustRegister(allowedSetFailures, clusterDisagreements, watchRefreshFailures, watchClosed)
+	legacyregistry.MustRegister(allowedSetFailures, clusterDisagreements, watchRefreshFailures, watchClosed, proxiedWatchClosed, proxiedSetSize, proxiedHeaderLimitRejections)
 }
