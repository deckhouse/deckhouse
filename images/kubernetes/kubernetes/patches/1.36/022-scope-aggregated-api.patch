+
+package scopefilter
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/util/validation"
+	"k8s.io/apiserver/pkg/audit"
+	"k8s.io/apiserver/pkg/authentication/user"
+)
+
+// Resources served by an aggregated API server (an APIService with a Service)
+// are not stored here: kube-aggregator only proxies them. For those,
+// kube-apiserver computes the allowed set of namespaces itself and hands it to
+// the extension server in the trusted headers below; the extension filters.
+//
+// This registry is deliberately separate from Register/IsRegistered. That set
+// means "a storage Decorator is wired, handing a denied read to the storage is
+// safe"; a proxied resource has no storage here, and a bypass routed by that
+// set would reach a proxy that forwards whatever it is given.
+//
+// The contract of an extension server that opts a resource in:
+//
+//   - It MUST honour HeaderScopeMode and HeaderScopeNamespaces only on a
+//     request authenticated by its requestheader (front-proxy) authenticator:
+//     a client certificate that chains to the requestheader client CA, a
+//     common name among the allowed names when those are configured, and a
+//     non-empty username header (X-Remote-User by default). On any other
+//     request -- a direct client, a bearer token, a client certificate of
+//     another CA -- the headers are ignored and the request is authorized as
+//     usual. kube-aggregator removes client copies of the headers only from
+//     the requests it proxies.
+//   - No HeaderScopeMode: no restriction, the request is served as usual.
+//   - HeaderScopeMode present: only objects in a namespace of
+//     HeaderScopeNamespaces are served. An empty or missing
+//     HeaderScopeNamespaces is the empty set and serves nothing; an unknown
+//     mode must be refused.
+//   - Objects without a namespace (cluster-scoped) are never in the set: a
+//     read restricted by the headers serves none of them.
+//   - ScopeModeFiltered means kube-apiserver let a read through that RBAC
+//     denied. Only under the conditions above may the extension skip its own
+//     SubjectAccessReview of the read, and only for the namespaces of the set;
+//     everything outside it stays denied. ScopeModeNarrowed comes with a read
+//     RBAC allowed, which the extension authorizes as usual.
+const (
+	// AnnotationProxiedResources opts an APIService in: comma-separated plural
+	// resource names within Spec.Group the extension server filters by the
+	// trusted headers.
+	AnnotationProxiedResources = "scope.deckhouse.io/resources"
+
+	// HeaderScopeMode tells the extension server how kube-apiserver let the
+	// read through: ScopeModeFiltered (RBAC denied it, the namespaces are the
+	// boundary of what may be served at all) or ScopeModeNarrowed (RBAC
+	// allowed it, the caller only asked to narrow the view).
+	HeaderScopeMode = "X-Deckhouse-Scope-Mode"
+
+	// HeaderScopeNamespaces carries the allowed set: sorted namespace names
+	// (DNS labels) joined by ",". It is always sent together with
+	// HeaderScopeMode. An empty value is the empty set and allows nothing; a
+	// receiver that sees HeaderScopeMode without this header must treat it
+	// the same way.
+	HeaderScopeNamespaces = "X-Deckhouse-Scope-Namespaces"
+
+	ScopeModeFiltered = "filtered"
+	ScopeModeNarrowed = "narrowed"
+)
+
+// The set sent with a proxied watch is fixed when the stream opens, so the
+// proxy recomputes it while the watch is open and ends the stream once it
+// changed; the client reconnects and gets the new set. The timeout below bounds
+// the stream even when nothing changes.
+const (
+	// DefaultProxiedWatchTimeout caps the timeoutSeconds of a scoped watch
+	// proxied to an aggregated API server.
+	DefaultProxiedWatchTimeout = 5 * time.Minute
+
+	// DefaultProxiedWatchRefreshGrace is how long a proxied watch stays open
+	// while every recomputation of its set fails, the same time a watch
+	// served from storage survives failing refreshes.
+	DefaultProxiedWatchRefreshGrace = 60 * time.Second
+)
+
+// ProxiedWatchLimits returns the tunables of a scoped watch proxied to an
+// aggregated API server: how often its set is recomputed, the cap of its
+// timeoutSeconds and how long it survives failing recomputations. A field
+// left unset gets its default.
+func (r *Resolvers) ProxiedWatchLimits() (interval, timeout, grace time.Duration) {
+	interval, timeout, grace = DefaultRefreshInterval, DefaultProxiedWatchTimeout, DefaultProxiedWatchRefreshGrace
+	if r == nil {
+		return interval, timeout, grace
+	}
+	if r.RefreshInterval > 0 {
+		interval = r.RefreshInterval
+	}
+	if r.ProxiedWatchTimeout > 0 {
+		timeout = r.ProxiedWatchTimeout
+	}
+	if r.ProxiedWatchRefreshGrace > 0 {
+		grace = r.ProxiedWatchRefreshGrace
+	}
+	return interval, timeout, grace
+}
+
+// permissionServiceGroup serves the reviews the RBAC floor is computed with.
+// A scoped read of it would compute its floor by calling itself.
+const permissionServiceGroup = "authorization.deckhouse.io"
+
+// TrustedHeaders lists the headers only kube-apiserver may set on a proxied
+// request. The proxy removes any client copy before forwarding, under any
+// spelling a receiver could read as one of them (see the contract above).
+var TrustedHeaders = []string{HeaderScopeMode, HeaderScopeNamespaces}
+
+// The audit annotations a read let through for the filter is recorded with:
+// the keys of the authorization filter (k8s.io/apiserver/pkg/endpoints/filters)
+// and the decision and reason of each path that serves such a read.
+const (
+	auditDecisionKey = "authorization.k8s.io/decision"
+	auditReasonKey   = "authorization.k8s.io/reason"
+
+	// AuditDecisionAllowScoped: the storage Decorator of this server filters.
+	AuditDecisionAllowScoped = "allow-scoped"
+	AuditReasonScoped        = "scope filtering mode"
+
+	// AuditDecisionAllowScopedProxied: an aggregated API server filters by the
+	// set kube-aggregator sends, or kube-aggregator refuses the read.
+	AuditDecisionAllowScopedProxied = "allow-scoped-proxied"
+	AuditReasonScopedProxied        = "scope filtering mode, aggregated API"
+)
+
+// AnnotateBypass records on the audit event of ctx the path that serves a read
+// let through for the filter: an aggregated API server when proxied, the
+// storage of this server otherwise. The authorization filter records it for
+// every such read; see IsProxiedVersion for a resource both stored here and
+// opted in by an APIService of another version. A decision recorded already is
+// kept: the audit context never replaces an annotation.
+func AnnotateBypass(ctx context.Context, proxied bool) {
+	decision, reason := AuditDecisionAllowScoped, AuditReasonScoped
+	if proxied {
+		decision, reason = AuditDecisionAllowScopedProxied, AuditReasonScopedProxied
+	}
+	audit.AddAuditAnnotations(ctx, auditDecisionKey, decision, auditReasonKey, reason)
+}
+
+// ParseProxiedResources parses the AnnotationProxiedResources value of an
+// APIService of group. It returns the valid entries, sorted and deduplicated,
+// and one error per entry it ignored. A group the opt-in is refused for
+// returns no resources at all.
+func ParseProxiedResources(group, value string) ([]schema.GroupResource, []error) {
+	if strings.TrimSpace(value) == "" {
+		return nil, []error{fmt.Errorf("scopefilter: empty %s annotation", AnnotationProxiedResources)}
+	}
+	if group == permissionServiceGroup {
+		return nil, []error{fmt.Errorf("scopefilter: %s cannot be scope-filtered: the RBAC floor is computed by the permission service itself", group)}
+	}
+	var errs []error
+	seen := map[string]struct{}{}
+	for _, raw := range strings.Split(value, ",") {
+		name := strings.TrimSpace(raw)
+		if name == "" {
+			errs = append(errs, fmt.Errorf("scopefilter: empty entry in %s annotation %q", AnnotationProxiedResources, value))
+			continue
+		}
+		// A resource name is a DNS label; a slash would name a subresource,
+		// which the filter never serves.
+		if msgs := validation.IsDNS1123Label(name); len(msgs) > 0 {
+			errs = append(errs, fmt.Errorf("scopefilter: invalid resource %q in %s annotation: %s", name, AnnotationProxiedResources, strings.Join(msgs, "; ")))
+			continue
+		}
+		seen[name] = struct{}{}
+	}
+	out := make([]schema.GroupResource, 0, len(seen))
+	for name := range seen {
+		out = append(out, schema.GroupResource{Group: group, Resource: name})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Resource < out[j].Resource })
+	return out, errs
+}
+
+// The proxied registry follows registry.go: written when an APIService is
+// added, updated or removed, read on every denied scoped read. Each APIService
+// owns its entry; a resource stays proxied while any APIService of its group
+// lists it, since one group can be served by several versions.
+var (
+	proxiedWriteMu sync.Mutex
+	proxiedOwners  = map[string]proxiedEntry{}
+	proxiedSnap    atomic.Pointer[proxiedSnapshot]
+)
+
+// proxiedEntry is what one APIService opted in.
+type proxiedEntry struct {
+	version string
+	grs     map[schema.GroupResource]struct{}
+}
+
+// proxiedSnapshot is the registry as the readers see it.
+type proxiedSnapshot struct {
+	byResource map[schema.GroupResource]struct{}
+	byVersion  map[schema.GroupVersionResource]struct{}
+	byOwner    map[string]proxiedEntry
+}
+
+func init() {
+	proxiedSnap.Store(&proxiedSnapshot{})
+}
+
+// RegisterProxied records grs as the resources the APIService apiServiceName,
+// of the given version of their group, opted in, replacing what it opted in
+// before. An empty grs is the same as UnregisterProxied.
+func RegisterProxied(apiServiceName, version string, grs []schema.GroupResource) {
+	proxiedWriteMu.Lock()
+	defer proxiedWriteMu.Unlock()
+	if len(grs) == 0 {
+		delete(proxiedOwners, apiServiceName)
+	} else {
+		entry := proxiedEntry{version: version, grs: make(map[schema.GroupResource]struct{}, len(grs))}
+		for _, gr := range grs {
+			entry.grs[gr] = struct{}{}
+		}
+		proxiedOwners[apiServiceName] = entry
+	}
+	publishProxiedLocked()
+}
+
+// UnregisterProxied removes what the APIService apiServiceName opted in.
+func UnregisterProxied(apiServiceName string) {
+	proxiedWriteMu.Lock()
+	defer proxiedWriteMu.Unlock()
+	if _, ok := proxiedOwners[apiServiceName]; !ok {
+		return
+	}
+	delete(proxiedOwners, apiServiceName)
+	publishProxiedLocked()
+}
+
+func publishProxiedLocked() {
+	next := &proxiedSnapshot{
+		byResource: map[schema.GroupResource]struct{}{},
+		byVersion:  map[schema.GroupVersionResource]struct{}{},
+		byOwner:    make(map[string]proxiedEntry, len(proxiedOwners)),
+	}
+	for owner, entry := range proxiedOwners {
+		next.byOwner[owner] = entry
+		for gr := range entry.grs {
+			next.byResource[gr] = struct{}{}
+			next.byVersion[gr.WithVersion(entry.version)] = struct{}{}
+		}
+	}
+	proxiedSnap.Store(next)
+}
+
+// IsProxied reports whether some APIService opted gr in. The authorization
+// filter consults it only for a resource that is not registered; the proxy
+// still checks that the APIService actually serving the request opted the
+// resource in, since this answer does not depend on the version.
+func IsProxied(gr schema.GroupResource) bool {
+	_, ok := proxiedSnap.Load().byResource[gr]
+	return ok
+}
+
+// IsProxiedVersion reports whether the APIService of the version of gvr opted
+// the resource in. For a resource both stored here and opted in by an
+// APIService of another version, it tells the authorization filter which path
+// serves a read of this version.
+func IsProxiedVersion(gvr schema.GroupVersionResource) bool {
+	_, ok := proxiedSnap.Load().byVersion[gvr]
+	return ok
+}
+
+// IsProxiedBy reports whether the APIService apiServiceName opts gr in now. The
+// refresher of an open watch checks it on every recomputation, so a watch ends
+// once the opt-in is withdrawn or the APIService is removed.
+func IsProxiedBy(apiServiceName string, gr schema.GroupResource) bool {
+	entry, ok := proxiedSnap.Load().byOwner[apiServiceName]
+	if !ok {
+		return false
+	}
+	_, ok = entry.grs[gr]
+	return ok
+}
+
+// AllowedNamespaces is the decision of the Decorator for a scoped read of gvr
+// that is served elsewhere -- by an aggregated API server, which filters by the
+// set it is sent. ctx carries the scope request and, when the authorization
+// filter bypassed a 403, the bypass tag, exactly as for a read served from
+// storage. restrict is false when neither the classification nor the RBAC
+// floor applies (an allowed caller asking for the accessible scope): nothing
+// is to be filtered, which is not the same as an empty set.
+//
+// A nil bundle is an error, so a caller without resolvers fails closed.
+func (r *Resolvers) AllowedNamespaces(ctx context.Context, u user.Info, gvr schema.GroupVersionResource, subresource, verb string) (set map[string]struct{}, restrict bool, err error) {
+	if r == nil {
+		return nil, false, errNoResolvers
+	}
+	if u == nil {
+		return nil, false, errNoUser
+	}
+	classified, hasClassified, floor, hasFloor, err := resolveScoped(ctx, r.Classify, r.Floor, r.Multitenancy, u, gvr, subresource, verb)
+	if err != nil {
+		return nil, false, err
+	}
+	set, restrict = combinedSet(classified, hasClassified, floor, hasFloor)
+	return set, restrict, nil
+}
+
+// ResolveError turns a failure of AllowedNamespaces into the answer of the
+// request, the same answer the Decorator gives: 400 for a scope the cluster
+// cannot serve, 503 with Retry-After while the permission service cannot
+// answer, 403 for everything else.
+func ResolveError(gvr schema.GroupVersionResource, u user.Info, verb, name string, err error) error {
+	cannot := errCannotList
+	switch verb {
+	case "get":
+		cannot = errCannotGet
+	case "watch":
+		cannot = errCannotWatch
+	}
+	if u == nil {
+		u = &user.DefaultInfo{}
+	}
+	return resolveError(gvr, u, verb, name, err, cannot)
+}
