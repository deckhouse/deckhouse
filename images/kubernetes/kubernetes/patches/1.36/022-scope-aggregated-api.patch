+// TestProxyScope_WatchStreamPassesThrough: a stream the writer does not frame
+// only ends when the refresher ends it, and a stream that ends on its own gets
+// what the extension server sent, an incomplete frame included.
+func TestProxyScope_WatchStreamPassesThrough(t *testing.T) {
+	t.Run("unknown media type", func(t *testing.T) {
+		waitNoRefreshers(t)
+		floor := &liveAnswer{set: nsSet("a", "b")}
+		p := newFrameProxy(t, filteredWatchResolvers(floor), &frameBackend{contentType: "application/x-custom", chunks: [][]byte{[]byte("abc"), []byte("{\"x\"")}})
+		resp := openFrameWatch(t, p, "*/*")
+		waitFor(t, p.backend.started, "the backend to stream")
+		floor.update(nsSet("a"), nil)
+		body, err := io.ReadAll(resp.Body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(body) != "abc{\"x\"" {
+			t.Fatalf("body = %q, want the bytes of the backend only", body)
+		}
+		waitNoRefreshers(t)
+	})
+
+	for _, tc := range []struct {
+		name        string
+		contentType string
+		chunks      [][]byte
+	}{
+		{name: "JSON", contentType: runtime.ContentTypeJSON, chunks: [][]byte{[]byte("{\"type\":\"ADDED\",\"object\":{\"s\":\"}\\\"{\"}}\n{\"type\""), []byte(":\"MODIFIED\"")}},
+		{name: "protobuf", contentType: protobufWatchMediaType, chunks: [][]byte{{0, 0, 0, 2, 'o', 'k', 0, 0, 0, 9, 'p', 'a'}}},
+		{name: "unparsable JSON", contentType: runtime.ContentTypeJSON, chunks: [][]byte{[]byte("[1]"), []byte("garbage")}},
+	} {
+		t.Run("ends on its own/"+tc.name, func(t *testing.T) {
+			waitNoRefreshers(t)
+			floor := &liveAnswer{set: nsSet("a", "b")}
+			p := newFrameProxy(t, filteredWatchResolvers(floor), &frameBackend{contentType: tc.contentType, chunks: tc.chunks, end: true})
+			resp := openFrameWatch(t, p, "*/*")
+			body, err := io.ReadAll(resp.Body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if want := bytes.Join(tc.chunks, nil); !bytes.Equal(body, want) {
+				t.Fatalf("body = %q, want %q", body, want)
+			}
+			waitNoRefreshers(t)
+		})
+	}
+}
