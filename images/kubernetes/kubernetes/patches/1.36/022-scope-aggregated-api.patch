+// TestProxyScope_WatchEndDoesNotWaitForASlowLoad: the end of a watch does not
+// wait for a recomputation stuck in the resolvers.
+func TestProxyScope_WatchEndDoesNotWaitForASlowLoad(t *testing.T) {
+	waitNoRefreshers(t)
+	floor := &blockingFloor{release: make(chan struct{})}
+	defer close(floor.release)
+	resolvers := &scopefilter.Resolvers{
+		Classify:                 &scopeTestClassify{set: nsSet("a", "b")},
+		Floor:                    floor,
+		RefreshInterval:          scopeWatchInterval,
+		ProxiedWatchRefreshGrace: time.Hour,
+	}
+	p := newWatchProxy(t, resolvers, filteredWatchTag, false, true)
+	s := p.watch(t, "/apis/"+scopeTestGroup+"/v1/widgets?watch=true")
+	waitUntil(t, "a recomputation to block", func() bool { return floor.calls.Load() >= 2 })
+	closed := time.Now()
+	_ = s.resp.Body.Close()
+	waitFor(t, p.backend.ended, "the backend request to end")
+	waitNoRefreshers(t)
+	if elapsed := time.Since(closed); elapsed > 2*time.Second {
+		t.Fatalf("the refresher exited %s after the client left", elapsed)
+	}
+}
