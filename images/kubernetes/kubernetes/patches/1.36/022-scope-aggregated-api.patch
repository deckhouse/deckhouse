+func spoofedScopeHeaders() http.Header {
+	return http.Header{
+		scopefilter.HeaderScopeMode:       []string{"narrowed"},
+		scopefilter.HeaderScopeNamespaces: []string{"spoofed"},
+	}
+}
+
+func readStatus(t *testing.T, resp *http.Response) metav1.Status {
+	t.Helper()
+	body, _ := io.ReadAll(resp.Body)
+	var s metav1.Status
+	if err := json.Unmarshal(body, &s); err != nil {
+		t.Fatalf("response is not a Status: %v: %s", err, body)
+	}
+	if s.Kind != "Status" || s.APIVersion != "v1" {
+		t.Fatalf("Status without kind/apiVersion v1: %s", body)
+	}
+	return s
+}
