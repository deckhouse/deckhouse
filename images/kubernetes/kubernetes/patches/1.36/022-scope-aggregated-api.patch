+	// added and removed while the test runs.
+	extGroup    = "scopeext.deckhouse.io"
+	plainGroup  = "plain.scopeext.deckhouse.io"
+	toggleGroup = "toggle.scopeext.deckhouse.io"
+	extVersion  = "v1"
+	// extVersion2 is a second version of extGroup, served by an APIService
+	// without the opt-in.
+	extVersion2 = "v2"
+	extResource = "gizmos"
