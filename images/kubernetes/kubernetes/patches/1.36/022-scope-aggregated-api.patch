+// TestProxyScope_WebsocketWatchSetChange: the hijacked connection of an
+// upgraded watch is closed when the set changes, and the backend connection
+// with it.
+func TestProxyScope_WebsocketWatchSetChange(t *testing.T) {
+	waitNoRefreshers(t)
+	floor := &liveAnswer{set: nsSet("a", "b")}
+	p := newWatchProxy(t, filteredWatchResolvers(floor), filteredWatchTag, false, true)
+	ws := dialWatch(t, p, "/apis/"+scopeTestGroup+"/v1/widgets?watch=true")
+	ended := readUntilError(ws)
+
+	calls := floor.callCount()
+	waitUntil(t, "several recomputations", func() bool { return floor.callCount() >= calls+3 })
+	select {
+	case err := <-ended:
+		t.Fatalf("the websocket ended (%v) with an unchanged set", err)
+	default:
+	}
+
+	floor.update(nsSet("a"), nil)
+	select {
+	case <-ended:
+	case <-time.After(scopeWatchDeadline):
+		t.Fatal("the websocket is still open after the set changed")
+	}
+	waitFor(t, p.backend.ended, "the backend connection to break")
+	waitNoRefreshers(t)
+}
