+func TestScopeProxiedAggregatedAPI(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+
+	ext := newExtensionBackend(t, extGroup, plainGroup, toggleGroup)
+	pb := newPermissionBrowserBackend(t)
