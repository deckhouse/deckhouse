+func TestCapWatchTimeout(t *testing.T) {
+	tests := []struct {
+		name  string
+		query string
+		want  string
+	}{
+		{name: "unset", query: "watch=true", want: "300"},
+		{name: "smaller", query: "watch=true&timeoutSeconds=30", want: "30"},
+		{name: "equal", query: "watch=true&timeoutSeconds=300", want: "300"},
+		{name: "larger", query: "watch=true&timeoutSeconds=3600", want: "300"},
+		{name: "zero asks for the server default", query: "timeoutSeconds=0", want: "300"},
+		{name: "negative", query: "timeoutSeconds=-5", want: "300"},
+		{name: "unparsable", query: "timeoutSeconds=abc", want: "300"},
+		{name: "repeated: the first value counts, one value is sent", query: "timeoutSeconds=3600&timeoutSeconds=10", want: "300"},
+		{name: "repeated, the first within the cap: one value is sent", query: "timeoutSeconds=10&timeoutSeconds=86400", want: "10"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			u := &url.URL{Path: "/apis/x/v1/widgets", RawQuery: tc.query}
+			capWatchTimeout(u, 5*time.Minute)
+			got := u.Query()["timeoutSeconds"]
+			if len(got) != 1 || got[0] != tc.want {
+				t.Fatalf("timeoutSeconds = %q, want [%s]", got, tc.want)
+			}
+		})
+	}
+	u := &url.URL{RawQuery: "timeoutSeconds=10"}
+	capWatchTimeout(u, 500*time.Millisecond)
+	if got := u.Query().Get("timeoutSeconds"); got != "1" {
+		t.Fatalf("a sub-second cap: timeoutSeconds = %q, want 1", got)
+	}
+}
