+// TestWithAuthorization_ProxiedScopeAuditAnnotations: the filter records the
+// audit decision of every bypassed read, naming the path that serves it, and a
+// later handler cannot change it. A resource with a storage Decorator that
+// another version of its group also opted in is recorded by the version: the
+// opted-in version is proxied, the stored one is served by the storage.
+func TestWithAuthorization_ProxiedScopeAuditAnnotations(t *testing.T) {
+	proxied := schema.GroupResource{Group: "proxied.example.io", Resource: "widgets"}
+	both := schema.GroupResource{Group: "proxied.example.io", Resource: "gadgets"}
+	stored := schema.GroupResource{Group: "proxied.example.io", Resource: "gizmos"}
+	registerProxiedForTest(t, "v2.proxied.example.io", proxied, both)
+	for _, gr := range []schema.GroupResource{both, stored} {
+		scopefilter.Register(gr)
+		t.Cleanup(func() { scopefilter.Unregister(gr) })
+	}
+	negotiatedSerializer := serializer.NewCodecFactory(runtime.NewScheme()).WithoutConversion()
+
+	// pathTaken stands for a handler behind the filter that tries to record
+	// the other path; nil records nothing.
+	proxiedPath, storedPath := true, false
+	tests := []struct {
+		name         string
+		path         string
+		pathTaken    *bool
+		wantDecision string
+		wantReason   string
+	}{
+		{name: "proxied only", path: "/apis/proxied.example.io/v2/widgets", wantDecision: "allow-scoped-proxied", wantReason: "scope filtering mode, aggregated API"},
+		{name: "proxied only, kept against a later handler", path: "/apis/proxied.example.io/v2/widgets", pathTaken: &storedPath, wantDecision: "allow-scoped-proxied", wantReason: "scope filtering mode, aggregated API"},
+		{name: "stored only", path: "/apis/proxied.example.io/v1/gizmos", wantDecision: "allow-scoped", wantReason: "scope filtering mode"},
+		{name: "stored only, kept against a later handler", path: "/apis/proxied.example.io/v1/gizmos", pathTaken: &proxiedPath, wantDecision: "allow-scoped", wantReason: "scope filtering mode"},
+		{name: "both, the stored version", path: "/apis/proxied.example.io/v1/gadgets", wantDecision: "allow-scoped", wantReason: "scope filtering mode"},
+		{name: "both, the opted-in version", path: "/apis/proxied.example.io/v2/gadgets", wantDecision: "allow-scoped-proxied", wantReason: "scope filtering mode, aggregated API"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			sink := &fakeAuditSink{}
+			var inner http.Handler = &scopeTestHandler{}
+			if tc.pathTaken != nil {
+				next := inner
+				inner = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					scopefilter.AnnotateBypass(r.Context(), *tc.pathTaken)
+					next.ServeHTTP(w, r)
+				})
+			}
+			handler := WithAudit(
+				WithAuthorization(inner, denyAllAuthorizer(), negotiatedSerializer),
+				sink,
+				policy.NewFakePolicyRuleEvaluator(auditinternal.LevelMetadata, nil),
+				nil,
+			)
+			handler.ServeHTTP(httptest.NewRecorder(), newScopeTestRequest(t, http.MethodGet, tc.path, "system"))
+			events := sink.Events()
+			if len(events) == 0 {
+				t.Fatal("no audit event was written")
+			}
+			annotations := events[len(events)-1].Annotations
+			if got := annotations["authorization.k8s.io/decision"]; got != tc.wantDecision {
+				t.Errorf("decision annotation = %q, want %q", got, tc.wantDecision)
+			}
+			if got := annotations["authorization.k8s.io/reason"]; got != tc.wantReason {
+				t.Errorf("reason annotation = %q, want %q", got, tc.wantReason)
+			}
+		})
+	}
+}
