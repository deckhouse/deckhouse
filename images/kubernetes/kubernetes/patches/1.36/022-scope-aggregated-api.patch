+// --- fake extension server -------------------------------------------------
+
+// extRequest is what the extension backend saw of one resource request.
+type extRequest struct {
+	Method   string
+	Path     string
+	RawQuery string
+	TestID   string
+	User     string
+	Header   http.Header
+	PeerCert *x509.Certificate
+}
+
+// extensionBackend is a recording aggregated API server serving the namespaced
+// resource gizmos in each of its groups: discovery for availability, an empty
+// list, a stub object for a get, and a watch held open until the client or
+// kube-apiserver ends it.
+type extensionBackend struct {
+	srv    *httptest.Server
+	groups map[string]bool
+
+	mu      sync.Mutex
+	records []extRequest
+	// watchDone is closed when the backend handler of the watch with that
+	// test ID returns.
+	watchDone map[string]chan struct{}
+
+	stop chan struct{}
+}
+
+func newExtensionBackend(t *testing.T, groups ...string) *extensionBackend {
+	b := &extensionBackend{
+		groups:    map[string]bool{},
+		watchDone: map[string]chan struct{}{},
+		stop:      make(chan struct{}),
+	}
+	for _, g := range groups {
+		b.groups[g] = true
+	}
+	b.srv = httptest.NewUnstartedServer(http.HandlerFunc(b.serve))
+	b.srv.TLS = &tls.Config{ClientAuth: tls.RequestClientCert}
+	t.Cleanup(func() {
+		close(b.stop)
+		b.srv.CloseClientConnections()
+		b.srv.Close()
+	})
+	return b
+}
+
+func (b *extensionBackend) serve(w http.ResponseWriter, r *http.Request) {
+	parts := strings.Split(strings.Trim(r.URL.Path, "/"), "/")
+	if len(parts) < 3 || parts[0] != "apis" || !b.groups[parts[1]] || (parts[2] != extVersion && parts[2] != extVersion2) {
+		http.NotFound(w, r)
+		return
+	}
+	group, version := parts[1], parts[2]
+	rest := parts[3:]
+	if len(rest) == 0 {
+		writeJSON(w, http.StatusOK, metav1.APIResourceList{
+			TypeMeta:     metav1.TypeMeta{Kind: "APIResourceList", APIVersion: "v1"},
+			GroupVersion: group + "/" + version,
+			APIResources: []metav1.APIResource{{
+				Name:         extResource,
+				SingularName: "gizmo",
+				Namespaced:   true,
+				Kind:         "Gizmo",
+				Verbs:        metav1.Verbs{"get", "list", "watch"},
+			}},
+		})
+		return
+	}
+	namespace, name := "", ""
+	switch {
+	case len(rest) == 1 && rest[0] == extResource:
+	case len(rest) == 2 && rest[0] == extResource:
+		name = rest[1]
+	case len(rest) == 3 && rest[0] == "namespaces" && rest[2] == extResource:
+		namespace = rest[1]
+	case len(rest) == 4 && rest[0] == "namespaces" && rest[2] == extResource:
+		namespace, name = rest[1], rest[3]
+	default:
+		http.NotFound(w, r)
+		return
+	}
+
+	rec := extRequest{
+		Method:   r.Method,
+		Path:     r.URL.Path,
+		RawQuery: r.URL.RawQuery,
+		TestID:   r.Header.Get(testIDHeader),
+		User:     r.Header.Get("X-Remote-User"),
+		Header:   r.Header.Clone(),
+	}
+	if r.TLS != nil && len(r.TLS.PeerCertificates) > 0 {
+		rec.PeerCert = r.TLS.PeerCertificates[0]
+	}
+	watching := r.URL.Query().Get("watch") == "true" || r.URL.Query().Get("watch") == "1"
+	var done chan struct{}
+	b.mu.Lock()
+	b.records = append(b.records, rec)
+	if watching {
+		done = make(chan struct{})
+		b.watchDone[rec.TestID] = done
+	}
+	b.mu.Unlock()
+
+	apiVersion := group + "/" + version
+	switch {
+	case watching:
+		defer close(done)
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+		if f, ok := w.(http.Flusher); ok {
+			f.Flush()
+		}
+		select {
+		case <-r.Context().Done():
+		case <-b.stop:
+		}
+	case name != "":
+		writeJSON(w, http.StatusOK, map[string]any{
+			"apiVersion": apiVersion,
+			"kind":       "Gizmo",
+			"metadata":   map[string]any{"name": name, "namespace": namespace},
+		})
+	default:
+		writeJSON(w, http.StatusOK, map[string]any{
+			"apiVersion": apiVersion,
+			"kind":       "GizmoList",
+			"metadata":   map[string]any{},
+			"items":      []any{},
+		})
+	}
+}
+
+func (b *extensionBackend) byID(id string) []extRequest {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	var out []extRequest
+	for _, r := range b.records {
+		if r.TestID == id {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+func (b *extensionBackend) requireOne(t *testing.T, id string) extRequest {
+	t.Helper()
+	recs := b.byID(id)
+	if len(recs) != 1 {
+		t.Fatalf("the extension backend got %d requests tagged %s, want 1: %+v", len(recs), id, recs)
+	}
+	return recs[0]
+}
+
+func (b *extensionBackend) requireNone(t *testing.T, id string) {
+	t.Helper()
+	if recs := b.byID(id); len(recs) != 0 {
+		t.Fatalf("the extension backend got %d requests tagged %s, want none: %+v", len(recs), id, recs)
+	}
+}
+
+// --- fake permission-browser -----------------------------------------------
+
+// The JSON shape of SelfScopedAccessReview, as permission-browser-apiserver
+// serves it.
+type selfScopedAccessReviewJSON struct {
+	APIVersion string `json:"apiVersion"`
+	Kind       string `json:"kind"`
+	Spec       struct {
+		Scope    string `json:"scope"`
+		Requests []struct {
+			Group             string   `json:"group,omitempty"`
+			Resource          string   `json:"resource"`
+			Subresource       string   `json:"subresource,omitempty"`
+			Verbs             []string `json:"verbs"`
+			IncludeNamespaces bool     `json:"includeNamespaces"`
+		} `json:"requests"`
+	} `json:"spec"`
+	Status struct {
+		Results []scopedAccessResultJSON `json:"results"`
+	} `json:"status"`
+}
+
+type scopedAccessResultJSON struct {
+	Allowed         bool     `json:"allowed"`
+	Cluster         bool     `json:"cluster,omitempty"`
+	Namespaces      []string `json:"namespaces"`
+	Reason          string   `json:"reason,omitempty"`
+	EvaluationError string   `json:"evaluationError,omitempty"`
+}
+
+// reviewAnswer is the canned answer to the reviews of one user: an error
+// status, or one result.
+type reviewAnswer struct {
+	status int
+	result scopedAccessResultJSON
+}
+
+type recordedReview struct {
+	User     string
+	Review   selfScopedAccessReviewJSON
+	PeerCert *x509.Certificate
+}
+
+// permissionBrowserBackend fakes permission-browser-apiserver: it answers
+// SelfScopedAccessReview per X-Remote-User with a canned answer. A user without
+// one is allowed nowhere.
+type permissionBrowserBackend struct {
+	srv *httptest.Server
+
+	mu      sync.Mutex
+	answers map[string]reviewAnswer
+	reviews []recordedReview
+}
+
+func newPermissionBrowserBackend(t *testing.T) *permissionBrowserBackend {
+	b := &permissionBrowserBackend{answers: map[string]reviewAnswer{}}
+	b.srv = httptest.NewUnstartedServer(http.HandlerFunc(b.serve))
+	b.srv.TLS = &tls.Config{ClientAuth: tls.RequestClientCert}
+	t.Cleanup(func() {
+		b.srv.CloseClientConnections()
+		b.srv.Close()
+	})
+	return b
+}
+
+// setFloor makes the reviews of user answer the namespaces.
+func (b *permissionBrowserBackend) setFloor(user string, namespaces ...string) {
+	if namespaces == nil {
+		namespaces = []string{}
+	}
+	b.setAnswer(user, reviewAnswer{result: scopedAccessResultJSON{Allowed: len(namespaces) > 0, Namespaces: namespaces}})
+}
+
+// setAnswer sets the answer to the reviews of user. Changing the answer of a
+// user with an open watch is how a revocation case would drive the refresher.
+func (b *permissionBrowserBackend) setAnswer(user string, answer reviewAnswer) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.answers[user] = answer
+}
+
+func (b *permissionBrowserBackend) serve(w http.ResponseWriter, r *http.Request) {
+	base := "/apis/" + pbGroup + "/" + pbVersion
+	switch {
+	case r.URL.Path == base && r.Method == http.MethodGet:
+		writeJSON(w, http.StatusOK, metav1.APIResourceList{
+			TypeMeta:     metav1.TypeMeta{Kind: "APIResourceList", APIVersion: "v1"},
+			GroupVersion: pbGroup + "/" + pbVersion,
+			APIResources: []metav1.APIResource{{
+				Name:         pbResource,
+				SingularName: "selfscopedaccessreview",
+				Kind:         "SelfScopedAccessReview",
+				Verbs:        metav1.Verbs{"create"},
+			}},
+		})
+		return
+	case r.URL.Path == base+"/"+pbResource && r.Method == http.MethodPost:
+	default:
+		http.NotFound(w, r)
+		return
+	}
+
+	var review selfScopedAccessReviewJSON
+	if err := json.NewDecoder(r.Body).Decode(&review); err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	user := r.Header.Get("X-Remote-User")
+	rec := recordedReview{User: user, Review: review}
+	if r.TLS != nil && len(r.TLS.PeerCertificates) > 0 {
+		rec.PeerCert = r.TLS.PeerCertificates[0]
+	}
+	b.mu.Lock()
+	b.reviews = append(b.reviews, rec)
+	answer, ok := b.answers[user]
+	b.mu.Unlock()
+	if !ok {
+		answer = reviewAnswer{result: scopedAccessResultJSON{Namespaces: []string{}}}
+	}
+	if answer.status != 0 {
+		http.Error(w, "permission-browser failure injected by the test", answer.status)
+		return
+	}
+	review.Status.Results = nil
+	for range review.Spec.Requests {
+		review.Status.Results = append(review.Status.Results, answer.result)
+	}
+	writeJSON(w, http.StatusCreated, review)
+}
+
+func (b *permissionBrowserBackend) reviewsOf(user string) []recordedReview {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	var out []recordedReview
+	for _, r := range b.reviews {
+		if r.User == user {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+// requireReviews requires that every review of user asked for gizmos of
+// extGroup in the accessible scope, with the namespaces, for verb -- the
+// actual verb of the read, as the security invariant of the floor demands.
+func (b *permissionBrowserBackend) requireReviews(t *testing.T, user, verb string) {
+	t.Helper()
+	reviews := b.reviewsOf(user)
+	if len(reviews) == 0 {
+		t.Fatalf("the permission-browser got no review of %s", user)
+	}
+	for _, rec := range reviews {
+		r := rec.Review
+		if r.Kind != "SelfScopedAccessReview" || r.APIVersion != pbGroup+"/"+pbVersion || r.Spec.Scope != "accessible" || len(r.Spec.Requests) != 1 {
+			t.Fatalf("review of %s: unexpected %+v", user, r)
+		}
+		req := r.Spec.Requests[0]
+		if req.Group != extGroup || req.Resource != extResource || req.Subresource != "" || len(req.Verbs) != 1 || req.Verbs[0] != verb || !req.IncludeNamespaces {
+			t.Fatalf("review of %s: request %+v, want %s/%s verb %s with namespaces", user, req, extGroup, extResource, verb)
+		}
+	}
+}
+
+// --- scoped watch ----------------------------------------------------------
+
+// scopedWatch is a watch held open from a client through kube-apiserver to
+// the extension backend. backendRequest is what the backend received;
+// backendDone is closed when the backend handler returns, which is how a
+// revocation case can observe kube-apiserver ending the watch (change the
+// floor with permissionBrowserBackend.setAnswer, then waitBackendClosed).
+type scopedWatch struct {
+	backendRequest extRequest
+	backendDone    <-chan struct{}
+	resp           *http.Response
+	cancel         context.CancelFunc
+}
+
+// openScopedWatch opens a watch of path with the scope headers and returns
+// once the backend has received it.
+func openScopedWatch(ctx context.Context, t *testing.T, c *rawCaller, ext *extensionBackend, path, id string, headers map[string]string) *scopedWatch {
+	t.Helper()
+	watchCtx, cancel := context.WithCancel(ctx)
+	resp, err := c.do(watchCtx, http.MethodGet, path, id, headers, nil)
+	if err != nil {
+		cancel()
+		t.Fatalf("open watch %s: %v", path, err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		body, _ := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		cancel()
+		t.Fatalf("open watch %s: status %d: %s", path, resp.StatusCode, body)
+	}
+	w := &scopedWatch{resp: resp, cancel: cancel}
+	t.Cleanup(w.close)
+	w.backendRequest = ext.requireOne(t, id)
+	ext.mu.Lock()
+	w.backendDone = ext.watchDone[id]
+	ext.mu.Unlock()
+	return w
+}
+
+func (w *scopedWatch) close() {
+	w.cancel()
+	_ = w.resp.Body.Close()
+}
+
+// waitBackendClosed reports whether the backend handler of the watch returned
+// within timeout.
+func (w *scopedWatch) waitBackendClosed(timeout time.Duration) bool {
+	select {
+	case <-w.backendDone:
+		return true
+	case <-time.After(timeout):
+		return false
+	}
+}
+
+// requireExpiredEvent reads a JSON watch stream until its next event, which
+// must be ERROR with 410 Expired, followed by the end of the stream.
+func requireExpiredEvent(t *testing.T, body io.Reader, timeout time.Duration) {
+	t.Helper()
+	type result struct {
+		event metav1.WatchEvent
+		err   error
+		rest  []byte
+	}
+	done := make(chan result, 1)
+	go func() {
+		dec := json.NewDecoder(body)
+		var r result
+		r.err = dec.Decode(&r.event)
+		if r.err == nil {
+			rest, _ := io.ReadAll(io.MultiReader(dec.Buffered(), body))
+			r.rest = rest
+		}
+		done <- r
+	}()
+	select {
+	case r := <-done:
+		if r.err != nil {
+			t.Fatalf("reading the watch: %v", r.err)
+		}
+		if r.event.Type != "ERROR" {
+			t.Fatalf("event %s, want ERROR", r.event.Type)
+		}
+		var status metav1.Status
+		if err := json.Unmarshal(r.event.Object.Raw, &status); err != nil {
+			t.Fatalf("the ERROR event carries no Status: %v: %s", err, r.event.Object.Raw)
+		}
+		if status.Kind != "Status" || status.Code != http.StatusGone || status.Reason != metav1.StatusReasonExpired {
+			t.Fatalf("Status = %s %d %s, want Status 410 Expired", status.Kind, status.Code, status.Reason)
+		}
+		if strings.TrimSpace(string(r.rest)) != "" {
+			t.Fatalf("the stream went on after the ERROR event: %q", r.rest)
+		}
+	case <-time.After(timeout):
+		t.Fatal("the watch did not end after its set changed")
+	}
+}
+
+// --- clients and helpers ---------------------------------------------------
+
+// rawCaller sends requests as one impersonated user over HTTP/1.1: the Go
+// HTTP/2 client refuses a request with a Connection header naming anything
+// but close or keep-alive, and the spoofing cases need one.
+type rawCaller struct {
+	client *http.Client
+	host   string
+}
+
+func newRawCaller(t *testing.T, base *restclient.Config, user string) *rawCaller {
+	t.Helper()
+	cfg := restclient.CopyConfig(base)
+	cfg.TLSClientConfig.NextProtos = []string{"http/1.1"}
+	cfg.Impersonate = restclient.ImpersonationConfig{UserName: user}
+	client, err := restclient.HTTPClientFor(cfg)
+	if err != nil {
+		t.Fatalf("build client for %s: %v", user, err)
+	}
+	host := cfg.Host
+	if !strings.Contains(host, "://") {
+		host = "https://" + host
+	}
+	return &rawCaller{client: client, host: strings.TrimSuffix(host, "/")}
+}
+
+func (c *rawCaller) do(ctx context.Context, method, path, id string, headers map[string]string, body []byte) (*http.Response, error) {
+	var reader io.Reader
+	if body != nil {
+		reader = strings.NewReader(string(body))
+	}
+	req, err := http.NewRequestWithContext(ctx, method, c.host+path, reader)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Accept", "application/json")
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	req.Header.Set(testIDHeader, id)
+	for k, v := range headers {
+		req.Header.Set(k, v)
+	}
+	return c.client.Do(req)
+}
+
+// get sends a GET and returns the status, body and headers of the response;
+// a transport error is status 0 with the error as body.
+func (c *rawCaller) get(ctx context.Context, path, id string, headers map[string]string) (int, string, http.Header) {
+	return c.roundTrip(ctx, http.MethodGet, path, id, headers, nil)
+}
+
+func (c *rawCaller) post(ctx context.Context, path, id string, body []byte) (int, string, http.Header) {
+	return c.roundTrip(ctx, http.MethodPost, path, id, nil, body)
+}
+
+func (c *rawCaller) roundTrip(ctx context.Context, method, path, id string, headers map[string]string, body []byte) (int, string, http.Header) {
+	resp, err := c.do(ctx, method, path, id, headers, body)
+	if err != nil {
+		return 0, err.Error(), nil
+	}
+	defer func() { _ = resp.Body.Close() }()
+	raw, _ := io.ReadAll(resp.Body)
+	return resp.StatusCode, string(raw), resp.Header
+}
+
+// testIDs hands out request tags unique within the test.
+type testIDs struct{ n atomic.Int64 }
+
+func (i *testIDs) next() string { return fmt.Sprintf("req-%d", i.n.Add(1)) }
+
+// backendResolver resolves "<namespace>/<name>" of a Service to a backend URL.
+type backendResolver map[string]string
+
+func (r backendResolver) ResolveEndpoint(namespace, name string, port int32) (*url.URL, error) {
+	u, ok := r[namespace+"/"+name]
+	if !ok {
+		return nil, fmt.Errorf("no test backend for service %s/%s", namespace, name)
+	}
+	return url.Parse(u)
+}
+
+func requireScope(t *testing.T, rec extRequest, mode string, namespaces ...string) {
+	t.Helper()
+	sort.Strings(namespaces)
+	if got := rec.Header.Values(scopeModeHeader); len(got) != 1 || got[0] != mode {
+		t.Errorf("%s of %s = %q, want [%q]", scopeModeHeader, rec.Path, got, mode)
+	}
+	want := strings.Join(namespaces, ",")
+	if got := rec.Header.Values(scopeNamespacesHeader); len(got) != 1 || got[0] != want {
+		t.Errorf("%s of %s = %q, want [%q]", scopeNamespacesHeader, rec.Path, got, want)
+	}
+}
+
+func requireNoScope(t *testing.T, rec extRequest) {
+	t.Helper()
+	for _, h := range []string{scopeModeHeader, scopeNamespacesHeader} {
+		if got, ok := rec.Header[http.CanonicalHeaderKey(h)]; ok {
+			t.Errorf("%s of %s = %q, want no such header", h, rec.Path, got)
+		}
+	}
+}
+
+// requirePeerFrontProxy requires that the backend was called with the
+// front-proxy client certificate of kube-apiserver, signed by the CA
+// extension servers are told to trust for X-Remote-User.
+func requirePeerFrontProxy(t *testing.T, cert *x509.Certificate, roots *x509.CertPool) {
+	t.Helper()
+	if cert == nil {
+		t.Fatal("the backend was called without a client certificate")
+	}
+	if cert.Subject.CommonName != frontProxyCN {
+		t.Errorf("client certificate CN = %q, want %q", cert.Subject.CommonName, frontProxyCN)
+	}
+	if _, err := cert.Verify(x509.VerifyOptions{Roots: roots, KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth}}); err != nil {
+		t.Errorf("client certificate does not verify against the request-header client CA: %v", err)
+	}
+}
+
+func loadCertPool(t *testing.T, file string) *x509.CertPool {
+	t.Helper()
+	pem, err := os.ReadFile(file)
+	if err != nil {
+		t.Fatalf("read %s: %v", file, err)
+	}
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(pem) {
+		t.Fatalf("no certificates in %s", file)
+	}
+	return pool
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+func createNamespace(ctx context.Context, t *testing.T, admin clientset.Interface, name string, labels map[string]string) {
+	t.Helper()
+	if _, err := admin.CoreV1().Namespaces().Create(ctx, &corev1.Namespace{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Labels: labels},
+	}, metav1.CreateOptions{}); err != nil {
+		t.Fatalf("create namespace %s: %v", name, err)
+	}
+}
+
+func liveNamespaces(ctx context.Context, t *testing.T, admin clientset.Interface, keep func(string) bool) []string {
+	t.Helper()
+	list, err := admin.CoreV1().Namespaces().List(ctx, metav1.ListOptions{})
+	if err != nil {
+		t.Fatalf("list namespaces: %v", err)
+	}
+	var out []string
+	for _, ns := range list.Items {
+		if keep(ns.Name) {
+			out = append(out, ns.Name)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+// createProxiedRBAC lets every authenticated user create the reviews (as
+// Deckhouse does; without it the floor review itself is denied) and lets
+// allowedUser read gizmos of every extension group.
+func createProxiedRBAC(ctx context.Context, t *testing.T, admin clientset.Interface) {
+	t.Helper()
+	roles := []*rbacv1.ClusterRole{
+		{
+			ObjectMeta: metav1.ObjectMeta{Name: "scopeext-review"},
+			Rules: []rbacv1.PolicyRule{{
+				APIGroups: []string{pbGroup},
+				Resources: []string{pbResource},
+				Verbs:     []string{"create"},
+			}},
+		},
+		{
+			ObjectMeta: metav1.ObjectMeta{Name: "scopeext-gizmo-reader"},
+			Rules: []rbacv1.PolicyRule{{
+				APIGroups: []string{extGroup, plainGroup, toggleGroup},
+				Resources: []string{extResource},
+				Verbs:     []string{"get", "list", "watch"},
+			}},
+		},
+	}
+	bindings := []*rbacv1.ClusterRoleBinding{
+		{
+			ObjectMeta: metav1.ObjectMeta{Name: "scopeext-review"},
+			RoleRef:    rbacv1.RoleRef{APIGroup: rbacv1.GroupName, Kind: "ClusterRole", Name: "scopeext-review"},
+			Subjects:   []rbacv1.Subject{{APIGroup: rbacv1.GroupName, Kind: rbacv1.GroupKind, Name: "system:authenticated"}},
+		},
+		{
+			ObjectMeta: metav1.ObjectMeta{Name: "scopeext-gizmo-reader"},
+			RoleRef:    rbacv1.RoleRef{APIGroup: rbacv1.GroupName, Kind: "ClusterRole", Name: "scopeext-gizmo-reader"},
+			Subjects:   []rbacv1.Subject{{APIGroup: rbacv1.GroupName, Kind: rbacv1.UserKind, Name: allowedUser}},
+		},
+	}
+	for _, role := range roles {
+		if _, err := admin.RbacV1().ClusterRoles().Create(ctx, role, metav1.CreateOptions{}); err != nil {
+			t.Fatalf("create ClusterRole %s: %v", role.Name, err)
+		}
+	}
+	for _, binding := range bindings {
+		if _, err := admin.RbacV1().ClusterRoleBindings().Create(ctx, binding, metav1.CreateOptions{}); err != nil {
+			t.Fatalf("create ClusterRoleBinding %s: %v", binding.Name, err)
+		}
+	}
+}
