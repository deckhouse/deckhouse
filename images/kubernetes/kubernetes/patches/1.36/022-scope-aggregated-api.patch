+// setAPIServiceAnnotation sets the opt-in annotation of the APIService to
+// value, or removes it when value is empty.
+func setAPIServiceAnnotation(ctx context.Context, t *testing.T, aggregator aggregatorclient.Interface, name, value string) {
+	t.Helper()
+	if err := retry.RetryOnConflict(retry.DefaultRetry, func() error {
+		apiService, err := aggregator.ApiregistrationV1().APIServices().Get(ctx, name, metav1.GetOptions{})
+		if err != nil {
+			return err
+		}
+		if value == "" {
+			delete(apiService.Annotations, proxiedAnnotation)
+		} else {
+			if apiService.Annotations == nil {
+				apiService.Annotations = map[string]string{}
+			}
+			apiService.Annotations[proxiedAnnotation] = value
+		}
+		_, err = aggregator.ApiregistrationV1().APIServices().Update(ctx, apiService, metav1.UpdateOptions{})
+		return err
+	}); err != nil {
+		t.Fatalf("update APIService %s: %v", name, err)
+	}
+}
+
+// pollUntil polls cond until it holds, failing the test with the last detail
+// after a minute.
+func pollUntil(ctx context.Context, t *testing.T, what string, cond func() (bool, string)) {
+	t.Helper()
+	var last string
+	if err := wait.PollUntilContextTimeout(ctx, 250*time.Millisecond, time.Minute, true, func(context.Context) (bool, error) {
+		ok, detail := cond()
+		last = detail
+		return ok, nil
+	}); err != nil {
+		t.Fatalf("waiting for %s: %v; last: %s", what, err, last)
+	}
+}
