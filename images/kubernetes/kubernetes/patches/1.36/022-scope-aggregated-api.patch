+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/runtime/serializer/streaming"
+	"k8s.io/apimachinery/pkg/watch"
+	"k8s.io/apiserver/pkg/authentication/user"
+	"k8s.io/apiserver/pkg/registry/generic/scopefilter"
+	clientfeatures "k8s.io/client-go/features"
+	clientfeaturestesting "k8s.io/client-go/features/testing"
+	restclient "k8s.io/client-go/rest"
+	restclientwatch "k8s.io/client-go/rest/watch"
+	"k8s.io/client-go/tools/cache"
+	apiregistration "k8s.io/kube-aggregator/pkg/apis/apiregistration/v1"
+	aggregatorscheme "k8s.io/kube-aggregator/pkg/apiserver/scheme"
+)
+
+const protobufWatchMediaType = runtime.ContentTypeProtobuf + ";stream=watch"
+
+// testWatchObject is an object of the aggregator scheme, so the watch decoder
+// of client-go decodes the events the test backend sends.
+func testWatchObject(name string) *apiregistration.APIService {
+	return &apiregistration.APIService{
+		TypeMeta:   metav1.TypeMeta{Kind: "APIService", APIVersion: apiregistration.SchemeGroupVersion.String()},
+		ObjectMeta: metav1.ObjectMeta{Name: name, ResourceVersion: "2"},
+	}
+}
+
+// encodeTestWatchEvent frames an event as the watch handler of an API server
+// does for mediaType.
+func encodeTestWatchEvent(t *testing.T, mediaType string, eventType watch.EventType, obj runtime.Object) []byte {
+	t.Helper()
+	base, _, err := mime.ParseMediaType(mediaType)
+	if err != nil {
+		t.Fatal(err)
+	}
+	info, ok := runtime.SerializerInfoForMediaType(aggregatorscheme.Codecs.SupportedMediaTypes(), base)
+	if !ok {
+		t.Fatalf("no serializer for %s", mediaType)
+	}
+	embedded, err := runtime.Encode(aggregatorscheme.Codecs.EncoderForVersion(info.Serializer, apiregistration.SchemeGroupVersion), obj)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var encoded, out bytes.Buffer
+	if err := info.StreamSerializer.Serializer.Encode(&metav1.WatchEvent{Type: string(eventType), Object: runtime.RawExtension{Raw: embedded}}, &encoded); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := info.StreamSerializer.Framer.NewFrameWriter(&out).Write(encoded.Bytes()); err != nil {
+		t.Fatal(err)
+	}
+	return out.Bytes()
+}
+
+// frameBackend is an extension server that streams the bytes it is given in
+// the content type it is given, then holds the watch open until the request
+// ends, or returns at once when end is set.
+type frameBackend struct {
+	contentType string
+	chunks      [][]byte
+	end         bool
+
+	started chan struct{}
+	ended   chan struct{}
+}
+
+func (b *frameBackend) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	defer func() { b.ended <- struct{}{} }()
+	w.Header().Set("Content-Type", b.contentType)
+	w.WriteHeader(http.StatusOK)
+	for _, chunk := range b.chunks {
+		_, _ = w.Write(chunk)
+		w.(http.Flusher).Flush()
+		// Separate reads on the proxy side.
+		time.Sleep(time.Millisecond)
+	}
+	b.started <- struct{}{}
+	if b.end {
+		return
+	}
+	<-r.Context().Done()
+}
+
+type frameProxy struct {
+	server  *httptest.Server
+	handler *proxyHandler
+	backend *frameBackend
+}
+
+func newFrameProxy(t *testing.T, resolvers *scopefilter.Resolvers, backend *frameBackend) *frameProxy {
+	t.Helper()
+	backend.started = make(chan struct{}, 16)
+	backend.ended = make(chan struct{}, 16)
+	backendServer := httptest.NewUnstartedServer(backend)
+	backendServer.EnableHTTP2 = true
+	startTestTLS(t, backendServer)
+	h := newScopeWatchHandler(t, resolvers, backendServer)
+	srv := httptest.NewServer(contextHandler(withScopeTag(h, filteredWatchTag), scopeTestUser))
+	t.Cleanup(srv.Close)
+	return &frameProxy{server: srv, handler: h, backend: backend}
+}
+
+// startTestTLS starts srv with the serving certificate the proxy trusts.
+func startTestTLS(t *testing.T, srv *httptest.Server) {
+	t.Helper()
+	cert, err := tls.X509KeyPair(svcCrt, svcKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv.TLS = &tls.Config{Certificates: []tls.Certificate{cert}}
+	srv.StartTLS()
+	t.Cleanup(srv.Close)
+}
+
+// watchDecoder decodes a watch response as client-go does.
+func watchDecoder(t *testing.T, mediaType string, body io.ReadCloser) *restclientwatch.Decoder {
+	t.Helper()
+	info, ok := runtime.SerializerInfoForMediaType(aggregatorscheme.Codecs.SupportedMediaTypes(), mediaType)
+	if !ok {
+		t.Fatalf("no serializer for %s", mediaType)
+	}
+	frames := info.StreamSerializer.Framer.NewFrameReader(body)
+	return restclientwatch.NewDecoder(streaming.NewDecoder(frames, info.StreamSerializer.Serializer), aggregatorscheme.Codecs.UniversalDeserializer())
+}
+
+type decoded struct {
+	eventType watch.EventType
+	obj       runtime.Object
+	err       error
+}
+
+func decodeAsync(d *restclientwatch.Decoder) <-chan decoded {
+	out := make(chan decoded, 1)
+	go func() {
+		eventType, obj, err := d.Decode()
+		out <- decoded{eventType, obj, err}
+	}()
+	return out
+}
+
+func nextEvent(t *testing.T, d *restclientwatch.Decoder) decoded {
+	t.Helper()
+	select {
+	case e := <-decodeAsync(d):
+		return e
+	case <-time.After(scopeWatchDeadline):
+		t.Fatal("timed out waiting for a watch event")
+		return decoded{}
+	}
+}
+
+func openFrameWatch(t *testing.T, p *frameProxy, accept string) *http.Response {
+	t.Helper()
+	req, err := http.NewRequest(http.MethodGet, p.server.URL+"/apis/"+scopeTestGroup+"/v1/widgets?watch=true", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("Accept", accept)
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = resp.Body.Close() })
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("status = %d", resp.StatusCode)
+	}
+	return resp
+}
+
+// requireExpired checks the event that ends a watch the refresher ended.
+func requireExpired(t *testing.T, e decoded) {
+	t.Helper()
+	if e.err != nil {
+		t.Fatalf("decoding the last event: %v", e.err)
+	}
+	if e.eventType != watch.Error {
+		t.Fatalf("last event = %s %T, want ERROR", e.eventType, e.obj)
+	}
+	status, ok := e.obj.(*metav1.Status)
+	if !ok {
+		t.Fatalf("ERROR event carries %T, want a Status", e.obj)
+	}
+	if status.Code != http.StatusGone || status.Reason != metav1.StatusReasonExpired {
+		t.Fatalf("Status = %d %s, want 410 Expired", status.Code, status.Reason)
+	}
+	if err := apierrors.FromObject(status); !apierrors.IsResourceExpired(err) {
+		t.Fatalf("client-go reads %v, which a reflector does not list again on", err)
+	}
+}
+
+// TestProxyScope_WatchEndsWithExpired: a plain watch the refresher ends gets
+// an ERROR event with 410 Expired in the framing of its stream, after the last
+// whole event: a frame the extension server had only started is dropped
+// rather than split.
+func TestProxyScope_WatchEndsWithExpired(t *testing.T) {
+	for _, mediaType := range []string{runtime.ContentTypeJSON, runtime.ContentTypeProtobuf} {
+		for _, partial := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/partialFrame=%v", mediaType, partial), func(t *testing.T) {
+				waitNoRefreshers(t)
+				contentType := mediaType
+				if mediaType == runtime.ContentTypeProtobuf {
+					contentType = protobufWatchMediaType
+				}
+				first := encodeTestWatchEvent(t, contentType, watch.Added, testWatchObject("first"))
+				second := encodeTestWatchEvent(t, contentType, watch.Added, testWatchObject("second"))
+				// The first event arrives in two writes, so the writer
+				// holds a frame back at least once.
+				chunks := [][]byte{first[:len(first)/2], first[len(first)/2:]}
+				if partial {
+					chunks = append(chunks, second[:len(second)/2])
+				}
+				floor := &liveAnswer{set: nsSet("a", "b")}
+				p := newFrameProxy(t, filteredWatchResolvers(floor), &frameBackend{contentType: contentType, chunks: chunks})
+				resp := openFrameWatch(t, p, mediaType)
+				waitFor(t, p.backend.started, "the backend to stream")
+				d := watchDecoder(t, mediaType, resp.Body)
+				e := nextEvent(t, d)
+				if e.err != nil || e.eventType != watch.Added || e.obj.(*apiregistration.APIService).Name != "first" {
+					t.Fatalf("first event = %s %v (%v)", e.eventType, e.obj, e.err)
+				}
+
+				floor.update(nsSet("a"), nil)
+				requireExpired(t, nextEvent(t, d))
+				if e := nextEvent(t, d); !errors.Is(e.err, io.EOF) {
+					t.Fatalf("after the ERROR event: %s %v (%v), want the end of the stream", e.eventType, e.obj, e.err)
+				}
+				waitFor(t, p.backend.ended, "the backend request to end")
+				waitNoRefreshers(t)
+			})
+		}
+	}
+}
