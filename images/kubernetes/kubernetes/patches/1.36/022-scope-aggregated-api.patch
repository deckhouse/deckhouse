+// TestProxyScope_StripsTrustedHeaders: client copies of the trusted headers
+// never reach the extension server, opted in or not, for a plain request and
+// for an upgrade, which dials with the headers of the proxied request.
+func TestProxyScope_StripsTrustedHeaders(t *testing.T) {
+	resolvers := &scopefilter.Resolvers{
+		Classify: &scopeTestClassify{set: nsSet("a", "b")},
+		Floor:    &scopeTestFloor{set: nsSet("a")},
+	}
+	for _, optIn := range []bool{false, true} {
+		for _, upgrade := range []bool{false, true} {
+			for _, tagged := range []bool{false, true} {
+				name := fmt.Sprintf("optIn=%v/upgrade=%v/scoped=%v", optIn, upgrade, tagged)
+				t.Run(name, func(t *testing.T) {
+					annotation := ""
+					if optIn {
+						annotation = "widgets"
+					}
+					tag := scopeTag{}
+					if tagged {
+						// A narrowed read: let through without bypass, so
+						// a handler that does not opt in forwards it.
+						tag = scopeTag{req: scopeSystem}
+					}
+					p := newScopeProxy(t, resolvers, scopeTestAPIService("v1", annotation), tag)
+					path := "/apis/" + scopeTestGroup + "/v1/widgets"
+					if upgrade {
+						p.upgrade(t, path, spoofedScopeHeaders())
+					} else if resp := p.get(t, path, spoofedScopeHeaders()); resp.StatusCode != http.StatusOK {
+						t.Fatalf("status = %d", resp.StatusCode)
+					}
+					calls, headers, _ := p.backend.snapshot()
+					if calls != 1 {
+						t.Fatalf("backend calls = %d, want 1", calls)
+					}
+					if headers.Get("X-Remote-User") != scopeTestUser.Name {
+						t.Fatalf("backend did not get the identity headers: %v", headers)
+					}
+					mode, hasMode := headers[scopefilter.HeaderScopeMode]
+					namespaces, hasNamespaces := headers[scopefilter.HeaderScopeNamespaces]
+					if optIn && tagged {
+						if !hasMode || !hasNamespaces || mode[0] != scopefilter.ScopeModeNarrowed || namespaces[0] != "a,b" {
+							t.Fatalf("trusted headers = %v / %v, want the computed ones", mode, namespaces)
+						}
+						return
+					}
+					if hasMode || hasNamespaces {
+						t.Fatalf("trusted headers reached the backend: %v / %v", mode, namespaces)
+					}
+				})
+			}
+		}
+	}
+}
