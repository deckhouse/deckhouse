+
+// TestAllowedNamespaces checks the decision shared with the Decorator:
+// classification ∩ floor, the floor only on bypass, and every missing piece
+// an error rather than "no restriction".
+func TestAllowedNamespaces(t *testing.T) {
+	gvr := schema.GroupVersionResource{Group: "example.io", Version: "v1", Resource: "widgets"}
+	alice := &user.DefaultInfo{Name: "alice"}
+	r := &scopefilter.Resolvers{
+		Classify: &fakeClassify{byKind: map[scopefilter.Kind]map[string]struct{}{
+			scopefilter.KindSystem: {"kube-system": {}, "d8-system": {}},
+		}},
+		Floor: &fakeFloor{allowed: map[string]map[string]struct{}{
+			"widgets/list": {"d8-system": {}, "app": {}},
+		}},
+	}
+	system := scopefilter.Request{Kind: scopefilter.KindSystem}
+	accessible := scopefilter.Request{Kind: scopefilter.KindAccessible}
+
+	tests := []struct {
+		name         string
+		r            *scopefilter.Resolvers
+		req          scopefilter.Request
+		bypass       bool
+		verb         string
+		want         map[string]struct{}
+		wantRestrict bool
+		wantErr      bool
+	}{
+		{name: "narrowed: classification only", r: r, req: system, verb: "list", want: map[string]struct{}{"kube-system": {}, "d8-system": {}}, wantRestrict: true},
+		{name: "filtered: classification and floor", r: r, req: system, bypass: true, verb: "list", want: map[string]struct{}{"d8-system": {}}, wantRestrict: true},
+		{name: "filtered: floor of the actual verb", r: r, req: system, bypass: true, verb: "watch", want: map[string]struct{}{}, wantRestrict: true},
+		{name: "filtered accessible: floor only", r: r, req: accessible, bypass: true, verb: "list", want: map[string]struct{}{"d8-system": {}, "app": {}}, wantRestrict: true},
+		{name: "narrowed accessible: no restriction", r: r, req: accessible, verb: "list"},
+		{name: "nil resolvers", r: nil, req: system, verb: "list", wantErr: true},
+		{name: "no floor resolver on bypass", r: &scopefilter.Resolvers{Classify: r.Classify}, req: system, bypass: true, verb: "list", wantErr: true},
+		{name: "no classify resolver", r: &scopefilter.Resolvers{Floor: r.Floor}, req: system, verb: "list", wantErr: true},
+		{name: "floor error", r: &scopefilter.Resolvers{Classify: r.Classify, Floor: failingFloor{errors.New("boom")}}, req: system, bypass: true, verb: "list", wantErr: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := scopefilter.WithRequest(context.Background(), tc.req)
+			if tc.bypass {
+				ctx = scopefilter.WithBypass(ctx)
+			}
+			set, restrict, err := tc.r.AllowedNamespaces(ctx, alice, gvr, "", tc.verb)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("err = %v, wantErr %v", err, tc.wantErr)
+			}
+			if restrict != tc.wantRestrict {
+				t.Fatalf("restrict = %v, want %v", restrict, tc.wantRestrict)
+			}
+			if tc.wantRestrict && len(set)+len(tc.want) > 0 && !reflect.DeepEqual(set, tc.want) {
+				t.Errorf("set = %v, want %v", set, tc.want)
+			}
+		})
+	}
+}
+
+func TestResolveError(t *testing.T) {
+	gvr := schema.GroupVersionResource{Group: "example.io", Version: "v1", Resource: "widgets"}
+	tests := []struct {
+		err  error
+		code int32
+	}{
+		{err: scopefilter.ErrScopeRequiresMultitenancyManager, code: http.StatusBadRequest},
+		{err: scopefilter.ErrPermissionServiceUnavailable, code: http.StatusServiceUnavailable},
+		{err: scopefilter.ErrClusterWideAccess, code: http.StatusForbidden},
+		{err: errors.New("anything else"), code: http.StatusForbidden},
+	}
+	for _, tc := range tests {
+		err := scopefilter.ResolveError(gvr, nil, "get", "w", tc.err)
+		var status apierrors.APIStatus
+		if !errors.As(err, &status) || status.Status().Code != tc.code {
+			t.Errorf("ResolveError(%v) = %v, want code %d", tc.err, err, tc.code)
+		}
+	}
+}
