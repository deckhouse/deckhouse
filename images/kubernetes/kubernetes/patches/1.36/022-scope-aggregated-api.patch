+
+// Deckhouse: the allowed set of a proxied watch is sent once, when the stream
+// opens. A refresher recomputes it while the stream is open, as the watch of
+// a resource served from storage does, and ends the stream once the set
+// differs from the one sent, or the APIService does not opt the resource in
+// any more: the client reconnects and gets the new set. The timeoutSeconds cap
+// bounds the stream even when nothing changes.
+//
+// The objects of a namespace that joined the set were never sent, and those of
+// one that left it are never deleted: a client that resumed from its last
+// resourceVersion would keep a wrong cache. Before a plain watch ends, the
+// proxy therefore sends an ERROR event with 410 Expired, in the framing of the
+// stream (scopeWatchWriter): client-go's reflector lists again on it. An
+// upgraded (websocket) watch only ends.
+//
+// Ending the stream means canceling the context of the proxied request:
+//
+//   - a plain watch, HTTP/1.1 or HTTP/2 on either leg: the reverse proxy reads
+//     the backend response under that context, so the read fails and the
+//     backend stream is reset. The reverse proxy then aborts the client
+//     response with http.ErrAbortHandler; scopeRefresher.end recovers that
+//     abort when the refresher caused it, so the client sees the response end
+//     normally rather than a broken connection or a reset stream.
+//   - an upgraded (websocket) watch: after the hijack the proxy copies bytes
+//     between two connections and never looks at the context again, so the
+//     refresher closes the hijacked client connection itself; the proxy then
+//     closes the backend connection.
+
+var (
+	errScopeSetChanged     = errors.New("scopefilter: the allowed set of namespaces of the watch changed")
+	errScopeRefreshFailed  = errors.New("scopefilter: the allowed set of namespaces of the watch could not be recomputed")
+	errScopeOptInWithdrawn = errors.New("scopefilter: the APIService does not filter the resource of the watch any more")
+)
+
+// activeScopeRefreshers counts the running refreshers.
+var activeScopeRefreshers atomic.Int64
+
+// capWatchTimeout limits the timeoutSeconds of a watch to limit. A missing,
+// zero, negative or unparsable value is replaced as well: zero asks the
+// server for its default, which may be longer. The query always ends up with
+// exactly one value, the one checked: a receiver reading another of several
+// values would not be bounded.
+func capWatchTimeout(u *url.URL, limit time.Duration) {
+	limitSeconds := int64(limit / time.Second)
+	if limitSeconds < 1 {
+		limitSeconds = 1
+	}
+	q := u.Query()
+	timeout := limitSeconds
+	if v, err := strconv.ParseInt(q.Get("timeoutSeconds"), 10, 64); err == nil && v > 0 && v <= limitSeconds {
+		timeout = v
+	}
+	q.Set("timeoutSeconds", strconv.FormatInt(timeout, 10))
+	u.RawQuery = q.Encode()
+}
+
+// scopeRefresher keeps the allowed set of one proxied watch current. Its
+// methods are no-ops on nil, the refresher of a read that needs none.
+type scopeRefresher struct {
+	ctx    context.Context
+	cancel context.CancelCauseFunc
+	done   chan struct{}
+
+	mu       sync.Mutex
+	stopConn func() bool
+
+	// stream is the writer of a plain watch, see writer.
+	stream *scopeWatchWriter
+}
+
+// scopeRecomputation is the outcome of one recomputation of the set: the
+// reason to end the stream, if any, or the failure to recompute.
+type scopeRecomputation struct {
+	closeReason string
+	err         error
+}
+
+// startScopeRefresher starts the refresher of a watch whose set was sent as
+// sent, sorted. parent is the context of the proxied request; it carries the
+// scope request and the bypass tag decideScope reads.
+func (r *proxyHandler) startScopeRefresher(parent context.Context, u user.Info, requestInfo *genericapirequest.RequestInfo, apiService string, sent []string) *scopeRefresher {
+	ctx, cancel := context.WithCancelCause(parent)
+	s := &scopeRefresher{ctx: ctx, cancel: cancel, done: make(chan struct{})}
+	interval, _, grace := r.scopeResolvers.ProxiedWatchLimits()
+	info := *requestInfo
+	gr := schema.GroupResource{Group: info.APIGroup, Resource: info.Resource}
+	recompute := func(ctx context.Context) scopeRecomputation {
+		// The registry follows every update and removal of the APIService.
+		if !scopefilter.IsProxiedBy(apiService, gr) {
+			return scopeRecomputation{closeReason: scopefilter.ProxiedWatchClosedOptInWithdrawn}
+		}
+		decision, err := r.decideScope(ctx, u, &info, apiService)
+		if err != nil {
+			return scopeRecomputation{err: err}
+		}
+		if decision.refusal != nil || !decision.filter || !slices.Equal(decision.names, sent) {
+			return scopeRecomputation{closeReason: scopefilter.ProxiedWatchClosedSetChanged}
+		}
+		return scopeRecomputation{}
+	}
+	activeScopeRefreshers.Add(1)
+	go s.run(interval, grace, recompute, u.GetName(), apiService)
+	return s
+}
+
+func (s *scopeRefresher) run(interval, grace time.Duration, recompute func(context.Context) scopeRecomputation, userName, apiService string) {
+	defer close(s.done)
+	defer activeScopeRefreshers.Add(-1)
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+
+	// failingSince is when the first of the current run of failed
+	// recomputations started; zero while the last one succeeded.
+	var failingSince time.Time
+	for {
+		select {
+		case <-s.ctx.Done():
+			return
+		case <-ticker.C:
+		}
+		started := time.Now()
+		// The resolvers load on a context of their own, shared by the
+		// callers of one key, and do not stop when this request ends: wait
+		// for the outcome only while the request lasts, so its end does not
+		// wait for a slow load.
+		outcome := make(chan scopeRecomputation, 1)
+		go func() { outcome <- recompute(s.ctx) }()
+		var result scopeRecomputation
+		select {
+		case <-s.ctx.Done():
+			return
+		case result = <-outcome:
+		}
+		if s.ctx.Err() != nil {
+			// The request ended while the set was computed.
+			return
+		}
+		closeReason, err := result.closeReason, result.err
+		if err != nil && (errors.Is(err, scopefilter.ErrClusterWideAccess) || errors.Is(err, scopefilter.ErrScopeRequiresMultitenancyManager)) {
+			// An answer rather than a fault, as for a watch served from
+			// storage: retrying gets the same answer, and the read the
+			// client reconnects with is decided anew.
+			closeReason, err = scopefilter.ProxiedWatchClosedSetChanged, nil
+		}
+		if err != nil {
+			scopefilter.RecordWatchRefreshFailure()
+			if failingSince.IsZero() {
+				failingSince = started
+			}
+			failingFor := time.Since(failingSince)
+			if failingFor < grace {
+				klog.Warningf("scopefilter: failed to recompute the allowed set of a watch of user %q through APIService %s (keeping the stream, failing for %s): %v", userName, apiService, failingFor.Round(time.Second), err)
+				continue
+			}
+			klog.Warningf("scopefilter: failed to recompute the allowed set of a watch of user %q through APIService %s for %s; ending the stream: %v", userName, apiService, failingFor.Round(time.Second), err)
+			scopefilter.RecordProxiedWatchClosed(scopefilter.ProxiedWatchClosedRefreshFailed)
+			s.cancel(errScopeRefreshFailed)
+			return
+		}
+		failingSince = time.Time{}
+		if closeReason != "" {
+			klog.V(2).InfoS("scopefilter: ending a proxied watch", "user", userName, "apiService", apiService, "reason", closeReason)
+			scopefilter.RecordProxiedWatchClosed(closeReason)
+			if closeReason == scopefilter.ProxiedWatchClosedOptInWithdrawn {
+				s.cancel(errScopeOptInWithdrawn)
+			} else {
+				s.cancel(errScopeSetChanged)
+			}
+			return
+		}
+	}
+}
+
+// endedByRefresher returns why the refresher ended the stream, nil when it
+// did not.
+func (s *scopeRefresher) endedByRefresher() error {
+	cause := context.Cause(s.ctx)
+	if errors.Is(cause, errScopeSetChanged) || errors.Is(cause, errScopeRefreshFailed) || errors.Is(cause, errScopeOptInWithdrawn) {
+		return cause
+	}
+	return nil
+}
+
+// end stops the refresher and waits for it to exit. It must be deferred by
+// the handler that serves the proxied request: it recovers the abort of the
+// reverse proxy when the refresher ended the stream, so the response ends
+// normally, and lets every other panic through. It then completes the
+// response of a plain watch: the ERROR event when the refresher ended it, the
+// rest of what the extension server sent otherwise.
+func (s *scopeRefresher) end() {
+	if s == nil {
+		return
+	}
+	s.mu.Lock()
+	if s.stopConn != nil {
+		s.stopConn()
+	}
+	s.mu.Unlock()
+	s.cancel(nil)
+	<-s.done
+	cause := s.endedByRefresher()
+	if p := recover(); p != nil {
+		if p != http.ErrAbortHandler || cause == nil {
+			panic(p)
+		}
+	}
+	if s.stream != nil {
+		s.stream.finish(cause)
+	}
+}
+
+// writer returns the response writer the upgrade-aware proxy is given. For an
+// upgrade it records the hijacked connection, so the refresher can close it;
+// for a plain watch it is the writer that keeps track of the event frames.
+func (s *scopeRefresher) writer(w http.ResponseWriter, upgrade bool) http.ResponseWriter {
+	if s == nil {
+		return w
+	}
+	if !upgrade {
+		s.stream = &scopeWatchWriter{ResponseWriter: w}
+		return s.stream
+	}
+	hijacker, ok := w.(http.Hijacker)
+	if !ok {
+		return w
+	}
+	return &scopeHijackWriter{ResponseWriter: w, hijacker: hijacker, refresher: s}
+}
+
+// scopeHijackWriter closes the hijacked connection of an upgraded watch when
+// the context of the proxied request ends, the refresher ending it included.
+type scopeHijackWriter struct {
+	http.ResponseWriter
+	hijacker  http.Hijacker
+	refresher *scopeRefresher
+}
+
+func (w *scopeHijackWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	conn, rw, err := w.hijacker.Hijack()
+	if err != nil {
+		return conn, rw, err
+	}
+	// Runs at once when the context already ended before the hijack.
+	stop := context.AfterFunc(w.refresher.ctx, func() { _ = conn.Close() })
+	w.refresher.mu.Lock()
+	w.refresher.stopConn = stop
+	w.refresher.mu.Unlock()
+	return conn, rw, nil
+}
