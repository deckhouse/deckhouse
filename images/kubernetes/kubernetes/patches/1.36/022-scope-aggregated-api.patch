+		floor := &liveAnswer{set: nsSet("a", "b")}
+		p := newWatchProxy(t, filteredWatchResolvers(floor), filteredWatchTag, false, true)
+		s := p.watch(t, "/apis/"+scopeTestGroup+"/v1/widgets?watch=true")
+		floor.update(nil, scopefilter.ErrClusterWideAccess)
+		select {
+		case <-s.ended:
+		case <-time.After(scopeWatchDeadline):
+			t.Fatal("the stream is still open")
+		}
+		if got := proxiedWatchClosed(t, scopefilter.ProxiedWatchClosedSetChanged) - closedBefore; got != 1 {
+			t.Errorf("set_changed closes = %v, want 1", got)
+		}
+	})
+
+	t.Run("disabled multitenancy ends the stream at once", func(t *testing.T) {
+		closedBefore := proxiedWatchClosed(t, scopefilter.ProxiedWatchClosedSetChanged)
+		floor := &liveAnswer{set: nsSet("a", "b")}
+		p := newWatchProxy(t, filteredWatchResolvers(floor), filteredWatchTag, false, true)
+		s := p.watch(t, "/apis/"+scopeTestGroup+"/v1/widgets?watch=true")
+		floor.update(nil, scopefilter.ErrScopeRequiresMultitenancyManager)
+		select {
+		case <-s.ended:
+		case <-time.After(scopeWatchDeadline):
+			t.Fatal("the stream is still open")
+		}
+		if got := proxiedWatchClosed(t, scopefilter.ProxiedWatchClosedSetChanged) - closedBefore; got != 1 {
+			t.Errorf("set_changed closes = %v, want 1", got)
+		}
+	})
+
+	t.Run("namespace leaving the set of a filtered watch ends the stream", func(t *testing.T) {
+		floor := &liveAnswer{set: nsSet("a", "b")}
+		p := newWatchProxy(t, filteredWatchResolvers(floor), filteredWatchTag, false, true)
+		s := p.watch(t, "/apis/"+scopeTestGroup+"/v1/namespaces/a/widgets?watch=true")
+		// The set of the namespaced watch is {a}: a change elsewhere keeps it.
+		floor.update(nsSet("a"), nil)
+		calls := floor.callCount()
+		waitUntil(t, "several recomputations", func() bool { return floor.callCount() >= calls+3 })
+		select {
+		case err := <-s.ended:
+			t.Fatalf("the stream ended (%v) while its namespace stayed in the set", err)
+		default:
+		}
+		floor.update(nsSet("b"), nil)
+		select {
+		case <-s.ended:
