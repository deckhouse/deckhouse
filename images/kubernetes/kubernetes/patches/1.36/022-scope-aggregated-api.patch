+// TestProxyScope_FailsClosed: a scoped read the set cannot be computed for
+// is answered by the proxy, never forwarded.
+func TestProxyScope_FailsClosed(t *testing.T) {
+	path := "/apis/" + scopeTestGroup + "/v1/widgets"
+	tests := []struct {
+		name      string
+		resolvers *scopefilter.Resolvers
+		tag       scopeTag
+		wantCode  int
+	}{
+		{name: "nil resolvers, filtered", tag: scopeTag{req: scopeSystem, bypass: true}, wantCode: 403},
+		{name: "nil resolvers, narrowed", tag: scopeTag{req: scopeSystem}, wantCode: 403},
+		{name: "floor error", resolvers: &scopefilter.Resolvers{Classify: &scopeTestClassify{set: nsSet("a")}, Floor: &scopeTestFloor{err: errors.New("boom")}}, tag: scopeTag{req: scopeSystem, bypass: true}, wantCode: 403},
+		{name: "floor unavailable", resolvers: &scopefilter.Resolvers{Classify: &scopeTestClassify{set: nsSet("a")}, Floor: &scopeTestFloor{err: scopefilter.ErrPermissionServiceUnavailable}}, tag: scopeTag{req: scopeSystem, bypass: true}, wantCode: 503},
+		{name: "classification error, narrowed", resolvers: &scopefilter.Resolvers{Classify: &scopeTestClassify{err: errors.New("boom")}}, tag: scopeTag{req: scopeSystem}, wantCode: 403},
+		{name: "cluster-wide disagreement", resolvers: &scopefilter.Resolvers{Floor: &scopeTestFloor{err: scopefilter.ErrClusterWideAccess}}, tag: scopeTag{req: scopeAccessible, bypass: true}, wantCode: 403},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			p := newScopeProxy(t, tc.resolvers, scopeTestAPIService("v1", "widgets"), tc.tag)
+			resp := p.get(t, path, nil)
+			if resp.StatusCode != tc.wantCode {
+				t.Fatalf("status = %d, want %d", resp.StatusCode, tc.wantCode)
+			}
+			if tc.wantCode == http.StatusServiceUnavailable && resp.Header.Get("Retry-After") == "" {
+				t.Error("503 without Retry-After")
+			}
+			readStatus(t, resp)
+			if calls, _, _ := p.backend.snapshot(); calls != 0 {
+				t.Fatal("the backend was called")
+			}
+		})
+	}
+}
