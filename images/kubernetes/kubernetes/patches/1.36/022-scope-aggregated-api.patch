+// The proxied branch: a resource an aggregated API server opted in (see
+// scopefilter.IsProxied) is let through under the same gates as a registered
+// one; kube-aggregator then sends the allowed set or refuses.
+
+func registerProxiedForTest(t *testing.T, apiService string, grs ...schema.GroupResource) {
+	t.Helper()
+	version, _, _ := strings.Cut(apiService, ".")
+	scopefilter.RegisterProxied(apiService, version, grs)
+	t.Cleanup(func() { scopefilter.UnregisterProxied(apiService) })
+}
+
+func TestWithAuthorization_ProxiedScopeBypass(t *testing.T) {
+	registerProxiedForTest(t, "v1.proxied.example.io", schema.GroupResource{Group: "proxied.example.io", Resource: "widgets"})
+	negotiatedSerializer := serializer.NewCodecFactory(runtime.NewScheme()).WithoutConversion()
+
+	tests := []struct {
+		name        string
+		authz       fakeAuthorizer
+		method      string
+		path        string
+		header      string
+		wantCalled  bool
+		wantPresent bool
+		wantBypass  bool
+		wantCode    int
+	}{
+		{name: "denied list with header is let through with bypass", authz: denyAllAuthorizer(), method: http.MethodGet, path: "/apis/proxied.example.io/v1/widgets", header: "system", wantCalled: true, wantPresent: true, wantBypass: true, wantCode: http.StatusOK},
+		{name: "denied namespaced get with header is let through", authz: denyAllAuthorizer(), method: http.MethodGet, path: "/apis/proxied.example.io/v1/namespaces/ns/widgets/w", header: "accessible", wantCalled: true, wantPresent: true, wantBypass: true, wantCode: http.StatusOK},
+		{name: "denied watch with header is let through", authz: denyAllAuthorizer(), method: http.MethodGet, path: "/apis/proxied.example.io/v1/widgets?watch=true", header: "projects", wantCalled: true, wantPresent: true, wantBypass: true, wantCode: http.StatusOK},
+		{name: "denied list without header is 403", authz: denyAllAuthorizer(), method: http.MethodGet, path: "/apis/proxied.example.io/v1/widgets", wantCode: http.StatusForbidden},
+		{name: "denied create with header is 403", authz: denyAllAuthorizer(), method: http.MethodPost, path: "/apis/proxied.example.io/v1/namespaces/ns/widgets", header: "system", wantCode: http.StatusForbidden},
+		{name: "denied subresource with header is 403", authz: denyAllAuthorizer(), method: http.MethodGet, path: "/apis/proxied.example.io/v1/namespaces/ns/widgets/w/status", header: "system", wantCode: http.StatusForbidden},
+		{name: "denied read of a resource not opted in is 403", authz: denyAllAuthorizer(), method: http.MethodGet, path: "/apis/proxied.example.io/v1/gadgets", header: "system", wantCode: http.StatusForbidden},
+		{name: "malformed header is 400", authz: denyAllAuthorizer(), method: http.MethodGet, path: "/apis/proxied.example.io/v1/widgets", header: "everything", wantCode: http.StatusBadRequest},
+		{name: "allowed list with header is narrowed only", authz: fakeAuthorizer{authorizer.DecisionAllow, "allowed for test", nil}, method: http.MethodGet, path: "/apis/proxied.example.io/v1/widgets", header: "system", wantCalled: true, wantPresent: true, wantCode: http.StatusOK},
+		{name: "allowed list without header is untagged", authz: fakeAuthorizer{authorizer.DecisionAllow, "allowed for test", nil}, method: http.MethodGet, path: "/apis/proxied.example.io/v1/widgets", wantCalled: true, wantCode: http.StatusOK},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			handler := &scopeTestHandler{}
+			w := httptest.NewRecorder()
+			WithAuthorization(handler, tc.authz, negotiatedSerializer).ServeHTTP(w, newScopeTestRequest(t, tc.method, tc.path, tc.header))
+			if w.Code != tc.wantCode {
+				t.Fatalf("code = %d, want %d", w.Code, tc.wantCode)
+			}
+			if handler.called != tc.wantCalled || handler.gotPresent != tc.wantPresent || handler.gotBypass != tc.wantBypass {
+				t.Fatalf("called/present/bypass = %v/%v/%v, want %v/%v/%v",
+					handler.called, handler.gotPresent, handler.gotBypass, tc.wantCalled, tc.wantPresent, tc.wantBypass)
+			}
+			if handler.gotNamespaceMode {
+				t.Fatal("a proxied read must not carry the namespaces filter tag")
+			}
+		})
+	}
+}
