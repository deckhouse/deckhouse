+// TestProxyScope_WatchOptInWithdrawn: a watch ends once the APIService does
+// not opt the resource in any more, with the ERROR event of a changed set.
+func TestProxyScope_WatchOptInWithdrawn(t *testing.T) {
+	waitNoRefreshers(t)
+	closedBefore := proxiedWatchClosed(t, scopefilter.ProxiedWatchClosedOptInWithdrawn)
+	floor := &liveAnswer{set: nsSet("a", "b")}
+	first := encodeTestWatchEvent(t, runtime.ContentTypeJSON, watch.Added, testWatchObject("first"))
+	p := newFrameProxy(t, filteredWatchResolvers(floor), &frameBackend{contentType: runtime.ContentTypeJSON, chunks: [][]byte{first}})
+	resp := openFrameWatch(t, p, runtime.ContentTypeJSON)
+	waitFor(t, p.backend.started, "the backend to stream")
+	d := watchDecoder(t, runtime.ContentTypeJSON, resp.Body)
+	if e := nextEvent(t, d); e.err != nil || e.eventType != watch.Added {
+		t.Fatalf("first event = %s (%v)", e.eventType, e.err)
+	}
+
+	calls := floor.callCount()
+	waitUntil(t, "several recomputations", func() bool { return floor.callCount() >= calls+3 })
+	apiService := scopeTestAPIService("v1", "")
+	p.handler.updateAPIService(apiService)
+	syncProxiedResources(apiService.Name, p.handler)
+	requireExpired(t, nextEvent(t, d))
+	waitFor(t, p.backend.ended, "the backend request to end")
+	waitNoRefreshers(t)
+	if got := proxiedWatchClosed(t, scopefilter.ProxiedWatchClosedOptInWithdrawn) - closedBefore; got != 1 {
+		t.Errorf("opt_in_withdrawn closes = %v, want 1", got)
+	}
+}
