+
+package scopefilter_test
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"reflect"
+	"testing"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apiserver/pkg/authentication/user"
+	"k8s.io/apiserver/pkg/registry/generic/scopefilter"
+)
+
+// TestParseProxiedResources: the cases are mirrored 1:1 in the permission
+// service of Deckhouse, which parses the same annotation
+// (deckhouse ee/be/modules/140-user-authz/images/permission-browser-apiserver/
+// src/pkg/resolver/apiservice_index_test.go, TestParseScopedResources). Keep
+// the two sets in sync: the parsers must agree on what an APIService opted in.
+func TestParseProxiedResources(t *testing.T) {
+	gr := func(r string) schema.GroupResource { return schema.GroupResource{Group: "example.io", Resource: r} }
+	tests := []struct {
+		name     string
+		group    string
+		value    string
+		want     []schema.GroupResource
+		wantErrs int
+	}{
+		{name: "single", group: "example.io", value: "widgets", want: []schema.GroupResource{gr("widgets")}},
+		{name: "several, spaces, duplicates, sorted", group: "example.io", value: " widgets , gadgets,widgets", want: []schema.GroupResource{gr("gadgets"), gr("widgets")}},
+		{name: "empty value", group: "example.io", value: "  ", wantErrs: 1},
+		{name: "empty entries are ignored", group: "example.io", value: "widgets,,", want: []schema.GroupResource{gr("widgets")}, wantErrs: 2},
+		{name: "subresource is malformed", group: "example.io", value: "widgets/status,gadgets", want: []schema.GroupResource{gr("gadgets")}, wantErrs: 1},
+		{name: "uppercase is malformed", group: "example.io", value: "Widgets", want: []schema.GroupResource{}, wantErrs: 1},
+		{name: "permission service group is refused", group: "authorization.deckhouse.io", value: "selfscopedaccessreviews", wantErrs: 1},
+		{name: "wildcard is malformed", group: "example.io", value: "*,gadgets", want: []schema.GroupResource{gr("gadgets")}, wantErrs: 1},
+		{name: "resource.group is malformed", group: "example.io", value: "widgets.example.io,gadgets", want: []schema.GroupResource{gr("gadgets")}, wantErrs: 1},
+		{name: "tabs and newlines around entries are trimmed", group: "example.io", value: "\twidgets\n,\n gadgets\t", want: []schema.GroupResource{gr("gadgets"), gr("widgets")}},
+		{name: "whitespace inside an entry is malformed", group: "example.io", value: "wid\tgets,gad gets,widgets", want: []schema.GroupResource{gr("widgets")}, wantErrs: 2},
+		{name: "blank value of tabs and newlines", group: "example.io", value: "\t\n", wantErrs: 1},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, errs := scopefilter.ParseProxiedResources(tc.group, tc.value)
+			if len(got) == 0 && len(tc.want) == 0 {
+				got, tc.want = nil, nil
+			}
+			if !reflect.DeepEqual(got, tc.want) {
+				t.Errorf("resources = %v, want %v", got, tc.want)
+			}
+			if len(errs) != tc.wantErrs {
+				t.Errorf("errors = %v, want %d", errs, tc.wantErrs)
+			}
+		})
+	}
+}
+
+// TestProxiedRegistry: each APIService owns its entry, so a resource stays
+// proxied while any version of its group lists it, and the proxied set never
+// leaks into the storage registry.
+func TestProxiedRegistry(t *testing.T) {
+	widgets := schema.GroupResource{Group: "proxied.example.io", Resource: "widgets"}
+	gadgets := schema.GroupResource{Group: "proxied.example.io", Resource: "gadgets"}
+	t.Cleanup(func() {
+		scopefilter.UnregisterProxied("v1.proxied.example.io")
+		scopefilter.UnregisterProxied("v2.proxied.example.io")
+	})
+
+	scopefilter.RegisterProxied("v1.proxied.example.io", "v1", []schema.GroupResource{widgets, gadgets})
+	scopefilter.RegisterProxied("v2.proxied.example.io", "v2", []schema.GroupResource{widgets})
+	if !scopefilter.IsProxied(widgets) || !scopefilter.IsProxied(gadgets) {
+		t.Fatal("registered resources are not proxied")
+	}
+	if scopefilter.IsRegistered(widgets) {
+		t.Fatal("a proxied resource must not be in the storage registry")
+	}
+	if !scopefilter.IsProxiedVersion(widgets.WithVersion("v2")) || !scopefilter.IsProxiedVersion(gadgets.WithVersion("v1")) {
+		t.Fatal("the versions that opted the resources in are not proxied")
+	}
+	if scopefilter.IsProxiedVersion(gadgets.WithVersion("v2")) {
+		t.Fatal("gadgets is proxied in v2, which did not opt it in")
+	}
+	if !scopefilter.IsProxiedBy("v1.proxied.example.io", gadgets) || scopefilter.IsProxiedBy("v2.proxied.example.io", gadgets) {
+		t.Fatal("IsProxiedBy does not follow the owner")
+	}
+
+	// Update v1: gadgets dropped, widgets still listed by both.
+	scopefilter.RegisterProxied("v1.proxied.example.io", "v1", []schema.GroupResource{widgets})
+	if scopefilter.IsProxied(gadgets) {
+		t.Error("gadgets still proxied after its only APIService dropped it")
+	}
+	if scopefilter.IsProxiedBy("v1.proxied.example.io", gadgets) || scopefilter.IsProxiedVersion(gadgets.WithVersion("v1")) {
+		t.Error("gadgets still opted in by v1 after v1 dropped it")
+	}
+
+	scopefilter.UnregisterProxied("v1.proxied.example.io")
+	if !scopefilter.IsProxied(widgets) {
+		t.Error("widgets not proxied any more although v2 still lists it")
+	}
+	if scopefilter.IsProxiedBy("v1.proxied.example.io", widgets) {
+		t.Error("a removed APIService still opts widgets in")
+	}
+
+	// An empty list is an unregistration.
+	scopefilter.RegisterProxied("v2.proxied.example.io", "v2", nil)
+	if scopefilter.IsProxied(widgets) {
+		t.Error("widgets still proxied after every APIService dropped it")
+	}
+	scopefilter.UnregisterProxied("never-registered")
+}
