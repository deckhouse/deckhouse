+// blockingFloor answers the first call and blocks every later one until
+// released, as a load of the permission service that does not answer.
+type blockingFloor struct {
+	calls   atomic.Int64
+	release chan struct{}
+}
+
+func (f *blockingFloor) Resolve(context.Context, user.Info, schema.GroupVersionResource, string, string) (map[string]struct{}, error) {
+	if f.calls.Add(1) > 1 {
+		<-f.release
+	}
+	return nsSet("a"), nil
+}
