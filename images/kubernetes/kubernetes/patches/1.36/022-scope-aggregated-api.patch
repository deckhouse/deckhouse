+// TestProxyScope_NotOptedIn: without the annotation no trusted header is
+// sent, and a read let through for the filter is refused -- also when the
+// annotation is removed from a live handler.
+func TestProxyScope_NotOptedIn(t *testing.T) {
+	resolvers := &scopefilter.Resolvers{
+		Classify: &scopeTestClassify{set: nsSet("a")},
+		Floor:    &scopeTestFloor{set: nsSet("a")},
+	}
+	path := "/apis/" + scopeTestGroup + "/v1/widgets"
+
+	p := newScopeProxy(t, resolvers, scopeTestAPIService("v1", ""), scopeTag{req: scopeSystem})
+	if resp := p.get(t, path, nil); resp.StatusCode != http.StatusOK {
+		t.Fatalf("narrowed read: status = %d", resp.StatusCode)
+	}
+	if _, headers, _ := p.backend.snapshot(); headers.Get(scopefilter.HeaderScopeMode) != "" {
+		t.Fatalf("trusted headers sent without opt-in: %v", headers)
+	}
+
+	p = newScopeProxy(t, resolvers, scopeTestAPIService("v2", ""), scopeTag{req: scopeSystem, bypass: true})
+	if resp := p.get(t, "/apis/"+scopeTestGroup+"/v2/widgets", nil); resp.StatusCode != http.StatusForbidden {
+		t.Fatalf("filtered read of a version not opted in: status = %d, want 403", resp.StatusCode)
+	}
+
+	p = newScopeProxy(t, resolvers, scopeTestAPIService("v1", "widgets"), scopeTag{req: scopeSystem, bypass: true})
+	p.handler.updateAPIService(scopeTestAPIService("v1", ""))
+	if resp := p.get(t, path, nil); resp.StatusCode != http.StatusForbidden {
+		t.Fatalf("filtered read after the annotation was removed: status = %d, want 403", resp.StatusCode)
+	}
+	if calls, _, _ := p.backend.snapshot(); calls != 0 {
+		t.Fatal("the backend was called")
+	}
+}
