+		"Trailer":                      {"X_Deckhouse_Scope_Mode, X-Other-Trailer", "x-deckhouse-scope-namespaces"},
+	}
+	trailer := http.Header{
+		"X-Deckhouse-Scope-Mode":       nil,
+		"X_DECKHOUSE_SCOPE_NAMESPACES": nil,
+		"X-Other-Trailer":              nil,
+	}
+	original := trailer
+	stripTrustedScopeHeaders(&http.Request{Header: h, Trailer: trailer})
+	want := http.Header{
+		"X_Deckhouse_Scope": {"kept"},
+		"X-Other_Header":    {"kept"},
+		"Connection":        {"keep-alive", "Upgrade"},
+		"Trailer":           {"X-Other-Trailer"},
+	}
+	if len(original) != 3 {
+		t.Fatalf("the trailers of the original request were changed: %v", original)
+	}
+	if len(h) != len(want) {
+		t.Fatalf("headers = %v, want %v", h, want)
+	}
+	for k, v := range want {
+		if got := h[k]; strings.Join(got, "|") != strings.Join(v, "|") {
+			t.Fatalf("%s = %q, want %q (headers %v)", k, got, v, h)
+		}
+	}
+
+	req := &http.Request{Header: http.Header{}, Trailer: trailer}
+	stripTrustedScopeHeaders(req)
+	if len(req.Trailer) != 1 {
+		t.Fatalf("trailers = %v, want only X-Other-Trailer", req.Trailer)
+	}
+	if _, ok := req.Trailer["X-Other-Trailer"]; !ok {
+		t.Fatalf("trailers = %v, want X-Other-Trailer", req.Trailer)
+	}
+	if len(trailer) != 3 {
+		t.Fatalf("the trailers of the original request were changed: %v", trailer)
+	}
+	untouched := http.Header{"X-Other-Trailer": nil}
+	req = &http.Request{Header: http.Header{}, Trailer: untouched}
+	stripTrustedScopeHeaders(req)
+	req.Trailer["X-Filled-Later"] = nil
+	if _, ok := untouched["X-Filled-Later"]; !ok {
+		t.Fatal("trailers without a trusted name must stay shared with the original request")
+	}
+}
+
+// TestProxyScope_StripsTrustedHeaderSpellings: client headers spelled with "_"
+// or another case never reach the extension server, next to the ones
+// kube-apiserver set.
+func TestProxyScope_StripsTrustedHeaderSpellings(t *testing.T) {
+	resolvers := &scopefilter.Resolvers{
+		Classify: &scopeTestClassify{set: nsSet("a", "b")},
+		Floor:    &scopeTestFloor{set: nsSet("a")},
+	}
+	for _, tag := range []scopeTag{{}, {req: scopeSystem, bypass: true}} {
+		p := newScopeProxy(t, resolvers, scopeTestAPIService("v1", "widgets"), tag)
+		header := http.Header{
+			"X_Deckhouse_Scope_Mode":       {"narrowed"},
+			"x_deckhouse_scope_namespaces": {"spoofed"},
+			"X-DECKHOUSE_SCOPE-NAMESPACES": {"spoofed"},
+		}
+		if resp := p.get(t, "/apis/"+scopeTestGroup+"/v1/widgets", header); resp.StatusCode != http.StatusOK {
+			t.Fatalf("status = %d", resp.StatusCode)
+		}
+		_, headers, _ := p.backend.snapshot()
+		for k, v := range headers {
+			folded := strings.ReplaceAll(k, "_", "-")
+			trusted := strings.EqualFold(folded, scopefilter.HeaderScopeMode) || strings.EqualFold(folded, scopefilter.HeaderScopeNamespaces)
+			if trusted && (!tag.bypass || len(v) != 1 || v[0] == "spoofed" || v[0] == "narrowed") {
+				t.Errorf("bypass=%v: the backend got %s: %q", tag.bypass, k, v)
+			}
+		}
+		if tag.bypass && (headers.Get(scopefilter.HeaderScopeMode) != scopefilter.ScopeModeFiltered || headers.Get(scopefilter.HeaderScopeNamespaces) != "a") {
+			t.Errorf("the backend did not get the computed headers: %v", headers)
+		}
+	}
+}
+
+// TestProxyScope_AuditDecision: the proxy records no decision of its own: the
+// authorization filter records it for every read it lets through (see
+// scopefilter.AnnotateBypass), and the proxy keeps it, whichever path the
+// version takes.
+func TestProxyScope_AuditDecision(t *testing.T) {
+	const decisionKey = "authorization.k8s.io/decision"
+	resolvers := &scopefilter.Resolvers{
+		Classify: &scopeTestClassify{set: nsSet("a")},
+		Floor:    &scopeTestFloor{set: nsSet("a")},
+	}
+	local := scopeTestAPIService("v1", "")
+	local.Spec.Service = nil
+	tests := []struct {
+		name         string
+		apiService   *apiregistration.APIService
+		tag          scopeTag
+		preset       string
+		wantDecision string
+	}{
+		{name: "proxied, undecided", apiService: scopeTestAPIService("v1", "widgets"), tag: scopeTag{req: scopeSystem, bypass: true}},
+		{name: "local, undecided", apiService: local, tag: scopeTag{req: scopeSystem, bypass: true}},
+		{name: "proxied, decided by the filter", apiService: scopeTestAPIService("v1", "widgets"), tag: scopeTag{req: scopeSystem, bypass: true}, preset: scopefilter.AuditDecisionAllowScopedProxied, wantDecision: scopefilter.AuditDecisionAllowScopedProxied},
+		{name: "refused, decided by the filter", apiService: scopeTestAPIService("v1", ""), tag: scopeTag{req: scopeSystem, bypass: true}, preset: scopefilter.AuditDecisionAllowScopedProxied, wantDecision: scopefilter.AuditDecisionAllowScopedProxied},
+		{name: "local, decided by the filter", apiService: local, tag: scopeTag{req: scopeSystem, bypass: true}, preset: scopefilter.AuditDecisionAllowScoped, wantDecision: scopefilter.AuditDecisionAllowScoped},
+		{name: "allowed read", apiService: scopeTestAPIService("v1", "widgets"), tag: scopeTag{req: scopeSystem}, preset: "allow", wantDecision: "allow"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			_, backendServer := newScopeBackend(t)
+			h := &proxyHandler{
+				localDelegate:              http.NewServeMux(),
+				serviceResolver:            &mockedRouter{destinationHost: backendServer.Listener.Addr().String()},
+				proxyCurrentCertKeyContent: func() ([]byte, []byte) { return emptyCert(), emptyCert() },
+				scopeResolvers:             resolvers,
+			}
+			h.updateAPIService(tc.apiService)
+			var ac *audit.AuditContext
+			withAudit := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				ctx := audit.WithAuditContext(r.Context())
+				ac = audit.AuditContextFrom(ctx)
+				if tc.preset != "" {
+					audit.AddAuditAnnotation(ctx, decisionKey, tc.preset)
+				}
+				withScopeTag(h, tc.tag).ServeHTTP(w, r.WithContext(ctx))
+			})
+			srv := httptest.NewServer(contextHandler(withAudit, scopeTestUser))
+			t.Cleanup(srv.Close)
+			resp, err := http.Get(srv.URL + "/apis/" + scopeTestGroup + "/v1/widgets")
+			if err != nil {
+				t.Fatal(err)
+			}
+			_ = resp.Body.Close()
+			if got, _ := ac.GetEventAnnotation(decisionKey); got != tc.wantDecision {
+				t.Fatalf("decision = %q, want %q", got, tc.wantDecision)
+			}
+		})
+	}
+}
+
+// TestScopeOptInLog: the ignored entries of an opt-in are logged when it
+// changes, not on every update of the APIService.
+func TestScopeOptInLog(t *testing.T) {
+	h := &proxyHandler{}
+	bad := scopeTestAPIService("v1", "widgets,Bad")
+	if got := h.scopedResourcesOfUpdate(bad); len(got) != 1 {
+		t.Fatalf("resources = %v", got)
+	}
+	steps := []struct {
+		apiService *apiregistration.APIService
+		want       bool
+	}{
+		{apiService: bad, want: false},
+		{apiService: scopeTestAPIService("v1", "widgets,Worse"), want: true},
+		{apiService: scopeTestAPIService("v1", ""), want: true},
+		{apiService: scopeTestAPIService("v1", ""), want: false},
+		{apiService: bad, want: true},
+	}
+	for i, step := range steps {
+		if got := h.scopeOptIn.changed(scopeOptInKey(step.apiService)); got != step.want {
+			t.Fatalf("step %d: changed = %v, want %v", i, got, step.want)
+		}
+	}
+}
