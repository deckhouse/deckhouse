+// TestProxyScope_WatchRefreshFailures: failing recomputations end the stream
+// only after the grace period; an answer that the read is not filtered any
+// more ends it at once.
+func TestProxyScope_WatchRefreshFailures(t *testing.T) {
+	t.Run("persistent failure ends the stream after the grace period", func(t *testing.T) {
+		const grace = 150 * time.Millisecond
+		closedBefore := proxiedWatchClosed(t, scopefilter.ProxiedWatchClosedRefreshFailed)
+		floor := &liveAnswer{set: nsSet("a", "b")}
+		resolvers := filteredWatchResolvers(floor)
+		resolvers.ProxiedWatchRefreshGrace = grace
+		p := newWatchProxy(t, resolvers, filteredWatchTag, false, true)
+		s := p.watch(t, "/apis/"+scopeTestGroup+"/v1/widgets?watch=true")
+
+		failing := time.Now()
+		floor.update(nil, errors.New("boom"))
+		select {
+		case err := <-s.ended:
+			if err != nil {
+				t.Errorf("the stream ended with %v, want a normal end", err)
+			}
+			if elapsed := time.Since(failing); elapsed < grace {
+				t.Errorf("the stream ended %s after the failures started, before the grace period of %s", elapsed, grace)
+			}
+		case <-time.After(scopeWatchDeadline):
+			t.Fatal("the stream is still open after the grace period")
+		}
+		waitFor(t, p.backend.ended, "the backend request to end")
+		if got := proxiedWatchClosed(t, scopefilter.ProxiedWatchClosedRefreshFailed) - closedBefore; got != 1 {
+			t.Errorf("refresh_failed closes = %v, want 1", got)
+		}
+	})
+
+	t.Run("cluster-wide access ends the stream at once", func(t *testing.T) {
