+const (
+	scopeWatchInterval = 10 * time.Millisecond
+	scopeWatchDeadline = 5 * time.Second
+)
+
+// liveAnswer is an answer of a fake resolver the test changes while a watch
+// is open.
+type liveAnswer struct {
+	mu       sync.Mutex
+	set      map[string]struct{}
+	err      error
+	failNext int
+	calls    int
+}
+
+var errTransient = errors.New("transient")
+
+func (a *liveAnswer) answer() (map[string]struct{}, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.calls++
+	if a.failNext > 0 {
+		a.failNext--
+		return nil, errTransient
+	}
+	return a.set, a.err
+}
+
+func (a *liveAnswer) update(set map[string]struct{}, err error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.set, a.err = set, err
+}
+
+func (a *liveAnswer) fail(n int) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.failNext = n
+}
+
+func (a *liveAnswer) callCount() int {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return a.calls
+}
+
+type liveFloor struct{ *liveAnswer }
+
+func (f liveFloor) Resolve(context.Context, user.Info, schema.GroupVersionResource, string, string) (map[string]struct{}, error) {
+	return f.answer()
+}
+
+type liveClassify struct{ *liveAnswer }
+
+func (c liveClassify) Resolve(context.Context, scopefilter.Kind, string) (map[string]struct{}, error) {
+	return c.answer()
+}
+
+// watchBackend is an extension server that streams: a plain watch gets one
+// event and stays open until its request ends; a websocket watch gets a
+// message every few milliseconds until the connection breaks.
+type watchBackend struct {
+	mu    sync.Mutex
+	proto string
+	query url.Values
+
+	started chan struct{}
+	ended   chan struct{}
+}
+
+func (b *watchBackend) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	b.mu.Lock()
+	b.proto = r.Proto
+	b.query = r.URL.Query()
+	b.mu.Unlock()
+	if r.Header.Get("Upgrade") != "" {
+		websocket.Handler(func(ws *websocket.Conn) {
+			b.started <- struct{}{}
+			defer func() { b.ended <- struct{}{} }()
+			for {
+				if _, err := ws.Write([]byte("event\n")); err != nil {
+					return
+				}
+				time.Sleep(5 * time.Millisecond)
+			}
+		}).ServeHTTP(w, r)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+	_, _ = fmt.Fprintln(w, `{"type":"ADDED"}`)
+	w.(http.Flusher).Flush()
+	b.started <- struct{}{}
+	<-r.Context().Done()
+	b.ended <- struct{}{}
+}
+
+func (b *watchBackend) snapshot() (string, url.Values) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.proto, b.query
+}
+
+func newWatchBackend(t *testing.T, http2 bool) (*watchBackend, *httptest.Server) {
+	t.Helper()
+	b := &watchBackend{started: make(chan struct{}, 16), ended: make(chan struct{}, 16)}
+	srv := httptest.NewUnstartedServer(b)
+	cert, err := tls.X509KeyPair(svcCrt, svcKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv.TLS = &tls.Config{Certificates: []tls.Certificate{cert}}
+	srv.EnableHTTP2 = http2
+	srv.StartTLS()
+	t.Cleanup(srv.Close)
+	return b, srv
+}
+
+type watchProxy struct {
+	server  *httptest.Server
+	client  *http.Client
+	backend *watchBackend
+	handler *proxyHandler
+}
+
+// newScopeWatchHandler is the proxy handler of the opted-in APIService of the
+// watch tests, published in the proxied registry as the aggregator does: the
+// refresher of a watch ends it once the registry stops listing the resource.
+func newScopeWatchHandler(t *testing.T, resolvers *scopefilter.Resolvers, backendServer *httptest.Server) *proxyHandler {
+	t.Helper()
+	h := &proxyHandler{
+		localDelegate:              http.NewServeMux(),
+		serviceResolver:            &mockedRouter{destinationHost: backendServer.Listener.Addr().String()},
+		proxyCurrentCertKeyContent: func() ([]byte, []byte) { return emptyCert(), emptyCert() },
+		scopeResolvers:             resolvers,
+	}
+	apiService := scopeTestAPIService("v1", "widgets")
+	h.updateAPIService(apiService)
+	syncProxiedResources(apiService.Name, h)
+	t.Cleanup(func() { scopefilter.UnregisterProxied(apiService.Name) })
+	return h
+}
+
+func newWatchProxy(t *testing.T, resolvers *scopefilter.Resolvers, tag scopeTag, frontendHTTP2, backendHTTP2 bool) *watchProxy {
+	t.Helper()
+	backend, backendServer := newWatchBackend(t, backendHTTP2)
+	h := newScopeWatchHandler(t, resolvers, backendServer)
+	srv := httptest.NewUnstartedServer(contextHandler(withScopeTag(h, tag), scopeTestUser))
+	if frontendHTTP2 {
+		srv.EnableHTTP2 = true
+		srv.StartTLS()
+	} else {
+		srv.Start()
+	}
+	t.Cleanup(srv.Close)
+	return &watchProxy{server: srv, client: srv.Client(), backend: backend, handler: h}
+}
+
+// watchStream is an open watch read by the test.
+type watchStream struct {
+	resp  *http.Response
+	ended chan error
+}
+
+func (p *watchProxy) watch(t *testing.T, path string) *watchStream {
+	t.Helper()
+	resp, err := p.client.Get(p.server.URL + path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = resp.Body.Close() })
+	if resp.StatusCode != http.StatusOK {
+		body, _ := io.ReadAll(resp.Body)
+		t.Fatalf("status = %d: %s", resp.StatusCode, body)
+	}
+	reader := bufio.NewReader(resp.Body)
+	if _, err := reader.ReadString('\n'); err != nil {
+		t.Fatalf("reading the first event: %v", err)
+	}
+	waitFor(t, p.backend.started, "the backend to start streaming")
+	s := &watchStream{resp: resp, ended: make(chan error, 1)}
+	go func() {
+		_, err := io.Copy(io.Discard, reader)
+		s.ended <- err
+	}()
+	return s
+}
+
+func waitFor(t *testing.T, ch <-chan struct{}, what string) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(scopeWatchDeadline):
+		t.Fatalf("timed out waiting for %s", what)
+	}
+}
+
+// waitUntil polls cond until it holds or the deadline passes.
+func waitUntil(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(scopeWatchDeadline)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatalf("timed out waiting for %s", what)
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// waitNoRefreshers waits until no refresher runs: the tests run one at a time
+// and every request of an earlier test has ended or is ending.
+func waitNoRefreshers(t *testing.T) {
+	t.Helper()
+	waitUntil(t, "every refresher to exit", func() bool { return activeScopeRefreshers.Load() == 0 })
+}
+
+func proxiedWatchClosed(t *testing.T, reason string) float64 {
+	t.Helper()
+	values, err := testutil.GetCounterValuesFromGatherer(legacyregistry.DefaultGatherer, "apiserver_scopefilter_proxied_watch_closed_total", nil, "reason")
+	if err != nil {
+		// Not reported before the first increment.
+		return 0
+	}
+	return values[reason]
+}
