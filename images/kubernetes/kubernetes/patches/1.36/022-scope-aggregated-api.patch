+		if !w.waitBackendClosed(30 * time.Second) {
+			t.Error("the backend watch did not end with the stream")
+		}
+	})
+
+	t.Run("ScopedWatchEndsWithExpiredWhenTheOptInIsWithdrawn", func(t *testing.T) {
+		const user = "scopeext-denied-watch-opt-out"
+		name := extVersion + "." + toggleGroup
+		path := gizmosPath(toggleGroup)
+		scoped := map[string]string{scopeHeader: "accessible"}
+		c := newDenied(user)
+		setAPIServiceAnnotation(ctx, t, aggregator, name, extResource)
+		pollUntil(ctx, t, "the opt-in of "+name+" to take effect", func() (bool, string) {
+			status, body, _ := c.get(ctx, path, ids.next(), scoped)
+			return status == http.StatusOK, fmt.Sprintf("status %d: %s", status, body)
+		})
+		w := openScopedWatch(ctx, t, c, ext, path+"?watch=true", ids.next(), scoped)
+		requireScope(t, w.backendRequest, scopeModeFiltered, "scopeext-alpha")
+		setAPIServiceAnnotation(ctx, t, aggregator, name, "")
+		requireExpiredEvent(t, w.resp.Body, 30*time.Second)
+		if !w.waitBackendClosed(30 * time.Second) {
+			t.Error("the backend watch did not end with the stream")
+		}
+	})
+}
