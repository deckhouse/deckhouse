+// TestUpgradeAwareProxyIgnoresContext shows why the refresher closes the
+// hijacked connection itself: once a connection is upgraded, the upgrade-aware
+// proxy keeps copying after the context of the request ends.
+func TestUpgradeAwareProxyIgnoresContext(t *testing.T) {
+	backend, backendServer := newWatchBackend(t, false)
+	location, err := url.Parse(backendServer.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	canceled := make(chan struct{})
+	front := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ctx, cancel := context.WithCancel(r.Context())
+		// The request is canceled while the stream is up.
+		go func() {
+			<-backend.started
+			cancel()
+			close(canceled)
+		}()
+		h := proxy.NewUpgradeAwareHandler(location, backendServer.Client().Transport, false, true, &responder{w: w})
+		h.ServeHTTP(w, r.WithContext(ctx))
+	}))
+	t.Cleanup(front.Close)
+
+	cfg, err := websocket.NewConfig("ws://"+front.Listener.Addr().String()+"/watch", "http://127.0.0.1/")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ws, err := websocket.DialConfig(cfg)
+	if err != nil {
+		t.Fatalf("websocket dial: %v", err)
+	}
+	t.Cleanup(func() { _ = ws.Close() })
+	waitFor(t, canceled, "the request to be canceled")
+	ended := readUntilError(ws)
+	select {
+	case err := <-ended:
+		t.Fatalf("the websocket ended (%v): the upgrade-aware proxy now honors the context, the explicit close may be redundant", err)
+	case <-time.After(20 * scopeWatchInterval):
+	}
+}
+
+// TestProxyScope_WatchOutsideTheSet: a filtered watch in a namespace outside
+// the set is forwarded with the empty set and ends once the namespace joins
+// the set; a filtered watch ends as well once its set holds a name that is not
+// a namespace name, which would be refused now.
+func TestProxyScope_WatchOutsideTheSet(t *testing.T) {
+	base := "/apis/" + scopeTestGroup + "/v1"
+	tests := []struct {
+		name string
+		tag  scopeTag
+		path string
+		next map[string]struct{}
+	}{
+		{name: "the namespace joins the set", tag: filteredWatchTag, path: base + "/namespaces/c/widgets?watch=true", next: nsSet("a", "b", "c")},
+		// The accessible scope: the set is the floor, not intersected with
+		// the classification.
+		{name: "an invalid name in the set", tag: scopeTag{req: scopeAccessible, bypass: true}, path: base + "/widgets?watch=true", next: nsSet("a", "b", "c,d")},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			waitNoRefreshers(t)
+			floor := &liveAnswer{set: nsSet("a", "b")}
+			p := newWatchProxy(t, filteredWatchResolvers(floor), tc.tag, false, true)
+			s := p.watch(t, tc.path)
+			select {
+			case err := <-s.ended:
+				t.Fatalf("the stream ended before the set changed: %v", err)
+			case <-time.After(5 * scopeWatchInterval):
+			}
+
+			floor.update(tc.next, nil)
+			select {
+			case <-s.ended:
+			case <-time.After(scopeWatchDeadline):
+				t.Fatal("the stream is still open after the set changed")
+			}
+			waitFor(t, p.backend.ended, "the backend request to end")
+			waitNoRefreshers(t)
+		})
+	}
+}
