+
+// Deckhouse: scope filtering of reads served by an aggregated API server. The
+// authorization filter lets a scoped read of an opted-in resource through (see
+// scopefilter.IsProxied); the proxy computes the allowed set of namespaces with
+// the decision the storage Decorator uses and sends it to the extension server
+// in the trusted headers scopefilter.HeaderScopeMode and
+// scopefilter.HeaderScopeNamespaces, which the extension filters by. The
+// upstream handler_proxy.go carries only the calls into this file.
+
+const (
+	// scopeHeaderLimit is the header limit of the receiving server:
+	// k8s.io/apiserver secure serving sets MaxHeaderBytes to 1 MiB, the
+	// net/http default, and its HTTP/2 server derives the header list limit
+	// from it.
+	scopeHeaderLimit = 1 << 20
+
+	// scopeHeaderMargin covers headers added after the estimate: tracing,
+	// X-Forwarded-*, Accept-Encoding and transport framing.
+	scopeHeaderMargin = 16 << 10
+
+	// headerFieldOverhead is the per-field overhead HTTP/2 counts against the
+	// header list limit (RFC 7540, 6.5.2). It exceeds the HTTP/1.1 overhead
+	// (": " and CRLF), so the estimate holds for both.
+	headerFieldOverhead = 32
+
+	auditScopeModeKey       = "scope.deckhouse.io/proxied-mode"
+	auditScopeNamespacesKey = "scope.deckhouse.io/proxied-namespaces"
+)
+
+// scopedResourcesOf returns the resources apiService opted in to scope
+// filtering. It logs the entries it ignores when logIgnored is set: the
+// handler sets it only when the opt-in changed, since an APIService is updated
+// on every change of its status.
+func scopedResourcesOf(apiService *apiregistrationv1api.APIService, logIgnored bool) []schema.GroupResource {
+	value, ok := apiService.Annotations[scopefilter.AnnotationProxiedResources]
+	if !ok {
+		return nil
+	}
+	if apiService.Spec.Service == nil {
+		if logIgnored {
+			klog.Warningf("scopefilter: ignoring %s on APIService %s: it is served locally, not proxied", scopefilter.AnnotationProxiedResources, apiService.Name)
+		}
+		return nil
+	}
+	grs, errs := scopefilter.ParseProxiedResources(apiService.Spec.Group, value)
+	if logIgnored {
+		for _, err := range errs {
+			klog.Warningf("scopefilter: APIService %s: %v", apiService.Name, err)
+		}
+	}
+	return grs
+}
+
+// scopeOptInKey identifies what scopedResourcesOf reads from apiService.
+func scopeOptInKey(apiService *apiregistrationv1api.APIService) string {
+	value, ok := apiService.Annotations[scopefilter.AnnotationProxiedResources]
+	if !ok {
+		return ""
+	}
+	return fmt.Sprintf("%t/%s/%s", apiService.Spec.Service == nil, apiService.Spec.Group, value)
+}
+
+// scopedResourcesOfUpdate is scopedResourcesOf for an update of the APIService
+// the handler serves: the ignored entries are logged once per opt-in.
+func (r *proxyHandler) scopedResourcesOfUpdate(apiService *apiregistrationv1api.APIService) map[string]struct{} {
+	// Updates of one APIService come one at a time; a copy of the handler
+	// shares the record.
+	if r.scopeOptIn == nil {
+		r.scopeOptIn = &scopeOptInLog{}
+	}
+	return resourceSet(scopedResourcesOf(apiService, r.scopeOptIn.changed(scopeOptInKey(apiService))))
+}
+
+// scopeOptInLog remembers the opt-in of an APIService last logged.
+type scopeOptInLog struct {
+	mu   sync.Mutex
+	last string
+}
+
+// changed records key and reports whether it differs from the one before.
+func (l *scopeOptInLog) changed(key string) bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	changed := key != l.last
+	l.last = key
+	return changed
+}
+
+func resourceSet(grs []schema.GroupResource) map[string]struct{} {
+	if len(grs) == 0 {
+		return nil
+	}
+	out := make(map[string]struct{}, len(grs))
+	for _, gr := range grs {
+		out[gr.Resource] = struct{}{}
+	}
+	return out
+}
+
+// stripTrustedScopeHeaders removes client copies of the headers only
+// kube-apiserver may set. It runs on every proxied request, opted in or not:
+// an extension server honours the headers on any request that reaches it
+// through this proxy, authenticated as kube-apiserver's front proxy (see the
+// contract in scopefilter's proxied.go).
+//
+// A copy is any header whose name equals a trusted one ignoring case with "_"
+// read as "-": net/http keeps a name with "_" as it came, and a receiver or
+// an intermediary may read it as the "-" spelling (CGI-style mapping).
+//
+// It also removes them from the Connection header: the reverse proxy drops
+// every header Connection names as hop-by-hop, so a client naming one there
+// would make the proxy drop the value kube-apiserver set -- the mode without
+// the set, or the set without the mode. Other tokens, Upgrade included, stay.
+//
+// The same goes for the trailers of the request: the names it declares in the
+// Trailer header and the request Trailer map, whose values the server reads
+// after the body. newReq shares that map with the request it was made from,
+// so it gets a copy of its own without the trusted names.
+func stripTrustedScopeHeaders(newReq *http.Request) {
+	stripTrustedScopeHeaderFields(newReq.Header)
+	stripTrustedScopeTokens(newReq.Header, "Trailer")
+	trusted := false
+	for k := range newReq.Trailer {
+		if isTrustedScopeHeader(k) {
+			trusted = true
+			break
+		}
+	}
+	if !trusted {
+		return
+	}
+	// The values of the other trailers are filled in the shared map, not in
+	// this copy, so they are not forwarded either: a request to an API
+	// server carries no trailers that matter.
+	kept := http.Header{}
+	for k := range newReq.Trailer {
+		if !isTrustedScopeHeader(k) {
+			kept[k] = nil
+		}
+	}
+	newReq.Trailer = kept
+}
+
+func stripTrustedScopeHeaderFields(h http.Header) {
+	for k := range h {
+		if isTrustedScopeHeader(k) {
+			delete(h, k)
+		}
+	}
+	stripTrustedScopeTokens(h, "Connection")
+}
+
+// stripTrustedScopeTokens removes the trusted names from the comma-separated
+// list of header names in the header field.
+func stripTrustedScopeTokens(h http.Header, field string) {
+	values, ok := h[field]
+	if !ok {
+		return
+	}
+	var kept []string
+	for _, v := range values {
+		var tokens []string
+		for _, token := range strings.Split(v, ",") {
+			token = strings.TrimSpace(token)
+			if token == "" || isTrustedScopeHeader(token) {
+				continue
+			}
+			tokens = append(tokens, token)
+		}
+		if len(tokens) > 0 {
+			kept = append(kept, strings.Join(tokens, ", "))
+		}
+	}
+	if len(kept) == 0 {
+		delete(h, field)
+		return
+	}
+	h[field] = kept
+}
+
+func isTrustedScopeHeader(name string) bool {
+	name = strings.ReplaceAll(name, "_", "-")
+	for _, k := range scopefilter.TrustedHeaders {
+		if strings.EqualFold(name, k) {
+			return true
+		}
+	}
+	return false
+}
+
+// applyScope decides a proxied read the authorization filter tagged for scope
+// filtering. It returns the request to forward, with the trusted headers set
+// when the read is filtered, or false when it answered the request itself:
+// every failure answers rather than forwards, so the extension server never
+// gets a read RBAC denied without the set to filter it by.
+//
+// For a filtered watch it also returns the refresher of the set sent, see
+// handler_proxy_scopewatch.go; the forwarded request carries its context. The
+// caller defers its end; a nil refresher ends as a no-op.
+func (r *proxyHandler) applyScope(w http.ResponseWriter, req, newReq *http.Request, info proxyHandlingInfo, u user.Info, userUID string) (*http.Request, *scopeRefresher, bool) {
+	ctx := req.Context()
+	_, scoped := scopefilter.RequestFrom(ctx)
+	bypass := scopefilter.IsBypass(ctx)
+	requestInfo, _ := genericapirequest.RequestInfoFrom(ctx)
+
+	var gr schema.GroupResource
+	name := ""
+	if requestInfo != nil {
+		gr = schema.GroupResource{Group: requestInfo.APIGroup, Resource: requestInfo.Resource}
+		name = requestInfo.Name
+	}
+
+	// The namespaces filter is never served by an aggregated API server.
+	if scopefilter.IsNamespaceFilteringMode(ctx) {
+		writeScopeError(w, req, refusedUnfiltered(gr, name, info.name))
+		return nil, nil, false
+	}
+
+	if !scoped || !info.servesScoped(requestInfo) {
+		if bypass {
+			// Let through for a filter this APIService does not apply: the
+			// annotation was removed, or another version of the group
+			// opted the resource in.
+			writeScopeError(w, req, refusedUnfiltered(gr, name, info.name))
+			return nil, nil, false
+		}
+		// An allowed caller: the scope is ignored for a resource this
+		// version does not filter, as it is for a built-in resource without
+		// the filter, which the authorization filter does not even tag.
+		return newReq, nil, true
+	}
+
+	gvr := gr.WithVersion(requestInfo.APIVersion)
+	decision, err := r.decideScope(ctx, u, requestInfo, info.name)
+	if err != nil {
+		writeScopeError(w, req, scopefilter.ResolveError(gvr, u, requestInfo.Verb, name, err))
+		return nil, nil, false
+	}
+	if decision.refusal != nil {
+		writeScopeError(w, req, decision.refusal)
+		return nil, nil, false
+	}
+	if !decision.filter {
+		// An allowed caller asking for the accessible scope: nothing to
+		// filter, the read is forwarded as is.
+		return newReq, nil, true
+	}
+
+	watch := requestInfo.Verb == "watch"
+	_, watchTimeout, _ := r.scopeResolvers.ProxiedWatchLimits()
+	if watch {
+		capWatchTimeout(newReq.URL, watchTimeout)
+	}
+
+	newReq.Header.Set(scopefilter.HeaderScopeMode, decision.mode)
+	newReq.Header.Set(scopefilter.HeaderScopeNamespaces, decision.header())
+
+	if size := outgoingHeaderBytes(newReq, u, userUID); size > scopeHeaderLimit-scopeHeaderMargin {
+		scopefilter.RecordProxiedHeaderLimitRejection()
+		writeScopeError(w, req, apierrors.NewBadRequest(fmt.Sprintf(
+			"the allowed set of %d namespaces for %s needs about %d bytes of request headers, more than the %d bytes an aggregated API server accepts; use a narrower --scope",
+			len(decision.names), gr, size, scopeHeaderLimit-scopeHeaderMargin)))
+		return nil, nil, false
+	}
+
+	scopefilter.RecordProxiedSet(len(decision.names))
+	audit.AddAuditAnnotations(ctx,
+		auditScopeModeKey, decision.mode,
+		auditScopeNamespacesKey, strconv.Itoa(len(decision.names)))
+
+	if !watch {
+		return newReq, nil, true
+	}
+	refresher := r.startScopeRefresher(newReq.Context(), u, requestInfo, info.name, decision.names)
+	return newReq.WithContext(refresher.ctx), refresher, true
+}
+
+// scopeDecision is what the proxy does with a scoped read: answer it with
+// refusal, forward it as is (filter is false), or forward it with the allowed
+// set names in mode.
+type scopeDecision struct {
+	refusal error
+	filter  bool
+	mode    string
+	names   []string
+}
+
+// header is the value of scopefilter.HeaderScopeNamespaces for the decision.
+func (d scopeDecision) header() string {
+	return strings.Join(d.names, ",")
+}
+
+// decideScope computes the decision for a scoped read of a resource the
+// APIService apiService opted in. err is a failure to compute the allowed
+// set. The refresher of a proxied watch calls it again with the same inputs,
+// so the set it compares is the one this read would be sent now.
+func (r *proxyHandler) decideScope(ctx context.Context, u user.Info, requestInfo *genericapirequest.RequestInfo, apiService string) (scopeDecision, error) {
+	bypass := scopefilter.IsBypass(ctx)
+	gr := schema.GroupResource{Group: requestInfo.APIGroup, Resource: requestInfo.Resource}
+	gvr := gr.WithVersion(requestInfo.APIVersion)
+	name := requestInfo.Name
+
+	set, restrict, err := r.scopeResolvers.AllowedNamespaces(ctx, u, gvr, "", requestInfo.Verb)
+	if err != nil {
+		return scopeDecision{}, err
+	}
+
+	mode := scopefilter.ScopeModeNarrowed
+	if bypass {
+		mode = scopefilter.ScopeModeFiltered
+	}
+	if !restrict {
+		if bypass {
+			// A bypassed read always carries the RBAC floor.
+			klog.Errorf("scopefilter: no allowed set computed for a denied read of %s through APIService %s; refusing", gvr, apiService)
+			return scopeDecision{refusal: refusedUnfiltered(gr, name, apiService)}, nil
+		}
+		return scopeDecision{}, nil
+	}
+
+	if bypass && requestInfo.Verb == "get" && (name == "." || name == "..") {
+		// Not an object name: a receiver that cleans the path would serve
+		// another resource, the list of the namespace or of the group.
+		return scopeDecision{refusal: apierrors.NewNotFound(gr, name)}, nil
+	}
+
+	if ns := requestInfo.Namespace; ns != "" {
+		if _, in := set[ns]; in {
+			set = map[string]struct{}{ns: {}}
+		} else {
+			if bypass && requestInfo.Verb == "get" {
+				// The answer of the storage Decorator: an object outside
+				// the set is indistinguishable from one that does not exist.
+				return scopeDecision{refusal: apierrors.NewNotFound(gr, name)}, nil
+			}
+			// A list or watch in a namespace outside the set is the empty
+			// set, as the Decorator answers it with an empty list.
+			set = map[string]struct{}{}
+		}
+	}
+
+	names := make([]string, 0, len(set))
+	for n := range set {
+		// The names are joined with "," into one header: a name that is not
+		// a namespace name could carry several, or a malformed value.
+		if msgs := validation.IsDNS1123Label(n); len(msgs) > 0 {
+			klog.Errorf("scopefilter: the allowed set of a read of %s through APIService %s contains %q, which is not a namespace name (%s); refusing", gvr, apiService, n, strings.Join(msgs, "; "))
+			return scopeDecision{refusal: apierrors.NewInternalError(errors.New("the allowed set of namespaces contains an invalid namespace name"))}, nil
+		}
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	return scopeDecision{filter: true, mode: mode, names: names}, nil
+}
+
+// servesScoped reports whether this APIService opted in the resource of a
+// read the scope filter can serve: a top-level list, get or watch.
+func (info proxyHandlingInfo) servesScoped(requestInfo *genericapirequest.RequestInfo) bool {
+	if requestInfo == nil || !requestInfo.IsResourceRequest || requestInfo.Subresource != "" {
+		return false
+	}
+	switch requestInfo.Verb {
+	case "list", "get", "watch":
+	default:
+		return false
+	}
+	if requestInfo.APIGroup != info.group {
+		return false
+	}
+	_, ok := info.scopedResources[requestInfo.Resource]
+	return ok
+}
+
+func refusedUnfiltered(gr schema.GroupResource, name, apiService string) error {
+	// Any caller can send such a read; V(2) keeps them out of the default log.
+	klog.V(2).InfoS("scopefilter: a read let through for the filter reached an APIService that does not filter the resource; refusing", "apiService", apiService, "resource", gr)
+	return apierrors.NewForbidden(gr, name, errors.New("the aggregated API server does not filter this resource by scope"))
+}
+
+// outgoingHeaderBytes estimates the request header size the extension server
+// receives, including the identity headers the proxy transport adds after
+// this point.
+func outgoingHeaderBytes(newReq *http.Request, u user.Info, userUID string) int {
+	h := newReq.Header.Clone()
+	transport.SetAuthProxyHeaders(&http.Request{Header: h}, u.GetName(), userUID, u.GetGroups(), u.GetExtra())
+	n := len(newReq.Method) + len(newReq.URL.RequestURI()) + len("HTTP/1.1") + 4
+	n += len("Host") + len(newReq.Host) + headerFieldOverhead
+	for k, vv := range h {
+		for _, v := range vv {
+			n += len(k) + len(v) + headerFieldOverhead
+		}
+	}
+	return n
+}
+
+// writeScopeError answers a scoped read with err as a Status in the media type
+// the client accepts, the form of every other API error: a 404 for an object
+// outside the set is indistinguishable from the 404 of a missing object.
+func writeScopeError(w http.ResponseWriter, req *http.Request, err error) {
+	var status apierrors.APIStatus
+	if !errors.As(err, &status) {
+		err = apierrors.NewInternalError(err)
+	}
+	code := responsewriters.ErrorNegotiated(err, aggregatorscheme.Codecs, metav1.Unversioned, w, req)
+	if info, ok := genericapirequest.RequestInfoFrom(req.Context()); ok {
+		endpointmetrics.RecordRequestTermination(req, info, aggregatorComponent, code)
+	}
+}
+
+// syncProxiedResources publishes what the APIService served by handler opted
+// in, after the handler was updated. The authorization filter lets reads
+// through by this registry; the handler refuses any it does not filter
+// itself, so the two disagreeing for a moment fails closed either way.
+func syncProxiedResources(apiServiceName string, handler *proxyHandler) {
+	value := handler.handlingInfo.Load()
+	if value == nil {
+		scopefilter.UnregisterProxied(apiServiceName)
+		return
+	}
+	info := value.(proxyHandlingInfo)
+	if info.local || len(info.scopedResources) == 0 {
+		scopefilter.UnregisterProxied(apiServiceName)
+		return
+	}
+	if handler.scopeResolvers == nil {
+		// Nothing could compute a set: an allowed scoped read keeps the
+		// vanilla behaviour and a denied one gets the plain 403 of the
+		// authorization filter, rather than the proxy refusing each.
+		klog.V(2).InfoS("scopefilter: ignoring the opt-in of an APIService: kube-aggregator has no scope resolvers", "apiService", apiServiceName)
+		scopefilter.UnregisterProxied(apiServiceName)
+		return
+	}
+	grs := make([]schema.GroupResource, 0, len(info.scopedResources))
+	for resource := range info.scopedResources {
+		grs = append(grs, schema.GroupResource{Group: info.group, Resource: resource})
+	}
+	scopefilter.RegisterProxied(apiServiceName, info.version, grs)
+}
