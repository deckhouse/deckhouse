+// TestScopeWatchWriter_Framing: the writer forwards whole frames only, across
+// writes split anywhere.
+func TestScopeWatchWriter_Framing(t *testing.T) {
+	// Each part ends where a whole frame, or whitespace between frames, does.
+	join := func(parts ...[]byte) ([]byte, []int) {
+		var stream []byte
+		var ends []int
+		for _, part := range parts {
+			stream = append(stream, part...)
+			ends = append(ends, len(stream))
+		}
+		return stream, ends
+	}
+	json, jsonFrames := join([]byte(`{"a":"x}\\"}`), []byte("\n"), []byte(`{"b":[{"c":"\"}"}]}`), []byte("\r"), []byte("\n"), []byte(" "), []byte("{}"), []byte("\n"))
+	proto, protoFrames := join([]byte{0, 0, 0, 1, 'x'}, []byte{0, 0, 0, 0}, []byte{0, 0, 0, 3, 'a', 'b', 'c'})
+	for _, tc := range []struct {
+		name        string
+		contentType string
+		stream      []byte
+		frames      []int
+	}{
+		{name: "JSON", contentType: runtime.ContentTypeJSON, stream: json, frames: jsonFrames},
+		{name: "protobuf", contentType: protobufWatchMediaType, stream: proto, frames: protoFrames},
+	} {
+		for split := 1; split < len(tc.stream); split++ {
+			rec := httptest.NewRecorder()
+			rec.Header().Set("Content-Type", tc.contentType)
+			w := &scopeWatchWriter{ResponseWriter: rec}
+			if _, err := w.Write(tc.stream[:split]); err != nil {
+				t.Fatal(err)
+			}
+			want := 0
+			for _, end := range tc.frames {
+				if end <= split {
+					want = end
+				}
+			}
+			if got := rec.Body.Len(); got != want {
+				t.Fatalf("%s, split at %d: forwarded %d bytes, want %d", tc.name, split, got, want)
+			}
+			if _, err := w.Write(tc.stream[split:]); err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(rec.Body.Bytes(), tc.stream) {
+				t.Fatalf("%s, split at %d: forwarded %q", tc.name, split, rec.Body.Bytes())
+			}
+		}
+	}
+
+	t.Run("an error answer is not framed", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		rec.Header().Set("Content-Type", runtime.ContentTypeJSON)
+		w := &scopeWatchWriter{ResponseWriter: rec}
+		w.WriteHeader(http.StatusGone)
+		_, _ = w.Write([]byte("{\"kind\""))
+		w.finish(errScopeSetChanged)
+		if rec.Body.String() != "{\"kind\"" {
+			t.Fatalf("body = %q", rec.Body.String())
+		}
+	})
+	t.Run("an informational answer does not decide", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		rec.Header().Set("Content-Type", runtime.ContentTypeJSON)
+		w := &scopeWatchWriter{ResponseWriter: rec}
+		if w.Unwrap() != rec {
+			t.Fatal("Unwrap does not return the client writer")
+		}
+		w.WriteHeader(http.StatusEarlyHints)
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("{}\n{\"kind\""))
+		w.finish(errScopeSetChanged)
+		body := rec.Body.String()
+		if !strings.HasPrefix(body, "{}\n{\"type\":\"ERROR\"") || !strings.Contains(body, `"code":410`) {
+			t.Fatalf("body = %q", body)
+		}
+	})
+	t.Run("a frame past the bound is forwarded as it comes", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		rec.Header().Set("Content-Type", runtime.ContentTypeJSON)
+		w := &scopeWatchWriter{ResponseWriter: rec}
+		open := append([]byte(`{"a":"`), bytes.Repeat([]byte("x"), maxBufferedWatchFrame)...)
+		_, _ = w.Write([]byte("{}\n"))
+		_, _ = w.Write(open[:len(open)/2])
+		if got := rec.Body.Len(); got != 3 {
+			t.Fatalf("forwarded %d bytes before the bound, want 3", got)
+		}
+		_, _ = w.Write(open[len(open)/2:])
+		if got := rec.Body.Len(); got != 3+len(open) || len(w.pending) != 0 {
+			t.Fatalf("forwarded %d bytes, %d pending, want %d and 0", got, len(w.pending), 3+len(open))
+		}
+		_, _ = w.Write([]byte("x"))
+		w.finish(errScopeSetChanged)
+		if got := rec.Body.Len(); got != 4+len(open) {
+			t.Fatalf("forwarded %d bytes after the switch, want %d", got, 4+len(open))
+		}
+	})
+	t.Run("the buffer of a large frame is released", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		rec.Header().Set("Content-Type", runtime.ContentTypeJSON)
+		w := &scopeWatchWriter{ResponseWriter: rec}
+		large := append(append([]byte(`{"a":"`), bytes.Repeat([]byte("x"), 1<<20)...), []byte("\"}\n")...)
+		_, _ = w.Write(large[:10])
+		_, _ = w.Write(large[10:])
+		if cap(w.pending) > maxIdleWatchBuffer {
+			t.Fatalf("pending keeps %d bytes", cap(w.pending))
+		}
+		if rec.Body.Len() != len(large) {
+			t.Fatalf("forwarded %d bytes, want %d", rec.Body.Len(), len(large))
+		}
+	})
+	t.Run("a compressed stream is not framed", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		rec.Header().Set("Content-Type", runtime.ContentTypeJSON)
+		rec.Header().Set("Content-Encoding", "gzip")
+		w := &scopeWatchWriter{ResponseWriter: rec}
+		_, _ = w.Write([]byte("\x1f\x8b"))
+		w.finish(errScopeSetChanged)
+		if rec.Body.String() != "\x1f\x8b" {
+			t.Fatalf("body = %q", rec.Body.String())
+		}
+	})
+}
