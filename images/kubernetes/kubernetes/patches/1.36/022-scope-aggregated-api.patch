+// TestAPIServiceScopeLifecycle: the proxied registry follows add, update and
+// removal of APIServices, ignoring local APIServices and the permission
+// service.
+func TestAPIServiceScopeLifecycle(t *testing.T) {
+	widgets := schema.GroupResource{Group: scopeTestGroup, Resource: "widgets"}
+	gadgets := schema.GroupResource{Group: scopeTestGroup, Resource: "gadgets"}
+	s := newTestAggregator()
+	t.Cleanup(func() {
+		s.RemoveAPIService("v1." + scopeTestGroup)
+		s.RemoveAPIService("v2." + scopeTestGroup)
+	})
+
+	// Added without the annotation, then annotated (the update path).
+	if err := s.AddAPIService(scopeTestAPIService("v1", "")); err != nil {
+		t.Fatal(err)
+	}
+	if scopefilter.IsProxied(widgets) {
+		t.Fatal("proxied without the annotation")
+	}
+	if err := s.AddAPIService(scopeTestAPIService("v1", "widgets,gadgets")); err != nil {
+		t.Fatal(err)
+	}
+	if !scopefilter.IsProxied(widgets) || !scopefilter.IsProxied(gadgets) {
+		t.Fatal("annotation added on update is not applied")
+	}
+	if _, ok := s.proxyHandlers["v1."+scopeTestGroup].handlingInfo.Load().(proxyHandlingInfo).scopedResources["gadgets"]; !ok {
+		t.Fatal("handler does not filter an annotated resource")
+	}
+
+	// A second version of the group keeps widgets proxied.
+	if err := s.AddAPIService(scopeTestAPIService("v2", "widgets")); err != nil {
+		t.Fatal(err)
+	}
+	if !scopefilter.IsProxiedVersion(widgets.WithVersion("v2")) || scopefilter.IsProxiedVersion(gadgets.WithVersion("v2")) {
+		t.Fatal("the registry does not follow the version that opted the resource in")
+	}
+	if err := s.AddAPIService(scopeTestAPIService("v1", "widgets")); err != nil {
+		t.Fatal(err)
+	}
+	if scopefilter.IsProxied(gadgets) {
+		t.Fatal("gadgets proxied after the annotation dropped it")
+	}
+	s.RemoveAPIService("v1." + scopeTestGroup)
+	if !scopefilter.IsProxied(widgets) {
+		t.Fatal("widgets not proxied although v2 still lists it")
+	}
+
+	// The annotation removed on update.
+	if err := s.AddAPIService(scopeTestAPIService("v2", "")); err != nil {
+		t.Fatal(err)
+	}
+	if scopefilter.IsProxied(widgets) {
+		t.Fatal("widgets proxied after the annotation was removed")
+	}
+
+	// Switched to a local APIService: ignored.
+	if err := s.AddAPIService(scopeTestAPIService("v2", "widgets")); err != nil {
+		t.Fatal(err)
+	}
+	local := scopeTestAPIService("v2", "widgets")
+	local.Spec.Service = nil
+	if err := s.AddAPIService(local); err != nil {
+		t.Fatal(err)
+	}
+	if scopefilter.IsProxied(widgets) {
+		t.Fatal("a local APIService opted in")
+	}
+	s.RemoveAPIService("v2." + scopeTestGroup)
+
+	// The permission service is never opted in.
+	perm := scopeTestAPIService("v1alpha1", "selfscopedaccessreviews")
+	perm.Name = "v1alpha1.authorization.deckhouse.io"
+	perm.Spec.Group = "authorization.deckhouse.io"
+	if err := s.AddAPIService(perm); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { s.RemoveAPIService(perm.Name) })
+	if scopefilter.IsProxied(schema.GroupResource{Group: "authorization.deckhouse.io", Resource: "selfscopedaccessreviews"}) {
+		t.Fatal("the permission service opted in")
+	}
+}
