@@ -505,8 +505,9 @@ func nodeHostsFileContent(hostsFilePath string, hostAliases []v1.HostAlias) ([]b
 	}
 	var buffer bytes.Buffer
 	buffer.WriteString(managedHostsHeaderWithHostNetwork)
