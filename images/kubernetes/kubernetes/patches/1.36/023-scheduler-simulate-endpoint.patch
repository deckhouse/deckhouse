+// RemovePods frees their nodes for the simulation only: the snapshot used by
+// real cycles keeps the Pods and the PVCs they use.
+func TestDeckhouseSimulateRemovePods(t *testing.T) {
+	logger, ctx := ktesting.NewTestContext(t)
+	sched := makeScheduler(ctx, makeNodeList([]string{"1", "2"}))
+	schedFramework, err := tf.NewFramework(ctx,
+		[]tf.RegisterPluginFunc{
+			tf.RegisterQueueSortPlugin(queuesort.Name, queuesort.New),
+			tf.RegisterFilterPlugin("NoPodsFilter", NewNoPodsFilterPlugin),
+			tf.RegisterScorePlugin("NumericMap", newNumericMapPlugin(), 1),
+			tf.RegisterBindPlugin(defaultbinder.Name, defaultbinder.New),
+		},
+		v1.DefaultSchedulerName,
+		frameworkruntime.WithPodNominator(internalqueue.NewTestQueue(ctx, nil)),
+		frameworkruntime.WithSnapshotSharedLister(sched.nodeInfoSnapshot),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sched.Profiles = map[string]framework.Framework{v1.DefaultSchedulerName: schedFramework}
+	blocker := &v1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: "blocker", Namespace: "ns", UID: "blocker"},
+		Spec: v1.PodSpec{NodeName: "2", Volumes: []v1.Volume{{Name: "data", VolumeSource: v1.VolumeSource{
+			PersistentVolumeClaim: &v1.PersistentVolumeClaimVolumeSource{ClaimName: "data"}}}}},
+	}
+	if err := sched.Cache.AddPod(logger, blocker); err != nil {
+		t.Fatal(err)
+	}
+	// The same name with another UID on node 1: the old Pod, not yet gone from the cache.
+	oldBlocker := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "blocker", Namespace: "ns", UID: "blocker-old"}, Spec: v1.PodSpec{NodeName: "1"}}
+	if err := sched.Cache.AddPod(logger, oldBlocker); err != nil {
+		t.Fatal(err)
+	}
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "web", Namespace: "ns"}}
+
+	node2 := func(resp *SimulateResponse) string {
+		for _, n := range resp.Nodes {
+			if n.Name == "2" {
+				return n.Verdict
+			}
+		}
+		return ""
+	}
+
+	resp, err := sched.Simulate(ctx, &SimulateRequest{Pod: pod})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if node2(resp) != VerdictRejected || len(resp.BestNodes) != 0 {
+		t.Fatalf("with both blockers: node 2 %s, best %v", node2(resp), resp.BestNodes)
+	}
+
+	// With a UID only that entry is removed.
+	resp, err = sched.Simulate(ctx, &SimulateRequest{Pod: pod, RemovePods: []internalcache.DeckhousePodRef{{Namespace: "ns", Name: "blocker", UID: "blocker-old"}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if node2(resp) != VerdictRejected || !reflect.DeepEqual(resp.BestNodes, []string{"1"}) {
+		t.Fatalf("old blocker removed by UID: node 2 %s, best %v", node2(resp), resp.BestNodes)
+	}
+
+	resp, err = sched.Simulate(ctx, &SimulateRequest{Pod: pod, RemovePods: []internalcache.DeckhousePodRef{
+		{Namespace: "ns", Name: "blocker"}, {Namespace: "ns", Name: "gone"},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Without a UID both entries are removed, whatever the map order.
+	if node2(resp) != VerdictFeasible || !reflect.DeepEqual(resp.BestNodes, []string{"2"}) {
+		t.Errorf("blockers removed: node 2 %s, best %v", node2(resp), resp.BestNodes)
+	}
+	if !reflect.DeepEqual(resp.RemovedPods, []string{"ns/blocker"}) || !reflect.DeepEqual(resp.NotFoundPods, []string{"ns/gone"}) {
+		t.Errorf("removed %v, not found %v", resp.RemovedPods, resp.NotFoundPods)
+	}
+
+	// A ref without a UID removes every entry even next to a ref with a UID.
+	resp, err = sched.Simulate(ctx, &SimulateRequest{Pod: pod, RemovePods: []internalcache.DeckhousePodRef{
+		{Namespace: "ns", Name: "blocker", UID: "blocker-old"}, {Namespace: "ns", Name: "blocker"},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if node2(resp) != VerdictFeasible {
+		t.Errorf("mixed refs: node 2 %s, want both blockers removed", node2(resp))
+	}
+
+	ni, err := sched.nodeInfoSnapshot.Get("2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ni.GetPods()) != 1 || !sched.nodeInfoSnapshot.IsPVCUsedByPods("ns/data") {
+		t.Errorf("snapshot not restored: %d pods on node 2, PVC used %v", len(ni.GetPods()), sched.nodeInfoSnapshot.IsPVCUsedByPods("ns/data"))
+	}
+	resp, err = sched.Simulate(ctx, &SimulateRequest{Pod: pod})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if node2(resp) != VerdictRejected {
+		t.Errorf("after a simulation with RemovePods node 2 is %s for the next one", node2(resp))
+	}
+}
+
+// filters=all lists every failing filter plugin of a node in the plugin order,
+// weights=true adds the weight and the normalized score; without them the
+// answer is the same as before.
+func TestDeckhouseSimulateDetails(t *testing.T) {
+	_, ctx := ktesting.NewTestContext(t)
+	sched := newSimulateTestScheduler(t, ctx, []string{"1", "2", "3"},
+		tf.RegisterFilterPlugin("FakeFilter", tf.NewFakeFilterPlugin(map[string]fwk.Code{"3": fwk.Unschedulable})))
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "vm", Namespace: "ns"}}
+
+	byName := func(resp *SimulateResponse) map[string]SimulateNode {
+		m := map[string]SimulateNode{}
+		for _, n := range resp.Nodes {
+			m[n.Name] = n
+		}
+		return m
+	}
+
+	plain, err := sched.Simulate(ctx, &SimulateRequest{Pod: pod, ExcludeNodes: []string{"3"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := byName(plain)["3"]; n.RejectedBy != nodeaffinityplugin.Name || n.Rejections != nil {
+		t.Errorf("plain: node 3 = %+v, want the first plugin only", n)
+	}
+	if s := byName(plain)["1"].Scores[0]; s.Weight != 0 || s.Normalized != nil {
+		t.Errorf("plain: score = %+v, want no weight", s)
+	}
+
+	full, err := sched.Simulate(ctx, &SimulateRequest{Pod: pod, ExcludeNodes: []string{"3"}, Weights: true, AllFilters: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	n3 := byName(full)["3"]
+	var plugins []string
+	for _, r := range n3.Rejections {
+		plugins = append(plugins, r.Plugin)
+	}
+	if n3.RejectedBy != nodeaffinityplugin.Name || !reflect.DeepEqual(plugins, []string{nodeaffinityplugin.Name, "FakeFilter"}) {
+		t.Errorf("filters=all: node 3 = %+v, want NodeAffinity then FakeFilter", n3)
+	}
+	if s := byName(full)["1"].Scores[0]; s.Name != "NumericMap" || s.Weight != 1 || s.Normalized == nil || *s.Normalized != s.Score {
+		t.Errorf("weights=true: score = %+v, want weight 1 and normalized = score", s)
+	}
+}
+
+// Plugin weights come from the profile, extender weights from the extender
+// config; only prioritizing extenders score.
+func TestDeckhouseSimulateWeights(t *testing.T) {
+	_, ctx := ktesting.NewTestContext(t)
+	sched := newSimulateTestScheduler(t, ctx, []string{"1"})
+	sched.Extenders = []fwk.Extender{
+		&HTTPExtender{extenderURL: "https://sds", prioritizeVerb: "prioritize", weight: 5},
+		&HTTPExtender{extenderURL: "https://filter-only", filterVerb: "filter", weight: 3},
+	}
+	got := sched.deckhouseWeights(sched.Profiles[v1.DefaultSchedulerName])
+	if want := map[string]int64{"NumericMap": 1, "https://sds": 5}; !reflect.DeepEqual(got, want) {
+		t.Errorf("weights = %v, want %v", got, want)
+	}
+
+	nodes, _ := simulateScoredNodes([]fwk.NodePluginScores{{
+		Name:       "hv-01",
+		TotalScore: 520,
+		Scores:     []fwk.PluginScore{{Name: "https://sds", Score: 500}, {Name: "NumericMap", Score: 20}, {Name: "unknown", Score: 7}},
+	}}, got)
+	want := []int64{100, 20, -1}
+	for i, s := range nodes[0].Scores {
+		n := int64(-1)
+		if s.Normalized != nil {
+			n = *s.Normalized
+		}
+		if n != want[i] {
+			t.Errorf("%s: normalized = %d, want %d", s.Name, n, want[i])
+		}
+	}
+}
+
+func TestDeckhouseSimulateQuery(t *testing.T) {
+	cases := []struct {
+		query           string
+		weights, filter bool
+		bad             bool
+	}{
+		{query: ""},
+		{query: "weights=true&filters=all", weights: true, filter: true},
+		{query: "weights=false&filters=first"},
+		{query: "weights=yes", bad: true},
+		{query: "filters=some", bad: true},
+		{query: "filters=all&filters=all", bad: true},
+		{query: "nodes=all", bad: true},
+	}
+	for _, tc := range cases {
+		q, err := url.ParseQuery(tc.query)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var req SimulateRequest
+		err = simulateQuery(q, &req)
+		if (err != nil) != tc.bad {
+			t.Errorf("%q: err = %v, want error %v", tc.query, err, tc.bad)
+			continue
+		}
+		if !tc.bad && (req.Weights != tc.weights || req.AllFilters != tc.filter) {
+			t.Errorf("%q: weights=%v filters=all %v", tc.query, req.Weights, req.AllFilters)
+		}
+	}
+}
+
+// The copy keeps the UID and the claim statuses of the original Pod: generic
+// ephemeral volumes and DRA claims belong to the Pod by its UID. A Pod without
+// a UID gets one. A body Pod needs a namespace and a name, and the two ways to
+// name the Pod exclude each other.
+func TestDeckhouseSimulationPod(t *testing.T) {
+	_, ctx := ktesting.NewTestContext(t)
+	sched := newSimulateTestScheduler(t, ctx, []string{"1"})
+	claim := "vm-disk-0"
+	original := &v1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: "vm", Namespace: "ns", UID: "original"},
+		Spec:       v1.PodSpec{NodeName: "1"},
+		Status: v1.PodStatus{
+			Phase:                 v1.PodRunning,
+			NominatedNodeName:     "1",
+			ResourceClaimStatuses: []v1.PodResourceClaimStatus{{Name: "disk", ResourceClaimName: &claim}},
+		},
+	}
+	got, err := sched.simulationPod(ctx, &SimulateRequest{Pod: original})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.UID != "original" || got.Spec.NodeName != "" || got.Status.Phase != "" || got.Status.NominatedNodeName != "" {
+		t.Errorf("copy = uid %q node %q phase %q nominated %q", got.UID, got.Spec.NodeName, got.Status.Phase, got.Status.NominatedNodeName)
+	}
+	if !reflect.DeepEqual(got.Status.ResourceClaimStatuses, original.Status.ResourceClaimStatuses) {
+		t.Errorf("claim statuses = %v", got.Status.ResourceClaimStatuses)
+	}
+	if original.Spec.NodeName != "1" || original.Annotations != nil {
+		t.Errorf("the request Pod was modified: %+v", original)
+	}
+
+	fresh, err := sched.simulationPod(ctx, &SimulateRequest{Pod: &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "new", Namespace: "ns"}}})
+	if err != nil || fresh.UID == "" {
+		t.Errorf("a Pod without a UID: uid %q, err %v", fresh.UID, err)
+	}
+
+	for name, req := range map[string]*SimulateRequest{
+		"no namespace": {Pod: &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "vm"}}},
+		"both forms":   {Pod: original, Namespace: "ns", Name: "vm"},
+		"nothing":      {},
+	} {
+		_, err := sched.simulationPod(ctx, req)
+		if code, _ := simulateHTTPStatus(err); code != http.StatusBadRequest {
+			t.Errorf("%s: code %d (%v), want 400", name, code, err)
+		}
+	}
+}
+
+// countingFilter rejects every node and counts its calls.
+type countingFilter struct{ calls *atomic.Int32 }
+
+func (f countingFilter) Name() string { return "CountingFilter" }
+
+func (f countingFilter) Filter(context.Context, fwk.CycleState, *v1.Pod, fwk.NodeInfo) *fwk.Status {
+	f.calls.Add(1)
+	return fwk.NewStatus(fwk.Unschedulable, "counted")
+}
+
+// Without filters=all a node rejected by one plugin is not passed to the next
+// one, as in a real cycle: the plain path is the upstream path.
+func TestDeckhouseSimulateFirstFilterStops(t *testing.T) {
+	_, ctx := ktesting.NewTestContext(t)
+	calls := &atomic.Int32{}
+	counting := func(context.Context, runtime.Object, fwk.Handle) (fwk.Plugin, error) {
+		return countingFilter{calls: calls}, nil
+	}
+	sched := newSimulateTestScheduler(t, ctx, []string{"1", "2"}, tf.RegisterFilterPlugin("CountingFilter", counting))
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "vm", Namespace: "ns"}}
+
+	if _, err := sched.Simulate(ctx, &SimulateRequest{Pod: pod, ExcludeNodes: []string{"1", "2"}}); err != nil {
+		t.Fatal(err)
+	}
+	if n := calls.Load(); n != 0 {
+		t.Errorf("first failure: CountingFilter called %d times, want 0", n)
+	}
+	if _, err := sched.Simulate(ctx, &SimulateRequest{Pod: pod, ExcludeNodes: []string{"1", "2"}, AllFilters: true}); err != nil {
+		t.Fatal(err)
+	}
+	if n := calls.Load(); n != 2 {
+		t.Errorf("filters=all: CountingFilter called %d times, want 2", n)
+	}
+}
+
+// The handler answers in the documented codes and runs one simulation at a time.
+func TestDeckhouseSimulateHandler(t *testing.T) {
+	logger, ctx := ktesting.NewTestContext(t)
+	sched := newSimulateTestScheduler(t, ctx, []string{"1"})
+	synced := make(chan struct{})
+	h := newDeckhouseSimulateHandler(sched, func() bool { return true }, synced, logger)
+	body := `{"pod": {"metadata": {"namespace": "ns", "name": "vm"}}}`
+	call := func(method, query, body string) *httptest.ResponseRecorder {
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, httptest.NewRequest(method, "/simulate"+query, strings.NewReader(body)))
+		return w
+	}
+
+	if code := call(http.MethodPost, "", body).Code; code != http.StatusServiceUnavailable {
+		t.Errorf("before sync: %d, want 503", code)
+	}
+	close(synced)
+	if code := call(http.MethodGet, "", body).Code; code != http.StatusMethodNotAllowed {
+		t.Errorf("GET: %d, want 405", code)
+	}
+	for _, q := range []string{"?weights=%zz", "?nodes=all", "?filters=some"} {
+		if code := call(http.MethodPost, q, body).Code; code != http.StatusBadRequest {
+			t.Errorf("query %q: %d, want 400", q, code)
+		}
+	}
+	if code := call(http.MethodPost, "", "{").Code; code != http.StatusBadRequest {
+		t.Errorf("broken JSON: %d, want 400", code)
+	}
+
+	h.busy <- struct{}{}
+	w := call(http.MethodPost, "", body)
+	<-h.busy
+	if w.Code != http.StatusTooManyRequests || w.Header().Get("Retry-After") == "" {
+		t.Errorf("while busy: %d, Retry-After %q, want 429 with Retry-After", w.Code, w.Header().Get("Retry-After"))
+	}
+
+	w = call(http.MethodPost, "?weights=true&filters=all", body)
+	if w.Code != http.StatusOK || !strings.Contains(w.Body.String(), `"leader":true`) {
+		t.Errorf("simulation: %d %s", w.Code, w.Body.String())
+	}
+}
