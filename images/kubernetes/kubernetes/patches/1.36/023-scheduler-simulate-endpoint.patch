+// Nodes without an own status are NotEvaluated unless PreFilter rejected all of them.
+func TestDeckhouseSimulateOtherNodes(t *testing.T) {
+	all := []fwk.NodeInfo{}
+	for _, n := range makeNodeList([]string{"1", "2", "3"}) {
+		ni := framework.NewNodeInfo()
+		ni.SetNode(n)
+		all = append(all, ni)
+	}
+
+	statuses := framework.NewDefaultNodeToStatus()
+	statuses.Set("2", fwk.NewStatus(fwk.Unschedulable, "disk is full").WithPlugin("https://sds/scheduler"))
+	got := simulateOtherNodes(all, all[:1], statuses, nil, nil)
+	want := []SimulateNode{
+		{Name: "2", Verdict: VerdictRejected, RejectedBy: "https://sds/scheduler", Reasons: []string{"disk is full"}},
+		{Name: "3", Verdict: VerdictNotEvaluated},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("got %+v, want %+v", got, want)
+	}
+
+	statuses = framework.NewDefaultNodeToStatus()
+	statuses.SetAbsentNodesStatus(fwk.NewStatus(fwk.UnschedulableAndUnresolvable, "no claim").WithPlugin("DynamicResources"))
+	got = simulateOtherNodes(all, nil, statuses, nil, nil)
+	for _, n := range got {
+		if n.Verdict != VerdictRejected || n.RejectedBy != "DynamicResources" {
+			t.Errorf("PreFilter rejection: %+v", n)
+		}
+	}
+
+	// PreFilter narrowed the search to nodes 1 and 2, the filters reached node 1 only.
+	statuses = framework.NewDefaultNodeToStatus()
+	statuses.SetAbsentNodesStatus(fwk.NewStatus(fwk.UnschedulableAndUnresolvable, "node(s) didn't satisfy plugin(s) [NodeAffinity]"))
+	statuses.Set("1", fwk.NewStatus(fwk.Unschedulable, "taint").WithPlugin("TaintToleration"))
+	got = simulateOtherNodes(all, nil, statuses, sets.New("1", "2"), nil)
+	verdicts := map[string]string{}
+	for _, n := range got {
+		verdicts[n.Name] = n.Verdict
+	}
+	if want := map[string]string{"1": VerdictRejected, "2": VerdictNotEvaluated, "3": VerdictRejected}; !reflect.DeepEqual(verdicts, want) {
+		t.Errorf("narrowed PreFilter: verdicts = %v, want %v", verdicts, want)
+	}
+}
