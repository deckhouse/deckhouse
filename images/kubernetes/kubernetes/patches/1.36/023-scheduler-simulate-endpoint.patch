+func TestDeckhouseSimulateErrors(t *testing.T) {
+	_, ctx := ktesting.NewTestContext(t)
+	sched := newSimulateTestScheduler(t, ctx, []string{"1"})
+
+	cancelled, cancel := context.WithCancel(ctx)
+	cancel()
+	named := metav1.ObjectMeta{Name: "vm", Namespace: "ns"}
+	_, err := sched.Simulate(cancelled, &SimulateRequest{Pod: &v1.Pod{ObjectMeta: named}})
+	if code, _ := simulateHTTPStatus(err); code != http.StatusGatewayTimeout {
+		t.Errorf("cancelled context: code %d (%v), want 504", code, err)
+	}
+
+	_, err = sched.Simulate(ctx, &SimulateRequest{})
+	if code, _ := simulateHTTPStatus(err); code != http.StatusBadRequest {
+		t.Errorf("empty request: code %d (%v), want 400", code, err)
+	}
+
+	_, err = sched.Simulate(ctx, &SimulateRequest{Pod: &v1.Pod{ObjectMeta: named, Spec: v1.PodSpec{SchedulerName: "unknown"}}})
+	if code, _ := simulateHTTPStatus(err); code != http.StatusBadRequest {
+		t.Errorf("unknown profile: code %d (%v), want 400", code, err)
+	}
+
+	notFound := apierrors.NewNotFound(schema.GroupResource{Resource: "pods"}, "vm")
+	if code, _ := simulateHTTPStatus(notFound); code != http.StatusNotFound {
+		t.Errorf("not found: code %d, want 404", code)
+	}
+	if code, msg := simulateHTTPStatus(context.DeadlineExceeded); code != http.StatusGatewayTimeout || msg == context.DeadlineExceeded.Error() {
+		t.Errorf("deadline: code %d, msg %q", code, msg)
+	}
+}
