+// An excluded node must not match whichever required term the Pod has, and the
+// other nodes must still match: matchFields takes one value per requirement.
+func TestDeckhouseExcludeNodes(t *testing.T) {
+	node := func(name, zone string) *v1.Node {
+		return &v1.Node{ObjectMeta: metav1.ObjectMeta{Name: name, Labels: map[string]string{"zone": zone}}}
+	}
+	nodes := []*v1.Node{node("hv-01", "a"), node("hv-02", "a"), node("hv-03", "a"), node("hv-04", "b")}
+
+	cases := []struct {
+		name string
+		pod  *v1.Pod
+		want map[string]bool
+	}{{
+		name: "no affinity",
+		pod:  &v1.Pod{},
+		want: map[string]bool{"hv-01": false, "hv-02": false, "hv-03": true, "hv-04": true},
+	}, {
+		name: "two terms, one by zone and one by name",
+		pod: &v1.Pod{Spec: v1.PodSpec{Affinity: &v1.Affinity{NodeAffinity: &v1.NodeAffinity{
+			RequiredDuringSchedulingIgnoredDuringExecution: &v1.NodeSelector{NodeSelectorTerms: []v1.NodeSelectorTerm{
+				{MatchExpressions: []v1.NodeSelectorRequirement{{Key: "zone", Operator: v1.NodeSelectorOpIn, Values: []string{"a"}}}},
+				{MatchFields: []v1.NodeSelectorRequirement{{Key: "metadata.name", Operator: v1.NodeSelectorOpIn, Values: []string{"hv-02"}}}},
+			}},
+		}}}},
+		want: map[string]bool{"hv-01": false, "hv-02": false, "hv-03": true, "hv-04": false},
+	}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			excludeNodes(tc.pod, []string{"hv-01", "hv-02"})
+			req := nodeaffinity.GetRequiredNodeAffinity(tc.pod)
+			for _, n := range nodes {
+				got, err := req.Match(n)
+				if err != nil {
+					t.Fatalf("%s: %v", n.Name, err)
+				}
+				if got != tc.want[n.Name] {
+					t.Errorf("%s: match = %v, want %v", n.Name, got, tc.want[n.Name])
+				}
+			}
+		})
+	}
+
+	untouched := &v1.Pod{}
+	excludeNodes(untouched, nil)
+	if untouched.Spec.Affinity != nil {
+		t.Fatalf("no excluded nodes must leave the pod as is")
+	}
+}
