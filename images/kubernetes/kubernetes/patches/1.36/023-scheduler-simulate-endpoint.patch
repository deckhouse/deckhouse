+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package scheduler
+
+// Deckhouse: dry-run scheduling endpoint.
+//
+// POST /simulate answers "which node would this Pod get right now": it runs the
+// same PreFilter, Filter, filter extenders, PreScore, Score and prioritize
+// extenders as a real scheduling cycle, on the same cache, and returns every
+// node with its verdict and per-plugin weighted scores. Nothing is reserved,
+// assumed, bound or nominated, the OpportunisticBatching hints of real cycles
+// are not read, and the extension point duration, plugin evaluation and
+// prioritizing-extender goroutine metrics are not recorded.
+//
+// Query parameters add details to the answer and cost nothing outside the
+// request: weights=true adds the weight and the normalized score to every
+// score, filters=all runs every filter plugin on a node instead of stopping at
+// the first failure and lists all failures.
+//
+// The endpoint is plain HTTP on a loopback address only (the address comes from
+// DECKHOUSE_SCHEDULER_SIMULATE_ADDRESS); authentication and authorization are
+// done by kube-rbac-proxy in front of it.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"sort"
+	"strconv"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/sets"
+	"k8s.io/apimachinery/pkg/util/uuid"
+	"k8s.io/klog/v2"
+	fwk "k8s.io/kube-scheduler/framework"
+	internalcache "k8s.io/kubernetes/pkg/scheduler/backend/cache"
+	"k8s.io/kubernetes/pkg/scheduler/framework"
+)
+
+const (
+	deckhouseSimulateAddressEnv = "DECKHOUSE_SCHEDULER_SIMULATE_ADDRESS"
+	deckhouseSimulateMaxBody    = 1 << 20
+	deckhouseSimulateTimeout    = 30 * time.Second
+
+	// DeckhouseSimulationAnnotation marks the Pod copy, so that an extender can
+	// tell a simulation from a real cycle (e.g. not to reserve space for it).
+	DeckhouseSimulationAnnotation = "scheduler.deckhouse.io/simulation"
+)
+
+// Verdicts of a node in a simulation.
+const (
+	VerdictFeasible     = "Feasible"
+	VerdictRejected     = "Rejected"
+	VerdictNotEvaluated = "NotEvaluated"
+)
+
+// SimulateRequest names the Pod to place: either a full Pod object or a
+// reference to an existing Pod. Both lists are optional. ExcludeNodes are
+// removed from the candidates, e.g. the source node of a live migration.
+// RemovePods are scheduled Pods the simulation treats as deleted: they free
+// their node resources and stop counting in topology spread, inter-Pod affinity
+// and PVC usage. The caller decides what is gone: nothing for a live migration
+// (the source runs until the target is ready), the evicted Pod for "evict and
+// recreate", all Pods of a node for a scale-down check.
+type SimulateRequest struct {
+	Pod          *v1.Pod                         `json:"pod,omitempty"`
+	Namespace    string                          `json:"namespace,omitempty"`
+	Name         string                          `json:"name,omitempty"`
+	ExcludeNodes []string                        `json:"excludeNodes,omitempty"`
+	RemovePods   []internalcache.DeckhousePodRef `json:"removePods,omitempty"`
+
+	// Weights and AllFilters come from the query parameters weights=true and
+	// filters=all, not from the body.
+	Weights    bool `json:"-"`
+	AllFilters bool `json:"-"`
+}
+
+// SimulateScore is a weighted score of one score plugin or one extender. With
+// weights=true it also carries the weight and the normalized score, Score =
+// Normalized * Weight. Normalized is 0-100 for a plugin and the extender score
+// (0-10) times 10 for an extender.
+type SimulateScore struct {
+	Name       string `json:"name"`
+	Score      int64  `json:"score"`
+	Weight     int64  `json:"weight,omitempty"`
+	Normalized *int64 `json:"normalized,omitempty"`
+}
+
+// SimulateRejection is one failing filter plugin or extender of a node.
+type SimulateRejection struct {
+	Plugin  string   `json:"plugin"`
+	Reasons []string `json:"reasons,omitempty"`
+}
+
+// SimulateNode is the verdict for one node. RejectedBy is the plugin (filter or
+// PreFilter) or the extender that rejected the node; it is empty when PreFilter
+// narrowed the candidate list. NotEvaluated nodes were not reached: a real cycle
+// also stops after numFeasibleNodesToFind feasible nodes.
+type SimulateNode struct {
+	Name       string          `json:"name"`
+	Verdict    string          `json:"verdict"`
+	RejectedBy string          `json:"rejectedBy,omitempty"`
+	Reasons    []string        `json:"reasons,omitempty"`
+	TotalScore int64           `json:"totalScore,omitempty"`
+	Scores     []SimulateScore `json:"scores,omitempty"`
+	// Rejections lists every failing filter plugin with filters=all. An
+	// extender only sees the nodes that passed all filter plugins, so a node
+	// has either plugin rejections or one extender rejection.
+	Rejections []SimulateRejection `json:"rejections,omitempty"`
+}
+
+// SimulateResponse lists feasible nodes by total score (best first), then the
+// other ones by name. BestNodes holds every node with the top score: a real
+// cycle picks one of them at random.
+type SimulateResponse struct {
+	Pod              string         `json:"pod"`
+	Profile          string         `json:"profile"`
+	Leader           bool           `json:"leader"`
+	PreFilterMessage string         `json:"preFilterMessage,omitempty"`
+	BestNodes        []string       `json:"bestNodes"`
+	Nodes            []SimulateNode `json:"nodes"`
+	// RemovedPods are the RemovePods found in the cache, NotFoundPods the rest
+	// (already deleted or not scheduled yet).
+	RemovedPods  []string `json:"removedPods,omitempty"`
+	NotFoundPods []string `json:"notFoundPods,omitempty"`
+}
+
+// deckhouseExtenderStatus names the extender in its rejection status during a
+// simulation. Real cycles keep the upstream status without a plugin name.
+func deckhouseExtenderStatus(ctx context.Context, s *fwk.Status, extender fwk.Extender) *fwk.Status {
+	if framework.IsDeckhouseSimulation(ctx) {
+		return s.WithPlugin(extender.Name())
+	}
+	return s
+}
+
+// errSimulateRequest marks errors caused by the request itself.
+type errSimulateRequest struct{ error }
+
+// Simulate runs filtering and scoring for a copy of the Pod without touching
+// the cache. It holds deckhouseSimulateMu, so it never interleaves with the
+// synchronous part of a real scheduling cycle that shares the snapshot.
+func (sched *Scheduler) Simulate(ctx context.Context, req *SimulateRequest) (*SimulateResponse, error) {
+	pod, err := sched.simulationPod(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+	schedFramework, err := sched.frameworkForPod(pod)
+	if err != nil {
+		return nil, errSimulateRequest{err}
+	}
+
+	sched.deckhouseSimulateMu.Lock()
+	defer sched.deckhouseSimulateMu.Unlock()
+	// The request may have waited for the lock longer than its deadline.
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	// Keep the real cycles' round-robin start untouched by simulations.
+	savedStart := sched.nextStartNodeIndex
+	defer func() { sched.nextStartNodeIndex = savedStart }()
+
+	logger := klog.FromContext(ctx)
+	if err := sched.Cache.UpdateSnapshot(logger, sched.nodeInfoSnapshot); err != nil {
+		return nil, err
+	}
+	restore, removedPods, notFoundPods := sched.nodeInfoSnapshot.DeckhouseWithoutPods(logger, req.RemovePods)
+	defer restore()
+	// Listed after the removal: the nodes as the simulation sees them.
+	allNodes, err := sched.nodeInfoSnapshot.NodeInfos().List()
+	if err != nil {
+		return nil, err
+	}
+	if len(allNodes) == 0 {
+		return nil, ErrNoNodesAvailable
+	}
+
+	ctx = framework.WithDeckhouseSimulation(ctx)
+	var filterLog *framework.DeckhouseFilterLog
+	if req.AllFilters {
+		ctx, filterLog = framework.WithDeckhouseFilterLog(ctx)
+	}
+	state := framework.NewCycleState()
+	state.Write(framework.PodsToActivateKey, framework.NewPodsToActivate())
+	// The error is ignored as in the scheduling queue: the apiserver does not
+	// fully validate affinity terms.
+	podInfo, _ := framework.NewPodInfo(pod)
+	feasible, diagnosis, _, err := sched.findNodesThatFitPodWithHint(ctx, schedFramework, state, &framework.QueuedPodInfo{PodInfo: podInfo}, false)
+	// Filters stop on a cancelled context without an error, and a plugin may fail
+	// because of it: report the deadline first, never a partial result.
+	if ctxErr := ctx.Err(); ctxErr != nil {
+		return nil, ctxErr
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	resp := &SimulateResponse{
+		Pod:              pod.Namespace + "/" + pod.Name,
+		Profile:          schedFramework.ProfileName(),
+		PreFilterMessage: diagnosis.PreFilterMsg,
+		BestNodes:        []string{},
+		RemovedPods:      removedPods,
+		NotFoundPods:     notFoundPods,
+	}
+	if len(feasible) > 0 {
+		scores, err := prioritizeNodes(ctx, sched.Extenders, schedFramework, state, pod, feasible)
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			return nil, ctxErr
+		}
+		if err != nil {
+			return nil, err
+		}
+		var weights map[string]int64
+		if req.Weights {
+			weights = sched.deckhouseWeights(schedFramework)
+		}
+		resp.Nodes, resp.BestNodes = simulateScoredNodes(scores, weights)
+	}
+	resp.Nodes = append(resp.Nodes, simulateOtherNodes(allNodes, feasible, diagnosis.NodeToStatus, deckhouseCandidates(state), filterLog)...)
+	return resp, nil
+}
+
+// deckhouseWeights returns the weights of the score plugins of the profile and
+// of the extenders that score.
+func (sched *Scheduler) deckhouseWeights(schedFramework framework.Framework) map[string]int64 {
+	out := map[string]int64{}
+	if f, ok := schedFramework.(interface{ DeckhouseScorePluginWeights() map[string]int }); ok {
+		for name, w := range f.DeckhouseScorePluginWeights() {
+			out[name] = int64(w)
+		}
+	}
+	for _, e := range sched.Extenders {
+		if h, ok := e.(*HTTPExtender); ok && e.IsPrioritizer() {
+			out[e.Name()] = h.weight
+		}
+	}
+	return out
+}
+
+// simulationPod builds the Pod to place: an unscheduled copy that cannot land
+// on an excluded node. The copy keeps the UID and the claim statuses of the
+// original: generic ephemeral volumes and DRA claims belong to the Pod by its
+// UID, and template claims are found through the status, as for a real
+// re-schedule of the same Pod. Only a Pod without a UID gets a new one.
+func (sched *Scheduler) simulationPod(ctx context.Context, req *SimulateRequest) (*v1.Pod, error) {
+	var pod *v1.Pod
+	switch {
+	case req.Pod != nil && (req.Namespace != "" || req.Name != ""):
+		return nil, errSimulateRequest{errors.New("set either pod or namespace and name, not both")}
+	case req.Pod != nil:
+		if req.Pod.Namespace == "" || req.Pod.Name == "" {
+			return nil, errSimulateRequest{errors.New("pod.metadata.namespace and pod.metadata.name must be set")}
+		}
+		pod = req.Pod.DeepCopy()
+	case req.Namespace != "" && req.Name != "":
+		got, err := sched.client.CoreV1().Pods(req.Namespace).Get(ctx, req.Name, metav1.GetOptions{})
+		if err != nil {
+			return nil, err
+		}
+		pod = got.DeepCopy()
+	default:
+		return nil, errSimulateRequest{errors.New("either pod or namespace and name must be set")}
+	}
+
+	if pod.UID == "" {
+		pod.UID = uuid.NewUUID()
+	}
+	pod.ResourceVersion = ""
+	pod.Spec.NodeName = ""
+	pod.Status = v1.PodStatus{
+		ResourceClaimStatuses:       pod.Status.ResourceClaimStatuses,
+		ExtendedResourceClaimStatus: pod.Status.ExtendedResourceClaimStatus,
+	}
+	if pod.Spec.SchedulerName == "" {
+		pod.Spec.SchedulerName = v1.DefaultSchedulerName
+	}
+	if pod.Annotations == nil {
+		pod.Annotations = map[string]string{}
+	}
+	pod.Annotations[DeckhouseSimulationAnnotation] = "true"
+	excludeNodes(pod, req.ExcludeNodes)
+	return pod, nil
+}
+
+// excludeNodes adds "metadata.name NotIn [node]" for every excluded node to every
+// required node affinity term, or creates the single term when the Pod has none.
+// A matchFields requirement takes exactly one value, so each node gets its own
+// requirement; requirements inside a term are ANDed, terms are ORed.
+func excludeNodes(pod *v1.Pod, nodes []string) {
+	if len(nodes) == 0 {
+		return
+	}
+	reqs := make([]v1.NodeSelectorRequirement, 0, len(nodes))
+	for _, n := range nodes {
+		reqs = append(reqs, v1.NodeSelectorRequirement{Key: "metadata.name", Operator: v1.NodeSelectorOpNotIn, Values: []string{n}})
+	}
+
+	if pod.Spec.Affinity == nil {
+		pod.Spec.Affinity = &v1.Affinity{}
+	}
+	if pod.Spec.Affinity.NodeAffinity == nil {
+		pod.Spec.Affinity.NodeAffinity = &v1.NodeAffinity{}
+	}
+	na := pod.Spec.Affinity.NodeAffinity
+	if na.RequiredDuringSchedulingIgnoredDuringExecution == nil || len(na.RequiredDuringSchedulingIgnoredDuringExecution.NodeSelectorTerms) == 0 {
+		na.RequiredDuringSchedulingIgnoredDuringExecution = &v1.NodeSelector{
+			NodeSelectorTerms: []v1.NodeSelectorTerm{{MatchFields: reqs}},
+		}
+		return
+	}
+	terms := na.RequiredDuringSchedulingIgnoredDuringExecution.NodeSelectorTerms
+	for i := range terms {
+		terms[i].MatchFields = append(terms[i].MatchFields, reqs...)
+	}
+}
+
+// simulateScoredNodes sorts the feasible nodes by total score. With weights
+// (weights=true) every score gets its weight and normalized score.
+func simulateScoredNodes(scores []fwk.NodePluginScores, weights map[string]int64) ([]SimulateNode, []string) {
+	nodes := make([]SimulateNode, 0, len(scores))
+	for _, s := range scores {
+		n := SimulateNode{Name: s.Name, Verdict: VerdictFeasible, TotalScore: s.TotalScore}
+		for _, p := range s.Scores {
+			score := SimulateScore{Name: p.Name, Score: p.Score}
+			if w := weights[p.Name]; w > 0 {
+				normalized := p.Score / w
+				score.Weight, score.Normalized = w, &normalized
+			}
+			n.Scores = append(n.Scores, score)
+		}
+		nodes = append(nodes, n)
+	}
+	sort.SliceStable(nodes, func(i, j int) bool {
+		if nodes[i].TotalScore != nodes[j].TotalScore {
+			return nodes[i].TotalScore > nodes[j].TotalScore
+		}
+		return nodes[i].Name < nodes[j].Name
+	})
+	best := []string{}
+	for _, n := range nodes {
+		if n.TotalScore == nodes[0].TotalScore {
+			best = append(best, n.Name)
+		}
+	}
+	return nodes, best
+}
+
+// deckhouseCandidatesKey keeps the node list PreFilter narrowed the search to,
+// in a simulation only: the nodes of that list without a status of their own
+// were not reached by the filters, the other nodes were rejected by PreFilter.
+const deckhouseCandidatesKey fwk.StateKey = "deckhouse.io/simulation-candidates"
+
+type deckhouseCandidatesState struct{ names sets.Set[string] }
+
+func (s deckhouseCandidatesState) Clone() fwk.StateData { return s }
+
+func deckhouseRememberCandidates(ctx context.Context, state fwk.CycleState, names sets.Set[string]) {
+	if framework.IsDeckhouseSimulation(ctx) {
+		state.Write(deckhouseCandidatesKey, deckhouseCandidatesState{names: names})
+	}
+}
+
+func deckhouseCandidates(state fwk.CycleState) sets.Set[string] {
+	if d, err := state.Read(deckhouseCandidatesKey); err == nil {
+		return d.(deckhouseCandidatesState).names
+	}
+	return nil
+}
+
+// simulateOtherNodes reports the nodes that did not pass. A node with its own
+// status was rejected by a filter or an extender. A node without one shares the
+// "absent" status: without a message, or inside the candidate list PreFilter
+// narrowed the search to, the filters never reached it; otherwise PreFilter
+// rejected it.
+//
+// With a filter log (filters=all) a rejected node also lists every failing
+// filter plugin, or the one extender that rejected it.
+func simulateOtherNodes(all, feasible []fwk.NodeInfo, statuses *framework.NodeToStatus, candidates sets.Set[string], filterLog *framework.DeckhouseFilterLog) []SimulateNode {
+	ok := make(map[string]bool, len(feasible))
+	for _, n := range feasible {
+		ok[n.Node().Name] = true
+	}
+	explicit := map[string]*fwk.Status{}
+	statuses.ForEachExplicitNode(func(name string, s *fwk.Status) { explicit[name] = s })
+
+	var out []SimulateNode
+	for _, n := range all {
+		name := n.Node().Name
+		if ok[name] {
+			continue
+		}
+		node := SimulateNode{Name: name, Verdict: VerdictRejected}
+		s, found := explicit[name]
+		if !found {
+			s = statuses.AbsentNodesStatus()
+			if s == nil || len(s.Reasons()) == 0 || candidates.Has(name) {
+				node.Verdict = VerdictNotEvaluated
+			}
+		}
+		if node.Verdict == VerdictRejected && s != nil {
+			node.RejectedBy = s.Plugin()
+			node.Reasons = s.Reasons()
+			if filterLog != nil {
+				node.Rejections = simulateRejections(filterLog.Get(name), s)
+			}
+		}
+		out = append(out, node)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })
+	return out
+}
+
+// simulateRejections lists the recorded filter plugin failures of a node, or
+// its own status when nothing was recorded (an extender or PreFilter rejected
+// it).
+func simulateRejections(failed []*fwk.Status, own *fwk.Status) []SimulateRejection {
+	if len(failed) == 0 {
+		failed = []*fwk.Status{own}
+	}
+	out := make([]SimulateRejection, 0, len(failed))
+	for _, f := range failed {
+		out = append(out, SimulateRejection{Plugin: f.Plugin(), Reasons: f.Reasons()})
+	}
+	return out
+}
+
+// simulateQuery reads the query parameters into the request. Unknown
+// parameters and values are errors: a typo must not silently drop a detail.
+func simulateQuery(q url.Values, req *SimulateRequest) error {
+	for key, values := range q {
+		if len(values) != 1 {
+			return fmt.Errorf("parameter %q must be set once", key)
+		}
+		switch v := values[0]; key {
+		case "weights":
+			b, err := strconv.ParseBool(v)
+			if err != nil {
+				return fmt.Errorf("weights must be true or false, got %q", v)
+			}
+			req.Weights = b
+		case "filters":
+			switch v {
+			case "first":
+				req.AllFilters = false
+			case "all":
+				req.AllFilters = true
+			default:
+				return fmt.Errorf("filters must be first or all, got %q", v)
+			}
+		default:
+			return fmt.Errorf("unknown parameter %q, known: weights, filters", key)
+		}
+	}
+	return nil
+}
+
+// simulateHTTPStatus maps a Simulate error to a status code and a message for
+// the client. Internal errors are logged and not echoed back.
+func simulateHTTPStatus(err error) (int, string) {
+	var reqErr errSimulateRequest
+	switch {
+	case errors.As(err, &reqErr):
+		return http.StatusBadRequest, err.Error()
+	case apierrors.IsNotFound(err):
+		return http.StatusNotFound, err.Error()
+	case errors.Is(err, context.DeadlineExceeded), errors.Is(err, context.Canceled):
+		return http.StatusGatewayTimeout, "simulation did not finish in time"
+	case errors.Is(err, ErrNoNodesAvailable):
+		return http.StatusServiceUnavailable, err.Error()
+	default:
+		return http.StatusInternalServerError, "simulation failed, see the kube-scheduler log"
+	}
+}
+
+// deckhouseSimulateHandler serves POST /simulate. It runs one simulation at a
+// time: a simulation holds the lock that real scheduling cycles take, extender
+// calls included, so a queue of simulations would delay real scheduling. A
+// request that arrives while another one runs gets 429.
+type deckhouseSimulateHandler struct {
+	sched    *Scheduler
+	isLeader func() bool
+	synced   <-chan struct{}
+	logger   klog.Logger
+	busy     chan struct{}
+}
+
+func newDeckhouseSimulateHandler(sched *Scheduler, isLeader func() bool, synced <-chan struct{}, logger klog.Logger) *deckhouseSimulateHandler {
+	return &deckhouseSimulateHandler{sched: sched, isLeader: isLeader, synced: synced, logger: logger, busy: make(chan struct{}, 1)}
+}
+
+func (h *deckhouseSimulateHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "use POST", http.StatusMethodNotAllowed)
+		return
+	}
+	select {
+	case <-h.synced:
+	default:
+		http.Error(w, "scheduler cache is not synced yet", http.StatusServiceUnavailable)
+		return
+	}
+	var req SimulateRequest
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, deckhouseSimulateMaxBody)).Decode(&req); err != nil {
+		http.Error(w, fmt.Sprintf("bad request: %v", err), http.StatusBadRequest)
+		return
+	}
+	query, err := url.ParseQuery(r.URL.RawQuery)
+	if err == nil {
+		err = simulateQuery(query, &req)
+	}
+	if err != nil {
+		http.Error(w, fmt.Sprintf("bad request: %v", err), http.StatusBadRequest)
+		return
+	}
+	select {
+	case h.busy <- struct{}{}:
+		defer func() { <-h.busy }()
+	default:
+		w.Header().Set("Retry-After", "1")
+		http.Error(w, "another simulation is running, retry later", http.StatusTooManyRequests)
+		return
+	}
+	rctx, cancel := context.WithTimeout(klog.NewContext(r.Context(), h.logger), deckhouseSimulateTimeout)
+	defer cancel()
+	resp, err := h.sched.Simulate(rctx, &req)
+	if err != nil {
+		code, msg := simulateHTTPStatus(err)
+		if code == http.StatusInternalServerError {
+			h.logger.Error(err, "Simulation failed", "namespace", req.Namespace, "name", req.Name)
+		}
+		http.Error(w, msg, code)
+		return
+	}
+	resp.Leader = h.isLeader()
+	w.Header().Set("Content-Type", "application/json")
+	if err := json.NewEncoder(w).Encode(resp); err != nil {
+		h.logger.Error(err, "Failed to write simulate response")
+	}
+}
+
+// StartDeckhouseSimulateServer serves POST /simulate on the loopback address
+// from DECKHOUSE_SCHEDULER_SIMULATE_ADDRESS. It does nothing when the variable
+// is empty and refuses any non-loopback address: the endpoint has no auth of
+// its own. Requests get 503 until the scheduler handlers are synced.
+func StartDeckhouseSimulateServer(ctx context.Context, sched *Scheduler, isLeader func() bool, synced <-chan struct{}) {
+	logger := klog.FromContext(ctx)
+	addr := os.Getenv(deckhouseSimulateAddressEnv)
+	if addr == "" {
+		return
+	}
+	host, _, err := net.SplitHostPort(addr)
+	if ip := net.ParseIP(host); err != nil || ip == nil || !ip.IsLoopback() {
+		logger.Error(err, "Simulate endpoint is disabled: the address must be a loopback IP:port", "address", addr)
+		return
+	}
+
+	mux := http.NewServeMux()
+	mux.Handle("/simulate", newDeckhouseSimulateHandler(sched, isLeader, synced, logger))
+
+	srv := &http.Server{Addr: addr, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
+	go func() {
+		logger.Info("Serving the simulate endpoint", "address", addr)
+		if err := srv.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
+			logger.Error(err, "Simulate endpoint stopped")
+		}
+	}()
+	go func() {
+		<-ctx.Done()
+		shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		_ = srv.Shutdown(shutdownCtx)
+	}()
+}
