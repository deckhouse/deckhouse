+// A simulation runs the real filters, extenders and scores, answers with every
+// node, names the extender that rejected a node, and leaves the scheduler as it
+// was: no pods in the cache, the same round-robin start, no extension point metrics.
+func TestDeckhouseSimulate(t *testing.T) {
+	_, ctx := ktesting.NewTestContext(t)
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	metrics.Register()
+
+	sched := newSimulateTestScheduler(t, ctx, []string{"1", "2", "3", "4"})
+	sched.nextStartNodeIndex = 2
+	onlyNode1 := func(_ *v1.Pod, n fwk.NodeInfo) *fwk.Status {
+		if n.Node().Name == "1" {
+			return nil
+		}
+		return fwk.NewStatus(fwk.Unschedulable, "no replica")
+	}
+	sched.Extenders = []fwk.Extender{&tf.FakeExtender{ExtenderName: "sds", Predicates: []tf.FitPredicate{onlyNode1}}}
+	preFilterMetric := metrics.FrameworkExtensionPointDuration.WithLabelValues(metrics.PreFilter, fwk.Success.String(), v1.DefaultSchedulerName)
+	filterMetric := metrics.FrameworkExtensionPointDuration.WithLabelValues(metrics.Filter, fwk.Success.String(), v1.DefaultSchedulerName)
+	evalMetric := metrics.PluginEvaluationTotal.WithLabelValues(nodeaffinityplugin.Name, metrics.Filter, v1.DefaultSchedulerName)
+	metricsBefore, _ := testutil.GetHistogramMetricCount(preFilterMetric)
+	filterBefore, _ := testutil.GetHistogramMetricCount(filterMetric)
+	evalBefore, _ := testutil.GetCounterMetricValue(evalMetric)
+
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "vm", Namespace: "ns", UID: "original"}}
+	resp, err := sched.Simulate(ctx, &SimulateRequest{Pod: pod, ExcludeNodes: []string{"4", "3"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if !reflect.DeepEqual(resp.BestNodes, []string{"1"}) {
+		t.Errorf("bestNodes = %v, want [1]", resp.BestNodes)
+	}
+	type verdict struct{ verdict, by string }
+	got := map[string]verdict{}
+	for _, n := range resp.Nodes {
+		got[n.Name] = verdict{n.Verdict, n.RejectedBy}
+	}
+	want := map[string]verdict{
+		"1": {VerdictFeasible, ""},
+		"2": {VerdictRejected, "sds"},
+		"3": {VerdictRejected, nodeaffinityplugin.Name},
+		"4": {VerdictRejected, nodeaffinityplugin.Name},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("verdicts = %v, want %v", got, want)
+	}
+	if resp.Nodes[0].Name != "1" || len(resp.Nodes[0].Scores) == 0 || resp.Nodes[0].Scores[0].Name != "NumericMap" {
+		t.Errorf("first node = %+v, want node 1 with the NumericMap score", resp.Nodes[0])
+	}
+
+	if pod.UID != "original" || pod.Spec.Affinity != nil || pod.Annotations != nil {
+		t.Errorf("the request Pod was modified: %+v", pod)
+	}
+	if n, _ := sched.Cache.PodCount(); n != 0 {
+		t.Errorf("cache holds %d pods after a simulation", n)
+	}
+	if sched.nextStartNodeIndex != 2 {
+		t.Errorf("nextStartNodeIndex = %d, want 2", sched.nextStartNodeIndex)
+	}
+	if metricsAfter, _ := testutil.GetHistogramMetricCount(preFilterMetric); metricsAfter != metricsBefore {
+		t.Errorf("PreFilter duration observed %d times by a simulation", metricsAfter-metricsBefore)
+	}
+	if filterAfter, _ := testutil.GetHistogramMetricCount(filterMetric); filterAfter != filterBefore {
+		t.Errorf("Filter duration observed %d times by a simulation", filterAfter-filterBefore)
+	}
+	if evalAfter, _ := testutil.GetCounterMetricValue(evalMetric); evalAfter != evalBefore {
+		t.Errorf("NodeAffinity Filter evaluations counted %v times by a simulation", evalAfter-evalBefore)
+	}
+}
