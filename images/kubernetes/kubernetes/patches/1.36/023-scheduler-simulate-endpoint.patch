+// Every node sharing the top score is a candidate of a real cycle.
+func TestDeckhouseSimulateBestNodes(t *testing.T) {
+	nodes, best := simulateScoredNodes([]fwk.NodePluginScores{
+		{Name: "hv-03", TotalScore: 150},
+		{Name: "hv-02", TotalScore: 420},
+		{Name: "hv-01", TotalScore: 420},
