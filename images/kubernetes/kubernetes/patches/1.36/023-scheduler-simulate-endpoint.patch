+import (
+	"context"
+	"sync"
+
+	fwk "k8s.io/kube-scheduler/framework"
+)
+
+// Deckhouse: the context of a dry-run simulation (pkg/scheduler/deckhouse_simulate.go)
+// carries this marker. Extension point duration metrics are not recorded for it,
+// and extender rejections name the extender; real cycles are not affected.
+type deckhouseSimulationKey struct{}
+
+// WithDeckhouseSimulation marks the context as a simulation.
+func WithDeckhouseSimulation(ctx context.Context) context.Context {
+	return context.WithValue(ctx, deckhouseSimulationKey{}, true)
+}
+
+// IsDeckhouseSimulation reports whether the context belongs to a simulation.
+func IsDeckhouseSimulation(ctx context.Context) bool {
+	v, _ := ctx.Value(deckhouseSimulationKey{}).(bool)
+	return v
+}
+
+// DeckhouseFilterLog collects every failing filter plugin per node during a
+// simulation asked for all filters (filters=all). Real cycles and plain
+// simulations stop at the first failing plugin and never see a log.
+type DeckhouseFilterLog struct {
+	mu     sync.Mutex
+	byNode map[string][]*fwk.Status
+}
+
+type deckhouseFilterLogKey struct{}
+
+// WithDeckhouseFilterLog makes RunFilterPlugins run every filter plugin on a
+// node and record all failures in the returned log.
+func WithDeckhouseFilterLog(ctx context.Context) (context.Context, *DeckhouseFilterLog) {
+	l := &DeckhouseFilterLog{byNode: map[string][]*fwk.Status{}}
+	return context.WithValue(ctx, deckhouseFilterLogKey{}, l), l
+}
+
+// DeckhouseAllFilters reports whether filtering must not stop at the first
+// failing plugin.
+func DeckhouseAllFilters(ctx context.Context) bool {
+	return ctx.Value(deckhouseFilterLogKey{}) != nil
+}
+
+// DeckhouseRecordFilters stores the failures of one filter run on a node and
+// returns the first one, the status a real cycle would get. A later run on the
+// same node (the second pass with nominated Pods) replaces the earlier one.
+func DeckhouseRecordFilters(ctx context.Context, nodeInfo fwk.NodeInfo, failed []*fwk.Status) *fwk.Status {
+	if len(failed) == 0 {
+		return nil
+	}
+	if l, ok := ctx.Value(deckhouseFilterLogKey{}).(*DeckhouseFilterLog); ok {
+		l.mu.Lock()
+		l.byNode[nodeInfo.Node().Name] = failed
+		l.mu.Unlock()
+	}
+	return failed[0]
+}
+
+// Get returns the failures recorded for the node.
+func (l *DeckhouseFilterLog) Get(node string) []*fwk.Status {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.byNode[node]
+}
