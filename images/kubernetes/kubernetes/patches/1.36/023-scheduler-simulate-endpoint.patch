+package cache
+
+import (
+	"maps"
+	"slices"
+
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/apimachinery/pkg/util/sets"
+	"k8s.io/klog/v2"
+	fwk "k8s.io/kube-scheduler/framework"
+	"k8s.io/kubernetes/pkg/scheduler/framework"
+)
+
+// DeckhousePodRef names a scheduled Pod. Without a UID every cache entry with
+// this namespace and name matches (a recreated Pod may briefly coexist with
+// the old one); with a UID only that entry matches.
+type DeckhousePodRef struct {
+	Namespace string    `json:"namespace"`
+	Name      string    `json:"name"`
+	UID       types.UID `json:"uid,omitempty"`
+}
+
+func (r DeckhousePodRef) String() string { return r.Namespace + "/" + r.Name }
+
+// DeckhouseWithoutPods makes the snapshot look as if the given Pods were
+// deleted, for a dry-run simulation (pkg/scheduler/deckhouse_simulate.go).
+// The nodes of these Pods are replaced by clones without them, and the
+// derived lists (nodes with affinity Pods, used PVCs) are rebuilt. restore puts
+// the original objects back, so the next UpdateSnapshot of a real cycle works
+// on untouched data. The caller must hold the lock that serializes the
+// snapshot with scheduling cycles until restore returns.
+func (s *Snapshot) DeckhouseWithoutPods(logger klog.Logger, refs []DeckhousePodRef) (restore func(), removed, notFound []string) {
+	restore = func() {}
+	if len(refs) == 0 {
+		return restore, nil, nil
+	}
+	// key -> UIDs to match; an empty set matches every UID. A ref without a UID
+	// matches every entry even when other refs name the same Pod with a UID.
+	want := map[string]sets.Set[types.UID]{}
+	for _, r := range refs {
+		key := r.String()
+		uids, seen := want[key]
+		switch {
+		case r.UID == "":
+			want[key] = sets.New[types.UID]()
+		case !seen:
+			want[key] = sets.New(r.UID)
+		case uids.Len() > 0:
+			uids.Insert(r.UID)
+		}
+	}
+
+	clones := map[string]*framework.NodeInfo{}
+	done := sets.New[string]()
+	for name, ni := range s.nodeInfoMap {
+		for _, pi := range ni.GetPods() {
+			pod := pi.GetPod()
+			key := pod.Namespace + "/" + pod.Name
+			uids, ok := want[key]
+			if !ok || (uids.Len() > 0 && !uids.Has(pod.UID)) {
+				continue
+			}
+			clone := clones[name]
+			if clone == nil {
+				clone = ni.SnapshotConcrete()
+				clones[name] = clone
+			}
+			if err := clone.RemovePod(logger, pod); err != nil {
+				logger.Error(err, "Simulation could not remove a Pod from the node", "pod", key, "node", name)
+				continue
+			}
+			done.Insert(key)
+		}
+	}
+	removed = sets.List(done)
+	for _, r := range refs {
+		if !done.Has(r.String()) && !slices.Contains(notFound, r.String()) {
+			notFound = append(notFound, r.String())
+		}
+	}
+	if len(clones) == 0 {
+		return restore, removed, notFound
+	}
+
+	savedMap, savedList := s.nodeInfoMap, s.nodeInfoList
+	savedAffinity, savedAntiAffinity, savedPVCs := s.havePodsWithAffinityNodeInfoList, s.havePodsWithRequiredAntiAffinityNodeInfoList, s.usedPVCSet
+	restore = func() {
+		s.nodeInfoMap, s.nodeInfoList = savedMap, savedList
+		s.havePodsWithAffinityNodeInfoList, s.havePodsWithRequiredAntiAffinityNodeInfoList, s.usedPVCSet = savedAffinity, savedAntiAffinity, savedPVCs
+	}
+
+	s.nodeInfoMap = maps.Clone(savedMap)
+	for name, clone := range clones {
+		s.nodeInfoMap[name] = clone
+	}
+	s.nodeInfoList = make([]fwk.NodeInfo, 0, len(savedList))
+	s.havePodsWithAffinityNodeInfoList = make([]fwk.NodeInfo, 0, len(savedAffinity))
+	s.havePodsWithRequiredAntiAffinityNodeInfoList = make([]fwk.NodeInfo, 0, len(savedAntiAffinity))
+	s.usedPVCSet = sets.New[string]()
+	for _, ni := range savedList {
+		if clone := clones[ni.Node().Name]; clone != nil {
+			ni = clone
+		}
+		s.nodeInfoList = append(s.nodeInfoList, ni)
+		if len(ni.GetPodsWithAffinity()) > 0 {
+			s.havePodsWithAffinityNodeInfoList = append(s.havePodsWithAffinityNodeInfoList, ni)
+		}
+		if len(ni.GetPodsWithRequiredAntiAffinity()) > 0 {
+			s.havePodsWithRequiredAntiAffinityNodeInfoList = append(s.havePodsWithRequiredAntiAffinityNodeInfoList, ni)
+		}
+		for key := range ni.GetPVCRefCounts() {
+			s.usedPVCSet.Insert(key)
+		}
+	}
+	return restore, removed, notFound
+}
