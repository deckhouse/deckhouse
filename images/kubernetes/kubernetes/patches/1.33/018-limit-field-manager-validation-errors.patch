+func TestValidateFieldManagerSingleError(t *testing.T) {
+	tests := map[string]struct {
+		fieldManager string
+		expectedType field.ErrorType
+	}{
+		"too long with invalid characters": {
+			fieldManager: strings.Repeat("\x01", 1<<20),
+			expectedType: field.ErrorTypeTooLong,
+		},
+		"too long with valid characters": {
+			fieldManager: strings.Repeat("f", FieldManagerMaxLength+1),
+			expectedType: field.ErrorTypeTooLong,
+		},
+		"max length of invalid characters": {
+			fieldManager: strings.Repeat("\x01", FieldManagerMaxLength),
+			expectedType: field.ErrorTypeInvalid,
+		},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			errs := ValidateFieldManager(test.fieldManager, field.NewPath("fieldManager"))
+			if len(errs) != 1 {
+				t.Fatalf("expected exactly one error, got %d", len(errs))
+			}
+			if errs[0].Type != test.expectedType {
+				t.Errorf("expected error type %q, got %q", test.expectedType, errs[0].Type)
+			}
+		})
+	}
+}
