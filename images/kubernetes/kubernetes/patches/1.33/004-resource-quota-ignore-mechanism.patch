+func TestValidateResourceQuotaLabels(t *testing.T) {
+	type labelCase struct {
+		value string
+		valid bool
+	}
+	cpu := []labelCase{
+		{"1", true}, {"500m", true}, {"0.5", true}, {"2.5", true},
+		{"1k", false}, {"1M", false}, {"1Ki", false}, {"1Gi", false},
+		{"-100m", false}, {"abc", false}, {"", false},
+	}
+	bytes := []labelCase{
+		{"1Gi", true}, {"500Mi", true}, {"1G", true}, {"1024", true},
+		{"500m", false}, {"-1Gi", false}, {"abc", false}, {"", false},
+	}
+	cases := map[string][]labelCase{
+		v1.LabelResourceQuotaIgnore: {
+			{"true", true}, {"false", true},
+			{"True", false}, {"yes", false}, {"1", false}, {"", false},
+		},
+		v1.LabelResourceQuotaCapCPU:          cpu,
+		v1.LabelResourceQuotaDiscountCPU:     cpu,
+		v1.LabelResourceQuotaCapMemory:       bytes,
+		v1.LabelResourceQuotaDiscountMemory:  bytes,
+		v1.LabelResourceQuotaCapStorage:      bytes,
+		v1.LabelResourceQuotaDiscountStorage: bytes,
+	}
+
+	path := field.NewPath("metadata", "labels")
+	for label, values := range cases {
+		for _, c := range values {
+			t.Run(label+"="+c.value, func(t *testing.T) {
+				errs := validateResourceQuotaLabels(map[string]string{label: c.value}, path)
+				if c.valid {
+					if len(errs) != 0 {
+						t.Errorf("want no errors, got %v", errs)
+					}
+					return
+				}
+				if len(errs) == 0 {
+					t.Fatal("want an error, got none")
+				}
+				for _, err := range errs {
+					if err.Type != field.ErrorTypeInvalid || err.Field != path.Key(label).String() {
+						t.Errorf("want an Invalid error for %s, got %v", path.Key(label), err)
+					}
+				}
+			})
+		}
+	}
+
+	t.Run("labels without the prefix", func(t *testing.T) {
+		if errs := validateResourceQuotaLabels(nil, path); len(errs) != 0 {
+			t.Errorf("nil labels: want no errors, got %v", errs)
+		}
+		if errs := validateResourceQuotaLabels(map[string]string{"app": "web"}, path); len(errs) != 0 {
+			t.Errorf("want no errors, got %v", errs)
+		}
+	})
+
+	t.Run("every invalid label is reported", func(t *testing.T) {
+		errs := validateResourceQuotaLabels(map[string]string{
+			v1.LabelResourceQuotaIgnore:      "yes",
+			v1.LabelResourceQuotaCapCPU:      "1Gi",
+			v1.LabelResourceQuotaCapMemory:   "500m",
+			v1.LabelResourceQuotaDiscountCPU: "100m",
+		}, path)
+		fields := map[string]bool{}
+		for _, err := range errs {
+			fields[err.Field] = true
+		}
+		for _, label := range []string{v1.LabelResourceQuotaIgnore, v1.LabelResourceQuotaCapCPU, v1.LabelResourceQuotaCapMemory} {
+			if !fields[path.Key(label).String()] {
+				t.Errorf("want an error for %s, got %v", path.Key(label), errs)
+			}
+		}
+		if fields[path.Key(v1.LabelResourceQuotaDiscountCPU).String()] {
+			t.Errorf("want no error for the valid %s, got %v", v1.LabelResourceQuotaDiscountCPU, errs)
+		}
+	})
+}
+
+// The labels are validated as part of pods and PVCs, with the same field path for both.
+func TestResourceQuotaLabelsOfPodsAndPVCs(t *testing.T) {
+	wantPath := field.NewPath("metadata", "labels").Key(v1.LabelResourceQuotaIgnore).String()
+
+	gracePeriod := int64(30)
+	pod := func(labels map[string]string) *core.Pod {
+		return &core.Pod{
+			ObjectMeta: metav1.ObjectMeta{Name: "web", Namespace: "team-a", Labels: labels},
+			Spec: core.PodSpec{
+				Containers: []core.Container{{
+					Name:                     "web",
+					Image:                    "registry.example.com/web:1.0",
+					ImagePullPolicy:          core.PullIfNotPresent,
+					TerminationMessagePolicy: core.TerminationMessageReadFile,
+				}},
+				RestartPolicy:                 core.RestartPolicyAlways,
+				DNSPolicy:                     core.DNSClusterFirst,
+				TerminationGracePeriodSeconds: &gracePeriod,
+			},
+		}
+	}
+	pvc := func(labels map[string]string) *core.PersistentVolumeClaim {
+		return &core.PersistentVolumeClaim{
+			ObjectMeta: metav1.ObjectMeta{Name: "data", Namespace: "team-a", Labels: labels},
+			Spec: core.PersistentVolumeClaimSpec{
+				AccessModes: []core.PersistentVolumeAccessMode{core.ReadWriteOnce},
+				Resources: core.VolumeResourceRequirements{
+					Requests: core.ResourceList{core.ResourceStorage: resource.MustParse("10Gi")},
+				},
+			},
+		}
+	}
+
+	validate := map[string]func(labels map[string]string) field.ErrorList{
+		"pod": func(labels map[string]string) field.ErrorList {
+			return ValidatePodCreate(pod(labels), PodValidationOptions{})
+		},
+		"pvc": func(labels map[string]string) field.ErrorList {
+			return ValidatePersistentVolumeClaim(pvc(labels), PersistentVolumeClaimSpecValidationOptions{})
+		},
+	}
+	for kind, validate := range validate {
+		t.Run(kind, func(t *testing.T) {
+			if errs := validate(map[string]string{v1.LabelResourceQuotaIgnore: "true"}); len(errs) != 0 {
+				t.Errorf("a valid label: want no errors, got %v", errs)
+			}
+			errs := validate(map[string]string{v1.LabelResourceQuotaIgnore: "yes"})
+			if len(errs) != 1 || errs[0].Type != field.ErrorTypeInvalid || errs[0].Field != wantPath {
+				t.Errorf("an invalid label: want one Invalid error for %s, got %v", wantPath, errs)
+			}
+		})
+	}
+}
