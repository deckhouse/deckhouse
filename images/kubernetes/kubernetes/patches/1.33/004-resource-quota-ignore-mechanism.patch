+// hasResourceQuotaLabelsChanged checks if any resource quota control labels have changed
+func hasResourceQuotaLabelsChanged(oldLabels, newLabels map[string]string) bool {
+	for _, label := range v1.ResourceQuotaLabels {
+		if oldLabels[label] != newLabels[label] {
+			return true
+		}
+	}
+	return false
+}
