+)
+
+// overridesLabelValues holds two valid values for every resource quota control label.
+// The list is written out by hand, so a label missing from v1.ResourceQuotaLabels fails the tests.
+var overridesLabelValues = []struct {
+	label    string
+	old, new string
+}{
+	{v1.LabelResourceQuotaIgnore, "true", "false"},
+	{v1.LabelResourceQuotaDiscountStorage, "1Gi", "2Gi"},
+	{v1.LabelResourceQuotaCapStorage, "1Gi", "2Gi"},
+	{v1.LabelResourceQuotaDiscountCPU, "100m", "200m"},
+	{v1.LabelResourceQuotaCapCPU, "100m", "200m"},
+	{v1.LabelResourceQuotaDiscountMemory, "128Mi", "256Mi"},
+	{v1.LabelResourceQuotaCapMemory, "128Mi", "256Mi"},
+}
+
+type overridesLabelsCase struct {
+	name                 string
+	oldLabels, newLabels map[string]string
+	want                 bool
+}
+
+// overridesLabelsCases returns the label transitions: adding, removing and changing every control label
+// is a change, other labels and unchanged control labels are not.
+func overridesLabelsCases() []overridesLabelsCase {
+	var cases []overridesLabelsCase
+	for _, v := range overridesLabelValues {
+		cases = append(cases,
+			overridesLabelsCase{
+				name:      v.label + " added",
+				oldLabels: map[string]string{"app": "web"},
+				newLabels: map[string]string{"app": "web", v.label: v.new},
+				want:      true,
+			},
+			overridesLabelsCase{
+				name:      v.label + " removed",
+				oldLabels: map[string]string{"app": "web", v.label: v.old},
+				newLabels: map[string]string{"app": "web"},
+				want:      true,
+			},
+			overridesLabelsCase{
+				name:      v.label + " changed",
+				oldLabels: map[string]string{"app": "web", v.label: v.old},
+				newLabels: map[string]string{"app": "web", v.label: v.new},
+				want:      true,
+			},
+			overridesLabelsCase{
+				name:      v.label + " unchanged, another label changed",
+				oldLabels: map[string]string{"app": "web", v.label: v.old},
+				newLabels: map[string]string{"app": "api", v.label: v.old},
+				want:      false,
+			},
+		)
+	}
+	return append(cases,
+		overridesLabelsCase{
+			name: "no labels",
+			want: false,
+		},
+		overridesLabelsCase{
+			name:      "a label with a similar prefix changed",
+			oldLabels: map[string]string{"resource-quota-overrides.deckhouse.io/other": "a"},
+			newLabels: map[string]string{"resource-quota-overrides.deckhouse.io/other": "b"},
+			want:      false,
+		},
+	)
+}
+
+func TestHasResourceQuotaLabelsChanged(t *testing.T) {
+	for _, tc := range overridesLabelsCases() {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := hasResourceQuotaLabelsChanged(tc.oldLabels, tc.newLabels); got != tc.want {
+				t.Errorf("hasResourceQuotaLabelsChanged() = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestUpdateFilterPodResourceQuotaLabels(t *testing.T) {
+	filter := DefaultUpdateFilter()
+	pods := schema.GroupVersionResource{Version: "v1", Resource: "pods"}
+	pod := func(labels map[string]string) *v1.Pod {
+		return &v1.Pod{
+			ObjectMeta: metav1.ObjectMeta{Name: "web", Namespace: "team-a", Labels: labels},
+			Spec:       v1.PodSpec{Containers: []v1.Container{{Name: "web"}}},
+			Status:     v1.PodStatus{Phase: v1.PodRunning},
+		}
+	}
+
+	for _, tc := range overridesLabelsCases() {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := filter(pods, pod(tc.oldLabels), pod(tc.newLabels)); got != tc.want {
+				t.Errorf("DefaultUpdateFilter() for pods = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
