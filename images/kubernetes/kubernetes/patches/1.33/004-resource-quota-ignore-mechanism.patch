+// overridesResources builds a resource list out of name-value pairs.
+func overridesResources(pairs ...string) corev1.ResourceList {
+	list := corev1.ResourceList{}
+	for i := 0; i+1 < len(pairs); i += 2 {
+		list[corev1.ResourceName(pairs[i])] = resource.MustParse(pairs[i+1])
+	}
+	return list
+}
+
+func overridesPod(labels map[string]string, requests, limits corev1.ResourceList) *corev1.Pod {
+	return &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: "web", Namespace: "team-a", Labels: labels},
+		Spec: corev1.PodSpec{
+			Containers: []corev1.Container{{
+				Name:      "web",
+				Resources: corev1.ResourceRequirements{Requests: requests, Limits: limits},
+			}},
+		},
+	}
+}
+
+func TestPodUsageWithResourceQuotaOverrides(t *testing.T) {
+	requests := overridesResources("cpu", "500m", "memory", "1Gi")
+	limits := overridesResources("cpu", "1", "memory", "2Gi")
+	counted := overridesResources(
+		"pods", "1", "count/pods", "1",
+		"cpu", "500m", "requests.cpu", "500m", "limits.cpu", "1",
+		"memory", "1Gi", "requests.memory", "1Gi", "limits.memory", "2Gi",
+	)
+
+	tests := []struct {
+		name     string
+		labels   map[string]string
+		requests corev1.ResourceList
+		limits   corev1.ResourceList
+		want     corev1.ResourceList
+	}{
+		{
+			name:     "a pod without the labels is counted in full",
+			requests: requests, limits: limits,
+			want: counted,
+		},
+		{
+			name:     "ignore leaves the pod out, its count included",
+			labels:   map[string]string{corev1.LabelResourceQuotaIgnore: "true"},
+			requests: requests, limits: limits,
+			want: corev1.ResourceList{},
+		},
+		{
+			name:     "ignore set to false counts the pod in full",
+			labels:   map[string]string{corev1.LabelResourceQuotaIgnore: "false"},
+			requests: requests, limits: limits,
+			want: counted,
+		},
+		{
+			name:     "a discount is subtracted from requests, limits and their short name",
+			labels:   map[string]string{corev1.LabelResourceQuotaDiscountCPU: "200m"},
+			requests: requests, limits: limits,
+			want: overridesResources(
+				"pods", "1", "count/pods", "1",
+				"cpu", "300m", "requests.cpu", "300m", "limits.cpu", "800m",
+				"memory", "1Gi", "requests.memory", "1Gi", "limits.memory", "2Gi",
+			),
+		},
+		{
+			name:     "a discount larger than the usage stops at zero",
+			labels:   map[string]string{corev1.LabelResourceQuotaDiscountMemory: "8Gi"},
+			requests: requests, limits: limits,
+			want: overridesResources(
+				"pods", "1", "count/pods", "1",
+				"cpu", "500m", "requests.cpu", "500m", "limits.cpu", "1",
+				"memory", "0", "requests.memory", "0", "limits.memory", "0",
+			),
+		},
+		{
+			name:     "a cap limits requests, limits and their short name",
+			labels:   map[string]string{corev1.LabelResourceQuotaCapMemory: "512Mi"},
+			requests: requests, limits: limits,
+			want: overridesResources(
+				"pods", "1", "count/pods", "1",
+				"cpu", "500m", "requests.cpu", "500m", "limits.cpu", "1",
+				"memory", "512Mi", "requests.memory", "512Mi", "limits.memory", "512Mi",
+			),
+		},
+		{
+			name:     "a cap above the usage changes nothing",
+			labels:   map[string]string{corev1.LabelResourceQuotaCapCPU: "4"},
+			requests: requests, limits: limits,
+			want: counted,
+		},
+		{
+			name: "the discount goes before the cap",
+			labels: map[string]string{
+				corev1.LabelResourceQuotaDiscountCPU: "1",
+				corev1.LabelResourceQuotaCapCPU:      "2",
+			},
+			requests: overridesResources("cpu", "4"),
+			limits:   overridesResources("cpu", "4"),
+			want: overridesResources(
+				"pods", "1", "count/pods", "1",
+				"cpu", "2", "requests.cpu", "2", "limits.cpu", "2",
+			),
+		},
+		{
+			name: "the storage labels apply to ephemeral storage",
+			labels: map[string]string{
+				corev1.LabelResourceQuotaDiscountStorage: "5Gi",
+				corev1.LabelResourceQuotaCapStorage:      "10Gi",
+			},
+			requests: overridesResources("ephemeral-storage", "10Gi"),
+			limits:   overridesResources("ephemeral-storage", "20Gi"),
+			want: overridesResources(
+				"pods", "1", "count/pods", "1",
+				"ephemeral-storage", "5Gi", "requests.ephemeral-storage", "5Gi", "limits.ephemeral-storage", "10Gi",
+			),
+		},
+		{
+			name:     "a discount for a resource the pod does not request adds nothing",
+			labels:   map[string]string{corev1.LabelResourceQuotaDiscountMemory: "1Gi"},
+			requests: overridesResources("cpu", "500m"),
+			want: overridesResources(
+				"pods", "1", "count/pods", "1",
+				"cpu", "500m", "requests.cpu", "500m",
+			),
+		},
+	}
+
+	evaluator := NewPodEvaluator(nil, clock.RealClock{})
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := evaluator.Usage(overridesPod(tt.labels, tt.requests, tt.limits))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !quota.Equals(tt.want, got) {
+				t.Errorf("want %v, got %v", tt.want, got)
+			}
+		})
+	}
+}
+
+func TestPersistentVolumeClaimUsageWithResourceQuotaOverrides(t *testing.T) {
+	storageClass := "fast"
+	pvc := func(labels map[string]string) *corev1.PersistentVolumeClaim {
+		return &corev1.PersistentVolumeClaim{
+			ObjectMeta: metav1.ObjectMeta{Name: "data", Namespace: "team-a", Labels: labels},
+			Spec: corev1.PersistentVolumeClaimSpec{
+				AccessModes:      []corev1.PersistentVolumeAccessMode{corev1.ReadWriteOnce},
+				StorageClassName: &storageClass,
+				Resources: corev1.VolumeResourceRequirements{
+					Requests: overridesResources("storage", "10Gi"),
+				},
+			},
+		}
+	}
+
+	evaluator := NewPersistentVolumeClaimEvaluator(nil)
+	counted, err := evaluator.Usage(pvc(nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if storage := counted[corev1.ResourceRequestsStorage]; storage.Cmp(resource.MustParse("10Gi")) != 0 {
+		t.Fatalf("a PVC without the labels: want requests.storage 10Gi, got %v", counted)
+	}
+
+	tests := []struct {
+		name   string
+		labels map[string]string
+		want   corev1.ResourceList
+	}{
+		{
+			name:   "ignore leaves the PVC out, its count included",
+			labels: map[string]string{corev1.LabelResourceQuotaIgnore: "true"},
+			want:   corev1.ResourceList{},
+		},
+		{
+			name:   "ignore set to false counts the PVC in full",
+			labels: map[string]string{corev1.LabelResourceQuotaIgnore: "false"},
+			want:   counted,
+		},
+		{
+			// Only ignore is supported for PVCs, see the resource quota ignore mechanism ADR.
+			name: "the storage discount and cap do not apply to PVCs",
+			labels: map[string]string{
+				corev1.LabelResourceQuotaDiscountStorage: "5Gi",
+				corev1.LabelResourceQuotaCapStorage:      "1Gi",
+			},
+			want: counted,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := evaluator.Usage(pvc(tt.labels))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !quota.Equals(tt.want, got) {
+				t.Errorf("want %v, got %v", tt.want, got)
+			}
+		})
+	}
+}
