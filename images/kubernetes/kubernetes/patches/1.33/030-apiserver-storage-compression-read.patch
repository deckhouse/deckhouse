+
+// Package compression reads zstd-compressed values from etcd.
+package compression
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"sync"
+
+	"github.com/klauspost/compress/zstd"
+
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apiserver/pkg/storage/value"
+)
+
+const (
+	zstdPrefix     = "k8s:cmp:zstd:v1:"
+	maxDecodedSize = 64 << 20
+)
+
+var (
+	zstdDecoderOnce sync.Once
+	zstdDecoder     *zstd.Decoder
+)
+
+func zstdDecode(src []byte) ([]byte, error) {
+	zstdDecoderOnce.Do(func() {
+		var err error
+		zstdDecoder, err = zstd.NewReader(nil,
+			zstd.WithDecoderMaxMemory(maxDecodedSize),
+			zstd.WithDecoderConcurrency(0), // Use GOMAXPROCS.
+		)
+		if err != nil {
+			// With a nil reader and these valid options, a constructor error signals a programming bug.
+			panic(fmt.Sprintf("zstd decoder: %v", err))
+		}
+	})
+	return zstdDecoder.DecodeAll(src, nil)
+}
+
+type transformer struct {
+	inner    value.Transformer
+	resource string
+}
+
+// NewTransformer wraps inner and decompresses values on read. Writes pass through.
+func NewTransformer(inner value.Transformer, gr schema.GroupResource) value.Transformer {
+	return &transformer{inner: inner, resource: gr.String()}
+}
+
+func (t *transformer) TransformFromStorage(ctx context.Context, data []byte, dataCtx value.Context) ([]byte, bool, error) {
+	out, stale, err := t.inner.TransformFromStorage(ctx, data, dataCtx)
+	if err != nil || !bytes.HasPrefix(out, []byte(zstdPrefix)) {
+		return out, stale, err
+	}
+	decoded, err := zstdDecode(out[len(zstdPrefix):])
+	if err != nil {
+		return nil, false, fmt.Errorf("decompress %s value: %w", t.resource, err)
+	}
+	// writes are raw: no-op update rewrites the value
+	return decoded, true, nil
+}
+
+func (t *transformer) TransformToStorage(ctx context.Context, data []byte, dataCtx value.Context) ([]byte, error) {
+	return t.inner.TransformToStorage(ctx, data, dataCtx)
+}
