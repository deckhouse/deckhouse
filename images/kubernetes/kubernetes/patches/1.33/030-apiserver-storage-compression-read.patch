+package etcd3
+
+import (
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/stretchr/testify/require"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apiserver/pkg/apis/example"
+	"k8s.io/apiserver/pkg/storage"
+	"k8s.io/apiserver/pkg/storage/value/compression"
+	"k8s.io/apiserver/pkg/storage/value/encrypt/identity"
+)
+
+func TestGuaranteedUpdateRewritesCompressedValue(t *testing.T) {
+	ctx, store, client := testSetup(t, func(options *setupOptions) {
+		options.transformer = compression.NewTransformer(identity.NewEncryptCheckTransformer(), options.groupResource)
+	})
+
+	const key = "/pods/default/compressed"
+	pod := &example.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: "default", Name: "compressed"}}
+	require.NoError(t, store.Create(ctx, key, pod, newPod(), 0))
+
+	before, err := client.KV.Get(ctx, key)
+	require.NoError(t, err)
+	require.Len(t, before.Kvs, 1)
+	raw := before.Kvs[0].Value
+
+	encoder, err := zstd.NewWriter(nil, zstd.WithEncoderConcurrency(1))
+	require.NoError(t, err)
+	defer encoder.Close()
+	compressed := encoder.EncodeAll(raw, []byte("k8s:cmp:zstd:v1:"))
+	_, err = client.KV.Put(ctx, key, string(compressed))
+	require.NoError(t, err)
+
+	err = store.GuaranteedUpdate(ctx, key, newPod(), false, nil,
+		func(obj runtime.Object, _ storage.ResponseMeta) (runtime.Object, *uint64, error) {
+			return obj, nil, nil
+		}, nil)
+	require.NoError(t, err)
+
+	after, err := client.KV.Get(ctx, key)
+	require.NoError(t, err)
+	require.Len(t, after.Kvs, 1)
+	require.Equal(t, raw, after.Kvs[0].Value)
+}
