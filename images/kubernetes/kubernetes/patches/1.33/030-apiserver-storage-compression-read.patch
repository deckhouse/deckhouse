+package compression_test
+
+import (
+	"bytes"
+	"errors"
+	"testing"
+
+	"github.com/klauspost/compress/zstd"
+	"github.com/stretchr/testify/require"
+
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apiserver/pkg/storage/value"
+	"k8s.io/apiserver/pkg/storage/value/compression"
+	"k8s.io/apiserver/pkg/storage/value/encrypt/identity"
+)
+
+func TestTransformFromStorage(t *testing.T) {
+	encoder, err := zstd.NewWriter(nil, zstd.WithEncoderConcurrency(1))
+	require.NoError(t, err)
+	defer encoder.Close()
+
+	raw := []byte("stored object")
+	compressed := encoder.EncodeAll(raw, []byte("k8s:cmp:zstd:v1:"))
+	errUnknownPrefix := errors.New("unknown storage prefix")
+	inner := value.NewPrefixTransformers(errUnknownPrefix,
+		value.PrefixTransformer{Prefix: []byte("current:"), Transformer: identity.NewEncryptCheckTransformer()},
+		value.PrefixTransformer{Prefix: []byte("previous:"), Transformer: identity.NewEncryptCheckTransformer()},
+	)
+	transformer := compression.NewTransformer(inner, schema.GroupResource{Resource: "pods"})
+
+	for _, tc := range []struct {
+		name  string
+		input []byte
+		want  []byte
+		stale bool
+		err   error
+	}{
+		{name: "raw", input: append([]byte("current:"), raw...), want: raw},
+		{name: "stale raw", input: append([]byte("previous:"), raw...), want: raw, stale: true},
+		{name: "compressed", input: append([]byte("current:"), compressed...), want: raw, stale: true},
+		{name: "invalid frame", input: []byte("current:k8s:cmp:zstd:v1:invalid frame"), err: zstd.ErrMagicMismatch},
+		{name: "inner error", input: compressed, err: errUnknownPrefix},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, stale, err := transformer.TransformFromStorage(t.Context(), tc.input, nil)
+			require.ErrorIs(t, err, tc.err)
+			require.Equal(t, tc.want, got)
+			require.Equal(t, tc.stale, stale)
+		})
+	}
+}
+
+func TestTransformToStorage(t *testing.T) {
+	raw := bytes.Repeat([]byte("stored object\n"), 256)
+	inner := value.NewPrefixTransformers(nil,
+		value.PrefixTransformer{Prefix: []byte("current:"), Transformer: identity.NewEncryptCheckTransformer()},
+	)
+	transformer := compression.NewTransformer(inner, schema.GroupResource{Resource: "pods"})
+
+	got, err := transformer.TransformToStorage(t.Context(), raw, nil)
+	require.NoError(t, err)
+	require.Equal(t, append([]byte("current:"), raw...), got)
+}
