+func recordDecision(l *deckhouseDecisionLog, name string) {
+	scores := decisionScores(
+		decisionNode("a", ps("Fit", 9), ps("http://ext", 1)),
+		decisionNode("b", ps("Fit", 5), ps("http://ext", 2)),
+	)
+	d, _ := deckhouseDecide("a", scores)
+	d.decidedBy = l.names.of(d.decidedBy) // as deckhouseRecordDecision does
+	l.record(time.Unix(1, 0), &v1.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: "ns", Name: name, UID: "uid-" + "x"}}, "default-scheduler", "a", d, scores, time.Millisecond)
+}
