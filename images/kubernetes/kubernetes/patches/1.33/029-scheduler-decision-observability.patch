+package scheduler
+
+// Deckhouse: observability of real scheduling decisions.
+//
+// Right after schedulePod selects the node of a Pod, deckhouseRecordDecision
+// compares the selected node (the winner) with the best other feasible node by
+// total score (the runner-up). The score plugin or prioritize extender with the
+// largest positive difference of weighted scores between the two decided.
+// Every decision updates the scheduler_decision_* metrics. Two outputs are
+// opt-in and read once at start:
+//
+//   - DECKHOUSE_SCHEDULER_DECISION_EVENTS=true appends the top nodes and the
+//     deciding plugin to the message of the Scheduled event;
+//   - DECKHOUSE_SCHEDULER_DECISION_LOG_SIZE=<n> keeps the last n decisions in
+//     memory for GET /decisions (deckhouse_decision_log.go).
+//
+// The deciding plugin or extender is named with a prefix: plugin/<score
+// plugin>, extender/<extender name> (deckhouse_extender_names.go), and the
+// shortcuts scheduler/single-node, scheduler/tie, scheduler/nominated-node and
+// scheduler/node-hint. The prefixed names are built once before the
+// scheduling loop starts (deckhouseDecisionNames), so a decision concatenates
+// nothing.
+//
+// Simulations never reach schedulePod, and the check of IsDeckhouseSimulation
+// keeps it so.
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+
+	"k8s.io/kubernetes/pkg/scheduler/framework"
+	"k8s.io/kubernetes/pkg/scheduler/metrics"
+	utiltrace "k8s.io/utils/trace"
+)
+
+const (
+	deckhouseDecisionEventsEnv  = "DECKHOUSE_SCHEDULER_DECISION_EVENTS"
+	deckhouseDecisionLogSizeEnv = "DECKHOUSE_SCHEDULER_DECISION_LOG_SIZE"
+	deckhouseDecisionLogMax     = 10000
+
+	// deckhouseDecisionTop is the number of nodes an event or a log entry shows.
+	deckhouseDecisionTop = 3
+	// deckhouseEventMessageLimit is the longest message events.k8s.io/v1
+	// accepts (note): a longer event is rejected by the API server.
+	deckhouseEventMessageLimit = 1024
+
+	// DecidedBySingleFeasibleNode: only one node passed the filters, nothing was
+	// scored. DecidedByTie: the runner-up has the same total score.
+	DecidedBySingleFeasibleNode = "scheduler/single-node"
+	DecidedByTie                = "scheduler/tie"
+	// DecidedByNodeHint and DecidedByNominatedNode: the scheduler tried one node
+	// only and took it without scoring: the OpportunisticBatching hint left by
+	// an earlier Pod with the same signature (1.35+), or the node nominated for
+	// the Pod by preemption. Other nodes may have fit too.
+	DecidedByNodeHint      = "scheduler/node-hint"
+	DecidedByNominatedNode = "scheduler/nominated-node"
+)
+
+// deckhouseDecisions holds the opt-in outputs of decisions. The zero value
+// keeps only the metrics; StartDeckhouseSimulateServer sets it from the
+// environment before the scheduling loop starts.
+type deckhouseDecisions struct {
+	events bool
+	log    *deckhouseDecisionLog
+	// names are the prefixed names of score plugins and extenders.
+	names deckhouseDecisionNames
+}
+
+// deckhouseDecision is one decision as indices into the scores of the cycle.
+// It lives on the stack of the scheduling goroutine.
+type deckhouseDecision struct {
+	feasible int
+	// top are the winner and the next best nodes, best first; n of them are set.
+	top [deckhouseDecisionTop]int
+	n   int
+	// decidedBy is the deciding plugin or extender (its score name from
+	// deckhouseDecide, prefixed by deckhouseRecordDecision),
+	// DecidedBySingleFeasibleNode or DecidedByTie. contribution is its
+	// weighted score difference.
+	decidedBy    string
+	contribution int64
+	// margin is the total score of the winner minus that of the runner-up.
+	margin int64
+}
+
+// deckhouseDecide explains why host won among the scored feasible nodes. With
+// fewer than two scores there was nothing to compare. ok is false when host is
+// not among the scores (never in a real cycle).
+//
+// One pass over the scores keeps the best three by total score, the earliest
+// first among equal totals; the winner is one of them unless more than three
+// nodes share the top score, then a second pass finds it.
+func deckhouseDecide(host string, scores []framework.NodePluginScores) (d deckhouseDecision, ok bool) {
+	d.feasible = len(scores)
+	if len(scores) < 2 {
+		d.feasible, d.n, d.decidedBy = 1, len(scores), DecidedBySingleFeasibleNode
+		return d, true
+	}
+
+	var best [deckhouseDecisionTop]int
+	n := 0
+	for i := range scores {
+		t := scores[i].TotalScore
+		if n == len(best) && t <= scores[best[n-1]].TotalScore {
+			continue
+		}
+		j := n
+		if n < len(best) {
+			n++
+		} else {
+			j = n - 1
+		}
+		for ; j > 0 && scores[best[j-1]].TotalScore < t; j-- {
+			best[j] = best[j-1]
+		}
+		best[j] = i
+	}
+
+	winner := -1
+	for k := 0; k < n; k++ {
+		if scores[best[k]].Name == host {
+			winner = best[k]
+			break
+		}
+	}
+	if winner < 0 {
+		for i := range scores {
+			if scores[i].Name == host {
+				winner = i
+				break
+			}
+		}
+		if winner < 0 {
+			return d, false
+		}
+	}
+	d.top[0], d.n = winner, 1
+	for k := 0; k < n && d.n < len(d.top); k++ {
+		if best[k] != winner {
+			d.top[d.n] = best[k]
+			d.n++
+		}
+	}
+
+	w, r := &scores[winner], &scores[d.top[1]]
+	d.margin = w.TotalScore - r.TotalScore
+	for k := range w.Scores {
+		name := w.Scores[k].Name
+		var other int64
+		if k < len(r.Scores) && r.Scores[k].Name == name {
+			other = r.Scores[k].Score
+		} else {
+			// Extenders append their scores in the order they answer.
+			for _, p := range r.Scores {
+				if p.Name == name {
+					other = p.Score
+					break
+				}
+			}
+		}
+		if diff := w.Scores[k].Score - other; diff > d.contribution {
+			d.contribution, d.decidedBy = diff, name
+		}
+	}
+	// The total is the sum of the weighted scores, so a positive margin always
+	// has a positive contribution; equal totals are a tie.
+	if d.margin <= 0 || d.decidedBy == "" {
+		d.decidedBy, d.contribution = DecidedByTie, 0
+	}
+	return d, true
+}
+
+// deckhouseRecordDecision records the decision of a real scheduling cycle:
+// host was selected among the feasible nodes with these scores, or it was the
+// only feasible node and scores is nil; nodeHint is the OpportunisticBatching
+// hint of the cycle (empty before 1.35). The deciding plugin or extender is
+// named with its prefix. With the opt-in outputs off it allocates nothing.
+func (sched *Scheduler) deckhouseRecordDecision(ctx context.Context, state *framework.CycleState, schedFramework framework.Framework, pod *v1.Pod, host string, scores []framework.NodePluginScores, nodeHint string, trace *utiltrace.Trace) {
+	if framework.IsDeckhouseSimulation(ctx) {
+		return
+	}
+	d, ok := deckhouseDecide(host, scores)
+	if !ok {
+		return
+	}
+	scored := len(scores) > 1
+	if scored {
+		d.decidedBy = sched.deckhouseDecisions.names.of(d.decidedBy)
+	} else {
+		d.decidedBy = deckhouseSingleNode(pod, host, nodeHint)
+	}
+	profile := schedFramework.ProfileName()
+	if metrics.DecisionDecidingPlugin != nil {
+		metrics.DecisionDecidingPlugin.WithLabelValues(profile, d.decidedBy).Inc()
+		// A shortcut tried one node: its count of feasible nodes means nothing.
+		if scored || d.decidedBy == DecidedBySingleFeasibleNode {
+			metrics.DecisionFeasibleNodes.WithLabelValues(profile).Observe(float64(d.feasible))
+		}
+		if scored {
+			metrics.DecisionScoreMargin.WithLabelValues(profile).Observe(float64(d.margin))
+		}
+	}
+	if sched.deckhouseDecisions.events {
+		state.Write(deckhouseDecisionEventKey, newDeckhouseDecisionEvent(host, d, scores))
+	}
+	if l := sched.deckhouseDecisions.log; l != nil {
+		l.record(time.Now(), pod, profile, host, d, scores, trace.TotalTime())
+	}
+}
+
+// deckhouseSingleNode names the decision for a single feasible node. The
+// nominated node, or without one the OpportunisticBatching hint, is tried
+// before all other nodes and taken when it passes the filters, in the order of
+// upstream evaluateNominatedNode.
+func deckhouseSingleNode(pod *v1.Pod, host, nodeHint string) string {
+	switch {
+	case pod.Status.NominatedNodeName != "":
+		if host == pod.Status.NominatedNodeName {
+			return DecidedByNominatedNode
+		}
+	case nodeHint != "" && host == nodeHint:
+		return DecidedByNodeHint
+	}
+	return DecidedBySingleFeasibleNode
+}
+
+// deckhouseDecisionEventKey keeps the decision in the CycleState for the
+// Scheduled event of the binding cycle.
+const deckhouseDecisionEventKey framework.StateKey = "deckhouse.io/decision"
+
+type deckhouseDecisionEventNode struct {
+	name  string
+	total int64
+}
+
+type deckhouseDecisionEvent struct {
+	top          [deckhouseDecisionTop]deckhouseDecisionEventNode
+	n            int
+	scored       bool
+	decidedBy    string
+	contribution int64
+}
+
+func (e *deckhouseDecisionEvent) Clone() framework.StateData { return e }
+
+func newDeckhouseDecisionEvent(host string, d deckhouseDecision, scores []framework.NodePluginScores) *deckhouseDecisionEvent {
+	e := &deckhouseDecisionEvent{decidedBy: d.decidedBy, contribution: d.contribution, scored: len(scores) > 1}
+	if !e.scored {
+		e.top[0], e.n = deckhouseDecisionEventNode{name: host}, 1
+		return e
+	}
+	for k := 0; k < d.n; k++ {
+		e.top[k] = deckhouseDecisionEventNode{name: scores[d.top[k]].Name, total: scores[d.top[k]].TotalScore}
+	}
+	e.n = d.n
+	return e
+}
+
+// deckhouseDecisionEventSuffix is appended to the upstream Scheduled message
+// "Successfully assigned <namespace>/<name> to <node>", for example
+// "; top: node-a=512 node-b=498 node-c=470; decided by NodeResourcesFit (+14)".
+// The whole message stays within deckhouseEventMessageLimit: nodes that do not
+// fit are left out from the end, and nothing is added when even the deciding
+// plugin does not fit. Empty when the events are off or the cycle recorded no
+// decision.
+func (sched *Scheduler) deckhouseDecisionEventSuffix(state *framework.CycleState, pod *v1.Pod, node string) string {
+	if !sched.deckhouseDecisions.events || state == nil {
+		return ""
+	}
+	data, err := state.Read(deckhouseDecisionEventKey)
+	if err != nil {
+		return ""
+	}
+	e, ok := data.(*deckhouseDecisionEvent)
+	if !ok {
+		return ""
+	}
+	budget := deckhouseEventMessageLimit - len("Successfully assigned / to ") - len(pod.Namespace) - len(pod.Name) - len(node)
+
+	decided := append([]byte("; decided by "), e.decidedBy...)
+	if e.contribution > 0 {
+		decided = append(decided, " (+"...)
+		decided = strconv.AppendInt(decided, e.contribution, 10)
+		decided = append(decided, ')')
+	}
+	if len(decided) > budget {
+		return ""
+	}
+	out := make([]byte, 0, budget)
+	out = append(out, "; top:"...)
+	added := 0
+	for k := 0; k < e.n; k++ {
+		mark := len(out)
+		out = append(out, ' ')
+		out = append(out, e.top[k].name...)
+		if e.scored {
+			out = append(out, '=')
+			out = strconv.AppendInt(out, e.top[k].total, 10)
+		}
+		if len(out)+len(decided) > budget {
+			out = out[:mark]
+			break
+		}
+		added++
+	}
+	if added == 0 {
+		out = out[:0]
+	}
+	return string(append(out, decided...))
+}
+
+// deckhouseDecisionNames maps the name of a score (a score plugin, or the URL
+// prefix of an extender, as prioritizeNodes names it) to plugin/<plugin> or
+// extender/<extender name>.
+type deckhouseDecisionNames map[string]string
+
+// of returns the prefixed name; a name it does not know (a plugin of a
+// framework without DeckhouseScorePluginWeights) stays as it is.
+func (n deckhouseDecisionNames) of(score string) string {
+	if name, ok := n[score]; ok {
+		return name
+	}
+	return score
+}
+
+// deckhouseDecisionNames builds the prefixed names of the score plugins of
+// every profile and of every extender.
+func (sched *Scheduler) deckhouseDecisionNames() deckhouseDecisionNames {
+	out := deckhouseDecisionNames{}
+	for _, f := range sched.Profiles {
+		if w, ok := f.(interface{ DeckhouseScorePluginWeights() map[string]int }); ok {
+			for name := range w.DeckhouseScorePluginWeights() {
+				out[name] = "plugin/" + name
+			}
+		}
+	}
+	for _, e := range sched.Extenders {
+		out[e.Name()] = "extender/" + deckhouseExtenderName(e.Name())
+	}
+	return out
+}
