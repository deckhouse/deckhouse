+	if fmt.Sprint(sched.deckhouseDecisions.names) != fmt.Sprint(want) {
+		t.Errorf("names %v, want %v", sched.deckhouseDecisions.names, want)
+	}
+
+	before := decisionMetric(t, "extender/usage")
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: "ns", Name: "p", UID: "u"}}
+	state := framework.NewCycleState()
