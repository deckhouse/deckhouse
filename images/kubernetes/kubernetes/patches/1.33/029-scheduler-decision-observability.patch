+// benchmarkScores builds the scores of n feasible nodes with 15 score plugins
+// and 2 extenders, as prioritizeNodes returns them.
+func benchmarkScores(n int) ([]framework.NodePluginScores, string) {
+	names := make([]string, 0, 17)
+	for i := 0; i < 15; i++ {
+		names = append(names, fmt.Sprintf("Plugin%02d", i))
+	}
+	names = append(names, "https://extender-1.example:8443/scheduler", "https://extender-2.example:8443/scheduler")
+	scores := make([]framework.NodePluginScores, n)
+	best, host := int64(-1), ""
+	for i := range scores {
+		s := framework.NodePluginScores{Name: fmt.Sprintf("node-%05d", i), Scores: make([]framework.PluginScore, len(names))}
+		for j, name := range names {
+			s.Scores[j] = framework.PluginScore{Name: name, Score: int64((i*31 + j*17) % 101)}
+			s.TotalScore += s.Scores[j].Score
+		}
+		if s.TotalScore > best {
+			best, host = s.TotalScore, s.Name
+		}
+		scores[i] = s
+	}
+	return scores, host
+}
+
+// benchmarkNames prefixes the score names of benchmarkScores as
+// deckhouseDecisionNames does.
+func benchmarkNames(scores []framework.NodePluginScores) deckhouseDecisionNames {
+	names := deckhouseDecisionNames{}
+	for _, p := range scores[0].Scores {
+		if strings.HasPrefix(p.Name, "https://") {
+			names[p.Name] = "extender/" + strings.TrimPrefix(p.Name, "https://")
+		} else {
+			names[p.Name] = "plugin/" + p.Name
+		}
+	}
+	return names
+}
