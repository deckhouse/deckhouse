+
+package scheduler
+
+// Deckhouse: in-memory log of the last scheduling decisions, GET /decisions on
+// the loopback listener of the simulate endpoint.
+//
+// The log is a ring of slots allocated once. The scheduling goroutine takes the
+// next sequence number with an atomic add and copies the decision into its slot
+// under the slot's own mutex; a reader locks one slot at a time to copy it out.
+// The scheduling path therefore waits at most for the copy of one entry, never
+// for a whole read. An entry holds strings and numbers only: no Pod, NodeInfo
+// or framework object stays referenced.
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/klog/v2"
+	"k8s.io/kubernetes/pkg/scheduler/framework"
+)
+
+const (
+	// deckhouseDecisionMaxScores bounds the plugin and extender scores kept per
+	// node of an entry.
+	deckhouseDecisionMaxScores     = 32
+	deckhouseDecisionsDefaultLimit = 100
+	// deckhouseDecisionsMaxLimit bounds one answer of GET /decisions whatever
+	// the size of the ring.
+	deckhouseDecisionsMaxLimit = 1000
+)
+
+// DeckhouseDecisionList is the answer of GET /decisions, newest first.
+type DeckhouseDecisionList struct {
+	Size      int                 `json:"size"`
+	Decisions []DeckhouseDecision `json:"decisions"`
+}
+
+// DeckhouseDecision is one decision of a real scheduling cycle. Top lists the
+// selected node first, then the next best nodes, with their weighted scores.
+// DurationSeconds is the time of the scheduling attempt up to the decision:
+// cache snapshot, filters, extenders and scores.
+type DeckhouseDecision struct {
+	Time            time.Time               `json:"time"`
+	Namespace       string                  `json:"namespace"`
+	Name            string                  `json:"name"`
+	UID             types.UID               `json:"uid"`
+	Profile         string                  `json:"profile"`
+	Node            string                  `json:"node"`
+	FeasibleNodes   int                     `json:"feasibleNodes"`
+	DecidedBy       string                  `json:"decidedBy"`
+	Contribution    int64                   `json:"contribution"`
+	Margin          int64                   `json:"margin"`
+	DurationSeconds float64                 `json:"durationSeconds"`
+	Top             []DeckhouseDecisionNode `json:"top"`
+}
+
+// DeckhouseDecisionNode is one of the top nodes of a decision. Scores are empty
+// when a single node was feasible.
+type DeckhouseDecisionNode struct {
+	Name       string          `json:"name"`
+	TotalScore int64           `json:"totalScore"`
+	Scores     []SimulateScore `json:"scores,omitempty"`
+}
+
+type deckhouseDecisionNodeRecord struct {
+	name   string
+	total  int64
+	scores []framework.PluginScore // the backing array is reused by later entries
+}
+
+type deckhouseDecisionRecord struct {
+	time                 time.Time
+	namespace, name      string
+	uid                  types.UID
+	profile, node        string
+	feasible             int
+	decidedBy            string
+	contribution, margin int64
+	duration             time.Duration
+	top                  [deckhouseDecisionTop]deckhouseDecisionNodeRecord
+	n                    int
+}
+
+type deckhouseDecisionSlot struct {
+	mu  sync.Mutex
+	seq uint64 // 1-based sequence number of the entry, 0 while empty
+	rec deckhouseDecisionRecord
+}
+
+type deckhouseDecisionLog struct {
+	next  atomic.Uint64
+	slots []deckhouseDecisionSlot
+	// names prefix the score names of an entry when it is read: the scheduling
+	// path copies the score names as prioritizeNodes made them.
+	names deckhouseDecisionNames
+}
+
+func newDeckhouseDecisionLog(size int) *deckhouseDecisionLog {
+	if size <= 0 {
+		return nil
+	}
+	return &deckhouseDecisionLog{slots: make([]deckhouseDecisionSlot, size)}
+}
+
+// deckhouseDecisionEventsFromEnv reads DECKHOUSE_SCHEDULER_DECISION_EVENTS. An
+// invalid value is logged and leaves the events off.
+func deckhouseDecisionEventsFromEnv(logger klog.Logger, getenv func(string) string) bool {
+	v := getenv(deckhouseDecisionEventsEnv)
+	if v == "" {
+		return false
+	}
+	b, err := strconv.ParseBool(v)
+	if err != nil {
+		logger.Error(err, "Ignoring invalid value", "variable", deckhouseDecisionEventsEnv, "value", v)
+	}
+	return b
+}
+
+// deckhouseDecisionLogFromEnv allocates the log of
+// DECKHOUSE_SCHEDULER_DECISION_LOG_SIZE entries, at most deckhouseDecisionLogMax.
+// Unset, 0 or an invalid value (logged) is nil: no log.
+func deckhouseDecisionLogFromEnv(logger klog.Logger, getenv func(string) string) *deckhouseDecisionLog {
+	v := getenv(deckhouseDecisionLogSizeEnv)
+	if v == "" {
+		return nil
+	}
+	n, err := strconv.Atoi(v)
+	if err != nil || n < 0 {
+		logger.Error(err, "Ignoring invalid value, the decision log is off", "variable", deckhouseDecisionLogSizeEnv, "value", v)
+		return nil
+	}
+	if n > deckhouseDecisionLogMax {
+		logger.Info("Decision log size is capped", "variable", deckhouseDecisionLogSizeEnv, "value", n, "size", deckhouseDecisionLogMax)
+		n = deckhouseDecisionLogMax
+	}
+	return newDeckhouseDecisionLog(n)
+}
+
+// record copies a decision into the next slot.
+func (l *deckhouseDecisionLog) record(now time.Time, pod *v1.Pod, profile, host string, d deckhouseDecision, scores []framework.NodePluginScores, duration time.Duration) {
+	seq := l.next.Add(1)
+	s := &l.slots[(seq-1)%uint64(len(l.slots))]
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if seq < s.seq {
+		// A later decision already took the slot after a full turn of the ring.
+		return
+	}
+	s.seq = seq
+	r := &s.rec
+	r.time, r.namespace, r.name, r.uid = now, pod.Namespace, pod.Name, pod.UID
+	r.profile, r.node, r.feasible, r.duration = profile, host, d.feasible, duration
+	r.decidedBy, r.contribution, r.margin = d.decidedBy, d.contribution, d.margin
+	if len(scores) < 2 {
+		r.top[0].name, r.top[0].total, r.top[0].scores, r.n = host, 0, r.top[0].scores[:0], 1
+		return
+	}
+	for k := 0; k < d.n; k++ {
+		src := &scores[d.top[k]]
+		ps := src.Scores
+		if len(ps) > deckhouseDecisionMaxScores {
+			ps = ps[:deckhouseDecisionMaxScores]
+		}
+		t := &r.top[k]
+		t.name, t.total, t.scores = src.Name, src.TotalScore, append(t.scores[:0], ps...)
+	}
+	r.n = d.n
+}
+
+// each copies out the newest entries that match, at most limit of them, and
+// passes them to fn one by one outside the slot lock; it stops at the first
+// error of fn. An empty namespace or name matches any.
+func (l *deckhouseDecisionLog) each(namespace, name string, limit int, fn func(DeckhouseDecision) error) error {
+	size := uint64(len(l.slots))
+	last := l.next.Load()
+	found := 0
+	for seq := last; seq > 0 && last-seq < size && found < limit; seq-- {
+		s := &l.slots[(seq-1)%size]
+		s.mu.Lock()
+		match := s.seq == seq && (namespace == "" || s.rec.namespace == namespace) && (name == "" || s.rec.name == name)
+		var d DeckhouseDecision
+		if match {
+			d = s.rec.export(l.names)
+		}
+		s.mu.Unlock()
+		if !match {
+			continue
+		}
+		found++
+		if err := fn(d); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// list returns what each passes.
+func (l *deckhouseDecisionLog) list(namespace, name string, limit int) []DeckhouseDecision {
+	var out []DeckhouseDecision
+	_ = l.each(namespace, name, limit, func(d DeckhouseDecision) error {
+		out = append(out, d)
+		return nil
+	})
+	return out
+}
+
+func (r *deckhouseDecisionRecord) export(names deckhouseDecisionNames) DeckhouseDecision {
+	out := DeckhouseDecision{
+		Time: r.time, Namespace: r.namespace, Name: r.name, UID: r.uid,
+		Profile: r.profile, Node: r.node, FeasibleNodes: r.feasible,
+		DecidedBy: r.decidedBy, Contribution: r.contribution, Margin: r.margin,
+		DurationSeconds: r.duration.Seconds(),
+		Top:             make([]DeckhouseDecisionNode, r.n),
+	}
+	for k := 0; k < r.n; k++ {
+		t := &r.top[k]
+		out.Top[k] = DeckhouseDecisionNode{Name: t.name, TotalScore: t.total}
+		if len(t.scores) > 0 {
+			out.Top[k].Scores = make([]SimulateScore, len(t.scores))
+			for i, p := range t.scores {
+				out.Top[k].Scores[i] = SimulateScore{Name: names.of(p.Name), Score: p.Score}
+			}
+		}
+	}
+	return out
+}
+
+// deckhouseDecisionsHandler serves GET /decisions?namespace=&name=&limit=.
+// Without the log it answers 404 and does nothing else.
+type deckhouseDecisionsHandler struct {
+	log    *deckhouseDecisionLog
+	logger klog.Logger
+}
+
+func (h deckhouseDecisionsHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if h.log == nil {
+		http.Error(w, "the decision log is off, set "+deckhouseDecisionLogSizeEnv, http.StatusNotFound)
+		return
+	}
+	if r.Method != http.MethodGet {
+		http.Error(w, "use GET", http.StatusMethodNotAllowed)
+		return
+	}
+	size := len(h.log.slots)
+	namespace, name, limit, err := decisionsQuery(r.URL.RawQuery, size)
+	if err != nil {
+		http.Error(w, fmt.Sprintf("bad request: %v", err), http.StatusBadRequest)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	if err := writeDecisions(w, h.log, size, namespace, name, limit); err != nil {
+		h.logger.Error(err, "Failed to write decisions response")
+	}
+}
+
+// writeDecisions streams a DeckhouseDecisionList entry by entry, so that an
+// answer is never built in one buffer.
+func writeDecisions(w io.Writer, l *deckhouseDecisionLog, size int, namespace, name string, limit int) error {
+	if _, err := fmt.Fprintf(w, `{"size":%d,"decisions":[`, size); err != nil {
+		return err
+	}
+	enc := json.NewEncoder(w)
+	sep := ""
+	err := l.each(namespace, name, limit, func(d DeckhouseDecision) error {
+		if _, err := io.WriteString(w, sep); err != nil {
+			return err
+		}
+		sep = ","
+		return enc.Encode(d)
+	})
+	if err != nil {
+		return err
+	}
+	_, err = io.WriteString(w, "]}\n")
+	return err
+}
+
+// decisionsQuery reads namespace, name and limit (default 100, at most
+// deckhouseDecisionsMaxLimit and the size of the ring; a larger limit is cut).
+// Unknown or repeated parameters are errors.
+func decisionsQuery(raw string, size int) (namespace, name string, limit int, err error) {
+	q, err := url.ParseQuery(raw)
+	if err != nil {
+		return "", "", 0, err
+	}
+	limit = min(deckhouseDecisionsDefaultLimit, size)
+	maxLimit := min(deckhouseDecisionsMaxLimit, size)
+	for key, values := range q {
+		if len(values) != 1 {
+			return "", "", 0, fmt.Errorf("parameter %q must be set once", key)
+		}
+		switch v := values[0]; key {
+		case "namespace":
+			namespace = v
+		case "name":
+			name = v
+		case "limit":
+			n, err := strconv.Atoi(v)
+			if err != nil || n < 1 {
+				return "", "", 0, fmt.Errorf("limit must be a positive integer, got %q", v)
+			}
+			limit = min(n, maxLimit)
+		default:
+			return "", "", 0, fmt.Errorf("unknown parameter %q, known: namespace, name, limit", key)
+		}
+	}
+	return namespace, name, limit, nil
+}
