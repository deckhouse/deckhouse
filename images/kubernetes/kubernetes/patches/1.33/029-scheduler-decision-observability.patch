+// The ring keeps the last entries, newest first, and never grows.
+func TestDeckhouseDecisionLog(t *testing.T) {
+	l := newDeckhouseDecisionLog(3)
+	l.names = deckhouseDecisionNames{"Fit": "plugin/Fit", "http://ext": "extender/ext"}
+	for i := 0; i < 5; i++ {
+		recordDecision(l, fmt.Sprintf("p%d", i))
+	}
+	if len(l.slots) != 3 || cap(l.slots) != 3 {
+		t.Fatalf("ring of %d slots", len(l.slots))
+	}
+	var names []string
+	for _, d := range l.list("", "", 10) {
+		names = append(names, d.Name)
+	}
+	if strings.Join(names, ",") != "p4,p3,p2" {
+		t.Errorf("entries %v", names)
+	}
+	if got := l.list("ns", "p3", 10); len(got) != 1 || got[0].Name != "p3" {
+		t.Errorf("filtered %v", got)
+	}
+	if got := l.list("other", "", 10); len(got) != 0 {
+		t.Errorf("other namespace %v", got)
+	}
+	if got := l.list("", "", 2); len(got) != 2 || got[0].Name != "p4" {
+		t.Errorf("limit 2: %v", got)
+	}
+
+	want := DeckhouseDecision{
+		Time: time.Unix(1, 0), Namespace: "ns", Name: "p4", UID: "uid-x", Profile: "default-scheduler", Node: "a",
+		FeasibleNodes: 2, DecidedBy: "plugin/Fit", Contribution: 4, Margin: 3, DurationSeconds: 0.001,
+		Top: []DeckhouseDecisionNode{
+			{Name: "a", TotalScore: 10, Scores: []SimulateScore{{Name: "plugin/Fit", Score: 9}, {Name: "extender/ext", Score: 1}}},
+			{Name: "b", TotalScore: 7, Scores: []SimulateScore{{Name: "plugin/Fit", Score: 5}, {Name: "extender/ext", Score: 2}}},
+		},
+	}
+	got, _ := json.Marshal(l.list("", "p4", 1)[0])
+	wantJSON, _ := json.Marshal(want)
+	if string(got) != string(wantJSON) {
+		t.Errorf("entry\n%s\nwant\n%s", got, wantJSON)
+	}
+
+	// The score lists of a slot are reused and bounded.
+	many := make([]framework.PluginScore, 2*deckhouseDecisionMaxScores)
+	for i := range many {
+		many[i] = ps(fmt.Sprintf("P%d", i), 1)
+	}
+	scores := decisionScores(decisionNode("a", many...), decisionNode("b"))
+	d, _ := deckhouseDecide("a", scores)
+	l.record(time.Now(), &v1.Pod{}, "p", "a", d, scores, 0)
+	for i := range l.slots {
+		for _, n := range l.slots[i].rec.top {
+			if len(n.scores) > deckhouseDecisionMaxScores {
+				t.Errorf("slot %d keeps %d scores", i, len(n.scores))
+			}
+		}
+	}
+
+	single := newDeckhouseDecisionLog(1)
+	sd, _ := deckhouseDecide("x", nil)
+	single.record(time.Now(), &v1.Pod{}, "p", "x", sd, nil, 0)
+	if got := single.list("", "", 1); len(got) != 1 || got[0].DecidedBy != DecidedBySingleFeasibleNode || len(got[0].Top) != 1 || got[0].Top[0].Name != "x" || got[0].Top[0].Scores != nil {
+		t.Errorf("single feasible node entry %+v", got)
+	}
+}
