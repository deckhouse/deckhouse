+// The message never exceeds the events.k8s.io/v1 limit: nodes that do not fit
+// are left out from the end, and nothing is added when the plugin does not fit.
+func TestDeckhouseDecisionEventLimit(t *testing.T) {
+	sched := &Scheduler{deckhouseDecisions: deckhouseDecisions{events: true}}
+	long := func(c byte) string { return strings.Repeat(string(c), 253) }
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: strings.Repeat("n", 63), Name: long('p')}}
+	scores := decisionScores(decisionNode(long('a'), ps("Fit", 9)), decisionNode(long('b'), ps("Fit", 5)), decisionNode(long('c'), ps("Fit", 1)))
+	d, _ := deckhouseDecide(long('a'), scores)
+	state := framework.NewCycleState()
+	state.Write(deckhouseDecisionEventKey, newDeckhouseDecisionEvent(long('a'), d, scores))
+
+	suffix := sched.deckhouseDecisionEventSuffix(state, pod, long('a'))
+	prefix := fmt.Sprintf("Successfully assigned %v/%v to %v", pod.Namespace, pod.Name, long('a'))
+	if n := len(prefix) + len(suffix); n > deckhouseEventMessageLimit {
+		t.Fatalf("message of %d bytes", n)
+	}
+	if !strings.HasSuffix(suffix, "; decided by Fit (+4)") || !strings.Contains(suffix, long('a')+"=9") || strings.Contains(suffix, long('b')) {
+		t.Errorf("suffix %q", suffix)
+	}
+
+	huge := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: pod.Namespace, Name: strings.Repeat("p", 700)}}
+	if s := sched.deckhouseDecisionEventSuffix(state, huge, long('a')); s != "" {
+		t.Errorf("no room left, got %q", s)
+	}
+	if s := sched.deckhouseDecisionEventSuffix(framework.NewCycleState(), pod, "a"); s != "" {
+		t.Errorf("no decision in the state, got %q", s)
+	}
+}
