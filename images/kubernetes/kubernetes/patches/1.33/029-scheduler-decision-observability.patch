+// BenchmarkDeckhousePrioritizeNodes is the upstream scoring of the same node
+// counts with 15 trivial score plugins and 2 in-process extenders, and the
+// selection of the host: a lower bound of what a real cycle spends to reach
+// the decision (real plugins and HTTP extenders cost more).
+func BenchmarkDeckhousePrioritizeNodes(b *testing.B) {
+	_, ctx := ktesting.NewTestContext(b)
+	for _, n := range []int{100, 1000, 5000} {
+		names := make([]string, n)
+		for i := range names {
+			names[i] = fmt.Sprintf("node-%05d", i)
+		}
+		sched := makeScheduler(ctx, makeNodeList(names))
+		plugins := []tf.RegisterPluginFunc{
+			tf.RegisterQueueSortPlugin(queuesort.Name, queuesort.New),
+			tf.RegisterBindPlugin(defaultbinder.Name, defaultbinder.New),
+		}
+		for i := 0; i < 15; i++ {
+			plugins = append(plugins, benchScorePlugin(fmt.Sprintf("Plugin%02d", i)))
+		}
+		schedFramework, err := tf.NewFramework(ctx, plugins, v1.DefaultSchedulerName,
+			frameworkruntime.WithSnapshotSharedLister(sched.nodeInfoSnapshot))
+		if err != nil {
+			b.Fatal(err)
+		}
+		extenders := []framework.Extender{benchExtender("https://extender-1.example:8443/scheduler"), benchExtender("https://extender-2.example:8443/scheduler")}
+		nodes, err := sched.nodeInfoSnapshot.NodeInfos().List()
+		if err != nil {
+			b.Fatal(err)
+		}
+		pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: "ns", Name: "p", UID: "u"}}
+		b.Run(fmt.Sprintf("nodes=%d", n), func(b *testing.B) {
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				scores, err := prioritizeNodes(ctx, extenders, schedFramework, framework.NewCycleState(), pod, nodes)
+				if err != nil {
+					b.Fatal(err)
+				}
+				if _, _, err := selectHost(scores, numberOfHighestScoredNodesToReport); err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
+}
+
+func benchExtender(name string) *tf.FakeExtender {
+	return &tf.FakeExtender{ExtenderName: name, Weight: 1, Prioritizers: []tf.PriorityConfig{{Weight: 1, Function: func(_ *v1.Pod, nodes []*framework.NodeInfo) (*framework.NodeScoreList, error) {
+		out := make(framework.NodeScoreList, len(nodes))
+		for i, n := range nodes {
+			out[i] = framework.NodeScore{Name: n.Node().Name, Score: int64(i % 11)}
+		}
+		return &out, nil
+	}}}}
+}
+
+type benchScore struct{ name string }
+
+func (p benchScore) Name() string { return p.name }
+
+func (p benchScore) Score(_ context.Context, _ *framework.CycleState, _ *v1.Pod, nodeInfo *framework.NodeInfo) (int64, *framework.Status) {
+	name := nodeInfo.Node().Name
+	return int64(len(name)*7+int(name[len(name)-1])+len(p.name)) % framework.MaxNodeScore, nil
+}
+
+func (p benchScore) ScoreExtensions() framework.ScoreExtensions { return nil }
+
+func benchScorePlugin(name string) tf.RegisterPluginFunc {
+	return tf.RegisterScorePlugin(name, func(context.Context, k8sruntime.Object, framework.Handle) (framework.Plugin, error) {
+		return benchScore{name: name}, nil
+	}, 1)
+}
