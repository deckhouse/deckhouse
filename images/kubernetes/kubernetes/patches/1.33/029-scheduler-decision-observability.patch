+// The deciding plugin is the one with the largest lead of the winner over the
+// best other node; ties, single nodes and more than three equal top scores are
+// named as such, and extender scores are matched by name in any order.
+func TestDeckhouseDecide(t *testing.T) {
+	cases := []struct {
+		name         string
+		host         string
+		scores       []framework.NodePluginScores
+		decidedBy    string
+		contribution int64
+		margin       int64
+		top          []string
+	}{{
+		name:      "single feasible node",
+		host:      "a",
+		decidedBy: DecidedBySingleFeasibleNode,
+	}, {
+		name: "largest positive lead decides",
+		host: "a",
+		scores: decisionScores(
+			decisionNode("c", ps("Fit", 50), ps("Spread", 40), ps("http://ext", 0)),
+			decisionNode("a", ps("Fit", 70), ps("Spread", 10), ps("http://ext", 30)),
+			decisionNode("b", ps("Fit", 60), ps("Spread", 30), ps("http://ext", 10)),
+		),
+		// a=110, b=100, c=90: Fit +10, Spread -20, ext +20.
+		decidedBy: "http://ext", contribution: 20, margin: 10, top: []string{"a", "b", "c"},
+	}, {
+		name: "extenders answered in another order, one did not score the runner-up",
+		host: "a",
+		scores: decisionScores(
+			decisionNode("a", ps("Fit", 10), ps("http://e1", 20), ps("http://e2", 50)),
+			decisionNode("b", ps("Fit", 30), ps("http://e2", 10)),
+		),
+		decidedBy: "http://e2", contribution: 40, margin: 40, top: []string{"a", "b"},
+	}, {
+		name: "tie",
+		host: "b",
+		scores: decisionScores(
+			decisionNode("a", ps("Fit", 50)),
+			decisionNode("b", ps("Fit", 50)),
+			decisionNode("c", ps("Fit", 10)),
+		),
+		decidedBy: DecidedByTie, top: []string{"b", "a", "c"},
+	}, {
+		name: "winner among more than three equal top scores",
+		host: "e",
+		scores: decisionScores(
+			decisionNode("a", ps("Fit", 50)), decisionNode("b", ps("Fit", 50)), decisionNode("c", ps("Fit", 50)),
+			decisionNode("d", ps("Fit", 50)), decisionNode("e", ps("Fit", 50)), decisionNode("f", ps("Fit", 1)),
+		),
+		decidedBy: DecidedByTie, top: []string{"e", "a", "b"},
+	}, {
+		name: "no score plugins: every total is 1",
+		host: "b",
+		scores: decisionScores(
+			framework.NodePluginScores{Name: "a", TotalScore: 1}, framework.NodePluginScores{Name: "b", TotalScore: 1},
+		),
+		decidedBy: DecidedByTie, top: []string{"b", "a"},
+	}, {
+		name: "best three kept in order",
+		host: "d",
+		scores: decisionScores(
+			decisionNode("a", ps("Fit", 1)), decisionNode("b", ps("Fit", 5)), decisionNode("c", ps("Fit", 3)),
+			decisionNode("d", ps("Fit", 9)), decisionNode("e", ps("Fit", 4)), decisionNode("f", ps("Fit", 5)),
+		),
+		decidedBy: "Fit", contribution: 4, margin: 4, top: []string{"d", "b", "f"},
+	}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			d, ok := deckhouseDecide(tc.host, tc.scores)
+			if !ok {
+				t.Fatal("not decided")
+			}
+			if d.decidedBy != tc.decidedBy || d.contribution != tc.contribution || d.margin != tc.margin {
+				t.Errorf("decided by %q (+%d), margin %d; want %q (+%d), margin %d", d.decidedBy, d.contribution, d.margin, tc.decidedBy, tc.contribution, tc.margin)
+			}
+			var top []string
+			for k := 0; k < d.n && len(tc.scores) > 1; k++ {
+				top = append(top, tc.scores[d.top[k]].Name)
+			}
+			if strings.Join(top, ",") != strings.Join(tc.top, ",") {
+				t.Errorf("top %v, want %v", top, tc.top)
+			}
+		})
+	}
+	if _, ok := deckhouseDecide("missing", decisionScores(decisionNode("a"), decisionNode("b"))); ok {
+		t.Error("a host outside the scores must not be decided")
+	}
+}
