+// A real cycle records the decision; a simulation records none.
+func TestDeckhouseDecisionMetrics(t *testing.T) {
+	_, ctx := ktesting.NewTestContext(t)
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	metrics.Register()
+
+	sched := newSimulateTestScheduler(t, ctx, []string{"1", "2", "3"})
+	schedFramework := sched.Profiles[v1.DefaultSchedulerName]
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: "ns", Name: "p", UID: "u"}}
+
+	numeric, single := decisionMetric(t, "plugin/NumericMap"), decisionMetric(t, DecidedBySingleFeasibleNode)
+	margins, feasible := decisionHistogramCount(t, metrics.DecisionScoreMargin), decisionHistogramCount(t, metrics.DecisionFeasibleNodes)
+
+	result, err := sched.SchedulePod(ctx, schedFramework, framework.NewCycleState(), pod)
+	if err != nil || result.SuggestedHost != "3" {
+		t.Fatalf("SchedulePod = %v, %v", result.SuggestedHost, err)
+	}
+	if got := decisionMetric(t, "plugin/NumericMap") - numeric; got != 1 {
+		t.Errorf("NumericMap decisions = %v, want 1", got)
+	}
+	if got := decisionHistogramCount(t, metrics.DecisionScoreMargin) - margins; got != 1 {
+		t.Errorf("margins observed = %v, want 1", got)
+	}
+	if got := decisionHistogramCount(t, metrics.DecisionFeasibleNodes) - feasible; got != 1 {
+		t.Errorf("feasible node counts observed = %v, want 1", got)
+	}
+
+	if _, err := sched.Simulate(ctx, &SimulateRequest{Pod: pod}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := sched.SchedulePod(framework.WithDeckhouseSimulation(ctx), schedFramework, framework.NewCycleState(), pod); err != nil {
+		t.Fatal(err)
+	}
+	if got := decisionMetric(t, "plugin/NumericMap") - numeric; got != 1 {
+		t.Errorf("simulations recorded decisions: %v, want 1 in total", got)
+	}
+
+	// The nominated node is tried first and taken without scoring.
+	nominated := decisionMetric(t, DecidedByNominatedNode)
+	nominatedPod := pod.DeepCopy()
+	nominatedPod.Status.NominatedNodeName = "2"
+	if result, err := sched.SchedulePod(ctx, schedFramework, framework.NewCycleState(), nominatedPod); err != nil || result.SuggestedHost != "2" {
+		t.Fatalf("SchedulePod = %v, %v", result.SuggestedHost, err)
+	}
+	if got := decisionMetric(t, DecidedByNominatedNode) - nominated; got != 1 {
+		t.Errorf("nominated node decisions = %v, want 1", got)
+	}
+	if got := decisionHistogramCount(t, metrics.DecisionFeasibleNodes) - feasible; got != 1 {
+		t.Errorf("a nominated node must not observe feasible nodes, observed = %v", got)
+	}
+
+	one := newSimulateTestScheduler(t, ctx, []string{"7"})
+	if _, err := one.SchedulePod(ctx, one.Profiles[v1.DefaultSchedulerName], framework.NewCycleState(), pod); err != nil {
+		t.Fatal(err)
+	}
+	if got := decisionMetric(t, DecidedBySingleFeasibleNode) - single; got != 1 {
+		t.Errorf("single feasible node decisions = %v, want 1", got)
+	}
+	if got := decisionHistogramCount(t, metrics.DecisionScoreMargin) - margins; got != 1 {
+		t.Errorf("a single feasible node must not observe a margin, margins observed = %v", got)
+	}
+	if got := decisionHistogramCount(t, metrics.DecisionFeasibleNodes) - feasible; got != 2 {
+		t.Errorf("feasible node counts observed = %v, want 2", got)
+	}
+
+}
