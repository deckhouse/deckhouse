+func TestDeckhouseDecisionsHandler(t *testing.T) {
+	l := newDeckhouseDecisionLog(5)
+	for i := 0; i < 3; i++ {
+		recordDecision(l, fmt.Sprintf("p%d", i))
+	}
+	cases := []struct {
+		log    *deckhouseDecisionLog
+		method string
+		query  string
+		code   int
+		names  string
+	}{
+		{log: nil, method: http.MethodGet, code: http.StatusNotFound},
+		{log: l, method: http.MethodPost, code: http.StatusMethodNotAllowed},
+		{log: l, method: http.MethodGet, query: "limit=0", code: http.StatusBadRequest},
+		{log: l, method: http.MethodGet, query: "limit=x", code: http.StatusBadRequest},
+		{log: l, method: http.MethodGet, query: "node=a", code: http.StatusBadRequest},
+		{log: l, method: http.MethodGet, query: "name=a&name=b", code: http.StatusBadRequest},
+		{log: l, method: http.MethodGet, code: http.StatusOK, names: "p2,p1,p0"},
+		{log: l, method: http.MethodGet, query: "limit=1000", code: http.StatusOK, names: "p2,p1,p0"},
+		{log: l, method: http.MethodGet, query: "namespace=ns&name=p1", code: http.StatusOK, names: "p1"},
+		{log: l, method: http.MethodGet, query: "limit=2", code: http.StatusOK, names: "p2,p1"},
+	}
+	for _, tc := range cases {
+		rec := httptest.NewRecorder()
+		deckhouseDecisionsHandler{log: tc.log, logger: klog.Background()}.ServeHTTP(rec, httptest.NewRequest(tc.method, "/decisions?"+tc.query, nil))
+		if rec.Code != tc.code {
+			t.Errorf("%s ?%s: %d %s, want %d", tc.method, tc.query, rec.Code, rec.Body.String(), tc.code)
+			continue
+		}
+		if tc.code != http.StatusOK {
+			continue
+		}
+		var resp DeckhouseDecisionList
+		if err := json.Unmarshal(rec.Body.Bytes(), &resp); err != nil {
+			t.Fatal(err)
+		}
+		var names []string
+		for _, d := range resp.Decisions {
+			names = append(names, d.Name)
+		}
+		if resp.Size != 5 || strings.Join(names, ",") != tc.names {
+			t.Errorf("?%s: size %d, entries %v, want %s", tc.query, resp.Size, names, tc.names)
+		}
+	}
+}
