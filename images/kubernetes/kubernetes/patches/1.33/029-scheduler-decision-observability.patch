+	defer goleak.VerifyNone(t, goleak.IgnoreCurrent())
+	_, ctx := ktesting.NewTestContext(t)
+	ctx, cancel := context.WithCancel(ctx)
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := l.Addr().String()
+	l.Close()
+	t.Setenv(deckhouseSimulateAddressEnv, addr)
+	t.Setenv(deckhouseDecisionEventsEnv, "true")
+	t.Setenv(deckhouseDecisionLogSizeEnv, "10")
+
+	sched := &Scheduler{}
+	StartDeckhouseSimulateServer(ctx, sched, func() bool { return true }, make(chan struct{}))
+	if !sched.deckhouseDecisions.events || sched.deckhouseDecisions.log == nil {
+		t.Fatalf("decision outputs %+v", sched.deckhouseDecisions)
+	}
+	recordDecision(sched.deckhouseDecisions.log, "p")
+	client := &http.Client{Transport: &http.Transport{DisableKeepAlives: true}}
+	var resp *http.Response
+	for i := 0; i < 100; i++ {
+		if resp, err = client.Get("http://" + addr + "/decisions?name=p"); err == nil {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	var list DeckhouseDecisionList
+	err = json.NewDecoder(resp.Body).Decode(&list)
+	resp.Body.Close()
+	if err != nil || resp.StatusCode != http.StatusOK || len(list.Decisions) != 1 {
+		t.Fatalf("GET /decisions: %d %+v %v", resp.StatusCode, list, err)
+	}
+	cancel()
+	for i := 0; i < 100; i++ {
+		if _, err = client.Get("http://" + addr + "/decisions"); err != nil {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if err == nil {
+		t.Fatal("the server still answers after the context is done")
+	}
+}
