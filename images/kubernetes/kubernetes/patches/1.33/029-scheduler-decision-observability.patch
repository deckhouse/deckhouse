+// The simulate endpoint counts every answer by code, and a simulation records
+// its wait for the lock and how long it held it.
+func TestDeckhouseSimulateMetrics(t *testing.T) {
+	_, ctx := ktesting.NewTestContext(t)
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	metrics.Register()
+
+	sched := newSimulateTestScheduler(t, ctx, []string{"1", "2"})
+	synced := make(chan struct{})
+	close(synced)
+	h := newDeckhouseSimulateHandler(sched, func() bool { return true }, synced, klog.FromContext(ctx))
+	count := func(code string) float64 {
+		v, err := testutil.GetCounterMetricValue(metrics.SimulateRequests.WithLabelValues(code))
+		if err != nil {
+			t.Fatal(err)
+		}
+		return v
+	}
+	held := func(filters string) uint64 {
+		n, err := testutil.GetHistogramMetricCount(metrics.SimulateDuration.WithLabelValues(filters))
+		if err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	waits := func() uint64 {
+		n, err := testutil.GetHistogramMetricCount(metrics.SimulateLockWait.ObserverMetric)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	ok, bad, notAllowed, first, all, w := count("200"), count("400"), count("405"), held("first"), held("all"), waits()
+
+	body := `{"pod":{"metadata":{"namespace":"ns","name":"p"}}}`
+	for _, r := range []*http.Request{
+		httptest.NewRequest(http.MethodPost, "/simulate", strings.NewReader(body)),
+		httptest.NewRequest(http.MethodPost, "/simulate?filters=all", strings.NewReader(body)),
+		httptest.NewRequest(http.MethodPost, "/simulate?x=1", strings.NewReader(body)),
+		httptest.NewRequest(http.MethodGet, "/simulate", nil),
+	} {
+		h.ServeHTTP(httptest.NewRecorder(), r)
+	}
+	for name, got := range map[string]float64{
+		"200": count("200") - ok, "400": count("400") - bad, "405": count("405") - notAllowed,
+		"first": float64(held("first") - first), "all": float64(held("all") - all), "wait": float64(waits() - w),
+	} {
+		want := 1.0
+		if name == "200" || name == "wait" {
+			want = 2
+		}
+		if got != want {
+			t.Errorf("%s: %v, want %v", name, got, want)
+		}
+	}
+}
