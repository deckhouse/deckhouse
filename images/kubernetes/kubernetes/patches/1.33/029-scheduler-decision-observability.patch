+// A panic in the simulate handler is counted as 500 and goes on to net/http.
+func TestDeckhouseSimulatePanicCounted(t *testing.T) {
+	_, ctx := ktesting.NewTestContext(t)
+	metrics.Register()
+	synced := make(chan struct{})
