+func decisionScores(nodes ...framework.NodePluginScores) []framework.NodePluginScores { return nodes }
+
+func decisionNode(name string, scores ...framework.PluginScore) framework.NodePluginScores {
+	n := framework.NodePluginScores{Name: name, Scores: scores}
+	for _, s := range scores {
+		n.TotalScore += s.Score
+	}
+	return n
+}
