+// Writers and readers run concurrently (go test -race): readers never get more
+// entries than the ring holds, and the ring keeps its size.
+func TestDeckhouseDecisionLogConcurrent(t *testing.T) {
+	l := newDeckhouseDecisionLog(64)
+	var wg sync.WaitGroup
+	stop := make(chan struct{})
+	for w := 0; w < 4; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 2000; i++ {
+				recordDecision(l, "p")
+			}
+		}()
+	}
+	var readers sync.WaitGroup
+	for r := 0; r < 4; r++ {
+		readers.Add(1)
+		go func() {
+			defer readers.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				got := l.list("", "", 64)
+				if len(got) > 64 {
+					t.Errorf("read %d entries", len(got))
+					return
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	close(stop)
+	readers.Wait()
+	if l.next.Load() != 8000 || len(l.slots) != 64 {
+		t.Errorf("next %d, slots %d", l.next.Load(), len(l.slots))
+	}
+	if got := l.list("", "", 64); len(got) != 64 {
+		t.Errorf("full ring reads %d entries", len(got))
+	}
+}
