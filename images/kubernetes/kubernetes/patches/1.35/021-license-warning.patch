+
+package licensewarning
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/util/sets"
+	"k8s.io/apiserver/pkg/authentication/user"
+	"k8s.io/apiserver/pkg/endpoints/request"
+	"k8s.io/apiserver/pkg/warning"
+	dynamicfake "k8s.io/client-go/dynamic/fake"
+	clienttesting "k8s.io/client-go/testing"
+)
+
+func effectiveLicense(status map[string]interface{}) runtime.Object {
+	return &unstructured.Unstructured{Object: map[string]interface{}{
+		"apiVersion": "deckhouse.io/v1alpha1",
+		"kind":       "EffectiveLicense",
+		"metadata":   map[string]interface{}{"name": objectName},
+		"status":     status,
+	}}
+}
+
+func TestPoll(t *testing.T) {
+	cases := []struct {
+		name    string
+		objects []runtime.Object
+		before  bool
+		want    bool
+	}{
+		{name: "no object", before: true, want: false},
+		{name: "apiWarning true", objects: []runtime.Object{effectiveLicense(map[string]interface{}{"apiWarning": true})}, want: true},
+		{name: "apiWarning false", objects: []runtime.Object{effectiveLicense(map[string]interface{}{"apiWarning": false})}, before: true, want: false},
+		{name: "no apiWarning field", objects: []runtime.Object{effectiveLicense(map[string]interface{}{"licensed": false})}, before: true, want: false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			active.Store(tc.before)
+			if err := poll(context.Background(), dynamicfake.NewSimpleDynamicClient(runtime.NewScheme(), tc.objects...)); err != nil {
+				t.Fatalf("poll: %v", err)
+			}
+			if got := active.Load(); got != tc.want {
+				t.Errorf("active = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestPollErrorKeepsState(t *testing.T) {
+	for _, before := range []bool{true, false} {
+		active.Store(before)
+		client := dynamicfake.NewSimpleDynamicClient(runtime.NewScheme())
+		client.PrependReactor("get", "effectivelicenses", func(clienttesting.Action) (bool, runtime.Object, error) {
+			return true, nil, errors.New("connection refused")
+		})
+		if err := poll(context.Background(), client); err == nil {
+			t.Fatal("poll: expected an error")
+		}
+		if got := active.Load(); got != before {
+			t.Errorf("active = %v, want the previous %v", got, before)
+		}
+	}
+}
+
+type recorder []string
+
+func (r *recorder) AddWarning(_, text string) { *r = append(*r, text) }
+
+func TestWithWarning(t *testing.T) {
+	const kubectl = "kubectl/v1.35.0 (linux/amd64) kubernetes/66452049"
+	// The same prefixes as the apiserver's RequestInfoResolver.
+	resolver := &request.RequestInfoFactory{APIPrefixes: sets.NewString("api", "apis"), GrouplessAPIPrefixes: sets.NewString("api")}
+	cases := []struct {
+		name      string
+		active    bool
+		user      string
+		userAgent string
+		path      string // defaults to /api/v1/namespaces
+		noInfo    bool
+		warn      bool
+	}{
+		{name: "kubectl", active: true, user: "admin@example.com", userAgent: kubectl, warn: true},
+		{name: "kubectl as kubernetes-admin", active: true, user: "kubernetes-admin", userAgent: kubectl, warn: true},
+		{name: "kubectl symlinked as k", active: true, user: "admin@example.com", userAgent: "k/v1.35.0 (linux/amd64) kubernetes/66452049", warn: true},
+		{name: "k9s", active: true, user: "admin@example.com", userAgent: "k9s/v0.0.0 (darwin/arm64) kubernetes/$Format", warn: true},
+		{name: "browser (Lens, Headlamp)", active: true, user: "admin@example.com", userAgent: "Mozilla/5.0 (X11; Linux x86_64)", warn: true},
+		{name: "helm", active: true, user: "admin@example.com", userAgent: "Helm/3.16.2", warn: true},
+		{name: "curl", active: true, user: "admin@example.com", userAgent: "curl/8.7.1", warn: true},
+		{name: "no user agent", active: true, user: "admin@example.com", warn: true},
+		{name: "dhctl", active: true, user: "kubernetes-admin", userAgent: "dhctl/v1.70.0 (linux/amd64) kubernetes/$Format"},
+		{name: "service account", active: true, user: "system:serviceaccount:default:default", userAgent: kubectl},
+		{name: "node", active: true, user: "system:node:master-0", userAgent: kubectl},
+		{name: "no user", active: true, userAgent: kubectl},
+		{name: "inactive", user: "admin@example.com", userAgent: kubectl},
+		{name: "CRD", active: true, user: "admin@example.com", userAgent: kubectl, path: "/apis/deckhouse.io/v1alpha1/effectivelicenses", warn: true},
+		{name: "aggregated API", active: true, user: "admin@example.com", userAgent: kubectl, path: "/apis/metrics.k8s.io/v1beta1/nodes", warn: true},
+		{name: "subresource", active: true, user: "admin@example.com", userAgent: kubectl, path: "/api/v1/namespaces/default/pods/web/log", warn: true},
+		{name: "watch", active: true, user: "admin@example.com", userAgent: kubectl, path: "/api/v1/namespaces?watch=true", warn: true},
+		{name: "discovery /api", active: true, user: "admin@example.com", userAgent: kubectl, path: "/api"},
+		{name: "discovery /apis", active: true, user: "admin@example.com", userAgent: kubectl, path: "/apis"},
+		{name: "discovery /api/v1", active: true, user: "admin@example.com", userAgent: kubectl, path: "/api/v1"},
+		{name: "discovery group version", active: true, user: "admin@example.com", userAgent: kubectl, path: "/apis/deckhouse.io/v1alpha1"},
+		{name: "openapi v2", active: true, user: "admin@example.com", userAgent: kubectl, path: "/openapi/v2"},
+		{name: "openapi v3", active: true, user: "admin@example.com", userAgent: kubectl, path: "/openapi/v3/apis/apps/v1?hash=0123"},
+		{name: "version", active: true, user: "admin@example.com", userAgent: kubectl, path: "/version"},
+		{name: "no request info", active: true, user: "admin@example.com", userAgent: kubectl, noInfo: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			active.Store(tc.active)
+			var got recorder
+			ctx := warning.WithWarningRecorder(context.Background(), &got)
+			if tc.user != "" {
+				ctx = request.WithUser(ctx, &user.DefaultInfo{Name: tc.user})
+			}
+			path := tc.path
+			if path == "" {
+				path = "/api/v1/namespaces"
+			}
+			req := httptest.NewRequest(http.MethodGet, path, nil)
+			if !tc.noInfo {
+				info, err := resolver.NewRequestInfo(req)
+				if err != nil {
+					t.Fatalf("NewRequestInfo: %v", err)
+				}
+				ctx = request.WithRequestInfo(ctx, info)
+			}
+			req = req.WithContext(ctx)
+			req.Header.Set("User-Agent", tc.userAgent)
+
+			called := false
+			WithWarning(http.HandlerFunc(func(http.ResponseWriter, *http.Request) { called = true })).ServeHTTP(httptest.NewRecorder(), req)
+
+			if !called {
+				t.Fatal("the wrapped handler was not called")
+			}
+			if tc.warn && (len(got) != 1 || got[0] != Message) {
+				t.Errorf("warnings = %q, want exactly %q", got, Message)
+			}
+			if !tc.warn && len(got) != 0 {
+				t.Errorf("warnings = %q, want none", got)
+			}
+		})
+	}
+}
