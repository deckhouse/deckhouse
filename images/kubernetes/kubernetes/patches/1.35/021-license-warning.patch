+
+// Package licensewarning is a Deckhouse addition: while the Deckhouse
+// EffectiveLicense object asks for it, kube-apiserver adds a license warning
+// to the resource responses of every user who is not a system: one.
+package licensewarning
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/util/wait"
+	"k8s.io/apiserver/pkg/endpoints/request"
+	"k8s.io/apiserver/pkg/warning"
+	"k8s.io/client-go/dynamic"
+	"k8s.io/klog/v2"
+)
+
+// Message is the warning text, kubectl prints it to stderr.
+const Message = "Deckhouse: the cluster does not have enough licenses. Please add licenses."
+
+const (
+	objectName       = "deckhouse-platform"
+	pollInterval     = time.Minute
+	requestTimeout   = 10 * time.Second
+	errorLogInterval = 10 * time.Minute
+)
+
+var gvr = schema.GroupVersionResource{Group: "deckhouse.io", Version: "v1alpha1", Resource: "effectivelicenses"}
+
+// skippedUserAgentPrefix is dhctl: it works under the admin kubeconfig (user
+// kubernetes-admin, not system:), makes hundreds of requests per run and would
+// only write the warning to its log on every one. Everyone else gets the
+// warning, so kubectl under any name, GUIs and curl need no list.
+const skippedUserAgentPrefix = "dhctl/"
+
+// active is the last known status.apiWarning, written by Run and read by WithWarning.
+var active atomic.Bool
+
+// Run reads status.apiWarning of the EffectiveLicense object every minute until ctx is done.
+// The first read waits a full interval: right after start the CRD informer is not
+// synced yet and the apiserver answers 503 instead of 404.
+func Run(ctx context.Context, client dynamic.Interface) {
+	var lastErrorLog time.Time
+	_ = wait.PollUntilContextCancel(ctx, pollInterval, false, func(ctx context.Context) (bool, error) {
+		if err := poll(ctx, client); err != nil && time.Since(lastErrorLog) >= errorLogInterval {
+			lastErrorLog = time.Now()
+			klog.ErrorS(err, "licensewarning: failed to read EffectiveLicense, keeping the last known state", "name", objectName, "active", active.Load())
+		}
+		return false, nil
+	})
+}
+
+func poll(ctx context.Context, client dynamic.Interface) error {
+	ctx, cancel := context.WithTimeout(ctx, requestTimeout)
+	defer cancel()
+
+	warn := false
+	obj, err := client.Resource(gvr).Get(ctx, objectName, metav1.GetOptions{})
+	switch {
+	case apierrors.IsNotFound(err):
+		// No CRD or no object: licensing is not installed, or the cluster is not bootstrapped yet.
+	case err != nil:
+		return err
+	default:
+		warn, _, _ = unstructured.NestedBool(obj.Object, "status", "apiWarning")
+	}
+	if active.Swap(warn) != warn {
+		klog.InfoS("licensewarning: state changed", "active", warn)
+	}
+	return nil
+}
+
+// WithWarning adds Message to the response of a resource request when the
+// license warning is active and the user is not a system: one (service
+// accounts, nodes, control plane components), unless the client is dhctl.
+// It must run after authentication and impersonation, inside the warning recorder.
+//
+// Non-resource requests are skipped: clients cache discovery and OpenAPI
+// responses with all headers and keep the stored warning on 304, so it would
+// outlive the license problem. Resource responses are never cached.
+func WithWarning(handler http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		if active.Load() && !strings.HasPrefix(req.UserAgent(), skippedUserAgentPrefix) {
+			info, isInfo := request.RequestInfoFrom(req.Context())
+			u, isUser := request.UserFrom(req.Context())
+			if isInfo && info.IsResourceRequest && isUser && !strings.HasPrefix(u.GetName(), "system:") {
+				warning.AddWarning(req.Context(), "", Message)
+			}
+		}
+		handler.ServeHTTP(w, req)
+	})
+}
