+limitations under the License.
+*/
+
+package scopefilter
+
+import (
+	"k8s.io/component-base/metrics"
+	"k8s.io/component-base/metrics/legacyregistry"
+)
+
+// Metrics of the filter. A failure to get the allowed set is answered with 403,
+// or 503 while the permission service cannot answer, and an open watch that
+// cannot refresh its set keeps the previous one, so both have to be visible
+// without reading logs. The labels are bounded: an operation name, a failure
+// reason and a close reason.
+var (
+	allowedSetFailures = metrics.NewCounterVec(
+		&metrics.CounterOpts{
+			Namespace:      "apiserver",
+			Subsystem:      "scopefilter",
+			Name:           "allowed_set_failures_total",
+			Help:           "Requests answered with an error because the allowed set of namespaces could not be resolved, by operation (list, get, watch) and reason (unavailable: the permission service timed out or answered 429 or 5xx, answered with 503; denied: any other failure, answered with 403).",
+			StabilityLevel: metrics.ALPHA,
+		},
+		[]string{"operation", "reason"},
+	)
+
+	clusterDisagreements = metrics.NewCounter(
+		&metrics.CounterOpts{
+			Namespace:      "apiserver",
+			Subsystem:      "scopefilter",
+			Name:           "cluster_disagreements_total",
+			Help:           "Requests kube-apiserver denied while the permission service allowed them in the whole cluster; they are answered with 403.",
+			StabilityLevel: metrics.ALPHA,
+		},
+	)
+
+	watchRefreshFailures = metrics.NewCounter(
+		&metrics.CounterOpts{
+			Namespace:      "apiserver",
+			Subsystem:      "scopefilter",
+			Name:           "watch_refresh_failures_total",
+			Help:           "Failed refreshes of the allowed set of an open filtered watch, timeouts included; until the watch closes it keeps the previous set.",
+			StabilityLevel: metrics.ALPHA,
+		},
+	)
+
+	watchClosed = metrics.NewCounterVec(
+		&metrics.CounterOpts{
+			Namespace:      "apiserver",
+			Subsystem:      "scopefilter",
+			Name:           "watch_closed_total",
+			Help:           "Filtered watches closed by the filter, by reason (refresh_failures: the allowed set could not be refreshed for the limit; overflow: the client did not keep up; multitenancy_disabled: the project scopes are not served any more; access_changed: the caller may now do it in the whole cluster).",
+			StabilityLevel: metrics.ALPHA,
+		},
+		[]string{"reason"},
+	)
+)
+
+func init() {
+	legacyregistry.MustRegister(allowedSetFailures, clusterDisagreements, watchRefreshFailures, watchClosed)
+}
