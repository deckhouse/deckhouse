+// TestDecorator_List_AppliesPostRead pins the read-time-defaulting contract
+// from review: the vanilla Store.List applies the store's post-read
+// decoration hook (Services'/PVCs' defaultOnRead) AFTER ListPredicate, and
+// the filtering List path replaces exactly that stretch of Store.List -- so
+// it must re-apply the hook itself, or a scoped listing would return a
+// different object representation than a plain one.
+func TestDecorator_List_AppliesPostRead(t *testing.T) {
+	store := newFakeStore()
+	store.put("ns-a", "pod-1")
+
+	var decorated []runtime.Object
+	d := &scopefilter.Decorator{
+		Store:          store,
+		BuildPredicate: store.buildPredicate,
+		Resource:       schema.GroupVersionResource{Group: "", Version: "v1", Resource: "pods"},
+		Mode:           scopefilter.IdentityByNamespace,
+		Classify: &fakeClassify{byKind: map[scopefilter.Kind]map[string]struct{}{
+			scopefilter.KindSystem: {"ns-a": {}},
+		}},
+		RBACFloor:  &fakeFloor{allowed: map[string]map[string]struct{}{"pods/list": {"ns-a": {}}}},
+		Accessible: &fakeAccessible{names: []string{"ns-a"}},
+		PostRead:   func(obj runtime.Object) { decorated = append(decorated, obj) },
+	}
+
+	ctx := genericapirequest.WithUser(genericapirequest.NewContext(), &user.DefaultInfo{Name: "alice"})
+	ctx = scopefilter.WithRequest(ctx, scopefilter.Request{Kind: scopefilter.KindSystem})
+	ctx = scopefilter.WithBypass(ctx)
+
+	out, err := d.List(ctx, nil)
+	if err != nil {
+		t.Fatalf("List: %v", err)
+	}
+	if len(decorated) != 1 || decorated[0] != out {
+		t.Fatalf("PostRead was not applied exactly once to the returned list (calls: %d)", len(decorated))
+	}
+}
