+// TestWithAuthorization_ScopeAuditAnnotations pins the audit annotations of
+// the answers of the filter: an allowed request keeps the upstream pair, and a
+// denied read let through for the filter -- a scoped read of a registered
+// resource, or a read of namespaces -- records why it was let through.
+func TestWithAuthorization_ScopeAuditAnnotations(t *testing.T) {
+	registered := schema.GroupResource{Resource: "widgets"}
+	scopefilter.Register(registered)
+	t.Cleanup(func() { scopefilter.Unregister(registered) })
+	namespaces := schema.GroupResource{Resource: "namespaces"}
+	scopefilter.Register(namespaces)
+	t.Cleanup(func() { scopefilter.Unregister(namespaces) })
+
+	scheme := runtime.NewScheme()
+	negotiatedSerializer := serializer.NewCodecFactory(scheme).WithoutConversion()
+
+	tests := []struct {
+		name         string
+		authz        fakeAuthorizer
+		path         string
+		header       string
+		wantDecision string
+		wantReason   string
+	}{
+		{
+			name:         "allowed request",
+			authz:        fakeAuthorizer{authorizer.DecisionAllow, "allowed for test", nil},
+			path:         "/api/v1/widgets",
+			header:       "system",
+			wantDecision: "allow",
+			wantReason:   "allowed for test",
+		},
+		{
+			name:         "denied scoped read let through for the filter",
+			authz:        denyAllAuthorizer(),
+			path:         "/api/v1/widgets",
+			header:       "accessible",
+			wantDecision: "allow-scoped",
+			wantReason:   "scope filtering mode",
+		},
+		{
+			name:         "denied read of namespaces let through for the filter",
+			authz:        denyAllAuthorizer(),
+			path:         "/api/v1/namespaces",
+			wantDecision: "allow-filtered",
+			wantReason:   "namespace filtering mode",
+		},
+		{
+			name:         "denied scoped read of a resource without the filter",
+			authz:        denyAllAuthorizer(),
+			path:         "/api/v1/gadgets",
+			header:       "accessible",
+			wantDecision: "forbid",
+			wantReason:   "denied for test",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			sink := &fakeAuditSink{}
+			handler := WithAudit(
+				WithAuthorization(&scopeTestHandler{}, tt.authz, negotiatedSerializer),
+				sink,
+				policy.NewFakePolicyRuleEvaluator(auditinternal.LevelMetadata, nil),
+				nil,
+			)
+			handler.ServeHTTP(httptest.NewRecorder(), newScopeTestRequest(t, http.MethodGet, tt.path, tt.header))
+
+			events := sink.Events()
+			if len(events) == 0 {
+				t.Fatal("no audit event was written")
+			}
+			annotations := events[len(events)-1].Annotations
+			if got := annotations["authorization.k8s.io/decision"]; got != tt.wantDecision {
+				t.Errorf("decision annotation = %q, want %q", got, tt.wantDecision)
+			}
+			if got := annotations["authorization.k8s.io/reason"]; got != tt.wantReason {
+				t.Errorf("reason annotation = %q, want %q", got, tt.wantReason)
+			}
+		})
+	}
+}
