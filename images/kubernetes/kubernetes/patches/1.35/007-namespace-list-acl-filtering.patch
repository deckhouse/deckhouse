+// TestLoopbackMultitenancyStateResolver reads the state of
+// multitenancy-manager from the ConfigMap of user-authz: only an explicit
+// "false" disables the project scopes; a missing ConfigMap or key is unknown
+// and changes nothing.
+func TestLoopbackMultitenancyStateResolver(t *testing.T) {
+	tests := []struct {
+		name         string
+		configMap    *corev1.ConfigMap
+		wantDisabled bool
+	}{
+		{name: "disabled", configMap: multitenancyState(map[string]string{"multitenancyManagerEnabled": "false"}), wantDisabled: true},
+		{name: "enabled", configMap: multitenancyState(map[string]string{"multitenancyManagerEnabled": "true"})},
+		{name: "no key", configMap: multitenancyState(map[string]string{"enableMultiTenancy": "true"})},
+		{name: "no ConfigMap"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/api/v1/namespaces/d8-user-authz/configmaps/d8-user-authz-multitenancy-state" || tt.configMap == nil {
+					w.Header().Set("Content-Type", "application/json")
+					w.WriteHeader(http.StatusNotFound)
+					_ = json.NewEncoder(w).Encode(metav1.Status{
+						TypeMeta: metav1.TypeMeta{APIVersion: "v1", Kind: "Status"},
+						Status:   metav1.StatusFailure,
+						Reason:   metav1.StatusReasonNotFound,
+						Code:     http.StatusNotFound,
+					})
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(w).Encode(tt.configMap)
+			}))
+			t.Cleanup(srv.Close)
+
+			resolver, err := scopefilter.NewLoopbackMultitenancyStateResolver(&restclient.Config{Host: srv.URL})
+			if err != nil {
+				t.Fatalf("NewLoopbackMultitenancyStateResolver: %v", err)
+			}
+			disabled, err := resolver.ProjectScopesDisabled(context.Background())
+			if err != nil {
+				t.Fatalf("ProjectScopesDisabled: %v", err)
+			}
+			if disabled != tt.wantDisabled {
+				t.Fatalf("ProjectScopesDisabled = %t, want %t", disabled, tt.wantDisabled)
+			}
+		})
+	}
+}
+
+func multitenancyState(data map[string]string) *corev1.ConfigMap {
+	return &corev1.ConfigMap{
+		TypeMeta:   metav1.TypeMeta{APIVersion: "v1", Kind: "ConfigMap"},
+		ObjectMeta: metav1.ObjectMeta{Namespace: "d8-user-authz", Name: "d8-user-authz-multitenancy-state"},
+		Data:       data,
+	}
+}
