+package filters
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/runtime/serializer"
+	auditinternal "k8s.io/apiserver/pkg/apis/audit"
+	"k8s.io/apiserver/pkg/audit"
+	"k8s.io/apiserver/pkg/audit/policy"
+	"k8s.io/apiserver/pkg/authentication/user"
+	"k8s.io/apiserver/pkg/authorization/authorizer"
+	genericapirequest "k8s.io/apiserver/pkg/endpoints/request"
+	"k8s.io/apiserver/pkg/registry/generic/scopefilter"
+)
+
+// This is "Layer 2" of the design's test plan: unit tests for the generic
+// scope-filtering bypass branch in withAuthorization, isolated from the
+// storage layer entirely (no *genericregistry.Store, no resolvers -- just
+// the HTTP-level gate that decides whether a denied request is handed to
+// the storage layer at all). This is the layer flagged as least covered
+// when the design was written: Layer 1/3 both start from "the filter
+// already decided to bypass" via scopefilter.WithRequest/WithBypass; this
+// file is what actually drives that decision through the real
+// withAuthorization code path.
+
+// scopeTestHandler records whether the wrapped handler ran (bypass fired)
+// and what scopefilter tags its context carried, without touching the
+// storage layer at all.
+type scopeTestHandler struct {
+	called     bool
+	gotRequest scopefilter.Request
+	gotPresent bool
+	gotBypass  bool
+	// gotNamespaceMode: the read was let through for the filter of namespaces.
+	gotNamespaceMode bool
+}
+
+func (h *scopeTestHandler) ServeHTTP(w http.ResponseWriter, req *http.Request) {
+	h.called = true
+	h.gotRequest, h.gotPresent = scopefilter.RequestFrom(req.Context())
+	h.gotBypass = scopefilter.IsBypass(req.Context())
+	h.gotNamespaceMode = scopefilter.IsNamespaceFilteringMode(req.Context())
+	w.WriteHeader(http.StatusOK)
+}
+
+func denyAllAuthorizer() fakeAuthorizer {
+	return fakeAuthorizer{authorizer.DecisionDeny, "denied for test", nil}
+}
+
+// newScopeTestRequest builds a request with a real, path-derived RequestInfo
+// (via the same RequestInfoFactory pattern audit_test.go's withTestContext
+// uses) plus an authenticated user -- everything GetAuthorizerAttributes and
+// isFilteredRequest need, and nothing else.
+func newScopeTestRequest(t *testing.T, method, path, scopeHeader string) *http.Request {
+	t.Helper()
+	req, err := http.NewRequest(method, path, nil)
+	if err != nil {
+		t.Fatalf("NewRequest: %v", err)
+	}
+	if scopeHeader != "" {
+		req.Header.Set(scopefilter.HeaderScope, scopeHeader)
+	}
+
+	info, err := newTestRequestInfoResolver().NewRequestInfo(req)
+	if err != nil {
+		t.Fatalf("NewRequestInfo(%s %s): %v", method, path, err)
+	}
+
+	ctx := audit.WithAuditContext(req.Context())
+	ctx = genericapirequest.WithRequestInfo(ctx, info)
+	ctx = genericapirequest.WithUser(ctx, &user.DefaultInfo{Name: "alice"})
+	return req.WithContext(ctx)
+}
+
+// TestWithAuthorization_GenericScopeBypass is the direct test of
+// isFilteredRequest's gating: a header alone must never be enough. Every
+// negative case here reproduces a specific way a header-gated bypass could
+// accidentally widen beyond its intended (resource, verb, subresource)
+// footprint if isFilteredRequest's checks were loosened.
+func TestWithAuthorization_GenericScopeBypass(t *testing.T) {
+	registered := schema.GroupResource{Resource: "widgets"}
+	scopefilter.Register(registered)
+	t.Cleanup(func() { scopefilter.Unregister(registered) })
+
+	scheme := runtime.NewScheme()
+	negotiatedSerializer := serializer.NewCodecFactory(scheme).WithoutConversion()
+
+	tests := []struct {
+		name       string
+		method     string
+		path       string
+		header     string
+		wantBypass bool
+	}{
+		{
+			name:       "list registered resource with header bypasses",
+			method:     http.MethodGet,
+			path:       "/api/v1/widgets",
+			header:     "system",
+			wantBypass: true,
+		},
+		{
+			name:       "get registered resource with header bypasses",
+			method:     http.MethodGet,
+			path:       "/api/v1/namespaces/ns-a/widgets/foo",
+			header:     "accessible",
+			wantBypass: true,
+		},
+		{
+			name:       "watch registered resource with header bypasses",
+			method:     http.MethodGet,
+			path:       "/api/v1/widgets?watch=true",
+			header:     "projects",
+			wantBypass: true,
+		},
+		{
+			name:       "no header at all never bypasses regardless of resource",
+			method:     http.MethodGet,
+			path:       "/api/v1/widgets",
+			header:     "",
+			wantBypass: false,
+		},
+		{
+			name:       "unregistered resource with header never bypasses",
+			method:     http.MethodGet,
+			path:       "/api/v1/pods", // deliberately not scopefilter.Register'd in this test
+			header:     "system",
+			wantBypass: false,
+		},
+		{
+			name:       "create verb never bypasses even with header",
+			method:     http.MethodPost,
+			path:       "/api/v1/namespaces/ns-a/widgets",
+			header:     "system",
+			wantBypass: false,
+		},
+		{
+			name:       "update (PUT) verb never bypasses",
+			method:     http.MethodPut,
+			path:       "/api/v1/namespaces/ns-a/widgets/foo",
+			header:     "system",
+			wantBypass: false,
+		},
+		{
+			name:       "delete verb never bypasses",
+			method:     http.MethodDelete,
+			path:       "/api/v1/namespaces/ns-a/widgets/foo",
+			header:     "system",
+			wantBypass: false,
+		},
+		{
+			name:       "patch verb never bypasses",
+			method:     http.MethodPatch,
+			path:       "/api/v1/namespaces/ns-a/widgets/foo",
+			header:     "system",
+			wantBypass: false,
+		},
+		{
+			name:       "subresource never bypasses even with header on a registered resource",
+			method:     http.MethodGet,
+			path:       "/api/v1/namespaces/ns-a/widgets/foo/status",
+			header:     "system",
+			wantBypass: false,
+		},
+		{
+			name: "cluster-scoped resource with header never bypasses when not registered " +
+				"(the scope-header wiring skips cluster-scoped resources -- see wireScopeFilter; " +
+				"the one exception, an identity resource, is filtered without a header)",
+			method:     http.MethodGet,
+			path:       "/apis/rbac.authorization.k8s.io/v1/clusterroles",
+			header:     "system",
+			wantBypass: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			handler := &scopeTestHandler{}
+			wrapped := WithAuthorization(handler, denyAllAuthorizer(), negotiatedSerializer)
+			req := newScopeTestRequest(t, tt.method, tt.path, tt.header)
+			w := httptest.NewRecorder()
+			wrapped.ServeHTTP(w, req)
+
+			if tt.wantBypass {
+				if !handler.called {
+					t.Fatalf("expected bypass (handler invoked), got HTTP %d: %s", w.Code, w.Body.String())
+				}
+				if !handler.gotPresent {
+					t.Fatal("handler ran but scopefilter.RequestFrom found nothing on its context")
+				}
+				if !handler.gotBypass {
+					t.Fatal("handler ran but scopefilter.IsBypass is false -- a denied-then-bypassed request must carry it")
+				}
+				return
+			}
+
+			if handler.called {
+				t.Fatal("expected no bypass, but the wrapped handler was invoked anyway")
+			}
+			if w.Code != http.StatusForbidden {
+				t.Fatalf("expected 403 Forbidden, got %d: %s", w.Code, w.Body.String())
+			}
+		})
+	}
+}
