+// TestDecorator_Watch_NoRestriction_DegradesToPlainWatchPredicate covers the
+// "fully privileged caller passing --scope=accessible" degenerate case: no
+// classification (accessible is a no-op) and no floor (never denied, so
+// never bypassed) must mean the FilteredWatch wrapper is skipped entirely.
+// TestDecorator_Nil_RefusesAReadLetThroughForTheFilter: a storage without the
+// filter serves a plain request as upstream does, but refuses a read the
+// authorization filter let through for the filter -- one that can reach it
+// only on a stale registration -- instead of serving it unfiltered.
+func TestDecorator_Nil_RefusesAReadLetThroughForTheFilter(t *testing.T) {
+	var d *scopefilter.Decorator
+	base := genericapirequest.WithRequestInfo(context.Background(), &genericapirequest.RequestInfo{
+		IsResourceRequest: true, APIGroup: "example.io", Resource: "foos", Verb: "list",
+	})
+	rawGet := func(context.Context, string, *metav1.GetOptions) (runtime.Object, error) {
+		t.Fatal("the unfiltered read must not run")
+		return nil, nil
+	}
+
+	if d.Engaged(base) {
+		t.Fatal("a plain request engages a nil decorator, want upstream behavior")
+	}
+	for name, ctx := range map[string]context.Context{
+		"bypassed":           scopefilter.WithBypass(base),
+		"namespace-filtered": scopefilter.WithNamespaceFilteringMode(base),
+	} {
+		t.Run(name, func(t *testing.T) {
+			if !d.Engaged(ctx) {
+				t.Fatal("a read let through for the filter does not engage a nil decorator")
+			}
+			if _, err := d.List(ctx, nil); !apierrors.IsForbidden(err) {
+				t.Fatalf("List: %v, want Forbidden", err)
+			}
+			if _, err := d.Get(ctx, "foo", &metav1.GetOptions{}, rawGet); !apierrors.IsForbidden(err) {
+				t.Fatalf("Get: %v, want Forbidden", err)
+			}
+			if _, err := d.Watch(ctx, nil); !apierrors.IsForbidden(err) {
+				t.Fatalf("Watch: %v, want Forbidden", err)
+			}
+		})
+	}
+}
