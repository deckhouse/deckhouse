+// TestIntegration_Floor_EvaluatesTheSubresource: the floor asks about the
+// subresource the request names, so a permission on pods does not stand in for
+// one on pods/status.
+func TestIntegration_Floor_EvaluatesTheSubresource(t *testing.T) {
+	srv := newFakeLoopbackServer(t, nil, []string{"ns-a", "ns-b"}, []accessRule{
+		{namespace: "ns-a", resource: "pods", verb: "get", allowed: true},
+		{namespace: "ns-b", resource: "pods", verb: "get", allowed: true},
+		{namespace: "ns-b", resource: "pods", subresource: "status", verb: "get", allowed: true},
+	})
+	cfg := &restclient.Config{Host: srv.URL}
+	floor, err := scopefilter.NewLoopbackRBACFloorResolver(cfg)
+	if err != nil {
+		t.Fatalf("NewLoopbackRBACFloorResolver: %v", err)
+	}
+	pods := schema.GroupVersionResource{Version: "v1", Resource: "pods"}
+	alice := &user.DefaultInfo{Name: "alice"}
+
+	resource, err := floor.Resolve(context.Background(), alice, pods, "", "get")
+	if err != nil {
+		t.Fatalf("Resolve(pods): %v", err)
+	}
+	if len(resource) != 2 {
+		t.Fatalf("pods floor = %v, want ns-a and ns-b", resource)
+	}
+	status, err := floor.Resolve(context.Background(), alice, pods, "status", "get")
+	if err != nil {
+		t.Fatalf("Resolve(pods/status): %v", err)
+	}
+	if _, ok := status["ns-b"]; !ok || len(status) != 1 {
+		t.Fatalf("pods/status floor = %v, want ns-b only", status)
+	}
+}
