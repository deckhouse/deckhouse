+
+// filteredWatchBufferSize controls the per-watch buffered channel that merges
+// events coming from the underlying storage watch with events synthesized by
+// the ACL poller. Sized to absorb a full re-list during a steady-state ACL
+// rotation; on overflow the watch errors out and the client is expected to
+// reconnect with a fresh LIST. Mirrors OpenShift's pkg/project/auth/watch.go
+// (1000).
+const filteredWatchBufferSize = 1000
+
+var errChannelOverflow = errors.New("scopefilter: filtered watch outgoing channel overflow; reconnect")
+
+// watchRefreshFailureLimit is how long an open watch keeps serving its last
+// allowed set while every refresh of the set fails. After that the watch is
+// closed: a list in the same situation is already answered with 403, and a
+// watch must not outlive it on a set nobody can confirm any more. The value is
+// fixed; tests shorten it through export_test.go.
+var watchRefreshFailureLimit = 60 * time.Second
+
+// IdentityMode selects how FilteredWatch maps a watched object to the
+// (namespace-set key, item key) pair its ACL-diffing logic operates on.
+type IdentityMode int
+
+const (
+	// IdentityByName is for the one case where the listed resource IS the
+	// identity being classified: Namespace listing Namespace. nsKey and
+	// itemKey are both the object's own name.
+	IdentityByName IdentityMode = iota
+
+	// IdentityByNamespace is the generic case: nsKey is the object's
+	// metadata.namespace, itemKey is its metadata.name. A single ACL
+	// change (one namespace gained/lost) can therefore gain or lose many
+	// items at once.
+	IdentityByNamespace
+)
+
+func identityOf(mode IdentityMode, obj runtime.Object) (nsKey, itemKey string, ok bool) {
+	accessor, err := meta.Accessor(obj)
+	if err != nil {
+		return "", "", false
+	}
+	if mode == IdentityByName {
+		n := accessor.GetName()
+		return n, n, true
+	}
+	return accessor.GetNamespace(), accessor.GetName(), true
+}
+
+// WatchConfig groups the dependencies of a FilteredWatch. All fields are
+// required unless documented otherwise.
+type WatchConfig struct {
+	// Inner is the storage-layer watch, already filtered through the live
+	// Selector via a SelectionPredicate. FilteredWatch takes ownership and
+	// calls Stop() on it.
+	Inner watch.Interface
+
+	// Selector is the live NameSetSelector whose allowed-value set is
+	// updated on every poll tick. Shared with the SelectionPredicate
+	// passed to Inner; updates are seen by both immediately.
+	Selector *NameSetSelector
+
+	// Mode selects the identity-extraction strategy (see IdentityMode).
+	Mode IdentityMode
+
+	// Store performs the Get (IdentityByName) or ListPredicate
+	// (IdentityByNamespace) calls used to materialize objects for
+	// synthesized ADDED events, and New() for building DELETED stubs.
+	Store StoreAccessor
+
+	// BuildPredicate mirrors Decorator.BuildPredicate -- the resource's
+	// registered predicate-construction function, needed to build a
+	// correctly-attributed SelectionPredicate when IdentityByNamespace mode
+	// lists a newly-gained namespace's contents.
+	BuildPredicate func(label labels.Selector, field fields.Selector) storage.SelectionPredicate
+
+	// PostRead mirrors Decorator.PostRead -- the store's post-read
+	// decoration hook, applied to the list fetched when materializing
+	// synthesized ADDED events so they carry the same object representation
+	// (e.g. Services'/PVCs' read-time defaulting) as storage-pump events,
+	// which the store already decorates itself. Nil when the resource has
+	// no decoration hook.
+	PostRead func(runtime.Object)
+
+	// CallerLabel / CallerField are the requesting client's own selectors
+	// (from the original List/Watch call), reused via BuildPredicate when
+	// IdentityByNamespace mode lists a newly-gained namespace's contents.
+	// Unused in IdentityByName mode. Nil means "no selector", matching
+	// fields.Everything()/labels.Everything() semantics.
+	CallerLabel labels.Selector
+	CallerField fields.Selector
+
+	// Poll returns the current combined allowed namespace/name set (e.g.
+	// classification ∩ RBAC floor, or plain accessible namespaces --
+	// FilteredWatch does not care which). Called once per refresh tick.
+	Poll func(ctx context.Context) (map[string]struct{}, error)
+
+	// Initial is the allowed set at watch-open, used to seed the ACL
+	// diff baseline so the first poll tick does not treat namespaces the
+	// inner watch is about to (or already did) replay as newly "gained".
+	Initial map[string]struct{}
+
+	// ResourceVersion is the resourceVersion the watch was opened from, if
+	// any. A concrete one is a version the client already has, so a DELETED
+	// synthesized before the first storage event carries it.
+	ResourceVersion string
+
+	// RefreshInterval governs how often the poller wakes up. A value <=0
+	// disables polling entirely (storage events still flow).
+	RefreshInterval time.Duration
+
+	// UserName identifies the watching client, for logging only.
+	UserName string
+}
+
+// FilteredWatch wraps a storage-layer watch.Interface and merges in
+// synthetic events derived from changes to a dynamically-computed allowed
+// namespace/name set (an "ACL" in the broad sense: could be
+// accessible namespaces, a classification ∩ RBAC-floor intersection, or
+// anything else Poll computes).
+//
+// Architecture mirrors OpenShift's userProjectWatcher:
+//
+//   - The underlying storage watch is started with a SelectionPredicate
+//     containing a live NameSetSelector. The selector's atomic state is
+//     updated on every poll tick, so storage-layer events for
+//     now-inaccessible namespaces/names are silently dropped at the
+//     predicate layer -- no extra round-trips, no work in the cacher.
+//
+//   - In parallel, this wrapper polls Poll every RefreshInterval (typically
+//     1s). On each tick it diffs the result against the last-known allowed
+//     set and synthesizes events for the change:
+//
+//   - IdentityByName (namespaces): a single Get materializes the one
+//     gained object; a stub carrying only its name is emitted for a lost
+//     one.
+//
+//   - IdentityByNamespace (generic resources): a namespace-scoped List
+//     (via Store.ListPredicate, reusing the caller's own label/field
+//     selectors) materializes every item newly visible in a gained
+//     namespace; stubs are emitted for every item previously surfaced
+//     from a lost namespace (see knownItems below) and every item the
+//     same List finds there now, which covers what the client's own LIST
+//     returned before the watch.
+//
+//   - All events -- pass-through from storage and synthetic from the
+//     poller -- are funneled through a single buffered channel and emitted
+//     to the client in arrival order.
+//
+//   - On unrecoverable failure (channel overflow, inner watch closure) the
+//     watch emits a watch.Error, stops itself, and closes the outgoing
+//     channel -- clients ranging over ResultChan() unblock cleanly and let
+//     their reflector reconnect.
+type FilteredWatch struct {
+	inner          watch.Interface
+	selector       *NameSetSelector
+	mode           IdentityMode
+	store          StoreAccessor
+	buildPredicate func(label labels.Selector, field fields.Selector) storage.SelectionPredicate
+	postRead       func(runtime.Object)
+
+	callerLabel labels.Selector
+	callerField fields.Selector
+
+	poll            func(ctx context.Context) (map[string]struct{}, error)
+	refreshInterval time.Duration
+	userName        string
+
+	// failureLimit is watchRefreshFailureLimit as of construction.
+	failureLimit time.Duration
+	// failingSince is when the first of the current run of failed refreshes
+	// started; zero while the last refresh succeeded. Touched only by the ACL
+	// poller goroutine.
+	failingSince time.Time
+
+	outgoing chan watch.Event
+
+	// mu guards knownACL, knownItems, deleted and lastResourceVersion.
+	mu sync.Mutex
+	// knownACL is the allowed namespace/name set as of the last poll tick
+	// (or Initial, before the first tick). Drives gained/lost diffing.
+	knownACL map[string]struct{}
+	// knownItems maps nsKey -> the set of itemKeys surfaced to the client
+	// under that key and not yet retracted. In IdentityByName mode this
+	// always collapses to knownItems[n] == {n: {}}. Source of truth for
+	// ADDED-vs-MODIFIED demotion and for exactly which stubs to emit as
+	// DELETED when a namespace is lost.
+	knownItems map[string]map[string]struct{}
+	// deleted holds, in IdentityByName mode, the names a storage event
+	// deleted while they were allowed: the client got their DELETED, so
+	// losing access to them later sends none.
+	deleted map[string]struct{}
+	// lastResourceVersion is the resourceVersion of the latest storage event
+	// of this watch, bookmarks included, or the one the watch was opened
+	// from before the first of them. Storage events arrive in
+	// resourceVersion order, so it is also the highest one seen. A DELETED
+	// synthesized for lost access carries it, so a client's resourceVersion
+	// keeps moving forward.
+	lastResourceVersion string
+
+	stopOnce sync.Once
+	stopCh   chan struct{}
+	cancel   context.CancelFunc
+	senders  sync.WaitGroup
+}
+
+// NewFilteredWatch wires together a storage watch with an ACL poller. The
+// returned watch owns cfg.Inner and will Stop() it when the watch ends.
+func NewFilteredWatch(parentCtx context.Context, cfg WatchConfig) *FilteredWatch {
+	ctx, cancel := context.WithCancel(parentCtx)
+
+	known := make(map[string]struct{}, len(cfg.Initial))
+	for n := range cfg.Initial {
+		known[n] = struct{}{}
+	}
+	// "" and "0" name no version the client has: any, and the cache's.
+	startingResourceVersion := cfg.ResourceVersion
+	if startingResourceVersion == "0" {
+		startingResourceVersion = ""
+	}
+
+	w := &FilteredWatch{
+		inner:           cfg.Inner,
+		selector:        cfg.Selector,
+		mode:            cfg.Mode,
+		store:           cfg.Store,
+		buildPredicate:  cfg.BuildPredicate,
+		postRead:        cfg.PostRead,
+		callerLabel:     cfg.CallerLabel,
+		callerField:     cfg.CallerField,
+		poll:            cfg.Poll,
+		refreshInterval: cfg.RefreshInterval,
+		userName:        cfg.UserName,
+		failureLimit:    watchRefreshFailureLimit,
+		outgoing:        make(chan watch.Event, filteredWatchBufferSize),
+		knownACL:        known,
+		knownItems:      make(map[string]map[string]struct{}),
+		deleted:         make(map[string]struct{}),
+		stopCh:          make(chan struct{}),
+		cancel:          cancel,
+
+		lastResourceVersion: startingResourceVersion,
+	}
+
+	w.senders.Add(2)
+	go w.runStoragePump(ctx)
+	go w.runACLPoller(ctx)
+	go w.closeWhenDone()
+
+	return w
+}
+
+// ResultChan implements watch.Interface.
+func (w *FilteredWatch) ResultChan() <-chan watch.Event {
+	return w.outgoing
+}
+
+// Stop implements watch.Interface. Idempotent.
+func (w *FilteredWatch) Stop() {
+	w.stopOnce.Do(func() {
+		// Cancel first so background goroutines unblock from their
+		// selects before we tear down the inner watch.
+		w.cancel()
+		w.inner.Stop()
+		close(w.stopCh)
+	})
+}
+
+// closeWhenDone waits for both sender goroutines (storage pump and ACL
+// poller) to finish, then closes the outgoing channel exactly once -- the
+// canonical "single closer" pattern, guaranteeing no send-on-closed-channel
+// panic.
+func (w *FilteredWatch) closeWhenDone() {
+	w.senders.Wait()
+	close(w.outgoing)
+}
+
+// runStoragePump forwards events from the underlying storage watch into the
+// outgoing channel, maintaining knownItems so subsequent ACL diffs make
+// correct ADDED/DELETED decisions.
+func (w *FilteredWatch) runStoragePump(ctx context.Context) {
+	defer utilruntime.HandleCrash()
+	defer w.senders.Done()
+	defer w.Stop()
+
+	in := w.inner.ResultChan()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case ev, ok := <-in:
+			if !ok {
+				// Inner watch closed (etcd disconnect, server
+				// shutdown). Propagate by stopping ourselves;
+				// client will reconnect with a fresh LIST.
+				return
+			}
+			// The event is sent under the lock it was checked against
+			// the allowed set with: a refresh swaps the set under it too,
+			// so an event either goes out before the swap - and the
+			// DELETED of its lost namespace after it - or is dropped. It
+			// never follows that DELETED. emit does not block.
+			w.mu.Lock()
+			ev, send := w.observeStorageEvent(ev)
+			sent := !send || w.emit(ev)
+			w.mu.Unlock()
+			if !sent {
+				return
+			}
+		}
+	}
+}
+
+// observeStorageEvent records the resourceVersion of a storage event, updates
+// knownItems for an event the predicate just let through and returns a
+// (possibly mutated) event for emission, or false when the event must not be
+// sent at all. The caller holds w.mu.
+//
+// The predicate matched the event against the allowed set as it was when the
+// storage layer evaluated it. If the set has narrowed since -- the event was
+// in flight while a refresh retracted its namespace -- the event is dropped:
+// the client already got the synthesized DELETED, and the item must not come
+// back.
+//
+// The event type is demoted from ADDED to MODIFIED if the item was already
+// known -- this happens, very rarely, when the ACL poller synthesized an ADDED
+// for the same item at almost the same instant a real etcd CREATE event for
+// it crossed the predicate. We never emit two ADDEDs for the same item without
+// an intervening DELETED.
+func (w *FilteredWatch) observeStorageEvent(ev watch.Event) (watch.Event, bool) {
+	if ev.Object == nil || ev.Type == watch.Error {
+		return ev, true
+	}
+
+	if accessor, err := meta.Accessor(ev.Object); err == nil {
+		if rv := accessor.GetResourceVersion(); rv != "" {
+			w.lastResourceVersion = rv
+		}
+	}
+	if ev.Type == watch.Bookmark {
+		return ev, true
+	}
+
+	nsKey, itemKey, ok := identityOf(w.mode, ev.Object)
+	if !ok {
+		return ev, true
+	}
+	if _, allowed := w.knownACL[nsKey]; !allowed {
+		klog.V(4).InfoS("scopefilter: dropping storage event outside the allowed set", "user", w.userName, "type", ev.Type, "namespace", nsKey, "name", itemKey)
+		return ev, false
+	}
+
+	switch ev.Type {
+	case watch.Added:
+		items := w.knownItems[nsKey]
+		if items == nil {
+			items = make(map[string]struct{})
+			w.knownItems[nsKey] = items
+		}
+		if _, already := items[itemKey]; already {
+			ev.Type = watch.Modified
+		}
+		items[itemKey] = struct{}{}
+		delete(w.deleted, nsKey)
+	case watch.Modified:
+		items := w.knownItems[nsKey]
+		if items == nil {
+			items = make(map[string]struct{})
+			w.knownItems[nsKey] = items
+		}
+		items[itemKey] = struct{}{}
+	case watch.Deleted:
+		if items, present := w.knownItems[nsKey]; present {
+			delete(items, itemKey)
+			if len(items) == 0 {
+				delete(w.knownItems, nsKey)
+			}
+		}
+		if w.mode == IdentityByName {
+			w.deleted[nsKey] = struct{}{}
+		}
+	}
+	return ev, true
+}
+
+// runACLPoller periodically re-evaluates Poll and synthesizes ADDED/DELETED
+// events for the diff against knownACL. The constructor seeds knownACL from
+// Initial, so the first poll iteration sees no diff in the steady state and
+// only acts on subsequent changes.
+func (w *FilteredWatch) runACLPoller(ctx context.Context) {
+	defer utilruntime.HandleCrash()
+	defer w.senders.Done()
+	defer w.Stop()
+
+	if w.refreshInterval <= 0 {
+		// Misconfigured: a 0/negative interval would spin. Park the
+		// goroutine until shutdown; the storage pump still works, ACL
+		// changes won't be reflected until the client reconnects.
+		<-ctx.Done()
+		return
+	}
+
+	ticker := time.NewTicker(w.refreshInterval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			if !w.tickACL(ctx) {
+				return
+			}
+		}
+	}
+}
+
+// tickACL performs one ACL poll iteration. Returns false if the watch must
+// be torn down (e.g. on emit overflow, or after refreshes failed for
+// failureLimit).
+func (w *FilteredWatch) tickACL(ctx context.Context) bool {
+	started := time.Now()
+	next, err := w.poll(ctx)
+	if err != nil {
+		if ctx.Err() != nil {
+			// Normal teardown: the watch itself is ending.
+			return true
+		}
+		if w.refreshRefused(err) {
+			return false
+		}
+		return w.refreshFailed(started, err)
+	}
+	w.failingSince = time.Time{}
+
+	w.selector.Update(next)
+
+	w.mu.Lock()
+	gained, lost := DiffNameSets(next, w.knownACL)
+	w.knownACL = next
+	w.mu.Unlock()
+
+	for _, ns := range lost {
+		if !w.retract(ctx, ns) {
+			return false
+		}
+	}
+	for _, ns := range gained {
+		if !w.materialize(ctx, ns) {
+			return false
+		}
+	}
+	return true
+}
+
+// refreshRefused handles a refresh that ended with an answer rather than a
+// fault: retrying gets the same answer, so the watch says so and closes at
+// once instead of keeping the previous set for failureLimit:
+//
+//   - the project scopes are not served any more (multitenancy-manager was
+//     disabled): 400, as a new request with the scope gets;
+//   - the permission service allows the request in the whole cluster: the
+//     access of the caller changed since kube-apiserver denied the watch.
+//     410, so the client lists again and the new list is authorized anew.
+//     It is no disagreement of the two chains: their answers are from
+//     different times.
+//
+// It reports whether err was such an answer.
+func (w *FilteredWatch) refreshRefused(err error) bool {
+	var status *metav1.Status
+	var reason string
+	switch {
+	case errors.Is(err, ErrScopeRequiresMultitenancyManager):
+		reason = "multitenancy_disabled"
+		status = &metav1.Status{
+			Status:  metav1.StatusFailure,
+			Message: err.Error(),
+			Reason:  metav1.StatusReasonBadRequest,
+			Code:    http.StatusBadRequest,
+		}
+	case errors.Is(err, ErrClusterWideAccess):
+		reason = "access_changed"
+		status = &metav1.Status{
+			Status:  metav1.StatusFailure,
+			Message: "scopefilter: the caller may now do this in the whole cluster; list again",
+			Reason:  metav1.StatusReasonExpired,
+			Code:    http.StatusGone,
+		}
+	default:
+		return false
+	}
+	watchClosed.WithLabelValues(reason).Inc()
+	klog.V(2).InfoS("scopefilter: closing watch on an answer to the refresh of its allowed set", "user", w.userName, "err", err)
+	w.sendError(status)
+	return true
+}
+
+// refreshFailed handles a refresh of the allowed set that failed, a timeout
+// of the permission service included. The watch keeps the previous set --
+// strictly safer than flipping to deny-everything, which would synthesize
+// spurious DELETEDs across the whole allowed set -- until refreshes have
+// been failing for failureLimit since the first failed one started; then it
+// tells the client why and closes. Returns false if the watch must be torn
+// down.
+func (w *FilteredWatch) refreshFailed(started time.Time, err error) bool {
+	watchRefreshFailures.Inc()
+	if w.failingSince.IsZero() {
+		w.failingSince = started
+	}
+	failingFor := time.Since(w.failingSince)
+	if failingFor < w.failureLimit {
+		klog.Warningf("scopefilter: failed to refresh allowed set for user %q (keeping previous state, failing for %s): %v", w.userName, failingFor.Round(time.Second), err)
+		return true
+	}
+
+	watchClosed.WithLabelValues("refresh_failures").Inc()
+	klog.Warningf("scopefilter: failed to refresh allowed set for user %q for %s; closing watch: %v", w.userName, failingFor.Round(time.Second), err)
+	w.sendError(&metav1.Status{
+		Status:  metav1.StatusFailure,
+		Message: "scopefilter: the allowed set of this watch could not be refreshed for " + w.failureLimit.String() + "; reconnect",
+		Reason:  metav1.StatusReasonServiceUnavailable,
+		Code:    http.StatusServiceUnavailable,
+	})
+	return false
+}
+
+// retract emits DELETED stubs for every item under nsKey the client may hold
+// and clears its bookkeeping. Returns false if the watch must be torn down.
+//
+// The client holds what this stream showed (knownItems), but also what the
+// LIST before it returned: a watch opened from that list's resourceVersion
+// sends no initial events, so those items never reach knownItems. In
+// IdentityByName mode the item is nsKey itself, so its stub is sent unless a
+// storage event deleted it already -- the store's Get cannot tell, it filters
+// by the allowed set nsKey just left. In IdentityByNamespace mode the items
+// nsKey holds now, under the caller's selectors, are retracted as well. A
+// DELETED for an item the client never got is a no-op for it.
+func (w *FilteredWatch) retract(ctx context.Context, nsKey string) bool {
+	var present []runtime.Object
+	if w.mode == IdentityByNamespace {
+		objs, err := w.fetchItems(ctx, nsKey)
+		if err != nil {
+			if ctx.Err() != nil {
+				return true
+			}
+			klog.Warningf("scopefilter: failed to list lost namespace %q for user %q, retracting only the items this watch sent: %v", nsKey, w.userName, err)
+		}
+		present = objs
+	}
+
+	w.mu.Lock()
+	items := w.knownItems[nsKey]
+	delete(w.knownItems, nsKey)
+	_, deleted := w.deleted[nsKey]
+	delete(w.deleted, nsKey)
+	resourceVersion := w.lastResourceVersion
+	w.mu.Unlock()
+
+	keys := make(map[string]struct{}, len(items)+len(present)+1)
+	for itemKey := range items {
+		keys[itemKey] = struct{}{}
+	}
+	if w.mode == IdentityByName && !deleted {
+		keys[nsKey] = struct{}{}
+	}
+	for _, obj := range present {
+		if objNSKey, itemKey, ok := identityOf(w.mode, obj); ok && objNSKey == nsKey {
+			keys[itemKey] = struct{}{}
+		}
+	}
+
+	for _, itemKey := range slices.Sorted(maps.Keys(keys)) {
+		stub := w.newStub(nsKey, itemKey, resourceVersion)
+		klog.V(4).InfoS("scopefilter: synthesizing DELETED for lost access", "user", w.userName, "namespace", nsKey, "name", itemKey)
+		if !w.emit(watch.Event{Type: watch.Deleted, Object: stub}) {
+			return false
+		}
+	}
+	return true
+}
+
+// newStub builds a minimal object carrying only identity fields and the last
+// resourceVersion of the watch, for a synthesized DELETED event where the real
+// object may no longer be retrievable (or, in IdentityByNamespace mode, was
+// never re-fetched).
+func (w *FilteredWatch) newStub(nsKey, itemKey, resourceVersion string) runtime.Object {
+	obj := w.store.New()
+	accessor, err := meta.Accessor(obj)
+	if err != nil {
+		// Unreachable for any real registered type; New() always
+		// returns something meta.Accessor can handle. Fall back to
+		// the bare object rather than panicking.
+		return obj
+	}
+	accessor.SetName(itemKey)
+	if w.mode == IdentityByNamespace {
+		accessor.SetNamespace(nsKey)
+	}
+	accessor.SetResourceVersion(resourceVersion)
+	return obj
+}
+
+// materialize fetches and emits ADDED events for every item newly visible
+// under nsKey. Returns false if the watch must be torn down.
+func (w *FilteredWatch) materialize(ctx context.Context, nsKey string) bool {
+	objs, err := w.fetchItems(ctx, nsKey)
+	if err != nil {
+		if apierrors.IsNotFound(err) {
+			// IdentityByName: the namespace vanished between the ACL
+			// tick and the Get (race with deletion). The client
+			// never saw it as ADDED and never will -- not an error.
+			return true
+		}
+		if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+			return true
+		}
+		klog.Warningf("scopefilter: failed to fetch gained namespace %q for user %q: %v", nsKey, w.userName, err)
+		return true
+	}
+
+	for _, obj := range objs {
+		_, itemKey, ok := identityOf(w.mode, obj)
+		if !ok {
+			continue
+		}
+
+		// Re-check under lock just before emitting: the storage pump
+		// may have raced ahead and already announced this same item
+		// as ADDED (a real etcd CREATE event passing the now-updated
+		// predicate) between us gathering `objs` and arriving here.
+		// Best-effort; a tighter window would require holding the
+		// lock across the fetch, which can be slow.
+		w.mu.Lock()
+		items := w.knownItems[nsKey]
+		if items == nil {
+			items = make(map[string]struct{})
+			w.knownItems[nsKey] = items
+		}
+		if _, already := items[itemKey]; already {
+			w.mu.Unlock()
+			continue
+		}
+		items[itemKey] = struct{}{}
+		w.mu.Unlock()
+
+		klog.V(4).InfoS("scopefilter: synthesizing ADDED for gained access", "user", w.userName, "namespace", nsKey, "name", itemKey)
+		if !w.emit(watch.Event{Type: watch.Added, Object: obj}) {
+			return false
+		}
+	}
+	return true
+}
+
+// fetchItems retrieves the object(s) under nsKey, for a namespace gained or
+// lost: a single Get in IdentityByName mode (nsKey IS the object's name), or
+// a namespace-scoped List reusing the caller's own selectors in
+// IdentityByNamespace mode.
+func (w *FilteredWatch) fetchItems(ctx context.Context, nsKey string) ([]runtime.Object, error) {
+	if w.mode == IdentityByName {
+		obj, err := w.store.Get(ctx, nsKey, &metav1.GetOptions{})
+		if err != nil {
+			return nil, err
+		}
+		return []runtime.Object{obj}, nil
+	}
+
+	nsCtx := genericapirequest.WithNamespace(ctx, nsKey)
+	predicate := w.buildPredicate(w.callerLabel, w.callerField)
+	list, err := w.store.ListPredicate(nsCtx, predicate, &metainternalversion.ListOptions{})
+	if err != nil {
+		return nil, err
+	}
+	// Apply the store's post-read decoration hook exactly where the vanilla
+	// Store.List would: synthesized ADDED events must carry the same object
+	// representation as storage-pump events, which the store decorates
+	// itself.
+	if w.postRead != nil {
+		w.postRead(list)
+	}
+	return meta.ExtractList(list)
+}
+
+// emit pushes an event to the outgoing channel. Returns false if the watch
+// is being torn down or the outgoing buffer overflowed, so callers stop.
+//
+// On overflow we attempt a single non-blocking delivery of a watch.Error so
+// the client learns why their stream just ended; if even that fails (buffer
+// genuinely full, client unresponsive) the error is dropped -- the client
+// will notice anyway when ResultChan closes.
+func (w *FilteredWatch) emit(ev watch.Event) bool {
+	select {
+	case <-w.stopCh:
+		return false
+	case w.outgoing <- ev:
+		return true
+	default:
+		w.sendError(&metav1.Status{
+			Status:  metav1.StatusFailure,
+			Message: errChannelOverflow.Error(),
+			Reason:  metav1.StatusReasonInternalError,
+			Code:    http.StatusInternalServerError,
+		})
+		watchClosed.WithLabelValues("overflow").Inc()
+		klog.Warningf("scopefilter: filtered watch outgoing channel full for user %q; closing watch", w.userName)
+		return false
+	}
+}
+
+// sendError makes a single non-blocking attempt to deliver a watch.Error
+// before the watch closes; if the buffer is full the error is dropped, and
+// the client notices anyway when ResultChan closes.
+func (w *FilteredWatch) sendError(status *metav1.Status) {
+	select {
+	case w.outgoing <- watch.Event{Type: watch.Error, Object: status}:
+	default:
+	}
+}
