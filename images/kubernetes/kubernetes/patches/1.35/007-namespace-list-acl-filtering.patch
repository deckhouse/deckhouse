+// TestWithAuthorization_GenericScopeBypass_RegistersAnUnbuiltCRD covers a CRD
+// whose storage was not built yet, so it is not registered: a denied scoped
+// read asks the registrar to build it instead of answering 403 until some
+// other request reaches the CRD handler.
+func TestWithAuthorization_GenericScopeBypass_RegistersAnUnbuiltCRD(t *testing.T) {
+	gadgets := schema.GroupResource{Group: "example.io", Resource: "gadgets"}
+	t.Cleanup(func() { scopefilter.Unregister(gadgets) })
+
+	scheme := runtime.NewScheme()
+	negotiatedSerializer := serializer.NewCodecFactory(scheme).WithoutConversion()
+
+	var asked []schema.GroupResource
+	unset := scopefilter.SetRegistrar(func(gr schema.GroupResource) bool {
+		asked = append(asked, gr)
+		if gr != gadgets {
+			return false
+		}
+		scopefilter.Register(gr)
+		return true
+	})
+	t.Cleanup(unset)
+
+	serve := func(path string) (*scopeTestHandler, int) {
+		handler := &scopeTestHandler{}
+		wrapped := WithAuthorization(handler, denyAllAuthorizer(), negotiatedSerializer)
+		w := httptest.NewRecorder()
+		wrapped.ServeHTTP(w, newScopeTestRequest(t, http.MethodGet, path, "accessible"))
+		return handler, w.Code
+	}
+
+	handler, code := serve("/apis/example.io/v1/gadgets")
+	if !handler.called || !handler.gotBypass {
+		t.Fatalf("denied scoped read of an unbuilt CRD: got HTTP %d, want the filtered read", code)
+	}
+	if len(asked) != 1 || asked[0] != gadgets {
+		t.Fatalf("registrar asked for %v, want exactly [%v]", asked, gadgets)
+	}
+
+	// Registered now: the registrar is not asked again.
+	if handler, code := serve("/apis/example.io/v1/gadgets"); !handler.called {
+		t.Fatalf("second read: got HTTP %d, want the filtered read", code)
+	}
+	if len(asked) != 1 {
+		t.Fatalf("registrar asked %d times, want once", len(asked))
+	}
+
+	// A resource the registrar cannot build stays a plain 403.
+	if handler, code := serve("/apis/example.io/v1/unknowns"); handler.called || code != http.StatusForbidden {
+		t.Fatalf("unbuildable resource: handler called = %v, HTTP %d, want 403", handler.called, code)
+	}
+
+	// The core group is never served by a CRD: the registrar is not asked.
+	asked = nil
+	if handler, code := serve("/api/v1/pods"); handler.called || code != http.StatusForbidden {
+		t.Fatalf("core resource: handler called = %v, HTTP %d, want 403", handler.called, code)
+	}
+	if len(asked) != 0 {
+		t.Fatalf("registrar asked for %v on a core resource, want no call", asked)
+	}
+}
