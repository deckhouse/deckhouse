+		{ObjectMeta: metav1.ObjectMeta{Name: "team-a-stage", Labels: map[string]string{scopefilter.ProjectLabel: "team-a"}}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "team-b", Labels: map[string]string{scopefilter.ProjectLabel: "team-b"}}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "empty-value", Labels: map[string]string{scopefilter.ProjectLabel: ""}}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "d8-monitoring"}},
