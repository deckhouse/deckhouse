+// TestFilteredWatch_DeletedNameIsNotRetractedAgain: a namespace a storage
+// event deleted while it was allowed got its DELETED from the storage; losing
+// access to it afterwards sends no second one.
+func TestFilteredWatch_DeletedNameIsNotRetractedAgain(t *testing.T) {
+	var mu sync.Mutex
+	current := map[string]struct{}{"ns-a": {}, "ns-b": {}}
+	poll := func(context.Context) (map[string]struct{}, error) {
+		mu.Lock()
+		defer mu.Unlock()
+		return maps.Clone(current), nil
+	}
+
+	store := newFakeStore()
+	inner := newFakeWatch()
+	w := scopefilter.NewFilteredWatch(context.Background(), scopefilter.WatchConfig{
+		Inner:           inner,
+		Selector:        scopefilter.NewNameSetSelector(scopefilter.NameField, map[string]struct{}{"ns-a": {}, "ns-b": {}}),
+		Mode:            scopefilter.IdentityByName,
+		Store:           store,
+		BuildPredicate:  store.buildPredicate,
+		CallerLabel:     labels.Everything(),
+		CallerField:     fields.Everything(),
+		Poll:            poll,
+		Initial:         map[string]struct{}{"ns-a": {}, "ns-b": {}},
+		ResourceVersion: "100",
+		RefreshInterval: 20 * time.Millisecond,
+		UserName:        "alice",
+	})
+	defer w.Stop()
+
+	inner.ch <- watch.Event{Type: watch.Deleted, Object: &fakeItem{ObjectMeta: metav1.ObjectMeta{Name: "ns-b", ResourceVersion: "101"}}}
+	select {
+	case ev := <-w.ResultChan():
+		if ev.Type != watch.Deleted {
+			t.Fatalf("got %s, want the DELETED of ns-b from the storage", ev.Type)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("the storage DELETED of ns-b was not passed through")
+	}
+
+	mu.Lock()
+	delete(current, "ns-b")
+	mu.Unlock()
+	select {
+	case ev := <-w.ResultChan():
+		t.Fatalf("got %s %#v after losing a deleted namespace, want nothing", ev.Type, ev.Object)
+	case <-time.After(300 * time.Millisecond):
+	}
+}
