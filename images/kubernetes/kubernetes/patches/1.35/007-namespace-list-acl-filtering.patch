+// TestWithAuthorization_MalformedScopeHeaderIs400 pins the fail-loud contract
+// for garbage in the scope header namespace: a malformed header on a request
+// the mechanism would engage for (read of a top-level resource) is rejected
+// with 400 for EVERY caller -- before authorization runs. The dangerous
+// alternative this guards against: a privileged backend with a typo'd scope
+// value silently receiving the full unfiltered listing it explicitly asked
+// to narrow. Requests the mechanism ignores by design (mutating verbs,
+// subresources) keep ignoring the headers entirely, malformed or not.
+func TestWithAuthorization_MalformedScopeHeaderIs400(t *testing.T) {
+	registered := schema.GroupResource{Resource: "widgets"}
+	scopefilter.Register(registered)
+	t.Cleanup(func() { scopefilter.Unregister(registered) })
+
+	scheme := runtime.NewScheme()
+	negotiatedSerializer := serializer.NewCodecFactory(scheme).WithoutConversion()
+	allowAll := fakeAuthorizer{authorizer.DecisionAllow, "allowed for test", nil}
+
+	tests := []struct {
+		name          string
+		method        string
+		path          string
+		scopeHeader   string
+		projectHeader string
+		authz         fakeAuthorizer
+		wantCode      int
+	}{
+		{
+			name:        "typo'd scope value from a PRIVILEGED caller is 400, not a silent full listing",
+			method:      http.MethodGet,
+			path:        "/api/v1/widgets",
+			scopeHeader: "projcts", // the typo Ivan's review comment warns about
+			authz:       allowAll,
+			wantCode:    http.StatusBadRequest,
+		},
+		{
+			name:        "typo'd scope value from a denied caller is 400, not a misleading 403",
+			method:      http.MethodGet,
+			path:        "/api/v1/widgets",
+			scopeHeader: "bogus",
+			authz:       denyAllAuthorizer(),
+			wantCode:    http.StatusBadRequest,
+		},
+		{
+			name:          "project header without a scope header is 400",
+			method:        http.MethodGet,
+			path:          "/api/v1/widgets",
+			projectHeader: "team-a",
+			authz:         allowAll,
+			wantCode:      http.StatusBadRequest,
+		},
+		{
+			name:        "scope=project without the project header is 400",
+			method:      http.MethodGet,
+			path:        "/api/v1/widgets",
+			scopeHeader: "project",
+			authz:       allowAll,
+			wantCode:    http.StatusBadRequest,
+		},
+		{
+			name:          "a project header that is not a DNS label is 400",
+			method:        http.MethodGet,
+			path:          "/api/v1/widgets",
+			scopeHeader:   "project",
+			projectHeader: "Team_A",
+			authz:         allowAll,
+			wantCode:      http.StatusBadRequest,
+		},
+		{
+			name:          "a project header longer than a DNS label is 400",
+			method:        http.MethodGet,
+			path:          "/api/v1/widgets",
+			scopeHeader:   "project",
+			projectHeader: strings.Repeat("a", 64),
+			authz:         denyAllAuthorizer(),
+			wantCode:      http.StatusBadRequest,
+		},
+		{
+			name:        "header validity is resource-independent: malformed value 400s even on an unregistered resource",
+			method:      http.MethodGet,
+			path:        "/api/v1/pods", // not Register'd in this test
+			scopeHeader: "bogus",
+			authz:       allowAll,
+			wantCode:    http.StatusBadRequest,
+		},
+		{
+			name:        "mutating request ignores the headers entirely -- malformed value included",
+			method:      http.MethodPost,
+			path:        "/api/v1/namespaces/ns-a/widgets",
+			scopeHeader: "bogus",
+			authz:       denyAllAuthorizer(),
+			wantCode:    http.StatusForbidden, // plain RBAC outcome, no 400
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			handler := &scopeTestHandler{}
+			wrapped := WithAuthorization(handler, tt.authz, negotiatedSerializer)
+			req := newScopeTestRequest(t, tt.method, tt.path, tt.scopeHeader)
+			if tt.projectHeader != "" {
+				req.Header.Set(scopefilter.HeaderProject, tt.projectHeader)
+			}
+			w := httptest.NewRecorder()
+			wrapped.ServeHTTP(w, req)
+
+			if handler.called && tt.wantCode != http.StatusOK {
+				t.Fatalf("expected HTTP %d without reaching the handler, but the handler ran", tt.wantCode)
+			}
+			if w.Code != tt.wantCode {
+				t.Fatalf("HTTP code = %d, want %d (body: %s)", w.Code, tt.wantCode, w.Body.String())
+			}
+		})
+	}
+}
