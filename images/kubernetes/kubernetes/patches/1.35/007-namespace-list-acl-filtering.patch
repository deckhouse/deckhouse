+// ProjectMembershipResolver answers which project each namespace shows. Like
+// ClassificationResolver it is identity-independent -- it describes how the
+// cluster is labeled, not what any user may see -- so one answer is shared by
+// every caller.
+type ProjectMembershipResolver interface {
+	// Resolve returns namespace name -> the name of the project it shows
+	// (projectOf), for every namespace.
+	Resolve(ctx context.Context) (map[string]string, error)
+}
+
+// The virtual projects of multitenancy-manager (v1alpha3.DefaultProjectName
+// and DeckhouseProjectName) and what it counts on the second one.
+const (
+	defaultProject   = "default"
+	deckhouseProject = "deckhouse"
+	heritageLabel    = "heritage"
+)
+
+// deckhouseInventoryPrefixes are the namespace names multitenancy-manager
+// counts on its virtual project deckhouse.
+var deckhouseInventoryPrefixes = []string{"d8-", "kube-", "upmeter-"}
+
+// projectOf is the project a namespace shows in the listing of projects: the
+// value of its project label, or else the virtual project multitenancy-manager
+// inventories it in (VirtualProjectName and IsDeckhouseInventory of its project
+// manager) -- deckhouse for a d8-, kube- or upmeter- namespace and for one
+// with the heritage deckhouse or upmeter, default for every other. An empty
+// label is no project, as it is not for multitenancy-manager either.
+func projectOf(ns *corev1.Namespace) string {
+	if project := ns.Labels[ProjectLabel]; project != "" {
+		return project
+	}
+	for _, prefix := range deckhouseInventoryPrefixes {
+		if strings.HasPrefix(ns.Name, prefix) {
+			return deckhouseProject
+		}
+	}
+	switch ns.Labels[heritageLabel] {
+	case "deckhouse", "upmeter":
+		return deckhouseProject
+	}
+	return defaultProject
+}
+
+// LoopbackProjectMembershipResolver reads membership through the loopback
+// client with one List of every namespace. multitenancy-manager stamps
+// ProjectLabel on EVERY namespace of a project: the main one, whose name is the
+// project's, and each additional one created through a ProjectNamespace. So the
+// map covers a project's whole namespace set without this package knowing
+// anything about how additional namespaces are named or requested; a namespace
+// without the label maps to its virtual project.
+type LoopbackProjectMembershipResolver struct {
+	client kubernetes.Interface
+}
+
+var _ ProjectMembershipResolver = (*LoopbackProjectMembershipResolver)(nil)
+
+// NewLoopbackProjectMembershipResolver builds a resolver from a loopback REST
+// config. The config is copied internally by kubernetes.NewForConfig; callers
+// may safely mutate it after this returns.
+func NewLoopbackProjectMembershipResolver(loopbackConfig *restclient.Config) (*LoopbackProjectMembershipResolver, error) {
+	cfg := restclient.CopyConfig(loopbackConfig)
+	client, err := kubernetes.NewForConfig(cfg)
+	if err != nil {
+		return nil, fmt.Errorf("build project membership client: %w", err)
+	}
+	return &LoopbackProjectMembershipResolver{client: client}, nil
+}
+
+// Resolve implements ProjectMembershipResolver.
+func (r *LoopbackProjectMembershipResolver) Resolve(ctx context.Context) (map[string]string, error) {
+	list, err := r.client.CoreV1().Namespaces().List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return nil, fmt.Errorf("list namespaces for project membership: %w", err)
+	}
+
+	membership := make(map[string]string, len(list.Items))
+	for i := range list.Items {
+		membership[list.Items[i].Name] = projectOf(&list.Items[i])
+	}
+	return membership, nil
+}
+
+// cachingProjectMembershipResolver caches the whole membership map under one
+// key: the answer is a pure function of cluster namespace labels, so every user
+// and every resource shares the single entry.
+type cachingProjectMembershipResolver struct {
+	inner ProjectMembershipResolver
+	cache *resolveCache[map[string]string]
+}
+
+var _ ProjectMembershipResolver = (*cachingProjectMembershipResolver)(nil)
+
+func (r *cachingProjectMembershipResolver) Resolve(_ context.Context) (map[string]string, error) {
+	return r.cache.getOrLoad(keyField("membership"), func(ctx context.Context) (map[string]string, error) {
+		return r.inner.Resolve(ctx)
+	})
+}
