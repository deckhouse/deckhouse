+
+package scopefilter_test
+
+import (
+	"testing"
+
+	"k8s.io/apiserver/pkg/registry/generic/scopefilter"
+	restclient "k8s.io/client-go/rest"
+)
+
+// TestNewLoopbackResolvers_OneBundlePerConfig: the built-in resources, the
+// custom resources and the namespaces of one kube-apiserver are wired from the
+// same loopback config, so they get the same bundle -- one set of clients and
+// caches. Another config, another server of a test process, gets its own, and
+// no config gets none.
+func TestNewLoopbackResolvers_OneBundlePerConfig(t *testing.T) {
+	if r, err := scopefilter.NewLoopbackResolvers(nil); r != nil || err != nil {
+		t.Fatalf("NewLoopbackResolvers(nil) = %v, %v; want nil, nil", r, err)
+	}
+
+	cfg := &restclient.Config{Host: "https://127.0.0.1:6443"}
+	first, err := scopefilter.NewLoopbackResolvers(cfg)
+	if err != nil || first == nil {
+		t.Fatalf("NewLoopbackResolvers(cfg) = %v, %v; want a bundle", first, err)
+	}
+	second, err := scopefilter.NewLoopbackResolvers(cfg)
+	if err != nil || second != first {
+		t.Fatalf("a second NewLoopbackResolvers(cfg) = %p, %v; want the same bundle %p", second, err, first)
+	}
+
+	other, err := scopefilter.NewLoopbackResolvers(&restclient.Config{Host: cfg.Host})
+	if err != nil || other == nil || other == first {
+		t.Fatalf("NewLoopbackResolvers of another config = %p, %v; want a bundle of its own, not %p", other, err, first)
+	}
+}
diff --git a/staging/src/k8s.io/apiserver/pkg/registry/generic/scopefilter/review.go b/staging/src/k8s.io/apiserver/pkg/registry/generic/scopefilter/review.go
new file mode 100644
index 00000000000..28a031b1286
--- /dev/null
+++ b/staging/src/k8s.io/apiserver/pkg/registry/generic/scopefilter/review.go
@@ -0,0 +1,233 @@
+/*
+Copyright 2026 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package scopefilter
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"time"
+
+	"k8s.io/apiserver/pkg/authentication/user"
+	restclient "k8s.io/client-go/rest"
+	"k8s.io/klog/v2"
+)
+
+// selfScopedAccessReviewAPIPath is the URL path under which Deckhouse's
+// permission-browser-apiserver serves SelfScopedAccessReview (create-only,
+// ephemeral -- the answer is computed and returned, never stored). Calls are
+// routed via kube-apiserver's loopback connection so they hit the aggregated
+// APIServer with full TLS/cert plumbing intact.
+const selfScopedAccessReviewAPIPath = "/apis/authorization.deckhouse.io/v1alpha1/selfscopedaccessreviews"
+
+// accessibleScope is the scope every review is asked in. The review then
+// answers the namespaces the caller may see at all where the action is
+// allowed -- the access boundary. The classification of the requested scope
+// stays in this package and is intersected separately, exactly as before, so
+// it also serves callers that are never reviewed (a caller RBAC already
+// allowed, and CE, which has no permission service).
+const accessibleScope = "accessible"
+
+// ErrClusterWideAccess is returned when the permission service answers that
+// the action is allowed in the whole cluster. Such an answer carries no
+// namespaces. For a request kube-apiserver has already denied it means the
+// two authorization chains disagree, and the request is refused rather than
+// answered with every namespace.
+var ErrClusterWideAccess = errors.New("scopefilter: the permission service allows the action in the whole cluster")
+
+// ErrPermissionServiceUnavailable is returned when the permission service
+// cannot answer a review for now: the call ran out of time, or the answer was
+// 429 or a 5xx status -- the service overloaded or past its own deadline, or
+// kube-apiserver unable to reach it. The access of the caller is unknown
+// rather than refused, so the request is answered with 503 and Retry-After;
+// it is still not served without the namespaces.
+var ErrPermissionServiceUnavailable = errors.New("scopefilter: the permission service is unavailable")
+
+// reviewHTTPTimeout is the timeout of every review call; tests shorten it.
+var reviewHTTPTimeout = defaultHTTPTimeout
+
+// scopedAccessItem is one action of a review: a resource or a subresource
+// and a verb.
+type scopedAccessItem struct {
+	Group       string
+	Resource    string
+	Subresource string
+	Verb        string
+}
+
+// The following types mirror the on-the-wire JSON shape of
+// permission-browser-apiserver's SelfScopedAccessReview
+// (authorization.deckhouse.io/v1alpha1). Only the fields used here are
+// encoded/decoded: new upstream fields don't break this code. Deckhouse's own
+// generated Go types are not importable here -- they live in a separate module
+// (deckhouse/deckhouse), while this file ships inside the Kubernetes tree.
+type selfScopedAccessReview struct {
+	APIVersion string                       `json:"apiVersion"`
+	Kind       string                       `json:"kind"`
+	Spec       selfScopedAccessReviewSpec   `json:"spec"`
+	Status     selfScopedAccessReviewStatus `json:"status"`
+}
+
+type selfScopedAccessReviewSpec struct {
+	Scope    string                `json:"scope"`
+	Requests []scopedAccessRequest `json:"requests"`
+}
+
+type scopedAccessRequest struct {
+	Group             string   `json:"group,omitempty"`
+	Resource          string   `json:"resource"`
+	Subresource       string   `json:"subresource,omitempty"`
+	Verbs             []string `json:"verbs"`
+	IncludeNamespaces bool     `json:"includeNamespaces"`
+}
+
+type selfScopedAccessReviewStatus struct {
+	// Results is positional: Results[i] answers Spec.Requests[i].
+	Results []scopedAccessResult `json:"results"`
+}
+
+type scopedAccessResult struct {
+	Allowed         bool     `json:"allowed"`
+	Cluster         bool     `json:"cluster"`
+	Namespaces      []string `json:"namespaces"`
+	Reason          string   `json:"reason"`
+	EvaluationError string   `json:"evaluationError"`
+}
+
+// LoopbackScopedAccessReviewer asks permission-browser-apiserver where an
+// action is allowed for a caller, with one SelfScopedAccessReview through
+// kube-apiserver's loopback HTTPS endpoint. The review is always about its
+// sender, so the caller is conveyed via standard impersonation headers
+// (Impersonate-User/-Group/-Extra-*) on top of the loopback client's
+// credentials. Every resolver of a Resolvers bundle shares one reviewer, and
+// so one transport and one connection pool.
+type LoopbackScopedAccessReviewer struct {
+	// baseURL is the scheme+host portion of the loopback config (no path).
+	baseURL string
+
+	// roundTripper is the authenticated transport built once from the
+	// loopback config. Per-request impersonation is layered on top via
+	// transport.NewImpersonatingRoundTripper, which simply prepends the
+	// impersonation headers and delegates to this base RT -- so all users
+	// share the same TLS connection pool.
+	roundTripper http.RoundTripper
+
+	// timeout caps every individual HTTP call.
+	timeout time.Duration
+}
+
+// NewLoopbackScopedAccessReviewer builds a reviewer from a loopback REST
+// config. The config is copied internally; callers may safely mutate it after
+// this returns.
+func NewLoopbackScopedAccessReviewer(loopbackConfig *restclient.Config) (*LoopbackScopedAccessReviewer, error) {
+	rt, baseURL, err := newLoopbackRoundTripper(loopbackConfig)
+	if err != nil {
+		return nil, err
+	}
+	return &LoopbackScopedAccessReviewer{
+		baseURL:      baseURL,
+		roundTripper: rt,
+		timeout:      reviewHTTPTimeout,
+	}, nil
+}
+
+// namespacesWhere returns the namespaces the caller u may see where item is
+// allowed, from one review with one request. It returns ErrClusterWideAccess
+// when the action is allowed in the whole cluster,
+// ErrPermissionServiceUnavailable when the service cannot answer for now (a
+// timeout, 429 or 5xx), and an error for anything else that is not a list of
+// namespaces: another error status -- a 404 of a permission service that does
+// not serve the kind included -- a request the service could not evaluate, or
+// a resource it does not filter. There is no other way to get the namespaces:
+// an unavailable service ends in 503, every other error in 403.
+func (r *LoopbackScopedAccessReviewer) namespacesWhere(ctx context.Context, u user.Info, item scopedAccessItem) ([]string, error) {
+	review := selfScopedAccessReview{
+		APIVersion: "authorization.deckhouse.io/v1alpha1",
+		Kind:       "SelfScopedAccessReview",
+		Spec: selfScopedAccessReviewSpec{
+			Scope: accessibleScope,
+			Requests: []scopedAccessRequest{{
+				Group:             item.Group,
+				Resource:          item.Resource,
+				Subresource:       item.Subresource,
+				Verbs:             []string{item.Verb},
+				IncludeNamespaces: true,
+			}},
+		},
+	}
+	payload, err := json.Marshal(review)
+	if err != nil {
+		return nil, fmt.Errorf("marshal SelfScopedAccessReview: %w", err)
+	}
+
+	endpoint := r.baseURL + selfScopedAccessReviewAPIPath
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(payload))
+	if err != nil {
+		return nil, fmt.Errorf("build SelfScopedAccessReview request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+
+	klog.V(4).InfoS("scopefilter: reviewing scoped access", "user", u.GetName(), "resource", item.Resource, "subresource", item.Subresource, "verb", item.Verb)
+
+	resp, err := impersonatedHTTPClient(r.roundTripper, u, r.timeout).Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("SelfScopedAccessReview for user %q: %w", u.GetName(), unavailableIfTimeout(err))
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK && resp.StatusCode != http.StatusCreated {
+		err := fmt.Errorf("unexpected status %d: %s", resp.StatusCode, readErrorBody(resp.Body))
+		if resp.StatusCode == http.StatusTooManyRequests || resp.StatusCode >= http.StatusInternalServerError {
+			err = fmt.Errorf("%w: %w", ErrPermissionServiceUnavailable, err)
+		}
+		return nil, fmt.Errorf("SelfScopedAccessReview for user %q: %w", u.GetName(), err)
+	}
+
+	var out selfScopedAccessReview
+	if err := json.NewDecoder(resp.Body).Decode(&out); err != nil {
+		return nil, fmt.Errorf("decode SelfScopedAccessReview response for user %q: %w", u.GetName(), unavailableIfTimeout(err))
+	}
+	if len(out.Status.Results) != 1 {
+		return nil, fmt.Errorf("SelfScopedAccessReview for user %q: got %d results for 1 request", u.GetName(), len(out.Status.Results))
+	}
+
+	result := out.Status.Results[0]
+	switch {
+	case result.EvaluationError != "":
+		return nil, fmt.Errorf("SelfScopedAccessReview for user %q: %s", u.GetName(), result.EvaluationError)
+	case result.Cluster:
+		return nil, fmt.Errorf("SelfScopedAccessReview for user %q on %s/%s %s: %w", u.GetName(), item.Resource, item.Subresource, item.Verb, ErrClusterWideAccess)
+	case result.Reason != "":
+		return nil, fmt.Errorf("SelfScopedAccessReview for user %q: %s/%s is not filtered: %s", u.GetName(), item.Resource, item.Subresource, result.Reason)
+	}
+	return result.Namespaces, nil
+}
+
+// unavailableIfTimeout marks a call that ran out of time -- its own timeout or
+// the deadline of its context -- as ErrPermissionServiceUnavailable.
+func unavailableIfTimeout(err error) error {
+	var netErr net.Error
+	if errors.Is(err, context.DeadlineExceeded) || (errors.As(err, &netErr) && netErr.Timeout()) {
+		return fmt.Errorf("%w: %w", ErrPermissionServiceUnavailable, err)
+	}
+	return err
+}
