+
+// Deckhouse: the part of withAuthorization that serves the scope filter. The
+// authorization filter calls the three functions below at its three decision
+// points; everything else lives here, so the upstream file carries only those
+// calls.
+
+const (
+	// Audit annotation values used when the authorization filter hands a
+	// denied namespace list/get/watch over to the storage layer for ACL-based
+	// filtering instead of 403'ing.
+	decisionAllowFiltered = "allow-filtered"
+	reasonNamespaceFilter = "namespace filtering mode"
+
+	// Audit annotation values used when the authorization filter hands a
+	// denied list/get/watch of an arbitrary --scope-registered resource over to
+	// the storage layer for scope-based filtering instead of 403'ing. Distinct
+	// from the namespace-specific pair above because the trigger condition
+	// differs (a header, not an unconditional rule) and operators auditing
+	// "allow-filtered" decisions want to tell the two apart.
+	decisionAllowScoped = "allow-scoped"
+	reasonScopeFilter   = "scope filtering mode"
+)
+
+// rejectMalformedScopeHeader answers 400 to a malformed scope header (unknown
+// value, project header without a scope header, ...) on a request the
+// mechanism would otherwise engage for, and reports whether it did. It runs
+// for every caller, before authorization. Silently ignoring the header would
+// hand a privileged caller with a typo the full unfiltered listing they
+// explicitly asked to narrow, and would give a denied caller a misleading 403
+// instead of pointing at the bad header. Requests the mechanism ignores anyway
+// (mutating verbs, subresources) keep ignoring the headers, valid or not.
+func rejectMalformedScopeHeader(w http.ResponseWriter, req *http.Request, s runtime.NegotiatedSerializer) bool {
+	requestInfo, ok := request.RequestInfoFrom(req.Context())
+	if !ok || !isFilteredRequest(requestInfo) {
+		return false
+	}
+	if _, present, perr := scopefilter.ParseHeaders(req.Header); present && perr != nil {
+		responsewriters.ErrorNegotiated(apierrors.NewBadRequest(perr.Error()), s, schema.GroupVersion{}, w, req)
+		return true
+	}
+	return false
+}
+
+// withAllowedScope tags an allowed scope request, WITHOUT WithBypass. This is
+// what lets a fully privileged caller use e.g. --scope=system to narrow their
+// own view without ever triggering the (comparatively expensive) RBAC floor
+// computation -- RBAC already said yes, so scopefilter.Decorator applies only
+// the classification selector and skips RBACFloorResolver entirely. See
+// scopefilter.WithBypass's doc for why these two tags are intentionally
+// independent.
+func withAllowedScope(req *http.Request) *http.Request {
+	requestInfo, ok := request.RequestInfoFrom(req.Context())
+	if !ok || !isFilteredRequest(requestInfo) {
+		return req
+	}
+	scopeReq, present, perr := scopefilter.ParseHeaders(req.Header)
+	if !present || perr != nil {
+		return req
+	}
+	if gr := (schema.GroupResource{Group: requestInfo.APIGroup, Resource: requestInfo.Resource}); !scopefilter.EnsureRegistered(gr) {
+		return req
+	}
+	return req.WithContext(scopefilter.WithRequest(req.Context(), scopeReq))
+}
+
+// withScopeBypass returns the request to serve instead of a 403, and whether
+// there is one. reason is the authorizer's.
+//
+// A namespace list/get/watch is handed to the storage layer for an ACL-filtered
+// response. This is strictly a relaxation for *read* verbs; mutating verbs still
+// get the standard Forbidden. The storage layer keys off
+// scopefilter.IsNamespaceFilteringMode() so other consumers of this filter chain
+// are unaffected.
+//
+// A read of any other resource is handed over for scope-based filtering only
+// when three independent gates all hold:
+//
+//  1. isFilteredRequest: read verb, no subresource, resource request at all
+//     (this alone says nothing about WHICH resource -- deliberately, so this
+//     stays a single shared gate for every namespaced resource rather than a
+//     per-resource hardcode like the namespaces case above).
+//  2. The client actually sent a scope header -- absence means "not asking for
+//     this", and behavior for such a caller must stay byte-for-byte identical to
+//     a kube-apiserver with no Deckhouse patches at all.
+//  3. scopefilter.EnsureRegistered(gr): a storage-layer decorator is ACTUALLY
+//     wired for this exact (group, resource) -- for a CRD whose storage was not
+//     built yet, it is built now. This is the gate that makes (1)+(2) safe --
+//     without it, a header alone would bypass 403 into a completely unfiltered
+//     Store.List for any resource nobody wired filtering for, handing back
+//     everything to a denied caller.
+func withScopeBypass(req *http.Request, reason string) (*http.Request, bool) {
+	ctx := req.Context()
+	requestInfo, _ := request.RequestInfoFrom(ctx)
+
+	if isNamespaceListGetOrWatchRequest(requestInfo) {
+		klog.V(4).InfoS("namespace ACL: bypassing authorization denial for namespace read; storage will filter",
+			"URI", req.RequestURI, "verb", requestInfo.Verb, "reason", reason)
+		audit.AddAuditAnnotations(ctx,
+			decisionAnnotationKey, decisionAllowFiltered,
+			reasonAnnotationKey, reasonNamespaceFilter)
+		return req.WithContext(scopefilter.WithNamespaceFilteringMode(ctx)), true
+	}
+
+	if !isFilteredRequest(requestInfo) {
+		return nil, false
+	}
+	// A malformed header (present && perr != nil) cannot reach this point: it
+	// was rejected with 400 before authorization ran.
+	scopeReq, present, perr := scopefilter.ParseHeaders(req.Header)
+	if !present || perr != nil {
+		return nil, false
+	}
+	gr := schema.GroupResource{Group: requestInfo.APIGroup, Resource: requestInfo.Resource}
+	if !scopefilter.EnsureRegistered(gr) {
+		return nil, false
+	}
+	klog.V(4).InfoS("scopefilter: bypassing authorization denial for scoped read; storage will filter",
+		"URI", req.RequestURI, "verb", requestInfo.Verb, "resource", gr, "scope", scopeReq.Kind, "reason", reason)
+	audit.AddAuditAnnotations(ctx,
+		decisionAnnotationKey, decisionAllowScoped,
+		reasonAnnotationKey, reasonScopeFilter)
+	return req.WithContext(scopefilter.WithBypass(scopefilter.WithRequest(ctx, scopeReq))), true
+}
+
+// isNamespaceListGetOrWatchRequest reports whether the request targets the
+// core /v1/namespaces list/get/watch endpoint, or that of a cluster-scoped
+// resource whose visibility is derived from the same namespace ACL (see
+// scopefilter.IsNamespaceIdentityResource -- the Project CRD, visible whenever
+// any namespace of the project is). These three verbs are the only ones we bypass
+// 403 for: create/update/delete still reject denied users with the standard
+// error so we don't accidentally let unauthorized callers mutate cluster state.
+//
+// Both are gated on the filter actually being registered, so a read with no
+// filter behind it gets the plain 403 rather than a silently unfiltered
+// answer: namespaces are registered only when their storage built the filter,
+// which it does not without a loopback config or when the resolvers cannot
+// be built, and an identity resource is served by a CRD that may not exist.
+func isNamespaceListGetOrWatchRequest(requestInfo *request.RequestInfo) bool {
+	if requestInfo == nil || !requestInfo.IsResourceRequest {
+		return false
+	}
+	if requestInfo.Subresource != "" {
+		return false
+	}
+
+	gr := schema.GroupResource{Group: requestInfo.APIGroup, Resource: requestInfo.Resource}
+	switch {
+	case gr.Group == "" && gr.Resource == "namespaces" && scopefilter.IsRegistered(gr):
+	case scopefilter.IsNamespaceIdentityResource(gr) && scopefilter.EnsureRegistered(gr):
+	default:
+		return false
+	}
+	switch requestInfo.Verb {
+	case "list", "get", "watch":
+		return true
+	}
+	return false
+}
+
+// isFilteredRequest reports whether the request is a read (list/get/watch)
+// of a top-level (no subresource) namespaced-resource endpoint that COULD be
+// bypassed for scope-based filtering. It deliberately says nothing about
+// whether the caller actually asked for a scope (that's a header check the
+// caller makes separately) or whether a filtering decorator is actually
+// wired for this resource (that's scopefilter.EnsureRegistered, also checked
+// separately by the caller) -- both must ALSO hold before bypassing, so
+// that a header alone is never enough to skip authz for a resource nobody
+// wired filtering for.
+func isFilteredRequest(requestInfo *request.RequestInfo) bool {
+	if requestInfo == nil || !requestInfo.IsResourceRequest || requestInfo.Subresource != "" {
+		return false
+	}
+	switch requestInfo.Verb {
+	case "list", "get", "watch":
+		return true
+	}
+	return false
+}
