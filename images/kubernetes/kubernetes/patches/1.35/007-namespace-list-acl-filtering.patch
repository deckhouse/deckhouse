+package apiserver
+
+import (
+	apiextensionshelpers "k8s.io/apiextensions-apiserver/pkg/apihelpers"
+	apiextensionsv1 "k8s.io/apiextensions-apiserver/pkg/apis/apiextensions/v1"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	genericregistry "k8s.io/apiserver/pkg/registry/generic/registry"
+	"k8s.io/apiserver/pkg/registry/generic/scopefilter"
+	genericapiserver "k8s.io/apiserver/pkg/server"
+	restclient "k8s.io/client-go/rest"
+	"k8s.io/klog/v2"
+)
+
+// Deckhouse: the part of the CRD handler that serves the scope filter -- the
+// CRD analogue of the built-in central loop in pkg/controlplane/apiserver's
+// InstallAPIs. The upstream files carry only the calls.
+
+// enableScopeFilter gives the CRD handler the shared scope-filter resolver
+// bundle and installs registerScopeFilter as the registrar of the shared
+// registry until the server is destroyed. Without a bundle every CRD stays at
+// vanilla behavior.
+func (r *crdHandler) enableScopeFilter(s *genericapiserver.GenericAPIServer) {
+	r.scopeResolvers = newScopeResolvers(s.LoopbackClientConfig)
+	if r.scopeResolvers == nil {
+		return
+	}
+	s.RegisterDestroyFunc(scopefilter.SetRegistrar(r.registerScopeFilter))
+}
+
+// registerScopeFilter builds the storage of the CRD serving gr, the way the
+// first request reaching the handler would, and reports whether gr is
+// registered afterwards. The authorization filter calls it for a scoped read
+// it denied, which never reaches the handler: without it, a new CRD -- or any
+// CRD after a restart -- would answer such reads with 403 until some other
+// request built its storage.
+//
+// It follows ServeHTTP: the CRD is looked up by the name the URL implies and
+// must be served (NamesAccepted or Established). getOrCreateServingInfoFor
+// registers a storage it builds with a ScopeFilter. One it already had may
+// have lost its registration since (see unregisterScopeFilter), so it is
+// registered here if it carries a ScopeFilter -- under customStorageLock, as
+// teardown unregisters, and only while it is still the live storage of the
+// CRD: a storage torn down in between leaves nothing to register.
+func (r *crdHandler) registerScopeFilter(gr schema.GroupResource) bool {
+	crd, err := r.crdLister.Get(gr.Resource + "." + gr.Group)
+	if err != nil {
+		return false
+	}
+	if !apiextensionshelpers.IsCRDConditionTrue(crd, apiextensionsv1.NamesAccepted) &&
+		!apiextensionshelpers.IsCRDConditionTrue(crd, apiextensionsv1.Established) {
+		return false
+	}
+	info, err := r.getOrCreateServingInfoFor(crd.UID, crd.Name)
+	if err != nil {
+		klog.V(2).InfoS("scopefilter: cannot build the storage of a CRD for a scoped read", "crd", crd.Name, "err", err)
+		return false
+	}
+	r.customStorageLock.Lock()
+	defer r.customStorageLock.Unlock()
+	if live := r.customStorage.Load().(crdStorageMap)[crd.UID]; live == info && hasScopeFilter(info) {
+		scopefilter.Register(gr)
+	}
+	return scopefilter.IsRegistered(gr)
+}
+
+// unregisterScopeFilter drops the registration of the group/resource the
+// torn-down oldInfo served -- unless a live crdInfo serves the same
+// group/resource with a ScopeFilter. The registry is keyed by group/resource,
+// not by CRD: on a spec update or a recreate the handler builds the new
+// crdInfo on the next request, while tearDown first waits for the requests of
+// the old one, so the new storage is often registered before the old one is
+// torn down. It runs under customStorageLock, as getOrCreateServingInfoFor
+// does when it registers.
+func (r *crdHandler) unregisterScopeFilter(oldInfo *crdInfo) {
+	gr := schema.GroupResource{Group: oldInfo.spec.Group, Resource: oldInfo.acceptedNames.Plural}
+
+	r.customStorageLock.Lock()
+	defer r.customStorageLock.Unlock()
+	for _, info := range r.customStorage.Load().(crdStorageMap) {
+		if info.spec.Group == gr.Group && info.acceptedNames.Plural == gr.Resource && hasScopeFilter(info) {
+			return
+		}
+	}
+	scopefilter.Unregister(gr)
+}
+
+// hasScopeFilter reports whether any version of the CRD storage carries a
+// ScopeFilter.
+func hasScopeFilter(info *crdInfo) bool {
+	for _, storage := range info.storages {
+		if storage.CustomResource != nil && storage.CustomResource.Store.ScopeFilter != nil {
+			return true
+		}
+	}
+	return false
+}
+
+// newScopeResolvers returns the shared scope-filter resolver bundle the CRD
+// handler wires every served CRD version against (see wireScopeFilter): nil
+// when there is no loopback config (minimal/test setups) or when the bundle
+// cannot be built, which leaves every CRD at vanilla behavior.
+func newScopeResolvers(loopbackConfig *restclient.Config) *scopefilter.Resolvers {
+	r, err := scopefilter.NewLoopbackResolvers(loopbackConfig)
+	if err != nil {
+		klog.Warningf("scopefilter: failed to build resolvers: %v; generic --scope filtering disabled for CRDs this run", err)
+		return nil
+	}
+	return r
+}
+
+// wireScopeFilter sets the ScopeFilter of the storage of one CRD version and
+// reports whether it did.
+//
+// A namespaced CRD version gets generic `-A --scope=<kind>` filtering.
+// customresource.REST embeds *genericregistry.Store and does not override
+// List/Get/Watch, so setting store.ScopeFilter takes effect exactly as it does
+// for built-ins.
+//
+// A cluster-scoped CRD normally has nothing to classify against (no namespace
+// to classify/floor, and the authz bypass never fires for it), but one whose
+// visibility follows the namespace ACL is filtered all the same -- the Project
+// CRD, visible whenever any of its namespaces is. It runs in the same
+// IdentityByName mode the namespaces storage uses, triggered by the same
+// filtering-mode flag, so a user without RBAC for the resource gets the
+// accessible subset instead of a 403. A nil decorator means the resource
+// derives no names and is left unfiltered.
+//
+// A nil resolver bundle (no loopback config) is a no-op. Registration in the
+// shared scopefilter registry is deliberately left to the caller, once the
+// WHOLE crdInfo has been built and cached: a later per-version build step can
+// still fail, and registering here would leave IsRegistered true -- opening
+// the authorization bypass -- for a resource that is not served and has no
+// teardown path to unregister it.
+func (r *crdHandler) wireScopeFilter(store *genericregistry.Store, resource schema.GroupVersionResource, clusterScoped bool) bool {
+	if r.scopeResolvers == nil {
+		return false
+	}
+	if !clusterScoped {
+		store.ScopeFilter = r.scopeResolvers.NewDecorator(store, store.PredicateFunc, store.Decorator, resource)
+		return true
+	}
+	if !scopefilter.IsNamespaceIdentityResource(resource.GroupResource()) {
+		return false
+	}
+	decorator := r.scopeResolvers.NewIdentityDecorator(store, store.PredicateFunc, store.Decorator, resource)
+	if decorator == nil {
+		return false
+	}
+	store.ScopeFilter = decorator
+	return true
+}
