+// TestFilteredWatch_RefreshAnswerClosesTheWatchAtOnce: a refresh answered
+// rather than failed does not change by retrying, so the watch reports the
+// answer and closes on the first one, long before the limit for failures.
+func TestFilteredWatch_RefreshAnswerClosesTheWatchAtOnce(t *testing.T) {
