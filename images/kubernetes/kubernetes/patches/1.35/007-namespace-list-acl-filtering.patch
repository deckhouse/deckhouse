+		{name: "projects, disabled, bypassed caller", disabled: true, scope: scopefilter.Request{Kind: scopefilter.KindProjects}, bypass: true, wantBadReq: true},
+		{name: "project, disabled", disabled: true, scope: scopefilter.Request{Kind: scopefilter.KindProject, Project: "team-a"}, wantBadReq: true},
+		{name: "system, disabled", disabled: true, scope: scopefilter.Request{Kind: scopefilter.KindSystem}},
+		{name: "accessible, disabled", disabled: true, scope: scopefilter.Request{Kind: scopefilter.KindAccessible}, bypass: true},
+		{name: "projects, enabled or unknown", scope: scopefilter.Request{Kind: scopefilter.KindProjects}, bypass: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			store := newFakeStore()
+			store.put("ns-a", "pod-1")
+			d := &scopefilter.Decorator{
+				Store:          store,
+				BuildPredicate: store.buildPredicate,
