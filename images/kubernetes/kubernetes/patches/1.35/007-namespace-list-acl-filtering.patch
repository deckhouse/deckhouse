+// TestDecorator_NamespacesWatchClosesWhenListIsAllowedInTheWholeCluster: an
+// open watch of namespaces whose refresh learns that the caller may now list
+// namespaces in the whole cluster closes with 410, so the client lists again,
+// instead of retracting every namespace it showed and staying open.
+func TestDecorator_NamespacesWatchClosesWhenListIsAllowedInTheWholeCluster(t *testing.T) {
+	scopefilter.SetWatchRefreshFailureLimitForTest(t, time.Hour)
+
+	store := newFakeStore()
+	accessible := &switchingAccessible{names: []string{"ns-a", "ns-b"}}
+	d := &scopefilter.Decorator{
+		Store:           store,
+		BuildPredicate:  store.buildPredicate,
+		Resource:        schema.GroupVersionResource{Version: "v1", Resource: "namespaces"},
+		Mode:            scopefilter.IdentityByName,
+		Accessible:      accessible,
+		RefreshInterval: 10 * time.Millisecond,
+	}
+	ctx := genericapirequest.WithUser(genericapirequest.NewContext(), &user.DefaultInfo{Name: "alice"})
+
+	w, err := d.Watch(ctx, nil)
+	if err != nil {
+		t.Fatalf("Watch: %v", err)
+	}
+	defer w.Stop()
+	accessible.clusterWide.Store(true)
+
+	var gotError bool
+	deadline := time.After(3 * time.Second)
+	for {
+		select {
+		case ev, open := <-w.ResultChan():
+			if !open {
+				if !gotError {
+					t.Fatal("the watch closed without an error event")
+				}
+				return
+			}
+			status, ok := ev.Object.(*metav1.Status)
+			if ev.Type != watch.Error || !ok || status.Code != 410 {
+				t.Fatalf("got %s %#v, want only an error event with code 410", ev.Type, ev.Object)
+			}
+			gotError = true
+		case <-deadline:
+			t.Fatal("the watch was not closed within 3s of the review allowing list in the whole cluster")
+		}
+	}
+}
+
+// collectEvents drains ch until every name in want has been seen with the
+// given (evType, namespace), or timeout elapses. Events not matching
+// evType/namespace (e.g. from an unrelated namespace) are ignored rather
+// than treated as failures.
+func collectEvents(t *testing.T, ch <-chan watch.Event, evType watch.EventType, namespace string, timeout time.Duration, want ...string) bool {
+	t.Helper()
+	remaining := make(map[string]bool, len(want))
+	for _, n := range want {
+		remaining[n] = true
+	}
+
+	deadline := time.NewTimer(timeout)
+	defer deadline.Stop()
+	for len(remaining) > 0 {
+		select {
+		case ev := <-ch:
+			if ev.Type != evType {
+				continue
+			}
+			item, ok := ev.Object.(*fakeItem)
+			if !ok || item.Namespace != namespace {
+				continue
+			}
+			delete(remaining, item.Name)
+		case <-deadline.C:
+			return false
+		}
+	}
+	return true
+}
