+
+// Package scopefilter holds integration tests for Deckhouse's generic
+// `-A --scope=<kind>` cross-namespace ACL filtering. Unlike the unit and
+// store-level tests that live next to the scopefilter package itself, these
+// run a REAL kube-apiserver (full chain: apiextensions -> kube -> aggregator,
+// RBAC authorization, etcd storage) and drive it over HTTP, so they exercise
+// the entire request path: header parsing -> authorization-filter tagging ->
+// storage decorator -> filtered response. They cover what no unit layer can:
+//
+//   - the wiring itself (central InstallAPIs loop for built-ins, crdHandler
+//     wiring for CRDs) against a server assembled exactly like production;
+//   - the fail-closed guarantee when Deckhouse's permission-browser aggregated
+//     API is ABSENT (as it is here): a denied caller sending scope headers
+//     must still get 403, never data.
+//
+// The permission-browser (authorization.deckhouse.io) is deliberately not
+// faked: an allowed caller (loopback superuser) never triggers the RBAC-floor
+// path, so classification-only scopes (system / projects / project:<name>)
+// resolve end-to-end through the real loopback Namespace LIST, while a denied
+// caller proves fail-closed behavior. The floor computation itself is covered
+// by the store-level integration test in the scopefilter package.
+package scopefilter
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	apiextensionsv1 "k8s.io/apiextensions-apiserver/pkg/apis/apiextensions/v1"
+	apiextensionsclientset "k8s.io/apiextensions-apiserver/pkg/client/clientset/clientset"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/util/wait"
+	"k8s.io/client-go/dynamic"
+	clientset "k8s.io/client-go/kubernetes"
+	restclient "k8s.io/client-go/rest"
+	apiregistrationv1 "k8s.io/kube-aggregator/pkg/apis/apiregistration/v1"
+	aggregatorclient "k8s.io/kube-aggregator/pkg/client/clientset_generated/clientset"
+	kubeapiservertesting "k8s.io/kubernetes/cmd/kube-apiserver/app/testing"
+	"k8s.io/kubernetes/test/integration/framework"
+
+	corev1 "k8s.io/api/core/v1"
+)
+
+const (
+	scopeHeader   = "X-Deckhouse-Scope"
+	projectHeader = "X-Deckhouse-Project"
+
+	// projectLabel mirrors scopefilter.ProjectLabel; spelled out here so the
+	// test asserts the real wire contract rather than whatever the constant
+	// happens to be.
+	projectLabel = "projects.deckhouse.io/project"
+
+	// probeName is the object name created in every fixture namespace; scoped
+	// listings are asserted by which namespaces' probes they contain.
+	probeName = "scope-probe"
+
+	crdGroup    = "scopetest.deckhouse.io"
+	crdVersion  = "v1"
+	crdPlural   = "widgets"
+	crdKind     = "Widget"
+	crdListKind = "WidgetList"
+
+	// aggregatedGroup is served by an APIService with a Service that does
+	// not exist.
+	aggregatedGroup = "aggregated.scopetest.deckhouse.io"
+)
+
+// fixture namespaces: two system ones (matching the fixed d8-*/kube-* name
+// allowlist), one "orphan" (unlabeled AND outside the allowlist -- matches
+// neither the system nor the projects scope), and two project ones. The
+// pre-existing default namespace completes the system allowlist and receives
+// probes alongside these (see probeNamespaces).
+var fixtureNamespaces = map[string]map[string]string{
+	"d8-scope-int":     nil,
+	"kube-scope-int":   nil,
+	"scope-int-orphan": nil,
+	"scope-int-alpha":  {projectLabel: "alpha"},
+	"scope-int-beta":   {projectLabel: "beta"},
+}
+
+// probeNamespaces is every namespace that holds a probe object: the created
+// fixtures plus the pre-existing default namespace (part of the system name
+// allowlist; only its probe is created, never the namespace itself).
+var probeNamespaces = []string{
+	"d8-scope-int",
+	"kube-scope-int",
+	"scope-int-orphan",
+	"scope-int-alpha",
+	"scope-int-beta",
+	"default",
+}
+
+func TestScopeFilter(t *testing.T) {
+	server := kubeapiservertesting.StartTestServerOrDie(t, nil,
+		append(framework.DefaultTestServerFlags(), "--authorization-mode=RBAC"),
+		framework.SharedEtcd())
+	defer server.TearDownFn()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+
+	admin := clientset.NewForConfigOrDie(server.ClientConfig)
+
+	// A JSON-speaking copy of the admin config: raw scoped requests below
+	// parse response bodies as JSON, and custom resources cannot be served
+	// as protobuf anyway.
+	jsonCfg := restclient.CopyConfig(server.ClientConfig)
+	jsonCfg.ContentType = "application/json"
+	jsonCfg.AcceptContentTypes = "application/json"
+	adminJSON := clientset.NewForConfigOrDie(jsonCfg)
+
+	// An impersonated caller with NO RBAC grants whatsoever. Impersonation is
+	// performed by the superuser client, so the request authenticates fine and
+	// then fails authorization -- exactly the caller class --scope exists for.
+	deniedCfg := restclient.CopyConfig(jsonCfg)
+	deniedCfg.Impersonate = restclient.ImpersonationConfig{UserName: "scope-denied-user"}
+	deniedJSON := clientset.NewForConfigOrDie(deniedCfg)
+
+	// Fixtures: labeled namespaces, then one probe ConfigMap in every probe
+	// namespace (including the pre-existing default, which is never created).
+	for ns, labels := range fixtureNamespaces {
+		if _, err := admin.CoreV1().Namespaces().Create(ctx, &corev1.Namespace{
+			ObjectMeta: metav1.ObjectMeta{Name: ns, Labels: labels},
+		}, metav1.CreateOptions{}); err != nil {
+			t.Fatalf("create namespace %s: %v", ns, err)
+		}
+	}
+	for _, ns := range probeNamespaces {
+		if _, err := admin.CoreV1().ConfigMaps(ns).Create(ctx, &corev1.ConfigMap{
+			ObjectMeta: metav1.ObjectMeta{Name: probeName},
+		}, metav1.CreateOptions{}); err != nil {
+			t.Fatalf("create probe configmap in %s: %v", ns, err)
+		}
+	}
+
+	// scopedProbeNamespaces GETs path with the given scope headers using the
+	// admin (allowed, superuser) identity and returns the sorted set of
+	// namespaces whose probe object made it into the response.
+	scopedProbeNamespaces := func(path string, headers map[string]string) ([]string, error) {
+		req := adminJSON.Discovery().RESTClient().Get().AbsPath(path)
+		for k, v := range headers {
+			req = req.SetHeader(k, v)
+		}
+		raw, err := req.DoRaw(ctx)
+		if err != nil {
+			return nil, err
+		}
+		var list struct {
+			Items []struct {
+				Metadata struct {
+					Namespace string `json:"namespace"`
+					Name      string `json:"name"`
+				} `json:"metadata"`
+			} `json:"items"`
+		}
+		if err := json.Unmarshal(raw, &list); err != nil {
+			return nil, fmt.Errorf("decode response: %w", err)
+		}
+		var namespaces []string
+		for _, item := range list.Items {
+			if item.Metadata.Name == probeName {
+				namespaces = append(namespaces, item.Metadata.Namespace)
+			}
+		}
+		sort.Strings(namespaces)
+		return namespaces, nil
+	}
+
+	requireNamespaces := func(t *testing.T, got []string, want ...string) {
+		t.Helper()
+		sort.Strings(want)
+		if len(got) != len(want) {
+			t.Fatalf("scoped listing namespaces = %v, want %v", got, want)
+		}
+		for i := range want {
+			if got[i] != want[i] {
+				t.Fatalf("scoped listing namespaces = %v, want %v", got, want)
+			}
+		}
+	}
+
+	t.Run("DeniedCallerWithoutHeaderGets403", func(t *testing.T) {
+		_, err := deniedJSON.Discovery().RESTClient().Get().
+			AbsPath("/api/v1/configmaps").DoRaw(ctx)
+		if !apierrors.IsForbidden(coerceStatusError(err)) {
+			t.Fatalf("expected vanilla Forbidden for cross-namespace list without header, got: %v", err)
+		}
+	})
+
+	t.Run("DeniedCallerWithHeaderStays403FailClosed", func(t *testing.T) {
+		// permission-browser (authorization.deckhouse.io) is not installed in
+		// this server, so the RBAC floor cannot be computed. A denied caller
+		// asking for ANY scope must still get 403 -- the header alone must
+		// never widen access. This is the fail-closed invariant.
+		for _, scope := range []string{"accessible", "projects", "system"} {
+			_, err := deniedJSON.Discovery().RESTClient().Get().
+				AbsPath("/api/v1/configmaps").SetHeader(scopeHeader, scope).DoRaw(ctx)
+			if !apierrors.IsForbidden(coerceStatusError(err)) {
+				t.Fatalf("scope=%s: expected fail-closed Forbidden, got: %v", scope, err)
+			}
+		}
+		_, err := deniedJSON.Discovery().RESTClient().Get().
+			AbsPath("/api/v1/configmaps").
+			SetHeader(scopeHeader, "project").SetHeader(projectHeader, "alpha").DoRaw(ctx)
+		if !apierrors.IsForbidden(coerceStatusError(err)) {
+			t.Fatalf("scope=project:alpha: expected fail-closed Forbidden, got: %v", err)
+		}
+	})
+
+	t.Run("MalformedScopeHeaderIs400ForEveryCaller", func(t *testing.T) {
+		// A typo'd scope value must fail loudly with 400 -- NOT silently
+		// hand a privileged caller the full listing they asked to narrow,
+		// and NOT turn into a misleading 403 for a denied caller.
+		for name, client := range map[string]clientset.Interface{"admin": adminJSON, "denied": deniedJSON} {
+			_, err := client.Discovery().RESTClient().Get().
+				AbsPath("/api/v1/configmaps").SetHeader(scopeHeader, "projcts").DoRaw(ctx)
+			if !apierrors.IsBadRequest(coerceStatusError(err)) {
+				t.Fatalf("%s with typo'd scope value: expected 400 BadRequest, got: %v", name, err)
+			}
+		}
+		// Project header without a scope header is an attempt to use the
+		// mechanism too -- same 400, not a silent full listing.
+		_, err := adminJSON.Discovery().RESTClient().Get().
+			AbsPath("/api/v1/configmaps").SetHeader(projectHeader, "alpha").DoRaw(ctx)
+		if !apierrors.IsBadRequest(coerceStatusError(err)) {
+			t.Fatalf("project header without scope header: expected 400 BadRequest, got: %v", err)
+		}
+		// scope=project without the project name is malformed as well.
+		_, err = adminJSON.Discovery().RESTClient().Get().
+			AbsPath("/api/v1/configmaps").SetHeader(scopeHeader, "project").DoRaw(ctx)
+		if !apierrors.IsBadRequest(coerceStatusError(err)) {
+			t.Fatalf("scope=project without project header: expected 400 BadRequest, got: %v", err)
+		}
+	})
+
+	t.Run("AllowedCallerWithoutHeaderUnchanged", func(t *testing.T) {
+		got, err := scopedProbeNamespaces("/api/v1/configmaps", nil)
+		if err != nil {
+			t.Fatalf("unscoped list: %v", err)
+		}
+		requireNamespaces(t, got, probeNamespaces...)
+	})
+
+	t.Run("SystemScopeIsTheNameAllowlistOnly", func(t *testing.T) {
+		// System is the fixed name allowlist (default, d8-*, kube-*):
+		// scope-int-orphan is unlabeled but NOT allowlisted, so it must not
+		// appear -- system is not "everything outside projects".
+		got, err := scopedProbeNamespaces("/api/v1/configmaps", map[string]string{scopeHeader: "system"})
+		if err != nil {
+			t.Fatalf("scope=system list: %v", err)
+		}
+		requireNamespaces(t, got, "d8-scope-int", "kube-scope-int", "default")
+	})
+
+	t.Run("ProjectsScopeIsExactlyProjectNamespaces", func(t *testing.T) {
+		// scope-int-orphan is absent here too: an unlabeled namespace outside
+		// the system allowlist matches neither scope.
+		got, err := scopedProbeNamespaces("/api/v1/configmaps", map[string]string{scopeHeader: "projects"})
+		if err != nil {
+			t.Fatalf("scope=projects list: %v", err)
+		}
+		requireNamespaces(t, got, "scope-int-alpha", "scope-int-beta")
+	})
+
+	t.Run("SingleProjectScope", func(t *testing.T) {
+		got, err := scopedProbeNamespaces("/api/v1/configmaps",
+			map[string]string{scopeHeader: "project", projectHeader: "alpha"})
+		if err != nil {
+			t.Fatalf("scope=project:alpha list: %v", err)
+		}
+		requireNamespaces(t, got, "scope-int-alpha")
+	})
+
+	t.Run("NonexistentProjectScopeIsEmptyNotError", func(t *testing.T) {
+		got, err := scopedProbeNamespaces("/api/v1/configmaps",
+			map[string]string{scopeHeader: "project", projectHeader: "no-such-project"})
+		if err != nil {
+			t.Fatalf("scope=project:no-such-project list: %v", err)
+		}
+		requireNamespaces(t, got) // empty; indistinguishable from a real-but-empty project
+	})
+
+	t.Run("CustomResourcesAreFilteredLikeBuiltins", func(t *testing.T) {
+		crdClient := apiextensionsclientset.NewForConfigOrDie(server.ClientConfig)
+		preserveUnknown := true
+		crd := &apiextensionsv1.CustomResourceDefinition{
+			ObjectMeta: metav1.ObjectMeta{Name: crdPlural + "." + crdGroup},
+			Spec: apiextensionsv1.CustomResourceDefinitionSpec{
+				Group: crdGroup,
+				Scope: apiextensionsv1.NamespaceScoped,
+				Names: apiextensionsv1.CustomResourceDefinitionNames{
+					Plural:   crdPlural,
+					Singular: "widget",
+					Kind:     crdKind,
+					ListKind: crdListKind,
+				},
+				Versions: []apiextensionsv1.CustomResourceDefinitionVersion{{
+					Name:    crdVersion,
+					Served:  true,
+					Storage: true,
+					Schema: &apiextensionsv1.CustomResourceValidation{
+						OpenAPIV3Schema: &apiextensionsv1.JSONSchemaProps{
+							Type:                   "object",
+							XPreserveUnknownFields: &preserveUnknown,
+						},
+					},
+				}},
+			},
+		}
+		if _, err := crdClient.ApiextensionsV1().CustomResourceDefinitions().Create(ctx, crd, metav1.CreateOptions{}); err != nil {
+			t.Fatalf("create CRD: %v", err)
+		}
+
+		crPath := "/apis/" + crdGroup + "/" + crdVersion + "/" + crdPlural
+
+		// Wait until the CRD is served (Established + the wildcard list
+		// endpoint answers), then create one CR per fixture namespace.
+		if err := wait.PollUntilContextTimeout(ctx, 200*time.Millisecond, time.Minute, true, func(ctx context.Context) (bool, error) {
+			if _, err := adminJSON.Discovery().RESTClient().Get().AbsPath(crPath).DoRaw(ctx); err != nil {
+				return false, nil
+			}
+			return true, nil
+		}); err != nil {
+			t.Fatalf("CRD never became served: %v", err)
+		}
+
+		dyn := dynamic.NewForConfigOrDie(server.ClientConfig)
+		gvr := schema.GroupVersionResource{Group: crdGroup, Version: crdVersion, Resource: crdPlural}
+		for _, ns := range probeNamespaces {
+			cr := &unstructured.Unstructured{Object: map[string]interface{}{
+				"apiVersion": crdGroup + "/" + crdVersion,
+				"kind":       crdKind,
+				"metadata":   map[string]interface{}{"name": probeName, "namespace": ns},
+			}}
+			if _, err := dyn.Resource(gvr).Namespace(ns).Create(ctx, cr, metav1.CreateOptions{}); err != nil {
+				t.Fatalf("create %s in %s: %v", crdKind, ns, err)
+			}
+		}
+
+		got, err := scopedProbeNamespaces(crPath, map[string]string{scopeHeader: "project", projectHeader: "alpha"})
+		if err != nil {
+			t.Fatalf("CR scope=project:alpha list: %v", err)
+		}
+		requireNamespaces(t, got, "scope-int-alpha")
+
+		got, err = scopedProbeNamespaces(crPath, map[string]string{scopeHeader: "system"})
+		if err != nil {
+			t.Fatalf("CR scope=system list: %v", err)
+		}
+		requireNamespaces(t, got, "d8-scope-int", "kube-scope-int", "default")
+
+		// Fail-closed applies to CRDs identically.
+		_, err = deniedJSON.Discovery().RESTClient().Get().
+			AbsPath(crPath).SetHeader(scopeHeader, "accessible").DoRaw(ctx)
+		if !apierrors.IsForbidden(coerceStatusError(err)) {
+			t.Fatalf("CR scope=accessible as denied user: expected fail-closed Forbidden, got: %v", err)
+		}
+	})
+
+	t.Run("NewCRDIsFilteredOnTheFirstDeniedScopedRead", func(t *testing.T) {
+		// The CRD handler builds the storage of a CRD -- and registers it for
+		// the filter -- on the first request that reaches it. Nothing below
+		// reaches it before the denied scoped read: the CRD is created and
+		// awaited through the apiextensions API only.
+		crdClient := apiextensionsclientset.NewForConfigOrDie(server.ClientConfig)
