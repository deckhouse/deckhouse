+// createProbeNamespace creates a namespace with the labels and a probe
+// ConfigMap in it.
+func createProbeNamespace(ctx context.Context, t *testing.T, admin clientset.Interface, name string, labels map[string]string) {
+	t.Helper()
+	if _, err := admin.CoreV1().Namespaces().Create(ctx, &corev1.Namespace{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Labels: labels},
+	}, metav1.CreateOptions{}); err != nil {
+		t.Fatalf("create namespace %s: %v", name, err)
+	}
+	if _, err := admin.CoreV1().ConfigMaps(name).Create(ctx, &corev1.ConfigMap{
+		ObjectMeta: metav1.ObjectMeta{Name: probeName},
+	}, metav1.CreateOptions{}); err != nil {
+		t.Fatalf("create probe configmap in %s: %v", name, err)
+	}
+}
