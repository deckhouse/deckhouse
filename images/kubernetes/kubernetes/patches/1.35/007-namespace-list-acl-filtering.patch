+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package scopefilter
+
+import (
+	"context"
+	"os"
+	"sync"
+	"time"
+
+	"k8s.io/apimachinery/pkg/fields"
+	"k8s.io/apimachinery/pkg/labels"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apiserver/pkg/storage"
+	restclient "k8s.io/client-go/rest"
+	"k8s.io/klog/v2"
+)
+
+// Env knobs (read once at construction). Defaults are the safe values; these
+// exist so an operator can tune load vs. responsiveness without a rebuild.
+const (
+	envPollInterval = "SCOPEFILTER_WATCH_POLL_INTERVAL"
+	envCacheTTL     = "SCOPEFILTER_RESOLVE_CACHE_TTL"
+)
+
+// Resolvers bundles the (cache-wrapped) resolvers plus tunables, built once
+// from a loopback REST config and shared across every generic-scope Decorator
+// in the process. The shared cache is what makes concurrent watches across all
+// covered resources collapse to ~one loopback resolve per key per TTL.
+type Resolvers struct {
+	Accessible      AccessibleNamespaceFetcher // caching wrapper
+	Classify        ClassificationResolver     // caching wrapper
+	Floor           RBACFloorResolver          // caching wrapper
+	Membership      ProjectMembershipResolver  // caching wrapper
+	Multitenancy    MultitenancyStateResolver  // caching wrapper
+	RefreshInterval time.Duration
+
+	cache           *resolveCache[map[string]struct{}]
+	membershipCache *resolveCache[map[string]string]
+	accessibleCache *resolveCache[[]string]
+}
+
+// sharedResolvers holds the bundle of every loopback config it was built for.
+// The built-in resources, the custom resources and the namespaces of one
+// kube-apiserver are wired from the same loopback config, so they share one
+// set of clients and one cache; test processes that start several servers get
+// a bundle per server.
+var sharedResolvers = struct {
+	sync.Mutex
+	byConfig map[*restclient.Config]*Resolvers
+}{byConfig: map[*restclient.Config]*Resolvers{}}
+
+// NewLoopbackResolvers returns the bundle of loopbackConfig, building it on
+// first use. Returns (nil, nil) -- not an error -- when loopbackConfig is nil
+// (some minimal/test setups have none); callers treat a nil bundle as "generic
+// scope filtering unavailable this run" and skip wiring, leaving every resource
+// at vanilla behavior.
+func NewLoopbackResolvers(loopbackConfig *restclient.Config) (*Resolvers, error) {
+	if loopbackConfig == nil {
+		return nil, nil
+	}
+
+	sharedResolvers.Lock()
+	defer sharedResolvers.Unlock()
+	if r, ok := sharedResolvers.byConfig[loopbackConfig]; ok {
+		return r, nil
+	}
+	r, err := newLoopbackResolvers(loopbackConfig)
+	if err != nil {
+		return nil, err
+	}
+	sharedResolvers.byConfig[loopbackConfig] = r
+	return r, nil
+}
+
+func newLoopbackResolvers(loopbackConfig *restclient.Config) (*Resolvers, error) {
+	// One reviewer, so one transport and one connection pool, for both
+	// questions put to the permission service.
+	reviewer, err := NewLoopbackScopedAccessReviewer(loopbackConfig)
+	if err != nil {
+		return nil, err
+	}
+	accessible := &LoopbackAccessibleNamespaceFetcher{reviewer: reviewer}
+	floor := &LoopbackRBACFloorResolver{reviewer: reviewer}
+	classify, err := NewLoopbackClassificationResolver(loopbackConfig)
+	if err != nil {
+		return nil, err
+	}
+	membership, err := NewLoopbackProjectMembershipResolver(loopbackConfig)
+	if err != nil {
+		return nil, err
+	}
+	multitenancy, err := NewLoopbackMultitenancyStateResolver(loopbackConfig)
+	if err != nil {
+		return nil, err
+	}
+
+	ttl := envDuration(envCacheTTL, DefaultResolveCacheTTL)
+	interval := envDuration(envPollInterval, DefaultRefreshInterval)
+
+	cache := newResolveCache[map[string]struct{}](ttl)
+	membershipCache := newResolveCache[map[string]string](ttl)
+	accessibleCache := newResolveCache[[]string](ttl)
+	multitenancyCache := newResolveCache[bool](ttl)
+
+	return &Resolvers{
+		Accessible:      &cachingAccessibleNamespaceFetcher{inner: accessible, cache: accessibleCache},
+		Classify:        &cachingClassificationResolver{inner: classify, cache: cache},
+		Floor:           &cachingRBACFloorResolver{inner: floor, cache: cache},
+		Membership:      &cachingProjectMembershipResolver{inner: membership, cache: membershipCache},
+		Multitenancy:    &cachingMultitenancyStateResolver{inner: multitenancy, cache: multitenancyCache},
+		RefreshInterval: interval,
+		cache:           cache,
+		membershipCache: membershipCache,
+		accessibleCache: accessibleCache,
+	}, nil
+}
+
+// NewDecorator builds a generic (IdentityByNamespace, header-triggered)
+// Decorator over the given store. store is passed as a StoreAccessor,
+// buildPredicate as the store's PredicateFunc value and postRead as the
+// store's Decorator value (nil when the resource has none), so this package
+// never imports the concrete *genericregistry.Store (which would be an
+// import cycle -- registry imports scopefilter for the ScopeFilter field).
+// The caller assigns the returned Decorator to store.ScopeFilter and calls
+// Register.
+func (r *Resolvers) NewDecorator(store StoreAccessor, buildPredicate func(labels.Selector, fields.Selector) storage.SelectionPredicate, postRead func(runtime.Object), gvr schema.GroupVersionResource) *Decorator {
+	return &Decorator{
+		Store:           store,
+		BuildPredicate:  buildPredicate,
+		Resource:        gvr,
+		Mode:            IdentityByNamespace,
+		Trigger:         scopeRequestPresent,
+		Classify:        r.Classify,
+		RBACFloor:       r.Floor,
+		Multitenancy:    r.Multitenancy,
+		Accessible:      r.Accessible,
+		RefreshInterval: r.RefreshInterval,
+		PostRead:        postRead,
+	}
+}
+
+// NewIdentityDecorator builds a Decorator for a cluster-scoped resource whose
+// visibility follows the namespace ACL (see IsNamespaceIdentityResource). It
+// runs in IdentityByName mode, over the name-deriving fetcher the allowlist
+// names for the resource, and without Classify/RBACFloor: there is no namespace
+// to classify and no separate resource+verb to narrow a floor against.
+//
+// Returns nil for a resource that is not in the allowlist, or for a bundle
+// missing the resolvers name derivation needs. The caller must treat nil as
+// "leave this storage unfiltered": wiring a filter that cannot derive names
+// would hide everything, and an unwired resource simply stays on plain RBAC,
+// since the authorization bypass only fires for a registered filter.
+func (r *Resolvers) NewIdentityDecorator(
+	store StoreAccessor,
+	buildPredicate func(labels.Selector, fields.Selector) storage.SelectionPredicate,
+	postRead func(runtime.Object),
+	gvr schema.GroupVersionResource,
+) *Decorator {
+	newFetcher, ok := namespaceIdentityResources[gvr.GroupResource()]
+	if !ok || r.Accessible == nil || r.Membership == nil {
+		return nil
+	}
+
+	return &Decorator{
+		Store:           store,
+		BuildPredicate:  buildPredicate,
+		Resource:        gvr,
+		Mode:            IdentityByName,
+		Trigger:         IsNamespaceFilteringMode,
+		Accessible:      newFetcher(r),
+		RefreshInterval: r.RefreshInterval,
+		PostRead:        postRead,
+	}
+}
+
+// scopeRequestPresent is the trigger for every generic-scope resource: route
+// through filtering whenever the request carries a scope header at all. Set by
+// the authorization filter on both the denied-then-bypassed path (also carries
+// IsBypass) and the already-allowed path (does not) -- see WithBypass's doc.
+func scopeRequestPresent(ctx context.Context) bool {
+	_, present := RequestFrom(ctx)
+	return present
+}
+
+func envDuration(name string, def time.Duration) time.Duration {
+	raw := os.Getenv(name)
+	if raw == "" {
+		return def
+	}
+	d, err := time.ParseDuration(raw)
+	if err != nil || d <= 0 {
+		klog.Warningf("scopefilter: ignoring invalid %s=%q: %v; using default %s", name, raw, err, def)
+		return def
+	}
+	return d
+}
