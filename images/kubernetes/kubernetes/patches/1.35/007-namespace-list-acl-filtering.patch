+
+package scopefilter
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"k8s.io/apiserver/pkg/authentication/user"
+	restclient "k8s.io/client-go/rest"
+	"k8s.io/client-go/transport"
+)
+
+const (
+	// defaultHTTPTimeout caps every review call. It must be short enough
+	// that a hung permission service does not stall a List/Watch request,
+	// and a little longer than the 10 seconds the permission service gives
+	// a review itself, so that its own Timeout answer reaches the filter
+	// rather than the call being cut off first.
+	defaultHTTPTimeout = 12 * time.Second
+
+	// errorBodyByteLimit bounds how much of an error response body we
+	// read into memory and surface in error messages. Permission-browser
+	// is trusted, but a misconfigured proxy could splice in arbitrarily
+	// large payloads; 8 KiB is plenty for any sane Status object.
+	errorBodyByteLimit = 8 * 1024
+)
+
+// AccessibleNamespaceFetcher returns the set of namespaces a given user is
+// allowed to see at all (the "accessible" scope's raw material). Repeated
+// calls returning different results as the user's bindings change lets the
+// watch code path synthesize ADDED/DELETED events while a watch is open.
+type AccessibleNamespaceFetcher interface {
+	// FetchAccessibleNamespaces lists all namespace names the user can see.
+	FetchAccessibleNamespaces(ctx context.Context, u user.Info) ([]string, error)
+}
+
+// LoopbackAccessibleNamespaceFetcher answers the accessible namespaces with
+// one SelfScopedAccessReview of listing namespaces. The permission service
+// answers that request by the rule namespace listings are filtered with --
+// the namespaces the caller may see, whatever the verb -- which is the set
+// this fetcher stands for. It deliberately does not ask about get: get of a
+// namespace is checked per namespace, a right namespace roles do not grant,
+// so a project user would lose their own namespaces.
+//
+// A caller allowed to list namespaces in the whole cluster gets
+// ErrClusterWideAccess: the review names no namespaces then.
+type LoopbackAccessibleNamespaceFetcher struct {
+	reviewer *LoopbackScopedAccessReviewer
+}
+
+// Compile-time guard.
+var _ AccessibleNamespaceFetcher = (*LoopbackAccessibleNamespaceFetcher)(nil)
+
+// listNamespaces is the review item the accessible namespaces are read from.
+var listNamespaces = scopedAccessItem{Resource: "namespaces", Verb: "list"}
+
+// NewLoopbackAccessibleNamespaceFetcher builds a fetcher from a loopback
+// REST config. The config is copied internally; callers may safely mutate
+// it after this returns.
+func NewLoopbackAccessibleNamespaceFetcher(loopbackConfig *restclient.Config) (*LoopbackAccessibleNamespaceFetcher, error) {
+	reviewer, err := NewLoopbackScopedAccessReviewer(loopbackConfig)
+	if err != nil {
+		return nil, err
+	}
+	return &LoopbackAccessibleNamespaceFetcher{reviewer: reviewer}, nil
+}
+
+// FetchAccessibleNamespaces lists all namespace names visible to the user.
+func (f *LoopbackAccessibleNamespaceFetcher) FetchAccessibleNamespaces(ctx context.Context, u user.Info) ([]string, error) {
+	names, err := f.reviewer.namespacesWhere(ctx, u, listNamespaces)
+	if err != nil {
+		return nil, fmt.Errorf("accessible namespaces: %w", err)
+	}
+	return names, nil
+}
+
+// newLoopbackRoundTripper builds an authenticated (but not yet impersonated)
+// transport plus the bare scheme+host from a loopback REST config.
+func newLoopbackRoundTripper(loopbackConfig *restclient.Config) (http.RoundTripper, string, error) {
+	if loopbackConfig == nil {
+		return nil, "", errors.New("loopback config is required")
+	}
+
+	cfg := restclient.CopyConfig(loopbackConfig)
+	transportConfig, err := cfg.TransportConfig()
+	if err != nil {
+		return nil, "", fmt.Errorf("get transport config: %w", err)
+	}
+
+	rt, err := transport.New(transportConfig)
+	if err != nil {
+		return nil, "", fmt.Errorf("build loopback transport: %w", err)
+	}
+
+	return rt, strings.TrimRight(cfg.Host, "/"), nil
+}
+
+// impersonatedHTTPClient returns an http.Client whose transport prepends
+// impersonation headers identifying u, then delegates to rt. Cheap to
+// construct: no new pools, no new TLS sessions. Per-user clients are
+// deliberately not cached -- the reviewer is shared across all users on the
+// apiserver, and caching would either grow unbounded or require an LRU;
+// per-call construction is simpler and the allocations are noise.
+func impersonatedHTTPClient(rt http.RoundTripper, u user.Info, timeout time.Duration) *http.Client {
+	// NOTE: extra keys may contain characters that are illegal in HTTP
+	// header field names (e.g. '/'). transport.NewImpersonatingRoundTripper
+	// applies the same key-escaping that kube-apiserver uses on the receive
+	// side, so we get cross-component agreement for free.
+	impRT := transport.NewImpersonatingRoundTripper(transport.ImpersonationConfig{
+		UserName: u.GetName(),
+		Groups:   u.GetGroups(),
+		Extra:    u.GetExtra(),
+	}, rt)
+
+	return &http.Client{
+		Transport: impRT,
+		Timeout:   timeout,
+	}
+}
+
+// readErrorBody reads up to errorBodyByteLimit bytes of an HTTP response
+// body for inclusion in error messages. The read error is intentionally
+// swallowed -- we are already on the error path and the partial body is
+// more useful than nothing.
+func readErrorBody(body io.Reader) string {
+	b, _ := io.ReadAll(io.LimitReader(body, errorBodyByteLimit))
+	return string(b)
+}
