+// ----- generic (IdentityByNamespace) watch synthesis ------------------------
+
+// TestFilteredWatch_IdentityByNamespace_SynthesizesAcrossNamespaceGainAndLoss
+// is the direct regression test for the riskiest previously-untested code
+// path: unlike namespaces (IdentityByName, one object per identity), a
+// single namespace gain/loss here must synthesize ADDED/DELETED for EVERY
+// item in that namespace, and FilteredWatch must remember exactly what it
+// synthesized so it can retract the right set later.
+func TestFilteredWatch_IdentityByNamespace_SynthesizesAcrossNamespaceGainAndLoss(t *testing.T) {
+	store := newFakeStore()
+	store.put("ns-a", "pod-1")
+	store.put("ns-b", "pod-2")
+	store.put("ns-b", "pod-3")
+
+	selector := scopefilter.NewNameSetSelector(scopefilter.NamespaceField, map[string]struct{}{"ns-a": {}})
+
+	var mu sync.Mutex
+	current := map[string]struct{}{"ns-a": {}}
+	poll := func(context.Context) (map[string]struct{}, error) {
+		mu.Lock()
+		defer mu.Unlock()
+		out := make(map[string]struct{}, len(current))
+		for k := range current {
+			out[k] = struct{}{}
+		}
+		return out, nil
+	}
+
+	w := scopefilter.NewFilteredWatch(context.Background(), scopefilter.WatchConfig{
+		Inner:           newFakeWatch(),
+		Selector:        selector,
+		Mode:            scopefilter.IdentityByNamespace,
+		Store:           store,
+		BuildPredicate:  store.buildPredicate,
+		CallerLabel:     labels.Everything(),
+		CallerField:     fields.Everything(),
+		Poll:            poll,
+		Initial:         map[string]struct{}{"ns-a": {}},
+		RefreshInterval: 20 * time.Millisecond,
+		UserName:        "alice",
+	})
+	defer w.Stop()
+
+	mu.Lock()
+	current = map[string]struct{}{"ns-a": {}, "ns-b": {}}
+	mu.Unlock()
+
+	added := collectEvents(t, w.ResultChan(), watch.Added, "ns-b", 3*time.Second, "pod-2", "pod-3")
+	if !added {
+		t.Fatal("did not observe synthesized ADDED for both ns-b pods within 3s of gaining ns-b")
+	}
+
+	mu.Lock()
+	current = map[string]struct{}{"ns-a": {}}
+	mu.Unlock()
+
+	deleted := collectEvents(t, w.ResultChan(), watch.Deleted, "ns-b", 3*time.Second, "pod-2", "pod-3")
+	if !deleted {
+		t.Fatal("did not observe synthesized DELETED for both ns-b pods within 3s of losing ns-b")
+	}
+}
+
+// TestFilteredWatch_SynthesizedDeletedCarriesTheLastSeenResourceVersion: the
+// object of a DELETED synthesized for lost access carries the name, the
+// namespace and the last resourceVersion the watch has seen on the stream, a
+// bookmark's included -- not the item's own, older one -- so the client's
+// resourceVersion keeps moving forward.
+func TestFilteredWatch_SynthesizedDeletedCarriesTheLastSeenResourceVersion(t *testing.T) {
+	store := newFakeStore()
+	store.put("ns-a", "pod-1")
+	store.put("ns-b", "pod-2")
+	store.items["ns-b"]["pod-2"].ResourceVersion = "42"
+
+	var mu sync.Mutex
+	current := map[string]struct{}{"ns-a": {}}
+	poll := func(context.Context) (map[string]struct{}, error) {
+		mu.Lock()
+		defer mu.Unlock()
+		out := make(map[string]struct{}, len(current))
+		for k := range current {
+			out[k] = struct{}{}
+		}
+		return out, nil
+	}
+
+	inner := newFakeWatch()
+	w := scopefilter.NewFilteredWatch(context.Background(), scopefilter.WatchConfig{
+		Inner:           inner,
+		Selector:        scopefilter.NewNameSetSelector(scopefilter.NamespaceField, map[string]struct{}{"ns-a": {}}),
+		Mode:            scopefilter.IdentityByNamespace,
+		Store:           store,
+		BuildPredicate:  store.buildPredicate,
+		CallerLabel:     labels.Everything(),
+		CallerField:     fields.Everything(),
+		Poll:            poll,
+		Initial:         map[string]struct{}{"ns-a": {}},
+		RefreshInterval: 20 * time.Millisecond,
+		UserName:        "alice",
+	})
+	defer w.Stop()
+
+	mu.Lock()
+	current = map[string]struct{}{"ns-a": {}, "ns-b": {}}
+	mu.Unlock()
+	if !collectEvents(t, w.ResultChan(), watch.Added, "ns-b", 3*time.Second, "pod-2") {
+		t.Fatal("did not observe the synthesized ADDED of pod-2")
+	}
+
+	inner.ch <- watch.Event{Type: watch.Bookmark, Object: &fakeItem{ObjectMeta: metav1.ObjectMeta{ResourceVersion: "57"}}}
+	bookmarkDeadline := time.After(3 * time.Second)
+	for bookmarked := false; !bookmarked; {
+		select {
+		case ev := <-w.ResultChan():
+			bookmarked = ev.Type == watch.Bookmark
+		case <-bookmarkDeadline:
+			t.Fatal("the bookmark was not passed through")
+		}
+	}
+
+	mu.Lock()
+	current = map[string]struct{}{"ns-a": {}}
+	mu.Unlock()
+
+	deadline := time.After(3 * time.Second)
+	for {
+		select {
+		case ev := <-w.ResultChan():
+			item, ok := ev.Object.(*fakeItem)
+			if ev.Type != watch.Deleted || !ok || item.Name != "pod-2" {
+				continue
+			}
+			if item.ResourceVersion != "57" {
+				t.Fatalf("synthesized DELETED resourceVersion = %q, want 57, the bookmark's", item.ResourceVersion)
+			}
+			return
+		case <-deadline:
+			t.Fatal("did not observe the synthesized DELETED of pod-2")
+		}
+	}
+}
