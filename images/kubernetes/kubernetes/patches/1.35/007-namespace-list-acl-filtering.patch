+package scopefilter
+
+import (
+	"context"
+	"errors"
+
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apiserver/pkg/authentication/user"
+)
+
+// namespaceIdentityResources are the CLUSTER-scoped resources whose visibility
+// is decided by the namespace ACL, mapped to how their object names are derived
+// from the namespaces a user may see. Reusing the ACL is what keeps this cheap:
+// no second permission endpoint, no per-object authorization, and the derived
+// name set drops straight into the IdentityByName machinery the namespaces
+// storage already uses.
+//
+// Membership in this map has an authorization consequence -- reads of these
+// resources are answered with a filtered list instead of a 403 (see
+// isNamespaceListGetOrWatchRequest) -- so it is an allowlist, never a blanket
+// rule for cluster-scoped resources.
+var namespaceIdentityResources = map[schema.GroupResource]func(*Resolvers) AccessibleNamespaceFetcher{
+	{Group: "deckhouse.io", Resource: "projects"}: func(r *Resolvers) AccessibleNamespaceFetcher {
+		return &projectFetcher{accessible: r.Accessible, membership: r.Membership}
+	},
+}
+
+// IsNamespaceIdentityResource reports whether the resource's visibility is
+// derived from the namespace ACL. Consulted when wiring the storage (which
+// fetcher the Decorator gets) and by the authorization filter (whether a denied
+// read may be answered with a filtered list instead).
+func IsNamespaceIdentityResource(gr schema.GroupResource) bool {
+	_, ok := namespaceIdentityResources[gr]
+
+	return ok
+}
+
+// projectFetcher answers "which Projects may this user see" in the shape an
+// IdentityByName Decorator consumes: a set of object NAMES. A project is
+// visible when ANY of its namespaces is -- the main one, which carries the
+// project's own name, or an additional one ordered through a ProjectNamespace
+// -- because multitenancy-manager stamps ProjectLabel on all of them alike. A
+// namespace without the label, or with an empty value, shows the virtual
+// project multitenancy-manager inventories it in (projectOf): deckhouse for
+// its system namespaces, default for the rest. The project is never derived
+// from the name of a namespace otherwise. It is about the listing of projects
+// only: the projects and project scopes do not take such a namespace.
+//
+// Deriving names this way rather than comparing them keeps the whole existing
+// pipeline intact: the derived set is still matched against metadata.name by
+// the same field selector, and the watch poller still synthesizes ADDED events
+// by diffing successive sets. Gaining access to a namespace therefore surfaces
+// its project within one refresh interval, with no extra machinery.
+type projectFetcher struct {
+	accessible AccessibleNamespaceFetcher
+	membership ProjectMembershipResolver
+}
+
+var _ AccessibleNamespaceFetcher = (*projectFetcher)(nil)
+
+// FetchAccessibleNamespaces returns project names, not namespace names -- the
+// identity the caller filters on. Both underlying answers are cached and
+// user-independent (membership) or already needed anyway (the ACL), so this
+// costs no extra round trip per request.
+func (f *projectFetcher) FetchAccessibleNamespaces(ctx context.Context, u user.Info) ([]string, error) {
+	namespaces, err := f.accessible.FetchAccessibleNamespaces(ctx, u)
+	allNamespaces := errors.Is(err, ErrClusterWideAccess)
+	if err != nil && !allNamespaces {
+		return nil, err
+	}
+	membership, err := f.membership.Resolve(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if allNamespaces {
+		// The caller may see every namespace, so every project: kube-apiserver
+		// denied projects, not namespaces, so this is no disagreement.
+		namespaces = make([]string, 0, len(membership))
+		for namespace := range membership {
+			namespaces = append(namespaces, namespace)
+		}
+	}
+
+	// A namespace membership does not know was created after its snapshot:
+	// it shows no project until the next one.
+	projects := make(map[string]struct{}, len(namespaces)+2)
+	for _, namespace := range namespaces {
+		if project, ok := membership[namespace]; ok {
+			projects[project] = struct{}{}
+		}
+	}
+	if allNamespaces {
+		// Every project includes the virtual ones, whichever namespaces they
+		// inventory: the derived set is matched against metadata.name, so a
+		// virtual project the cluster does not serve costs nothing.
+		projects[defaultProject] = struct{}{}
+		projects[deckhouseProject] = struct{}{}
+	}
+
+	names := make([]string, 0, len(projects))
+	for project := range projects {
+		names = append(names, project)
+	}
+	return names, nil
+}
