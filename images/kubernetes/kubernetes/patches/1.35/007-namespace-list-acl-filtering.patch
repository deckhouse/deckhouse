+*/
+
+package scopefilter
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apiserver/pkg/authentication/user"
+)
+
+// countingFloorResolver records how many times the (uncached) inner resolver
+// actually ran, and returns a per-identity distinct set so a cross-user leak
+// is detectable.
+type countingFloorResolver struct {
+	mu    sync.Mutex
+	calls map[string]int
+	// setFor maps a user name to the namespace set that user should get.
+	setFor map[string]map[string]struct{}
+}
+
+func (r *countingFloorResolver) Resolve(_ context.Context, u user.Info, _ schema.GroupVersionResource, _, _ string) (map[string]struct{}, error) {
+	r.mu.Lock()
+	r.calls[u.GetName()]++
+	r.mu.Unlock()
+	return r.setFor[u.GetName()], nil
+}
+
+func (r *countingFloorResolver) callCount(name string) int {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.calls[name]
+}
+
+func gvrPods() schema.GroupVersionResource {
+	return schema.GroupVersionResource{Group: "", Version: "v1", Resource: "pods"}
+}
+
+// TestCache_DedupesConcurrentSameKey: many concurrent Resolve calls for the
+// same identity+resource+verb collapse to a single inner call (singleflight +
+// TTL) -- the whole point, since that's the watch-poll amplification case.
+func TestCache_DedupesConcurrentSameKey(t *testing.T) {
+	inner := &countingFloorResolver{
+		calls:  map[string]int{},
+		setFor: map[string]map[string]struct{}{"alice": {"ns-a": {}}},
+	}
+	c := newResolveCache[map[string]struct{}](time.Minute) // long TTL: all hits share one load
+	cached := &cachingRBACFloorResolver{inner: inner, cache: c}
+
+	alice := &user.DefaultInfo{Name: "alice", Groups: []string{"g1"}}
+	var wg sync.WaitGroup
+	for i := 0; i < 50; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			got, err := cached.Resolve(context.Background(), alice, gvrPods(), "", "list")
+			if err != nil {
+				t.Errorf("Resolve: %v", err)
+				return
+			}
+			if _, ok := got["ns-a"]; !ok || len(got) != 1 {
+				t.Errorf("alice got %v, want {ns-a}", got)
+			}
+		}()
+	}
+	wg.Wait()
+
+	if n := inner.callCount("alice"); n != 1 {
+		t.Fatalf("inner resolver ran %d times for 50 concurrent same-key calls, want 1", n)
+	}
+}
+
+// TestCache_DistinctIdentitiesNeverCollide is the adversarial test flagged in
+// review: the ONE cache bug that escalates privilege rather than merely going
+// stale. Two identities that differ only in groups (and separately only in
+// uid) must get SEPARATE entries and SEPARATE inner calls -- one user's floor
+// must never be served to another.
+func TestCache_DistinctIdentitiesNeverCollide(t *testing.T) {
+	// Names collide by design here, so the inner resolver keys on the FULL
+	// identity (userCacheKey) and returns a distinct set per identity; a
+	// cross-identity cache leak would surface as the wrong set.
+	perIdentity := &identityKeyedResolver{
+		calls:   map[string]int{},
+		results: map[string]map[string]struct{}{},
+	}
+	c := newResolveCache[map[string]struct{}](time.Minute)
+	cached := &cachingRBACFloorResolver{inner: perIdentity, cache: c}
+
+	// Three identities: same name, but distinct groups / uid.
+	u1 := &user.DefaultInfo{Name: "same-name", UID: "uid-1", Groups: []string{"team-a"}}
+	u2 := &user.DefaultInfo{Name: "same-name", UID: "uid-1", Groups: []string{"team-b"}} // differs in groups
+	u3 := &user.DefaultInfo{Name: "same-name", UID: "uid-2", Groups: []string{"team-a"}} // differs in uid
+
+	perIdentity.results[userCacheKey(u1)] = map[string]struct{}{"ns-1": {}}
+	perIdentity.results[userCacheKey(u2)] = map[string]struct{}{"ns-2": {}}
+	perIdentity.results[userCacheKey(u3)] = map[string]struct{}{"ns-3": {}}
+
+	for _, tc := range []struct {
+		u    user.Info
+		want string
+	}{{u1, "ns-1"}, {u2, "ns-2"}, {u3, "ns-3"}} {
+		got, err := cached.Resolve(context.Background(), tc.u, gvrPods(), "", "list")
+		if err != nil {
+			t.Fatalf("Resolve: %v", err)
+		}
+		if _, ok := got[tc.want]; !ok || len(got) != 1 {
+			t.Fatalf("identity uid=%q groups=%v got %v, want {%s} -- CROSS-IDENTITY CACHE LEAK",
+				tc.u.GetUID(), tc.u.GetGroups(), got, tc.want)
+		}
+	}
+}
+
+type identityKeyedResolver struct {
+	mu      sync.Mutex
+	calls   map[string]int
+	results map[string]map[string]struct{}
+}
+
+func (r *identityKeyedResolver) Resolve(_ context.Context, u user.Info, _ schema.GroupVersionResource, _, _ string) (map[string]struct{}, error) {
+	k := userCacheKey(u)
+	r.mu.Lock()
+	r.calls[k]++
+	r.mu.Unlock()
+	return r.results[k], nil
+}
+
+// TestCache_ClassificationSharedAcrossUsers: classification is user-independent,
+// so the caching classification resolver keys on (kind, project) only and
+// serves one inner call to many distinct users.
+func TestCache_ClassificationSharedAcrossUsers(t *testing.T) {
+	var innerCalls int32
+	inner := classifyFunc(func(_ context.Context, kind Kind, _ string) (map[string]struct{}, error) {
+		atomic.AddInt32(&innerCalls, 1)
+		return map[string]struct{}{"sys-ns": {}}, nil
+	})
+	c := newResolveCache[map[string]struct{}](time.Minute)
+	cached := &cachingClassificationResolver{inner: inner, cache: c}
+
+	// Two different users asking for the same classification kind -> one load.
+	for _, name := range []string{"alice", "bob"} {
+		_ = name
+		got, err := cached.Resolve(context.Background(), KindSystem, "")
+		if err != nil {
+			t.Fatalf("Resolve: %v", err)
+		}
+		if _, ok := got["sys-ns"]; !ok {
+			t.Fatalf("got %v, want {sys-ns}", got)
+		}
+	}
+	if n := atomic.LoadInt32(&innerCalls); n != 1 {
+		t.Fatalf("classification inner ran %d times, want 1 (must be shared across users)", n)
+	}
+}
+
+type classifyFunc func(context.Context, Kind, string) (map[string]struct{}, error)
+
+func (f classifyFunc) Resolve(ctx context.Context, kind Kind, project string) (map[string]struct{}, error) {
+	return f(ctx, kind, project)
+}
+
+// TestCache_TTLExpiry: after the TTL elapses a fresh inner call is made.
+func TestCache_TTLExpiry(t *testing.T) {
+	inner := &countingFloorResolver{
+		calls:  map[string]int{},
+		setFor: map[string]map[string]struct{}{"alice": {"ns-a": {}}},
+	}
+	c := newResolveCache[map[string]struct{}](time.Minute)
+	// Drive time manually.
+	nowT := time.Now()
+	c.now = func() time.Time { return nowT }
+	cached := &cachingRBACFloorResolver{inner: inner, cache: c}
+	alice := &user.DefaultInfo{Name: "alice"}
+
+	if _, err := cached.Resolve(context.Background(), alice, gvrPods(), "", "list"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := cached.Resolve(context.Background(), alice, gvrPods(), "", "list"); err != nil {
+		t.Fatal(err)
+	}
+	if n := inner.callCount("alice"); n != 1 {
+		t.Fatalf("within TTL: inner ran %d times, want 1", n)
+	}
+	nowT = nowT.Add(2 * time.Minute) // past TTL
+	if _, err := cached.Resolve(context.Background(), alice, gvrPods(), "", "list"); err != nil {
+		t.Fatal(err)
+	}
+	if n := inner.callCount("alice"); n != 2 {
+		t.Fatalf("after TTL: inner ran %d times, want 2", n)
+	}
+}
+
+// TestCache_ErrorsNotCached: a failing load is not cached; the next call
+// retries.
+func TestCache_ErrorsNotCached(t *testing.T) {
+	var calls int32
+	fail := true
+	inner := classifyFunc(func(_ context.Context, _ Kind, _ string) (map[string]struct{}, error) {
+		atomic.AddInt32(&calls, 1)
+		if fail {
+			return nil, context.DeadlineExceeded
+		}
+		return map[string]struct{}{"ns": {}}, nil
+	})
+	c := newResolveCache[map[string]struct{}](time.Minute)
+	cached := &cachingClassificationResolver{inner: inner, cache: c}
+
+	if _, err := cached.Resolve(context.Background(), KindProjects, ""); err == nil {
+		t.Fatal("expected error on first call")
+	}
+	fail = false
+	got, err := cached.Resolve(context.Background(), KindProjects, "")
+	if err != nil {
+		t.Fatalf("second call: %v", err)
+	}
+	if _, ok := got["ns"]; !ok {
+		t.Fatalf("got %v, want {ns}", got)
+	}
+	if n := atomic.LoadInt32(&calls); n != 2 {
+		t.Fatalf("inner ran %d times, want 2 (error must not have been cached)", n)
+	}
+}
+
+// countingAccessible records how many times the inner fetcher ran per user.
+type countingAccessible struct {
+	mu    sync.Mutex
+	calls map[string]int
+}
+
+func (f *countingAccessible) FetchAccessibleNamespaces(_ context.Context, u user.Info) ([]string, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.calls[u.GetName()]++
+	return []string{u.GetName() + "-ns"}, nil
+}
+
+func (f *countingAccessible) callCount(name string) int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.calls[name]
+}
+
+// TestCachingAccessibleNamespaceFetcher_OneCallPerUserAndTTL: repeated polls of
+// one user within the TTL cost one inner call, and users never share an entry.
+func TestCachingAccessibleNamespaceFetcher_OneCallPerUserAndTTL(t *testing.T) {
+	inner := &countingAccessible{calls: map[string]int{}}
+	fetcher := &cachingAccessibleNamespaceFetcher{inner: inner, cache: newResolveCache[[]string](time.Minute)}
+	alice := &user.DefaultInfo{Name: "alice"}
+	bob := &user.DefaultInfo{Name: "bob"}
+
+	for range 5 {
+		got, err := fetcher.FetchAccessibleNamespaces(context.Background(), alice)
+		if err != nil {
+			t.Fatalf("alice: %v", err)
+		}
+		if len(got) != 1 || got[0] != "alice-ns" {
+			t.Fatalf("alice got %v, want [alice-ns]", got)
+		}
+	}
+	got, err := fetcher.FetchAccessibleNamespaces(context.Background(), bob)
+	if err != nil {
+		t.Fatalf("bob: %v", err)
+	}
+	if len(got) != 1 || got[0] != "bob-ns" {
+		t.Fatalf("bob got %v, want [bob-ns]: an entry leaked across users", got)
+	}
+	if n := inner.callCount("alice"); n != 1 {
+		t.Fatalf("alice inner calls = %d, want 1", n)
+	}
+	if n := inner.callCount("bob"); n != 1 {
+		t.Fatalf("bob inner calls = %d, want 1", n)
+	}
+}
+
+// TestCache_BoundedSize: a full cache does not grow; once its entries expire
+// a sweep makes room again.
+func TestCache_BoundedSize(t *testing.T) {
+	now := time.Unix(1_000_000, 0)
+	c := newResolveCache[int](time.Second)
+	c.maxEntries = 2
+	c.now = func() time.Time { return now }
+
+	c.set("a", 1)
+	c.set("b", 2)
+	c.set("c", 3)
+	if _, ok := c.get("c"); ok {
+		t.Fatal("a full cache stored a third entry")
+	}
+	if len(c.entries) != 2 {
+		t.Fatalf("entries = %d, want 2", len(c.entries))
+	}
+	c.set("a", 10)
+	if v, ok := c.get("a"); !ok || v != 10 {
+		t.Fatalf("refreshing an existing key in a full cache: got %v, %v; want 10, true", v, ok)
+	}
+
+	now = now.Add(2 * time.Second)
+	c.set("c", 3)
+	if v, ok := c.get("c"); !ok || v != 3 {
+		t.Fatalf("after expiry: got %v, %v; want 3, true", v, ok)
+	}
+}
+
+// TestCache_FloorKeyedBySubresource: a floor of a subresource is never served
+// from the entry of its resource.
+func TestCache_FloorKeyedBySubresource(t *testing.T) {
+	inner := &countingFloorResolver{calls: map[string]int{}, setFor: map[string]map[string]struct{}{"alice": {"ns-a": {}}}}
+	cached := &cachingRBACFloorResolver{inner: inner, cache: newResolveCache[map[string]struct{}](time.Minute)}
+	alice := &user.DefaultInfo{Name: "alice"}
+
+	for _, subresource := range []string{"", "status", "", "status"} {
+		if _, err := cached.Resolve(context.Background(), alice, gvrPods(), subresource, "get"); err != nil {
+			t.Fatalf("Resolve(%q): %v", subresource, err)
+		}
+	}
+	if n := inner.callCount("alice"); n != 2 {
+		t.Fatalf("inner calls = %d, want 2: one for pods and one for pods/status", n)
+	}
+}
