+
+package scopefilter
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes"
+	restclient "k8s.io/client-go/rest"
+)
+
+// The ConfigMap the user-authz module renders in every edition, CE included,
+// and the key in it that says whether the multitenancy-manager module is
+// enabled.
+const (
+	multitenancyStateNamespace = "d8-user-authz"
+	multitenancyStateName      = "d8-user-authz-multitenancy-state"
+	multitenancyManagerKey     = "multitenancyManagerEnabled"
+)
+
+// ErrScopeRequiresMultitenancyManager is returned for the projects and
+// project scopes while the multitenancy-manager module is disabled. Storage
+// answers it with 400: projects are what that module maintains, and project
+// labels left behind after it was turned off are not a classification
+// anybody keeps up to date.
+var ErrScopeRequiresMultitenancyManager = errors.New("scopefilter: the projects and project scopes require the multitenancy-manager module, which is disabled")
+
+// MultitenancyStateResolver says whether the multitenancy-manager module is
+// known to be disabled. Like ClassificationResolver it is
+// identity-independent, so one answer is shared by every caller.
+type MultitenancyStateResolver interface {
+	// ProjectScopesDisabled is true only when the module is known to be
+	// disabled. A state that is not known -- no ConfigMap or no key, as
+	// before user-authz renders it during an update -- is false: the
+	// projects scopes keep working from project labels, as they did before
+	// the state existed.
+	ProjectScopesDisabled(ctx context.Context) (bool, error)
+}
+
+// LoopbackMultitenancyStateResolver reads the state from the ConfigMap of
+// user-authz through the loopback client. No permission service is involved,
+// so it works in CE too.
+type LoopbackMultitenancyStateResolver struct {
+	client kubernetes.Interface
+}
+
+var _ MultitenancyStateResolver = (*LoopbackMultitenancyStateResolver)(nil)
+
+// NewLoopbackMultitenancyStateResolver builds a resolver from a loopback REST
+// config. The config is copied internally by kubernetes.NewForConfig;
+// callers may safely mutate it after this returns.
+func NewLoopbackMultitenancyStateResolver(loopbackConfig *restclient.Config) (*LoopbackMultitenancyStateResolver, error) {
+	cfg := restclient.CopyConfig(loopbackConfig)
+	client, err := kubernetes.NewForConfig(cfg)
+	if err != nil {
+		return nil, fmt.Errorf("build multitenancy state client: %w", err)
+	}
+	return &LoopbackMultitenancyStateResolver{client: client}, nil
+}
+
+// ProjectScopesDisabled implements MultitenancyStateResolver.
+func (r *LoopbackMultitenancyStateResolver) ProjectScopesDisabled(ctx context.Context) (bool, error) {
+	state, err := r.client.CoreV1().ConfigMaps(multitenancyStateNamespace).Get(ctx, multitenancyStateName, metav1.GetOptions{})
+	if apierrors.IsNotFound(err) {
+		return false, nil
+	}
+	if err != nil {
+		return false, fmt.Errorf("get multitenancy state: %w", err)
+	}
+	return state.Data[multitenancyManagerKey] == "false", nil
+}
+
+// cachingMultitenancyStateResolver caches the state under one key, like the
+// project membership.
+type cachingMultitenancyStateResolver struct {
+	inner MultitenancyStateResolver
+	cache *resolveCache[bool]
+}
+
+var _ MultitenancyStateResolver = (*cachingMultitenancyStateResolver)(nil)
+
+func (r *cachingMultitenancyStateResolver) ProjectScopesDisabled(_ context.Context) (bool, error) {
+	return r.cache.getOrLoad(keyField("multitenancy"), func(ctx context.Context) (bool, error) {
+		return r.inner.ProjectScopesDisabled(ctx)
+	})
+}
