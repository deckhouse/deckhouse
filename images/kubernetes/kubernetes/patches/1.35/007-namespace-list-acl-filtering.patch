+// TestIntegration_AttackScenario_NarrowRBACMustNotLeakSystemNamespacePods is
+// the mandatory "attack" test from the design doc, run through the REAL
+// network path this time: a caller with RBAC for `get secrets` (not pods) in
+// d8-ns-sys -- which classifies as "system" by its name-allowlisted d8-*
+// prefix -- must see nothing when requesting `pods --scope=system`, even
+// though d8-ns-sys is also an accessible namespace (some access, just
+// not to pods).
+func TestIntegration_AttackScenario_NarrowRBACMustNotLeakSystemNamespacePods(t *testing.T) {
+	store, destroy := newIntegrationStore(t)
+	defer destroy()
+
+	srv := newFakeLoopbackServer(t,
+		[]corev1.Namespace{
+			namespaceWithProjectLabel("d8-ns-sys", ""), // system: name-allowlisted prefix
+			namespaceWithProjectLabel("ns-b", "team-a"),
+		},
+		[]string{"d8-ns-sys"}, // accessible namespaces: caller has SOME access to d8-ns-sys
+		[]accessRule{
+			// Caller can list secrets in d8-ns-sys, but NOT pods.
+			{namespace: "d8-ns-sys", resource: "secrets", verb: "list", allowed: true},
+		},
+	)
+
+	decorator := buildDecorator(t, store, srv)
+	ctx := scopeCtx(t, decorator, scopefilter.Request{Kind: scopefilter.KindSystem}, true)
+
+	out, err := decorator.List(ctx, nil)
+	if err != nil {
+		t.Fatalf("List: %v", err)
+	}
+	if got := podNames(t, out); len(got) != 0 {
+		t.Fatalf("attack scenario leaked pods: got %v, want none (floor for pods/list in d8-ns-sys was never granted)", got)
+	}
+}
