+	if gotLabelSelector != "" {
+		t.Fatalf("labelSelector = %q, want every namespace", gotLabelSelector)
+	}
+
+	want := map[string]string{
+		"team-a":                    "team-a",
+		"team-a-stage":              "team-a",
+		"team-b":                    "team-b",
+		"empty-value":               "default",
+		"d8-monitoring":             "deckhouse",
+		"kube-system":               "deckhouse",
+		"upmeter-probe-namespace-x": "deckhouse",
+		"ingress":                   "deckhouse",
+		"probe":                     "deckhouse",
+		"deckhouse":                 "default",
+		"sandbox":                   "default",
+		"default":                   "default",
+	}
+	if len(got) != len(want) {
+		t.Fatalf("membership = %v, want %v", got, want)
+	}
+	for namespace, project := range want {
+		if got[namespace] != project {
+			t.Fatalf("membership = %v, want %v", got, want)
+		}
+	}
+}
