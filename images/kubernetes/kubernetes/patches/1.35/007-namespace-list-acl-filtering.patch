+
+package scopefilter
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+	"time"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/fields"
+	"k8s.io/apimachinery/pkg/labels"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/watch"
+	"k8s.io/apiserver/pkg/authentication/user"
+	"k8s.io/component-base/metrics"
+	"k8s.io/component-base/metrics/testutil"
+)
+
+func counterValue(t *testing.T, c metrics.CounterMetric) float64 {
+	t.Helper()
+	v, err := testutil.GetCounterMetricValue(c)
+	if err != nil {
+		t.Fatalf("read counter: %v", err)
+	}
+	return v
+}
+
+// TestMetrics_AllowedSetFailure: a request answered with 403 because the
+// allowed set could not be resolved is counted by operation as denied; a 400
+// for a scope the cluster cannot serve is not a failure and is not counted.
+func TestMetrics_AllowedSetFailure(t *testing.T) {
+	d := &Decorator{Resource: schema.GroupVersionResource{Version: "v1", Resource: "pods"}}
+	alice := &user.DefaultInfo{Name: "alice"}
+	before := counterValue(t, allowedSetFailures.WithLabelValues("list", "denied"))
+
+	d.resolveError(alice, "List", "", errors.New("permission browser answered 404"), errCannotList)
+	d.resolveError(alice, "List", "", ErrScopeRequiresMultitenancyManager, errCannotList)
+
+	if got := counterValue(t, allowedSetFailures.WithLabelValues("list", "denied")) - before; got != 1 {
+		t.Fatalf("denied list failures grew by %v, want 1", got)
+	}
+}
+
+// TestMetrics_AllowedSetUnavailable: a request answered with 503 because the
+// permission service cannot answer now is counted as unavailable, apart from
+// the requests refused with 403, and the answer asks the client to retry.
+func TestMetrics_AllowedSetUnavailable(t *testing.T) {
+	d := &Decorator{Resource: schema.GroupVersionResource{Version: "v1", Resource: "pods"}}
+	alice := &user.DefaultInfo{Name: "alice"}
+	unavailableBefore := counterValue(t, allowedSetFailures.WithLabelValues("watch", "unavailable"))
+	deniedBefore := counterValue(t, allowedSetFailures.WithLabelValues("watch", "denied"))
+
+	err := d.resolveError(alice, "Watch", "", fmt.Errorf("rbac floor: %w", ErrPermissionServiceUnavailable), errCannotWatch)
+
+	if !apierrors.IsServiceUnavailable(err) {
+		t.Fatalf("error = %v, want ServiceUnavailable", err)
+	}
+	if seconds, ok := apierrors.SuggestsClientDelay(err); !ok || seconds != unavailableRetryAfterSeconds {
+		t.Fatalf("retry after = %d, %v; want %d", seconds, ok, unavailableRetryAfterSeconds)
+	}
+	if got := counterValue(t, allowedSetFailures.WithLabelValues("watch", "unavailable")) - unavailableBefore; got != 1 {
+		t.Fatalf("unavailable watch failures grew by %v, want 1", got)
+	}
+	if got := counterValue(t, allowedSetFailures.WithLabelValues("watch", "denied")) - deniedBefore; got != 0 {
+		t.Fatalf("denied watch failures grew by %v, want 0", got)
+	}
+}
+
+// TestMetrics_ClusterDisagreement: a denied request the permission service
+// allows in the whole cluster is counted as a disagreement, not as a failure
+// to resolve the set.
+func TestMetrics_ClusterDisagreement(t *testing.T) {
+	d := &Decorator{Resource: schema.GroupVersionResource{Version: "v1", Resource: "pods"}}
+	alice := &user.DefaultInfo{Name: "alice"}
+	disagreementsBefore := counterValue(t, clusterDisagreements)
+	failuresBefore := counterValue(t, allowedSetFailures.WithLabelValues("list", "denied"))
+
+	err := d.resolveError(alice, "List", "", fmt.Errorf("rbac floor: %w", ErrClusterWideAccess), errCannotList)
+
+	if !apierrors.IsForbidden(err) {
+		t.Fatalf("error = %v, want Forbidden", err)
+	}
+	if got := counterValue(t, clusterDisagreements) - disagreementsBefore; got != 1 {
+		t.Fatalf("disagreements grew by %v, want 1", got)
+	}
+	if got := counterValue(t, allowedSetFailures.WithLabelValues("list", "denied")) - failuresBefore; got != 0 {
+		t.Fatalf("list failures grew by %v, want 0", got)
+	}
+}
+
+type emptyStore struct{ StoreAccessor }
+
+// TestMetrics_WatchRefreshFailuresAndClose: every failed refresh of an open
+// watch is counted, and so is the close once the limit is reached.
+func TestMetrics_WatchRefreshFailuresAndClose(t *testing.T) {
+	previous := watchRefreshFailureLimit
+	watchRefreshFailureLimit = 50 * time.Millisecond
+	t.Cleanup(func() { watchRefreshFailureLimit = previous })
+
+	failuresBefore := counterValue(t, watchRefreshFailures)
+	closedBefore := counterValue(t, watchClosed.WithLabelValues("refresh_failures"))
+
+	w := NewFilteredWatch(context.Background(), WatchConfig{
+		Inner:           watch.NewFake(),
+		Selector:        NewNameSetSelector(NamespaceField, map[string]struct{}{"ns-a": {}}),
+		Mode:            IdentityByNamespace,
+		Store:           emptyStore{},
+		CallerLabel:     labels.Everything(),
+		CallerField:     fields.Everything(),
+		Poll:            func(context.Context) (map[string]struct{}, error) { return nil, errors.New("unavailable") },
+		Initial:         map[string]struct{}{"ns-a": {}},
+		RefreshInterval: 5 * time.Millisecond,
+		UserName:        "alice",
+	})
+	defer w.Stop()
+
+	deadline := time.After(3 * time.Second)
+	for open := true; open; {
+		select {
+		case _, open = <-w.ResultChan():
+		case <-deadline:
+			t.Fatal("the watch was not closed within 3s")
+		}
+	}
+
+	if got := counterValue(t, watchRefreshFailures) - failuresBefore; got < 2 {
+		t.Fatalf("refresh failures grew by %v, want at least 2", got)
+	}
+	if got := counterValue(t, watchClosed.WithLabelValues("refresh_failures")) - closedBefore; got != 1 {
+		t.Fatalf("closes for refresh failures grew by %v, want 1", got)
+	}
+}
+
+// TestMetrics_WatchClosedOnARefreshAnswer: a watch closed on an answer to its
+// refresh is counted under the reason of the answer, not as a failure.
+func TestMetrics_WatchClosedOnARefreshAnswer(t *testing.T) {
+	failuresBefore := counterValue(t, watchRefreshFailures)
+	closedBefore := counterValue(t, watchClosed.WithLabelValues("multitenancy_disabled"))
+
+	w := NewFilteredWatch(context.Background(), WatchConfig{
+		Inner:           watch.NewFake(),
+		Selector:        NewNameSetSelector(NamespaceField, map[string]struct{}{"ns-a": {}}),
+		Mode:            IdentityByNamespace,
+		Store:           emptyStore{},
+		CallerLabel:     labels.Everything(),
+		CallerField:     fields.Everything(),
+		Poll:            func(context.Context) (map[string]struct{}, error) { return nil, ErrScopeRequiresMultitenancyManager },
+		Initial:         map[string]struct{}{"ns-a": {}},
+		RefreshInterval: 5 * time.Millisecond,
+		UserName:        "alice",
+	})
+	defer w.Stop()
+
+	deadline := time.After(3 * time.Second)
+	for open := true; open; {
+		select {
+		case _, open = <-w.ResultChan():
+		case <-deadline:
+			t.Fatal("the watch was not closed within 3s")
+		}
+	}
+
+	if got := counterValue(t, watchRefreshFailures) - failuresBefore; got != 0 {
+		t.Fatalf("refresh failures grew by %v, want 0", got)
+	}
+	if got := counterValue(t, watchClosed.WithLabelValues("multitenancy_disabled")) - closedBefore; got != 1 {
+		t.Fatalf("closes for a disabled multitenancy-manager grew by %v, want 1", got)
+	}
+}
