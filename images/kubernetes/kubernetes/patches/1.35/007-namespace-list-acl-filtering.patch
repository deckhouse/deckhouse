+
+package scopefilter
+
+import (
+	"context"
+	"fmt"
+
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apiserver/pkg/authentication/user"
+	restclient "k8s.io/client-go/rest"
+)
+
+// RBACFloorResolver computes the RBAC safety floor for a denied-then-bypassed
+// request: the set of namespaces the user is both (a) allowed to see at all
+// and (b) specifically allowed to perform verb on gvr (and its subresource,
+// when the request names one) within. Both halves are required: (a) alone
+// would let a caller with rights to some unrelated resource in namespace N see
+// gvr's objects in N too -- exactly the privilege-escalation bug this design
+// was corrected to close (see the package doc).
+type RBACFloorResolver interface {
+	Resolve(ctx context.Context, u user.Info, gvr schema.GroupVersionResource, subresource, verb string) (map[string]struct{}, error)
+}
+
+// LoopbackRBACFloorResolver implements RBACFloorResolver with one
+// SelfScopedAccessReview: the permission service answers, by the same rule it
+// answers a console page gate with, the namespaces the caller may see where
+// the action is allowed -- one request, however many namespaces there are.
+type LoopbackRBACFloorResolver struct {
+	reviewer *LoopbackScopedAccessReviewer
+}
+
+var _ RBACFloorResolver = (*LoopbackRBACFloorResolver)(nil)
+
+// NewLoopbackRBACFloorResolver builds a resolver from a loopback REST config.
+func NewLoopbackRBACFloorResolver(loopbackConfig *restclient.Config) (*LoopbackRBACFloorResolver, error) {
+	reviewer, err := NewLoopbackScopedAccessReviewer(loopbackConfig)
+	if err != nil {
+		return nil, err
+	}
+	return &LoopbackRBACFloorResolver{reviewer: reviewer}, nil
+}
+
+// Resolve implements RBACFloorResolver. A permission in the whole cluster is
+// ErrClusterWideAccess: the floor is computed only for a request
+// kube-apiserver has denied, so such an answer is a disagreement of the two
+// authorization chains and the request is refused.
+func (r *LoopbackRBACFloorResolver) Resolve(ctx context.Context, u user.Info, gvr schema.GroupVersionResource, subresource, verb string) (map[string]struct{}, error) {
+	names, err := r.reviewer.namespacesWhere(ctx, u, scopedAccessItem{
+		Group:       gvr.Group,
+		Resource:    gvr.Resource,
+		Subresource: subresource,
+		Verb:        verb,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("rbac floor: %w", err)
+	}
+	return NamesToSet(names), nil
+}
diff --git a/staging/src/k8s.io/apiserver/pkg/registry/generic/scopefilter/registry.go b/staging/src/k8s.io/apiserver/pkg/registry/generic/scopefilter/registry.go
new file mode 100644
index 00000000000..e6468bf8eb1
--- /dev/null
+++ b/staging/src/k8s.io/apiserver/pkg/registry/generic/scopefilter/registry.go
@@ -0,0 +1,142 @@
+/*
+Copyright 2026 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package scopefilter
+
+import (
+	"sync"
+	"sync/atomic"
+
+	"k8s.io/apimachinery/pkg/runtime/schema"
+)
+
+// The registry is written a bounded number of times (once per covered
+// built-in resource at server bootstrap; once per CRD when its storage is
+// built, and again when it is torn down) but READ on every RBAC-denied
+// list/get/watch to decide whether to bypass. So reads are copy-on-write
+// lock-free via an atomic snapshot; only the rare writes take the mutex and
+// publish a fresh map. IsRegistered -- the hot path -- never blocks.
+var (
+	registryWriteMu sync.Mutex
+	registrySnap    atomic.Pointer[map[schema.GroupResource]struct{}]
+
+	// registrar builds the storage of a resource served by a
+	// CustomResourceDefinition, see SetRegistrar.
+	registrar atomic.Pointer[func(schema.GroupResource) bool]
+)
+
+func init() {
+	empty := map[schema.GroupResource]struct{}{}
+	registrySnap.Store(&empty)
+}
+
+// Register marks gr as having scope-filtering storage wired in. Called at
+// construction time by the central wiring loop for every covered built-in
+// namespaced resource, and by the CRD handler once it has built the storage
+// of a CRD.
+//
+// The authorization filter consults IsRegistered before bypassing a 403 for
+// a scope-header request: a header alone must never be sufficient, because
+// bypassing authz for a resource with no filtering decorator actually wired
+// would hand a fully unfiltered list back to a caller RBAC just denied.
+func Register(gr schema.GroupResource) {
+	registryWriteMu.Lock()
+	defer registryWriteMu.Unlock()
+	cur := *registrySnap.Load()
+	if _, ok := cur[gr]; ok {
+		return
+	}
+	next := make(map[schema.GroupResource]struct{}, len(cur)+1)
+	for k := range cur {
+		next[k] = struct{}{}
+	}
+	next[gr] = struct{}{}
+	registrySnap.Store(&next)
+}
+
+// Unregister removes gr from the allow-list. Used when a
+// CustomResourceDefinition is deleted, so that a future CRD reusing the same
+// group/resource name does not inherit stale registration state left over
+// from the deleted one.
+func Unregister(gr schema.GroupResource) {
+	registryWriteMu.Lock()
+	defer registryWriteMu.Unlock()
+	cur := *registrySnap.Load()
+	if _, ok := cur[gr]; !ok {
+		return
+	}
+	next := make(map[schema.GroupResource]struct{}, len(cur))
+	for k := range cur {
+		if k != gr {
+			next[k] = struct{}{}
+		}
+	}
+	registrySnap.Store(&next)
+}
+
+// IsRegistered reports whether gr has scope-filtering storage wired in.
+// Lock-free atomic snapshot read -- the denied-request hot path.
+func IsRegistered(gr schema.GroupResource) bool {
+	_, ok := (*registrySnap.Load())[gr]
+	return ok
+}
+
+// SetRegistrar installs fn as the way to register a resource whose storage
+// has not been built yet, and returns the function that removes it again.
+//
+// The CRD handler builds the storage of a CRD -- and registers it -- on the
+// first request that reaches the handler. A scoped read RBAC denies never
+// reaches it: without a registrar, a user without cluster-wide access would
+// get 403 for a new CRD (or for every CRD after a restart) until some other
+// request touched it. fn builds the storage of the established CRD serving gr
+// and reports whether gr is registered afterwards; it must never register a
+// resource whose storage carries no ScopeFilter.
+//
+// The returned function removes fn only while it is still the installed one,
+// so a server shutting down never removes the registrar of a newer server in
+// the same process.
+func SetRegistrar(fn func(schema.GroupResource) bool) func() {
+	p := &fn
+	registrar.Store(p)
+	return func() { registrar.CompareAndSwap(p, nil) }
+}
+
+// EnsureRegistered reports whether gr has scope-filtering storage wired in,
+// asking the registrar to build the storage of a CRD that has none yet. The
+// registrar is consulted only for a group a CRD can serve (not the core
+// group) and only on a registry miss, so the hot path stays a map read.
+func EnsureRegistered(gr schema.GroupResource) bool {
+	if IsRegistered(gr) {
+		return true
+	}
+	fn := registrar.Load()
+	if fn == nil || gr.Group == "" {
+		return false
+	}
+	return (*fn)(gr)
+}
+
+// RegisteredResources returns a snapshot of all registered GroupResources.
+// Used by the wiring loop to log/verify coverage after bootstrap. The
+// returned slice is a copy; the caller may sort/mutate it freely.
+func RegisteredResources() []schema.GroupResource {
+	cur := *registrySnap.Load()
+	out := make([]schema.GroupResource, 0, len(cur))
+	for gr := range cur {
+		out = append(out, gr)
+	}
+	return out
+}
