+)
+
+func TestIsNamespaceIdentityResource(t *testing.T) {
+	tests := []struct {
+		name     string
+		gr       schema.GroupResource
+		expected bool
+	}{
+		{
+			name:     "the Project CRD is named after its main namespace",
+			gr:       schema.GroupResource{Group: "deckhouse.io", Resource: "projects"},
+			expected: true,
+		},
+		{
+			name:     "a same-group neighbour is not an identity resource",
+			gr:       schema.GroupResource{Group: "deckhouse.io", Resource: "projecttemplates"},
+			expected: false,
+		},
+		{
+			name:     "the group is part of the match, not just the plural",
+			gr:       schema.GroupResource{Group: "example.com", Resource: "projects"},
+			expected: false,
+		},
+		{
+			name:     "namespaces themselves are filtered by their own storage, not this list",
+			gr:       schema.GroupResource{Resource: "namespaces"},
+			expected: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := IsNamespaceIdentityResource(tt.gr); got != tt.expected {
+				t.Fatalf("IsNamespaceIdentityResource(%v) = %v, expected %v", tt.gr, got, tt.expected)
+			}
+		})
+	}
+}
+
+// TestNewIdentityDecorator pins the wiring an identity resource gets: names
+// derived from the namespace ACL, and none of the namespace-classification
+// machinery, which has nothing to work with on a cluster-scoped object.
+func TestNewIdentityDecorator(t *testing.T) {
+	resolvers := &Resolvers{Accessible: staticFetcher{}, Membership: staticMembership{}}
+	gvr := schema.GroupVersionResource{Group: "deckhouse.io", Version: "v1alpha3", Resource: "projects"}
+	decorator := resolvers.NewIdentityDecorator(nil, nil, nil, gvr)
+
+	if decorator.Mode != IdentityByName {
+		t.Fatalf("expected IdentityByName, got %v", decorator.Mode)
+	}
+	if decorator.Classify != nil || decorator.RBACFloor != nil {
+		t.Fatal("a cluster-scoped identity resource has no namespace to classify or floor against")
+	}
+	if _, ok := decorator.Accessible.(*projectFetcher); !ok {
+		t.Fatalf("expected the name-deriving fetcher from the allowlist, got %T", decorator.Accessible)
+	}
+	if decorator.Trigger(context.Background()) {
+		t.Fatal("filtering must not engage on a context the authorization filter never tagged")
+	}
+	if !decorator.Trigger(WithNamespaceFilteringMode(context.Background())) {
+		t.Fatal("filtering must engage once the authorization filter tags the request")
+	}
+}
+
+// TestNewIdentityDecoratorUnknownResource pins the caller contract: a resource
+// outside the allowlist derives no names, and filtering it by an empty set
+// would hide every object rather than fall back to plain RBAC.
+func TestNewIdentityDecoratorUnknownResource(t *testing.T) {
+	resolvers := &Resolvers{Accessible: staticFetcher{}, Membership: staticMembership{}}
+	gvr := schema.GroupVersionResource{Group: "deckhouse.io", Version: "v1alpha1", Resource: "projecttemplates"}
+
+	if decorator := resolvers.NewIdentityDecorator(nil, nil, nil, gvr); decorator != nil {
+		t.Fatal("expected no decorator for a resource outside the allowlist")
+	}
+}
+
+// TestProjectFetcherDerivesProjectsFromNamespaces is the heart of the rule:
+// access to ANY namespace of a project reveals the project, whether that is the
+// main namespace (named after the project) or an additional one.
+func TestProjectFetcherDerivesProjectsFromNamespaces(t *testing.T) {
+	membership := staticMembership{
+		"team-a":       "team-a",
+		"team-a-stage": "team-a",
+		"team-b":       "team-b",
+		"team-c":       "team-c",
+		"team-d":       "default",
+		"default":      "default",
+		"deckhouse":    "default",
+		"d8-system":    "deckhouse",
+		"kube-system":  "deckhouse",
+	}
+
+	tests := []struct {
+		name       string
+		accessible []string
+		expected   []string
+	}{
+		{
+			name:       "the main namespace reveals its project",
+			accessible: []string{"team-a"},
+			expected:   []string{"team-a"},
+		},
+		{
+			name:       "an additional namespace alone reveals the project too",
+			accessible: []string{"team-a-stage"},
+			expected:   []string{"team-a"},
+		},
+		{
+			name:       "several namespaces of one project collapse to one name",
+			accessible: []string{"team-a", "team-a-stage"},
+			expected:   []string{"team-a"},
+		},
+		{
+			name:       "an unlabeled namespace reveals the virtual project default, not a project of its name",
+			accessible: []string{"team-d"},
+			expected:   []string{"default"},
+		},
+		{
+			name:       "system namespaces reveal the virtual project deckhouse",
+			accessible: []string{"d8-system", "kube-system"},
+			expected:   []string{"deckhouse"},
+		},
+		{
+			name:       "a namespace named deckhouse is not the virtual project deckhouse",
+			accessible: []string{"deckhouse"},
+			expected:   []string{"default"},
+		},
+		{
+			name:       "a namespace a membership snapshot does not know reveals nothing yet",
+			accessible: []string{"brand-new"},
+			expected:   nil,
+		},
+		{
+			name:       "unrelated projects stay hidden",
+			accessible: []string{"team-a-stage", "team-b"},
+			expected:   []string{"team-a", "team-b"},
+		},
+		{
+			name:       "no accessible namespaces means no visible projects",
+			accessible: nil,
+			expected:   nil,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			fetcher := &projectFetcher{
+				accessible: staticFetcher{namespaces: tt.accessible},
+				membership: membership,
+			}
+
+			got, err := fetcher.FetchAccessibleNamespaces(context.Background(), &user.DefaultInfo{Name: "alice"})
+			if err != nil {
+				t.Fatalf("FetchAccessibleNamespaces: %v", err)
+			}
+
+			sort.Strings(got)
+			if !reflect.DeepEqual(got, tt.expected) && !(len(got) == 0 && len(tt.expected) == 0) {
+				t.Fatalf("expected projects %v, got %v", tt.expected, got)
+			}
+		})
+	}
+}
+
+// TestProjectFetcherPropagatesErrors pins fail-closed behavior: a resolver
+// failure must surface, never degrade into an empty (deny-everything) or
+// unfiltered set.
+func TestProjectFetcherPropagatesErrors(t *testing.T) {
+	fetcher := &projectFetcher{
+		accessible: staticFetcher{namespaces: []string{"team-a"}},
+		membership: failingMembership{},
+	}
+
+	if _, err := fetcher.FetchAccessibleNamespaces(context.Background(), &user.DefaultInfo{Name: "alice"}); err == nil {
+		t.Fatal("expected the membership failure to surface")
+	}
+}
+
+// TestProjectFetcherClusterWideNamespacesRevealEveryProject: a caller the
+// permission service allows to list namespaces in the whole cluster sees every
+// project, the virtual ones included. kube-apiserver denied projects, not
+// namespaces, so this answer is no disagreement.
+func TestProjectFetcherClusterWideNamespacesRevealEveryProject(t *testing.T) {
+	fetcher := &projectFetcher{
+		accessible: clusterWideFetcher{},
+		membership: staticMembership{"team-a": "team-a", "team-a-stage": "team-a", "team-b": "team-b"},
+	}
+
+	got, err := fetcher.FetchAccessibleNamespaces(context.Background(), &user.DefaultInfo{Name: "alice"})
+	if err != nil {
+		t.Fatalf("FetchAccessibleNamespaces: %v", err)
+	}
+	sort.Strings(got)
+	if !reflect.DeepEqual(got, []string{"deckhouse", "default", "team-a", "team-b"}) {
+		t.Fatalf("projects = %v, want [deckhouse default team-a team-b]", got)
+	}
+}
+
+// TestDecorator_NamespacesAllowedInTheWholeCluster: the namespaces identity
+// asks the permission service about list. A caller who may list namespaces in
+// the whole cluster sees every namespace, so the decorator does not restrict a
+// get or a watch it let through -- and a refusal would not be a disagreement
+// of the two chains, which asked about different verbs. A list is refused, see
+// TestDecorator_NamespacesListAllowedInTheWholeClusterIsRefused.
+func TestDecorator_NamespacesAllowedInTheWholeCluster(t *testing.T) {
+	d := &Decorator{
+		Resource:   schema.GroupVersionResource{Version: "v1", Resource: "namespaces"},
+		Mode:       IdentityByName,
+		Accessible: clusterWideFetcher{},
+	}
+	for _, verb := range []string{"get", "watch"} {
+		classified, hasClassified, floor, hasFloor, err := d.resolve(context.Background(), &user.DefaultInfo{Name: "alice"}, verb)
+		if err != nil {
+			t.Fatalf("%s: resolve error %v, want every namespace", verb, err)
+		}
+		if _, restrict := combinedSet(classified, hasClassified, floor, hasFloor); restrict {
+			t.Fatalf("%s: restricted to %v, want every namespace", verb, floor)
+		}
+	}
+}
+
+// TestDecorator_NamespacesListAllowedInTheWholeClusterIsRefused: a list of
+// namespaces reaches the decorator only after kube-apiserver denied it. A
+// review that allows list in the whole cluster answers the same verb, so the
+// two chains disagree: the list is refused and counted, never answered with
+// every namespace.
+func TestDecorator_NamespacesListAllowedInTheWholeClusterIsRefused(t *testing.T) {
+	d := &Decorator{
+		Resource:   schema.GroupVersionResource{Version: "v1", Resource: "namespaces"},
+		Mode:       IdentityByName,
+		Accessible: clusterWideFetcher{},
+	}
+	ctx := genericapirequest.WithUser(context.Background(), &user.DefaultInfo{Name: "alice"})
+	before := counterValue(t, clusterDisagreements)
+
+	if _, err := d.List(ctx, nil); !apierrors.IsForbidden(err) {
+		t.Fatalf("List: %v, want Forbidden", err)
+	}
+	if got := counterValue(t, clusterDisagreements) - before; got != 1 {
+		t.Fatalf("disagreements grew by %v, want 1", got)
+	}
+}
+
+type clusterWideFetcher struct{}
+
+func (clusterWideFetcher) FetchAccessibleNamespaces(context.Context, user.Info) ([]string, error) {
+	return nil, ErrClusterWideAccess
+}
+
+type staticFetcher struct {
+	namespaces []string
+}
+
+func (f staticFetcher) FetchAccessibleNamespaces(_ context.Context, _ user.Info) ([]string, error) {
+	return f.namespaces, nil
+}
+
+type staticMembership map[string]string
+
+func (m staticMembership) Resolve(_ context.Context) (map[string]string, error) {
+	return m, nil
+}
+
+type failingMembership struct{}
+
+func (failingMembership) Resolve(_ context.Context) (map[string]string, error) {
+	return nil, errors.New("membership unavailable")
+}
