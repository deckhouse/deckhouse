+	inner.ch <- watch.Event{Type: watch.Added, Object: &fakeItem{ObjectMeta: metav1.ObjectMeta{Namespace: "ns-a", Name: "pod-1"}}}
+
+	select {
+	case ev := <-w.ResultChan():
+		item, ok := ev.Object.(*fakeItem)
+		if !ok || item.Namespace != "ns-a" || item.Name != "pod-1" {
+			t.Fatalf("first event = %s %#v, want ADDED ns-a/pod-1: the ns-b event must be dropped", ev.Type, ev.Object)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("the ns-a event was not passed through")
+	}
+}
