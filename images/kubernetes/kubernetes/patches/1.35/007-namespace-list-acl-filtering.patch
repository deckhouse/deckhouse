+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package apiserver
+
+import (
+	"strings"
+
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	genericregistry "k8s.io/apiserver/pkg/registry/generic/registry"
+	"k8s.io/apiserver/pkg/registry/generic/scopefilter"
+	"k8s.io/apiserver/pkg/registry/rest"
+	genericapiserver "k8s.io/apiserver/pkg/server"
+	restclient "k8s.io/client-go/rest"
+	"k8s.io/klog/v2"
+)
+
+// newScopeResolvers returns the shared scope-filter resolver bundle that every
+// covered built-in resource is wired against in wireScopeFilterForGroup: nil
+// when there is no loopback config (minimal/test setups) or when the bundle
+// cannot be built, which leaves every resource at vanilla behavior.
+func newScopeResolvers(loopbackConfig *restclient.Config) *scopefilter.Resolvers {
+	r, err := scopefilter.NewLoopbackResolvers(loopbackConfig)
+	if err != nil {
+		klog.Warningf("scopefilter: failed to build resolvers: %v; generic --scope filtering disabled this run", err)
+		return nil
+	}
+	return r
+}
+
+// logScopeFilterCoverage logs the resulting coverage so an operator can verify
+// which built-in resources became `--scope`-filterable (and spot omissions).
+func logScopeFilterCoverage(r *scopefilter.Resolvers) {
+	if r == nil {
+		return
+	}
+	klog.V(2).InfoS("scopefilter: generic --scope coverage wired",
+		"resources", scopefilter.RegisteredResources())
+}
+
+// scopeStoreProvider is satisfied by any REST storage that EMBEDS
+// *genericregistry.Store (which promotes DeckhouseScopeStore). Storage that
+// merely wraps the store in an unexported field -- notably namespaces, which
+// runs its own bespoke IdentityByName ACL filter -- does not satisfy it and
+// is left untouched.
+type scopeStoreProvider interface {
+	DeckhouseScopeStore() *genericregistry.Store
+}
+
+// wireScopeFilterForGroup is Deckhouse's central choke point for attaching
+// generic `-A --scope=<kind>` cross-namespace filtering to built-in
+// resources. It walks one API group's storage map and wires every
+// namespaced, non-subresource, *genericregistry.Store-backed resource.
+//
+// Why here and not per-resource: this runs for every built-in group during
+// InstallAPIs, so covering a resource costs zero edits to that resource's
+// own storage.go. Why this excludes CRDs without any opt-out: CRD instance
+// storage is served by the apiextensions-apiserver delegate and never flows
+// through this install path. Why it excludes namespaces: the namespaces REST
+// wraps (not embeds) its Store, so it does not satisfy scopeStoreProvider,
+// and it is cluster-scoped anyway.
+//
+// A nil resolver bundle (no loopback config this run) is a silent no-op:
+// nothing is registered, so no --scope header can bypass 403 for anything.
+func wireScopeFilterForGroup(info *genericapiserver.APIGroupInfo, r *scopefilter.Resolvers) {
+	if r == nil {
+		return
+	}
+
+	group := ""
+	if len(info.PrioritizedVersions) > 0 {
+		// Every version in one APIGroupInfo shares a group; the group must
+		// equal requestInfo.APIGroup exactly, or the authz filter's
+		// IsRegistered check would miss and the resource would silently not
+		// be bypassable.
+		group = info.PrioritizedVersions[0].Group
+	}
+
+	for version, resources := range info.VersionedResourcesStorageMap {
+		for name, storageObj := range resources {
+			if strings.Contains(name, "/") {
+				continue // subresource (pods/status, deployments/scale, …)
+			}
+			scoper, ok := storageObj.(rest.Scoper)
+			if !ok || !scoper.NamespaceScoped() {
+				continue // cluster-scoped (nodes, namespaces, clusterroles, …)
+			}
+			provider, ok := storageObj.(scopeStoreProvider)
+			if !ok {
+				continue // does not embed *genericregistry.Store
+			}
+
+			store := provider.DeckhouseScopeStore()
+			gvr := schema.GroupVersionResource{Group: group, Version: version, Resource: name}
+			store.ScopeFilter = r.NewDecorator(store, store.PredicateFunc, store.Decorator, gvr)
+			scopefilter.Register(gvr.GroupResource())
+			klog.V(4).InfoS("scopefilter: wired built-in resource", "resource", gvr)
+		}
+	}
+}
