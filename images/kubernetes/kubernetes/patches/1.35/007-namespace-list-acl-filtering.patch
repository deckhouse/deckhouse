+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package scopefilter
+
+import (
+	"context"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"golang.org/x/sync/singleflight"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apiserver/pkg/authentication/user"
+)
+
+const (
+	// DefaultResolveCacheTTL is how long a resolver result is served from the
+	// cache before a fresh loopback call is made. Kept short deliberately: a
+	// change to a user's RBAC/namespace-labels is reflected within
+	// ~TTL + permission-browser informer lag, which is already the
+	// eventual-consistency envelope the watch poller (also ~1s) operates in.
+	// A LARGER TTL is a footgun -- a transient empty set of namespaces would
+	// stick as "no access" for the whole TTL -- so it is capped by
+	// maxResolveCacheTTL.
+	DefaultResolveCacheTTL = 1 * time.Second
+
+	// maxResolveCacheTTL bounds the configurable TTL. Above this the staleness
+	// window stops being "within existing propagation lag" and starts being a
+	// visible correctness/authz-latency problem.
+	maxResolveCacheTTL = 30 * time.Second
+
+	// resolveLoadTimeout backstops a single cache-miss load. It sits just above
+	// the fetchers' own HTTP client timeout so the load ctx never cancels a
+	// call the client would otherwise have completed.
+	resolveLoadTimeout = defaultHTTPTimeout + 5*time.Second
+
+	// sweepInterval is how often, at most, expired entries are swept to
+	// reclaim memory for identities that never recur. The sweep is amortized
+	// into set() rather than run on a background goroutine: correctness does
+	// not depend on it (reads evict lazily), it only bounds memory, and a
+	// process-lifetime goroutine would leak past apiserver shutdown (there is
+	// no teardown hook plumbed to the shared cache -- integration tests'
+	// goroutine-leak checker rightly flags that).
+	sweepInterval = 60 * time.Second
+
+	// maxResolveCacheEntries bounds every cache. The keys carry the whole
+	// caller identity, extra included, so a client that sends a new extra
+	// value on every request would otherwise grow a cache by one entry per
+	// request for a sweep period. A full cache sweeps expired entries; when
+	// that frees nothing, the result is served without being cached.
+	maxResolveCacheEntries = 4096
+)
+
+// resolveCache is a small TTL cache with singleflight de-duplication, shared by
+// the caching resolver wrappers below. Values are maps that are immutable once
+// stored (a refresh replaces the entry with a new map, never mutates in place),
+// so concurrent readers -- and long-lived watch selectors holding a reference --
+// are safe without copying. It is generic over the value type because the
+// wrappers cache different shapes: namespace-name sets for classification and
+// the RBAC floor, a namespace-to-project map for project membership.
+//
+// The whole point is watch-poll amplification: N concurrent watches sharing a
+// user+resource+verb (or a user-independent classification) collapse to ~one
+// loopback resolve per TTL instead of one per watch per tick.
+type resolveCache[T any] struct {
+	ttl        time.Duration
+	maxEntries int
+	group      singleflight.Group
+
+	mu        sync.Mutex
+	entries   map[string]resolveCacheEntry[T]
+	nextSweep time.Time
+
+	now func() time.Time // overridable in tests
+}
+
+type resolveCacheEntry[T any] struct {
+	value  T
+	expiry time.Time
+}
+
+func newResolveCache[T any](ttl time.Duration) *resolveCache[T] {
+	if ttl <= 0 {
+		ttl = DefaultResolveCacheTTL
+	}
+	if ttl > maxResolveCacheTTL {
+		ttl = maxResolveCacheTTL
+	}
+	return &resolveCache[T]{
+		ttl:        ttl,
+		maxEntries: maxResolveCacheEntries,
+		entries:    make(map[string]resolveCacheEntry[T]),
+		now:        time.Now,
+	}
+}
+
+// sweepLocked drops every expired entry. Callers must hold c.mu. It is invoked
+// opportunistically from set() at most once per sweepInterval, which keeps the
+// map bounded (stale identities are reclaimed within a sweep period of the
+// next write) at O(len(entries)) amortized over at least a minute of writes.
+func (c *resolveCache[T]) sweepLocked() {
+	now := c.now()
+	for k, e := range c.entries {
+		if now.After(e.expiry) {
+			delete(c.entries, k)
+		}
+	}
+}
+
+func (c *resolveCache[T]) get(key string) (T, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	var zero T
+	e, ok := c.entries[key]
+	if !ok {
+		return zero, false
+	}
+	if c.now().After(e.expiry) {
+		delete(c.entries, key)
+		return zero, false
+	}
+	return e.value, true
+}
+
+func (c *resolveCache[T]) set(key string, v T) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	now := c.now()
+	if now.After(c.nextSweep) {
+		c.sweepLocked()
+		c.nextSweep = now.Add(sweepInterval)
+	}
+	if _, exists := c.entries[key]; !exists && len(c.entries) >= c.maxEntries {
+		c.sweepLocked()
+		if len(c.entries) >= c.maxEntries {
+			return
+		}
+	}
+	c.entries[key] = resolveCacheEntry[T]{value: v, expiry: now.Add(c.ttl)}
+}
+
+// getOrLoad returns the cached set for key or runs load exactly once across all
+// concurrent callers for that key (singleflight). Errors are never cached.
+//
+// load runs on a fresh context.Background()-derived context with its own
+// timeout, NOT the caller's context: under singleflight one caller is the
+// flight leader, and if its request context cancelled mid-load (e.g. the watch
+// that happened to lead stops), every waiter on that key would otherwise get
+// context-canceled -- defeating dedup exactly when it matters most. Identity is
+// passed to the resolvers as an explicit argument, never read from the context,
+// so detaching the context changes nothing about the authorization decision.
+func (c *resolveCache[T]) getOrLoad(key string, load func(ctx context.Context) (T, error)) (T, error) {
+	var zero T
+	if v, ok := c.get(key); ok {
+		return v, nil
+	}
+	loaded, err, _ := c.group.Do(key, func() (interface{}, error) {
+		if v, ok := c.get(key); ok { // double-check after winning the flight
+			return v, nil
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), resolveLoadTimeout)
+		defer cancel()
+		v, err := load(ctx)
+		if err != nil {
+			return nil, err
+		}
+		c.set(key, v)
+		return v, nil
+	})
+	if err != nil {
+		return zero, err
+	}
+	return loaded.(T), nil
+}
+
+// ----- caching resolver wrappers --------------------------------------------
+
+// cachingClassificationResolver caches classification results keyed by
+// (kind, project) ONLY -- classification is a pure function of cluster
+// namespace labels, identical for every user, so one entry is shared across
+// all users.
+type cachingClassificationResolver struct {
+	inner ClassificationResolver
+	cache *resolveCache[map[string]struct{}]
+}
+
+var _ ClassificationResolver = (*cachingClassificationResolver)(nil)
+
+func (r *cachingClassificationResolver) Resolve(_ context.Context, kind Kind, project string) (map[string]struct{}, error) {
+	key := keyField("classify") + keyField(string(kind)) + keyField(project)
+	return r.cache.getOrLoad(key, func(ctx context.Context) (map[string]struct{}, error) {
+		return r.inner.Resolve(ctx, kind, project)
+	})
+}
+
+// cachingRBACFloorResolver caches the RBAC safety floor keyed by the FULL
+// caller identity plus the exact (gvr, subresource, verb). The identity key is
+// length-and-count-prefixed (see userCacheKey) so two distinct identities can
+// never collide onto one entry -- the one cache bug that would escalate
+// privilege rather than merely go stale.
+type cachingRBACFloorResolver struct {
+	inner RBACFloorResolver
+	cache *resolveCache[map[string]struct{}]
+}
+
+var _ RBACFloorResolver = (*cachingRBACFloorResolver)(nil)
+
+func (r *cachingRBACFloorResolver) Resolve(_ context.Context, u user.Info, gvr schema.GroupVersionResource, subresource, verb string) (map[string]struct{}, error) {
+	key := keyField("floor") + userCacheKey(u) + keyField(gvr.String()) + keyField(subresource) + keyField(verb)
+	return r.cache.getOrLoad(key, func(ctx context.Context) (map[string]struct{}, error) {
+		return r.inner.Resolve(ctx, u, gvr, subresource, verb)
+	})
+}
+
+// cachingAccessibleNamespaceFetcher caches the accessible namespaces keyed by
+// the FULL caller identity (see userCacheKey). Every open watch of namespaces
+// and of projects polls them once a second, so N watches of one user collapse
+// to ~one loopback call per TTL. The returned slice is shared by every caller
+// of the entry and must not be modified.
+type cachingAccessibleNamespaceFetcher struct {
+	inner AccessibleNamespaceFetcher
+	cache *resolveCache[[]string]
+}
+
+var _ AccessibleNamespaceFetcher = (*cachingAccessibleNamespaceFetcher)(nil)
+
+func (f *cachingAccessibleNamespaceFetcher) FetchAccessibleNamespaces(_ context.Context, u user.Info) ([]string, error) {
+	key := keyField("accessible") + userCacheKey(u)
+	return f.cache.getOrLoad(key, func(ctx context.Context) ([]string, error) {
+		return f.inner.FetchAccessibleNamespaces(ctx, u)
+	})
+}
+
+// keyField renders one field as `<len>:<value>;` so concatenated fields are
+// unambiguous regardless of their contents (no delimiter can be forged from
+// within a value).
+func keyField(s string) string {
+	return strconv.Itoa(len(s)) + ":" + s + ";"
+}
+
+// userCacheKey builds a collision-free key from every identity attribute that
+// can affect an authorization decision: name, uid, groups, and extra. Every
+// field is length-prefixed and every collection is count-prefixed, so no two
+// distinct user.Info values can map to the same string. Never shorten this to
+// name-only.
+func userCacheKey(u user.Info) string {
+	var b strings.Builder
+	b.WriteString(keyField(u.GetName()))
+	b.WriteString(keyField(u.GetUID()))
+
+	groups := append([]string(nil), u.GetGroups()...)
+	sort.Strings(groups)
+	b.WriteString(keyField(strconv.Itoa(len(groups))))
+	for _, g := range groups {
+		b.WriteString(keyField(g))
+	}
+
+	extra := u.GetExtra()
+	ekeys := make([]string, 0, len(extra))
+	for k := range extra {
+		ekeys = append(ekeys, k)
+	}
+	sort.Strings(ekeys)
+	b.WriteString(keyField(strconv.Itoa(len(ekeys))))
+	for _, k := range ekeys {
+		b.WriteString(keyField(k))
+		vals := append([]string(nil), extra[k]...)
+		sort.Strings(vals)
+		b.WriteString(keyField(strconv.Itoa(len(vals))))
+		for _, v := range vals {
+			b.WriteString(keyField(v))
+		}
+	}
+	return b.String()
+}
