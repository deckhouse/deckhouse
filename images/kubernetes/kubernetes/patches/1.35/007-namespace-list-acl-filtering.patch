+package storage
+
+import (
+	"time"
+
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	genericregistry "k8s.io/apiserver/pkg/registry/generic/registry"
+	"k8s.io/apiserver/pkg/registry/generic/scopefilter"
+	restclient "k8s.io/client-go/rest"
+	"k8s.io/klog/v2"
+)
+
+// Deckhouse: the namespace list ACL filter of the namespace storage.
+//
+// REST.List/Get/Watch are plain, unconditional delegations to store; all the
+// filtering logic lives one level down, on store.ScopeFilter (see
+// genericregistry.Store's field doc). When a fetcher was supplied to NewREST,
+// store.ScopeFilter is wired in IdentityByName mode with an unconditional
+// trigger (scopefilter.IsNamespaceFilteringMode, set by the authorization filter
+// for users who lack RBAC for list/get on namespaces but should still see the
+// subset they have *some* access to). This is the original, narrower
+// ACL-filtering mechanism that scopefilter's generic --scope=<kind> path (used
+// by every other namespaced resource) was generalized from -- namespaces keeps
+// its own unconditional trigger as a deliberate, documented exception.
+//
+// Called with no options, NewREST(optsGetter) reproduces vanilla upstream
+// behavior -- this is what the upstream storage_test.go relies on.
+
+// namespacesGVR identifies the namespaces resource for scopefilter.Decorator
+// error construction. There is no separate resource+verb to narrow an RBAC
+// floor against here (see scopefilter.Decorator's IdentityByName doc), so
+// Version is cosmetic.
+var namespacesGVR = schema.GroupVersionResource{Group: "", Version: "v1", Resource: "namespaces"}
+
+// restConfig collects the Deckhouse-specific settings supplied to NewREST
+// via functional options. The zero value disables filtering — i.e. plain
+// upstream behavior — which is what NewREST(optsGetter) gives you.
+type restConfig struct {
+	// fetcher is the scopefilter.AccessibleNamespaceFetcher to use
+	// directly, when the caller already has one (typically tests).
+	fetcher scopefilter.AccessibleNamespaceFetcher
+
+	// loopbackConfig, when set, asks NewREST to take the accessible-namespace
+	// fetcher of the shared scopefilter.Resolvers of that config. If both
+	// fetcher and loopbackConfig are set, fetcher wins.
+	loopbackConfig *restclient.Config
+
+	// refreshInterval overrides scopefilter.DefaultRefreshInterval for
+	// the watch-path ACL poller.
+	refreshInterval time.Duration
+}
+
+// Option configures the namespace REST storage. Options are applied in
+// order; later options override earlier ones for the same field.
+type Option func(*restConfig)
+
+// WithAccessibleNamespaceFetcher enables Deckhouse ACL filtering with the
+// caller-supplied fetcher. Pass nil to leave filtering disabled.
+func WithAccessibleNamespaceFetcher(f scopefilter.AccessibleNamespaceFetcher) Option {
+	return func(c *restConfig) { c.fetcher = f }
+}
+
+// WithLoopbackFetcher enables Deckhouse ACL filtering with the
+// accessible-namespace fetcher of the scopefilter.Resolvers built from the
+// supplied loopback REST config, the bundle every other filtered resource of
+// the server shares. Nil config or a bundle-build failure degrades to vanilla
+// behavior with a klog warning — kube-apiserver still boots.
+func WithLoopbackFetcher(cfg *restclient.Config) Option {
+	return func(c *restConfig) { c.loopbackConfig = cfg }
+}
+
+// WithACLRefreshInterval overrides the watch-path ACL polling cadence.
+// Non-positive values fall back to scopefilter.DefaultRefreshInterval.
+func WithACLRefreshInterval(d time.Duration) Option {
+	return func(c *restConfig) { c.refreshInterval = d }
+}
+
+// newScopeFilter returns the ScopeFilter of the namespaces store, or nil when
+// opts enable no filtering.
+//
+// It is wired directly on store (rather than kept alongside it on REST) so
+// that store.List/Get/Watch's own ScopeFilter check -- shared by every
+// resource built on *genericregistry.Store -- picks it up with no per-type
+// List/Get/Watch overrides needed here. NewREST assigns it after
+// statusStore/finalizeStore were already copied, so neither subresource
+// inherits it -- consistent with the authorization filter never tagging a
+// subresource request for filtering in the first place
+// (scopefilter.IsNamespaceFilteringMode only ever fires for the top-level
+// namespaces resource), just structurally guaranteed rather than incidentally
+// true.
+func newScopeFilter(store *genericregistry.Store, opts []Option) *scopefilter.Decorator {
+	var cfg restConfig
+	for _, opt := range opts {
+		opt(&cfg)
+	}
+
+	fetcher := cfg.fetcher
+	if fetcher == nil && cfg.loopbackConfig != nil {
+		resolvers, err := scopefilter.NewLoopbackResolvers(cfg.loopbackConfig)
+		if err != nil {
+			klog.Warningf("namespace ACL: failed to build the loopback resolvers of the filter: %v; filtering disabled, a denied read of namespaces gets 403", err)
+		} else {
+			fetcher = resolvers.Accessible
+		}
+	}
+	if fetcher == nil {
+		return nil
+	}
+	// The authorization filter lets a denied read of namespaces through to the
+	// filter only once it is registered; without the filter the read gets the
+	// plain 403.
+	scopefilter.Register(namespacesGVR.GroupResource())
+
+	return &scopefilter.Decorator{
+		Store:           store,
+		BuildPredicate:  store.PredicateFunc,
+		Resource:        namespacesGVR,
+		Mode:            scopefilter.IdentityByName,
+		Trigger:         scopefilter.IsNamespaceFilteringMode,
+		Accessible:      fetcher,
+		RefreshInterval: cfg.refreshInterval,
+	}
+}
