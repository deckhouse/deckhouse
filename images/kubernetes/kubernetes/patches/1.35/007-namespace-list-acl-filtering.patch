+package scopefilter_test
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apiserver/pkg/registry/generic/scopefilter"
+	restclient "k8s.io/client-go/rest"
+)
+
+// TestLoopbackClassificationResolver_LabelSelectorPerKind is the direct,
+// wire-level test of the exact labelSelector query string each scope Kind
+// sends: integration_test.go proves the END BEHAVIOR is correct against a
+// fake server that itself re-parses the selector with labels.Parse, which
+// would forgive some malformed-but-equivalent strings. This test instead
+// asserts on the literal query parameter the real HTTP client sends, so a
+// change to e.g. ProjectLabel accidentally becoming " "+ProjectLabel
+// (a leading space, still often tolerated by labels.Parse) would be caught
+// here even if it happened to still work end to end.
+func TestLoopbackClassificationResolver_LabelSelectorPerKind(t *testing.T) {
+	tests := []struct {
+		name              string
+		kind              scopefilter.Kind
+		project           string
+		wantLabelSelector string
+	}{
+		{
+			// System is a name-based classification (IsSystemNamespace), so
+			// the LIST must be unfiltered: any label selector here would
+			// silently drop namespaces from the allowlist.
+			name:              "system sends no selector at all",
+			kind:              scopefilter.KindSystem,
+			wantLabelSelector: "",
+		},
+		{
+			name:              "projects is the bare-existence selector",
+			kind:              scopefilter.KindProjects,
+			wantLabelSelector: scopefilter.ProjectLabel,
+		},
+		{
+			name:              "project is an equality selector on the given name",
+			kind:              scopefilter.KindProject,
+			project:           "team-a",
+			wantLabelSelector: scopefilter.ProjectLabel + "=team-a",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var gotSelector string
+			var gotPath string
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				gotPath = r.URL.Path
+				gotSelector = r.URL.Query().Get("labelSelector")
+				w.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(w).Encode(corev1.NamespaceList{
+					TypeMeta: metav1.TypeMeta{APIVersion: "v1", Kind: "NamespaceList"},
+				})
+			}))
+			defer srv.Close()
+
+			resolver, err := scopefilter.NewLoopbackClassificationResolver(&restclient.Config{Host: srv.URL})
+			if err != nil {
+				t.Fatalf("NewLoopbackClassificationResolver: %v", err)
+			}
+
+			if _, err := resolver.Resolve(context.Background(), tt.kind, tt.project); err != nil {
+				t.Fatalf("Resolve: %v", err)
+			}
+
+			if gotPath != "/api/v1/namespaces" {
+				t.Fatalf("request path = %q, want /api/v1/namespaces", gotPath)
+			}
+			if gotSelector != tt.wantLabelSelector {
+				t.Fatalf("labelSelector = %q, want %q", gotSelector, tt.wantLabelSelector)
+			}
+		})
+	}
+}
+
+// TestIsSystemNamespace pins the exact name-based allowlist of the system
+// scope: the default namespace plus the d8-* and kube-* prefixes -- dash
+// included, so near-misses like "d8x" or "kubernetes" must not match.
+func TestIsSystemNamespace(t *testing.T) {
+	cases := map[string]bool{
+		"default":         true,
+		"d8-system":       true,
+		"d8-monitoring":   true,
+		"kube-system":     true,
+		"kube-node-lease": true,
+		"d8-":             true, // degenerate but prefix-matching
+		"kube-":           true,
+
+		"d8":         false, // no dash
+		"d8x":        false,
+		"kube":       false,
+		"kubernetes": false,
+		"defaultx":   false,
+		"mydefault":  false,
+		"xd8-foo":    false, // prefix, not substring
+		"xkube-foo":  false,
+		"user-ns":    false,
+		"":           false,
+	}
+	for name, want := range cases {
+		if got := scopefilter.IsSystemNamespace(name); got != want {
+			t.Errorf("IsSystemNamespace(%q) = %v, want %v", name, got, want)
+		}
+	}
+}
+
+// TestLoopbackClassificationResolver_SystemIsNameAllowlist drives the real
+// resolver against a fake Namespace LIST and asserts KindSystem keeps exactly
+// the name-allowlisted namespaces -- independent of ProjectLabel: a labeled
+// d8-* namespace stays in (name wins), and an unlabeled namespace outside the
+// allowlist stays out (no "everything unlabeled" fallback).
+func TestLoopbackClassificationResolver_SystemIsNameAllowlist(t *testing.T) {
+	namespaces := []corev1.Namespace{
+		{ObjectMeta: metav1.ObjectMeta{Name: "default"}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "kube-system"}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "d8-monitoring"}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "d8-labeled", Labels: map[string]string{scopefilter.ProjectLabel: "oddball"}}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "user-ns"}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "kubernetes"}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "team-a", Labels: map[string]string{scopefilter.ProjectLabel: "team-a"}}},
+	}
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(corev1.NamespaceList{
+			TypeMeta: metav1.TypeMeta{APIVersion: "v1", Kind: "NamespaceList"},
+			Items:    namespaces,
+		})
+	}))
+	defer srv.Close()
+
+	resolver, err := scopefilter.NewLoopbackClassificationResolver(&restclient.Config{Host: srv.URL})
+	if err != nil {
+		t.Fatalf("NewLoopbackClassificationResolver: %v", err)
+	}
+
+	got, err := resolver.Resolve(context.Background(), scopefilter.KindSystem, "")
+	if err != nil {
+		t.Fatalf("Resolve: %v", err)
+	}
+
+	want := map[string]struct{}{
+		"default":       {},
+		"kube-system":   {},
+		"d8-monitoring": {},
+		"d8-labeled":    {},
+	}
+	if len(got) != len(want) {
+		t.Fatalf("system set = %v, want %v", got, want)
+	}
+	for name := range want {
+		if _, ok := got[name]; !ok {
+			t.Fatalf("system set = %v, want %v", got, want)
+		}
+	}
+}
+
+// TestLoopbackClassificationResolver_ProjectWithoutNameIsRejectedLocally
+// verifies KindProject with an empty project name fails BEFORE making any
+// HTTP call at all -- a request for "every namespace with any value of the
+// project label" is never the right fallback for a missing project name.
+func TestLoopbackClassificationResolver_ProjectWithoutNameIsRejectedLocally(t *testing.T) {
+	called := false
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		called = true
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+
+	resolver, err := scopefilter.NewLoopbackClassificationResolver(&restclient.Config{Host: srv.URL})
+	if err != nil {
+		t.Fatalf("NewLoopbackClassificationResolver: %v", err)
+	}
+
+	if _, err := resolver.Resolve(context.Background(), scopefilter.KindProject, ""); err == nil {
+		t.Fatal("expected an error for KindProject with an empty project name")
+	}
+	if called {
+		t.Fatal("must fail before making any HTTP request when the project name is empty")
+	}
+}
