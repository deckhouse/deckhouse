+				Mode:           scopefilter.IdentityByNamespace,
+				Classify: &fakeClassify{byKind: map[scopefilter.Kind]map[string]struct{}{
+					scopefilter.KindSystem:   {"ns-a": {}},
+					scopefilter.KindProjects: {"ns-a": {}},
+					scopefilter.KindProject:  {"ns-a": {}},
+				}},
+				RBACFloor:    &fakeFloor{allowed: map[string]map[string]struct{}{"pods/list": {"ns-a": {}}, "pods/watch": {"ns-a": {}}}},
+				Accessible:   &fakeAccessible{names: []string{"ns-a"}},
+				Multitenancy: fakeMultitenancy{disabled: tt.disabled},
+			}
+
+			ctx := genericapirequest.WithUser(genericapirequest.NewContext(), &user.DefaultInfo{Name: "alice"})
+			ctx = scopefilter.WithRequest(ctx, tt.scope)
+			if tt.bypass {
+				ctx = scopefilter.WithBypass(ctx)
+			}
+
+			_, listErr := d.List(ctx, nil)
+			w, watchErr := d.Watch(ctx, nil)
