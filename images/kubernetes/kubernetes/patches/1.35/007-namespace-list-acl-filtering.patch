+)
+
+func TestSetRegistrar_UnsetKeepsANewerRegistrar(t *testing.T) {
+	gr := schema.GroupResource{Group: "example.io", Resource: "gadgets"}
+	answer := func(v bool) func(schema.GroupResource) bool {
+		return func(schema.GroupResource) bool { return v }
+	}
+
+	unsetOld := SetRegistrar(answer(false))
+	unsetNew := SetRegistrar(answer(true))
+	t.Cleanup(unsetNew)
+
+	unsetOld()
+	if !EnsureRegistered(gr) {
+		t.Fatal("removing the old registrar removed the newer one")
+	}
+
+	unsetNew()
+	if EnsureRegistered(gr) {
+		t.Fatal("EnsureRegistered is true with no registrar and no registration")
+	}
+}
