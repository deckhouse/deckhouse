+// ----- fake loopback server: core v1 Namespace LIST + permission-browser --
+
+// accessRule is one canned (namespace, resource, subresource, verb) ->
+// allowed answer for the fake SelfScopedAccessReview endpoint.
+type accessRule struct {
+	namespace, resource, subresource, verb string
+	allowed                                bool
+}
+
+// scopedReview mirrors the wire shape of SelfScopedAccessReview that the
+// filter sends and the permission browser answers.
+type scopedReview struct {
+	APIVersion string `json:"apiVersion"`
+	Kind       string `json:"kind"`
+	Spec       struct {
+		Scope    string `json:"scope"`
+		Requests []struct {
+			Group             string   `json:"group,omitempty"`
+			Resource          string   `json:"resource"`
+			Subresource       string   `json:"subresource,omitempty"`
+			Verbs             []string `json:"verbs"`
+			IncludeNamespaces bool     `json:"includeNamespaces"`
+		} `json:"requests"`
+	} `json:"spec"`
+	Status struct {
+		Results []reviewResult `json:"results"`
+	} `json:"status"`
+}
+
+type reviewResult struct {
+	Allowed         bool     `json:"allowed"`
+	Cluster         bool     `json:"cluster"`
+	Namespaces      []string `json:"namespaces"`
+	Reason          string   `json:"reason,omitempty"`
+	EvaluationError string   `json:"evaluationError,omitempty"`
+}
+
+func decodeReview(r *http.Request) (scopedReview, error) {
+	var review scopedReview
+	err := json.NewDecoder(r.Body).Decode(&review)
+	return review, err
+}
+
+func writeReview(t *testing.T, w http.ResponseWriter, review scopedReview) {
+	t.Helper()
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusCreated)
+	if err := json.NewEncoder(w).Encode(review); err != nil {
+		t.Errorf("encode selfscopedaccessreviews response: %v", err)
+	}
+}
+
+// newFakeLoopbackServer serves just enough of two APIs, on one server, to
+// exercise the real Loopback* resolvers exactly as they're used in
+// production against kube-apiserver's own loopback endpoint:
+//
+//   - GET /api/v1/namespaces (core v1, consumed by
+//     LoopbackClassificationResolver via a real client-go clientset) --
+//     filtered by labelSelector, matching real Kubernetes selector semantics
+//     via labels.Parse/labels.Set, not a hand-rolled string match.
+//   - POST /apis/authorization.deckhouse.io/v1alpha1/selfscopedaccessreviews
+//     (consumed by LoopbackAccessibleNamespaceFetcher, which lists
+//     namespaces and gets every accessible one, and by
+//     LoopbackRBACFloorResolver, whose action is answered from rules in the
+//     accessible namespaces).
+func newFakeLoopbackServer(t *testing.T, namespaces []corev1.Namespace, accessible []string, rules []accessRule) *httptest.Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+
+	mux.HandleFunc("/api/v1/namespaces", func(w http.ResponseWriter, r *http.Request) {
+		selector := labels.Everything()
+		if raw := r.URL.Query().Get("labelSelector"); raw != "" {
+			sel, err := labels.Parse(raw)
+			if err != nil {
+				http.Error(w, err.Error(), http.StatusBadRequest)
+				return
+			}
+			selector = sel
+		}
+
+		list := corev1.NamespaceList{TypeMeta: metav1.TypeMeta{APIVersion: "v1", Kind: "NamespaceList"}}
+		for _, ns := range namespaces {
+			if selector.Matches(labels.Set(ns.Labels)) {
+				list.Items = append(list.Items, ns)
+			}
+		}
+		w.Header().Set("Content-Type", "application/json")
+		if err := json.NewEncoder(w).Encode(list); err != nil {
+			t.Errorf("encode NamespaceList: %v", err)
+		}
+	})
+
+	mux.HandleFunc("/apis/authorization.deckhouse.io/v1alpha1/selfscopedaccessreviews", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			http.Error(w, "unsupported method", http.StatusMethodNotAllowed)
+			return
+		}
+		review, err := decodeReview(r)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		for _, req := range review.Spec.Requests {
+			result := reviewResult{Namespaces: []string{}}
+			for _, ns := range accessible {
+				// Listing namespaces is answered with the accessible
+				// namespaces, whatever the verb, as the permission
+				// browser does; anything else by the rules.
+				allowed := req.Resource == "namespaces" && req.Subresource == "" && slices.Equal(req.Verbs, []string{"list"})
+				for _, rule := range rules {
+					if rule.namespace == ns && rule.resource == req.Resource && rule.subresource == req.Subresource &&
+						slices.Equal([]string{rule.verb}, req.Verbs) {
+						allowed = rule.allowed
+						break
+					}
+				}
+				if allowed {
+					result.Namespaces = append(result.Namespaces, ns)
+				}
+			}
+			result.Allowed = len(result.Namespaces) > 0
+			review.Status.Results = append(review.Status.Results, result)
+		}
+		writeReview(t, w, review)
+	})
+
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+	return srv
+}
+
+func namespaceWithProjectLabel(name, project string) corev1.Namespace {
+	labelsMap := map[string]string{}
+	if project != "" {
+		labelsMap[scopefilter.ProjectLabel] = project
+	}
+	return corev1.Namespace{ObjectMeta: metav1.ObjectMeta{Name: name, Labels: labelsMap}}
+}
+
+func podNames(t *testing.T, obj runtime.Object) []string {
+	t.Helper()
+	list, ok := obj.(*example.PodList)
+	if !ok {
+		t.Fatalf("List returned %T, want *example.PodList", obj)
+	}
+	names := make([]string, len(list.Items))
+	for i, p := range list.Items {
+		names[i] = p.Name
+	}
+	return names
+}
