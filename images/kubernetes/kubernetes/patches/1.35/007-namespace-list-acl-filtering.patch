+// waitEstablished waits until the CRD is established, through the
+// apiextensions API only.
+func waitEstablished(ctx context.Context, t *testing.T, crdClient apiextensionsclientset.Interface, name string) {
+	t.Helper()
+	if err := wait.PollUntilContextTimeout(ctx, 200*time.Millisecond, time.Minute, true, func(ctx context.Context) (bool, error) {
+		got, err := crdClient.ApiextensionsV1().CustomResourceDefinitions().Get(ctx, name, metav1.GetOptions{})
+		if err != nil {
+			return false, nil
+		}
+		for _, cond := range got.Status.Conditions {
+			if cond.Type == apiextensionsv1.Established && cond.Status == apiextensionsv1.ConditionTrue {
+				return true, nil
+			}
+		}
+		return false, nil
+	}); err != nil {
+		t.Fatalf("CRD %s never became established: %v", name, err)
+	}
+}
+
+// requireFilterForbidden sends a denied scoped list of path and requires the
+// 403 of the filter, which fails closed without permission-browser: the plain
+// 403 of the authorization filter names the user, the filter's does not. So
+// the read was handed to a storage registered for the filter.
+func requireFilterForbidden(ctx context.Context, t *testing.T, denied clientset.Interface, path string) {
+	t.Helper()
+	raw, err := denied.Discovery().RESTClient().Get().AbsPath(path).SetHeader(scopeHeader, "accessible").DoRaw(ctx)
+	if !apierrors.IsForbidden(coerceStatusError(err)) {
+		t.Fatalf("denied scoped read of %s: expected Forbidden, got: %v", path, err)
+	}
+	var status metav1.Status
+	if err := json.Unmarshal(raw, &status); err != nil {
+		t.Fatalf("decode the 403 of %s: %v", path, err)
+	}
+	if strings.Contains(status.Message, "User ") || !strings.Contains(status.Message, "cannot list resource") {
+		t.Fatalf("denied scoped read of %s got %q, want the filter's 403", path, status.Message)
+	}
+}
+
+// coerceStatusError lets apierrors.IsForbidden see through DoRaw's habit of
+// returning the raw *StatusError already -- and turns a nil error into a
+// non-Forbidden sentinel so `!IsForbidden(...)` fails loudly on unexpected
+// success instead of panicking.
+func coerceStatusError(err error) error {
+	if err == nil {
+		return fmt.Errorf("request unexpectedly succeeded")
+	}
+	return err
+}
