+// TestFilteredWatch_RetractsWhatTheListShowed: a client that lists and then
+// watches from the list's resourceVersion gets no initial events, so the
+// stream never showed it the items of the list. Losing a namespace still
+// retracts them -- every item the namespace holds -- and before any storage
+// event the stubs carry the resourceVersion the watch was opened from.
+func TestFilteredWatch_RetractsWhatTheListShowed(t *testing.T) {
+	tests := []struct {
+		name    string
+		mode    scopefilter.IdentityMode
+		field   string
+		put     func(*fakeStore)
+		lost    string
+		deleted []string
+	}{
+		{
+			name:  "items of a namespace",
+			mode:  scopefilter.IdentityByNamespace,
+			field: scopefilter.NamespaceField,
+			put: func(s *fakeStore) {
+				s.put("ns-a", "pod-1")
+				s.put("ns-b", "pod-2")
+				s.put("ns-b", "pod-3")
+			},
+			lost:    "ns-b",
+			deleted: []string{"pod-2", "pod-3"},
+		},
+		{
+			// The store of namespaces filters its Get by the allowed set,
+			// which ns-b has just left: nothing may be read from it.
+			name:    "a namespace itself",
+			mode:    scopefilter.IdentityByName,
+			field:   scopefilter.NameField,
+			put:     func(*fakeStore) {},
+			lost:    "ns-b",
+			deleted: []string{"ns-b"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			store := newFakeStore()
+			tt.put(store)
+
+			var mu sync.Mutex
+			current := map[string]struct{}{"ns-a": {}, "ns-b": {}}
+			poll := func(context.Context) (map[string]struct{}, error) {
+				mu.Lock()
+				defer mu.Unlock()
+				return maps.Clone(current), nil
+			}
+
+			w := scopefilter.NewFilteredWatch(context.Background(), scopefilter.WatchConfig{
+				Inner:           newFakeWatch(),
+				Selector:        scopefilter.NewNameSetSelector(tt.field, map[string]struct{}{"ns-a": {}, "ns-b": {}}),
+				Mode:            tt.mode,
+				Store:           store,
+				BuildPredicate:  store.buildPredicate,
+				CallerLabel:     labels.Everything(),
+				CallerField:     fields.Everything(),
+				Poll:            poll,
+				Initial:         map[string]struct{}{"ns-a": {}, "ns-b": {}},
+				ResourceVersion: "100",
+				RefreshInterval: 20 * time.Millisecond,
+				UserName:        "alice",
+			})
+			defer w.Stop()
+
+			mu.Lock()
+			delete(current, tt.lost)
+			mu.Unlock()
+
+			var deleted []string
+			deadline := time.After(3 * time.Second)
+			for len(deleted) < len(tt.deleted) {
+				select {
+				case ev := <-w.ResultChan():
+					item, ok := ev.Object.(*fakeItem)
+					if ev.Type != watch.Deleted || !ok {
+						t.Fatalf("got %s %#v, want only the DELETED of %v", ev.Type, ev.Object, tt.deleted)
+					}
+					if item.ResourceVersion != "100" {
+						t.Fatalf("DELETED %s carries resourceVersion %q, want 100, the one the watch was opened from", item.Name, item.ResourceVersion)
+					}
+					deleted = append(deleted, item.Name)
+				case <-deadline:
+					t.Fatalf("got the DELETED of %v within 3s of losing %s, want %v", deleted, tt.lost, tt.deleted)
+				}
+			}
+			slices.Sort(deleted)
+			if !slices.Equal(deleted, tt.deleted) {
+				t.Fatalf("DELETED %v, want %v", deleted, tt.deleted)
+			}
+		})
+	}
+}
