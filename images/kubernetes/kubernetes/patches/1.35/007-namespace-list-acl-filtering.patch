+// TestFilteredWatch_PollErrorKeepsThePreviousSet: while the allowed set cannot
+// be refreshed for less than the limit, an open watch keeps serving the
+// previous set and retracts nothing.
+func TestFilteredWatch_PollErrorKeepsThePreviousSet(t *testing.T) {
+	store := newFakeStore()
+	store.put("ns-a", "pod-1")
+
+	var polls atomic.Int32
+	threePolls := make(chan struct{})
+	poll := func(context.Context) (map[string]struct{}, error) {
+		if polls.Add(1) == 3 {
+			close(threePolls)
+		}
+		return nil, fmt.Errorf("permission browser unavailable")
+	}
+
+	w := scopefilter.NewFilteredWatch(context.Background(), scopefilter.WatchConfig{
+		Inner:           newFakeWatch(),
+		Selector:        scopefilter.NewNameSetSelector(scopefilter.NamespaceField, map[string]struct{}{"ns-a": {}}),
+		Mode:            scopefilter.IdentityByNamespace,
+		Store:           store,
+		BuildPredicate:  store.buildPredicate,
+		CallerLabel:     labels.Everything(),
+		CallerField:     fields.Everything(),
+		Poll:            poll,
+		Initial:         map[string]struct{}{"ns-a": {}},
+		RefreshInterval: 10 * time.Millisecond,
+		UserName:        "alice",
+	})
+	defer w.Stop()
+
+	select {
+	case <-threePolls:
+	case <-time.After(3 * time.Second):
+		t.Fatal("the allowed set was not polled three times within 3s")
+	}
+	select {
+	case ev, open := <-w.ResultChan():
+		if open {
+			t.Fatalf("got %s event after failed polls, want none: the previous set is kept", ev.Type)
+		}
+		t.Fatal("the watch was closed after failed polls, want it kept open")
+	case <-time.After(100 * time.Millisecond):
+	}
+}
+
+// TestFilteredWatch_PollErrorClosesTheWatchAfterTheLimit: once refreshes of the
+// allowed set have been failing for the limit -- a timeout of the permission
+// service is a failure like any other -- the watch reports why and closes.
+func TestFilteredWatch_PollErrorClosesTheWatchAfterTheLimit(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+	}{
+		{name: "an error", err: fmt.Errorf("permission browser unavailable")},
+		{name: "a timeout", err: fmt.Errorf("permission browser: %w", context.DeadlineExceeded)},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			scopefilter.SetWatchRefreshFailureLimitForTest(t, 100*time.Millisecond)
+
+			store := newFakeStore()
+			store.put("ns-a", "pod-1")
+
+			w := scopefilter.NewFilteredWatch(context.Background(), scopefilter.WatchConfig{
+				Inner:           newFakeWatch(),
+				Selector:        scopefilter.NewNameSetSelector(scopefilter.NamespaceField, map[string]struct{}{"ns-a": {}}),
+				Mode:            scopefilter.IdentityByNamespace,
+				Store:           store,
+				BuildPredicate:  store.buildPredicate,
+				CallerLabel:     labels.Everything(),
+				CallerField:     fields.Everything(),
+				Poll:            func(context.Context) (map[string]struct{}, error) { return nil, tt.err },
+				Initial:         map[string]struct{}{"ns-a": {}},
+				RefreshInterval: 10 * time.Millisecond,
+				UserName:        "alice",
+			})
+			defer w.Stop()
+
+			var gotError bool
+			deadline := time.After(3 * time.Second)
+			for {
+				select {
+				case ev, open := <-w.ResultChan():
+					if !open {
+						if !gotError {
+							t.Fatal("the watch closed without an error event")
+						}
+						return
+					}
+					if ev.Type != watch.Error {
+						t.Fatalf("got %s event, want only an error before the watch closes", ev.Type)
+					}
+					status, ok := ev.Object.(*metav1.Status)
+					if !ok || status.Code != 503 {
+						t.Fatalf("error event object = %#v, want a 503 status", ev.Object)
+					}
+					gotError = true
+				case <-deadline:
+					t.Fatal("the watch was not closed within 3s of failing refreshes with a 100ms limit")
+				}
+			}
+		})
+	}
+}
