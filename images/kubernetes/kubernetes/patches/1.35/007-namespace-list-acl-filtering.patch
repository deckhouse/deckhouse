+// TestIntegration_FloorError_IsForbidden: a permission browser that answers
+// without namespaces -- a 404 of one that does not serve
+// SelfScopedAccessReview yet, a resource it does not filter, a request it
+// could not evaluate -- gets the bypassed list refused, not answered with
+// what could be computed. There is no other way to the floor.
+func TestIntegration_FloorError_IsForbidden(t *testing.T) {
+	answers := []struct {
+		name   string
+		status int
+		result reviewResult
+	}{
+		{name: "not served", status: http.StatusNotFound},
+		{name: "not filterable", status: http.StatusOK, result: reviewResult{Reason: "NotFilterable"}},
+		{name: "not evaluated", status: http.StatusOK, result: reviewResult{EvaluationError: "discovery has not answered"}},
+	}
+	for _, answer := range answers {
+		t.Run(answer.name, func(t *testing.T) {
+			store, destroy := newIntegrationStore(t)
+			defer destroy()
+
+			mux := http.NewServeMux()
+			mux.HandleFunc("/apis/authorization.deckhouse.io/v1alpha1/selfscopedaccessreviews", func(w http.ResponseWriter, r *http.Request) {
+				review, err := decodeReview(r)
+				if err != nil {
+					http.Error(w, err.Error(), http.StatusBadRequest)
+					return
+				}
+				if answer.status != http.StatusOK {
+					http.Error(w, "permission browser failure", answer.status)
+					return
+				}
+				review.Status.Results = []reviewResult{answer.result}
+				writeReview(t, w, review)
+			})
+			srv := httptest.NewServer(mux)
+			t.Cleanup(srv.Close)
+
+			decorator := buildDecorator(t, store, srv)
+			ctx := scopeCtx(t, decorator, scopefilter.Request{Kind: scopefilter.KindAccessible}, true)
+
+			_, err := decorator.List(ctx, nil)
+			if !apierrors.IsForbidden(err) {
+				t.Fatalf("List error = %v, want Forbidden", err)
+			}
+		})
+	}
+}
+
+// TestIntegration_FloorUnavailable_IsServiceUnavailable: a permission browser
+// that cannot answer now -- overloaded (429), past its own deadline (504) or
+// failing (500, 503 of an unreachable APIService) -- gets the bypassed list
+// answered with 503 and Retry-After: the access of the caller is unknown, not
+// refused. Nothing is served either way.
+func TestIntegration_FloorUnavailable_IsServiceUnavailable(t *testing.T) {
+	for _, status := range []int{http.StatusTooManyRequests, http.StatusInternalServerError, http.StatusServiceUnavailable, http.StatusGatewayTimeout} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			store, destroy := newIntegrationStore(t)
+			defer destroy()
+
+			srv := newFloorServer(t, []string{"ns-a", "ns-b"}, status, nil)
+
+			decorator := buildDecorator(t, store, srv)
+			ctx := scopeCtx(t, decorator, scopefilter.Request{Kind: scopefilter.KindAccessible}, true)
+
+			_, err := decorator.List(ctx, nil)
+			requireUnavailable(t, err)
+		})
+	}
+}
+
+// TestIntegration_Floor_ClusterWideAnswerIsForbidden: the floor is computed
+// only for a request kube-apiserver denied. A permission service that answers
+// "allowed in the whole cluster" disagrees with it, and the request is refused
+// rather than answered with every namespace.
+func TestIntegration_Floor_ClusterWideAnswerIsForbidden(t *testing.T) {
+	store, destroy := newIntegrationStore(t)
+	defer destroy()
+
+	mux := http.NewServeMux()
+	mux.HandleFunc("/apis/authorization.deckhouse.io/v1alpha1/selfscopedaccessreviews", func(w http.ResponseWriter, r *http.Request) {
+		review, err := decodeReview(r)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		review.Status.Results = []reviewResult{{Allowed: true, Cluster: true}}
+		writeReview(t, w, review)
+	})
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+
+	decorator := buildDecorator(t, store, srv)
+	ctx := scopeCtx(t, decorator, scopefilter.Request{Kind: scopefilter.KindAccessible}, true)
+
+	if _, err := decorator.List(ctx, nil); !apierrors.IsForbidden(err) {
+		t.Fatalf("List error = %v, want Forbidden", err)
+	}
+}
+
+// TestLoopbackAccessibleNamespaceFetcher_ListsNamespaces: the accessible
+// namespaces are asked as one review of listing namespaces in the accessible
+// scope -- never get, which the permission browser checks per namespace, a
+// right namespace roles do not grant.
+func TestLoopbackAccessibleNamespaceFetcher_ListsNamespaces(t *testing.T) {
+	var got []scopedReview
+	srv := newFloorServer(t, []string{"ns-a", "ns-b"}, http.StatusOK, func(review scopedReview) {
+		got = append(got, review)
+	})
+	fetcher, err := scopefilter.NewLoopbackAccessibleNamespaceFetcher(&restclient.Config{Host: srv.URL})
+	if err != nil {
+		t.Fatalf("NewLoopbackAccessibleNamespaceFetcher: %v", err)
+	}
+
+	names, err := fetcher.FetchAccessibleNamespaces(context.Background(), &user.DefaultInfo{Name: "alice"})
+	if err != nil {
+		t.Fatalf("FetchAccessibleNamespaces: %v", err)
+	}
+	if !sameStrings(names, "ns-a", "ns-b") {
+		t.Fatalf("names = %v, want ns-a and ns-b", names)
+	}
+	if len(got) != 1 || len(got[0].Spec.Requests) != 1 {
+		t.Fatalf("reviews = %+v, want one with one request", got)
+	}
+	req := got[0].Spec.Requests[0]
+	if got[0].Kind != "SelfScopedAccessReview" || got[0].Spec.Scope != "accessible" ||
+		req.Group != "" || req.Resource != "namespaces" || req.Subresource != "" ||
+		!slices.Equal(req.Verbs, []string{"list"}) || !req.IncludeNamespaces {
+		t.Fatalf("review = %+v, want namespaces list in the accessible scope with names", got[0])
+	}
+}
+
+// TestIntegration_Floor_OneReviewForAllCandidates: the floor asks the
+// permission browser once, with one request, however many namespaces the
+// caller can see: a caller with 10001 of them gets a filtered list, not a 403.
+func TestIntegration_Floor_OneReviewForAllCandidates(t *testing.T) {
+	store, destroy := newIntegrationStore(t)
+	defer destroy()
+
+	accessible := make([]string, 10001)
+	for i := range accessible {
+		accessible[i] = fmt.Sprintf("ns-%05d", i)
+	}
+	seedPod(t, store, "ns-10000", "pod-last")
+	seedPod(t, store, "elsewhere", "pod-hidden")
+	var mu sync.Mutex
+	var reviews []int
+	srv := newFloorServer(t, accessible, http.StatusOK, func(review scopedReview) {
+		mu.Lock()
+		defer mu.Unlock()
+		reviews = append(reviews, len(review.Spec.Requests))
+	})
+
+	decorator := buildDecorator(t, store, srv)
+	ctx := scopeCtx(t, decorator, scopefilter.Request{Kind: scopefilter.KindAccessible}, true)
+
+	out, err := decorator.List(ctx, nil)
+	if err != nil {
+		t.Fatalf("List: %v", err)
+	}
+	if got := podNames(t, out); !sameStrings(got, "pod-last") {
+		t.Fatalf("got %v, want [pod-last]", got)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(reviews) != 1 || reviews[0] != 1 {
+		t.Fatalf("reviews sent = %v, want one with one request", reviews)
+	}
+}
+
+// ----- shared wiring helpers -------------------------------------------------
+
+// newFloorServer answers every SelfScopedAccessReview with status; on a 200
+// the action is allowed in every accessible namespace. onReview, when set,
+// gets every review.
+func newFloorServer(t *testing.T, accessible []string, status int, onReview func(scopedReview)) *httptest.Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	mux.HandleFunc("/apis/authorization.deckhouse.io/v1alpha1/selfscopedaccessreviews", func(w http.ResponseWriter, r *http.Request) {
+		review, err := decodeReview(r)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		if onReview != nil {
+			onReview(review)
+		}
+		if status != http.StatusOK {
+			http.Error(w, "permission browser failure", status)
+			return
+		}
+		for range review.Spec.Requests {
+			review.Status.Results = append(review.Status.Results, reviewResult{
+				Allowed:    len(accessible) > 0,
+				Namespaces: accessible,
+			})
+		}
+		writeReview(t, w, review)
+	})
+
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+	return srv
+}
+
+func namespaceWithLabels(name string, labelsMap map[string]string) corev1.Namespace {
+	return corev1.Namespace{ObjectMeta: metav1.ObjectMeta{Name: name, Labels: labelsMap}}
+}
+
+// seedPod stores a pod straight through the storage of the store, as
+// newIntegrationStore seeds its own.
+func seedPod(t *testing.T, store *genericregistry.Store, namespace, name string) {
+	t.Helper()
+	ctx := genericapirequest.WithNamespace(genericapirequest.NewContext(), namespace)
+	key, err := store.KeyFunc(ctx, name)
+	if err != nil {
+		t.Fatalf("KeyFunc(%s/%s): %v", namespace, name, err)
+	}
+	pod := &example.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: namespace, Name: name}}
+	if err := store.Storage.Storage.Create(ctx, key, pod, nil, 0); err != nil {
+		t.Fatalf("seed %s/%s: %v", namespace, name, err)
+	}
+}
+
+func sameStrings(got []string, want ...string) bool {
+	got = append([]string(nil), got...)
+	want = append([]string(nil), want...)
+	sort.Strings(got)
+	sort.Strings(want)
+	if len(got) != len(want) {
+		return false
+	}
+	for i := range got {
+		if got[i] != want[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func buildDecorator(t *testing.T, store *genericregistry.Store, srv *httptest.Server) *scopefilter.Decorator {
+	t.Helper()
+	cfg := &restclient.Config{Host: srv.URL}
+
+	accessible, err := scopefilter.NewLoopbackAccessibleNamespaceFetcher(cfg)
+	if err != nil {
+		t.Fatalf("NewLoopbackAccessibleNamespaceFetcher: %v", err)
+	}
+	classify, err := scopefilter.NewLoopbackClassificationResolver(cfg)
+	if err != nil {
+		t.Fatalf("NewLoopbackClassificationResolver: %v", err)
+	}
+	floor, err := scopefilter.NewLoopbackRBACFloorResolver(cfg)
+	if err != nil {
+		t.Fatalf("NewLoopbackRBACFloorResolver: %v", err)
+	}
+
+	return &scopefilter.Decorator{
+		Store:          store,
+		BuildPredicate: store.PredicateFunc,
+		Resource:       schema.GroupVersionResource{Group: "", Version: "v1", Resource: "pods"},
+		Mode:           scopefilter.IdentityByNamespace,
+		Classify:       classify,
+		RBACFloor:      floor,
+		Accessible:     accessible,
+	}
+}
+
+// scopeCtx builds a request context tagged exactly as authorization.go's
+// generic bypass branch would tag it for a denied-then-bypassed request
+// (WithRequest + WithBypass together) -- the HTTP-level authorization
+// filter itself is Layer 2's concern, not this layer's; this test starts
+// from "the filter already decided to bypass" and verifies everything
+// downstream of that decision.
+func scopeCtx(t *testing.T, _ *scopefilter.Decorator, req scopefilter.Request, bypass bool) context.Context {
+	t.Helper()
+	ctx := genericapirequest.WithUser(genericapirequest.NewContext(), &user.DefaultInfo{Name: "alice"})
+	ctx = scopefilter.WithRequest(ctx, req)
+	if bypass {
+		ctx = scopefilter.WithBypass(ctx)
+	}
+	return ctx
+}
+
+// TestIntegration_FloorTimeout_IsServiceUnavailable: a permission service
+// that does not answer within the timeout of the call gets the bypassed list
+// answered with 503 and Retry-After, not with what could be computed.
+func TestIntegration_FloorTimeout_IsServiceUnavailable(t *testing.T) {
+	scopefilter.SetReviewTimeoutForTest(t, 200*time.Millisecond)
+	store, destroy := newIntegrationStore(t)
+	defer destroy()
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case <-r.Context().Done():
+		case <-time.After(5 * time.Second):
+		}
+		http.Error(w, "permission browser too slow", http.StatusGatewayTimeout)
+	}))
+	t.Cleanup(srv.Close)
+
+	decorator := buildDecorator(t, store, srv)
+	ctx := scopeCtx(t, decorator, scopefilter.Request{Kind: scopefilter.KindAccessible}, true)
+
+	start := time.Now()
+	_, err := decorator.List(ctx, nil)
+	requireUnavailable(t, err)
+	if elapsed := time.Since(start); elapsed > 4*time.Second {
+		t.Fatalf("List took %s, want the call cut off by its timeout", elapsed)
+	}
+}
+
+// requireUnavailable fails unless err is the 503 of a permission service that
+// cannot answer now, with a Retry-After.
+func requireUnavailable(t *testing.T, err error) {
+	t.Helper()
+	if !apierrors.IsServiceUnavailable(err) {
+		t.Fatalf("List error = %v, want ServiceUnavailable", err)
+	}
+	if seconds, ok := apierrors.SuggestsClientDelay(err); !ok || seconds < 1 {
+		t.Fatalf("List error retry after = %d, %v; want a positive Retry-After", seconds, ok)
+	}
+}
+
+// TestIntegration_BypassedListPagesThroughTheFloor: a bypassed list with a
+// limit pages through the namespaces of the floor and nothing else -- every
+// page within the limit, the continue token carrying the rest.
+func TestIntegration_BypassedListPagesThroughTheFloor(t *testing.T) {
+	store, destroy := newIntegrationStore(t)
+	defer destroy()
+	seedPod(t, store, "ns-a", "pod-1b")
+
+	srv := newFakeLoopbackServer(t,
+		[]corev1.Namespace{
+			namespaceWithLabels("ns-a", nil),
+			namespaceWithLabels("ns-b", nil),
+			namespaceWithLabels("d8-ns-sys", nil),
+		},
+		[]string{"ns-a", "ns-b", "d8-ns-sys"},
+		[]accessRule{
+			{namespace: "ns-a", resource: "pods", verb: "list", allowed: true},
+			{namespace: "d8-ns-sys", resource: "pods", verb: "list", allowed: true},
+		},
+	)
+
+	decorator := buildDecorator(t, store, srv)
+	ctx := scopeCtx(t, decorator, scopefilter.Request{Kind: scopefilter.KindAccessible}, true)
+
+	var names []string
+	options := &metainternalversion.ListOptions{Limit: 1}
+	for page := 0; ; page++ {
+		if page > 10 {
+			t.Fatal("more than 10 pages for 3 objects")
+		}
+		out, err := decorator.List(ctx, options)
+		if err != nil {
+			t.Fatalf("page %d: %v", page, err)
+		}
+		got := podNames(t, out)
+		if len(got) > 1 {
+			t.Fatalf("page %d has %v with limit 1", page, got)
+		}
+		names = append(names, got...)
+		list, err := meta.ListAccessor(out)
+		if err != nil {
+			t.Fatalf("page %d: %v", page, err)
+		}
+		if list.GetContinue() == "" {
+			break
+		}
+		options = &metainternalversion.ListOptions{Limit: 1, Continue: list.GetContinue()}
+	}
+	if !sameStrings(names, "pod-1", "pod-1b", "pod-sys") {
+		t.Fatalf("pages returned %v, want pod-1, pod-1b and pod-sys: ns-b is outside the floor", names)
+	}
+}
