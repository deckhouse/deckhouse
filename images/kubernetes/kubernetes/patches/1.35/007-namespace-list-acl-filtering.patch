+limitations under the License.
+*/
+
+package apiserver
+
+import (
+	"testing"
+
+	"k8s.io/apimachinery/pkg/fields"
+	"k8s.io/apimachinery/pkg/labels"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apiserver/pkg/registry/generic/registry"
+	"k8s.io/apiserver/pkg/registry/generic/scopefilter"
+	"k8s.io/apiserver/pkg/registry/rest"
+	genericapiserver "k8s.io/apiserver/pkg/server"
+	"k8s.io/apiserver/pkg/storage"
+)
+
+func minimalStore() *registry.Store {
+	return &registry.Store{
+		PredicateFunc: func(l labels.Selector, f fields.Selector) storage.SelectionPredicate {
+			return storage.SelectionPredicate{Label: l, Field: f}
+		},
+	}
+}
+
+// nsEmbed embeds *registry.Store (promoting DeckhouseScopeStore) and is
+// namespaced -- the shape of a standard built-in resource, must be wired.
+type nsEmbed struct{ *registry.Store }
+
+func (nsEmbed) NamespaceScoped() bool { return true }
+
+// clusterEmbed embeds the store but is cluster-scoped -- must be skipped.
+type clusterEmbed struct{ *registry.Store }
+
+func (clusterEmbed) NamespaceScoped() bool { return false }
+
+// nsWrap is namespaced but WRAPS the store in an unexported field (does not
+// promote DeckhouseScopeStore) -- the namespaces-storage shape, must be
+// skipped.
+type nsWrap struct{ s *registry.Store }
+
+func (nsWrap) NamespaceScoped() bool { return true }
+func (nsWrap) New() runtime.Object   { return nil }
+func (nsWrap) Destroy()              {}
+
+var (
+	_ rest.Scoper = nsEmbed{}
+	_ rest.Scoper = clusterEmbed{}
+	_ rest.Scoper = nsWrap{}
+)
+
+// TestWireScopeFilterForGroup_SelectsOnlyNamespacedEmbeddedResources verifies
+// the coverage rule end to end: a namespaced resource embedding *Store gets
+// registered with the correct group; a cluster-scoped one, a subresource
+// (name contains '/'), and a namespaced-but-wrapping one are all skipped.
+func TestWireScopeFilterForGroup_SelectsOnlyNamespacedEmbeddedResources(t *testing.T) {
+	info := &genericapiserver.APIGroupInfo{
+		PrioritizedVersions: []schema.GroupVersion{{Group: "apps", Version: "v1"}},
+		VersionedResourcesStorageMap: map[string]map[string]rest.Storage{
+			"v1": {
+				"deployments":       nsEmbed{minimalStore()},      // wire
+				"deployments/scale": nsEmbed{minimalStore()},      // skip: subresource
+				"clusterwidgets":    clusterEmbed{minimalStore()}, // skip: cluster-scoped
+				"wrappedns":         nsWrap{minimalStore()},       // skip: wraps, no promote
+			},
+		},
+	}
+
+	// A non-nil bundle so wiring proceeds; resolvers are never invoked here.
+	wireScopeFilterForGroup(info, &scopefilter.Resolvers{})
+
+	mustBe := func(gr schema.GroupResource, want bool) {
+		t.Helper()
+		if got := scopefilter.IsRegistered(gr); got != want {
+			t.Fatalf("IsRegistered(%v) = %v, want %v", gr, got, want)
+		}
+	}
+	mustBe(schema.GroupResource{Group: "apps", Resource: "deployments"}, true)
+	mustBe(schema.GroupResource{Group: "apps", Resource: "deployments/scale"}, false)
+	mustBe(schema.GroupResource{Group: "apps", Resource: "clusterwidgets"}, false)
+	mustBe(schema.GroupResource{Group: "apps", Resource: "wrappedns"}, false)
+
+	// Group derivation must match requestInfo.APIGroup exactly: the wrong
+	// group (e.g. empty) must NOT be registered for an apps resource.
+	mustBe(schema.GroupResource{Group: "", Resource: "deployments"}, false)
+}
+
+// TestWireScopeFilterForGroup_NilResolversIsNoop: with no resolver bundle,
+// nothing is registered (fail-safe: no header can bypass anything).
+func TestWireScopeFilterForGroup_NilResolversIsNoop(t *testing.T) {
+	info := &genericapiserver.APIGroupInfo{
+		PrioritizedVersions: []schema.GroupVersion{{Group: "batch", Version: "v1"}},
+		VersionedResourcesStorageMap: map[string]map[string]rest.Storage{
+			"v1": {"cronjobs": nsEmbed{minimalStore()}},
+		},
+	}
+	wireScopeFilterForGroup(info, nil)
+	if scopefilter.IsRegistered(schema.GroupResource{Group: "batch", Resource: "cronjobs"}) {
+		t.Fatal("nil resolvers must register nothing")
+	}
+}
