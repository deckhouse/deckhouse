+// TestWithAuthorization_NamespaceReadNeedsTheFilter: a denied read of
+// namespaces is let through for the filter only when the namespaces storage
+// built it (and registered namespaces); without it the read gets the plain
+// 403.
+func TestWithAuthorization_NamespaceReadNeedsTheFilter(t *testing.T) {
+	namespaces := schema.GroupResource{Resource: "namespaces"}
+	scheme := runtime.NewScheme()
+	negotiatedSerializer := serializer.NewCodecFactory(scheme).WithoutConversion()
+
+	for _, path := range []string{"/api/v1/namespaces", "/api/v1/namespaces/ns-a"} {
+		handler := &scopeTestHandler{}
+		w := httptest.NewRecorder()
+		WithAuthorization(handler, denyAllAuthorizer(), negotiatedSerializer).ServeHTTP(w, newScopeTestRequest(t, http.MethodGet, path, ""))
+		if handler.called || w.Code != http.StatusForbidden {
+			t.Fatalf("%s without the filter: handler ran = %v, HTTP %d; want the plain 403", path, handler.called, w.Code)
+		}
+	}
+
+	scopefilter.Register(namespaces)
+	t.Cleanup(func() { scopefilter.Unregister(namespaces) })
+	for _, path := range []string{"/api/v1/namespaces", "/api/v1/namespaces/ns-a"} {
+		handler := &scopeTestHandler{}
+		w := httptest.NewRecorder()
+		WithAuthorization(handler, denyAllAuthorizer(), negotiatedSerializer).ServeHTTP(w, newScopeTestRequest(t, http.MethodGet, path, ""))
+		if !handler.called || !handler.gotNamespaceMode {
+			t.Fatalf("%s with the filter: handler ran = %v, namespace filtering mode = %v, HTTP %d; want it let through", path, handler.called, handler.gotNamespaceMode, w.Code)
+		}
+	}
+}
