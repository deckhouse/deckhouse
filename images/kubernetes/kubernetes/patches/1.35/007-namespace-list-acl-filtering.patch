+package filters
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/runtime/serializer"
+	"k8s.io/apiserver/pkg/registry/generic/scopefilter"
+)
+
+// identityTestHandler records whether the denied request was handed to the
+// storage layer in namespace-filtering mode -- the flag the identity
+// resources' Decorator triggers on.
+type identityTestHandler struct {
+	called        bool
+	filteringMode bool
+}
+
+func (h *identityTestHandler) ServeHTTP(w http.ResponseWriter, req *http.Request) {
+	h.called = true
+	h.filteringMode = scopefilter.IsNamespaceFilteringMode(req.Context())
+	w.WriteHeader(http.StatusOK)
+}
+
+// TestWithAuthorization_IdentityResourceBypass covers the bypass for a
+// cluster-scoped resource whose visibility is derived from the namespace ACL
+// (the Project CRD).
+// The negative cases are the ones that matter: the bypass must not widen to
+// resources nobody wired a filter for, nor to verbs that mutate.
+func TestWithAuthorization_IdentityResourceBypass(t *testing.T) {
+	projects := schema.GroupResource{Group: "deckhouse.io", Resource: "projects"}
+	scopefilter.Register(projects)
+	t.Cleanup(func() { scopefilter.Unregister(projects) })
+
+	scheme := runtime.NewScheme()
+	negotiatedSerializer := serializer.NewCodecFactory(scheme).WithoutConversion()
+
+	tests := []struct {
+		name       string
+		method     string
+		path       string
+		wantBypass bool
+	}{
+		{
+			name:       "list projects is filtered instead of denied",
+			method:     http.MethodGet,
+			path:       "/apis/deckhouse.io/v1alpha3/projects",
+			wantBypass: true,
+		},
+		{
+			name:       "get a single project is filtered instead of denied",
+			method:     http.MethodGet,
+			path:       "/apis/deckhouse.io/v1alpha3/projects/team-a",
+			wantBypass: true,
+		},
+		{
+			name:       "watch projects is filtered instead of denied",
+			method:     http.MethodGet,
+			path:       "/apis/deckhouse.io/v1alpha3/projects?watch=true",
+			wantBypass: true,
+		},
+		{
+			name:       "creating a project is still denied",
+			method:     http.MethodPost,
+			path:       "/apis/deckhouse.io/v1alpha3/projects",
+			wantBypass: false,
+		},
+		{
+			name:       "deleting a project is still denied",
+			method:     http.MethodDelete,
+			path:       "/apis/deckhouse.io/v1alpha3/projects/team-a",
+			wantBypass: false,
+		},
+		{
+			name:       "a subresource is never filtered",
+			method:     http.MethodGet,
+			path:       "/apis/deckhouse.io/v1alpha3/projects/team-a/status",
+			wantBypass: false,
+		},
+		{
+			name:       "another cluster-scoped resource of the same group is untouched",
+			method:     http.MethodGet,
+			path:       "/apis/deckhouse.io/v1alpha1/projecttemplates",
+			wantBypass: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			handler := &identityTestHandler{}
+			wrapped := WithAuthorization(handler, denyAllAuthorizer(), negotiatedSerializer)
+			req := newScopeTestRequest(t, tt.method, tt.path, "")
+			w := httptest.NewRecorder()
+			wrapped.ServeHTTP(w, req)
+
+			if tt.wantBypass {
+				if !handler.called {
+					t.Fatalf("expected the storage layer to be reached, got HTTP %d: %s", w.Code, w.Body.String())
+				}
+				if !handler.filteringMode {
+					t.Fatal("the request reached storage without namespace-filtering mode, so nothing would filter it")
+				}
+				return
+			}
+
+			if handler.called {
+				t.Fatal("expected a plain denial, but the request was handed to the storage layer")
+			}
+			if w.Code != http.StatusForbidden {
+				t.Fatalf("expected 403 Forbidden, got %d: %s", w.Code, w.Body.String())
+			}
+		})
+	}
+}
+
+// TestWithAuthorization_IdentityResourceNotRegistered pins the gate that makes
+// the bypass safe when the CRD is absent: without a registered filter the read
+// must stay denied rather than fall through unfiltered.
+func TestWithAuthorization_IdentityResourceNotRegistered(t *testing.T) {
+	scheme := runtime.NewScheme()
+	negotiatedSerializer := serializer.NewCodecFactory(scheme).WithoutConversion()
+
+	handler := &identityTestHandler{}
+	wrapped := WithAuthorization(handler, denyAllAuthorizer(), negotiatedSerializer)
+	req := newScopeTestRequest(t, http.MethodGet, "/apis/deckhouse.io/v1alpha3/projects", "")
+	w := httptest.NewRecorder()
+	wrapped.ServeHTTP(w, req)
+
+	if handler.called {
+		t.Fatal("no filter is registered for projects, so the read must not reach the storage layer")
+	}
+	if w.Code != http.StatusForbidden {
+		t.Fatalf("expected 403 Forbidden, got %d: %s", w.Code, w.Body.String())
+	}
+}
