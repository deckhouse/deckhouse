index 5a41c95..6f8169d 100644
--- a/pkg/kubelet/kubelet_pods.go
+++ b/pkg/kubelet/kubelet_pods.go
@@ -498,8 +498,9 @@ func nodeHostsFileContent(hostsFilePath string, hostAliases []v1.HostAlias) ([]b
 	}
 	var buffer bytes.Buffer
 	buffer.WriteString(managedHostsHeaderWithHostNetwork)
-	buffer.Write(hostsFileContent)
+	// HostAliases go first: resolvers take the first match, so stale node entries must not shadow them.
 	buffer.Write(hostsEntriesFromHostAliases(hostAliases))
+	buffer.Write(hostsFileContent)
 	return buffer.Bytes(), nil
 }
 
