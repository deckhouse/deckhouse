 }
 
 func makeTransport(config *schedulerapi.Extender) (http.RoundTripper, error) {
@@ -120,6 +121,7 @@ func NewHTTPExtender(config *schedulerapi.Extender) (framework.Extender, error)
 		nodeCacheCapable: config.NodeCacheCapable,
 		managedResources: managedResources,
 		ignorable:        config.Ignorable,
+		breaker:          newCircuitBreaker(config.URLPrefix, config.Ignorable),
 	}, nil
 }
 
@@ -408,13 +410,27 @@ func (h *HTTPExtender) send(action string, args interface{}, result interface{})
 	return h.sendRecorded(action, args, result, true)
 }
 
-// sendRecorded sends a request; with record it observes the request metrics.
-// Deckhouse: simulations (deckhouse_simulate.go) are not recorded.
+// sendRecorded sends a request; with record it observes the request metrics and
+// feeds the circuit breaker. Deckhouse: simulations (deckhouse_simulate.go) are not recorded.
 func (h *HTTPExtender) sendRecorded(action string, args interface{}, result interface{}, record bool) (err error) {
 	start, outcome := time.Now(), "error"
+	// Deckhouse: the breaker covers filter and prioritize, as upstream kubernetes#142911;
+	// bind and preempt always go out and do not count. A simulation skips an extender the
+	// breaker skips, but takes no half-open probe and records nothing.
+	gated := action == h.filterVerb || action == h.prioritizeVerb
+	if gated && (record && !h.breaker.allow() || !record && h.breaker.skipping()) {
+		if record {
+			metrics.ExtenderRequestDuration.WithLabelValues(h.name, action, "skipped").Observe(time.Since(start).Seconds())
+		}
+		return errCircuitOpen
+	}
 	defer func() {
 		if record {
 			metrics.ExtenderRequestDuration.WithLabelValues(h.name, action, outcome).Observe(time.Since(start).Seconds())
+			if gated {
+				// An error the extender reports in its answer is not a failure to answer.
+				h.breaker.done(outcome == "success" || outcome == "extender_error")
+			}
 		}
 	}()
 
