+
+// An ignorable extender is skipped after ten failed requests in a row, probed after the open
+// period, and called again once the probe succeeds; a non-ignorable one has no breaker. Nine
+// failures in a row followed by a success do not open it.
+func TestExtenderCircuitBreaker(t *testing.T) {
+	metrics.Register()
+	if newCircuitBreaker("x", false) != nil {
+		t.Fatal("a non-ignorable extender must not get a breaker")
+	}
+	opened := func() float64 {
+		v, _ := testutil.GetCounterMetricValue(metrics.ExtenderCircuitOpenTotal.WithLabelValues("cb"))
+		return v
+	}
+	openedBefore := opened()
+	now := time.Unix(0, 0)
+	b := newCircuitBreaker("cb", true)
+	b.now = func() time.Time { return now }
+	for range 9 {
+		b.allow()
+		b.done(false)
+	}
+	b.allow()
+	b.done(true)
+	for range 10 {
+		if !b.allow() {
+			t.Fatal("closed breaker skipped a request")
+		}
+		b.done(false)
+	}
+	if b.allow() || !b.skipping() {
+		t.Fatal("open breaker let a request through")
+	}
+	now = now.Add(31 * time.Second)
+	if !b.allow() || b.allow() {
+		t.Fatal("after the open period exactly one probe must go through")
+	}
+	b.done(false) // the probe fails: open again
+	if b.allow() {
+		t.Fatal("breaker did not reopen after a failed probe")
+	}
+	now = now.Add(31 * time.Second)
+	if !b.allow() {
+		t.Fatal("no probe after the second open period")
+	}
+	b.done(true)
+	if !b.allow() || !b.allow() {
+		t.Fatal("breaker did not close after a successful probe")
+	}
+	if got := opened() - openedBefore; got != 2 {
+		t.Errorf("opened %v times, want 2", got)
+	}
+}
+
+// A simulation skips an extender the breaker skips, but neither takes the
+// half-open probe nor counts its result: the next real request gets the probe.
+func TestDeckhouseExtenderBreakerSimulation(t *testing.T) {
+	metrics.Register()
+	calls := 0
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		calls++
+		_, _ = w.Write([]byte(`[]`))
+	}))
+	defer srv.Close()
+	e, err := NewHTTPExtender(&schedulerapi.Extender{URLPrefix: srv.URL, PrioritizeVerb: "prioritize", Weight: 1, Ignorable: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ext := e.(*HTTPExtender)
+	now := time.Unix(0, 0)
+	ext.breaker.now = func() time.Time { return now }
+	for range ext.breaker.limit {
+		ext.breaker.allow()
+		ext.breaker.done(false)
+	}
+	node := framework.NewNodeInfo()
+	node.SetNode(&v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n"}})
+	sim := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Annotations: map[string]string{DeckhouseSimulationAnnotation: "true"}}}
+	if _, _, err := ext.Prioritize(sim, []fwk.NodeInfo{node}); err == nil || calls != 0 {
+		t.Fatalf("simulation while the breaker is open: err %v, %d calls; want skipped", err, calls)
+	}
+	now = now.Add(time.Hour) // the open period is over: the next real request is the probe
+	if _, _, err := ext.Prioritize(sim, []fwk.NodeInfo{node}); err != nil || calls != 1 {
+		t.Fatalf("simulation after the open period: err %v, %d calls; want sent", err, calls)
+	}
+	if !ext.breaker.allow() {
+		t.Fatal("the simulation took the half-open probe")
+	}
+	ext.breaker.done(true)
+	if ext.breaker.skipping() {
+		t.Error("the successful probe did not close the breaker")
+	}
+}
+
+// The breaker covers filter and prioritize only: bind of a paused extender
+// still goes out, and an error the extender reports in its answer does not
+// count as a failure.
+func TestDeckhouseExtenderBreakerScope(t *testing.T) {
+	metrics.Register()
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		_, _ = w.Write([]byte(`{"error":"busy"}`))
+	}))
+	defer srv.Close()
+	e, err := NewHTTPExtender(&schedulerapi.Extender{URLPrefix: srv.URL, FilterVerb: "filter", BindVerb: "bind", Weight: 1, Ignorable: true, NodeCacheCapable: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ext := e.(*HTTPExtender)
+	node := framework.NewNodeInfo()
+	node.SetNode(&v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n"}})
+	for range ext.breaker.limit + 2 {
+		_, _, _, _ = ext.Filter(&v1.Pod{}, []fwk.NodeInfo{node})
+	}
+	if ext.breaker.skipping() {
+		t.Fatal("answers with an extender error opened the breaker")
+	}
+	for range ext.breaker.limit {
+		ext.breaker.allow()
+		ext.breaker.done(false)
+	}
+	before := calls.Load()
+	_ = ext.Bind(&v1.Binding{ObjectMeta: metav1.ObjectMeta{Name: "p", Namespace: "ns"}, Target: v1.ObjectReference{Name: "n"}})
+	if calls.Load() != before+1 {
+		t.Error("bind of a paused extender did not go out")
+	}
+}
