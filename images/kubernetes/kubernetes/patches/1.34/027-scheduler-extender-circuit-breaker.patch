+package scheduler
+
+// Deckhouse patch: a circuit breaker for ignorable extenders. A timed-out or failing ignorable
+// extender costs its whole timeout in every scheduling cycle and its scores are dropped anyway;
+// after a few failures in a row the scheduler stops calling it for a while and probes again.
+
+import (
+	"errors"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+
+	"k8s.io/klog/v2"
+
+	"k8s.io/kubernetes/pkg/scheduler/metrics"
+)
+
+const (
+	// defaultBreakerFailures: kube-scheduler calls an extender once per scheduling cycle, so a hung
+	// extender with a 100ms timeout fails about 10 calls a second and the breaker opens within a
+	// second. A healthy extender on a starved master times out 12..17% of calls, and a GC pause of
+	// the extender (up to 0.7s seen) fails up to 7 calls in a row: 10 in a row does not happen then.
+	defaultBreakerFailures = 10
+	defaultBreakerOpen     = 30 * time.Second
+	// The environment of kube-scheduler overrides the defaults; failures 0 turns the breaker off.
+	envBreakerFailures = "DECKHOUSE_EXTENDER_BREAKER_FAILURES"
+	envBreakerOpen     = "DECKHOUSE_EXTENDER_BREAKER_OPEN"
+)
+
+var errCircuitOpen = errors.New("extender skipped: circuit breaker open after consecutive failures")
+
+// circuitBreaker opens after limit failed requests in a row: requests are skipped for openFor,
+// then one probe goes through; its success closes the breaker, its failure opens it again.
+type circuitBreaker struct {
+	extender string // the name in metrics (deckhouse_extender_names.go)
+	limit    int
+	openFor  time.Duration
+	now      func() time.Time
+
+	mu        sync.Mutex
+	failures  int
+	openUntil time.Time
+	probing   bool
+}
+
+// newCircuitBreaker returns nil (no breaker) for a non-ignorable extender: skipping it would fail
+// the scheduling of pods instead of dropping its scores.
+func newCircuitBreaker(urlPrefix string, ignorable bool) *circuitBreaker {
+	limit, openFor := defaultBreakerFailures, defaultBreakerOpen
+	if s := os.Getenv(envBreakerFailures); s != "" {
+		if v, err := strconv.Atoi(s); err == nil {
+			limit = v
+		} else {
+			klog.InfoS("Ignoring an invalid extender breaker setting", "env", envBreakerFailures, "value", s)
+		}
+	}
+	if s := os.Getenv(envBreakerOpen); s != "" {
+		if v, err := time.ParseDuration(s); err == nil && v > 0 {
+			openFor = v
+		} else {
+			klog.InfoS("Ignoring an invalid extender breaker setting", "env", envBreakerOpen, "value", s)
+		}
+	}
+	if !ignorable || limit <= 0 {
+		return nil
+	}
+	b := &circuitBreaker{extender: deckhouseExtenderName(urlPrefix), limit: limit, openFor: openFor, now: time.Now}
+	b.setOpen(false) // a series from the start, so a healthy extender shows 0
+	return b
+}
+
+// setOpen publishes the state; tests may build extenders without registered metrics.
+func (b *circuitBreaker) setOpen(open bool) {
+	if metrics.ExtenderCircuitOpen == nil {
+		return
+	}
+	v := 0.0
+	if open {
+		v = 1
+		metrics.ExtenderCircuitOpenTotal.WithLabelValues(b.extender).Inc()
+	}
+	metrics.ExtenderCircuitOpen.WithLabelValues(b.extender).Set(v)
+}
+
+// allow reports whether a request may go out now.
+func (b *circuitBreaker) allow() bool {
+	if b == nil {
+		return true
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	switch {
+	case b.failures < b.limit:
+		return true
+	case b.now().Before(b.openUntil) || b.probing:
+		return false
+	default: // half-open: one probe at a time
+		b.probing = true
+		return true
+	}
+}
+
+// skipping reports whether the extender is skipped now: open, or its probe is in flight. It
+// takes no probe: for requests whose result must not count, such as simulations. After the open
+// period such a request goes out although no real request has probed yet.
+func (b *circuitBreaker) skipping() bool {
+	if b == nil {
+		return false
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.failures >= b.limit && (b.now().Before(b.openUntil) || b.probing)
+}
+
+// done records the result of a request that allow let through.
+func (b *circuitBreaker) done(ok bool) {
+	if b == nil {
+		return
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	wasOpen := b.failures >= b.limit
+	b.probing = false
+	if ok {
+		b.failures = 0
+		if wasOpen {
+			b.setOpen(false)
+			klog.InfoS("Extender circuit breaker closed", "extender", b.extender)
+		}
+		return
+	}
+	b.failures++
+	if b.failures >= b.limit {
+		b.openUntil = b.now().Add(b.openFor)
+		b.setOpen(true)
+		if !wasOpen {
+			klog.InfoS("Extender circuit breaker opened", "extender", b.extender, "failures", b.failures, "openFor", b.openFor)
+		}
+	}
+}
