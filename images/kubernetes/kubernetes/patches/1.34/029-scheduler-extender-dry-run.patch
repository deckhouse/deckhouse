+
+package scheduler
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/klog/v2/ktesting"
+	schedulerapi "k8s.io/kubernetes/pkg/scheduler/apis/config"
+	"k8s.io/kubernetes/pkg/scheduler/metrics"
+)
+
+// A simulation sends "dryRun": true in its filter and prioritize requests,
+// never calls preempt or bind, and no longer annotates the Pod copy. Real
+// requests carry no dryRun, also for a Pod with the former simulation
+// annotation: a user can set it on any Pod.
+func TestDeckhouseExtenderDryRun(t *testing.T) {
+	_, ctx := ktesting.NewTestContext(t)
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	metrics.Register()
+
+	var mu sync.Mutex
+	bodies := map[string][]map[string]json.RawMessage{}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, _ := io.ReadAll(r.Body)
+		var b map[string]json.RawMessage
+		_ = json.Unmarshal(raw, &b)
+		mu.Lock()
+		bodies[r.URL.Path] = append(bodies[r.URL.Path], b)
+		mu.Unlock()
+		if r.URL.Path == "/filter" {
+			_, _ = w.Write([]byte(`{"NodeNames":["1","2"]}`))
+			return
+		}
+		_, _ = w.Write([]byte(`[{"Host":"1","Score":1},{"Host":"2","Score":0}]`))
+	}))
+	defer srv.Close()
+	e, err := NewHTTPExtender(&schedulerapi.Extender{
+		URLPrefix: srv.URL, FilterVerb: "filter", PrioritizeVerb: "prioritize", PreemptVerb: "preempt", BindVerb: "bind",
+		Weight: 1, NodeCacheCapable: true,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sched := newSimulateTestScheduler(t, ctx, []string{"1", "2"})
+	sched.Extenders = append(sched.Extenders[:0:0], e)
+
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "vm", Namespace: "ns", UID: "u1"}}
+	if _, err := sched.Simulate(ctx, &SimulateRequest{Pod: pod}); err != nil {
+		t.Fatal(err)
+	}
+	deckhouseSimulatedPods.Lock()
+	marked := len(deckhouseSimulatedPods.m)
+	deckhouseSimulatedPods.Unlock()
+	if marked != 0 {
+		t.Errorf("%d Pod copies still marked after the simulation", marked)
+	}
+
+	annotated := pod.DeepCopy()
+	annotated.Annotations = map[string]string{"scheduler.deckhouse.io/simulation": "true"}
+	if deckhouseIsSimulation(annotated) {
+		t.Error("an annotated Pod counts as a simulation")
+	}
+	nodes, err := sched.nodeInfoSnapshot.NodeInfos().List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ext := e.(*HTTPExtender)
+	if _, _, _, err := ext.Filter(annotated, nodes); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := ext.Prioritize(annotated, nodes); err != nil {
+		t.Fatal(err)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	for _, verb := range []string{"/filter", "/prioritize"} {
+		got := bodies[verb]
+		if len(got) != 2 {
+			t.Fatalf("%s: %d requests, want 2 (simulation, real)", verb, len(got))
+		}
+		if string(got[0]["dryRun"]) != "true" {
+			t.Errorf("%s of the simulation: dryRun %q, want true", verb, got[0]["dryRun"])
+		}
+		if _, ok := got[1]["dryRun"]; ok {
+			t.Errorf("%s of a real cycle carries dryRun %s", verb, got[1]["dryRun"])
+		}
+		var copied v1.Pod
+		if err := json.Unmarshal(got[0]["Pod"], &copied); err != nil || copied.UID != "u1" || len(copied.Annotations) != 0 {
+			t.Errorf("%s of the simulation: Pod uid %q annotations %v (err %v), want u1 without annotations", verb, copied.UID, copied.Annotations, err)
+		}
+	}
+	if n := len(bodies["/preempt"]) + len(bodies["/bind"]); n != 0 {
+		t.Errorf("%d preempt or bind requests, want none", n)
+	}
+}
