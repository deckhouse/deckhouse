+
+package scheduler
+
+// Deckhouse: the filter and prioritize requests of a simulation
+// (deckhouse_simulate.go) carry "dryRun": true, so that an extender computes
+// its answer without side effects such as reservations. Real requests stay as
+// upstream sends them. A simulation never calls preempt or bind.
+//
+// The scheduler tells its own simulation by the identity of the Pod copy: an
+// annotation or a field of the Pod can be set by anyone who creates a Pod.
+
+import (
+	"sync"
+
+	v1 "k8s.io/api/core/v1"
+	extenderv1 "k8s.io/kube-scheduler/extender/v1"
+)
+
+// deckhouseSimulatedPods holds the Pod copies of the running simulations. A
+// plain map: deleting the key drops the reference to the copy at once.
+var deckhouseSimulatedPods = struct {
+	sync.Mutex
+	m map[*v1.Pod]struct{}
+}{m: map[*v1.Pod]struct{}{}}
+
+// deckhouseMarkSimulation marks the Pod copy of a simulation until the
+// returned function is called.
+func deckhouseMarkSimulation(pod *v1.Pod) (unmark func()) {
+	deckhouseSimulatedPods.Lock()
+	defer deckhouseSimulatedPods.Unlock()
+	deckhouseSimulatedPods.m[pod] = struct{}{}
+	return func() {
+		deckhouseSimulatedPods.Lock()
+		defer deckhouseSimulatedPods.Unlock()
+		delete(deckhouseSimulatedPods.m, pod)
+	}
+}
+
+// deckhouseIsMarked reports whether the Pod is the copy of a running simulation.
+func deckhouseIsMarked(pod *v1.Pod) bool {
+	deckhouseSimulatedPods.Lock()
+	defer deckhouseSimulatedPods.Unlock()
+	_, ok := deckhouseSimulatedPods.m[pod]
+	return ok
+}
+
+// filterBody returns the filter request: with dryRun in a simulation, the
+// upstream one otherwise.
+func filterBody(pod *v1.Pod, args *extenderv1.ExtenderArgs) any {
+	if deckhouseIsSimulation(pod) {
+		return &extenderArgs{ExtenderArgs: args, DryRun: true}
+	}
+	return args
+}
