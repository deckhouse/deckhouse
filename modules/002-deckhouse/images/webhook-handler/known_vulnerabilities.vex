    {
      "vulnerability": {
        "name": "CVE-2026-34040"
      },
      "products": [
        {
          "@id": "pkg:golang/github.com/docker/docker@v28.0.0+incompatible"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "В webhook-handler promtool вызывается валидатором CustomPrometheusRules командой promtool check rules для временного YAML-файла. Этот путь читает правила с диска и проверяет YAML, PromQL и синтаксис текстовых шаблонов; Docker Engine API и service discovery не используются.",
      "timestamp": "2026-10-12T15:10:20Z"
    },
