+
+	// SkipModeCleanup keeps the store when the registry starts in a different mode than the one
+	// that last wrote it.
+	//
+	// By default a transition between cache and non-cache modes deletes everything under /docker,
+	// so that data written as a proxy cache is never served as if it were local. That assumes one
+	// registry process owns the directory. Where two processes share it — one proxying and one
+	// accepting pushes, which is how Deckhouse serves and fills a single store — the non-proxying
+	// one sees the other's scheduler state as a mode change on every start and empties the store
+	// out from under a running cluster. Measured on a three-master cluster: twelve gigabytes and
+	// 3236 files gone two seconds after the push instance came up, twice, and once at the exact
+	// moment the upstream was dropped for an air-gap, leaving nothing to pull anywhere.
+	//
+	// Left false by default, so a registry that does own its directory behaves exactly as before.
+	SkipModeCleanup bool `yaml:"skipmodecleanup,omitempty"`
 }
 
