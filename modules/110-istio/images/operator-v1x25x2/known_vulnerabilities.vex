  "statements": [
    {
      "vulnerability": {
        "name": "CVE-2025-32386"
      },
      "products": [
        {
          "@id": "pkg:golang/helm.sh/helm/v3@v3.14.2"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "The component uses Helm only to render and deliver built-in Istio control-plane Kubernetes manifests. Charts/templates are compiled into the image at build time and cannot be replaced at runtime due to a read-only container filesystem, so Helm chart/archive/schema parsing CVEs are not exploitable here.",
      "timestamp": "2026-07-24T12:00:00.000000000Z"
    },
