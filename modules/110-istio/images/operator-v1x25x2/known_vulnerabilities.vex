        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "DoS via snappy payload on Prometheus remote-read /api/v1/read (CVE-2026-42154). This binary does not run the Prometheus server or handle that endpoint; the dependency is library-only.",
      "timestamp": "2026-07-24T12:00:00.000000000Z"
    },
