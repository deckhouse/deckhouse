+// newRemoteMeshCollection builds the mesh config of a remote cluster from its mesh ConfigMap.
+// Unlike meshwatcher.NewCollection, it has no value while the ConfigMap is missing or unreadable
+// (e.g. the remote cluster has no control plane of this revision), instead of the default mesh config.
+// This way the controller falls back to the config cluster's mesh config (ConfigClusterMeshWatcher)
+// and does not expect the default "cluster.local" trust domain from the remote workloads.
+func newRemoteMeshCollection(opts krt.OptionsBuilder, source meshwatcher.MeshConfigSource) krt.Singleton[meshwatcher.MeshConfigResource] {
+	meshCollection := meshwatcher.NewCollection(opts, source)
+	return krt.NewSingleton[meshwatcher.MeshConfigResource](
+		func(ctx krt.HandlerContext) *meshwatcher.MeshConfigResource {
+			if krt.FetchOne(ctx, source.AsCollection()) == nil {
+				return nil
+			}
+			return krt.FetchOne(ctx, meshCollection.AsCollection())
+		}, opts.WithName("RemoteMeshConfig")...,
+	)
+}
