+func TestDoesServiceSyncEndpointSliceDeckhouseMode(t *testing.T) {
+	withMode := func(mode string) *slim_corev1.Service {
+		svc := createService("svc")
+		svc.Annotations[annotation.DeckhouseGlobalServiceMode] = mode
+		return svc
+	}
+
+	// Only a service that takes the backends of the peers gets their EndpointSlices.
+	require.True(t, doesServiceSyncEndpointSlice(withMode(annotation.DeckhouseGlobalServiceModeImportOnly)))
+	require.True(t, doesServiceSyncEndpointSlice(withMode(annotation.DeckhouseGlobalServiceModeImportAndExport)))
+	require.False(t, doesServiceSyncEndpointSlice(withMode(annotation.DeckhouseGlobalServiceModeLocal)))
+	require.False(t, doesServiceSyncEndpointSlice(withMode("true")))
+
+	// The upstream annotation is replaced, not aliased.
+	svc := createService("svc")
+	delete(svc.Annotations, annotation.DeckhouseGlobalServiceMode)
+	svc.Annotations[annotation.GlobalService] = "true"
+	require.False(t, doesServiceSyncEndpointSlice(svc))
+}
