+// DeckhouseGlobalServiceModeOf returns the DeckhouseGlobalServiceMode of the object in its
+// canonical spelling: Local for a missing or unknown value.
+func DeckhouseGlobalServiceModeOf(obj metav1.Object) string {
+	value, _ := Get(obj, DeckhouseGlobalServiceMode)
+	switch {
+	case strings.EqualFold(value, DeckhouseGlobalServiceModeImportOnly):
+		return DeckhouseGlobalServiceModeImportOnly
+	case strings.EqualFold(value, DeckhouseGlobalServiceModeImportAndExport):
+		return DeckhouseGlobalServiceModeImportAndExport
+	}
+	return DeckhouseGlobalServiceModeLocal
+}
