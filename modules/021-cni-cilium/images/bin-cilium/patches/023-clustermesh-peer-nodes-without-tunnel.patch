+// With the host firewall on, ClusterMesh peer node addresses get no tunnel IP;
+// this cluster's nodes and every CiliumInternalIP keep it.
+func TestNodeAddressTunnelIPForPeerNodes(t *testing.T) {
+	setup(t)
+
+	for _, tc := range []struct {
+		name        string
+		encryptNode bool
+		joinCluster bool
+		cluster     string
+		addrType    addressing.AddressType
+		want        bool
+	}{
+		{name: "local node InternalIP", cluster: "c1", addrType: addressing.NodeInternalIP, want: true},
+		{name: "local node CiliumInternalIP", cluster: "c1", addrType: addressing.NodeCiliumInternalIP, want: true},
+		{name: "peer node InternalIP", cluster: "c2", addrType: addressing.NodeInternalIP, want: false},
+		{name: "peer node ExternalIP", cluster: "c2", addrType: addressing.NodeExternalIP, want: false},
+		{name: "peer node CiliumInternalIP", cluster: "c2", addrType: addressing.NodeCiliumInternalIP, want: true},
+		{name: "peer node InternalIP with node encryption", encryptNode: true, cluster: "c2", addrType: addressing.NodeInternalIP, want: true},
+		{name: "peer node InternalIP with join-cluster", joinCluster: true, cluster: "c2", addrType: addressing.NodeInternalIP, want: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			h, _ := cell.NewSimpleHealth()
+			mngr, err := New(&option.DaemonConfig{
+				ClusterName:        "c1",
+				EnableHostFirewall: true,
+				EncryptNode:        tc.encryptNode,
+				EnableIPSec:        tc.encryptNode,
+				JoinCluster:        tc.joinCluster,
+			}, newIPcacheMock(), newIPSetMock(), nil, NewNodeMetrics(), h)
+			require.NoError(t, err)
+			n := nodeTypes.Node{Name: "node1", Cluster: tc.cluster}
+			got := mngr.nodeAddressHasTunnelIP(&n, nodeTypes.Address{Type: tc.addrType, IP: net.ParseIP("10.0.0.2")})
+			require.Equal(t, tc.want, got)
+		})
+	}
+}
