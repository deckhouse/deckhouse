  "statements": [
    {
      "vulnerability": {
        "name": "GO-2026-5932"
      },
      "products": [
        {
          "@id": "pkg:golang/golang.org/x/crypto"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "GO-2026-5932 относится к пакету golang.org/x/crypto/openpgp. Пакет не поддерживается, исправленной версии нет. Бинарник registry-packages-proxy не импортирует golang.org/x/crypto/openpgp. Модуль golang.org/x/crypto попадает в сборку только через github.com/deckhouse/delivery-kit-sdk/pkg/signver. Этот пакет нужен для проверки подписи образов в github.com/deckhouse/deckhouse/go_lib/registry-packages-proxy/registry. Из golang.org/x/crypto в сборку входят только cryptobyte, cryptobyte/asn1, ed25519, nacl/secretbox, salsa20/salsa, pbkdf2, scrypt и внутренние internal/alias и internal/poly1305. go list -deps по пакету cmd/registry-packages-proxy не находит openpgp в графе импортов.",
      "timestamp": "2026-10-09T07:52:30.000000000Z"
    }
  ],
  "timestamp": "2026-10-09T07:52:30.000000000Z"
}
