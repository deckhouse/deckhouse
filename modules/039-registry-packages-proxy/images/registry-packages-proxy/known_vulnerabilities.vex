  "@context": "https://openvex.dev/ns/v0.2.0",
  "@id": "https://openvex.dev/docs/public/vex-fbc7d4b8d156d17ea631661252269956fb11696677287edfd22a9c76cb8f6122",
  "author": "Deckhouse <contact@deckhouse.io>",
  "version": 2,
  "statements": [
    {
      "vulnerability": {
        "name": "GO-2026-5932"
      },
      "products": [
        {
          "@id": "pkg:golang/golang.org/x/crypto"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "GO-2026-5932 относится к пакету golang.org/x/crypto/openpgp, который помечен как unmaintained. Бинарник registry-packages-proxy не импортирует golang.org/x/crypto/openpgp; модуль golang.org/x/crypto подтягивается транзитивно через github.com/deckhouse/deckhouse/go_lib/registry-packages-proxy/registry и github.com/deckhouse/delivery-kit-sdk/pkg/signver, где задействованы только подпакеты ed25519, cryptobyte, nacl/secretbox, salsa20/salsa, pbkdf2 и scrypt. Ни поиск по исходникам, ни go list -deps не находят openpgp в графе импортов. Исправленной версии пакета нет; уязвимый код в данном компоненте не выполняется.",
      "timestamp": "2026-08-27T13:00:19.000000000Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-85747",
        "aliases": [
          "GHSA-685w-q87j-wqw3"
        ]
      },
      "products": [
        {
          "@id": "pkg:golang/github.com/docker/distribution@v2.8.3+incompatible"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_present",
      "impact_statement": "CVE-2026-85747 относится к пакету github.com/docker/distribution/registry/client: функция (*manifests).Get не сверяет полученный манифест с запрошенным дайджестом, а прокси registry/proxy может раздавать подменённый манифест из кэша. В бинарнике registry-packages-proxy из модуля собран только пакет registry/client/auth/challenge: его импортирует github.com/google/go-containerregistry/pkg/v1/remote/transport, чтобы разобрать заголовок WWW-Authenticate. Модуль github.com/deckhouse/delivery-kit-sdk тоже требует docker/distribution в go.mod, но через него в сборку не попадает ни один пакет docker/distribution. Пакетов registry/client и registry/proxy в бинарнике нет, это показывает go list -deps. Исправление вышло только в модуле distribution/v3, для v2 исправленной версии нет.",
      "timestamp": "2026-11-06T15:24:04.000000000Z"
    }
  ],
  "timestamp": "2026-10-01T09:08:28.000000000Z",
  "last_updated": "2026-11-06T15:24:04Z"
}
