+
+// detachAddressFromInstances removes the one-to-one NAT that holds the given
+// address from every compute instance using it.
+//
+// The VPC API does not report which resource occupies an address, so instances
+// in the address folder are scanned for a matching NAT address.
+func detachAddressFromInstances(ctx context.Context, config *Config, d *schema.ResourceData) error {
+	address, err := config.sdk.VPC().Address().Get(ctx, &vpc.GetAddressRequest{AddressId: d.Id()})
 	if err != nil {
 		return err
 	}
 
-	_, err = op.Response()
+	value := address.GetExternalIpv4Address().GetAddress()
+	if value == "" {
+		return fmt.Errorf("address %q has no external IPv4 value to look up", d.Id())
+	}
+
+	folderID, err := getFolderID(d, config)
 	if err != nil {
 		return err
 	}
 
+	detached := false
+	pageToken := ""
+
+	for {
+		resp, err := config.sdk.Compute().Instance().List(ctx, &compute.ListInstancesRequest{
+			FolderId:  folderID,
+			PageSize:  defaultListSize,
+			PageToken: pageToken,
+		})
+		if err != nil {
+			return err
+		}
+
+		for _, instance := range resp.GetInstances() {
+			for _, iface := range instance.GetNetworkInterfaces() {
+				if iface.GetPrimaryV4Address().GetOneToOneNat().GetAddress() != value {
+					continue
+				}
+
+				op, err := config.sdk.WrapOperation(config.sdk.Compute().Instance().RemoveOneToOneNat(ctx,
+					&compute.RemoveInstanceOneToOneNatRequest{
+						InstanceId:            instance.GetId(),
+						NetworkInterfaceIndex: iface.GetIndex(),
+					}))
+				if err != nil {
+					return err
+				}
+
+				if err := op.Wait(ctx); err != nil {
+					return err
+				}
+
+				detached = true
+			}
+		}
+
+		pageToken = resp.GetNextPageToken()
+		if pageToken == "" {
+			break
+		}
+	}
+
+	if !detached {
+		return fmt.Errorf("address %q is reported as in use, but no instance in folder %q holds it", d.Id(), folderID)
+	}
+
 	return nil
 }
