 // log is for logging in this package.
 var log = logf.Log.WithName("yandexmachine-resource")
 
+// SupportedNetworkTypes lists the compute instance network types a YandexMachine may request.
+// HARDWARE_ACCELERATED is left out: the compute API reserves it for future use.
+var SupportedNetworkTypes = []string{"STANDARD", "SOFTWARE_ACCELERATED"}
+
+// validateNetworkType rejects a network type unknown to YandexCloud, so that a typo fails
+// at admission rather than at compute instance creation.
+func validateNetworkType(spec YandexMachineSpec, path *field.Path) field.ErrorList {
+	if spec.NetworkType == nil || slices.Contains(SupportedNetworkTypes, *spec.NetworkType) {
+		return nil
+	}
+	return field.ErrorList{field.NotSupported(path.Child("networkType"), *spec.NetworkType, SupportedNetworkTypes)}
+}
+
 // SetupWebhookWithManager creates an YandexMachine validation webhook.
