-	if len(intfList) != 1 {
-		return nil, fmt.Errorf("only one interface supported")
+	if len(intfList) == 0 {
+		return nil, fmt.Errorf("compute instance has no network interfaces")
+	}
+
+	primary := slices.IndexFunc(intfList, func(intf *yandex_compute.NetworkInterface) bool {
+		return intf.GetIndex() == "0"
