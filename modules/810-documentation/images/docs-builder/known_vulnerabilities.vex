{
  "@context": "https://openvex.dev/ns/v0.2.0",
  "@id": "urn:deckhouse:vex:3a4f910385960098934503700078170889218760057250688085605068848460",
  "author": "Deckhouse <contact@deckhouse.io>",
  "version": 5,
  "statements": [
    {
      "vulnerability": {
        "name": "CVE-2025-61726",
        "description": "Issues related to archive/zip processing"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.5"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Archive/zip processing - Функционал обработки и сжатия ZIP-архивов в стандартной библиотеке Go (stdlib) версии 1.25.5 не используется в рамках текущих функциональных спецификаций и эксплуатационных процессов системы. Приложение docs-builder не обращается к пакету archive/zip в процессе своего выполнения, что исключает возможность эксплуатации уязвимости.",
      "timestamp": "2026-02-03T10:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2025-61728",
        "description": "Potential memory overflow via malformed GET requests"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.5"
        }
      ],
      "status": "not_affected",
      "justification": "inline_mitigations_already_exist",
      "impact_statement": "Memory overflow via GET requests - Риск исчерпания памяти при обработке некорректных GET-запросов в библиотеке Go stdlib версии 1.25.5 нивелируется архитектурой среды исполнения. Сервис функционирует в контейнеризированной среде с жесткими лимитами ресурсов и автоматическим восстановлением (health recovery), что исключает возможность персистентного отказа в обслуживании, повреждения данных или эскалации привилегий.",
      "timestamp": "2026-02-03T10:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2025-61730",
        "description": "TLS information disclosure"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.5"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "TLS information disclosure - Эксплуатация уязвимости раскрытия информации в TLS-стеке библиотеки Go stdlib версии 1.25.5 требует специфических условий и высокой сложности атаки, которые отсутствуют в рамках текущей конфигурации развертывания. Вектор атаки признан непрактичным, так как уязвимый код эффективно изолирован от контроля со стороны злоумышленника.",
      "timestamp": "2026-02-03T10:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2025-68121",
        "description": "Improper Certificate Validation (CWE-295) in crypto/tls"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.5"
        }
      ],
      "status": "not_affected",
      "justification": "component_not_present",
      "impact_statement": "Improper Certificate Validation - Приложение docs-builder используется для генерации статического контента и не выполняет исходящих TLS-соединений к недоверенным внешним ресурсам в процессе сборки. Проверка сертификатов делегирована системным механизмам среды CI/CD, что исключает влияние данной уязвимости на безопасность артефакта.",
      "timestamp": "2026-02-09T16:00:00Z"
    },
    {
      "vulnerability": {
        "name": "GHSA-r46f-3rpw-hxrv",
        "description": "Hugo: security.http.urls deny rules bypassed by alternate IPv4 encodings (SSRF)"
      },
      "products": [
        {
          "@id": "pkg:golang/github.com/gohugoio/hugo@v0.162.1"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "SSRF via alternate IPv4 encodings - Обход политики security.http.urls в Hugo достижим только когда шаблон передаёт недоверенный или полученный из данных URL в функцию resources.GetRemote. Согласно самому advisory, уязвимость не затрагивает сайты, полностью доверяющие загружаемым URL. docs-builder рендерит документацию из локально загруженного доверенного контента и не использует resources.GetRemote для загрузки внешних ресурсов в процессе сборки. Уязвимый путь исполнения не задействован, поэтому SSRF для образа недостижим.",
      "timestamp": "2026-07-22T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-39822",
        "description": "os: Go os.Root symlink following vulnerability allows directory traversal (CWE-61)"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        },
        {
          "@id": "pkg:golang/stdlib@v1.26.4"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "os.Root symlink following - Уязвимость перехода по символическим ссылкам в os.Root (обход песочницы при финальном компоненте-симлинке и завершающем '/') требует использования приложением API os.Root/OpenRoot. docs-builder не использует os.Root: изоляция путей загрузки и удаления обеспечивается строгим allow-list имён модулей и каналов (регулярное выражение RFC 1123, запрещающее '/', '.' и '..') и проверкой ensureWithinBase (filepath.Rel относительно базового каталога). Уязвимый код os.Root не входит в путь исполнения, поэтому directory traversal для образа недостижим.",
      "timestamp": "2026-07-22T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "GHSA-c3wq-j5vh-68rc",
        "description": "Hugo: Symlink confinement bypass in os.ReadFile"
      },
      "products": [
        {
          "@id": "pkg:golang/github.com/gohugoio/hugo@v0.162.1"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "Symlink confinement bypass в os.ReadFile - Уязвимость связана с регрессией в виртуальной ФС Hugo: RootMappingFs.statRoot вызывает Stat (переход по символическим ссылкам) вместо Lstat, из-за чего прямой поиск (resources.Get / os.ReadFile) по симлинку, размещённому внутри смонтированного каталога, читает содержимое цели за пределами mount'а. Эксплуатация требует, чтобы атакующий смог подложить симлинк внутрь смонтированного каталога (например, локально вендоренной темы в themes/). В docs-builder этого пути нет: рендерится доверенная документация модулей, а не произвольный пользовательский ввод; локальные вендоренные темы с симлинками не используются, а темы, подключаемые как Go-модули, скачиваются со снятыми симлинками. Подконтрольный атакующему симлинк во входных данных отсутствует, поэтому чтение произвольных файлов для образа недостижимо.",
      "timestamp": "2026-08-24T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "GHSA-q76j-gcg9-vxc6",
        "description": "Hugo: XSS via unescaped code-fence language in default code block renderer"
      },
      "products": [
        {
          "@id": "pkg:golang/github.com/gohugoio/hugo@v0.162.1"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "XSS через неэкранированный language в code-fence - Штатный code-block renderer Hugo записывает info-string (язык) code-fence в атрибуты class/data-lang обёртки без HTML-экранирования, что позволяет вырваться из атрибута и внедрить <script>. Эксплуатация требует контроля над содержимым рендерируемого Markdown. В docs-builder весь рендерируемый контент доверенный: это документация модулей из исходников, а не произвольный пользовательский ввод. Подконтрольный атакующему info-string во входных данных отсутствует, поэтому XSS для образа недостижим.",
      "timestamp": "2026-08-24T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-27145",
        "description": "crypto/x509: Denial of Service via excessive processing of DNS SAN entries"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "crypto/x509 DoS через DNS SAN - Уязвимость проявляется при разборе сертификата с большим числом DNS SAN-записей. Единственное исходящее TLS-соединение docs-builder — к in-cluster Kubernetes API (rest.InClusterConfig, доверенный CA из service account); TLS-сервер не поднимается (net/http слушает по plain HTTP через ListenAndServe, без TLSConfig). Уязвимый код исполняется только при взаимодействии с доверенным пиром, которого атакующий не контролирует, поэтому вредоносный сертификат/TLS-поток во входные данные образа не попадает.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-32280",
        "description": "crypto/x509, crypto/tls: Denial of Service in certificate chain building"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "crypto/x509 DoS при построении цепочки сертификатов - Уязвимость проявляется при построении цепочки доверия для предъявленного пиром сертификата. Единственное исходящее TLS-соединение docs-builder — к in-cluster Kubernetes API (rest.InClusterConfig, доверенный CA из service account); TLS-сервер не поднимается (net/http слушает по plain HTTP через ListenAndServe, без TLSConfig). Уязвимый код исполняется только при взаимодействии с доверенным пиром, которого атакующий не контролирует, поэтому вредоносный сертификат/TLS-поток во входные данные образа не попадает.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-32281",
        "description": "crypto/x509: Denial of Service via inefficient certificate chain validation"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "crypto/x509 DoS при валидации цепочки - Уязвимость проявляется при валидации цепочки сертификатов, предъявленной TLS-пиром. Единственное исходящее TLS-соединение docs-builder — к in-cluster Kubernetes API (rest.InClusterConfig, доверенный CA из service account); TLS-сервер не поднимается (net/http слушает по plain HTTP через ListenAndServe, без TLSConfig). Уязвимый код исполняется только при взаимодействии с доверенным пиром, которого атакующий не контролирует, поэтому вредоносный сертификат/TLS-поток во входные данные образа не попадает.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-32283",
        "description": "crypto/tls: Denial of Service via multiple TLS 1.3 key update messages"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "crypto/tls DoS через key update в TLS 1.3 - Атака требует установленной TLS 1.3-сессии, в которой пир шлёт множественные key update. Единственное исходящее TLS-соединение docs-builder — к in-cluster Kubernetes API (rest.InClusterConfig, доверенный CA из service account); TLS-сервер не поднимается (net/http слушает по plain HTTP через ListenAndServe, без TLSConfig). Уязвимый код исполняется только при взаимодействии с доверенным пиром, которого атакующий не контролирует, поэтому вредоносный сертификат/TLS-поток во входные данные образа не попадает.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-56862",
        "description": "crypto/tls: Denial of Service via indefinite KeyUpdate messages"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "crypto/tls DoS через бесконечные KeyUpdate - Атака требует TLS-пира, непрерывно шлющего KeyUpdate. Единственное исходящее TLS-соединение docs-builder — к in-cluster Kubernetes API (rest.InClusterConfig, доверенный CA из service account); TLS-сервер не поднимается (net/http слушает по plain HTTP через ListenAndServe, без TLSConfig). Уязвимый код исполняется только при взаимодействии с доверенным пиром, которого атакующий не контролирует, поэтому вредоносный сертификат/TLS-поток во входные данные образа не попадает.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-33818",
        "description": "encoding/asn1: Denial of Service via excessive recursion in Unmarshal"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "encoding/asn1 DoS через рекурсию в Unmarshal - В docs-builder encoding/asn1 задействован только транзитивно, при разборе X.509-сертификатов в ходе TLS-рукопожатия. Приложение не выполняет разбор ASN.1 из произвольных данных. Единственное исходящее TLS-соединение docs-builder — к in-cluster Kubernetes API (rest.InClusterConfig, доверенный CA из service account); TLS-сервер не поднимается (net/http слушает по plain HTTP через ListenAndServe, без TLSConfig). Уязвимый код исполняется только при взаимодействии с доверенным пиром, которого атакующий не контролирует, поэтому вредоносный сертификат/TLS-поток во входные данные образа не попадает.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-42505",
        "description": "crypto/tls: Information disclosure in Encrypted Client Hello"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "crypto/tls раскрытие информации в ECH - Encrypted Client Hello в docs-builder не включается (конфигурация TLS по умолчанию, поле EncryptedClientHelloConfigList не задаётся). Единственное исходящее TLS-соединение docs-builder — к in-cluster Kubernetes API (rest.InClusterConfig, доверенный CA из service account); TLS-сервер не поднимается (net/http слушает по plain HTTP через ListenAndServe, без TLSConfig). Уязвимый код исполняется только при взаимодействии с доверенным пиром, которого атакующий не контролирует, поэтому вредоносный сертификат/TLS-поток во входные данные образа не попадает.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-56853",
        "description": "net/http: Unencrypted HTTP/2 (h2c) connections vulnerable to Denial of Service"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "net/http DoS незашифрованного HTTP/2 (h2c) - Уязвимость затрагивает обслуживание HTTP/2 поверх нешифрованного соединения (h2c). docs-builder поднимает обычный HTTP/1.1-сервер (net/http ListenAndServe без TLS и без явного h2c-обработчика golang.org/x/net/http2/h2c), поэтому h2c никогда не согласуется. Уязвимый путь исполнения не задействован.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-33814",
        "description": "net/http/internal/http2: Denial of Service via malformed SETTINGS_MAX_FRAME_SIZE frame"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
      "impact_statement": "HTTP/2 DoS через SETTINGS_MAX_FRAME_SIZE - Обработка HTTP/2-фреймов на стороне сервера не задействована: сервер работает по HTTP/1.1 без TLS, где HTTP/2 не согласуется. HTTP/2 используется только клиентом при обращении к доверенному in-cluster Kubernetes API, некорректный SETTINGS-фрейм от которого не контролируется атакующим.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-39820",
        "description": "net/mail: Denial of Service via crafted email inputs"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "component_not_present",
      "impact_statement": "net/mail DoS через email-входные данные - Пакет net/mail не входит в собранный бинарь docs-builder (проверено go list -deps: пакет отсутствует в графе зависимостей). Приложение не разбирает email-адреса.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-42499",
        "description": "net/mail: Denial of Service via pathological email address parsing"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "component_not_present",
      "impact_statement": "net/mail DoS через разбор email-адресов - Пакет net/mail не входит в собранный бинарь docs-builder (проверено go list -deps). Разбор email-адресов в приложении не выполняется.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-39836",
        "description": "net: Denial of Service via NUL byte in Dial and LookupPort on Windows"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "net DoS через NUL-байт (только Windows) - Уязвимый код специфичен для Windows. Образ docs-builder собирается и исполняется под Linux (CGO_ENABLED=0 GOOS=linux, база common/distroless), поэтому Windows-зависимая ветка Dial/LookupPort в путь исполнения не входит.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-32282",
        "description": "internal/syscall/unix: Root.Chmod can follow symlinks out of the root"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "os.Root.Chmod переход по симлинкам - Уязвимость требует использования приложением API os.Root/OpenRoot (метод Root.Chmod). docs-builder не использует os.Root: изоляция путей загрузки и удаления обеспечивается строгим allow-list имён модулей и каналов (регулярное выражение RFC 1123, запрещающее '/', '.' и '..') и проверкой ensureWithinBase (filepath.Rel относительно базового каталога). Уязвимый код os.Root не входит в путь исполнения.",
      "timestamp": "2026-08-25T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-56858",
        "description": "html/template: Cross-Site Scripting via pathological input"
      },
      "products": [
        {
          "@id": "pkg:golang/stdlib@v1.25.8"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_cannot_be_controlled_by_adversary",
