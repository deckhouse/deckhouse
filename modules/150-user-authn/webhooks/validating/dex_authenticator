source /shell_lib.sh

function is_ip_address() {
  local value="$1"

  # Use Python's stdlib to properly parse IPv4/IPv6 instead of maintaining complex regexes in bash.
  python3 - "$value" >/dev/null 2>&1 <<'PY'
import ipaddress
import sys

try:
    ipaddress.ip_address(sys.argv[1])
except ValueError:
    sys.exit(1)
PY
}

function __config__(){
  cat <<EOF
configVersion: v1
kubernetes:
  - name: dexauthenticators
    apiVersion: deckhouse.io/v1
    kind: DexAuthenticator
    queue: "dexauthenticators-list"
    group: main
    executeHookOnEvent: []
    executeHookOnSynchronization: false
    keepFullObjectsInMemory: false
    jqFilter: |
      .metadata.namespace as \$namespace |
      {
        "name": .metadata.name,
        "namespace": .metadata.namespace,
        "applicationDomain": .spec.applicationDomain,
        "ingressClass": .spec.applicationIngressClassName,
        "additionalDomains": [
          .spec.additionalApplications[]? | [.domain, .ingressClassName]
        ],
        "gatewayDomains": ([
          {
            "domain": .spec.applicationDomain,
            "listenerSetName": .spec.gatewayAPI.applicationHTTPRouteListenerSetName,
            "listenerSetNamespace": (.spec.gatewayAPI.applicationHTTPRouteListenerSetNamespace // \$namespace),
            "sectionName": (.spec.gatewayAPI.applicationHTTPRouteListenerSetSectionName // "")
          },
          (.spec.additionalApplications[]? | {
            "domain": .domain,
            "listenerSetName": .gatewayAPI.httpRouteListenerSetName,
            "listenerSetNamespace": (.gatewayAPI.httpRouteListenerSetNamespace // \$namespace),
            "sectionName": (.gatewayAPI.httpRouteListenerSetSectionName // "")
          })
        ] | map(select(.listenerSetName != null)))
      }
kubernetesValidating:
- name: dexauthenticators-unique.deckhouse.io
  group: main
  rules:
  - apiGroups:   ["deckhouse.io"]
    apiVersions: ["v1", "v1alpha1", "v2alpha1"]
    operations:  ["CREATE", "UPDATE"]
    resources:   ["dexauthenticators"]
    scope:       "Namespaced"
EOF
}

function __main__() {
  newAuthNamespace=$(context::jq -r '.review.request.object.metadata.namespace')
  newAuthName=$(context::jq -r '.review.request.object.metadata.name')
  apiVersion=$(context::jq -r '.review.request.object.apiVersion')
  

  # An object being deleted is only passing through: a finalizer set by something else turns the
  # deletion into updates, and refusing those would leave the object stuck forever.
  if [[ -n "$(context::jq -r '.review.request.object.metadata.deletionTimestamp // ""')" ]]; then
    jq -n '{allowed:true}' > "$VALIDATING_RESPONSE_PATH"
    return 0
  fi

  domains_to_check=()
  
  if [[ "$apiVersion" == "deckhouse.io/v2alpha1" ]]; then

    while IFS=$'\t' read -r domain ingressClass listenerSet fieldPath; do
      if [[ "$domain" != "null" && "$fieldPath" != "null" ]]; then
        domains_to_check+=("$domain"$'\t'"$ingressClass"$'\t'"$listenerSet"$'\t'"$fieldPath")
      fi
    done < <(context::jq -r '(.review.request.object.spec.applications // []) | to_entries[]? | "\(.value.domain)\t\(.value.ingressClassName)\t\(.value.gatewayAPI.httpRouteListenerSetName)\t.spec.applications[\(.key)].domain"')
  else

    main_domain=$(context::jq -r '.review.request.object.spec.applicationDomain')
    main_ingress_class=$(context::jq -r '.review.request.object.spec.applicationIngressClassName')
    main_listener_set=$(context::jq -r '.review.request.object.spec.gatewayAPI.applicationHTTPRouteListenerSetName')
    domains_to_check+=("$main_domain"$'\t'"$main_ingress_class"$'\t'"$main_listener_set"$'\t'".spec.applicationDomain")


    while IFS=$'\t' read -r domain ingressClass listenerSet fieldPath; do
      if [[ "$domain" != "null" && "$fieldPath" != "null" ]]; then
        domains_to_check+=("$domain"$'\t'"$ingressClass"$'\t'"$listenerSet"$'\t'"$fieldPath")
      fi
    done < <(context::jq -r '(.review.request.object.spec.additionalApplications // []) | to_entries[]? | "\(.value.domain)\t\(.value.ingressClassName)\t\(.value.gatewayAPI.httpRouteListenerSetName)\t.spec.additionalApplications[\(.key)].domain"')
  fi
  

  # What the object already published is not re-checked, for the same reason as the ListenerSet
  # check below: conflicting pairs could be created before these checks existed.
  old_ingress_claims=" $(context::jq -r '
    (.review.request.oldObject // empty) |
    [{domain: .spec.applicationDomain, class: .spec.applicationIngressClassName}]
      + [(.spec.applications // [])[] | {domain: .domain, class: .ingressClassName}]
      + [(.spec.additionalApplications // [])[] | {domain: .domain, class: .ingressClassName}] |
    map(select(.domain != null and .class != null)) |
    map("\(.domain),\(.class)")[]
  ' | tr "\n" " ")"

  # Applications after the first one take a resource-name suffix derived from sha256(domain), so
  # two of them sharing a domain would name two objects of one kind alike. The first application
  # carries no suffix, and an Ingress and an HTTPRoute may share a name, so the domains are
  # tracked per publication path rather than globally.
  seen_ingress_domains=" "
  seen_route_domains=" "

  for domain_pair in "${domains_to_check[@]}"; do
    IFS=$'\t' read -r domain ingressClass listenerSet fieldPath <<< "$domain_pair"

    if is_ip_address "$domain"; then
      msg="DexAuthenticator '$newAuthNamespace/$newAuthName' is invalid: '$fieldPath' must be a DNS name, not an IP address ('$domain')"
      jq -n --arg msg "$msg" '{allowed:false, message:$msg}' > "$VALIDATING_RESPONSE_PATH"
      return 0
    fi

    if [[ "$fieldPath" != ".spec.applicationDomain" && "$fieldPath" != ".spec.applications[0].domain" ]]; then
      duplicate_kind=""
      if [[ "$ingressClass" != "null" && "$seen_ingress_domains" == *" $domain "* ]]; then
        duplicate_kind="Ingress"
      elif [[ "$listenerSet" != "null" && "$seen_route_domains" == *" $domain "* ]]; then
        duplicate_kind="HTTPRoute"
      fi

      if [[ -n "$duplicate_kind" ]]; then
        msg="DexAuthenticator '$newAuthNamespace/$newAuthName' is invalid: '$fieldPath' repeats domain '$domain', so it would name a second $duplicate_kind after another additional application of this DexAuthenticator"
        jq -n --arg msg "$msg" '{allowed:false, message:$msg}' > "$VALIDATING_RESPONSE_PATH"
        return 0
      fi

      if [[ "$ingressClass" != "null" ]]; then
        seen_ingress_domains+="$domain "
      fi
      if [[ "$listenerSet" != "null" ]]; then
        seen_route_domains+="$domain "
      fi
    fi

    if [[ "$ingressClass" == "null" ]]; then
      continue
    fi

    if [[ "$old_ingress_claims" == *" $domain,$ingressClass "* ]]; then
      continue
    fi

    result=$(context::jq -r --arg domain "$domain" --arg class "$ingressClass" \
      --arg namespace "$newAuthNamespace" --arg name "$newAuthName" '
      .snapshots.dexauthenticators[].filterResult | 
      select(.namespace != $namespace or .name != $name) |
      select(
        .applicationDomain == $domain and .ingressClass == $class or
        (.additionalDomains | arrays | any(.[0] == $domain and .[1] == $class))
      )
    ')
    
    if [ "$result" ]; then
      existingAuth=$(echo "$result" | jq -r '.namespace + "/" + .name')
      

      msg="Desired DexAuthenticator '$newAuthNamespace/$newAuthName' conflicts with the existing DexAuthenticator '$existingAuth' for domain '$domain'"
      jq -n --arg msg "$msg" '{allowed:false, message:$msg}' > "$VALIDATING_RESPONSE_PATH"
      return 0
    fi
  done

  # Compare ListenerSet references and overlapping sections only. Detecting conflicts
  # across different ListenerSets attached to one Gateway requires Gateway topology.
  #
  # Only what the object did not already claim is checked. Pairs sharing a ListenerSet could be
  # created before this check existed, and refusing every edit to them would leave them stuck:
  # nothing about them could be fixed, including the conflict.
  if ! gatewayConflict=$(context::jq -r '
    def claims:
      .metadata.namespace as $namespace |
      (if .apiVersion == "deckhouse.io/v2alpha1" then
        .spec.applications
      else
        [{
          domain: .spec.applicationDomain,
          gatewayAPI: {
            httpRouteListenerSetName: .spec.gatewayAPI.applicationHTTPRouteListenerSetName,
            httpRouteListenerSetNamespace: .spec.gatewayAPI.applicationHTTPRouteListenerSetNamespace,
            httpRouteListenerSetSectionName: .spec.gatewayAPI.applicationHTTPRouteListenerSetSectionName
          }
        }] + (.spec.additionalApplications // [])
      end)[] |
      select(.gatewayAPI.httpRouteListenerSetName != null) |
      {
        domain: .domain,
        listenerSetName: .gatewayAPI.httpRouteListenerSetName,
        listenerSetNamespace: (.gatewayAPI.httpRouteListenerSetNamespace // $namespace),
        sectionName: (.gatewayAPI.httpRouteListenerSetSectionName // "")
      };

    . as $context |
    .review.request.object as $object |
    [$object | claims] as $claimed |
    [(.review.request.oldObject // empty) | claims] as $kept |
    [
      ($claimed - $kept)[] as $claim |
      $context.snapshots.dexauthenticators[].filterResult |
      select(.namespace != $object.metadata.namespace or .name != $object.metadata.name) |
      select(any(.gatewayDomains[]?;
        .domain == $claim.domain and
        .listenerSetName == $claim.listenerSetName and
        .listenerSetNamespace == $claim.listenerSetNamespace and
        (.sectionName == $claim.sectionName or .sectionName == "" or $claim.sectionName == "")
      )) |
      "Desired DexAuthenticator \u0027\($object.metadata.namespace)/\($object.metadata.name)\u0027 conflicts with the existing DexAuthenticator \u0027\(.namespace)/\(.name)\u0027 for domain \u0027\($claim.domain)\u0027 on ListenerSet \u0027\($claim.listenerSetNamespace)/\($claim.listenerSetName)\u0027"
    ] | first // empty
  '); then
    return 1
  fi

  if [[ -n "$gatewayConflict" ]]; then
    jq -n --arg msg "$gatewayConflict" '{allowed:false, message:$msg}' > "$VALIDATING_RESPONSE_PATH"
    return 0
  fi

  jq -n '{allowed:true}' > "$VALIDATING_RESPONSE_PATH"
}

hook::run "$@"
