+		{
+			name: "right secret, no header: the last hop of the chain", secret: secret, presented: []string{secret},
+			forwardedFor: []string{"203.0.113.9, 198.51.100.7"}, want: "198.51.100.7",
+		},
+		{
+			name: "right secret, chain over several header lines", secret: secret, presented: []string{secret},
+			forwardedFor: []string{"203.0.113.9", "198.51.100.7"}, want: "198.51.100.7",
+		},
+		{
+			name: "right secret, header not an address: the chain", secret: secret, presented: []string{secret},
+			realIP: "198.51.100.7, 203.0.113.9", forwardedFor: []string{"192.0.2.1, 198.51.100.8"}, want: "198.51.100.8",
+		},
+		{
+			name: "right secret, last hop not an address", secret: secret, presented: []string{secret},
+			realIP: "garbage", forwardedFor: []string{"198.51.100.7, garbage"}, want: "10.1.2.3",
+		},
+		{
+			name: "right secret, empty hops skipped", secret: secret, presented: []string{secret},
+			forwardedFor: []string{"198.51.100.7, ,"}, want: "198.51.100.7",
+		},
+		{name: "right secret, no address at all", secret: secret, presented: []string{secret}, want: "10.1.2.3"},
+		{
+			name: "wrong secret, chain ignored", secret: secret, presented: []string{"guess"},
+			forwardedFor: []string{"198.51.100.7"}, want: "10.1.2.3",
+		},
+		{
+			name: "only the first secret header counts", secret: secret, presented: []string{"guess", secret},
+			realIP: "198.51.100.7", want: "10.1.2.3",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			r := httptest.NewRequest(http.MethodGet, "/auth", nil)
+			r.RemoteAddr = peer
+			for _, v := range tc.presented {
+				r.Header.Add(TrustedProxyHeader, v)
+			}
+			if tc.realIP != "" {
+				r.Header.Set(header, tc.realIP)
+			}
+			for _, v := range tc.forwardedFor {
+				r.Header.Add("X-Forwarded-For", v)
+			}
+
+			got, err := ParseRealIPFromProxy(header, TrustedProxy{Secret: tc.secret})(r)
+			require.NoError(t, err)
+			require.Equal(t, tc.want, got)
+		})
+	}
+
+	r := httptest.NewRequest(http.MethodGet, "/auth", nil)
+	r.RemoteAddr = "no-port"
+	_, err := ParseRealIPFromProxy(header, TrustedProxy{Secret: secret})(r)
+	require.Error(t, err)
+}
