diff --git a/server/router/realip.go b/server/router/realip.go
index 80b80eb2..1a5d49cd 100644
--- a/server/router/realip.go
+++ b/server/router/realip.go
@@ -1,6 +1,8 @@
 package router
 
 import (
+	"crypto/subtle"
+	"crypto/x509"
 	"net"
 	"net/http"
 	"net/netip"
@@ -62,3 +64,101 @@ func ParseRealIP(header string, trusted []netip.Prefix) func(*http.Request) (str
 		return remoteAddr, nil
 	}
 }
+
+// TrustedProxyHeader carries the secret by which a proxy proves that it set the
+// client address headers of a request (ParseRealIPFromProxy). The router removes
+// it from every request before the handlers see it, so it is neither logged nor
+// passed on.
+const TrustedProxyHeader = "X-Deckhouse-Trusted-Proxy"
+
+// forwardedForHeader is the chain of addresses each proxy appends the address of
+// its own peer to.
+const forwardedForHeader = "X-Forwarded-For"
+
+// TrustedProxy tells the proxies that cannot be told by their address, such as
+// an ingress controller on the host network of any node (Deckhouse). A request
+// is from one when its TrustedProxyHeader equals Secret (compared in constant
+// time; an empty Secret trusts nothing), or when the client certificate of its
+// connection verifies against ClientCAs for client authentication and, with
+// Organization set, names it among its organizations. The certificate is not
+// required by the TLS handshake: a client without one, or with another one,
+// connects as before and is reported by its peer address.
+type TrustedProxy struct {
+	Secret       string
+	ClientCAs    *x509.CertPool
+	Organization string
+}
+
+// ParseRealIPFromProxy returns a resolver for the proxies trusted tells.
+//
+// For a request from a trusted proxy the client address is the named header
+// when it holds a single address, otherwise the last address of
+// X-Forwarded-For, which the proxy appended (a proxy that drops the client's
+// header and appends to the chain instead, as a Gateway does). Everything to
+// the left of it was sent by the client, so a last entry that is not an
+// address reports the peer address. Every other request is reported by its
+// peer address, whatever its headers say.
+func ParseRealIPFromProxy(header string, trusted TrustedProxy) func(*http.Request) (string, error) {
+	return func(r *http.Request) (string, error) {
+		remoteAddr, _, err := net.SplitHostPort(r.RemoteAddr)
+		if err != nil {
+			return "", err
+		}
+		if !fromTrustedProxy(r, trusted.Secret) && !trusted.certified(r) {
+			return remoteAddr, nil
+		}
+		if ip, err := netip.ParseAddr(strings.TrimSpace(r.Header.Get(header))); err == nil {
+			return ip.String(), nil
+		}
+		if ip, ok := lastForwardedFor(r); ok {
+			return ip.String(), nil
+		}
+		return remoteAddr, nil
+	}
+}
+
+func fromTrustedProxy(r *http.Request, secret string) bool {
+	presented := r.Header.Get(TrustedProxyHeader)
+	if secret == "" || presented == "" {
+		return false
+	}
+	return subtle.ConstantTimeCompare([]byte(presented), []byte(secret)) == 1
+}
+
+// certified reports whether the client certificate of the connection of r is one
+// of a trusted proxy: it verifies against ClientCAs for client authentication,
+// with the certificates the client sent after it as intermediates, and names
+// Organization when that is set.
+func (t TrustedProxy) certified(r *http.Request) bool {
+	if t.ClientCAs == nil || r.TLS == nil || len(r.TLS.PeerCertificates) == 0 {
+		return false
+	}
+	leaf := r.TLS.PeerCertificates[0]
+	intermediates := x509.NewCertPool()
+	for _, c := range r.TLS.PeerCertificates[1:] {
+		intermediates.AddCert(c)
+	}
+	if _, err := leaf.Verify(x509.VerifyOptions{
+		Roots:         t.ClientCAs,
+		Intermediates: intermediates,
+		KeyUsages:     []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth},
+	}); err != nil {
+		return false
+	}
+	return t.Organization == "" || slices.Contains(leaf.Subject.Organization, t.Organization)
+}
+
+// lastForwardedFor returns the last address of the X-Forwarded-For chain of r,
+// over all its header lines.
+func lastForwardedFor(r *http.Request) (netip.Addr, bool) {
+	hops := strings.Split(strings.Join(r.Header.Values(forwardedForHeader), ","), ",")
+	for _, hop := range slices.Backward(hops) {
+		hop = strings.TrimSpace(hop)
+		if hop == "" {
+			continue
+		}
+		ip, err := netip.ParseAddr(hop)
+		return ip, err == nil
+	}
+	return netip.Addr{}, false
+}
diff --git a/server/router/realip_cert_test.go b/server/router/realip_cert_test.go
new file mode 100644
index 00000000..1ed9bb50
--- /dev/null
+++ b/server/router/realip_cert_test.go
@@ -0,0 +1,161 @@
+package router
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"io"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// testCA is a certificate authority that signs client certificates in tests.
+type testCA struct {
+	cert *x509.Certificate
+	key  *ecdsa.PrivateKey
+}
+
+func newTestCA(t *testing.T, name string) testCA {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	tmpl := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: name},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		IsCA:                  true,
+		KeyUsage:              x509.KeyUsageCertSign,
+		BasicConstraintsValid: true,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	require.NoError(t, err)
+	cert, err := x509.ParseCertificate(der)
+	require.NoError(t, err)
+	return testCA{cert: cert, key: key}
+}
+
+func (ca testCA) pool() *x509.CertPool {
+	p := x509.NewCertPool()
+	p.AddCert(ca.cert)
+	return p
+}
+
+// issue signs a certificate for the organization with the extended key usage.
+func (ca testCA) issue(t *testing.T, organization string, usage x509.ExtKeyUsage) *x509.Certificate {
+	t.Helper()
+	cert, _ := ca.issueWithKey(t, organization, usage)
+	return cert
+}
+
+// issueWithKey is issue that also returns the private key of the certificate.
+func (ca testCA) issueWithKey(t *testing.T, organization string, usage x509.ExtKeyUsage) (*x509.Certificate, *ecdsa.PrivateKey) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(2),
+		Subject:      pkix.Name{CommonName: "nginx-ingress:main", Organization: []string{organization}},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{usage},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, ca.cert, &key.PublicKey, ca.key)
+	require.NoError(t, err)
+	cert, err := x509.ParseCertificate(der)
+	require.NoError(t, err)
+	return cert, key
+}
+
+// TestParseRealIPFromProxyClientCertificate: the client address header is
+// trusted from a connection whose client certificate the trusted CA signed for
+// client authentication and the pinned organization (Deckhouse), and from no
+// other connection, whatever certificate it presents.
+func TestParseRealIPFromProxyClientCertificate(t *testing.T) {
+	ingressCA := newTestCA(t, "kube-rbac-proxy-ca-key-pair")
+	otherCA := newTestCA(t, "another-ca")
+	trusted := TrustedProxy{ClientCAs: ingressCA.pool(), Organization: "ingress-nginx:auth"}
+
+	tests := []struct {
+		name  string
+		certs []*x509.Certificate
+		plain bool // no TLS at all
+		want  string
+	}{
+		{name: "ingress controller certificate", certs: []*x509.Certificate{ingressCA.issue(t, "ingress-nginx:auth", x509.ExtKeyUsageClientAuth)}, want: "203.0.113.7"},
+		{name: "no client certificate", want: "10.0.0.5"},
+		{name: "plain HTTP", plain: true, want: "10.0.0.5"},
+		{name: "certificate of another CA", certs: []*x509.Certificate{otherCA.issue(t, "ingress-nginx:auth", x509.ExtKeyUsageClientAuth)}, want: "10.0.0.5"},
+		{name: "another organization of the same CA", certs: []*x509.Certificate{ingressCA.issue(t, "prometheus:scraper", x509.ExtKeyUsageClientAuth)}, want: "10.0.0.5"},
+		{name: "server certificate of the same CA", certs: []*x509.Certificate{ingressCA.issue(t, "ingress-nginx:auth", x509.ExtKeyUsageServerAuth)}, want: "10.0.0.5"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			r := httptest.NewRequest("GET", "/", nil)
+			r.RemoteAddr = "10.0.0.5:4321"
+			r.Header.Set("X-Real-IP", "203.0.113.7")
+			if tc.plain {
+				r.TLS = nil
+			} else {
+				r.TLS = &tls.ConnectionState{PeerCertificates: tc.certs}
+			}
+			got, err := ParseRealIPFromProxy("X-Real-IP", trusted)(r)
+			require.NoError(t, err)
+			require.Equal(t, tc.want, got)
+		})
+	}
+
+	t.Run("secret still trusted next to the certificate", func(t *testing.T) {
+		r := httptest.NewRequest("GET", "/", nil)
+		r.RemoteAddr = "10.0.0.5:4321"
+		r.Header.Set("X-Real-IP", "203.0.113.7")
+		r.Header.Set(TrustedProxyHeader, "s3cret")
+		got, err := ParseRealIPFromProxy("X-Real-IP", TrustedProxy{Secret: "s3cret", ClientCAs: ingressCA.pool(), Organization: "ingress-nginx:auth"})(r)
+		require.NoError(t, err)
+		require.Equal(t, "203.0.113.7", got)
+	})
+}
+
+// TestParseRealIPFromProxyOverTLS: over a real TLS connection to a server that
+// asks for a client certificate without requiring one (Deckhouse), the
+// certificate of the ingress controller is seen and trusted, and a client
+// without one connects and is reported by its peer address.
+func TestParseRealIPFromProxyOverTLS(t *testing.T) {
+	ingressCA := newTestCA(t, "kube-rbac-proxy-ca-key-pair")
+	resolve := ParseRealIPFromProxy("X-Real-IP", TrustedProxy{ClientCAs: ingressCA.pool(), Organization: "ingress-nginx:auth"})
+	srv := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ip, err := resolve(r)
+		require.NoError(t, err)
+		_, _ = io.WriteString(w, ip)
+	}))
+	srv.TLS = &tls.Config{ClientAuth: tls.RequestClientCert}
+	srv.StartTLS()
+	defer srv.Close()
+
+	get := func(certs []tls.Certificate) string {
+		transport := srv.Client().Transport.(*http.Transport).Clone()
+		transport.TLSClientConfig.Certificates = certs
+		req, err := http.NewRequest("GET", srv.URL, nil)
+		require.NoError(t, err)
+		req.Header.Set("X-Real-IP", "203.0.113.7")
+		resp, err := (&http.Client{Transport: transport}).Do(req)
+		require.NoError(t, err)
+		defer resp.Body.Close()
+		body, err := io.ReadAll(resp.Body)
+		require.NoError(t, err)
+		return string(body)
+	}
+
+	cert, key := ingressCA.issueWithKey(t, "ingress-nginx:auth", x509.ExtKeyUsageClientAuth)
+	require.Equal(t, "203.0.113.7", get([]tls.Certificate{{Certificate: [][]byte{cert.Raw}, PrivateKey: key, Leaf: cert}}))
+	require.Equal(t, "127.0.0.1", get(nil), "a client without a certificate connects and is its peer address")
+}
