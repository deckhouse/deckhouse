+package main
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestClientRemoteIPTrustedProxySecret(t *testing.T) {
+	var c Web
+	require.NoError(t, json.Unmarshal([]byte(`{"clientRemoteIP": {"header": "X-Real-IP", "trustedProxySecret": "s3cret"}}`), &c))
+	assert.Equal(t, ClientRemoteIP{Header: "X-Real-IP", TrustedProxySecret: "s3cret"}, c.ClientRemoteIP)
+}
+
+func TestClientRemoteIPTrustWarning(t *testing.T) {
+	tests := []struct {
+		name    string
+		config  ClientRemoteIP
+		warning string
+	}{
+		{name: "nothing set"},
+		{name: "trusted proxies", config: ClientRemoteIP{Header: "X-Forwarded-For", TrustedProxies: []string{"10.0.0.0/8"}}},
+		{name: "trusted proxy secret", config: ClientRemoteIP{Header: "X-Real-IP", TrustedProxySecret: "s3cret"}},
+		{name: "trusted proxy CA", config: ClientRemoteIP{Header: "X-Real-IP", TrustedProxyCAFile: "/ca.crt", TrustedProxyCertOrganization: "ingress-nginx:auth"}},
+		{
+			name:    "trusted proxy CA without an organization",
+			config:  ClientRemoteIP{Header: "X-Real-IP", TrustedProxyCAFile: "/ca.crt"},
+			warning: "trusts every client certificate the CA signed",
+		},
+		{
+			name:    "header alone",
+			config:  ClientRemoteIP{Header: "X-Real-IP"},
+			warning: "the header is ignored because any client could spoof it",
+		},
+		{
+			name:    "secret and trusted proxies",
+			config:  ClientRemoteIP{Header: "X-Real-IP", TrustedProxies: []string{"10.0.0.0/8"}, TrustedProxySecret: "s3cret"},
+			warning: "trustedProxySecret and trustedProxyCAFile are ignored",
+		},
+		{
+			name:    "secret without a header",
+			config:  ClientRemoteIP{TrustedProxySecret: "s3cret"},
+			warning: "trustedProxySecret and trustedProxyCAFile have no effect",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			warning := tc.config.trustWarning()
+			if tc.warning == "" {
+				assert.Empty(t, warning)
+				return
+			}
+			assert.Contains(t, warning, tc.warning)
+			assert.NotContains(t, warning, "s3cret", "the secret is never logged")
+		})
+	}
+}
+
+// TestClientRemoteIPTrustedProxyClientCAs reads the CA file of the trusted
+// proxies (Deckhouse): none without the setting, an error for a file that is
+// missing or holds no certificate.
+func TestClientRemoteIPTrustedProxyClientCAs(t *testing.T) {
+	pool, err := (&ClientRemoteIP{}).TrustedProxyClientCAs()
+	require.NoError(t, err)
+	assert.Nil(t, pool)
+
+	dir := t.TempDir()
+	_, err = (&ClientRemoteIP{TrustedProxyCAFile: filepath.Join(dir, "missing.crt")}).TrustedProxyClientCAs()
+	require.Error(t, err)
+
+	empty := filepath.Join(dir, "empty.crt")
+	require.NoError(t, os.WriteFile(empty, []byte("not a certificate"), 0o600))
+	_, err = (&ClientRemoteIP{TrustedProxyCAFile: empty}).TrustedProxyClientCAs()
+	require.Error(t, err)
+}
