+package router
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gorilla/mux"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/reqctx"
+)
+
+// The secret of the trusted proxy decides the client address and goes no
+// further: no handler sees it, so none can log or pass it on.
+func TestMuxRemovesTrustedProxySecret(t *testing.T) {
+	const secret = "pr0xy-s3cret"
+	m := New(Config{
+		Router:       mux.NewRouter(),
+		RealIPHeader: "X-Real-IP",
+		RealIP:       ParseRealIPFromProxy("X-Real-IP", TrustedProxy{Secret: secret}),
+		Instrument:   func(_ string, h http.Handler) http.HandlerFunc { return h.ServeHTTP },
+	})
+	var presented, clientAddr string
+	m.HandleFunc("/token", func(w http.ResponseWriter, r *http.Request) {
+		presented = r.Header.Get(TrustedProxyHeader)
+		clientAddr, _ = r.Context().Value(reqctx.RequestKeyRemoteIP).(string)
+	})
+
+	r := httptest.NewRequest(http.MethodPost, "/token", nil)
+	r.RemoteAddr = "10.1.2.3:1234"
+	r.Header.Set(TrustedProxyHeader, secret)
+	r.Header.Set("X-Real-IP", "198.51.100.7")
+	m.(mountMux).c.Router.ServeHTTP(httptest.NewRecorder(), r)
+
+	require.Equal(t, "198.51.100.7", clientAddr)
+	require.Empty(t, presented)
+}
