+// realIPResolver resolves the client address of a request: from the header of
+// a proxy listed in TrustedRealIPCIDRs, as upstream does, or, with none listed,
+// of a proxy that presents TrustedProxySecret or a client certificate that
+// TrustedProxyClientCAs verify. Without any, every request is reported by its
+// peer address.
+func realIPResolver(c Config) func(*http.Request) (string, error) {
+	if len(c.TrustedRealIPCIDRs) == 0 && (c.TrustedProxySecret != "" || c.TrustedProxyClientCAs != nil) {
+		return router.ParseRealIPFromProxy(c.RealIPHeader, router.TrustedProxy{
+			Secret:       c.TrustedProxySecret,
+			ClientCAs:    c.TrustedProxyClientCAs,
+			Organization: c.TrustedProxyCertOrganization,
+		})
+	}
+	return router.ParseRealIP(c.RealIPHeader, c.TrustedRealIPCIDRs)
+}
