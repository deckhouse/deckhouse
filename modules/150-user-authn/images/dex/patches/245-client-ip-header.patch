+// TestRateLimitTrustedProxySecret checks that the limiter counts the client
+// address a proxy that presents the secret names, and a direct caller by its
+// peer address, whatever it writes into the header: it can neither pick a
+// bucket of its own nor use up the bucket of another client.
+func TestRateLimitTrustedProxySecret(t *testing.T) {
+	const secret = "pr0xy-s3cret"
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.RateLimit = rateLimitTestConfig
+		c.RealIPHeader = "X-Real-IP"
+		c.TrustedProxySecret = secret
+	})
+	defer httpServer.Close()
+
+	viaProxy := func(clientAddr, presented string) *http.Request {
+		r := badClientTokenRequest(clientAddr)
+		r.Header.Set(router.TrustedProxyHeader, presented)
+		return r
+	}
+
+	for range 2 {
+		require.Equal(t, http.StatusUnauthorized, serveRequest(s, badClientTokenRequest("198.51.100.1")).Code)
+	}
+	assert.Equal(t, http.StatusTooManyRequests, serveRequest(s, badClientTokenRequest("198.51.100.2")).Code,
+		"without the secret the header is ignored: one bucket for the peer")
+	assert.Equal(t, http.StatusTooManyRequests, serveRequest(s, viaProxy("198.51.100.3", "guess")).Code,
+		"a wrong secret is no secret")
+
+	for range 2 {
+		require.Equal(t, http.StatusUnauthorized, serveRequest(s, viaProxy("198.51.100.1", secret)).Code,
+			"the direct calls did not use up the bucket of the client they named")
+	}
+	assert.Equal(t, http.StatusTooManyRequests, serveRequest(s, viaProxy("198.51.100.1", secret)).Code)
+	assert.Equal(t, http.StatusUnauthorized, serveRequest(s, viaProxy("198.51.100.2", secret)).Code,
+		"another client behind the proxy has a bucket of its own")
+}
