+func TestApplyClientAccessFilters(t *testing.T) {
+	tests := []struct {
+		name           string
+		client         storage.Client
+		claims         storage.Claims
+		expectedGroups []string
+		expectedErr    bool
+	}{
+		{
+			name:           "no allowlists keeps groups",
+			claims:         storage.Claims{Email: "jane@example.com", Groups: []string{"d8-users", "d8-users-test"}},
+			expectedGroups: []string{"d8-users", "d8-users-test"},
+		},
+		{
+			name:           "email allow-list accepts matching address",
+			client:         storage.Client{AllowedEmails: []string{"jane@example.com"}},
+			claims:         storage.Claims{Email: "jane@example.com", Groups: []string{"d8-users"}},
+			expectedGroups: []string{"d8-users"},
+		},
+		{
+			name:        "email allow-list rejects other address",
+			client:      storage.Client{AllowedEmails: []string{"jane@example.com"}},
+			claims:      storage.Claims{Email: "john@example.com"},
+			expectedErr: true,
+		},
+		{
+			name:           "group allow-list keeps intersection and drops the rest",
+			client:         storage.Client{AllowedGroups: []string{"d8-users"}},
+			claims:         storage.Claims{Email: "both@example.com", Groups: []string{"d8-users", "d8-users-test"}},
+			expectedGroups: []string{"d8-users"},
+		},
+		{
+			name:        "group allow-list rejects empty intersection",
+			client:      storage.Client{AllowedGroups: []string{"d8-users-test"}},
+			claims:      storage.Claims{Email: "jane@example.com", Groups: []string{"d8-users"}},
+			expectedErr: true,
+		},
+		{
+			name:        "group allow-list rejects user with no groups",
+			client:      storage.Client{AllowedGroups: []string{"d8-users"}},
+			claims:      storage.Claims{Email: "jane@example.com"},
+			expectedErr: true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			claims := tc.claims
+			err := applyClientAccessFilters(tc.client, &claims)
+			if tc.expectedErr {
+				require.Error(t, err)
+				var nae *NotAllowedError
+				require.ErrorAs(t, err, &nae)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tc.expectedGroups, claims.Groups)
+		})
+	}
+}
