+// groupsRefreshConnector returns a fixed email and group set from Refresh,
+// so tests can simulate an upstream directory change without LDAP.
+type groupsRefreshConnector struct {
+	email  string
+	groups []string
+}
+
+func (c groupsRefreshConnector) Refresh(_ context.Context, _ connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	ident.Email = c.email
+	ident.Groups = append([]string(nil), c.groups...)
+	return ident, nil
+}
