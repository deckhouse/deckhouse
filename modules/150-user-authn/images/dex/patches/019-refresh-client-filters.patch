+func TestHandlePasswordLoginClientFilters(t *testing.T) {
+	ctx := t.Context()
+	hash, err := bcrypt.GenerateFromPassword([]byte("correct-password"), bcrypt.DefaultCost)
+	require.NoError(t, err)
+
+	tests := []struct {
+		name          string
+		allowedGroups []string
+		userGroups    []string
+		expectedCode  int
+	}{
+		{
+			name:          "login allowed when user is in allowedGroups",
+			allowedGroups: []string{"d8-users"},
+			userGroups:    []string{"d8-users"},
+			expectedCode:  http.StatusSeeOther,
+		},
+		{
+			name:          "login denied when user is only in another group",
+			allowedGroups: []string{"d8-users"},
+			userGroups:    []string{"d8-users-test"},
+			expectedCode:  http.StatusUnauthorized,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, s := newTestServer(t, func(c *Config) {
+				c.SkipApprovalScreen = false
+				c.Now = time.Now
+			})
+			defer httpServer.Close()
+
+			sc := storage.Connector{
+				ID:              "local",
+				Type:            "local",
+				Name:            "Local",
+				ResourceVersion: "1",
+			}
+			require.NoError(t, s.storage.CreateConnector(ctx, sc))
+			if _, err := s.OpenConnector(sc); err != nil {
+				t.Fatalf("open connector: %v", err)
+			}
+			require.NoError(t, s.storage.CreateClient(ctx, storage.Client{
+				ID:            "client_1",
+				Secret:        "secret",
+				RedirectURIs:  []string{"cb"},
+				Name:          "test",
+				AllowedGroups: tc.allowedGroups,
+			}))
+			require.NoError(t, s.storage.CreateAuthRequest(ctx, storage.AuthRequest{
+				ID:                  "test",
+				ClientID:            "client_1",
+				ConnectorID:         "local",
+				RedirectURI:         "cb",
+				Expiry:              time.Now().Add(100 * time.Second),
+				ResponseTypes:       []string{responseTypeCode},
+				ForceApprovalPrompt: true,
+			}))
+			require.NoError(t, s.storage.CreatePassword(ctx, storage.Password{
+				Email:    "jane@example.com",
+				Username: "jane",
+				UserID:   "jane-id",
+				Hash:     hash,
+				Groups:   tc.userGroups,
+			}))
+
+			rr := httptest.NewRecorder()
+			path := "/auth/local/login?state=test&back=&login=jane@example.com&password=correct-password"
+			s.handlePasswordLogin(rr, httptest.NewRequest("POST", path, nil))
+			require.Equal(t, tc.expectedCode, rr.Code)
+		})
+	}
+}
