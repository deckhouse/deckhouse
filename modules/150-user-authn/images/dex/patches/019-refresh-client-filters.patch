+func TestHandleRefreshTokenClientFilters(t *testing.T) {
+	now := time.Now()
+	accessDeniedBody := `{"error":"access_denied","error_description":"User is not allowed."}`
+
+	tests := []struct {
+		name           string
+		allowedEmails  []string
+		allowedGroups  []string
+		storedGroups   []string
+		storedEmail    string
+		policy         *RefreshTokenPolicy
+		refreshGroups  []string
+		refreshEmail   string
+		expectedStatus int
+		expectedBody   string
+	}{
+		{
+			name:           "refresh allowed when stored groups still match allowedGroups",
+			allowedGroups:  []string{"d8-users"},
+			storedGroups:   []string{"d8-users"},
+			storedEmail:    "jane@example.com",
+			policy:         &RefreshTokenPolicy{rotateRefreshTokens: false, reuseInterval: time.Hour, now: func() time.Time { return now }},
+			expectedStatus: http.StatusOK,
+		},
+		{
+			name:           "refresh denied after allowedGroups no longer contains stored group",
+			allowedGroups:  []string{"d8-users-test"},
+			storedGroups:   []string{"d8-users"},
+			storedEmail:    "jane@example.com",
+			policy:         &RefreshTokenPolicy{rotateRefreshTokens: false, reuseInterval: time.Hour, now: func() time.Time { return now }},
+			expectedStatus: http.StatusUnauthorized,
+			expectedBody:   accessDeniedBody,
+		},
+		{
+			name:           "refresh denied after allowedEmails no longer contains stored email",
+			allowedEmails:  []string{"other@example.com"},
+			storedGroups:   []string{"d8-users"},
+			storedEmail:    "jane@example.com",
+			policy:         &RefreshTokenPolicy{rotateRefreshTokens: false, reuseInterval: time.Hour, now: func() time.Time { return now }},
+			expectedStatus: http.StatusUnauthorized,
+			expectedBody:   accessDeniedBody,
+		},
+		{
+			name:           "refresh denied when upstream refresh returns groups outside allowedGroups",
+			allowedGroups:  []string{"d8-users"},
+			storedGroups:   []string{"d8-users"},
+			storedEmail:    "jane@example.com",
+			policy:         &RefreshTokenPolicy{rotateRefreshTokens: true, now: func() time.Time { return now }},
+			refreshGroups:  []string{"d8-users-test"},
+			refreshEmail:   "jane@example.com",
+			expectedStatus: http.StatusUnauthorized,
+			expectedBody:   accessDeniedBody,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, s := newTestServer(t, func(c *Config) {
+				c.RefreshTokenPolicy = tc.policy
+				c.Now = func() time.Time { return now }
+			})
+			defer httpServer.Close()
+
+			createRefreshFilterFixtures(t, s.storage, tc.storedEmail, tc.storedGroups, tc.allowedEmails, tc.allowedGroups)
+
+			if tc.refreshGroups != nil {
+				s.mu.Lock()
+				orig := s.connectors["test"]
+				s.connectors["test"] = Connector{
+					ResourceVersion: orig.ResourceVersion,
+					Connector: groupsRefreshConnector{
+						email:  tc.refreshEmail,
+						groups: tc.refreshGroups,
+					},
+				}
+				s.mu.Unlock()
+			}
+
+			tokenData, err := internal.Marshal(&internal.RefreshToken{RefreshId: "test", Token: "bar"})
+			require.NoError(t, err)
+
+			u, err := url.Parse(s.issuerURL.String())
+			require.NoError(t, err)
+			u.Path = path.Join(u.Path, "/token")
+
+			form := url.Values{}
+			form.Set("grant_type", "refresh_token")
+			form.Set("refresh_token", tokenData)
+
+			req, err := http.NewRequest(http.MethodPost, u.String(), bytes.NewBufferString(form.Encode()))
+			require.NoError(t, err)
+			req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+			req.SetBasicAuth("test", "barfoo")
+
+			rr := httptest.NewRecorder()
+			s.ServeHTTP(rr, req)
+			require.Equal(t, tc.expectedStatus, rr.Code)
+			if tc.expectedBody != "" {
+				require.JSONEq(t, tc.expectedBody, rr.Body.String())
+			}
+			if tc.expectedStatus == http.StatusOK {
+				var ref struct {
+					Error string `json:"error"`
+				}
+				require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &ref))
+				require.Empty(t, ref.Error)
+				_, err := s.storage.GetRefresh(t.Context(), "test")
+				require.NoError(t, err)
+				return
+			}
+			_, err = s.storage.GetRefresh(t.Context(), "test")
+			require.ErrorIs(t, err, storage.ErrNotFound)
+		})
+	}
+}
