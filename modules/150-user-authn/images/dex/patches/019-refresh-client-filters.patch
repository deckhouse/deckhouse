+func TestHandlePasswordGrantClientFilters(t *testing.T) {
+	tests := []struct {
+		name          string
+		allowedEmails []string
+		allowedGroups []string
+		expectedCode  int
+	}{
+		{
+			name:         "password grant allowed when no allow-list",
+			expectedCode: http.StatusOK,
+		},
+		{
+			name:          "password grant denied when email is not listed",
+			allowedEmails: []string{"other@example.com"},
+			expectedCode:  http.StatusUnauthorized,
+		},
+		{
+			name:          "password grant denied when groups do not intersect",
+			allowedGroups: []string{"d8-users"},
+			expectedCode:  http.StatusUnauthorized,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, s := newTestServer(t, func(c *Config) {
+				c.PasswordConnector = "test"
+				c.Now = time.Now
+			})
+			defer httpServer.Close()
+			mockConnectorDataTestStorage(t, s.storage)
+			require.NoError(t, s.storage.UpdateClient(t.Context(), "test", func(old storage.Client) (storage.Client, error) {
+				old.AllowedEmails = tc.allowedEmails
+				old.AllowedGroups = tc.allowedGroups
+				return old, nil
+			}))
+
+			u, err := url.Parse(s.issuerURL.String())
+			require.NoError(t, err)
+			u.Path = path.Join(u.Path, "/token")
+			v := url.Values{}
+			v.Set("scope", "openid email")
+			v.Set("grant_type", "password")
+			v.Set("username", "test")
+			v.Set("password", "test")
+			req, err := http.NewRequest(http.MethodPost, u.String(), bytes.NewBufferString(v.Encode()))
+			require.NoError(t, err)
+			req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+			req.SetBasicAuth("test", "barfoo")
+
+			rr := httptest.NewRecorder()
+			s.ServeHTTP(rr, req)
+			require.Equal(t, tc.expectedCode, rr.Code, rr.Body.String())
+			if tc.expectedCode == http.StatusUnauthorized {
+				require.Contains(t, rr.Body.String(), "access_denied")
+			}
+		})
+	}
+}
