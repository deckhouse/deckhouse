+func TestListConnectorsCancelsHTTPRequest(t *testing.T) {
+	started := make(chan struct{})
+	finished := make(chan struct{})
+	api := httptest.NewServer(http.HandlerFunc(func(_ http.ResponseWriter, req *http.Request) {
+		close(started)
+		<-req.Context().Done()
+		close(finished)
+	}))
+	defer api.Close()
+	cli := &client{
+		client:     api.Client(),
+		baseURL:    api.URL,
+		namespace:  "dex",
+		apiVersion: "dex.coreos.com/v1",
+	}
+	cli.client.Timeout = 15 * time.Second
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, err := cli.ListConnectors(ctx)
+		done <- err
+	}()
+	select {
+	case <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("the request did not reach the test API")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		require.ErrorIs(t, err, context.Canceled)
+	case <-time.After(5 * time.Second):
+		t.Fatal("ListConnectors did not stop after cancellation")
+	}
+	select {
+	case <-finished:
+	case <-time.After(5 * time.Second):
+		t.Fatal("the HTTP handler did not observe cancellation")
+	}
+}
