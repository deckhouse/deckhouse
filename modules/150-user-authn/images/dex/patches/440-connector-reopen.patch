+// RetryFailed opens again, every interval until ctx ends, the connectors whose
+// last opening attempt failed (Deckhouse). Without it a connector is opened
+// again only when a request uses it, on the pod that serves the request, so
+// the other pods report the failure until they serve such a request or
+// restart. It reuses Get: an attempt is shared with the requests that wait for
+// the same version, and a changed version is opened as it is now stored.
+func (c *Cache) RetryFailed(ctx context.Context, interval time.Duration, logger *slog.Logger) {
+	// A pass can take a while (an OIDC issuer that does not answer holds an
+	// attempt for its discoveryTimeout), so the next one waits a full interval
+	// after it.
+	timer := time.NewTimer(interval)
+	defer timer.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-timer.C:
+		}
+		c.retryFailed(ctx, logger)
+		timer.Reset(interval)
+	}
+}
+
+func (c *Cache) retryFailed(ctx context.Context, logger *slog.Logger) {
+	c.mu.Lock()
+	failed := maps.Clone(c.failed)
+	c.mu.Unlock()
+
+	for _, id := range slices.Sorted(maps.Keys(failed)) {
+		if ctx.Err() != nil {
+			return
+		}
+		conn, err := c.Get(ctx, id)
+		switch {
+		case err == nil:
+			// Get opened the stored version or found it opened by a request. A
+			// failure of an earlier version stays recorded when a newer one
+			// opens; it says nothing any more.
+			c.forgetFailure(id, failed[id])
+			logger.InfoContext(ctx, "opened connector after a failed attempt", "connector_id", id, "connector_type", conn.Type)
+		case errors.Is(err, storage.ErrNotFound):
+			// The connector is gone from storage: nothing to open, and nothing
+			// to report.
+			c.Close(id)
+		default:
+			// The startup or the request that failed first has logged the reason.
+			logger.DebugContext(ctx, "connector still fails to open", "connector_id", id, "err", err)
+		}
+	}
+}
+
+// forgetFailure drops the failure of version, unless a later attempt has
+// recorded another one meanwhile.
+func (c *Cache) forgetFailure(id, version string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if failedVersion, ok := c.failed[id]; ok && failedVersion == version {
+		delete(c.failed, id)
+	}
+}
