+func TestTokenIdentityDiscovery(t *testing.T) {
+	key := newSigner(t, "gitlab")
+	var srv *httptest.Server
+	var discoveryCalls atomic.Int32
+	srv = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/.well-known/openid-configuration":
+			discoveryCalls.Add(1)
+			_ = json.NewEncoder(w).Encode(map[string]string{"issuer": srv.URL, "jwks_uri": srv.URL + "/keys"})
+		case "/keys":
+			_ = json.NewEncoder(w).Encode(key.publicJWKS())
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	t.Cleanup(srv.Close)
+	ca := string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: srv.Certificate().Raw}))
+
+	conn := open(t, Config{
+		Issuer:    srv.URL,
+		Keys:      Keys{Discovery: &Discovery{CAData: ca}},
+		Audiences: []Audience{{Exact: "https://dex.example.com"}},
+		Identity: IdentityMapping{
+			Username: ClaimMapping{Claim: "sub", Prefix: "ci:"},
+			Email:    &ClaimMapping{Claim: "user_email"},
+			Groups:   []GroupMapping{{Claim: "groups", Prefix: "ci:"}},
+		},
+		Clients: []string{"ci"},
+	})
+	require.Zero(t, discoveryCalls.Load(), "Open must not fetch the discovery document")
+
+	claims := map[string]any{
+		"iss":        srv.URL,
+		"sub":        "project_path:platform/app:ref_type:branch:ref:main",
+		"aud":        "https://dex.example.com",
+		"exp":        time.Now().Add(time.Minute).Unix(),
+		"user_email": "jane@example.com",
+		"groups":     []string{"deploy", "dev"},
+	}
+	for range 2 {
+		identity, err := conn.TokenIdentity(t.Context(), subjectTokenTypeIDToken, key.sign(t, claims))
+		require.NoError(t, err)
+		require.Equal(t, "ci:project_path:platform/app:ref_type:branch:ref:main", identity.Username)
+		require.Equal(t, "jane@example.com", identity.Email)
+		require.Equal(t, []string{"ci:deploy", "ci:dev"}, identity.Groups)
+	}
+	require.EqualValues(t, 1, discoveryCalls.Load(), "a successful discovery is kept")
+
+	// The key set of discovery verifies a token with the key its kid names.
+	otherKid := signer{key: key.key, kid: "other"}
+	_, err := conn.TokenIdentity(t.Context(), subjectTokenTypeIDToken, otherKid.sign(t, claims))
+	require.ErrorContains(t, err, "verify subject token")
+}
