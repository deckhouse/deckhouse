+			Keys:      Keys{JWKS: key.publicJWKS()},
+			Audiences: []Audience{{Exact: "a"}},
+			Identity:  IdentityMapping{Username: ClaimMapping{Claim: "sub"}},
+			Clients:   []string{"ci"},
+		}
+	}
+
+	tests := []struct {
+		name    string
+		mutate  func(*Config)
+		errText string
+	}{
+		{name: "no issuer", mutate: func(c *Config) { c.Issuer = "" }, errText: "issuer is required"},
+		{name: "no keys", mutate: func(c *Config) { c.Keys = Keys{} }, errText: "exactly one of keys"},
+		{name: "both key sources", mutate: func(c *Config) { c.Keys.Discovery = &Discovery{} }, errText: "exactly one of keys"},
+		{name: "empty jwks", mutate: func(c *Config) { c.Keys.JWKS = &jose.JSONWebKeySet{} }, errText: "no keys"},
+		{name: "private key", mutate: func(c *Config) { c.Keys.JWKS = private }, errText: "private key"},
+		{name: "no audiences", mutate: func(c *Config) { c.Audiences = nil }, errText: "audience is required"},
+		{name: "audience with both forms", mutate: func(c *Config) { c.Audiences = []Audience{{Exact: "a", Prefix: "b"}} }, errText: "audiences[0]"},
+		{name: "claim rule without claim", mutate: func(c *Config) { c.ClaimValidation = []ClaimRule{{Equals: "x"}} }, errText: "claimValidation[0]"},
+		{name: "no clients", mutate: func(c *Config) { c.Clients = nil }, errText: "client is required"},
+		{name: "no username claim", mutate: func(c *Config) { c.Identity.Username.Claim = "" }, errText: "identity.username.claim"},
+		{name: "group without claim", mutate: func(c *Config) { c.Identity.Groups = []GroupMapping{{Prefix: "x"}} }, errText: "identity.groups[0]"},
+		{name: "discovery over plain http", mutate: func(c *Config) {
+			c.Keys = Keys{Discovery: &Discovery{URL: "http://issuer.example.com/.well-known/openid-configuration"}}
+		}, errText: "is not an https URL"},
+		{name: "discovery from a plain http issuer", mutate: func(c *Config) {
+			c.Issuer = "http://issuer.example.com"
+			c.Keys = Keys{Discovery: &Discovery{}}
+		}, errText: "issuer, read for discovery"},
+		{name: "lifetime is not a duration", mutate: func(c *Config) { c.SubjectTokenMaxLifetime = "1d" }, errText: "subjectTokenMaxLifetime"},
+		{name: "lifetime is not positive", mutate: func(c *Config) { c.SubjectTokenMaxLifetime = "0s" }, errText: "must be positive"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			c := base()
+			tc.mutate(&c)
+			_, err := c.Open("tep-test", slog.New(slog.DiscardHandler))
+			require.ErrorContains(t, err, tc.errText)
+		})
+	}
+}
+
+func TestMapIdentityGroups(t *testing.T) {
+	claims := map[string]any{
+		"sub": "s",
+		"aud": []any{"peering.deckhouse.io/peer/b/cap/vm", "peering.deckhouse.io/peer/b/cap/", "other"},
+	}
+	identity, err := mapIdentity(claims, IdentityMapping{
+		Username: ClaimMapping{Claim: "sub"},
+		Groups:   []GroupMapping{{Claim: "aud", TrimPrefix: "peering.deckhouse.io/peer/b/cap/", Prefix: "cap:"}},
+	})
+	require.NoError(t, err)
+	// A value without the prefix and an empty remainder are dropped.
+	require.Equal(t, []string{"cap:vm"}, identity.Groups)
+}
+
+// FuzzTokenIdentity feeds arbitrary subject tokens to a connector with pinned
+// keys: whatever arrives at /token must be refused or mapped, never panic.
+func FuzzTokenIdentity(f *testing.F) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		f.Fatal(err)
+	}
+	s := signer{key: key, kid: "k"}
+	conn, err := (&Config{
+		Issuer:    saIssuer,
+		Keys:      Keys{JWKS: s.publicJWKS()},
+		Audiences: []Audience{{Prefix: "a"}},
+		Identity: IdentityMapping{
+			Username: ClaimMapping{Claim: "sub"},
+			Groups:   []GroupMapping{{Claim: "aud", TrimPrefix: "a"}},
+		},
+		Clients: []string{"fuzz"},
+	}).Open("fuzz", slog.New(slog.DiscardHandler))
+	if err != nil {
+		f.Fatal(err)
+	}
+	te := conn.(connector.TokenIdentityConnector)
+
+	f.Add("")
+	f.Add("a.b.c")
+	f.Add("eyJhbGciOiJub25lIn0.e30.")
+	f.Fuzz(func(t *testing.T, token string) {
+		_, _ = te.TokenIdentity(t.Context(), subjectTokenTypeIDToken, token)
+	})
+}
+
+func TestAllowsClient(t *testing.T) {
+	conn, err := (&Config{
+		Issuer:    saIssuer,
+		Keys:      Keys{JWKS: newSigner(t, "k").publicJWKS()},
+		Audiences: []Audience{{Exact: "a"}},
+		Identity:  IdentityMapping{Username: ClaimMapping{Claim: "sub"}},
+		Clients:   []string{"dex-client-receiver@d8-peering"},
+	}).Open("tep-test", slog.New(slog.DiscardHandler))
+	require.NoError(t, err)
+	restricted, ok := conn.(connector.ClientRestrictedConnector)
+	require.True(t, ok)
+	require.True(t, restricted.AllowsClient("dex-client-receiver@d8-peering"))
+	require.False(t, restricted.AllowsClient("kubeconfig-generator"))
+}
+
+// A discovery that panics still lets the next exchanges through: they do not
+// wait for it until their deadline.
+func TestTokenIdentityDiscoveryPanic(t *testing.T) {
+	conn := open(t, Config{
+		Issuer:    "https://issuer.example.com",
+		Keys:      Keys{Discovery: &Discovery{}},
+		Audiences: []Audience{{Exact: "dex"}},
+		Identity:  IdentityMapping{Username: ClaimMapping{Claim: "sub"}},
+		Clients:   []string{"ci"},
+	})
+	c := conn.(*tokenExchangeConnector)
+	c.httpClient = nil // makes the discovery panic
+
+	func() {
+		defer func() { require.NotNil(t, recover()) }()
+		_, _ = conn.TokenIdentity(t.Context(), subjectTokenTypeIDToken, "a.b.c")
+	}()
+
+	c.mu.Lock()
+	require.Nil(t, c.discovering)
+	c.mu.Unlock()
+}
+
+// The keys of an issuer are read over https only: neither a plain http
+// jwks_uri nor a redirect to plain http is followed.
+func TestTokenIdentityKeysOverHTTPSOnly(t *testing.T) {
+	key := newSigner(t, "k")
+	plain := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_ = json.NewEncoder(w).Encode(key.publicJWKS())
+	}))
+	t.Cleanup(plain.Close)
+
+	tests := []struct {
+		name    string
+		jwksURI func(srv *httptest.Server) string
+		errText string
+	}{
+		{name: "plain http jwks_uri", jwksURI: func(*httptest.Server) string { return plain.URL + "/keys" }, errText: "jwks_uri"},
+		{name: "redirect to plain http", jwksURI: func(srv *httptest.Server) string { return srv.URL + "/redirect" }, errText: "verify subject token"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var srv *httptest.Server
+			srv = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch r.URL.Path {
+				case "/.well-known/openid-configuration":
+					_ = json.NewEncoder(w).Encode(map[string]string{"issuer": srv.URL, "jwks_uri": tc.jwksURI(srv)})
+				case "/redirect":
+					http.Redirect(w, r, plain.URL+"/keys", http.StatusFound)
+				}
+			}))
+			t.Cleanup(srv.Close)
+			ca := string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: srv.Certificate().Raw}))
+			conn := open(t, Config{
+				Issuer:    srv.URL,
+				Keys:      Keys{Discovery: &Discovery{CAData: ca}},
+				Audiences: []Audience{{Exact: "dex"}},
+				Identity:  IdentityMapping{Username: ClaimMapping{Claim: "sub"}},
+				Clients:   []string{"ci"},
+			})
+			token := key.sign(t, map[string]any{"iss": srv.URL, "sub": "x", "aud": "dex", "exp": time.Now().Add(time.Minute).Unix()})
+			_, err := conn.TokenIdentity(t.Context(), subjectTokenTypeIDToken, token)
+			require.ErrorContains(t, err, tc.errText)
+		})
+	}
+}
