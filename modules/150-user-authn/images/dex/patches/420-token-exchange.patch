+func TestTokenIdentityDiscoveryRetries(t *testing.T) {
+	key := newSigner(t, "k")
+	var up atomic.Bool
+	var srv *httptest.Server
+	srv = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if !up.Load() {
+			http.Error(w, "down", http.StatusServiceUnavailable)
+			return
+		}
+		switch r.URL.Path {
+		case "/.well-known/openid-configuration":
+			_ = json.NewEncoder(w).Encode(map[string]string{"issuer": srv.URL, "jwks_uri": srv.URL + "/keys"})
+		case "/keys":
+			_ = json.NewEncoder(w).Encode(key.publicJWKS())
+		}
+	}))
+	t.Cleanup(srv.Close)
+	ca := string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: srv.Certificate().Raw}))
+
+	conn := open(t, Config{
+		Issuer:    srv.URL,
+		Keys:      Keys{Discovery: &Discovery{CAData: ca}},
+		Audiences: []Audience{{Exact: "dex"}},
+		Identity:  IdentityMapping{Username: ClaimMapping{Claim: "sub"}},
+		Clients:   []string{"ci"},
+	})
+	token := key.sign(t, map[string]any{"iss": srv.URL, "sub": "x", "aud": "dex", "exp": time.Now().Add(time.Minute).Unix()})
+
+	_, err := conn.TokenIdentity(t.Context(), subjectTokenTypeIDToken, token)
+	require.ErrorContains(t, err, "discovery")
+
+	// Until the retry period ends, the failure answers without asking again.
+	up.Store(true)
+	_, err = conn.TokenIdentity(t.Context(), subjectTokenTypeIDToken, token)
+	require.ErrorContains(t, err, "discovery")
+
+	expireDiscoveryFailure(conn)
+	_, err = conn.TokenIdentity(t.Context(), subjectTokenTypeIDToken, token)
+	require.NoError(t, err)
+}
+
+func expireDiscoveryFailure(conn connector.TokenIdentityConnector) {
+	c := conn.(*tokenExchangeConnector)
+	c.mu.Lock()
+	c.retryAt = time.Time{}
+	c.mu.Unlock()
+}
+
+// Exchanges that come while the issuer is slow wait for one discovery, not
+// for one each in turn.
+func TestTokenIdentityDiscoveryOnce(t *testing.T) {
+	var calls atomic.Int32
+	srv := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		calls.Add(1)
+		time.Sleep(500 * time.Millisecond)
+		http.Error(w, "down", http.StatusServiceUnavailable)
+	}))
+	t.Cleanup(srv.Close)
+	ca := string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: srv.Certificate().Raw}))
+
+	conn := open(t, Config{
+		Issuer:    srv.URL,
+		Keys:      Keys{Discovery: &Discovery{CAData: ca}},
+		Audiences: []Audience{{Exact: "dex"}},
+		Identity:  IdentityMapping{Username: ClaimMapping{Claim: "sub"}},
+		Clients:   []string{"ci"},
+	})
+
+	start := time.Now()
+	var wg sync.WaitGroup
+	for range 5 {
+		wg.Go(func() {
+			_, err := conn.TokenIdentity(t.Context(), subjectTokenTypeIDToken, "a.b.c")
+			assert.ErrorContains(t, err, "discovery")
+		})
+	}
+	wg.Wait()
+	require.Less(t, time.Since(start), 2*time.Second)
+	require.EqualValues(t, 1, calls.Load())
+
+	// A waiting exchange gives up with its own context.
+	expireDiscoveryFailure(conn)
+	ctx, cancel := context.WithTimeout(t.Context(), 50*time.Millisecond)
+	defer cancel()
+	go func() { _, _ = conn.TokenIdentity(t.Context(), subjectTokenTypeIDToken, "a.b.c") }()
+	time.Sleep(10 * time.Millisecond)
+	_, err := conn.TokenIdentity(ctx, subjectTokenTypeIDToken, "a.b.c")
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+}
