+package allowlist
+
+import (
+	"errors"
+	"log/slog"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector/tokenexchange"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+func TestApplyReservedPrefixes(t *testing.T) {
+	SetReservedPrefixes([]string{"system:", "peering:"})
+	t.Cleanup(func() { SetReservedPrefixes(nil) })
+
+	ctx := t.Context()
+	s := memory.New(slog.New(slog.DiscardHandler))
+	require.NoError(t, s.CreateConnector(ctx, storage.Connector{ID: "corp", Type: "oidc", Name: "Corp"}))
+	require.NoError(t, s.CreateConnector(ctx, storage.Connector{
+		ID: "tep-peer", Type: tokenexchange.Type, Name: "peer",
+		Config: []byte(`{"reservedPrefixes":["peering:peer:moscow:","peering:peer:moscow:cap:"]}`),
+	}))
+	require.NoError(t, s.CreateConnector(ctx, storage.Connector{
+		ID: "tep-ci", Type: tokenexchange.Type, Name: "ci",
+		Config: []byte(`{"issuer":"https://ci.example"}`),
+	}))
+	require.NoError(t, s.CreateConnector(ctx, storage.Connector{
+		// Ownership is read from token-exchange connectors only.
+		ID: "oidc-claims-owner", Type: "oidc", Name: "oidc",
+		Config: []byte(`{"reservedPrefixes":["peering:"]}`),
+	}))
+
+	tests := []struct {
+		name        string
+		connectorID string
+		claims      storage.Claims
+		refused     bool
+	}{
+		{
+			name:        "ordinary names pass",
+			connectorID: "corp",
+			claims:      storage.Claims{Email: "jane@example.com", Groups: []string{"staff"}},
+		},
+		{
+			name:        "login connector cannot assert a reserved email",
+			connectorID: "corp",
+			claims:      storage.Claims{Email: "peering:peer:moscow:x"},
+			refused:     true,
+		},
+		{
+			name:        "login connector cannot assert a reserved group",
+			connectorID: "corp",
+			claims:      storage.Claims{Email: "jane@example.com", Groups: []string{"staff", "system:masters"}},
+			refused:     true,
+		},
+		{
+			name:        "owner asserts its prefix",
+			connectorID: "tep-peer",
+			claims:      storage.Claims{Email: "peering:peer:moscow:sa", Groups: []string{"peering:peer:moscow:cap:vm"}},
+		},
+		{
+			name:        "owner cannot assert the names of another peer",
+			connectorID: "tep-peer",
+			claims:      storage.Claims{Email: "peering:peer:moscow:sa", Groups: []string{"peering:peer:spb:cap:vm"}},
+			refused:     true,
+		},
+		{
+			name:        "owner of one prefix cannot assert another",
+			connectorID: "tep-peer",
+			claims:      storage.Claims{Email: "peering:peer:moscow:sa", Groups: []string{"system:masters"}},
+			refused:     true,
+		},
+		{
+			name:        "token-exchange connector without ownership is refused",
+			connectorID: "tep-ci",
+			claims:      storage.Claims{Email: "peering:peer:moscow:sa"},
+			refused:     true,
+		},
+		{
+			name:        "ownership in the config of another connector type is ignored",
+			connectorID: "oidc-claims-owner",
+			claims:      storage.Claims{Email: "peering:peer:moscow:sa"},
+			refused:     true,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			claims := tc.claims
+			err := Apply(ctx, s, storage.Client{ID: "app"}, tc.connectorID, &claims)
+			if !tc.refused {
+				require.NoError(t, err)
+				return
+			}
+			var notAllowed *NotAllowedError
+			require.True(t, errors.As(err, &notAllowed))
+			require.Equal(t, ReservedPrefix, notAllowed.Rule)
+			require.Equal(t, tc.connectorID, notAllowed.ConnectorID)
+		})
+	}
+}
+
+func TestApplyNoReservedPrefixes(t *testing.T) {
+	SetReservedPrefixes(nil)
+
+	ctx := t.Context()
+	s := memory.New(slog.New(slog.DiscardHandler))
+	require.NoError(t, s.CreateConnector(ctx, storage.Connector{ID: "corp", Type: "oidc", Name: "Corp"}))
+
+	claims := storage.Claims{Email: "peering:peer:x", Groups: []string{"system:masters"}}
+	require.NoError(t, Apply(ctx, s, storage.Client{ID: "app"}, "corp", &claims))
+}
