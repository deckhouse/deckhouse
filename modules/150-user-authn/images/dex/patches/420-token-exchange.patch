+// saIssuer is the issuer every DKP cluster gives its service account tokens.
+const saIssuer = "https://kubernetes.default.svc.cluster.local"
+
+type signer struct {
+	key *rsa.PrivateKey
+	kid string
+}
+
+func newSigner(t *testing.T, kid string) signer {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	return signer{key: key, kid: kid}
+}
+
+func (s signer) publicJWKS() *jose.JSONWebKeySet {
+	return &jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: &s.key.PublicKey, KeyID: s.kid, Algorithm: "RS256", Use: "sig"}}}
+}
+
+func (s signer) sign(t *testing.T, claims map[string]any) string {
+	t.Helper()
+	opts := (&jose.SignerOptions{}).WithType("JWT")
+	if s.kid != "" {
+		opts = opts.WithHeader("kid", s.kid)
+	}
+	sig, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.RS256, Key: s.key}, opts)
+	require.NoError(t, err)
+	payload, err := json.Marshal(claims)
+	require.NoError(t, err)
+	jws, err := sig.Sign(payload)
+	require.NoError(t, err)
+	token, err := jws.CompactSerialize()
+	require.NoError(t, err)
+	return token
+}
+
+func saClaims(aud ...string) map[string]any {
+	now := time.Now()
+	return map[string]any{
+		"iss": saIssuer,
+		"sub": "system:serviceaccount:d8-virtualization:virtualization-controller",
+		"aud": aud,
+		"iat": now.Unix(),
+		"exp": now.Add(10 * time.Minute).Unix(),
+	}
+}
+
+// peeringConfig is the config a peering TokenExchangeProvider renders to.
+func peeringConfig(jwks *jose.JSONWebKeySet) Config {
+	return Config{
+		Issuer:    saIssuer,
+		Keys:      Keys{JWKS: jwks},
+		Audiences: []Audience{{Prefix: "peering.deckhouse.io/peer/b-uuid/"}},
+		Identity: IdentityMapping{
+			Username: ClaimMapping{Claim: "sub", Prefix: "peering:peer:moscow:"},
+			Groups: []GroupMapping{{
+				Claim:      "aud",
+				TrimPrefix: "peering.deckhouse.io/peer/b-uuid/cap/",
+				Prefix:     "peering:peer:moscow:cap:",
+			}},
+		},
+		ReservedPrefixes: []string{"peering:peer:moscow:", "peering:peer:moscow:cap:"},
+		Clients:          []string{"peering-receiver"},
+	}
+}
