+// Package tokenexchange implements a connector that serves the token-exchange
+// grant only: it verifies a JWT of a trusted issuer and maps its claims to an
+// identity. Deckhouse renders it from a TokenExchangeProvider; upstream has no
+// equivalent.
+//
+// Unlike the OIDC connector it checks the audience of the subject token, can
+// verify against keys pinned in the config instead of the issuer's discovery
+// (Kubernetes service account issuers of different clusters share one URL),
+// requires claim values, and names the subject with prefixes. It has no login.
+package tokenexchange
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/url"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/coreos/go-oidc/v3/oidc"
+	"github.com/go-jose/go-jose/v4"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/pkg/httpclient"
+)
+
+// Type is the connector type in the Dex config and storage.
+const Type = "tokenexchange"
+
+// subjectTokenTypeIDToken is the only subject token type the connector takes:
+// a JWT it verifies itself. An access token would need the issuer's userinfo,
+// which carries no audience to check.
+const subjectTokenTypeIDToken = "urn:ietf:params:oauth:token-type:id_token"
+
+// discoveryTimeout bounds one discovery request, as patch 400 does for the
+// OIDC connector.
+const discoveryTimeout = 10 * time.Second
+
+// clockSkew is how far ahead of the clock of Dex the iat of a subject token
+// may be and still count: the clock of the issuer may run a little fast. It is
+// the leeway go-oidc gives nbf.
+const clockSkew = 5 * time.Minute
+
+// discoveryRetry is how long a failed discovery answers the exchanges that
+// follow before the issuer is asked again: an issuer that is down gets one
+// request per period, not one per exchange.
+const discoveryRetry = 10 * time.Second
+
+// maxDiscoveryBytes bounds the discovery document read into memory.
+const maxDiscoveryBytes = 1 << 20
+
+// defaultSubjectTokenMaxLifetime is the limit of Config.SubjectTokenMaxLifetime
+// when the config sets none.
+const defaultSubjectTokenMaxLifetime = 24 * time.Hour
+
+// supportedSigningAlgs are the algorithms a subject token may be signed with.
+var supportedSigningAlgs = []string{
+	oidc.RS256, oidc.RS384, oidc.RS512,
+	oidc.ES256, oidc.ES384, oidc.ES512,
+	oidc.PS256, oidc.PS384, oidc.PS512,
+	oidc.EdDSA,
+}
+
+// signingAlgs are supportedSigningAlgs for go-jose.
+var signingAlgs = func() []jose.SignatureAlgorithm {
+	algs := make([]jose.SignatureAlgorithm, 0, len(supportedSigningAlgs))
+	for _, alg := range supportedSigningAlgs {
+		algs = append(algs, jose.SignatureAlgorithm(alg))
+	}
+	return algs
+}()
+
+// Config is the connector config. It mirrors the spec of a
+// TokenExchangeProvider.
+type Config struct {
+	// Issuer must equal the iss claim of a subject token.
+	Issuer string `json:"issuer"`
+	// Keys says where the keys that sign subject tokens come from.
+	Keys Keys `json:"keys"`
+	// Audiences admit a subject token whose aud matches at least one of them.
+	Audiences []Audience `json:"audiences"`
+	// ClaimValidation lists claim values a subject token must carry.
+	ClaimValidation []ClaimRule `json:"claimValidation"`
+	// SubjectTokenMaxLifetime bounds how long a subject token may be valid: exp
+	// minus iat, or exp minus now for a token without iat. A Go duration; the
+	// default is 24h.
+	SubjectTokenMaxLifetime string `json:"subjectTokenMaxLifetime"`
+	// Identity maps the claims of a subject token to the identity.
+	Identity IdentityMapping `json:"identity"`
+	// ReservedPrefixes are the prefixes of the names this connector gives
+	// under a reserved name prefix: such a name must start with one of them
+	// (server/allowlist). Only the user-authn controller writes them.
+	ReservedPrefixes []string `json:"reservedPrefixes"`
+	// Clients are the IDs of the clients that may exchange through this
+	// connector; the others are refused before their token is looked at.
+	Clients []string `json:"clients"`
+}
+
+// Keys holds exactly one source of the issuer's keys.
+type Keys struct {
+	// Discovery reads the keys from the issuer's discovery document.
+	Discovery *Discovery `json:"discovery"`
+	// JWKS pins the public keys.
+	JWKS *jose.JSONWebKeySet `json:"jwks"`
+}
+
+// Discovery locates the issuer's discovery document.
+type Discovery struct {
+	// URL of the discovery document; the default is
+	// <issuer>/.well-known/openid-configuration.
+	URL string `json:"url"`
+	// CAData is a PEM bundle that the issuer's certificate chains to, in
+	// addition to the system roots.
+	CAData string `json:"caData"`
+}
+
+// Audience matches an aud value exactly or by prefix.
+type Audience struct {
+	Exact  string `json:"exact"`
+	Prefix string `json:"prefix"`
+}
+
+// ClaimRule requires a claim to carry a value: a string equal to it, a boolean
+// or a number that prints as it, or a list that contains it.
+type ClaimRule struct {
+	Claim  string `json:"claim"`
+	Equals string `json:"equals"`
+}
+
+// IdentityMapping names the subject of a token.
+type IdentityMapping struct {
+	// Username is required. Its value also becomes the email when Email is not
+	// set: the Kubernetes API server takes the user name from the email claim.
+	Username ClaimMapping `json:"username"`
+	// Email is optional.
+	Email *ClaimMapping `json:"email"`
+	// Groups are collected from every mapping in turn.
+	Groups []GroupMapping `json:"groups"`
+}
+
+// ClaimMapping takes a string claim and prepends Prefix.
+type ClaimMapping struct {
+	Claim  string `json:"claim"`
+	Prefix string `json:"prefix"`
+}
+
+// GroupMapping takes a string or a list of strings from Claim. With
+// TrimPrefix, a value without it is dropped and the rest of one with it is
+// kept; Prefix is prepended to every value kept.
+type GroupMapping struct {
+	Claim      string `json:"claim"`
+	TrimPrefix string `json:"trimPrefix"`
+	Prefix     string `json:"prefix"`
+}
+
+// Open validates the config and returns the connector. With discovery it does
+// not fetch anything: the keys are read at the first exchange, so an issuer
+// that is down does not hold the startup of Dex.
+func (c *Config) Open(id string, logger *slog.Logger) (connector.Connector, error) {
+	if err := c.validate(); err != nil {
+		return nil, fmt.Errorf("tokenexchange: %w", err)
+	}
+
+	conn := &tokenExchangeConnector{
+		config:      *c,
+		logger:      logger.With(slog.Group("connector", "type", Type, "id", id)),
+		maxLifetime: defaultSubjectTokenMaxLifetime,
+	}
+	if c.SubjectTokenMaxLifetime != "" {
+		// validate has parsed it already.
+		conn.maxLifetime, _ = time.ParseDuration(c.SubjectTokenMaxLifetime)
+	}
+
+	if c.Keys.JWKS != nil {
+		keys, err := publicKeys(c.Keys.JWKS)
+		if err != nil {
+			return nil, fmt.Errorf("tokenexchange: %w", err)
+		}
+		conn.verifier = newVerifier(c.Issuer, pinnedKeySet{keys: keys})
+		return conn, nil
+	}
+
+	var caData []string
+	if c.Keys.Discovery.CAData != "" {
+		caData = []string{c.Keys.Discovery.CAData}
+	}
+	client, err := httpclient.NewHTTPClient(caData, false)
+	if err != nil {
+		return nil, fmt.Errorf("tokenexchange: http client: %w", err)
+	}
+	// The key set fetches the keys with this client, on a context without a
+	// deadline: the timeout keeps a hung JWKS endpoint from holding it forever.
+	client.Timeout = discoveryTimeout
+	// The keys decide whom Dex trusts: they are read over https only, and a
+	// redirect elsewhere is not followed.
+	client.CheckRedirect = func(req *http.Request, via []*http.Request) error {
+		if req.URL.Scheme != "https" {
+			return fmt.Errorf("redirect to %s: only https is followed", req.URL.Redacted())
+		}
+		if len(via) >= 5 {
+			return errors.New("too many redirects")
+		}
+		return nil
+	}
+	conn.httpClient = client
+	conn.discoveryRetry = discoveryRetry
+	return conn, nil
+}
+
+func (c *Config) validate() error {
+	if c.Issuer == "" {
+		return errors.New("issuer is required")
+	}
+	if (c.Keys.Discovery == nil) == (c.Keys.JWKS == nil) {
+		return errors.New("exactly one of keys.discovery and keys.jwks is required")
+	}
+	if c.Keys.Discovery != nil {
+		// Without url the discovery document is read from the issuer, so the
+		// issuer has to be https as well.
+		if c.Keys.Discovery.URL != "" {
+			if err := requireHTTPS(c.Keys.Discovery.URL); err != nil {
+				return fmt.Errorf("keys.discovery.url: %w", err)
+			}
+		} else if err := requireHTTPS(c.Issuer); err != nil {
+			return fmt.Errorf("issuer, read for discovery: %w", err)
+		}
+	}
+	if c.Keys.JWKS != nil && len(c.Keys.JWKS.Keys) == 0 {
+		return errors.New("keys.jwks has no keys")
+	}
+	if len(c.Audiences) == 0 {
+		return errors.New("at least one audience is required")
+	}
+	for i, a := range c.Audiences {
+		if (a.Exact == "") == (a.Prefix == "") {
+			return fmt.Errorf("audiences[%d]: exactly one of exact and prefix is required", i)
+		}
+	}
+	for i, r := range c.ClaimValidation {
+		if r.Claim == "" {
+			return fmt.Errorf("claimValidation[%d]: claim is required", i)
+		}
+	}
+	if c.SubjectTokenMaxLifetime != "" {
+		d, err := time.ParseDuration(c.SubjectTokenMaxLifetime)
+		if err != nil {
+			return fmt.Errorf("subjectTokenMaxLifetime: %w", err)
+		}
+		if d <= 0 {
+			return errors.New("subjectTokenMaxLifetime must be positive")
+		}
+	}
+	if len(c.Clients) == 0 {
+		return errors.New("at least one client is required")
+	}
+	if c.Identity.Username.Claim == "" {
+		return errors.New("identity.username.claim is required")
+	}
+	if c.Identity.Email != nil && c.Identity.Email.Claim == "" {
+		return errors.New("identity.email.claim is required when identity.email is set")
+	}
+	for i, g := range c.Identity.Groups {
+		if g.Claim == "" {
+			return fmt.Errorf("identity.groups[%d]: claim is required", i)
+		}
+	}
+	return nil
+}
+
+// publicKeys returns the public keys of a key set. A private key is refused:
+// the config is not a secret, and a key that can sign has no place in it.
+func publicKeys(set *jose.JSONWebKeySet) ([]jose.JSONWebKey, error) {
+	keys := make([]jose.JSONWebKey, 0, len(set.Keys))
+	for i, k := range set.Keys {
+		if !k.Valid() {
+			return nil, fmt.Errorf("keys.jwks.keys[%d] is not a valid key", i)
+		}
+		if !k.IsPublic() {
+			return nil, fmt.Errorf("keys.jwks.keys[%d] is a private key", i)
+		}
+		keys = append(keys, k)
+	}
+	return keys, nil
+}
+
+// pinnedKeySet verifies a token with the pinned keys. Unlike oidc.StaticKeySet
+// it honors the kid of the token, as the key set of discovery does: a token
+// that names a key is verified with the key of that kid only, even when the set
+// has a single key. A token without kid is tried with every key.
+type pinnedKeySet struct {
+	keys []jose.JSONWebKey
+}
+
+func (s pinnedKeySet) VerifySignature(_ context.Context, jwt string) ([]byte, error) {
+	jws, err := jose.ParseSigned(jwt, signingAlgs)
+	if err != nil {
+		return nil, fmt.Errorf("parse jwt: %w", err)
+	}
+	if len(jws.Signatures) != 1 {
+		return nil, errors.New("jwt must have exactly one signature")
+	}
+	kid := jws.Signatures[0].Header.KeyID
+	for i := range s.keys {
+		if kid != "" && s.keys[i].KeyID != kid {
+			continue
+		}
+		if payload, err := jws.Verify(&s.keys[i]); err == nil {
+			return payload, nil
+		}
+	}
+	if kid != "" {
+		return nil, fmt.Errorf("no pinned key with kid %q verifies the jwt", kid)
+	}
+	return nil, errors.New("no pinned key verifies the jwt")
+}
+
+func newVerifier(issuer string, keySet oidc.KeySet) *oidc.IDTokenVerifier {
+	return oidc.NewVerifier(issuer, keySet, &oidc.Config{
+		// The audience is checked against Config.Audiences instead.
+		SkipClientIDCheck:    true,
+		SupportedSigningAlgs: supportedSigningAlgs,
+	})
+}
+
+var (
+	_ connector.Connector                 = (*tokenExchangeConnector)(nil)
+	_ connector.TokenIdentityConnector    = (*tokenExchangeConnector)(nil)
+	_ connector.ClientRestrictedConnector = (*tokenExchangeConnector)(nil)
+)
+
+type tokenExchangeConnector struct {
+	config     Config
+	logger     *slog.Logger
+	httpClient *http.Client
+
+	// mu guards the fields below. With pinned keys Open sets verifier;
+	// with discovery the first exchange that finds none starts a discovery,
+	// and the others wait for its end without holding mu.
+	mu       sync.Mutex
+	verifier *oidc.IDTokenVerifier
+	// discovering is closed when the discovery in flight ends; nil when none
+	// runs.
+	discovering chan struct{}
+	// discoveryErr is the error of the last failed discovery, returned until
+	// retryAt.
+	discoveryErr   error
+	retryAt        time.Time
+	discoveryRetry time.Duration
+
+	maxLifetime time.Duration
+}
+
+// Close implements connector.Connector; the connector holds nothing to free.
+func (c *tokenExchangeConnector) Close() error { return nil }
+
+// AllowsClient reports whether the client may exchange through the connector.
+func (c *tokenExchangeConnector) AllowsClient(clientID string) bool {
+	return slices.Contains(c.config.Clients, clientID)
+}
+
+// TokenIdentity verifies a subject token and maps its claims to an identity.
+func (c *tokenExchangeConnector) TokenIdentity(ctx context.Context, subjectTokenType, subjectToken string) (connector.Identity, error) {
+	if subjectTokenType != subjectTokenTypeIDToken {
+		return connector.Identity{}, fmt.Errorf("tokenexchange: unsupported subject token type %q", subjectTokenType)
+	}
+
+	verifier, err := c.getVerifier(ctx)
+	if err != nil {
+		return connector.Identity{}, err
+	}
+
+	token, err := verifier.Verify(ctx, subjectToken)
+	if err != nil {
+		return connector.Identity{}, fmt.Errorf("tokenexchange: verify subject token: %w", err)
+	}
+	if err := checkLifetime(token, c.maxLifetime, time.Now()); err != nil {
+		return connector.Identity{}, err
+	}
+	if !audienceAllowed(token.Audience, c.config.Audiences) {
+		return connector.Identity{}, fmt.Errorf("tokenexchange: audience %q is not allowed", token.Audience)
+	}
+
+	var claims map[string]any
+	if err := token.Claims(&claims); err != nil {
+		return connector.Identity{}, fmt.Errorf("tokenexchange: decode claims: %w", err)
+	}
+	for _, rule := range c.config.ClaimValidation {
+		if !claimEquals(claims[rule.Claim], rule.Equals) {
+			return connector.Identity{}, fmt.Errorf("tokenexchange: claim %q does not equal %q", rule.Claim, rule.Equals)
+		}
+	}
+
+	return mapIdentity(claims, c.config.Identity)
+}
+
+// checkLifetime refuses a subject token valid for longer than limit: a leaked
+// long-lived token would otherwise buy fresh Dex tokens until it expires. The
+// verifier has refused a token without exp or past it already.
+//
+// The lifetime counts from iat, or from now when the token has no iat or one
+// more than clockSkew in the future: go-oidc does not check iat, and a token
+// issued "in ten years" for an hour would otherwise pass for ten years.
+func checkLifetime(token *oidc.IDToken, limit time.Duration, now time.Time) error {
+	start := now
+	if !token.IssuedAt.IsZero() && token.IssuedAt.Before(now.Add(clockSkew)) {
+		start = token.IssuedAt
+	}
+	if lifetime := token.Expiry.Sub(start); lifetime > limit {
+		return fmt.Errorf("tokenexchange: subject token is valid for %s from %s, longer than %s",
+			lifetime.Round(time.Second), start.UTC().Format(time.RFC3339), limit)
+	}
+	return nil
+}
+
+// getVerifier returns the verifier, reading the discovery document first if
+// no read succeeded yet. One discovery runs at a time, and the exchanges that
+// come meanwhile wait for it as long as their own context allows. A failed
+// read answers the exchanges of the next discoveryRetry, then the issuer is
+// asked again.
+func (c *tokenExchangeConnector) getVerifier(ctx context.Context) (*oidc.IDTokenVerifier, error) {
+	for {
+		c.mu.Lock()
+		if c.verifier != nil {
+			verifier := c.verifier
+			c.mu.Unlock()
+			return verifier, nil
+		}
+		if c.discoveryErr != nil && time.Now().Before(c.retryAt) {
+			err := c.discoveryErr
+			c.mu.Unlock()
+			return nil, err
+		}
+		if wait := c.discovering; wait != nil {
+			c.mu.Unlock()
+			select {
+			case <-wait:
+				continue
+			case <-ctx.Done():
+				return nil, fmt.Errorf("tokenexchange: wait for discovery: %w", ctx.Err())
+			}
+		}
+		c.discovering = make(chan struct{})
+		c.mu.Unlock()
+		return c.runDiscovery(ctx)
+	}
+}
+
+// runDiscovery reads the discovery document for getVerifier and records the
+// outcome. The deferred release runs even if the discovery panics, so that
+// the waiting exchanges do not wait for a discovery that never ends.
+func (c *tokenExchangeConnector) runDiscovery(ctx context.Context) (verifier *oidc.IDTokenVerifier, err error) {
+	defer func() {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		switch {
+		case verifier != nil:
+			c.verifier, c.discoveryErr = verifier, nil
+		case err != nil:
+			c.discoveryErr = err
+			c.retryAt = time.Now().Add(c.discoveryRetry)
+		}
+		close(c.discovering)
+		c.discovering = nil
+	}()
+	// The discovery serves every waiting exchange, so the client that started
+	// it going away does not fail it.
+	return c.discoverVerifier(context.WithoutCancel(ctx))
+}
+
+func (c *tokenExchangeConnector) discoverVerifier(ctx context.Context) (*oidc.IDTokenVerifier, error) {
+	discoveryURL := c.config.Keys.Discovery.URL
+	if discoveryURL == "" {
+		discoveryURL = strings.TrimSuffix(c.config.Issuer, "/") + "/.well-known/openid-configuration"
+	}
+	provider, err := c.discover(ctx, discoveryURL)
+	if err != nil {
+		return nil, fmt.Errorf("tokenexchange: discovery %s: %w", discoveryURL, err)
+	}
+
+	// The key set keeps the background context: it refetches the keys of a
+	// rotation long after this exchange ends.
+	keySetCtx := oidc.ClientContext(context.Background(), c.httpClient)
+	return newVerifier(c.config.Issuer, oidc.NewRemoteKeySet(keySetCtx, provider.JWKSURL)), nil
+}
+
+func (c *tokenExchangeConnector) discover(ctx context.Context, discoveryURL string) (oidc.ProviderConfig, error) {
+	ctx, cancel := context.WithTimeout(ctx, discoveryTimeout)
+	defer cancel()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, discoveryURL, nil)
+	if err != nil {
+		return oidc.ProviderConfig{}, fmt.Errorf("new request: %w", err)
+	}
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return oidc.ProviderConfig{}, fmt.Errorf("get: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return oidc.ProviderConfig{}, fmt.Errorf("get: status %s", resp.Status)
+	}
+
+	var doc oidc.ProviderConfig
+	if err := json.NewDecoder(io.LimitReader(resp.Body, maxDiscoveryBytes)).Decode(&doc); err != nil {
+		return oidc.ProviderConfig{}, fmt.Errorf("decode: %w", err)
+	}
+	if doc.IssuerURL != c.config.Issuer {
+		return oidc.ProviderConfig{}, fmt.Errorf("issuer %q does not match the configured %q", doc.IssuerURL, c.config.Issuer)
+	}
+	if doc.JWKSURL == "" {
+		return oidc.ProviderConfig{}, errors.New("no jwks_uri")
+	}
+	if err := requireHTTPS(doc.JWKSURL); err != nil {
+		return oidc.ProviderConfig{}, fmt.Errorf("jwks_uri: %w", err)
+	}
+	return doc, nil
+}
+
+// requireHTTPS refuses an address that is not https: the keys of an issuer
+// read over plain http could be swapped on the way.
+func requireHTTPS(address string) error {
+	u, err := url.Parse(address)
+	if err != nil {
+		return fmt.Errorf("parse %q: %w", address, err)
+	}
+	if u.Scheme != "https" || u.Host == "" {
+		return fmt.Errorf("%q is not an https URL", address)
+	}
+	return nil
+}
+
+func audienceAllowed(aud []string, allowed []Audience) bool {
+	for _, value := range aud {
+		for _, a := range allowed {
+			if a.Exact != "" && value == a.Exact {
+				return true
+			}
+			if a.Prefix != "" && strings.HasPrefix(value, a.Prefix) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// claimEquals reports whether a claim value carries want. JSON numbers decode
+// as float64 and print without a fraction when they have none.
+func claimEquals(value any, want string) bool {
+	switch v := value.(type) {
+	case string:
+		return v == want
+	case bool:
+		return strconv.FormatBool(v) == want
+	case float64:
+		return strconv.FormatFloat(v, 'f', -1, 64) == want
+	case []any:
+		for _, item := range v {
+			if claimEquals(item, want) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func mapIdentity(claims map[string]any, m IdentityMapping) (connector.Identity, error) {
+	subject, ok := claims["sub"].(string)
+	if !ok || subject == "" {
+		return connector.Identity{}, errors.New(`tokenexchange: missing "sub" claim`)
+	}
+
+	username, err := mapClaim(claims, m.Username)
+	if err != nil {
+		return connector.Identity{}, err
+	}
+	email := username
+	if m.Email != nil {
+		if email, err = mapClaim(claims, *m.Email); err != nil {
+			return connector.Identity{}, err
+		}
+	}
+
+	var groups []string
+	for _, g := range m.Groups {
+		for _, value := range stringValues(claims[g.Claim]) {
+			if g.TrimPrefix != "" {
+				rest, found := strings.CutPrefix(value, g.TrimPrefix)
+				if !found {
+					continue
+				}
+				value = rest
+			}
+			if value == "" {
+				continue
+			}
+			groups = append(groups, g.Prefix+value)
+		}
+	}
+
+	return connector.Identity{
+		UserID:            subject,
+		Username:          username,
+		PreferredUsername: username,
+		Email:             email,
+		// The mapping, not the issuer, vouches for the email: it is the name
+		// the cluster knows the subject by.
+		EmailVerified: true,
+		Groups:        groups,
+	}, nil
+}
+
+func mapClaim(claims map[string]any, m ClaimMapping) (string, error) {
+	value, ok := claims[m.Claim].(string)
+	if !ok || value == "" {
+		return "", fmt.Errorf("tokenexchange: missing string claim %q", m.Claim)
+	}
+	return m.Prefix + value, nil
+}
+
+// stringValues returns a string claim as one value and the strings of a list
+// claim; anything else gives none.
+func stringValues(value any) []string {
+	switch v := value.(type) {
+	case string:
+		return []string{v}
+	case []any:
+		values := make([]string, 0, len(v))
+		for _, item := range v {
+			if s, ok := item.(string); ok {
+				values = append(values, s)
+			}
+		}
+		return values
+	}
+	return nil
+}
