diff --git a/server/allowlist/reserved.go b/server/allowlist/reserved.go
new file mode 100644
index 00000000..3f5f2035
--- /dev/null
+++ b/server/allowlist/reserved.go
@@ -0,0 +1,79 @@
+package allowlist
+
+import (
+	"encoding/json"
+	"slices"
+	"strings"
+	"sync/atomic"
+
+	"github.com/dexidp/dex/connector/tokenexchange"
+	"github.com/dexidp/dex/storage"
+)
+
+// reservedPrefixes are the name prefixes that only their owners may assert:
+// the Kubernetes API server grants rights by user and group names, and a
+// prefix such as "peering:" belongs to the module that names its subjects
+// with it. Dex serves one config, so the list is set once at startup.
+var reservedPrefixes atomic.Pointer[[]string]
+
+// SetReservedPrefixes sets the reserved name prefixes (the reservedNamePrefixes
+// of the Dex config). An empty list reserves nothing.
+func SetReservedPrefixes(prefixes []string) {
+	p := slices.Clone(prefixes)
+	reservedPrefixes.Store(&p)
+}
+
+// reservedNameUsed returns the first reserved prefix that the email or a group
+// of a user starts with outside the names the connector owns, or "".
+//
+// These are the names the API server takes: the user name from the email
+// claim and the groups. A connector owns the names that start with one of the
+// reservedPrefixes of its config lying under the reserved prefix: a peer
+// connector owns "peering:peer:moscow:", not all of "peering:", so it cannot
+// name the subjects of another peer. Only a token-exchange connector has
+// them, and only the user-authn controller writes that config.
+func reservedNameUsed(conn storage.Connector, email string, groups []string) string {
+	p := reservedPrefixes.Load()
+	if p == nil || len(*p) == 0 {
+		return ""
+	}
+
+	owned := ownedPrefixes(conn)
+	used := func(name string) string {
+		for _, prefix := range *p {
+			if prefix == "" || !strings.HasPrefix(name, prefix) {
+				continue
+			}
+			if !slices.ContainsFunc(owned, func(o string) bool {
+				return strings.HasPrefix(o, prefix) && strings.HasPrefix(name, o)
+			}) {
+				return prefix
+			}
+		}
+		return ""
+	}
+	if prefix := used(email); prefix != "" {
+		return prefix
+	}
+	for _, g := range groups {
+		if prefix := used(g); prefix != "" {
+			return prefix
+		}
+	}
+	return ""
+}
+
+// ownedPrefixes reads the owned prefixes from the config of a token-exchange
+// connector. A config that does not parse owns none.
+func ownedPrefixes(conn storage.Connector) []string {
+	if conn.Type != tokenexchange.Type {
+		return nil
+	}
+	var config struct {
+		ReservedPrefixes []string `json:"reservedPrefixes"`
+	}
+	if err := json.Unmarshal(conn.Config, &config); err != nil {
+		return nil
+	}
+	return config.ReservedPrefixes
+}
