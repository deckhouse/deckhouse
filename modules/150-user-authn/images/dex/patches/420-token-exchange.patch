@@ -0,0 +1,140 @@
+package server
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-jose/go-jose/v4"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector/tokenexchange"
+	"github.com/dexidp/dex/server/allowlist"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/storage"
+)
+
+// TestTokenExchangeConnectorFromStorage exchanges a service account token of
+// another cluster through a token-exchange connector that is written to
+// storage while the server runs, as the user-authn controller does.
+func TestTokenExchangeConnectorFromStorage(t *testing.T) {
+	allowlist.SetReservedPrefixes([]string{"system:", "peering:"})
+	t.Cleanup(func() { allowlist.SetReservedPrefixes(nil) })
+
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	jwks := jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: &key.PublicKey, KeyID: "moscow", Algorithm: "RS256", Use: "sig"}}}
+
+	ctx := t.Context()
+	httpServer, s := newTestServer(t, func(c *Config) {
+		require.NoError(t, c.Storage.CreateClient(ctx, storage.Client{
+			ID: "peering-receiver", Secret: "secret", AllowedConnectors: []string{"tep-moscow", "tep-unowned"},
+		}))
+		require.NoError(t, c.Storage.CreateClient(ctx, storage.Client{
+			ID: "kubernetes", Secret: "k8s", TrustedPeers: []string{"peering-receiver", "other"},
+		}))
+		// A client with no AllowedConnectors, as most clients are.
+		require.NoError(t, c.Storage.CreateClient(ctx, storage.Client{ID: "other", Secret: "other"}))
+	})
+	defer httpServer.Close()
+
+	createConnector := func(id string, reserved []string) {
+		config, err := json.Marshal(tokenexchange.Config{
+			Issuer:    "https://kubernetes.default.svc.cluster.local",
+			Keys:      tokenexchange.Keys{JWKS: &jwks},
+			Audiences: []tokenexchange.Audience{{Prefix: "peering.deckhouse.io/peer/b/"}},
+			Identity: tokenexchange.IdentityMapping{
+				Username: tokenexchange.ClaimMapping{Claim: "sub", Prefix: "peering:peer:moscow:"},
+				Groups: []tokenexchange.GroupMapping{{
+					Claim: "aud", TrimPrefix: "peering.deckhouse.io/peer/b/cap/", Prefix: "peering:peer:moscow:cap:",
+				}},
+			},
+			ReservedPrefixes: reserved,
+			Clients:          []string{"peering-receiver"},
+		})
+		require.NoError(t, err)
+		require.NoError(t, s.storage.CreateConnector(ctx, storage.Connector{
+			ID: id, Type: tokenexchange.Type, Name: id, Config: config,
+			GrantTypes: []string{oauth2.GrantTypeTokenExchange},
+		}))
+	}
+	createConnector("tep-moscow", []string{"peering:peer:moscow:", "peering:peer:moscow:cap:"})
+	createConnector("tep-unowned", nil)
+
+	subjectToken := signJWT(t, key, "moscow", map[string]any{
+		"iss": "https://kubernetes.default.svc.cluster.local",
+		"sub": "system:serviceaccount:d8-virtualization:virtualization-controller",
+		"aud": []string{"peering.deckhouse.io/peer/b/cap/virtualization"},
+		"exp": time.Now().Add(10 * time.Minute).Unix(),
+	})
+
+	exchange := func(connectorID string, clientCreds ...string) *httptest.ResponseRecorder {
+		clientID, clientSecret := "peering-receiver", "secret"
+		if len(clientCreds) == 2 {
+			clientID, clientSecret = clientCreds[0], clientCreds[1]
+		}
+		vals := url.Values{}
+		vals.Set("grant_type", oauth2.GrantTypeTokenExchange)
+		vals.Set("connector_id", connectorID)
+		vals.Set("scope", "openid email groups federated:id audience:server:client_id:kubernetes")
+		vals.Set("requested_token_type", oauth2.TokenTypeID)
+		vals.Set("subject_token_type", oauth2.TokenTypeID)
+		vals.Set("subject_token", subjectToken)
+		vals.Set("client_id", clientID)
+		vals.Set("client_secret", clientSecret)
+		rr := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, httpServer.URL+"/token", strings.NewReader(vals.Encode()))
+		req.Header.Set("content-type", "application/x-www-form-urlencoded")
+		s.ServeHTTP(rr, req)
+		return rr
+	}
+
+	rr := exchange("tep-moscow")
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	var res tokens.Response
+	require.NoError(t, json.NewDecoder(rr.Body).Decode(&res))
+	claims := jwtPayload(t, res.AccessToken)
+	require.Equal(t, "peering:peer:moscow:system:serviceaccount:d8-virtualization:virtualization-controller", claims["email"])
+	require.Equal(t, []any{"peering:peer:moscow:cap:virtualization"}, claims["groups"])
+	require.Contains(t, claims["aud"], "kubernetes")
+
+	// The same names through a connector that does not own the prefix.
+	rr = exchange("tep-unowned")
+	require.NotEqual(t, http.StatusOK, rr.Code, rr.Body.String())
+
+	// A client the connector does not name, though its AllowedConnectors is open.
+	rr = exchange("tep-moscow", "other", "other")
+	require.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+	require.Contains(t, rr.Body.String(), "Connector not allowed for this client.")
+}
+
+func signJWT(t *testing.T, key *rsa.PrivateKey, kid string, claims map[string]any) string {
+	t.Helper()
+	sig, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.RS256, Key: key}, (&jose.SignerOptions{}).WithHeader("kid", kid))
+	require.NoError(t, err)
+	payload, err := json.Marshal(claims)
+	require.NoError(t, err)
+	jws, err := sig.Sign(payload)
+	require.NoError(t, err)
+	token, err := jws.CompactSerialize()
+	require.NoError(t, err)
+	return token
+}
+
+// jwtPayload decodes the claims of a token without verifying it: the test
+// checks what Dex issued, not its signature.
+func jwtPayload(t *testing.T, token string) map[string]any {
+	t.Helper()
+	jws, err := jose.ParseSigned(token, []jose.SignatureAlgorithm{jose.RS256, jose.ES256})
+	require.NoError(t, err)
+	var claims map[string]any
+	require.NoError(t, json.Unmarshal(jws.UnsafePayloadWithoutVerification(), &claims))
+	return claims
+}
