+func TestTokenIdentityLifetime(t *testing.T) {
+	key := newSigner(t, "k")
+	now := time.Now()
+	claims := func(iat, exp time.Duration) map[string]any {
+		c := saClaims("peering.deckhouse.io/peer/b-uuid/cap/virtualization")
+		c["iat"] = now.Add(iat).Unix()
+		c["exp"] = now.Add(exp).Unix()
+		return c
+	}
+	noIat := func(exp time.Duration) map[string]any {
+		c := claims(0, exp)
+		delete(c, "iat")
+		return c
+	}
+
+	tests := []struct {
+		name     string
+		lifetime string
+		claims   map[string]any
+		errText  string
+	}{
+		{name: "default limit, 24h", claims: claims(0, 24*time.Hour)},
+		{name: "default limit, longer than 24h", claims: claims(0, 24*time.Hour+time.Second), errText: "longer than 24h0m0s"},
+		{name: "issued long ago", claims: claims(-23*time.Hour, 2*time.Hour), errText: "valid for 25h0m0s"},
+		{name: "no iat, expires within the limit", claims: noIat(23 * time.Hour)},
+		{name: "no iat, expires after the limit", claims: noIat(25 * time.Hour), errText: "longer than 24h0m0s"},
+		{name: "iat in the future", claims: claims(10*365*24*time.Hour, 10*365*24*time.Hour+time.Hour), errText: "longer than 24h0m0s"},
+		{name: "iat a little ahead of the clock", claims: claims(time.Minute, time.Hour)},
+		{name: "iat a little ahead, valid for the whole limit", claims: claims(5*time.Second, 5*time.Second+24*time.Hour)},
+		{name: "no exp", claims: func() map[string]any { c := claims(0, 0); delete(c, "exp"); return c }(), errText: "verify subject token"},
+		{name: "own limit", lifetime: "1h", claims: claims(0, 30*time.Minute)},
+		{name: "own limit, longer", lifetime: "1h", claims: claims(0, 2*time.Hour), errText: "longer than 1h0m0s"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			config := peeringConfig(key.publicJWKS())
+			config.SubjectTokenMaxLifetime = tc.lifetime
+			conn := open(t, config)
+			_, err := conn.TokenIdentity(t.Context(), subjectTokenTypeIDToken, key.sign(t, tc.claims))
+			if tc.errText == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorContains(t, err, tc.errText)
+		})
+	}
+}
