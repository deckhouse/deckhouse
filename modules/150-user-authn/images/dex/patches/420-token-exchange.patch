+		{name: "no kid, one key", jwks: moscow.publicJWKS(), token: signer{key: moscow.key}},
+		{name: "no kid, two keys", jwks: bothKeys, token: signer{key: spb.key}},
+		{name: "kid of the second key", jwks: bothKeys, token: spb},
+		{
