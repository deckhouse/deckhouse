+func TestPasswordLoginRequiresPasswordChange(t *testing.T) {
+	strong := "Str0ng-Passw0rd"
+	tests := []struct {
+		name     string
+		policy   *passwordpolicy.Policy
+		password string
+		update   func(*storage.Password)
+		reason   string
+	}{
+		{
+			name:     "forced by an administrator without a policy",
+			password: strong,
+			update:   func(p *storage.Password) { p.RequireResetHashOnNextSuccLogin = true },
+			reason:   "forced",
+		},
+		{
+			name:     "password breaks the complexity rules",
+			policy:   &passwordpolicy.Policy{Complexity: passwordpolicy.Rules{MinLength: 8, Number: true}},
+			password: "nonumbers",
+			reason:   "complexity",
+		},
+		{
+			name:     "password is older than the rotation interval",
+			policy:   &passwordpolicy.Policy{RotationInterval: 24 * time.Hour},
+			password: strong,
+			update:   func(p *storage.Password) { p.HashUpdatedAt = time.Now().Add(-48 * time.Hour) },
+			reason:   "rotation",
+		},
+		{
+			name:     "nothing is due",
+			policy:   &passwordpolicy.Policy{Complexity: passwordpolicy.Rules{MinLength: 8}, RotationInterval: 24 * time.Hour},
+			password: strong,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newLocalLoginHandler(t, tc.policy, tc.password, tc.update)
+
+			rr := postPasswordLogin(s, "//evil.example", localUserEmail, tc.password)
+			require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+			location, err := url.Parse(rr.Header().Get("Location"))
+			require.NoError(t, err)
+			cookie := responseCookie(rr, passwordChangeCookie)
+
+			authReq, err := s.Storage.GetAuthRequest(t.Context(), localAuthReqID)
+			require.NoError(t, err)
+			if tc.reason == "" {
+				assert.NotEqual(t, PasswordChangePath, location.Path)
+				assert.True(t, authReq.LoggedIn)
+				assert.Nil(t, cookie)
+				assert.Empty(t, authReq.PasswordChangeBinding)
+				return
+			}
+
+			assert.False(t, authReq.LoggedIn, "the login waits for the password change")
+			assert.Equal(t, PasswordChangePath, location.Path)
+			q := location.Query()
+			assert.Equal(t, localAuthReqID, q.Get("req"))
+			assert.Equal(t, strings.ToLower(localUserEmail), q.Get("username"))
+			assert.Equal(t, tc.reason, q.Get("changeReason"))
+			assert.Equal(t, "on", q.Get("remember_me"), "the choice of the login form goes on")
+			assert.Empty(t, q.Get("back"), "the page leads nowhere but on with the login")
+			assert.True(t, verifyPasswordChange(authReq, q.Get("hmac"), q.Get("username")))
+
+			require.NotNil(t, cookie)
+			assert.True(t, cookie.HttpOnly)
+			assert.Equal(t, http.SameSiteLaxMode, cookie.SameSite)
+			assert.Equal(t, PasswordChangePath, cookie.Path, "the cookie goes to the page only")
+			assert.Positive(t, cookie.MaxAge)
+			assert.LessOrEqual(t, cookie.MaxAge, int(passwordChangeCookieTTL.Seconds()))
+			assert.NotContains(t, location.RawQuery, cookie.Value, "the URL does not carry the binding")
+			binding := sha256.Sum256([]byte(cookie.Value))
+			assert.Equal(t, binding[:], authReq.PasswordChangeBinding, "the auth request keeps only the hash")
+		})
+	}
+}
