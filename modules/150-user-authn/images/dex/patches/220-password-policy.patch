diff --git a/server/templates/passwordchange.go b/server/templates/passwordchange.go
new file mode 100644
index 00000000..a3c4ff35
--- /dev/null
+++ b/server/templates/passwordchange.go
@@ -0,0 +1,84 @@
+package templates
+
+import "net/http"
+
+// PasswordChangeError is what was wrong with the last submission of the password
+// change page.
+type PasswordChangeError int
+
+const (
+	// PasswordChangeNoError: nothing was submitted yet.
+	PasswordChangeNoError PasswordChangeError = iota
+	// PasswordChangeTooWeak: the new password breaks a complexity rule.
+	PasswordChangeTooWeak
+	// PasswordChangeUnchanged: the new password equals the current one.
+	PasswordChangeUnchanged
+	// PasswordChangeReused: the new password is one of the previous ones.
+	PasswordChangeReused
+	// PasswordChangeRejected: the new password breaks another rule.
+	PasswordChangeRejected
+)
+
+// PasswordChange is the content of the password change page.
+type PasswordChange struct {
+	Username string
+	// Reason is why the change is due: "complexity", "rotation" or "forced". The
+	// page words it for the user.
+	Reason string
+	// Hint describes the complexity rules of a new password.
+	Hint  string
+	Error PasswordChangeError
+	// BrokenRule words the rule a PasswordChangeTooWeak password breaks.
+	BrokenRule string
+}
+
+// PasswordChange renders the password change page. The page posts back to the
+// request URI, query included, which carries the verified login it belongs to;
+// that URI is ReqPath, as the page of the v2.44-based Deckhouse dex had it, and
+// PostURL. A refused new password answers 400.
+func (t *Templates) PasswordChange(r *http.Request, w http.ResponseWriter, p PasswordChange) error {
+	type tooWeak struct {
+		Exists      bool
+		Description string
+	}
+	data := struct {
+		PostURL  string
+		Username string
+		Reason   string
+		Error    struct {
+			Exists bool
+			List   struct {
+				OldAndNewPassAreEqual bool
+				PasswordTooWeak       tooWeak
+				ReusedPassword        bool
+			}
+		}
+		PasswordPolicy struct {
+			ComplexityRequirements string
+		}
+		ReqPath string
+	}{
+		PostURL:  r.URL.RequestURI(),
+		Username: p.Username,
+		ReqPath:  r.URL.RequestURI(),
+	}
+
+	data.Reason = p.Reason
+	data.PasswordPolicy.ComplexityRequirements = p.Hint
+
+	data.Error.Exists = p.Error != PasswordChangeNoError
+	switch p.Error {
+	case PasswordChangeTooWeak:
+		data.Error.List.PasswordTooWeak = tooWeak{Exists: true, Description: p.BrokenRule}
+	case PasswordChangeUnchanged:
+		data.Error.List.OldAndNewPassAreEqual = true
+	case PasswordChangeReused:
+		data.Error.List.ReusedPassword = true
+	case PasswordChangeNoError, PasswordChangeRejected:
+		// No flag: the page shows a generic message for a rejected password.
+	}
+	if data.Error.Exists {
+		w.WriteHeader(http.StatusBadRequest)
+	}
+	return renderTemplate(w, t.passwordChangeTmpl, data)
+}
