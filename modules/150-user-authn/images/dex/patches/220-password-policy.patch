diff --git a/server/authflow/passwordchange.go b/server/authflow/passwordchange.go
new file mode 100644
index 00000000..34aa09a2
--- /dev/null
+++ b/server/authflow/passwordchange.go
@@ -0,0 +1,414 @@
+package authflow
+
+// passwordchange.go is the password change step of a local user's login. When the
+// password policy requires a new password, the password form sends the user to
+// the password change page instead of completing the login. The page asks for a
+// new password, checks it against the policy, stores it and completes the login
+// it belongs to: the flow goes on to the second factor, the consent screen and
+// the response to the client, as after the password form.
+//
+// The page belongs to the login that sent the user there and to the browser that
+// login came from:
+//
+//   - its URL carries the auth request and the user that login verified, under
+//     an HMAC of the request's key;
+//   - the login sets a short-lived cookie with a random value, limited to the
+//     page, and keeps the hash of the value on the auth request. The page opens
+//     only for that cookie, and a successful change clears both, so the cookie
+//     serves once. The auth request ends the binding with it.
+//
+// The URL alone, which passes through the browser history and the access logs of
+// the ingress, opens nothing. So the page does not ask for the current password
+// again: the login form has just checked it.
+//
+// When the login has a second factor to pass, the page waits for it: the password
+// form finalizes the login without a session and keeps the page on the auth
+// request (PendingPasswordChange), and the dispatcher opens it once the second
+// factor is done. Someone who knows only the password cannot set a new one and
+// keep the owner out. Without a second factor the page opens at once.
+//
+// The page changes no other user's password, serves no login that is already
+// complete, and continues only its auth request, whose redirect URI was checked
+// when the request was made. The page of the v2.44-based Deckhouse dex
+// redirected to any "back" address and served any user named in the query
+// outside a login.
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/subtle"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"golang.org/x/crypto/bcrypt"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/passwordpolicy"
+	"github.com/dexidp/dex/server/templates"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/storage"
+)
+
+// PasswordChangePath is the route of the password change page.
+const PasswordChangePath = "/password/change"
+
+// passwordChangeStep names what the HMAC of a password change URL protects: the
+// change of one user's password within one auth request.
+const passwordChangeStep = "step:password-change"
+
+// passwordChangeCookie is the cookie that binds the password change page to the
+// browser of the login, and passwordChangeCookieTTL its longest life: the end of
+// the auth request comes first when it is sooner.
+const (
+	passwordChangeCookie    = "dex_password_change"
+	passwordChangeCookieTTL = 10 * time.Minute
+)
+
+func signPasswordChange(authReq storage.AuthRequest, username string) string {
+	return internal.ComputeHMAC(authReq.HMACKey, authReq.ID, passwordChangeStep, username)
+}
+
+func verifyPasswordChange(authReq storage.AuthRequest, mac, username string) bool {
+	return internal.VerifyHMAC(authReq.HMACKey, mac, authReq.ID, passwordChangeStep, username)
+}
+
+// passwordChangeRedirect returns the URL of the password change page when the
+// login of the local user username in authReq must change the password before it
+// completes, and "" when it need not. When it returns a URL it has bound the page
+// to the browser w answers. typed is the password the user has just logged in
+// with; a login that typed none passes nil. rememberMe is the choice of the login
+// form, for the session the page creates.
+//
+// It is the one place where a login applies the password policy: the password
+// form asks it, and so must every other login path of a local user.
+func (h *Handler) passwordChangeRedirect(ctx context.Context, w http.ResponseWriter, authReq storage.AuthRequest, username string, typed *string, rememberMe bool) (string, error) {
+	username = strings.ToLower(username)
+	stored, err := h.Storage.GetPassword(ctx, username)
+	switch {
+	case errors.Is(err, storage.ErrNotFound):
+		return "", nil
+	case err != nil:
+		return "", fmt.Errorf("get password: %w", err)
+	}
+
+	reason := h.PasswordPolicy.ChangeReason(stored, typed, h.Now())
+	if reason == passwordpolicy.ReasonNone {
+		return "", nil
+	}
+	if err := h.bindPasswordChange(ctx, w, authReq); err != nil {
+		return "", err
+	}
+	h.Logger.InfoContext(ctx, "password change required",
+		"connector_id", authReq.ConnectorID, "user_id", stored.UserID, "reason", reason)
+
+	q := url.Values{
+		"req":          {authReq.ID},
+		"hmac":         {signPasswordChange(authReq, username)},
+		"username":     {username},
+		"changeReason": {string(reason)},
+	}
+	if rememberMe {
+		q.Set("remember_me", "on")
+	}
+	return h.IssuerURL.AbsPath(PasswordChangePath) + "?" + q.Encode(), nil
+}
+
+// deferPasswordChange keeps the password change page changeURL of authReq for
+// after the second factor when the login has one to pass, and reports whether it
+// did. A storage that does not keep the page on the auth request would let the
+// login skip the change, so the page opens at once there.
+func (h *Handler) deferPasswordChange(ctx context.Context, authReq storage.AuthRequest, changeURL string) (bool, error) {
+	outstanding, err := h.mfaOutstanding(ctx, authReq)
+	if err != nil || !outstanding {
+		return false, err
+	}
+	err = h.Storage.UpdateAuthRequest(ctx, authReq.ID, func(a storage.AuthRequest) (storage.AuthRequest, error) {
+		a.PendingPasswordChange = changeURL
+		return a, nil
+	})
+	if err != nil {
+		return false, fmt.Errorf("keep the password change for after the second factor: %w", err)
+	}
+	stored, err := h.Storage.GetAuthRequest(ctx, authReq.ID)
+	if err != nil {
+		return false, fmt.Errorf("get auth request: %w", err)
+	}
+	return stored.PendingPasswordChange == changeURL, nil
+}
+
+// mfaOutstanding reports whether authReq still has a second factor to pass: the
+// dispatcher would send it to the MFA entry.
+func (h *Handler) mfaOutstanding(ctx context.Context, authReq storage.AuthRequest) (bool, error) {
+	if !h.MFAEnabled || authReq.MFAValidated {
+		return false, nil
+	}
+	required, err := h.mfaRequired(ctx, authReq.ClientID)
+	if err != nil {
+		return false, fmt.Errorf("get the MFA requirement of the client: %w", err)
+	}
+	return required, nil
+}
+
+// bindPasswordChange binds the password change page of authReq to the browser w
+// answers: a random value goes into a cookie limited to the page, its hash onto
+// the auth request.
+func (h *Handler) bindPasswordChange(ctx context.Context, w http.ResponseWriter, authReq storage.AuthRequest) error {
+	value := rand.Text()
+	binding := sha256.Sum256([]byte(value))
+	err := h.Storage.UpdateAuthRequest(ctx, authReq.ID, func(a storage.AuthRequest) (storage.AuthRequest, error) {
+		a.PasswordChangeBinding = binding[:]
+		return a, nil
+	})
+	if err != nil {
+		return fmt.Errorf("bind the password change to the browser: %w", err)
+	}
+
+	ttl := min(passwordChangeCookieTTL, authReq.Expiry.Sub(h.Now()))
+	http.SetCookie(w, h.passwordChangeCookie(value, max(int(ttl.Seconds()), 1)))
+	return nil
+}
+
+// unbindPasswordChange ends the binding of the page of authReq after a change,
+// so that the cookie does not serve again, and the change the login put off.
+func (h *Handler) unbindPasswordChange(ctx context.Context, w http.ResponseWriter, authReq storage.AuthRequest) error {
+	err := h.Storage.UpdateAuthRequest(ctx, authReq.ID, func(a storage.AuthRequest) (storage.AuthRequest, error) {
+		a.PasswordChangeBinding = nil
+		a.PendingPasswordChange = ""
+		return a, nil
+	})
+	if err != nil {
+		return fmt.Errorf("unbind the password change: %w", err)
+	}
+	http.SetCookie(w, h.passwordChangeCookie("", -1))
+	return nil
+}
+
+func (h *Handler) passwordChangeCookie(value string, maxAge int) *http.Cookie {
+	return &http.Cookie{
+		Name:     passwordChangeCookie,
+		Value:    value,
+		Path:     h.IssuerURL.AbsPath(PasswordChangePath),
+		MaxAge:   maxAge,
+		HttpOnly: true,
+		// As the session cookie of upstream: always in Deckhouse, whose issuer is
+		// HTTPS; a browser would not send a secure cookie to an HTTP issuer.
+		Secure:   h.IssuerURL.Scheme == "https",
+		SameSite: http.SameSiteLaxMode,
+	}
+}
+
+// boundToBrowser reports whether r carries the cookie the page of authReq is
+// bound to.
+func boundToBrowser(r *http.Request, authReq storage.AuthRequest) bool {
+	cookie, err := r.Cookie(passwordChangeCookie)
+	if err != nil || len(authReq.PasswordChangeBinding) == 0 {
+		return false
+	}
+	presented := sha256.Sum256([]byte(cookie.Value))
+	return subtle.ConstantTimeCompare(presented[:], authReq.PasswordChangeBinding) == 1
+}
+
+// handlePasswordChange serves the password change page: GET shows the form, POST
+// stores the new password and completes the login.
+func (h *Handler) handlePasswordChange(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	if r.Method != http.MethodGet && r.Method != http.MethodPost {
+		h.renderError(r, w, http.StatusBadRequest, "Unsupported request method.")
+		return
+	}
+
+	authReq, err := h.Storage.GetAuthRequest(ctx, r.FormValue("req"))
+	switch {
+	case errors.Is(err, storage.ErrNotFound):
+		h.renderError(r, w, http.StatusBadRequest, "Requested resource does not exist.")
+		return
+	case err != nil:
+		h.Logger.ErrorContext(ctx, "failed to get auth request", "err", err)
+		h.renderError(r, w, http.StatusInternalServerError, "Database error.")
+		return
+	}
+	username := strings.ToLower(r.FormValue("username"))
+	// The answer does not say which binding failed.
+	if !verifyPasswordChange(authReq, r.FormValue("hmac"), username) || !boundToBrowser(r, authReq) {
+		h.Logger.WarnContext(ctx, "password change refused: request not bound to the login",
+			"connector_id", authReq.ConnectorID, "client_id", authReq.ClientID)
+		h.renderError(r, w, http.StatusUnauthorized, "Unauthorized request.")
+		return
+	}
+	deferred := authReq.PendingPasswordChange != ""
+	if authReq.LoggedIn && !deferred {
+		// The login the page belongs to is complete.
+		h.renderError(r, w, http.StatusBadRequest, "Login process already finalized.")
+		return
+	}
+	if deferred {
+		outstanding, err := h.mfaOutstanding(ctx, authReq)
+		if err != nil {
+			h.Logger.ErrorContext(ctx, "failed to check the second factor of the login", "err", err)
+			h.renderError(r, w, http.StatusInternalServerError, ErrMsgLoginError)
+			return
+		}
+		if outstanding || !authReq.LoggedIn {
+			h.Logger.WarnContext(ctx, "password change refused: the second factor of the login is not done",
+				"connector_id", authReq.ConnectorID, "client_id", authReq.ClientID)
+			h.renderError(r, w, http.StatusUnauthorized, "Unauthorized request.")
+			return
+		}
+	}
+
+	conn, err := h.Connectors.Get(ctx, authReq.ConnectorID)
+	if err != nil {
+		h.Logger.ErrorContext(ctx, "failed to get connector", "connector_id", authReq.ConnectorID, "err", err)
+		h.renderError(r, w, http.StatusInternalServerError, "Connector failed to initialize.")
+		return
+	}
+	refresher, ok := conn.Connector.(connector.RefreshConnector)
+	if !ok || conn.Type != connectors.LocalConnector {
+		h.Logger.ErrorContext(ctx, "password change for a connector other than the local one", "connector_id", authReq.ConnectorID)
+		h.renderError(r, w, http.StatusBadRequest, "Requested resource does not exist.")
+		return
+	}
+
+	page := templates.PasswordChange{
+		Username: username,
+		Reason:   string(passwordpolicy.ParseReason(r.FormValue("changeReason"))),
+		Hint:     h.PasswordPolicy.Hint(),
+	}
+	if r.Method == http.MethodGet {
+		h.renderPasswordChange(w, r, page)
+		return
+	}
+
+	stored, err := h.Storage.GetPassword(ctx, username)
+	if err != nil {
+		h.Logger.ErrorContext(ctx, "failed to get password", "err", err)
+		h.renderError(r, w, http.StatusInternalServerError, ErrMsgLoginError)
+		return
+	}
+	if !h.changePassword(w, r, authReq.ConnectorID, page, stored) {
+		return
+	}
+	if err := h.unbindPasswordChange(ctx, w, authReq); err != nil {
+		h.Logger.ErrorContext(ctx, "failed to unbind the password change", "err", err)
+		h.renderError(r, w, http.StatusInternalServerError, ErrMsgLoginError)
+		return
+	}
+
+	// A deferred change belongs to a login the password form finalized before its
+	// second factor; any other is finalized here.
+	if !deferred {
+		// The login form verified the password; the identity is what the local
+		// connector holds for the user now that the new one is stored.
+		identity, err := refresher.Refresh(ctx, tokens.ParseScopes(authReq.Scopes), connector.Identity{
+			UserID: stored.UserID,
+			Email:  stored.Email,
+		})
+		if err != nil {
+			h.Logger.ErrorContext(ctx, "failed to read the user of the password change", "connector_id", authReq.ConnectorID, "err", err)
+			h.renderError(r, w, http.StatusInternalServerError, ErrMsgLoginError)
+			return
+		}
+
+		// The new password is stored first, so a login that fails from here on
+		// cannot skip the change.
+		authReq, err = h.finalizeLogin(ctx, identity, authReq, conn.Connector)
+		if err != nil {
+			if h.renderNotAllowed(r, w, err) {
+				return
+			}
+			h.Logger.ErrorContext(ctx, "failed to finalize login", "err", err)
+			h.renderError(r, w, http.StatusInternalServerError, "Login error.")
+			return
+		}
+	}
+	if err := h.Sessions.CreateOrUpdateAuthSession(ctx, r, w, authReq, r.FormValue("remember_me") == "on"); err != nil {
+		h.Logger.ErrorContext(ctx, "failed to create/update auth session", "err", err)
+	}
+	http.Redirect(w, r, h.buildContinueURL(authReq), http.StatusSeeOther)
+}
+
+// changePassword replaces the password of the stored user of page with the new
+// one the form posts, when the policy accepts it. Otherwise it answers the
+// request and reports false.
+func (h *Handler) changePassword(w http.ResponseWriter, r *http.Request, connectorID string, page templates.PasswordChange, stored storage.Password) bool {
+	ctx := r.Context()
+	next := r.PostFormValue("newPassword")
+
+	if err := h.PasswordPolicy.CheckNew(stored, next); err != nil {
+		page.Error, page.BrokenRule = passwordChangeError(err)
+		h.renderPasswordChange(w, r, page)
+		return false
+	}
+	hash, err := bcrypt.GenerateFromPassword([]byte(next), bcrypt.DefaultCost)
+	switch {
+	case errors.Is(err, bcrypt.ErrPasswordTooLong):
+		page.Error = templates.PasswordChangeRejected
+		h.renderPasswordChange(w, r, page)
+		return false
+	case err != nil:
+		h.Logger.ErrorContext(ctx, "failed to hash the new password", "err", err)
+		h.renderError(r, w, http.StatusInternalServerError, ErrMsgLoginError)
+		return false
+	}
+
+	if err := h.storePassword(ctx, page.Username, hash); err != nil {
+		h.Logger.ErrorContext(ctx, "failed to update password", "err", err)
+		h.renderError(r, w, http.StatusInternalServerError, ErrMsgLoginError)
+		return false
+	}
+	h.Logger.InfoContext(ctx, "password changed", "connector_id", connectorID, "user_id", stored.UserID)
+	return true
+}
+
+// passwordUpdateAttempts bounds the tries of the write of a new password. Any
+// other write of the Password object between the read and the write makes it
+// conflict, a failed login of the user on another replica counting on it (230)
+// among them, and the kubernetes storage does not retry a conflicting write of a
+// Password.
+const passwordUpdateAttempts = 5
+
+// storePassword stores hash as the new password of username, trying a failed
+// write again on what is stored by then.
+func (h *Handler) storePassword(ctx context.Context, username string, hash []byte) error {
+	update := func(p storage.Password) (storage.Password, error) {
+		return h.PasswordPolicy.Changed(p, hash, h.Now()), nil
+	}
+	err := h.Storage.UpdatePassword(ctx, username, update)
+	for try := 1; err != nil && !errors.Is(err, storage.ErrNotFound) && try < passwordUpdateAttempts; try++ {
+		select {
+		case <-ctx.Done():
+			return err
+		case <-time.After(time.Duration(try) * 5 * time.Millisecond):
+		}
+		err = h.Storage.UpdatePassword(ctx, username, update)
+	}
+	return err
+}
+
+func (h *Handler) renderPasswordChange(w http.ResponseWriter, r *http.Request, page templates.PasswordChange) {
+	if err := h.Templates.PasswordChange(r, w, page); err != nil {
+		h.Logger.ErrorContext(r.Context(), "server template error", "err", err)
+	}
+}
+
+// passwordChangeError maps a refusal of passwordpolicy.CheckNew to the page.
+func passwordChangeError(err error) (templates.PasswordChangeError, string) {
+	var weak *passwordpolicy.WeakError
+	switch {
+	case errors.As(err, &weak):
+		return templates.PasswordChangeTooWeak, weak.Error()
+	case errors.Is(err, passwordpolicy.ErrUnchanged):
+		return templates.PasswordChangeUnchanged, ""
+	case errors.Is(err, passwordpolicy.ErrReused):
+		return templates.PasswordChangeReused, ""
+	default:
+		return templates.PasswordChangeRejected, ""
+	}
+}
