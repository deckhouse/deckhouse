+++ b/server/passwordpolicy/policy_test.go
@@ -0,0 +1,198 @@
+package passwordpolicy
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+
+	"github.com/dexidp/dex/storage"
+)
+
+func TestParseReason(t *testing.T) {
+	assert.Equal(t, ReasonForced, ParseReason("forced"))
+	assert.Equal(t, ReasonRotation, ParseReason("rotation"))
+	assert.Equal(t, ReasonComplexity, ParseReason("complexity"))
+	assert.Equal(t, ReasonNone, ParseReason("expired"))
+	assert.Equal(t, ReasonNone, ParseReason(""))
+}
+
+func TestLevel(t *testing.T) {
+	for _, name := range []string{"", "None", "custom"} {
+		rules, err := Level(name)
+		require.NoError(t, err, name)
+		assert.Equal(t, Rules{}, rules, name)
+	}
+
+	fair, err := Level("Fair")
+	require.NoError(t, err)
+	assert.Equal(t, Rules{MinLength: 8, Lowercase: true, Uppercase: true, Number: true}, fair)
+
+	_, err = Level("strong")
+	require.Error(t, err)
+}
+
+func TestRulesValidate(t *testing.T) {
+	excellent, err := Level("excellent")
+	require.NoError(t, err)
+
+	tests := []struct {
+		name     string
+		rules    Rules
+		password string
+		broken   string
+	}{
+		{"no rules accept anything", Rules{}, "", ""},
+		{"short", Rules{MinLength: 8}, "1234567", "minimum 8 characters required"},
+		{"length counts bytes", Rules{MinLength: 8}, "\u043f\u0430\u0440\u043e\u043b\u044c", ""},
+		{"no lowercase", Rules{Lowercase: true}, "ABC", "at least one lowercase letter required"},
+		{"no uppercase", Rules{Uppercase: true}, "abc", "at least one uppercase letter required"},
+		{"no number", Rules{Number: true}, "abc", "at least one number required"},
+		{"no special", Rules{Special: true}, "abc1", "at least one special character (!@#$ etc.) required"},
+		{"repeats", Rules{NoRepeats: true}, "abbbc", "password contains 3 or more identical characters in a row"},
+		{"two repeats are fine", Rules{NoRepeats: true}, "abbcc", ""},
+		{"excellent", excellent, "Abcd123!", ""},
+		{"excellent with repeats", excellent, "Abcd111!", "password contains 3 or more identical characters in a row"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			err := tc.rules.Validate(tc.password)
+			if tc.broken == "" {
+				assert.NoError(t, err)
+				return
+			}
+			assert.EqualError(t, err, tc.broken)
+		})
+	}
+}
+
+func TestHint(t *testing.T) {
+	var none *Policy
+	assert.Empty(t, none.Hint())
+	assert.Empty(t, (&Policy{}).Hint())
+
+	good, err := Level("good")
+	require.NoError(t, err)
+	assert.Equal(t, "Password must contain:\n"+
+		"• At least 8 characters\n"+
+		"• Upper and lowercase letters\n"+
+		"• At least one number\n"+
+		"• Special characters (!@#$%^&* etc.)",
+		(&Policy{Complexity: good}).Hint())
+}
+
+func TestChangeReason(t *testing.T) {
+	now := time.Date(2026, 10, 14, 12, 0, 0, 0, time.UTC)
+	weak, strong := "weak", "Str0ngPassword"
+	policy := &Policy{Complexity: Rules{MinLength: 8, Number: true}, RotationInterval: 24 * time.Hour}
+	fresh := storage.Password{HashUpdatedAt: now.Add(-time.Hour)}
+	old := storage.Password{HashUpdatedAt: now.Add(-25 * time.Hour)}
+	forced := storage.Password{HashUpdatedAt: now, RequireResetHashOnNextSuccLogin: true}
+
+	tests := []struct {
+		name   string
+		policy *Policy
+		stored storage.Password
+		typed  *string
+		want   Reason
+	}{
+		{"forced without a policy", nil, forced, &strong, ReasonForced},
+		{"forced comes first", policy, storage.Password{RequireResetHashOnNextSuccLogin: true}, &weak, ReasonForced},
+		{"nothing without a policy", nil, old, &weak, ReasonNone},
+		{"weak password", policy, fresh, &weak, ReasonComplexity},
+		{"no plaintext skips complexity", policy, fresh, nil, ReasonNone},
+		{"expired password", policy, old, &strong, ReasonRotation},
+		{"expired password without plaintext", policy, old, nil, ReasonRotation},
+		{"never set expires at once", policy, storage.Password{}, &strong, ReasonRotation},
+		{"no rotation", &Policy{}, old, &weak, ReasonNone},
+		{"nothing due", policy, fresh, &strong, ReasonNone},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, tc.policy.ChangeReason(tc.stored, tc.typed, now))
+		})
+	}
+}
+
+func TestCheckNew(t *testing.T) {
+	current, err := bcrypt.GenerateFromPassword([]byte("Same1password"), bcrypt.MinCost)
+	require.NoError(t, err)
+	previous, err := bcrypt.GenerateFromPassword([]byte("Old1password"), bcrypt.MinCost)
+	require.NoError(t, err)
+	stored := storage.Password{Hash: current, PreviousHashes: [][]byte{previous}}
+	policy := &Policy{Complexity: Rules{MinLength: 8, Number: true}}
+
+	assert.ErrorIs(t, policy.CheckNew(stored, "Same1password"), ErrUnchanged)
+	assert.ErrorIs(t, policy.CheckNew(stored, "New1 password"), ErrSpace)
+	assert.ErrorIs(t, policy.CheckNew(stored, "Old1password"), ErrReused)
+
+	var weak *WeakError
+	require.ErrorAs(t, policy.CheckNew(stored, "short1"), &weak)
+	assert.EqualError(t, weak, "minimum 8 characters required")
+
+	assert.NoError(t, policy.CheckNew(stored, "New1password"))
+
+	// Without a policy the current password and the history still count, the
+	// complexity does not.
+	var none *Policy
+	assert.NoError(t, none.CheckNew(stored, "x"))
+	assert.ErrorIs(t, none.CheckNew(stored, "Same1password"), ErrUnchanged)
+	assert.ErrorIs(t, none.CheckNew(stored, "Old1password"), ErrReused)
+}
+
+func TestCheckNewRefusesAnEmptyPassword(t *testing.T) {
+	// A stored empty password would let the login form accept an empty one, so
+	// no level allows it, not even one without rules, and neither does no policy.
+	empty, err := bcrypt.GenerateFromPassword(nil, bcrypt.MinCost)
+	require.NoError(t, err)
+	current, err := bcrypt.GenerateFromPassword([]byte("Same1password"), bcrypt.MinCost)
+	require.NoError(t, err)
+
+	policies := map[string]*Policy{"no policy": nil}
+	for _, name := range []string{"none", "low", "fair", "good", "excellent", "custom"} {
+		rules, err := Level(name)
+		require.NoError(t, err, name)
+		policies[name] = &Policy{Complexity: rules}
+	}
+	for name, policy := range policies {
+		t.Run(name, func(t *testing.T) {
+			assert.ErrorIs(t, policy.CheckNew(storage.Password{Hash: current}, ""), ErrEmpty)
+			// Refused before the comparison with the current password too.
+			assert.ErrorIs(t, policy.CheckNew(storage.Password{Hash: empty}, ""), ErrEmpty)
+		})
+	}
+}
+
+func TestChanged(t *testing.T) {
+	now := time.Date(2026, 10, 14, 12, 0, 0, 0, time.UTC)
+	h := func(s string) []byte { return []byte(s) }
+	stored := storage.Password{
+		Email: "jane@example.com", Hash: h("current"),
+		PreviousHashes:                  [][]byte{h("p1"), h("p2"), h("p3")},
+		RequireResetHashOnNextSuccLogin: true,
+	}
+
+	tests := []struct {
+		name    string
+		policy  *Policy
+		history [][]byte
+	}{
+		{"no policy keeps the history as is", nil, stored.PreviousHashes},
+		{"no history kept", &Policy{}, stored.PreviousHashes},
+		{"history within the limit", &Policy{HistoryLimit: 10}, [][]byte{h("p1"), h("p2"), h("p3"), h("current")}},
+		{"history trimmed to a lowered limit", &Policy{HistoryLimit: 2}, [][]byte{h("p3"), h("current")}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := tc.policy.Changed(stored, h("next"), now)
+			assert.Equal(t, h("next"), got.Hash)
+			assert.Equal(t, now, got.HashUpdatedAt)
+			assert.False(t, got.RequireResetHashOnNextSuccLogin)
+			assert.Equal(t, tc.history, got.PreviousHashes)
+			assert.Equal(t, "jane@example.com", got.Email)
+		})
+	}
+	assert.Equal(t, [][]byte{h("p1"), h("p2"), h("p3")}, stored.PreviousHashes, "the input is not modified")
+}
