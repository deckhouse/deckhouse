+// loginToPasswordChange logs the local user in with password and returns the
+// password change URL the login redirects to and the cookie it sets, as a
+// browser would keep them.
+func loginToPasswordChange(t *testing.T, s *testServer, password string) (string, *http.Cookie) {
+	t.Helper()
+	rr := postPasswordLogin(s, "", localUserEmail, password)
+	require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+	location, err := url.Parse(rr.Header().Get("Location"))
+	require.NoError(t, err)
+	require.Equal(t, PasswordChangePath, location.Path)
+	cookie := responseCookie(rr, passwordChangeCookie)
+	require.NotNil(t, cookie, "the login binds the page to the browser")
+	return location.RequestURI(), &http.Cookie{Name: cookie.Name, Value: cookie.Value}
+}
