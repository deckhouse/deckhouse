+// newLocalLoginHandler serves the login flow with the local connector, one local
+// user whose password is password, and an auth request for that connector.
+// update may change the stored password object before it is created, configure
+// the flow.
+func newLocalLoginHandler(t *testing.T, policy *passwordpolicy.Policy, password string, update func(*storage.Password), configure ...func(*testFlowConfig)) *testServer {
+	t.Helper()
+	httpServer, s := newTestHandler(t, func(c *testFlowConfig) {
+		c.PasswordPolicy = policy
+		for _, f := range configure {
+			f(c)
+		}
+	})
+	t.Cleanup(httpServer.Close)
+	ctx := t.Context()
+
+	require.NoError(t, s.Storage.CreateClient(ctx, storage.Client{
+		ID: "client", RedirectURIs: []string{localClientRedirect},
+	}))
+	require.NoError(t, s.Storage.CreateConnector(ctx, storage.Connector{
+		ID: "local", Type: connectors.LocalConnector, Name: "Email", ResourceVersion: "1",
+	}))
+	s.Connectors.Set("local", connectors.Connector{
+		Type: connectors.LocalConnector, ResourceVersion: "1", Connector: connectors.NewPasswordDB(s.Storage),
+	})
+
+	hash, err := bcrypt.GenerateFromPassword([]byte(password), bcrypt.DefaultCost)
+	require.NoError(t, err)
+	p := storage.Password{
+		Email: strings.ToLower(localUserEmail), Username: "jane", UserID: localUserID,
+		Hash: hash, HashUpdatedAt: time.Now(),
+	}
