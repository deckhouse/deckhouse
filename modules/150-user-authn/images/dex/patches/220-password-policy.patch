+func TestPasswordChange(t *testing.T) {
+	const current = "Curr3nt-password"
+	previous, err := bcrypt.GenerateFromPassword([]byte("Prev10us-password"), bcrypt.MinCost)
+	require.NoError(t, err)
+	policy := &passwordpolicy.Policy{
+		Complexity:   passwordpolicy.Rules{MinLength: 8, Number: true},
+		HistoryLimit: 2,
+	}
+	newHandler := func(t *testing.T) *testServer {
+		return newLocalLoginHandler(t, policy, current, func(p *storage.Password) {
+			p.RequireResetHashOnNextSuccLogin = true
+			p.PreviousHashes = [][]byte{previous}
+			p.HashUpdatedAt = time.Now().Add(-time.Hour)
+		})
+	}
+
+	refusals := []struct {
+		name     string
+		next     string
+		contains string
+	}{
+		{"weak new password", "weak", "minimum 8 characters required"},
+		{"unchanged password", current, "cannot be equal"},
+		{"previous password", "Prev10us-password", "previous passwords"},
+		{"empty new password", "", "Failed to change password"},
+		{"space in the new password", "N3w password", "Failed to change password"},
+		{"too long for bcrypt", "N3w-" + strings.Repeat("x", 80), "Failed to change password"},
+	}
+	for _, tc := range refusals {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newHandler(t)
+			target, cookie := loginToPasswordChange(t, s, current)
+			rr := serve(s, http.MethodPost, target, url.Values{"newPassword": {tc.next}}, cookie)
+			assert.Equal(t, http.StatusBadRequest, rr.Code)
+			assert.Contains(t, rr.Body.String(), tc.contains)
+
+			stored, err := s.Storage.GetPassword(t.Context(), localUserEmail)
+			require.NoError(t, err)
+			assert.NoError(t, bcrypt.CompareHashAndPassword(stored.Hash, []byte(current)), "the password is unchanged")
+			assert.True(t, stored.RequireResetHashOnNextSuccLogin)
+
+			// The binding holds until a change succeeds, so the user can try again.
+			rr = serve(s, http.MethodPost, target, url.Values{"newPassword": {"N3w-password"}}, cookie)
+			assert.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+		})
+	}
+
+	t.Run("changed", func(t *testing.T) {
+		s := newHandler(t)
+		before, err := s.Storage.GetPassword(t.Context(), localUserEmail)
+		require.NoError(t, err)
+
+		target, cookie := loginToPasswordChange(t, s, current)
+		rr := serve(s, http.MethodPost, target, url.Values{"newPassword": {"N3w-password"}}, cookie)
+		require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+		cleared := responseCookie(rr, passwordChangeCookie)
+		require.NotNil(t, cleared, "the browser drops the cookie")
+		assert.Negative(t, cleared.MaxAge)
+
+		stored, err := s.Storage.GetPassword(t.Context(), localUserEmail)
+		require.NoError(t, err)
+		assert.NoError(t, bcrypt.CompareHashAndPassword(stored.Hash, []byte("N3w-password")))
+		assert.Equal(t, [][]byte{previous, before.Hash}, stored.PreviousHashes)
+		assert.False(t, stored.RequireResetHashOnNextSuccLogin)
+		assert.WithinDuration(t, time.Now(), stored.HashUpdatedAt, time.Minute)
+
+		// The login the page belongs to is complete and goes on to the client.
+		authReq, err := s.Storage.GetAuthRequest(t.Context(), localAuthReqID)
+		require.NoError(t, err)
+		assert.True(t, authReq.LoggedIn)
+		assert.Equal(t, localUserID, authReq.Claims.UserID)
+		assert.Empty(t, authReq.PasswordChangeBinding, "the binding served once")
+		ui, err := s.Storage.GetUserIdentity(t.Context(), localUserID, "local")
+		require.NoError(t, err, "the login records the identity")
+		assert.False(t, ui.LastLogin.IsZero())
+
+		// The cookie does not serve again.
+		replay := serve(s, http.MethodPost, target, url.Values{"newPassword": {"An0ther-password"}}, cookie)
+		assert.Equal(t, http.StatusUnauthorized, replay.Code)
+		stored, err = s.Storage.GetPassword(t.Context(), localUserEmail)
+		require.NoError(t, err)
+		assert.NoError(t, bcrypt.CompareHashAndPassword(stored.Hash, []byte("N3w-password")))
+
+		location, err := url.Parse(rr.Header().Get("Location"))
+		require.NoError(t, err)
+		assert.Equal(t, s.IssuerURL.AbsPath("/auth"), location.Path)
+		rr = serve(s, http.MethodGet, location.RequestURI(), nil)
+		require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+		location, err = url.Parse(rr.Header().Get("Location"))
+		require.NoError(t, err)
+		assert.Equal(t, "client.example", location.Host)
+		assert.NotEmpty(t, location.Query().Get("code"))
+		assert.Equal(t, "client-state", location.Query().Get("state"))
+	})
+
+	t.Run("a conflicting write is tried again", func(t *testing.T) {
+		s := newHandler(t)
+		target, cookie := loginToPasswordChange(t, s, current)
+		conflicting := &conflictingPasswordWrite{Storage: s.Storage, conflicts: 2}
+		s.Storage = conflicting
+
+		rr := serve(s, http.MethodPost, target, url.Values{"newPassword": {"N3w-password"}}, cookie)
+		require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+
+		stored, err := conflicting.GetPassword(t.Context(), localUserEmail)
+		require.NoError(t, err)
+		assert.NoError(t, bcrypt.CompareHashAndPassword(stored.Hash, []byte("N3w-password")))
+		assert.Equal(t, uint64(2), stored.IncorrectPasswordLoginAttempts, "the writes that won are kept")
+	})
+
+	t.Run("the second factor comes first", func(t *testing.T) {
+		s := newLocalLoginHandler(t, policy, current, func(p *storage.Password) {
+			p.RequireResetHashOnNextSuccLogin = true
+		}, func(c *testFlowConfig) {
+			c.MFAProviders = map[string]mfa.Provider{"totp": mfa.NewTOTPProvider("test-issuer", nil)}
+			c.DefaultMFAChain = []string{"totp"}
+		})
+		redirectPath := func(rr *httptest.ResponseRecorder) *url.URL {
+			t.Helper()
+			require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+			location, err := url.Parse(rr.Header().Get("Location"))
+			require.NoError(t, err)
+			return location
+		}
+		unchanged := func(why string) {
+			t.Helper()
+			stored, err := s.Storage.GetPassword(t.Context(), localUserEmail)
+			require.NoError(t, err)
+			assert.NoError(t, bcrypt.CompareHashAndPassword(stored.Hash, []byte(current)), why)
+			assert.True(t, stored.RequireResetHashOnNextSuccLogin, why)
+		}
+
+		// The password form goes on to the second factor, not to the change page.
+		rr := postPasswordLogin(s, "", localUserEmail, current)
+		next := redirectPath(rr)
+		require.Equal(t, s.IssuerURL.AbsPath("/auth"), next.Path)
+		bound := responseCookie(rr, passwordChangeCookie)
+		require.NotNil(t, bound, "the login binds the page to the browser")
+		cookie := &http.Cookie{Name: bound.Name, Value: bound.Value}
+		authReq, err := s.Storage.GetAuthRequest(t.Context(), localAuthReqID)
+		require.NoError(t, err)
+		require.NotEmpty(t, authReq.PendingPasswordChange)
+		pending, err := url.Parse(authReq.PendingPasswordChange)
+		require.NoError(t, err)
+		assert.Equal(t, s.IssuerURL.AbsPath(PasswordChangePath), pending.Path)
+
+		// The page refuses the browser of the login until the second factor is done.
+		rr = serve(s, http.MethodPost, pending.RequestURI(), url.Values{"newPassword": {"N3w-password"}}, cookie)
+		assert.Equal(t, http.StatusUnauthorized, rr.Code)
+		unchanged("a login that passed only the password cannot change it")
+		assert.Equal(t, s.IssuerURL.AbsPath("/mfa"), redirectPath(serve(s, http.MethodGet, next.RequestURI(), nil)).Path)
+		ui, err := s.Storage.GetUserIdentity(t.Context(), localUserID, "local")
+		require.NoError(t, err)
+		assert.True(t, ui.LastLogin.IsZero(), "the login is not complete before the second factor")
+
+		// Once the second factor is done, the dispatcher opens the change page.
+		require.NoError(t, s.Storage.UpdateAuthRequest(t.Context(), localAuthReqID, func(a storage.AuthRequest) (storage.AuthRequest, error) {
+			a.MFAValidated = true
+			return a, nil
+		}))
+		assert.Equal(t, pending.RequestURI(), redirectPath(serve(s, http.MethodGet, next.RequestURI(), nil)).RequestURI())
+
+		rr = serve(s, http.MethodPost, pending.RequestURI(), url.Values{"newPassword": {"N3w-password"}}, cookie)
+		assert.Equal(t, s.IssuerURL.AbsPath("/auth"), redirectPath(rr).Path)
+		stored, err := s.Storage.GetPassword(t.Context(), localUserEmail)
+		require.NoError(t, err)
+		assert.NoError(t, bcrypt.CompareHashAndPassword(stored.Hash, []byte("N3w-password")))
+		authReq, err = s.Storage.GetAuthRequest(t.Context(), localAuthReqID)
+		require.NoError(t, err)
+		assert.Empty(t, authReq.PendingPasswordChange)
+		assert.Empty(t, authReq.PasswordChangeBinding)
+
+		// The login goes on to the client.
+		location := redirectPath(serve(s, http.MethodGet, next.RequestURI(), nil))
+		assert.Equal(t, "client.example", location.Host)
+		assert.NotEmpty(t, location.Query().Get("code"))
+	})
+
+	t.Run("continues only the login it belongs to", func(t *testing.T) {
+		s := newHandler(t)
+		target, cookie := loginToPasswordChange(t, s, current)
+		target += "&" + url.Values{"back": {"https://evil.example/"}, "redirect_uri": {"https://evil.example/"}}.Encode()
+		rr := serve(s, http.MethodPost, target, url.Values{"newPassword": {"N3w-password"}}, cookie)
+		require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+		location, err := url.Parse(rr.Header().Get("Location"))
+		require.NoError(t, err)
+		assert.Equal(t, s.IssuerURL.AbsPath("/auth"), location.Path)
+		assert.Equal(t, localAuthReqID, location.Query().Get("req"))
+		assert.NotContains(t, rr.Header().Get("Location"), "evil")
+	})
+
+	t.Run("an allow-list still refuses the user", func(t *testing.T) {
+		s := newHandler(t)
+		target, cookie := loginToPasswordChange(t, s, current)
+		require.NoError(t, s.Storage.UpdateClient(t.Context(), "client", func(c storage.Client) (storage.Client, error) {
+			c.AllowedEmails = []string{"someone.else@example.com"}
+			return c, nil
+		}))
+		rr := serve(s, http.MethodPost, target, url.Values{"newPassword": {"N3w-password"}}, cookie)
+		assert.Equal(t, http.StatusUnauthorized, rr.Code, rr.Body.String())
+		assert.Contains(t, rr.Body.String(), ErrMsgAccessDenied)
+		authReq, err := s.Storage.GetAuthRequest(t.Context(), localAuthReqID)
+		require.NoError(t, err)
+		assert.False(t, authReq.LoggedIn)
+	})
+
+	t.Run("a finished login is not served", func(t *testing.T) {
+		s := newHandler(t)
+		target, cookie := loginToPasswordChange(t, s, current)
+		require.NoError(t, s.Storage.UpdateAuthRequest(t.Context(), localAuthReqID, func(a storage.AuthRequest) (storage.AuthRequest, error) {
+			a.LoggedIn = true
+			return a, nil
+		}))
+		rr := serve(s, http.MethodPost, target, url.Values{"newPassword": {"N3w-password"}}, cookie)
+		assert.Equal(t, http.StatusBadRequest, rr.Code)
+		stored, err := s.Storage.GetPassword(t.Context(), localUserEmail)
+		require.NoError(t, err)
+		assert.True(t, stored.RequireResetHashOnNextSuccLogin, "the password is unchanged")
+	})
+}
+
+// conflictingPasswordWrite lets another writer win the first conflicts writes
+// of a Password: a failed login of the same user on another replica counts on
+// the object between the read and the write of the change, and the write
+// conflicts, as on the kubernetes storage.
+type conflictingPasswordWrite struct {
+	storage.Storage
+	conflicts int
+}
+
+var errPasswordConflict = errors.New("the object has been modified")
+
+func (s *conflictingPasswordWrite) UpdatePassword(ctx context.Context, email string, updater func(storage.Password) (storage.Password, error)) error {
+	if s.conflicts == 0 {
+		return s.Storage.UpdatePassword(ctx, email, updater)
+	}
+	s.conflicts--
+	err := s.Storage.UpdatePassword(ctx, email, func(p storage.Password) (storage.Password, error) {
+		p.IncorrectPasswordLoginAttempts++
+		return p, nil
+	})
+	if err != nil {
+		return err
+	}
+	return errPasswordConflict
+}
