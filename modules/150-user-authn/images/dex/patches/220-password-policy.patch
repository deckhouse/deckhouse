+++ b/cmd/dex/passwordpolicy_test.go
@@ -0,0 +1,96 @@
+package main
+
+import (
+	"testing"
+	"time"
+
+	"github.com/ghodss/yaml"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/passwordpolicy"
+)
+
+func TestParsePolicyDuration(t *testing.T) {
+	tests := []struct {
+		in   string
+		want time.Duration
+	}{
+		{"10s", 10 * time.Second},
+		{"5m", 5 * time.Minute},
+		{"1h", time.Hour},
+		{"3d", 72 * time.Hour},
+		{"1d12h", 36 * time.Hour},
+		{"2d3h4m5s", 51*time.Hour + 4*time.Minute + 5*time.Second},
+	}
+	for _, tc := range tests {
+		got, err := parsePolicyDuration(tc.in)
+		require.NoError(t, err, tc.in)
+		assert.Equal(t, tc.want, got, tc.in)
+	}
+
+	for _, in := range []string{"", "0s", "0d", "d", "1.5d", "-1d", "1dd", "1d-2d", "1dx", "99999999999999d", "forever"} {
+		_, err := parsePolicyDuration(in)
+		assert.Error(t, err, in)
+	}
+}
+
+// The passwordPolicy section as Deckhouse renders it (templates/dex/config.yaml).
+const deckhousePasswordPolicy = `
+passwordPolicy:
+  id: local
+  complexityLevel: "Custom"
+  custom:
+    minLength: 10
+    specialCharacters: true
+    numbers: false
+    capitalized: true
+    repeatedChars: true
+  passwordHistoryLimit: 5
+  rotation:
+    interval: "30d"
+  lockout:
+    maxAttempts: 3
+    lockDuration: "15m"
+    applyToConnectors:
+    - ldap
+    - atlassian-crowd
+`
+
+func TestPasswordPolicyConfig(t *testing.T) {
+	var c Config
+	require.NoError(t, yaml.Unmarshal([]byte(deckhousePasswordPolicy), &c))
+
+	policy, err := c.PasswordPolicy.serverPolicy()
+	require.NoError(t, err)
+	assert.Equal(t, &passwordpolicy.Policy{
+		Complexity:       passwordpolicy.Rules{MinLength: 10, Special: true, Uppercase: true, NoRepeats: true},
+		HistoryLimit:     5,
+		RotationInterval: 30 * 24 * time.Hour,
+	}, policy)
+}
+
+func TestPasswordPolicyServerPolicy(t *testing.T) {
+	str := func(s string) *string { return &s }
+
+	var none *PasswordPolicy
+	policy, err := none.serverPolicy()
+	require.NoError(t, err)
+	assert.Nil(t, policy)
+
+	policy, err = (&PasswordPolicy{}).serverPolicy()
+	require.NoError(t, err)
+	fair, err := passwordpolicy.Level("fair")
+	require.NoError(t, err)
+	assert.Equal(t, &passwordpolicy.Policy{Complexity: fair}, policy, "an unset level is fair")
+
+	policy, err = (&PasswordPolicy{ComplexityLevel: str("")}).serverPolicy()
+	require.NoError(t, err)
+	assert.Equal(t, &passwordpolicy.Policy{}, policy, "an empty level is none")
+
+	_, err = (&PasswordPolicy{ComplexityLevel: str("strong")}).serverPolicy()
+	require.Error(t, err)
+
+	_, err = (&PasswordPolicy{Rotation: &PasswordRotation{Interval: "never"}}).serverPolicy()
+	require.Error(t, err)
+}
