diff --git a/cmd/dex/passwordpolicy.go b/cmd/dex/passwordpolicy.go
new file mode 100644
index 00000000..b97f2d35
--- /dev/null
+++ b/cmd/dex/passwordpolicy.go
@@ -0,0 +1,116 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/dexidp/dex/server/passwordpolicy"
+)
+
+// PasswordPolicy is the passwordPolicy section of the config: the password policy
+// of local users, with the keys of the v2.44-based Deckhouse dex.
+type PasswordPolicy struct {
+	// ID is accepted for compatibility with the config of the v2.44-based
+	// Deckhouse dex, which required it, and is not used.
+	ID string `json:"id"`
+
+	// ComplexityLevel is none, low, fair, good, excellent or custom, in any case;
+	// empty is none. Unset means fair, as in the v2.44-based Deckhouse dex.
+	ComplexityLevel *string `json:"complexityLevel"`
+
+	// Custom are the complexity rules of the custom level. When set, they replace
+	// the rules of ComplexityLevel, whatever level it names.
+	Custom *PasswordComplexity `json:"custom"`
+
+	// PasswordHistoryLimit is the number of previous passwords a user cannot reuse.
+	PasswordHistoryLimit uint64 `json:"passwordHistoryLimit"`
+
+	// Rotation makes passwords expire.
+	Rotation *PasswordRotation `json:"rotation"`
+}
+
+// PasswordComplexity are custom complexity rules. Each flag adds a requirement.
+type PasswordComplexity struct {
+	MinLength         int  `json:"minLength"`
+	SpecialCharacters bool `json:"specialCharacters"`
+	Numbers           bool `json:"numbers"`
+	Capitalized       bool `json:"capitalized"`
+	// RepeatedChars forbids three or more identical characters in a row.
+	RepeatedChars bool `json:"repeatedChars"`
+}
+
+// PasswordRotation makes passwords expire.
+type PasswordRotation struct {
+	// Interval is how long a password lives, such as "90d" or "12h".
+	Interval string `json:"interval"`
+}
+
+// serverPolicy builds the password policy of the server, nil when the section is
+// absent.
+func (p *PasswordPolicy) serverPolicy() (*passwordpolicy.Policy, error) {
+	if p == nil {
+		return nil, nil
+	}
+
+	level := "fair"
+	if p.ComplexityLevel != nil {
+		level = *p.ComplexityLevel
+	}
+	rules, err := passwordpolicy.Level(level)
+	if err != nil {
+		return nil, err
+	}
+	if c := p.Custom; c != nil {
+		rules = passwordpolicy.Rules{
+			MinLength: c.MinLength,
+			Uppercase: c.Capitalized,
+			Number:    c.Numbers,
+			Special:   c.SpecialCharacters,
+			NoRepeats: c.RepeatedChars,
+		}
+	}
+
+	policy := &passwordpolicy.Policy{
+		Complexity:   rules,
+		HistoryLimit: p.PasswordHistoryLimit,
+	}
+	if p.Rotation != nil {
+		if policy.RotationInterval, err = parsePolicyDuration(p.Rotation.Interval); err != nil {
+			return nil, fmt.Errorf("rotation interval: %w", err)
+		}
+	}
+	return policy, nil
+}
+
+// parsePolicyDuration parses a positive duration that may start with a number of
+// days, such as "3d" or "1d12h". Deckhouse renders the durations of the password
+// policy in this form, which time.ParseDuration does not accept.
+func parsePolicyDuration(s string) (time.Duration, error) {
+	var d time.Duration
+	rest := s
+	if days, after, found := strings.Cut(s, "d"); found {
+		n, err := strconv.ParseInt(days, 10, 64)
+		if err != nil || n < 0 || n > math.MaxInt64/int64(24*time.Hour) {
+			return 0, fmt.Errorf("invalid duration %q", s)
+		}
+		d, rest = time.Duration(n)*24*time.Hour, after
+	}
+	if rest != "" {
+		r, err := time.ParseDuration(rest)
+		if err != nil {
+			return 0, fmt.Errorf("invalid duration %q", s)
+		}
+		if r > math.MaxInt64-d {
+			return 0, fmt.Errorf("invalid duration %q", s)
+		}
+		d += r
+	}
+	if d <= 0 {
+		return 0, errors.New("duration must be positive")
+	}
+	return d, nil
+}
