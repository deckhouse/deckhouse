diff --git a/server/passwordpolicy/policy.go b/server/passwordpolicy/policy.go
new file mode 100644
index 00000000..f5ec82ca
--- /dev/null
+++ b/server/passwordpolicy/policy.go
@@ -0,0 +1,273 @@
+// Package passwordpolicy is the password policy of local users, the users of the
+// built-in password database: complexity rules for a new password, a history of
+// previous passwords that cannot be reused, rotation after an interval, and the
+// change Password.RequireResetHashOnNextSuccLogin forces after a password reset.
+//
+// A login of a local user consults ChangeReason and, when a change is due, goes
+// to the password change page (server/authflow/passwordchange.go) instead of
+// completing; the page checks the new password with CheckNew and stores it with
+// Changed.
+package passwordpolicy
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+	"unicode"
+
+	"golang.org/x/crypto/bcrypt"
+
+	"github.com/dexidp/dex/storage"
+)
+
+// Reason says why a password must change before a login with it completes.
+type Reason string
+
+const (
+	// ReasonNone: the password need not change.
+	ReasonNone Reason = ""
+	// ReasonComplexity: the password does not meet the complexity rules.
+	ReasonComplexity Reason = "complexity"
+	// ReasonRotation: the password is older than the rotation interval.
+	ReasonRotation Reason = "rotation"
+	// ReasonForced: the stored password requires a change
+	// (RequireResetHashOnNextSuccLogin), as after a password reset.
+	ReasonForced Reason = "forced"
+)
+
+// ParseReason returns the reason named s, or ReasonNone for any other value.
+func ParseReason(s string) Reason {
+	if r := Reason(s); r == ReasonComplexity || r == ReasonRotation || r == ReasonForced {
+		return r
+	}
+	return ReasonNone
+}
+
+// Rules are the complexity rules a password must meet. The zero value accepts
+// any password.
+type Rules struct {
+	// MinLength is the minimum length in bytes; zero disables the rule. Bytes,
+	// not characters, as the v2.44-based Deckhouse dex counted them, so that a
+	// password it accepted does not start failing the rule.
+	MinLength int
+	// Lowercase requires a lowercase letter.
+	Lowercase bool
+	// Uppercase requires an uppercase letter.
+	Uppercase bool
+	// Number requires a digit.
+	Number bool
+	// Special requires a character that is neither a letter nor a digit.
+	Special bool
+	// NoRepeats forbids three or more identical characters in a row.
+	NoRepeats bool
+}
+
+var levels = map[string]Rules{
+	"none":      {},
+	"low":       {MinLength: 8},
+	"fair":      {MinLength: 8, Lowercase: true, Uppercase: true, Number: true},
+	"good":      {MinLength: 8, Lowercase: true, Uppercase: true, Number: true, Special: true},
+	"excellent": {MinLength: 8, Lowercase: true, Uppercase: true, Number: true, Special: true, NoRepeats: true},
+	// Custom starts with no rules; the configuration supplies them.
+	"custom": {},
+}
+
+// Level returns the rules of a predefined complexity level: none, low, fair,
+// good or excellent, in any case; an empty name is none. The level custom has no
+// rules of its own.
+func Level(name string) (Rules, error) {
+	if name == "" {
+		return Rules{}, nil
+	}
+	rules, ok := levels[strings.ToLower(name)]
+	if !ok {
+		return Rules{}, fmt.Errorf("unknown password complexity level %q", name)
+	}
+	return rules, nil
+}
+
+// Validate returns why password breaks the rules, or nil. The message is shown to
+// the user.
+func (r Rules) Validate(password string) error {
+	if r.MinLength > 0 && len(password) < r.MinLength {
+		return fmt.Errorf("minimum %d characters required", r.MinLength)
+	}
+
+	var hasLower, hasUpper, hasNumber, hasSpecial bool
+	var previous rune
+	run := 0
+	for _, c := range password {
+		if c == previous {
+			run++
+		} else {
+			run, previous = 1, c
+		}
+		if r.NoRepeats && run >= 3 {
+			return errors.New("password contains 3 or more identical characters in a row")
+		}
+
+		switch {
+		case unicode.IsLower(c):
+			hasLower = true
+		case unicode.IsUpper(c):
+			hasUpper = true
+		case unicode.IsNumber(c):
+			hasNumber = true
+		case !unicode.IsLetter(c):
+			hasSpecial = true
+		}
+	}
+
+	switch {
+	case r.Lowercase && !hasLower:
+		return errors.New("at least one lowercase letter required")
+	case r.Uppercase && !hasUpper:
+		return errors.New("at least one uppercase letter required")
+	case r.Number && !hasNumber:
+		return errors.New("at least one number required")
+	case r.Special && !hasSpecial:
+		return errors.New("at least one special character (!@#$ etc.) required")
+	}
+	return nil
+}
+
+// Hint describes the rules for the password change page, one rule per line, or
+// returns "" when there are none.
+func (r Rules) Hint() string {
+	lines := make([]string, 0, 6)
+	if r.MinLength > 0 {
+		lines = append(lines, fmt.Sprintf("• At least %d characters", r.MinLength))
+	}
+	switch {
+	case r.Lowercase && r.Uppercase:
+		lines = append(lines, "• Upper and lowercase letters")
+	case r.Uppercase:
+		lines = append(lines, "• At least one uppercase letter")
+	case r.Lowercase:
+		lines = append(lines, "• At least one lowercase letter")
+	}
+	if r.Number {
+		lines = append(lines, "• At least one number")
+	}
+	if r.Special {
+		lines = append(lines, "• Special characters (!@#$%^&* etc.)")
+	}
+	if r.NoRepeats {
+		lines = append(lines, "• No more than 2 identical characters in a row")
+	}
+	if len(lines) == 0 {
+		return ""
+	}
+	return "Password must contain:\n" + strings.Join(lines, "\n")
+}
+
+// Policy is the password policy of local users. A nil *Policy has no rules of its
+// own; a forced change applies all the same.
+type Policy struct {
+	// Complexity are the rules every password must meet. A login with a password
+	// that breaks them goes to the password change page.
+	Complexity Rules
+	// HistoryLimit is the number of replaced passwords kept to refuse their reuse;
+	// zero keeps none.
+	HistoryLimit uint64
+	// RotationInterval is how long a password lives before it must change; zero
+	// means it does not expire.
+	RotationInterval time.Duration
+}
+
+// ChangeReason reports why the stored password of a local user must change
+// before a login with it completes, or ReasonNone. typed is the password the user
+// has just logged in with; a login that typed none, such as one served from a
+// session, passes nil and skips the complexity rules, which need the plaintext.
+//
+// It is the one decision of the policy for a login: every login path of a local
+// user asks it.
+func (p *Policy) ChangeReason(stored storage.Password, typed *string, now time.Time) Reason {
+	switch {
+	case stored.RequireResetHashOnNextSuccLogin:
+		return ReasonForced
+	case p == nil:
+		return ReasonNone
+	case typed != nil && p.Complexity.Validate(*typed) != nil:
+		return ReasonComplexity
+	case p.RotationInterval > 0 && stored.HashUpdatedAt.Add(p.RotationInterval).Before(now):
+		return ReasonRotation
+	}
+	return ReasonNone
+}
+
+// Hint describes the complexity rules for the password change page.
+func (p *Policy) Hint() string {
+	if p == nil {
+		return ""
+	}
+	return p.Complexity.Hint()
+}
+
+var (
+	// ErrEmpty refuses an empty new password, whatever the complexity rules.
+	ErrEmpty = errors.New("passwordpolicy: new password is empty")
+	// ErrUnchanged refuses a new password equal to the current one.
+	ErrUnchanged = errors.New("passwordpolicy: new password equals the current one")
+	// ErrSpace refuses a new password with a space in it.
+	ErrSpace = errors.New("passwordpolicy: new password contains a space")
+	// ErrReused refuses a new password kept in the history.
+	ErrReused = errors.New("passwordpolicy: new password was used before")
+)
+
+// WeakError refuses a new password that breaks the complexity rules.
+type WeakError struct {
+	// Rule is the broken rule, as Rules.Validate words it for the user.
+	Rule error
+}
+
+func (e *WeakError) Error() string { return e.Rule.Error() }
+
+func (e *WeakError) Unwrap() error { return e.Rule }
+
+// CheckNew returns why next cannot replace the password of the stored user:
+// ErrEmpty, ErrSpace, a *WeakError, ErrUnchanged or ErrReused. An empty password
+// is refused with no policy and at every complexity level: the login form would
+// accept it afterwards. The current password and the history are checked last,
+// as every hash costs a bcrypt comparison.
+func (p *Policy) CheckNew(stored storage.Password, next string) error {
+	if next == "" {
+		return ErrEmpty
+	}
+	if strings.Contains(next, " ") {
+		return ErrSpace
+	}
+	if p != nil {
+		if err := p.Complexity.Validate(next); err != nil {
+			return &WeakError{Rule: err}
+		}
+	}
+	if bcrypt.CompareHashAndPassword(stored.Hash, []byte(next)) == nil {
+		return ErrUnchanged
+	}
+	for _, previous := range stored.PreviousHashes {
+		if bcrypt.CompareHashAndPassword(previous, []byte(next)) == nil {
+			return ErrReused
+		}
+	}
+	return nil
+}
+
+// Changed returns stored with its password replaced by hash at now: the old hash
+// joins the history when the policy keeps one, the history is trimmed to the
+// limit, and a forced change is done.
+func (p *Policy) Changed(stored storage.Password, hash []byte, now time.Time) storage.Password {
+	if p != nil && p.HistoryLimit > 0 {
+		history := append(make([][]byte, 0, len(stored.PreviousHashes)+1), stored.PreviousHashes...)
+		history = append(history, stored.Hash)
+		if n := uint64(len(history)); n > p.HistoryLimit {
+			history = history[n-p.HistoryLimit:]
+		}
+		stored.PreviousHashes = history
+	}
+	stored.Hash = hash
+	stored.HashUpdatedAt = now
+	stored.RequireResetHashOnNextSuccLogin = false
+	return stored
+}
