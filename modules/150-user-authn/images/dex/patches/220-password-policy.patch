+		ID: localAuthReqID, ClientID: "client", ConnectorID: "local",
+		ResponseTypes: []string{"code"}, Scopes: []string{"openid"}, RedirectURI: localClientRedirect,
+		State: "client-state", Expiry: time.Now().Add(time.Hour), HMACKey: []byte("0123456789abcdef0123456789abcdef"),
+	}))
+	return s
+}
