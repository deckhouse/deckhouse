+// TestRefreshStoreCreateMaxGrantsPerClient: the number of devices a user keeps
+// in one client is configured (Deckhouse).
+func TestRefreshStoreCreateMaxGrantsPerClient(t *testing.T) {
+	ctx := context.Background()
+	rt, store := newTestStore(t)
+	rt.MaxGrantsPerClient = 3
+	auth := testAuthorization()
+
+	first := createdID(t, rt, auth)
+	for range 3 {
