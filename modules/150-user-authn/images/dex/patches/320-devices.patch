+// DefaultMaxKnownDevices bounds the known devices of a pair unless configured
+// (Deckhouse): past it, the browser seen longest ago is forgotten.
+const DefaultMaxKnownDevices = 20
+
+// configuredKnownDevices is the configured bound plus one; zero, the value
+// before any SetMaxKnownDevices, stands for DefaultMaxKnownDevices.
+var configuredKnownDevices atomic.Int64
+
+// SetMaxKnownDevices sets how many browsers of a pair Dex remembers with their
+// first login (Deckhouse); 0 remembers none, and a login then forgets the ones
+// remembered before. It is a setting of the process: call it before serving.
+func SetMaxKnownDevices(n int) {
+	configuredKnownDevices.Store(int64(max(n, 0)) + 1)
