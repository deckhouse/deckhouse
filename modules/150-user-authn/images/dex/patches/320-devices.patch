+// returns known as it is when there is nothing to change: no hash, or a browser
+// seen at or after at. known is never changed in place.
+func rememberDevice(known []storage.KnownDevice, hash string, at time.Time) ([]storage.KnownDevice, bool) {
+	if hash == "" {
+		return known, false
+	}
+	limit := maxKnownDevices()
+	if limit == 0 {
+		return nil, len(known) > 0
+	}
+	i := slices.IndexFunc(known, func(d storage.KnownDevice) bool { return d.Hash == hash })
+	if i >= 0 && !known[i].LastSeen.Before(at) {
+		return known, false
+	}
+	out := slices.Clone(known)
+	if i >= 0 {
+		out[i].LastSeen = at
+		return out, true
+	}
+	out = append(out, storage.KnownDevice{Hash: hash, FirstSeen: at, LastSeen: at})
+	if len(out) > limit {
+		slices.SortStableFunc(out, func(a, b storage.KnownDevice) int { return b.LastSeen.Compare(a.LastSeen) })
+		out = out[:limit]
+	}
+	return out, true
