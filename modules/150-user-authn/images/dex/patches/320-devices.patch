+func TestRefreshStoreCreateProtectedGrantAge(t *testing.T) {
+	tests := []struct {
+		name         string
+		protectedAge time.Duration
+		ownerKept    bool
+	}{
+		{name: "an hour protects a device signed in two hours ago", protectedAge: time.Hour, ownerKept: true},
+		{name: "three hours do not", protectedAge: 3 * time.Hour, ownerKept: false},
+		{name: "zero protects none", protectedAge: 0, ownerKept: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			rt, store := newTestStore(t)
+			rt.ProtectedGrantAge = tt.protectedAge
+			auth := testAuthorization()
+
+			var ids []string
+			for i := 0; i < DefaultMaxGrantsPerClient; i++ {
+				ids = append(ids, createdID(t, rt, auth))
+			}
+			// The owner's device, signed in two hours ago and used longest ago of all.
+			require.NoError(t, store.UpdateOfflineSessions(ctx, "u1", "mock", func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+				old.Grants[ids[0]].CreatedAt = time.Now().Add(-2 * time.Hour)
+				old.Grants[ids[0]].LastUsed = time.Now().Add(-time.Hour)
+				return old, nil
+			}))
+
+			createdID(t, rt, auth)
+			sess, err := store.GetOfflineSessions(ctx, "u1", "mock")
+			require.NoError(t, err)
+			require.Len(t, sess.Grants, DefaultMaxGrantsPerClient)
+			if tt.ownerKept {
+				require.Contains(t, sess.Grants, ids[0])
+				require.NotContains(t, sess.Grants, ids[1])
+			} else {
+				require.NotContains(t, sess.Grants, ids[0])
+			}
+		})
+	}
+}
