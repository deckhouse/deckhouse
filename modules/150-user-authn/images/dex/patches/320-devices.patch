+}
+
+// TestRefreshStoreLegacyOfflineSession: an offline session written before Grants
+// keeps working, its grant is the one of Refresh (Deckhouse).
+func TestRefreshStoreLegacyOfflineSession(t *testing.T) {
+	ctx := context.Background()
+	rt, store := newTestStore(t)
+	auth := testAuthorization()
+	old := createdID(t, rt, auth)
+	require.NoError(t, store.UpdateOfflineSessions(ctx, "u1", "mock", func(o storage.OfflineSessions) (storage.OfflineSessions, error) {
+		o.Grants = nil
+		return o, nil
+	}))
+
+	newer := createdID(t, rt, auth)
+	sess, err := store.GetOfflineSessions(ctx, "u1", "mock")
+	require.NoError(t, err)
+	require.ElementsMatch(t, []string{old, newer}, grantIDs(sess))
+}
+
+func createdID(t *testing.T, rt *RefreshStore, auth Authorization) string {
+	t.Helper()
+	raw, err := rt.Create(context.Background(), auth)
+	require.NoError(t, err)
+	var tok internal.RefreshToken
+	require.NoError(t, internal.Unmarshal(raw, &tok))
+	return tok.RefreshId
+}
+
+func grantIDs(o storage.OfflineSessions) []string {
+	return slices.Sorted(maps.Keys(o.Grants))
