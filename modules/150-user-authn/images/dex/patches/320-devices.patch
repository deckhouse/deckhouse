@@ -0,0 +1,38 @@
+package reqctx
+
+import (
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// TestUserAgent: dex keeps at most maxUserAgent bytes of the User-Agent a client
+// sends, cut before a character the bound would split (Deckhouse).
+func TestUserAgent(t *testing.T) {
+	tests := []struct {
+		name     string
+		header   string
+		expected string
+	}{
+		{name: "short", header: "Mozilla/5.0", expected: "Mozilla/5.0"},
+		{name: "exactly the bound", header: strings.Repeat("a", maxUserAgent), expected: strings.Repeat("a", maxUserAgent)},
+		{name: "longer", header: strings.Repeat("a", maxUserAgent+100), expected: strings.Repeat("a", maxUserAgent)},
+		{
+			name:     "a character across the bound",
+			header:   strings.Repeat("a", maxUserAgent-1) + "é" + "tail",
+			expected: strings.Repeat("a", maxUserAgent-1),
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := httptest.NewRequest("GET", "/", nil)
+			r.Header.Set("User-Agent", tt.header)
+			got := UserAgent(r)
+			assert.Equal(t, tt.expected, got)
+			assert.True(t, utf8.ValidString(got))
+		})
+	}
+}
