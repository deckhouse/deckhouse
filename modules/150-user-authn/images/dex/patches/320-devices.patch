index 00000000..172af881
--- /dev/null
+++ b/cmd/dex/devices.go
@@ -0,0 +1,34 @@
+package main
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/dexidp/dex/server"
+)
+
+// serverConfig checks the device limits and converts them for the server
+// (Deckhouse). A nil config, or a field left out, keeps the default.
+func (d *Devices) serverConfig() (server.DevicesConfig, error) {
+	var out server.DevicesConfig
+	if d == nil {
+		return out, nil
+	}
+	if d.TrustedAfter != "" {
+		trustedAfter, err := time.ParseDuration(d.TrustedAfter)
+		if err != nil || trustedAfter < 0 {
+			return out, fmt.Errorf("trustedAfter %q is not a non-negative duration", d.TrustedAfter)
+		}
+		out.TrustedAfter = &trustedAfter
+	}
+	if d.MaxPerClient != nil {
+		if *d.MaxPerClient < 1 {
+			return out, fmt.Errorf("maxPerClient must be at least 1, got %d", *d.MaxPerClient)
+		}
+		out.MaxPerClient = *d.MaxPerClient
+	}
+	if d.MaxKnown != nil && *d.MaxKnown < 0 {
+		return out, fmt.Errorf("maxKnown must not be negative, got %d", *d.MaxKnown)
+	}
+	return out, nil
+}
diff --git a/cmd/dex/devices_test.go b/cmd/dex/devices_test.go
new file mode 100644
index 00000000..a9205c61
--- /dev/null
+++ b/cmd/dex/devices_test.go
@@ -0,0 +1,42 @@
+package main
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestDevicesServerConfig(t *testing.T) {
+	intp := func(n int) *int { return &n }
+	day, zero := 24*time.Hour, time.Duration(0)
+
+	tests := []struct {
+		name         string
+		devices      *Devices
+		trustedAfter *time.Duration
+		maxPerClient int
+		wantErr      string
+	}{
+		{name: "nil keeps the defaults"},
+		{name: "a day and five devices", devices: &Devices{TrustedAfter: "24h", MaxPerClient: intp(5)}, trustedAfter: &day, maxPerClient: 5},
+		{name: "trusted at once", devices: &Devices{TrustedAfter: "0s"}, trustedAfter: &zero},
+		{name: "no browser remembered", devices: &Devices{MaxKnown: intp(0)}},
+		{name: "a negative age", devices: &Devices{TrustedAfter: "-1h"}, wantErr: "trustedAfter"},
+		{name: "not a duration", devices: &Devices{TrustedAfter: "a day"}, wantErr: "trustedAfter"},
+		{name: "no device per client", devices: &Devices{MaxPerClient: intp(0)}, wantErr: "maxPerClient"},
+		{name: "a negative number of browsers", devices: &Devices{MaxKnown: intp(-1)}, wantErr: "maxKnown"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := tt.devices.serverConfig()
+			if tt.wantErr != "" {
+				require.ErrorContains(t, err, tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tt.trustedAfter, got.TrustedAfter)
+			require.Equal(t, tt.maxPerClient, got.MaxPerClient)
+		})
+	}
+}
