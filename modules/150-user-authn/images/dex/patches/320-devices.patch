diff --git a/server/devicemark/devicemark.go b/server/devicemark/devicemark.go
new file mode 100644
index 00000000..3ba24f46
--- /dev/null
+++ b/server/devicemark/devicemark.go
@@ -0,0 +1,91 @@
+// Package devicemark gives every browser that signs in to Dex a long-lived
+// random mark (Deckhouse), so that a device is as old as the first login of its
+// browser, not only its last one.
+//
+// The mark is a cookie of its own, separate from the session cookie: a logout
+// ends the session and clears its cookie, the mark stays. Dex keeps only the
+// SHA-256 hash of the mark: on the auth request, the code, the grant and the
+// browser session of a login, and in the known devices of the pair
+// (storage.UserIdentity.KnownDevices) once a login of the browser passed every
+// factor. The user-authn controller lists a device as known since the first
+// login of its browser; user-api lets a device act on the other devices and the
+// password 24 hours after that.
+//
+// A thief who signs in with a stolen password does so from a browser without
+// the mark of the owner, so the device is new. A mark copied from the owner's
+// browser is as good as the session cookie next to it, and the controller
+// forgets the browsers whose sign-in someone else ends.
+package devicemark
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"net/http"
+	"time"
+)
+
+const (
+	// cookieName is the mark over HTTPS: __Host- makes the browser take it only
+	// from Dex itself (secure, path /, no domain).
+	cookieName = "__Host-dex_device"
+	// insecureCookieName is the mark of a Dex served over plain HTTP (tests).
+	insecureCookieName = "dex_device"
+
+	// maxAge is how long the browser keeps the mark: the longest a browser
+	// accepts, renewed at every login of the browser.
+	maxAge = 400 * 24 * time.Hour
+
+	// markBytes is the entropy of a mark.
+	markBytes = 32
+)
+
+// markLength is the length of a mark in unpadded base64url.
+var markLength = base64.RawURLEncoding.EncodedLen(markBytes)
+
+// Hash returns the hash of the device mark of the browser of r, giving the
+// browser a new mark first when it has none or one that is malformed. The mark
+// is written again at every call, so it lives maxAge after the last login of
+// the browser. secure tells whether Dex is served over HTTPS. An empty result
+// means no mark could be made.
+func Hash(w http.ResponseWriter, r *http.Request, secure bool) string {
+	name := insecureCookieName
+	if secure {
+		name = cookieName
+	}
+	mark := ""
+	if c, err := r.Cookie(name); err == nil && valid(c.Value) {
+		mark = c.Value
+	}
+	if mark == "" {
+		buf := make([]byte, markBytes)
+		if _, err := rand.Read(buf); err != nil {
+			return ""
+		}
+		mark = base64.RawURLEncoding.EncodeToString(buf)
+	}
+	http.SetCookie(w, &http.Cookie{
+		Name:     name,
+		Value:    mark,
+		Path:     "/",
+		MaxAge:   int(maxAge.Seconds()),
+		HttpOnly: true,
+		Secure:   secure,
+		SameSite: http.SameSiteLaxMode,
+	})
+	return hashOf(mark)
+}
+
+// valid reports whether mark has the form of a mark Dex makes.
+func valid(mark string) bool {
+	if len(mark) != markLength {
+		return false
+	}
+	_, err := base64.RawURLEncoding.DecodeString(mark)
+	return err == nil
+}
+
+func hashOf(mark string) string {
+	sum := sha256.Sum256([]byte(mark))
+	return base64.RawURLEncoding.EncodeToString(sum[:])
+}
diff --git a/server/devicemark/devicemark_test.go b/server/devicemark/devicemark_test.go
new file mode 100644
index 00000000..d004151c
--- /dev/null
+++ b/server/devicemark/devicemark_test.go
@@ -0,0 +1,53 @@
+package devicemark
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func markOf(t *testing.T, rr *httptest.ResponseRecorder, name string) *http.Cookie {
+	t.Helper()
+	for _, c := range rr.Result().Cookies() {
+		if c.Name == name {
+			return c
+		}
+	}
+	t.Fatalf("no %s cookie in the response", name)
+	return nil
+}
+
+// TestHash: a browser without a mark gets one; a browser with a mark keeps it and
+// gets the same hash; a malformed mark is replaced.
+func TestHash(t *testing.T) {
+	rr := httptest.NewRecorder()
+	first := Hash(rr, httptest.NewRequest(http.MethodGet, "/auth/local", nil), true)
+	require.NotEmpty(t, first)
+	mark := markOf(t, rr, cookieName)
+	require.True(t, mark.HttpOnly)
+	require.True(t, mark.Secure)
+	require.Equal(t, "/", mark.Path)
+	require.Equal(t, int(maxAge.Seconds()), mark.MaxAge)
+	require.NotEqual(t, first, mark.Value, "the hash is not the mark")
+
+	again := httptest.NewRequest(http.MethodGet, "/auth/local", nil)
+	again.AddCookie(&http.Cookie{Name: cookieName, Value: mark.Value})
+	rr = httptest.NewRecorder()
+	require.Equal(t, first, Hash(rr, again, true))
+	require.Equal(t, mark.Value, markOf(t, rr, cookieName).Value, "the mark is kept and its lifetime renewed")
+
+	forged := httptest.NewRequest(http.MethodGet, "/auth/local", nil)
+	forged.AddCookie(&http.Cookie{Name: cookieName, Value: "short"})
+	rr = httptest.NewRecorder()
+	replaced := Hash(rr, forged, true)
+	require.NotEqual(t, hashOf("short"), replaced, "a malformed mark is replaced, not hashed")
+	require.NotEqual(t, "short", markOf(t, rr, cookieName).Value)
+}
+
+func TestHashOverHTTP(t *testing.T) {
+	rr := httptest.NewRecorder()
+	require.NotEmpty(t, Hash(rr, httptest.NewRequest(http.MethodGet, "/auth/local", nil), false))
+	require.False(t, markOf(t, rr, insecureCookieName).Secure)
+}
