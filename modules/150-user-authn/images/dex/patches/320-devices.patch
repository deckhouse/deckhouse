+
+// TestIntrospectionEndsWithTheGrant: once the revocation of a grant is recorded (the
+// device was signed out, its client revoked the refresh token, a newer sign-in
+// evicted it), the tokens issued with it are inactive though they have not expired
+// (Deckhouse).
+func TestIntrospectionEndsWithTheGrant(t *testing.T) {
+	_, s := newLockTestServer(t)
+	rr := passwordGrant(t, s)
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	var resp struct {
+		AccessToken string `json:"access_token"`
+	}
+	require.NoError(t, json.NewDecoder(rr.Body).Decode(&resp))
+	grantID, _ := decodeJWTClaims(t, resp.AccessToken)["d8_gid"].(string)
+	require.NotEmpty(t, grantID)
+
+	introspect := func() bool {
+		req := httptest.NewRequest(http.MethodPost, "/token/introspect", strings.NewReader(url.Values{"token": {resp.AccessToken}}.Encode()))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		req.SetBasicAuth("test", "barfoo")
+		rr := httptest.NewRecorder()
+		s.ServeHTTP(rr, req)
+		require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+		var got struct {
+			Active bool `json:"active"`
+		}
+		require.NoError(t, json.NewDecoder(rr.Body).Decode(&got))
+		return got.Active
+	}
+	require.True(t, introspect(), "a token of a live grant is active")
+
+	cacher, ok := s.storage.(*keyCacher)
+	require.True(t, ok)
+	creator, ok := storage.AsRevocationCreator(cacher.Storage)
+	require.True(t, ok)
+	require.NoError(t, creator.CreateRevocation(t.Context(), storage.Revocation{
+		Type: storage.RevocationGrant, GrantID: grantID, ClientID: "test", UserID: mockUserID, ConnectorID: "test",
+	}))
+	require.False(t, introspect(), "the revocation of its grant ends the token")
+}
+
+// browserLogin signs a browser with jar in to the client "test-client" through the
+// mock connector and returns the AuthSession it is left with.
+func browserLogin(t *testing.T, httpServer *httptest.Server, s *Server, jar http.CookieJar) storage.AuthSession {
+	t.Helper()
+	client := &http.Client{
+		Jar: jar,
+		CheckRedirect: func(req *http.Request, _ []*http.Request) error {
+			if !strings.HasPrefix(req.URL.String(), httpServer.URL) {
+				return http.ErrUseLastResponse
+			}
+			return nil
+		},
+	}
+	resp, err := client.Get(httpServer.URL + "/auth?" + url.Values{
+		"client_id":     {"test-client"},
+		"redirect_uri":  {"https://client.example/cb"},
+		"response_type": {"code"},
+		"scope":         {"openid offline_access"},
+		"state":         {"state-1"},
+		"connector_id":  {"mock"},
+	}.Encode())
+	require.NoError(t, err)
+	resp.Body.Close()
+	require.Equal(t, http.StatusSeeOther, resp.StatusCode, "the login ends with a code for the client")
+	require.Contains(t, resp.Header.Get("Location"), "code=")
+
+	u, err := url.Parse(httpServer.URL)
+	require.NoError(t, err)
+	var sid string
+	for _, c := range jar.Cookies(u) {
+		if c.Name == "dex_session" {
+			sid = c.Value
+		}
+	}
+	require.NotEmpty(t, sid, "the login left a session cookie")
+	sessions, err := s.storage.ListAuthSessions(t.Context())
+	require.NoError(t, err)
+	slices.SortFunc(sessions, func(a, b storage.AuthSession) int { return b.CreatedAt.Compare(a.CreatedAt) })
+	require.NotEmpty(t, sessions)
+	return sessions[0]
+}
+
+// TestDeviceMark: a browser keeps its device mark across a logout, so its next
+// login is of a known device, first seen at its first login; another browser is
+// another device (Deckhouse).
+func TestDeviceMark(t *testing.T) {
+	httpServer, s := newTestServerWithSessions(t, nil)
+	defer httpServer.Close()
+	ctx := t.Context()
+	require.NoError(t, s.storage.CreateClient(ctx, storage.Client{
+		ID: "test-client", Secret: "secret", RedirectURIs: []string{"https://client.example/cb"},
+	}))
+
+	jar, err := cookiejar.New(nil)
+	require.NoError(t, err)
+	first := browserLogin(t, httpServer, s, jar)
+	require.NotEmpty(t, first.DeviceHash, "the session carries the hash of the device mark")
+	identity, err := s.storage.GetUserIdentity(ctx, first.UserID, first.ConnectorID)
+	require.NoError(t, err)
+	require.Len(t, identity.KnownDevices, 1)
+	known := identity.KnownDevices[0]
+	require.Equal(t, first.DeviceHash, known.Hash)
+
+	// A logout ends the session; the mark stays in the browser.
+	require.NoError(t, s.storage.DeleteAuthSession(ctx, first.ID))
+	again := browserLogin(t, httpServer, s, jar)
+	require.NotEqual(t, first.ID, again.ID, "a new session")
+	require.Equal(t, first.DeviceHash, again.DeviceHash, "the same browser")
+	identity, err = s.storage.GetUserIdentity(ctx, first.UserID, first.ConnectorID)
+	require.NoError(t, err)
+	require.Len(t, identity.KnownDevices, 1)
+	require.True(t, known.FirstSeen.Equal(identity.KnownDevices[0].FirstSeen), "first seen at the first login")
+	require.False(t, identity.KnownDevices[0].LastSeen.Before(known.LastSeen))
+
+	otherJar, err := cookiejar.New(nil)
+	require.NoError(t, err)
+	other := browserLogin(t, httpServer, s, otherJar)
+	require.NotEqual(t, first.DeviceHash, other.DeviceHash, "another browser is another device")
+	identity, err = s.storage.GetUserIdentity(ctx, first.UserID, first.ConnectorID)
+	require.NoError(t, err)
+	require.Len(t, identity.KnownDevices, 2)
+}
+
+// TestPasswordGrantKeepsOneGrant: a client repeats the password grant for one
+// user (basic-auth-proxy), so its refresh token replaces the previous one instead
+// of adding a device (Deckhouse). The grant keeps the address of the client.
+func TestPasswordGrantKeepsOneGrant(t *testing.T) {
+	_, s := newLockTestServer(t)
+
+	for i := 0; i < 3; i++ {
+		rr := passwordGrant(t, s)
+		require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	}
+
+	offline, err := s.storage.GetOfflineSessions(t.Context(), mockUserID, "test")
+	require.NoError(t, err)
+	grants := tokens.GrantsOf(offline)
+	require.Len(t, grants, 1, "one grant for the client")
+	for id, ref := range grants {
+		assert.Equal(t, id, offline.Refresh["test"].ID)
+		assert.Equal(t, "192.0.2.1", ref.IPAddress, "the address of the client of the token request")
+		refresh, err := s.storage.GetRefresh(t.Context(), id)
+		require.NoError(t, err)
+		assert.Equal(t, "192.0.2.1", refresh.IPAddress)
+	}
+}
+
+// TestDevicesConfig: the age that keeps a device from eviction and the number of
+// devices per client come from the config, a day and 10 without it (Deckhouse).
+func TestDevicesConfig(t *testing.T) {
+	_, byDefault := newTestServer(t, nil)
+	require.Equal(t, tokens.DefaultProtectedGrantAge, byDefault.issuer.Refresh.ProtectedGrantAge)
+	require.Equal(t, tokens.DefaultMaxGrantsPerClient, byDefault.issuer.Refresh.MaxGrantsPerClient)
+
+	for _, age := range []time.Duration{time.Hour, 0} {
+		_, s := newTestServer(t, func(c *Config) { c.Devices = DevicesConfig{TrustedAfter: &age, MaxPerClient: 3} })
+		require.Equal(t, age, s.issuer.Refresh.ProtectedGrantAge)
+		require.Equal(t, 3, s.issuer.Refresh.MaxGrantsPerClient)
+	}
+}
