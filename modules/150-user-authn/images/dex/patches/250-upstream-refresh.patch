diff --git a/server/tokens/refresh_lease.go b/server/tokens/refresh_lease.go
new file mode 100644
index 00000000..717e6211
--- /dev/null
+++ b/server/tokens/refresh_lease.go
@@ -0,0 +1,317 @@
+package tokens
+
+// refresh_lease.go serializes the spending of the upstream credential an
+// offline session shares between the clients of a user (Deckhouse).
+//
+// A provider that rotates refresh tokens accepts each one once. Two requests
+// that present the same one at once, from two clients of the user or on two
+// replicas, leave one of them refused, and a provider that detects reuse
+// (Auth0, Okta, Keycloak) revokes the whole grant on the second presentation.
+// The lease is a field of the offline session, taken and released with the
+// compare-and-swap update every storage offers, so every replica sharing the
+// storage honours it. A request holds it from reading the credential until the
+// successor is published and the claims read are stored, and keeps it alive
+// meanwhile however long its storage and the provider take; the others wait,
+// then are served those claims or read the successor.
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/dexidp/dex/storage"
+)
+
+var (
+	// errLeaseHeld aborts the update that would take a lease another request
+	// holds.
+	errLeaseHeld = errors.New("upstream credential leased by another request")
+	// errLeaseLost aborts the update that would extend or release a lease
+	// another request has taken over since.
+	errLeaseLost = errors.New("upstream credential lease taken over")
+	// errLeaseBusy reports a request that waited for the lease in vain.
+	errLeaseBusy = errors.New("upstream credential busy: another request kept it leased")
+	// errNothingToLease aborts the update that would take the lease of an
+	// offline session without a credential, for a token without one: nothing
+	// single-use is spent, so the request needs no lease and writes nothing.
+	errNothingToLease = errors.New("no upstream credential to lease")
+)
+
+// upstreamLease is the lease of one request on the upstream credential of an
+// offline session.
+type upstreamLease struct {
+	rt          *RefreshStore
+	userID      string
+	connectorID string
+	holder      string
+
+	mu sync.Mutex
+	// isHeld is set while the storage records the lease as this request's,
+	// until expiry as the clock of the store tells it; isLost once a renewal
+	// found it taken over.
+	isHeld bool
+	isLost bool
+	expiry time.Time
+	// gen counts the takes of the lease: a renewal that started before the
+	// lease was lost and taken again reports on a lease that is gone, and is
+	// ignored.
+	gen int
+
+	// stop ends the renewal of the lease, which closes done when it returns.
+	stop chan struct{}
+	done chan struct{}
+}
+
+func (rt *RefreshStore) newUpstreamLease(token *storage.RefreshToken) *upstreamLease {
+	return &upstreamLease{
+		rt:          rt,
+		userID:      token.Claims.UserID,
+		connectorID: token.ConnectorID,
+		holder:      storage.NewID(),
+	}
+}
+
+// acquire takes the lease, or extends it when this request holds it already,
+// waiting while another request holds it and at most as long as a lease lasts:
+// a holder that died leaves a lease that expires by then. It returns the offline
+// session as it was when the lease was taken, and keeps the lease alive until it
+// is released. It takes no lease, and returns errNothingToLease with the
+// session, when neither the session nor own (the credential of the token) holds
+// a credential, and storage.ErrNotFound when the pair has no offline session.
+func (l *upstreamLease) acquire(ctx context.Context, own []byte) (storage.OfflineSessions, error) {
+	ttl := l.rt.UpstreamLeaseTTL
+	deadline, polls := l.rt.waitBounds(ttl + l.rt.UpstreamPollPeriod)
+	for poll := 0; ; poll++ {
+		now := l.rt.now()
+		var (
+			session   storage.OfflineSessions
+			isRenewal bool
+		)
+		err := l.rt.storage.UpdateOfflineSessions(ctx, l.userID, l.connectorID,
+			func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+				session = old
+				cur := old.UpstreamLease
+				if !cur.IsZero() && cur.Holder != l.holder && now.Before(cur.Expiry) {
+					return old, errLeaseHeld
+				}
+				if len(old.ConnectorData) == 0 && len(own) == 0 && cur.Holder != l.holder {
+					return old, errNothingToLease
+				}
+				// Extending a lease of this request that is still in force, or
+				// taking one anew: free, expired, or another request's that expired.
+				isRenewal = cur.Holder == l.holder && now.Before(cur.Expiry)
+				old.UpstreamLease = storage.UpstreamLease{Holder: l.holder, Expiry: now.Add(ttl)}
+				session = old
+				return old, nil
+			})
+		switch {
+		case err == nil:
+			l.mu.Lock()
+			if !isRenewal {
+				l.gen++
+			}
+			l.isHeld, l.isLost, l.expiry = true, false, now.Add(ttl)
+			l.mu.Unlock()
+			l.keepAlive(ctx)
+			return session, nil
+		case errors.Is(err, errNothingToLease):
+			return session, err
+		case errors.Is(err, storage.ErrNotFound):
+			return storage.OfflineSessions{}, err
+		case !errors.Is(err, errLeaseHeld):
+			return storage.OfflineSessions{}, fmt.Errorf("lease upstream credential: %w", err)
+		}
+
+		if poll >= polls-1 || !l.rt.now().Before(deadline) {
+			return storage.OfflineSessions{}, &UpstreamError{Unavailable: true, Err: errLeaseBusy}
+		}
+		if err := l.rt.Sleep(ctx, l.rt.pollDelay(poll, deadline)); err != nil {
+			// The client is gone before anything was spent.
+			return storage.OfflineSessions{}, &UpstreamError{Unavailable: true, Err: err}
+		}
+	}
+}
+
+// keepAlive starts the renewal of a lease just taken, unless it runs already.
+// A request holds the lease across its storage reads, the upstream call and the
+// writes that keep its result, which on the Kubernetes storage take as
+// long as its API server does, whatever the context of the request says:
+// renewing the lease a third of its time keeps it from expiring under a request
+// that is alive, and only a request that stopped altogether loses it.
+func (l *upstreamLease) keepAlive(ctx context.Context) {
+	if l.stop != nil {
+		select {
+		case <-l.done:
+			// It stopped on a lease it lost; this one is new.
+		default:
+			return
+		}
+	}
+	l.stop, l.done = make(chan struct{}), make(chan struct{})
+	ticks, stopTicks := l.rt.leaseTicker(l.rt.UpstreamLeaseTTL / 3)
+	go l.renew(context.WithoutCancel(ctx), ticks, stopTicks, l.stop, l.done)
+}
+
+func (l *upstreamLease) renew(ctx context.Context, ticks <-chan time.Time, stopTicks func(), stop <-chan struct{}, done chan<- struct{}) {
+	defer close(done)
+	defer stopTicks()
+	for {
+		select {
+		case <-stop:
+			return
+		case <-ticks:
+			select {
+			case <-stop:
+				// A tick that came with the release renews nothing.
+				return
+			default:
+			}
+			if !l.renewOnce(ctx) {
+				return
+			}
+		}
+	}
+}
+
+// renewOnce extends the lease by a lease time from now while the storage still
+// records it as this request's, and reports whether to go on renewing. A lease
+// another request took over, or one released, is never extended or taken
+// again: the request learns it lost the lease (valid).
+func (l *upstreamLease) renewOnce(ctx context.Context) bool {
+	ctx, cancel := context.WithTimeout(ctx, publishTimeout)
+	defer cancel()
+	l.mu.Lock()
+	gen := l.gen
+	l.mu.Unlock()
+	now := l.rt.now()
+	expiry := now.Add(l.rt.UpstreamLeaseTTL)
+	err := l.rt.storage.UpdateOfflineSessions(ctx, l.userID, l.connectorID,
+		func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+			if old.UpstreamLease.Holder != l.holder {
+				return old, errLeaseLost
+			}
+			old.UpstreamLease.Expiry = expiry
+			return old, nil
+		})
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if gen != l.gen {
+		// The lease was taken again meanwhile: this renewal says nothing about
+		// it, and the renewal goes on for the new one.
+		return true
+	}
+	switch {
+	case err == nil:
+		l.expiry = expiry
+		return true
+	case errors.Is(err, errLeaseLost), errors.Is(err, storage.ErrNotFound):
+		l.isLost = true
+		return false
+	}
+	// A failed write is tried again at the next tick; the lease ends at its
+	// expiry if none succeeds, which valid tells.
+	l.rt.logger.WarnContext(ctx, "failed to renew the lease of the upstream credential", "err", err)
+	return true
+}
+
+// leaseTicker returns the ticks the lease is renewed at.
+func (rt *RefreshStore) leaseTicker(d time.Duration) (<-chan time.Time, func()) {
+	if rt.LeaseTicker != nil {
+		return rt.LeaseTicker(d)
+	}
+	ticker := time.NewTicker(d)
+	return ticker.C, ticker.Stop
+}
+
+// stopRenewal stops the renewal. It does not wait for a renewal write in
+// flight, which takes as long as the storage does: once the lease is released,
+// such a write finds it no longer this request's and changes nothing, and a
+// later take of the lease is a generation of its own.
+func (l *upstreamLease) stopRenewal() {
+	if l.stop == nil {
+		return
+	}
+	select {
+	case <-l.done:
+	default:
+		close(l.stop)
+	}
+	l.stop, l.done = nil, nil
+}
+
+// isTaken reports whether this request took the lease and has not released it.
+func (l *upstreamLease) isTaken() bool {
+	if l == nil {
+		return false
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.isHeld
+}
+
+// valid reports whether the lease is still this request's for longer than the
+// clocks of the replicas may differ: no other request took it over, and it was
+// renewed in time. A request whose lease is not valid must not spend the
+// credential it read under it: another request may have spent it since. The
+// margin is leaseClockMargin, or a fifth of a lease configured shorter than the
+// default, which renewals every third of it keep clear of.
+func (l *upstreamLease) valid() bool {
+	margin := min(leaseClockMargin, l.rt.UpstreamLeaseTTL/5)
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.isHeld && !l.isLost && l.rt.now().Add(margin).Before(l.expiry)
+}
+
+// releaseIn releases the lease within an update of the offline session o, the
+// one that records the use of the refresh token after the successor of the
+// credential is published and the claims read are stored. It reports whether
+// it did; the lease counts as released once the update is stored (released).
+func (l *upstreamLease) releaseIn(o *storage.OfflineSessions) bool {
+	if l == nil || o.UpstreamLease.Holder != l.holder {
+		return false
+	}
+	o.UpstreamLease = storage.UpstreamLease{}
+	return true
+}
+
+// released records that an update released the lease.
+func (l *upstreamLease) released() {
+	if l == nil {
+		return
+	}
+	l.stopRenewal()
+	l.mu.Lock()
+	l.isHeld = false
+	l.mu.Unlock()
+}
+
+// release releases the lease unless an update released it already. It runs as
+// the request ends, failing or not, so it does not end with the request.
+func (l *upstreamLease) release(ctx context.Context) {
+	if l == nil {
+		return
+	}
+	l.stopRenewal()
+	if !l.isTaken() {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), publishTimeout)
+	defer cancel()
+	err := l.rt.storage.UpdateOfflineSessions(ctx, l.userID, l.connectorID,
+		func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+			if old.UpstreamLease.Holder != l.holder {
+				return old, errLeaseLost
+			}
+			old.UpstreamLease = storage.UpstreamLease{}
+			return old, nil
+		})
+	l.mu.Lock()
+	l.isHeld = false
+	l.mu.Unlock()
+	if err != nil && !errors.Is(err, errLeaseLost) && !errors.Is(err, storage.ErrNotFound) {
+		// The lease ends at its expiry instead.
+		l.rt.logger.ErrorContext(ctx, "failed to release the lease of the upstream credential", "err", err)
+	}
+}
diff --git a/server/tokens/refresh_lease_test.go b/server/tokens/refresh_lease_test.go
new file mode 100644
index 00000000..4897502c
