+// hookStorage runs hooks around the next update of an offline session, once
+// armed: a storage that is slow, or whose answer comes late.
+type hookStorage struct {
+	storage.Storage
+
+	mu     sync.Mutex
+	before func()
+	after  func()
+}
+
+func (s *hookStorage) arm(before, after func()) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.before, s.after = before, after
+}
+
+func (s *hookStorage) UpdateOfflineSessions(ctx context.Context, userID, connID string, updater func(storage.OfflineSessions) (storage.OfflineSessions, error)) error {
+	s.mu.Lock()
+	before, after := s.before, s.after
+	s.before, s.after = nil, nil
+	s.mu.Unlock()
+	if before != nil {
+		before()
+	}
+	err := s.Storage.UpdateOfflineSessions(ctx, userID, connID, updater)
+	if after != nil {
+		after()
+	}
+	return err
+}
+
+func (f *leaseFixture) clock() time.Time {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.now
+}
+
+func (f *leaseFixture) advance(d time.Duration) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.now = f.now.Add(d)
+}
+
+func (f *leaseFixture) pollCount() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.polls
+}
+
+// ticker returns the ticks of the i-th renewal started, waiting for it to
+// start.
+func (f *leaseFixture) ticker(i int) chan time.Time {
+	for {
+		f.mu.Lock()
+		if i < len(f.tickers) {
+			ticks := f.tickers[i]
+			f.mu.Unlock()
+			return ticks
+		}
+		f.mu.Unlock()
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// tick renews the first lease taken once: the second send returns only after
+// the renewal of the first is done.
+func (f *leaseFixture) tick() {
+	f.ticker(0) <- f.clock()
+	f.ticker(0) <- f.clock()
+}
+
+func (f *leaseFixture) lease(t *testing.T) *upstreamLease {
+	l := f.rt.newUpstreamLease(&storage.RefreshToken{ConnectorID: "mock", Claims: storage.Claims{UserID: "u1"}})
+	t.Cleanup(func() { l.release(context.Background()) })
+	return l
+}
+
+func (f *leaseFixture) stored(t *testing.T) storage.UpstreamLease {
+	t.Helper()
+	session, err := f.store.GetOfflineSessions(t.Context(), "u1", "mock")
+	require.NoError(t, err)
+	return session.UpstreamLease
+}
+
+// One request at a time holds the lease of a pair; the others wait for it at
+// most as long as a lease lasts, then give up as with a provider that did not
+// answer. The holder keeps it alive; a lease whose holder died is taken over
+// once it expires, and the holder, should it come back, learns that it lost it.
+func TestUpstreamLease(t *testing.T) {
+	t.Run("free lease is taken with the session", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		l := f.lease(t)
+		session, err := l.acquire(t.Context(), nil)
+		require.NoError(t, err)
+		assert.Equal(t, []byte("shared"), session.ConnectorData)
+		assert.Equal(t, storage.UpstreamLease{Holder: l.holder, Expiry: f.clock().Add(DefaultUpstreamLeaseTTL)}, f.stored(t))
+		assert.True(t, l.valid())
+		assert.Zero(t, f.pollCount())
+	})
+
+	t.Run("held lease is waited for, then busy", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		_, err := f.lease(t).acquire(t.Context(), nil)
+		require.NoError(t, err)
+
+		_, err = f.lease(t).acquire(t.Context(), nil)
+		var upstreamErr *UpstreamError
+		require.ErrorAs(t, err, &upstreamErr)
+		assert.True(t, upstreamErr.Unavailable)
+		assert.ErrorIs(t, err, errLeaseBusy)
+		assert.Equal(t, pollsWithin(DefaultUpstreamLeaseTTL+DefaultUpstreamPollPeriod, DefaultUpstreamPollPeriod)-1, f.pollCount(),
+			"a waiter gives up only after a whole lease time")
+	})
+
+	t.Run("renewal keeps the lease alive", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		l := f.lease(t)
+		_, err := l.acquire(t.Context(), nil)
+		require.NoError(t, err)
+
+		for range 3 {
+			f.advance(DefaultUpstreamLeaseTTL / 2)
+			f.tick()
+		}
+		assert.Equal(t, f.clock().Add(DefaultUpstreamLeaseTTL), f.stored(t).Expiry)
+		assert.True(t, l.valid(), "a lease renewed in time stays the request's")
+
+		_, err = f.lease(t).acquire(t.Context(), nil)
+		assert.ErrorIs(t, err, errLeaseBusy, "however long the holder takes")
+	})
+
+	t.Run("a lease not renewed in time is no longer valid", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		l := f.lease(t)
+		_, err := l.acquire(t.Context(), nil)
+		require.NoError(t, err)
+
+		f.advance(DefaultUpstreamLeaseTTL - leaseClockMargin)
+		assert.False(t, l.valid(), "the clocks of the replicas may differ by the margin")
+	})
+
+	t.Run("expired lease of a dead holder is taken over, and stays taken", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		dead := f.lease(t)
+		_, err := dead.acquire(t.Context(), nil)
+		require.NoError(t, err)
+
+		f.advance(DefaultUpstreamLeaseTTL)
+		l := f.lease(t)
+		_, err = l.acquire(t.Context(), nil)
+		require.NoError(t, err)
+		taken := f.stored(t)
+		assert.Equal(t, l.holder, taken.Holder)
+
+		// The dead holder comes back: its renewal neither extends nor takes the
+		// lease of the other, and it learns that it lost its own.
+		f.ticker(0) <- f.clock()
+		require.Eventually(t, func() bool { return !dead.valid() }, time.Second, time.Millisecond)
+		assert.Equal(t, taken, f.stored(t))
+		dead.release(t.Context())
+		assert.Equal(t, taken, f.stored(t), "nor does it release it")
+	})
+
+	t.Run("release frees the lease and stops the renewal", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		l := f.lease(t)
+		_, err := l.acquire(t.Context(), nil)
+		require.NoError(t, err)
+		l.release(t.Context())
+		assert.True(t, f.stored(t).IsZero())
+
+		// A tick after the release, should the renewal still take it, renews
+		// nothing.
+		select {
+		case f.ticker(0) <- f.clock():
+		case <-time.After(10 * time.Millisecond):
+		}
+		assert.True(t, f.stored(t).IsZero(), "the renewal is stopped")
+
+		_, err = f.lease(t).acquire(t.Context(), nil)
+		require.NoError(t, err, "the next request takes it at once")
+		assert.Zero(t, f.pollCount())
+	})
+
+	t.Run("nothing to spend, nothing to lease", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		require.NoError(t, f.store.UpdateOfflineSessions(t.Context(), "u1", "mock",
+			func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+				old.ConnectorData = nil
+				return old, nil
+			}))
+		l := f.lease(t)
+		_, err := l.acquire(t.Context(), nil)
+		require.ErrorIs(t, err, errNothingToLease)
+		assert.True(t, f.stored(t).IsZero(), "no write")
+		assert.False(t, l.isTaken())
+
+		_, err = l.acquire(t.Context(), []byte("own"))
+		require.NoError(t, err, "an own credential of the token is leased with the session")
+	})
+
+	t.Run("no offline session, nothing to lease", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		l := f.rt.newUpstreamLease(&storage.RefreshToken{ConnectorID: "mock", Claims: storage.Claims{UserID: "u2"}})
+		_, err := l.acquire(t.Context(), nil)
+		require.ErrorIs(t, err, storage.ErrNotFound)
+		assert.False(t, l.isTaken())
+	})
+
+	t.Run("a waiter whose client is gone stops waiting", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		_, err := f.lease(t).acquire(t.Context(), nil)
+		require.NoError(t, err)
+
+		ctx, cancel := context.WithCancel(t.Context())
+		cancel()
+		_, err = f.lease(t).acquire(ctx, nil)
+		require.ErrorIs(t, err, context.Canceled)
+		assert.Equal(t, 1, f.pollCount())
+	})
+}
+
+// A renewal whose answer comes after the lease was lost and taken again
+// reports on the lease that is gone: it neither marks the new one lost nor
+// stops renewing it.
+func TestUpstreamLeaseLateRenewalAfterRetake(t *testing.T) {
+	f := newLeaseFixture(t)
+	l := f.lease(t)
+	_, err := l.acquire(t.Context(), nil)
+	require.NoError(t, err)
+
+	// The lease expires under a stalled request and another takes it over.
+	f.advance(DefaultUpstreamLeaseTTL)
+	other := f.lease(t)
+	_, err = other.acquire(t.Context(), nil)
+	require.NoError(t, err)
+
+	// A renewal finds it taken over, and its answer is late.
+	answered, late := make(chan struct{}), make(chan struct{})
+	f.hooks.arm(nil, func() {
+		close(answered)
+		<-late
+	})
+	f.ticker(0) <- f.clock()
+	<-answered
+
+	// Meanwhile the other request is done and this one takes the lease again.
+	other.release(t.Context())
+	_, err = l.acquire(t.Context(), nil)
+	require.NoError(t, err)
+	close(late)
+
+	// The renewal goes on for the lease taken again.
+	f.advance(DefaultUpstreamLeaseTTL / 2)
+	f.tick()
+	assert.True(t, l.valid(), "the late answer about the lost lease does not mark the new one lost")
+	assert.Equal(t, f.clock().Add(DefaultUpstreamLeaseTTL), f.stored(t).Expiry, "and it is renewed")
+}
+
+// Releasing the lease does not wait for a renewal write in flight, which on the
+// Kubernetes storage takes as long as its API server does: the late renewal
+// finds the lease no longer this request's and changes nothing.
+func TestUpstreamLeaseReleaseDoesNotWaitForRenewal(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		release func(t *testing.T, l *upstreamLease)
+	}{
+		{name: "release", release: func(t *testing.T, l *upstreamLease) { l.release(t.Context()) }},
+		{name: "released with the last write", release: func(t *testing.T, l *upstreamLease) {
+			assert.NoError(t, l.rt.storage.UpdateOfflineSessions(t.Context(), l.userID, l.connectorID,
+				func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+					assert.True(t, l.releaseIn(&old))
+					return old, nil
+				}))
+			l.released()
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newLeaseFixture(t)
+			l := f.lease(t)
+			_, err := l.acquire(t.Context(), nil)
+			require.NoError(t, err)
+
+			writing, slow := make(chan struct{}), make(chan struct{})
+			f.hooks.arm(func() {
+				close(writing)
+				<-slow
+			}, nil)
+			f.ticker(0) <- f.clock()
+			<-writing
+
+			released := make(chan struct{})
+			go func() {
+				tc.release(t, l)
+				close(released)
+			}()
+			select {
+			case <-released:
+			case <-time.After(5 * time.Second):
+				close(slow)
+				t.Fatal("the release waits for the renewal in flight")
+			}
+			assert.True(t, f.stored(t).IsZero())
+
+			close(slow)
+			// The late renewal changes nothing: the lease stays free.
+			require.Eventually(t, func() bool { return !l.valid() }, time.Second, time.Millisecond)
+			assert.True(t, f.stored(t).IsZero(), "a late renewal does not take the lease again")
+		})
+	}
+}
+
+// A wait looks again every poll period and reads the storage at every look,
+// which takes time of its own: the wait ends by the clock, a lease time or an
+// upstream refresh after it began, however many looks that made.
+func TestUpstreamWaitsEndByTheClock(t *testing.T) {
+	const storageRead = 20 * time.Millisecond
+	slowLooks := func(f *leaseFixture) {
+		f.rt.Sleep = func(ctx context.Context, d time.Duration) error {
+			f.advance(d + storageRead)
+			f.mu.Lock()
+			f.polls++
+			f.mu.Unlock()
+			return ctx.Err()
+		}
+	}
+
+	t.Run("lease held by another request", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		require.NoError(t, f.store.UpdateOfflineSessions(t.Context(), "u1", "mock", func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+			old.UpstreamLease = storage.UpstreamLease{Holder: "other", Expiry: f.clock().Add(time.Hour)}
+			return old, nil
+		}))
+		slowLooks(f)
+
+		start := f.clock()
+		_, err := f.lease(t).acquire(t.Context(), nil)
+		require.ErrorIs(t, err, errLeaseBusy)
+		budget := DefaultUpstreamLeaseTTL + DefaultUpstreamPollPeriod
+		elapsed := f.clock().Sub(start)
+		assert.GreaterOrEqual(t, elapsed, budget, "a waiter gives up only after a whole lease time")
+		assert.Less(t, elapsed, budget+DefaultUpstreamPollPeriod+storageRead, "and not later")
+		assert.LessOrEqual(t, f.pollCount(), pollsWithin(budget, DefaultUpstreamPollPeriod)-1)
+	})
+
+	t.Run("shared credential that does not move", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		slowLooks(f)
+
+		start := f.clock()
+		token := &storage.RefreshToken{ConnectorID: "mock", Claims: storage.Claims{UserID: "u1"}}
+		assert.False(t, f.rt.awaitRotatedCredential(t.Context(), token, [][]byte{[]byte("shared")}))
+		elapsed := f.clock().Sub(start)
+		assert.GreaterOrEqual(t, elapsed, UpstreamRefreshTimeout, "the credential is taken for dead only after an upstream refresh time")
+		assert.Less(t, elapsed, UpstreamRefreshTimeout+DefaultUpstreamPollPeriod+storageRead, "and not later")
+	})
+}
+
+// A wait backs off: it looks again after 50 ms, then 100, 200, 400 and every
+// 500 ms, so a whole lease time is 24 looks at the storage and the wait for a
+// rotated credential 14, where looking every 50 ms made 201 and 100.
+func TestUpstreamWaitsBackOff(t *testing.T) {
+	record := func(f *leaseFixture) *[]time.Duration {
+		var pauses []time.Duration
+		f.rt.Sleep = func(ctx context.Context, d time.Duration) error {
+			f.mu.Lock()
+			pauses = append(pauses, d)
+			f.polls++
+			f.mu.Unlock()
+			return ctx.Err()
+		}
+		return &pauses
+	}
+	ms := time.Millisecond
+
+	t.Run("lease held by another request", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		require.NoError(t, f.store.UpdateOfflineSessions(t.Context(), "u1", "mock", func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+			old.UpstreamLease = storage.UpstreamLease{Holder: "other", Expiry: f.clock().Add(time.Hour)}
+			return old, nil
+		}))
+		pauses := record(f)
+
+		_, err := f.lease(t).acquire(t.Context(), nil)
+		require.ErrorIs(t, err, errLeaseBusy)
+		require.Len(t, *pauses, 23, "24 looks")
+		require.Equal(t, []time.Duration{50 * ms, 100 * ms, 200 * ms, 400 * ms, 500 * ms, 500 * ms}, (*pauses)[:6])
+		var total time.Duration
+		for _, d := range *pauses {
+			total += d
+		}
+		budget := DefaultUpstreamLeaseTTL + DefaultUpstreamPollPeriod
+		require.GreaterOrEqual(t, total, budget, "the pauses cover a lease time")
+		require.Less(t, total, budget+500*ms, "and one pause more at most")
+	})
+
+	t.Run("shared credential that does not move", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		pauses := record(f)
+		token := &storage.RefreshToken{ConnectorID: "mock", Claims: storage.Claims{UserID: "u1"}}
+		require.False(t, f.rt.awaitRotatedCredential(t.Context(), token, [][]byte{[]byte("shared")}))
+		require.Len(t, *pauses, 13, "14 looks")
+	})
+
+	t.Run("the last pause ends at the deadline", func(t *testing.T) {
+		f := newLeaseFixture(t)
+		deadline := f.clock().Add(120 * ms)
+		require.Equal(t, 50*ms, f.rt.pollDelay(0, deadline))
+		require.Equal(t, 100*ms, f.rt.pollDelay(1, deadline))
+		f.advance(100 * ms)
+		require.Equal(t, 20*ms, f.rt.pollDelay(2, deadline), "not past the deadline")
+		require.Equal(t, 500*ms, f.rt.pollDelay(10, f.clock().Add(time.Hour)), "the cap")
+	})
+}
