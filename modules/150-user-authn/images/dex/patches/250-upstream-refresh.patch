+	body := url.Values{"grant_type": {"authorization_code"}, "code": {code}, "redirect_uri": {upstreamRedirect}}
+	req := httptest.NewRequest(http.MethodPost, "/token", bytes.NewBufferString(body.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth(clientID, upstreamSecret)
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	require.Equal(t, http.StatusOK, rr.Code, "the login must succeed: %s", rr.Body.String())
