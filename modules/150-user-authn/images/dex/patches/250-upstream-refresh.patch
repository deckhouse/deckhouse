+// throttledPasswordStore is the password store of local users that fails every
+// read of a password while throttled is set.
+type throttledPasswordStore struct {
+	storage.Storage
+	throttled bool
+}
+
+func (s *throttledPasswordStore) GetPassword(ctx context.Context, email string) (storage.Password, error) {
+	if s.throttled {
+		return storage.Password{}, errThrottled
+	}
+	return s.Storage.GetPassword(ctx, email)
+}
