+// kubernetesRefreshTokenLock is how long the kubernetes storage holds the lock
+// of a refresh token before another request may break it (lockTimeout in
+// storage/kubernetes/lock.go).
+const kubernetesRefreshTokenLock = 10 * time.Second
+
+// The connector call ends well before the kubernetes storage gives up the lock
+// of the refresh token it runs under: a request on another replica would take
+// the lock and spend the same upstream credential again.
+func TestUpstreamRefreshEndsWithinRefreshTokenLock(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
