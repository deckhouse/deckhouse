+// A refresh token ID that no object can be named after names no stored token:
+// the lookup answers ErrNotFound, as the other storages do, without asking the
+// API server (Deckhouse). The client of the test has no server, so any request
+// would fail with another error.
+func TestGetRefreshInvalidName(t *testing.T) {
+	cli := &client{}
+	for _, id := range []string{
+		"ChlibHhxZ0123456789abcdef01234567",
+		"garbage-not-base64!",
+		"-leading-dash",
+		string(make([]byte, kubeResourceMaxLen+1)),
+	} {
+		_, err := cli.GetRefresh(t.Context(), id)
+		require.ErrorIs(t, err, storage.ErrNotFound, "%q", id)
+	}
+}
+
+func TestValidResourceName(t *testing.T) {
+	require.True(t, validResourceName("ohc5ruokzsz7wkxfcqm4hosmrq"))
+	require.True(t, validResourceName("a.b-c"))
+	require.False(t, validResourceName("Upper"))
+	require.False(t, validResourceName("a_b"))
+	require.False(t, validResourceName(""))
+}
