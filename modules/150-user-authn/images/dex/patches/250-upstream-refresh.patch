+// The connector call outlives a client that hangs up: a provider that rotates
+// refresh tokens has spent the presented one by the time it answers, and the
+// successor must be stored.
+func TestUpstreamRefreshDetachedFromRequest(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	own := upstream.mint()
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, own, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, nil)
+
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel() // the client is gone before dex reaches the provider
+	refreshTokenRequest(t, ctx, s, clientID, requestToken(refreshID))
+
+	require.Equal(t, 1, upstream.calls)
+	require.NoError(t, upstream.lastCtxErr, "the request's cancellation does not reach the provider call")
+	assert.True(t, upstream.lastHasDeadline, "the detached call is still bounded")
+
+	stored, err := s.storage.GetRefresh(t.Context(), refreshID)
+	require.NoError(t, err)
+	requireCredentialValid(t, upstream, stored.ConnectorData, "the rotated credential is stored")
