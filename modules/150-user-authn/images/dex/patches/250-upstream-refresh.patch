+
+// Upstream credentials are bearer credentials for the account of the user at the
+// provider; they stay out of the logs.
+func TestUpstreamRotationCredentialNotLogged(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	var logs bytes.Buffer
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
