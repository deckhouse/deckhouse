+// replacesSharedCredential reports whether the connector data of a login
+// replaces the upstream credential the offline session shares between the
+// clients of the user: the identity of a SAML login always does, a credential
+// when the connector finds a refresh credential in it
+// (connector.RefreshCredentialReporter), and any other connector data when it
+// is not empty.
+func replacesSharedCredential(conn connector.Connector, data []byte) bool {
+	if len(data) == 0 {
+		return false
+	}
+	if connectors.KeepsLoginIdentity(conn) {
+		return true
+	}
