+	session, err := s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+	require.NoError(t, err)
+	require.Equal(t, obtained, session.ConnectorData, "a login restores a shared credential that is gone")
+
+	// And the client that was broken refreshes again, without a login of its own.
+	clk.advance(5 * time.Minute)
+	requireRefreshSucceeds(t, s, cliClient, requestToken(cliRefresh))
+}
