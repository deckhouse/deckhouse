index 00000000..f489d40b
--- /dev/null
+++ b/server/server_grant_refresh_upstream_fuzz_test.go
@@ -0,0 +1,165 @@
+package server
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/tokens"
+)
+
+// FuzzUpstreamRefresh drives random interleavings of logins and refreshes of
+// three clients of one user over two replicas of dex sharing one storage, and
+// checks the invariants of the shared upstream credential (see
+// server_grant_refresh_upstream_state_test.go) after every step and at the end:
+//
+//   - I1: a spent upstream refresh token is never presented again;
+//   - I2: after a login every client refreshes without another login: no refresh
+//     is refused, and at the end every client refreshes on every replica;
+//   - I3: at most one request spends the shared credential at a time;
+//   - I4: a rotated upstream refresh token is never lost: at the end the offline
+//     session holds a live one.
+//
+// The first byte picks the provider and whether stored claims are served for
+// 10 minutes. Every other byte is a step; a step can run another one inside the
+// next upstream call, the way a request on another replica runs while one waits
+// for the provider: before the provider spends the credential, or after it,
+// while its answer and the write that publishes the successor are on their way.
+// Time may pass there too, longer than a lease lasts; the holder renews its
+// lease meanwhile, as its renewal does on its own.
+func FuzzUpstreamRefresh(f *testing.F) {
+	for _, seed := range [][]byte{
+		{0, 3, 35, 0, 37, 6, 32, 1},       // rotating: logins, a raced refresh
+		{1, 3, 11, 37, 6, 40, 0, 37, 1},   // family revocation: race on two replicas
+		{2, 3, 4, 37, 0, 1, 2, 37, 0},     // not rotating: a login without a refresh token
+		{3, 3, 11, 37, 6, 3, 0, 37, 0, 1}, // ending: a login during a refresh
+		{4, 3, 11, 37, 7, 0, 37, 15, 0},   // dex up to v2.45: failures of the provider
+		{8, 3, 11, 37, 0, 1, 61, 0, 1},    // rotating, stored claims served
+		{11, 3, 19, 37, 6, 43, 0, 61, 1},  // ending, stored claims served, a race
+		{1, 3, 7, 37, 0, 7, 0, 37, 0},     // family revocation: rotated, then failed
+		{1, 3, 43, 37, 46, 32, 0, 37, 0},  // family revocation: a slow answer, a race after the spend
+		{3, 3, 43, 37, 38, 3, 0, 37, 1},   // ending: time passes before the spend, a login
+	} {
+		f.Add(seed)
+	}
+
+	f.Fuzz(func(t *testing.T, data []byte) {
+		if len(data) == 0 {
+			return
+		}
+		kind := providerKinds[int(data[0])%len(providerKinds)].kind
+		var maxAge time.Duration
+		if data[0]>>3&1 == 1 {
+			maxAge = 10 * time.Minute
+		}
+		w := newUpstreamWorld(t, kind, 2, maxAge)
+		steps := data[1:]
+		if len(steps) > 48 {
+			steps = steps[:48]
+		}
+
+		for i := 0; i < len(steps); i++ {
+			b := steps[i]
+			if b%8 == 6 && i+1 < len(steps) {
+				// The next step runs inside the next upstream call, after time
+				// passed there, if any.
+				i++
+				inner := steps[i]
+				passes := [...]time.Duration{0, tokens.DefaultUpstreamLeaseTTL / 2, 2 * tokens.DefaultUpstreamLeaseTTL, 0}[int(b>>4)&3]
+				hook := func() {
+					if passes > 0 {
+						w.clk.advance(passes)
+						w.renewLease()
+					}
+					fuzzStep(t, w, inner, true)
+				}
+				w.provider.mu.Lock()
+				if b>>3&1 == 1 {
+					w.provider.afterSpend = hook
+				} else {
+					w.provider.during = hook
+				}
+				w.provider.mu.Unlock()
+				continue
+			}
+			fuzzStep(t, w, b, false)
+			w.requireInvariants()
+		}
+
+		// Quiescence: no more failures, no more nested steps.
+		w.provider.mu.Lock()
+		w.provider.during, w.provider.afterSpend, w.provider.answers, w.provider.failAfterRotation = nil, nil, nil, 0
+		w.provider.mu.Unlock()
+		if !w.anyLoggedIn() {
+			return
+		}
+		w.requireEveryClientRefreshes()
+	})
+}
+
+// fuzzStep runs step b of FuzzUpstreamRefresh. A nested step only logs in or
+// refreshes.
+func fuzzStep(t *testing.T, w *upstreamWorld, b byte, isNested bool) {
+	client := worldClients[int(b>>3)%len(worldClients)]
+	replica := int(b>>5) & 1
+	op := b % 8
+	if isNested && op > 4 {
+		op %= 4
+	}
+	switch op {
+	case 0, 1, 2:
+		if w.tokens[client] == nil {
+			w.login(client, replica)
+			return
+		}
+		rr := w.refresh(client, replica)
+		require.Contains(t, []int{http.StatusOK, http.StatusServiceUnavailable}, rr.Code,
+			"I2: a refresh is never refused while the provider knows the user: %s", rr.Body.String())
+		if rr.Code == http.StatusServiceUnavailable {
+			requireNotFatalForDexAuthenticator(t, rr)
+		}
+	case 3:
+		w.login(client, replica)
+	case 4:
+		// A login without a refresh token keeps the shared credential; before
+		// any login there would be nothing to keep.
+		if !w.anyLoggedIn() {
+			w.login(client, replica)
+			return
+		}
+		w.provider.mu.Lock()
+		w.provider.withoutRefreshToken = true
+		w.provider.mu.Unlock()
+		w.login(client, replica)
+	case 5:
+		w.clk.advance(time.Duration(int(b>>3)%8+1) * time.Minute)
+	case 7:
+		w.provider.mu.Lock()
+		defer w.provider.mu.Unlock()
+		switch int(b>>3) % 3 {
+		case 0:
+			if w.provider.kind.rotates() {
+				w.provider.failAfterRotation = 1
+			}
+		case 1:
+			w.provider.answers = append(w.provider.answers, fmt.Errorf("oidc: failed to get refresh token: %w",
+				&url.Error{Op: "Post", URL: "https://idp.example.com/token", Err: errors.New("connection refused")}))
+		case 2:
+			w.provider.answers = append(w.provider.answers, oauth2Answer(http.StatusUnauthorized, "invalid_client", ""))
+		}
+	}
+}
+
+func (w *upstreamWorld) anyLoggedIn() bool {
+	for _, token := range w.tokens {
+		if token != nil {
+			return true
+		}
+	}
+	return false
+}
