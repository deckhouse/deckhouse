+// Tests of the upstream refresh (250-upstream-refresh): the upstream credential
+// has one holder, the refresh survives the races of several clients of one user
+// and a client that hangs up, and a refusal of the provider is invalid_grant.
+
+const (
+	upstreamConnID   = "gitlab"
+	upstreamUserID   = "1"
+	upstreamSecret   = "secret"
+	upstreamRedirect = "https://example.com/callback"
+)
+
+// rotatingUpstream simulates an upstream IdP with single-use refresh tokens, like
+// GitLab: every successful refresh invalidates the presented token and issues a
+// new one.
+type rotatingUpstream struct {
+	valid map[string]bool
+	seq   int
+	calls int
+
+	// spent holds the tokens spent at a refresh, and reused counts the
+	// presentations of one of them: the reuse of a rotated refresh token that a
+	// provider such as Auth0 revokes the whole grant for.
+	spent  map[string]bool
+	reused int
+
+	// unreachable makes every refresh fail the way a provider that cannot be
+	// reached does, without saying anything about the credential offered to it.
+	unreachable bool
+
+	// lastCtxErr, lastHasDeadline and lastTimeLeft describe the context of the
+	// last refresh at the time of the call.
+	lastCtxErr      error
+	lastHasDeadline bool
+	lastTimeLeft    time.Duration
+}
+
+type upstreamConnectorData struct {
+	RefreshToken string `json:"refreshToken"`
+}
+
+func newRotatingUpstream() *rotatingUpstream {
+	return &rotatingUpstream{valid: map[string]bool{}, spent: map[string]bool{}}
+}
+
+func (u *rotatingUpstream) mint() []byte {
+	u.seq++
+	token := fmt.Sprintf("upstream-%d", u.seq)
+	u.valid[token] = true
+	data, _ := json.Marshal(upstreamConnectorData{RefreshToken: token})
+	return data
+}
+
+// spend invalidates a credential the way the provider does when it is used,
+// standing for a rotation that happened outside the requests of a test.
+func (u *rotatingUpstream) spend(t *testing.T, data []byte) {
+	t.Helper()
+	var parsed upstreamConnectorData
+	require.NoError(t, json.Unmarshal(data, &parsed))
+	delete(u.valid, parsed.RefreshToken)
+}
+
+func (u *rotatingUpstream) Refresh(ctx context.Context, _ connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	u.calls++
+	u.lastCtxErr = ctx.Err()
+	var deadline time.Time
+	deadline, u.lastHasDeadline = ctx.Deadline()
+	u.lastTimeLeft = time.Until(deadline)
+
+	var data upstreamConnectorData
+	if err := json.Unmarshal(ident.ConnectorData, &data); err != nil {
+		return ident, fmt.Errorf("unmarshal connector data: %v", err)
+	}
+
+	// Both failures are wrapped the way the GitLab connector wraps them, because
+	// telling them apart decides whether a stored credential may be treated as dead.
+	if u.unreachable {
+		return ident, fmt.Errorf("gitlab: failed to get refresh token: %w", &url.Error{
+			Op:  "Post",
+			URL: "https://gitlab.example.com/oauth/token",
+			Err: errors.New("connect: connection refused"),
+		})
+	}
+
+	if !u.valid[data.RefreshToken] {
+		if u.spent[data.RefreshToken] {
+			u.reused++
+		}
+		return ident, fmt.Errorf("gitlab: failed to get refresh token: %w", refusedGrant())
+	}
+
+	delete(u.valid, data.RefreshToken)
+	u.spent[data.RefreshToken] = true
+	ident.ConnectorData = u.mint()
+	return ident, nil
+}
+
+func (u *rotatingUpstream) LoginURL(_ connector.Scopes, callbackURL, state string) (string, []byte, error) {
+	return callbackURL + "?state=" + state, nil, nil
+}
+
+func (u *rotatingUpstream) HandleCallback(connector.Scopes, []byte, *http.Request) (connector.Identity, error) {
+	return connector.Identity{}, nil
+}
+
+// refusedGrant is the answer of an OAuth2 provider to a refresh token that is
+// invalid, expired or revoked.
+func refusedGrant() *oauth2.RetrieveError {
+	const desc = "The provided authorization grant is invalid, expired, revoked, does not match the redirection URI used in the authorization request, or was issued to another client."
+	return &oauth2.RetrieveError{
+		Response:         &http.Response{StatusCode: http.StatusBadRequest},
+		Body:             []byte(`{"error":"invalid_grant","error_description":"` + desc + `"}`),
+		ErrorCode:        "invalid_grant",
+		ErrorDescription: desc,
+	}
+}
+
+func registerUpstreamConnector(t *testing.T, s *Server, connID string, conn connector.Connector) {
+	t.Helper()
+	require.NoError(t, s.storage.CreateConnector(t.Context(), storage.Connector{
+		ID:              connID,
+		Type:            "mockCallback",
+		Name:            "GitLab",
+		ResourceVersion: "1",
+	}))
+	s.connectors.Set(connID, connectors.Connector{ResourceVersion: "1", Connector: conn})
+}
+
+func registerClients(t *testing.T, s *Server, ids ...string) {
+	t.Helper()
+	for _, id := range ids {
+		require.NoError(t, s.storage.CreateClient(t.Context(), storage.Client{
+			ID:           id,
+			Secret:       upstreamSecret,
+			RedirectURIs: []string{upstreamRedirect},
+			Name:         id,
+		}))
+	}
+}
+
+func upstreamClaims() storage.Claims {
+	return storage.Claims{UserID: upstreamUserID, Username: "jane", Email: "jane@example.com", EmailVerified: true}
+}
+
+func createRefreshToken(t *testing.T, s *Server, connID, id, clientID string, connectorData []byte, now time.Time) {
+	t.Helper()
+	require.NoError(t, s.storage.CreateRefresh(t.Context(), storage.RefreshToken{
+		ID:            id,
+		Token:         "token-" + id,
+		ClientID:      clientID,
+		ConnectorID:   connID,
+		Scopes:        []string{"openid", "email", "groups", "offline_access"},
+		Claims:        upstreamClaims(),
+		ConnectorData: connectorData,
+		CreatedAt:     now.Add(-time.Hour),
+		LastUsed:      now.Add(-time.Hour),
+	}))
+}
+
+func createOfflineSession(t *testing.T, s *Server, connID string, refs map[string]string, connectorData []byte) {
+	t.Helper()
+	refresh := make(map[string]*storage.RefreshTokenRef, len(refs))
+	for clientID, refreshID := range refs {
+		refresh[clientID] = &storage.RefreshTokenRef{ID: refreshID, ClientID: clientID}
+	}
+	require.NoError(t, s.storage.CreateOfflineSessions(t.Context(), storage.OfflineSessions{
+		UserID:        upstreamUserID,
+		ConnID:        connID,
+		Refresh:       refresh,
+		ConnectorData: connectorData,
+	}))
+}
+
+func refreshTokenRequest(t *testing.T, ctx context.Context, s *Server, clientID string, token *internal.RefreshToken) *httptest.ResponseRecorder {
+	t.Helper()
+	raw, err := internal.Marshal(token)
+	require.NoError(t, err)
+
+	body := url.Values{"grant_type": {"refresh_token"}, "refresh_token": {raw}}
+	req := httptest.NewRequestWithContext(ctx, http.MethodPost, "/token", bytes.NewBufferString(body.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth(clientID, upstreamSecret)
+
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	return rr
+}
+
+func requestToken(id string) *internal.RefreshToken {
+	return &internal.RefreshToken{RefreshId: id, Token: "token-" + id}
+}
+
+// requireRefreshSucceeds refreshes and returns the rotated token, so that a
+// caller can keep refreshing the same downstream session.
+func requireRefreshSucceeds(t *testing.T, s *Server, clientID string, token *internal.RefreshToken) *internal.RefreshToken {
+	t.Helper()
+	rr := refreshTokenRequest(t, t.Context(), s, clientID, token)
+	require.Equal(t, http.StatusOK, rr.Code, "refresh of %q must succeed: %s", clientID, rr.Body.String())
+
+	var resp struct {
+		RefreshToken string `json:"refresh_token"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &resp))
+	rotated := new(internal.RefreshToken)
+	require.NoError(t, internal.Unmarshal(resp.RefreshToken, rotated))
+	return rotated
+}
+
+func requireCredentialValid(t *testing.T, upstream *rotatingUpstream, data []byte, msg string) {
+	t.Helper()
+	var parsed upstreamConnectorData
+	require.NoError(t, json.Unmarshal(data, &parsed))
+	require.True(t, upstream.valid[parsed.RefreshToken], msg)
+}
+
+func requireSessionCredentialValid(t *testing.T, s *Server, upstream *rotatingUpstream) {
+	t.Helper()
+	session, err := s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+	require.NoError(t, err)
+	requireCredentialValid(t, upstream, session.ConnectorData,
+		"the offline session must hold the upstream refresh token that is still valid upstream")
+}
+
+func requireOAuth2Error(t *testing.T, rr *httptest.ResponseRecorder, status int, code string) {
+	t.Helper()
+	require.Equal(t, status, rr.Code, rr.Body.String())
+	var resp struct {
+		Error string `json:"error"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &resp))
+	require.Equal(t, code, resp.Error)
+}
+
+// testClock is an injectable time source. Tests advance it to leave the refresh
+// token reuse interval, inside which refreshes are served from storage without
+// contacting the provider.
+type testClock struct {
+	now time.Time
+}
+
+func (c *testClock) Now() time.Time { return c.now }
+
+func (c *testClock) advance(d time.Duration) { c.now = c.now.Add(d) }
+
+// rotatingPolicy configures refresh token rotation with a reuse interval, the way
+// Deckhouse runs dex.
+func rotatingPolicy(clk *testClock) func(c *Config) {
+	return func(c *Config) {
+		c.RefreshTokenPolicy = tokens.NewRefreshStrategy(true, 0, 0, 2*time.Minute, clk.Now)
+		c.Now = clk.Now
+	}
+}
+
+// sessionReadStorage counts reads of the offline session and, when stale is set,
+// serves the first of them from a credential taken before another client rotated
+// the shared one. That is what losing a race looks like to a request which has
+// already read the session by the time the winner publishes its successor.
+type sessionReadStorage struct {
+	storage.Storage
+
+	stale []byte
+	reads int
+}
+
+func (s *sessionReadStorage) GetOfflineSessions(ctx context.Context, userID, connID string) (storage.OfflineSessions, error) {
+	session, err := s.Storage.GetOfflineSessions(ctx, userID, connID)
+	s.reads++
+	if err == nil && s.reads == 1 && len(s.stale) > 0 {
+		session.ConnectorData = s.stale
+	}
+	return session, err
+}
+
+// retryingUpdaterStorage runs the refresh token updater twice per call,
+// discarding the result of the first run, the way a storage retrying a
+// conflicting write does.
+type retryingUpdaterStorage struct {
+	storage.Storage
+}
+
+func (r *retryingUpdaterStorage) UpdateRefreshToken(ctx context.Context, id string, updater func(old storage.RefreshToken) (storage.RefreshToken, error)) error {
+	discard := func(old storage.RefreshToken) (storage.RefreshToken, error) {
+		if _, err := updater(old); err != nil {
+			return old, err
+		}
+		return old, nil
+	}
+	if err := r.Storage.UpdateRefreshToken(ctx, id, discard); err != nil {
+		return err
+	}
+	return r.Storage.UpdateRefreshToken(ctx, id, updater)
+}
+
+// A user has two clients (an application behind DexAuthenticator and
+// kubeconfig-generator) sharing one offline session, and the upstream refresh
+// token they rely on is single-use: the refreshes of one client must not break
+// the other.
+func TestUpstreamRotationSharedBetweenClients(t *testing.T) {
+	const (
+		webClient, cliClient   = "webapp", "kubeconfig-generator"
+		webRefresh, cliRefresh = "web-refresh-id", "cli-refresh-id"
+	)
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, webClient, cliClient)
+
+	// The web application logged in first and has refreshed since, so it holds no
+	// credential of its own. Then the CLI logged in, and its login put the same
+	// credential into its refresh token and into the offline session.
+	createRefreshToken(t, s, upstreamConnID, webRefresh, webClient, nil, clk.now)
+	cliLoginData := upstream.mint()
+	createRefreshToken(t, s, upstreamConnID, cliRefresh, cliClient, cliLoginData, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{webClient: webRefresh, cliClient: cliRefresh}, cliLoginData)
+
+	// The web application spends the shared credential the CLI login brought.
+	requireRefreshSucceeds(t, s, webClient, requestToken(webRefresh))
+
+	// The CLI must refresh against the rotated credential of the offline session,
+	// not its stale copy, and keep working.
+	rotated := requireRefreshSucceeds(t, s, cliClient, requestToken(cliRefresh))
+	clk.advance(5 * time.Minute)
+	requireRefreshSucceeds(t, s, cliClient, rotated)
+
+	requireSessionCredentialValid(t, s, upstream)
+}
+
+// A storage that runs the refresh token updater more than once (Kubernetes on
+// conflicts) must not make dex contact the provider twice: the presented upstream
+// refresh token is spent by the time the updater runs again.
+func TestUpstreamRotationRetriedUpdater(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
+		c.Storage = &retryingUpdaterStorage{Storage: c.Storage}
+	})
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	connectorData := upstream.mint()
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, connectorData, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, connectorData)
+
+	requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+	require.Equal(t, 1, upstream.calls, "the upstream provider must be contacted once per request")
+	requireSessionCredentialValid(t, s, upstream)
+}
+
+// An upstream refresh token rotated during a request that fails afterwards is
+// still stored, so the failure stays a single failed request.
+func TestUpstreamRotationKeptOnFailedUpdate(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	connectorData := upstream.mint()
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, connectorData, clk.now)
+	// The offline session points at another refresh token of the same client, as
+	// after a newer login while an older token is still in use: updating it fails.
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: "other-refresh-id"}, connectorData)
+
+	rr := refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+	require.Equal(t, http.StatusInternalServerError, rr.Code, "the request itself is expected to fail")
+	requireSessionCredentialValid(t, s, upstream)
+}
+
+// A refresh token issued before the offline session kept the only credential
+// may hold one of its own, possibly a copy of a shared credential spent since.
+// It is not offered while the session holds one: presenting a spent refresh
+// token is what a provider that detects reuse revokes the whole grant for. The
+// token drops it once it refreshed through the session.
+func TestUpstreamRotationStaleOwnCredentialFallsBackToSession(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	stale := upstream.mint()
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, stale, clk.now)
+	upstream.spend(t, stale)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, upstream.mint())
+
+	requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+	require.Equal(t, 1, upstream.calls, "only the shared credential is offered")
+	require.Zero(t, upstream.reused, "a spent credential is never presented")
+
+	stored, err := s.storage.GetRefresh(t.Context(), refreshID)
+	require.NoError(t, err)
+	require.Empty(t, stored.ConnectorData, "a token that spent the shared credential keeps no credential of its own")
+	requireSessionCredentialValid(t, s, upstream)
+}
+
+// A token with an own credential refreshing through the shared one, with a
+// storage that runs the updater more than once: later runs are served from the
+// first result, and the provider is asked once.
+func TestUpstreamRotationFallbackSurvivesRetriedUpdater(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
+		c.Storage = &retryingUpdaterStorage{Storage: c.Storage}
+	})
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	stale := upstream.mint()
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, stale, clk.now)
+	upstream.spend(t, stale)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, upstream.mint())
+
+	requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+	require.Equal(t, 1, upstream.calls, "the provider is contacted once, however often the updater runs")
+	requireSessionCredentialValid(t, s, upstream)
+}
+
+// rolloutRacer stands for a Dex that does not take the lease of the shared
+// credential, an older version during a rollout: right before this request
+// presents the credential it read, that Dex spends it and publishes the
+// successor, as it does. races is how many calls it races; a negative one races
+// every call.
+type rolloutRacer struct {
+	connector.RefreshConnector
+	t        *testing.T
+	upstream *rotatingUpstream
+	storage  storage.Storage
+	races    int
+}
+
+func (r *rolloutRacer) Refresh(ctx context.Context, s connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	if r.races != 0 {
+		r.races--
+		r.upstream.spend(r.t, ident.ConnectorData)
+		successor := r.upstream.mint()
+		require.NoError(r.t, r.storage.UpdateOfflineSessions(ctx, upstreamUserID, upstreamConnID,
+			func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+				old.ConnectorData = successor
+				return old, nil
+			}))
+	}
+	return r.RefreshConnector.Refresh(ctx, s, ident)
+}
+
+// A Dex that does not take the lease spends the shared credential under this
+// request: the request continues from the credential that Dex published.
+func TestUpstreamRotationRecoversFromLostRace(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, &rolloutRacer{RefreshConnector: upstream, t: t, upstream: upstream, storage: s.storage, races: 1})
+	registerClients(t, s, clientID)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, upstream.mint())
+
+	requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+	require.Equal(t, 2, upstream.calls, "the credential published by the other Dex is offered once")
+	requireSessionCredentialValid(t, s, upstream)
+}
+
+// A refusal nobody caused by rotating the shared credential fails the request with
+// invalid_grant (R30) without spending further credentials, and the dead
+// credential is dropped, since no refresh can revive it. Before that the request
+// waits as long as an upstream refresh may take, for a Dex that spent it under
+// the request to publish the successor; every client of a user whose upstream
+// credential died pays it once, and none after it is dropped.
+func TestUpstreamRotationRetiresRefusedSharedCredential(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	var reads *sessionReadStorage
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
+		reads = &sessionReadStorage{Storage: c.Storage}
+		c.Storage = reads
+	})
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	// A credential the provider never issued, as after the user revoked the
+	// application upstream.
+	revoked, err := json.Marshal(upstreamConnectorData{RefreshToken: "revoked-upstream"})
+	require.NoError(t, err)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, revoked)
+
+	rr := refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+	requireOAuth2Error(t, rr, http.StatusBadRequest, "invalid_grant")
+	require.Equal(t, 1, upstream.calls, "a credential nobody rotated is offered once")
+	// 14 looks: after 50, 100, 200 and 400 ms, then every 500 ms until the
+	// pauses cover the 5 s of an upstream refresh (tokens pollDelay).
+	require.Equal(t, 14, reads.reads,
+		"the request looks for a successor for as long as an upstream refresh may take")
+
+	session, err := s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+	require.NoError(t, err)
+	require.Empty(t, session.ConnectorData, "a refused credential nothing rotated is not left in place")
+	require.True(t, session.UpstreamLease.IsZero(), "the lease is released")
+
+	// Once it is gone, the clients relying on it stop paying for the conclusion.
+	reads.reads = 0
+	rr = refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+	requireOAuth2Error(t, rr, http.StatusBadRequest, "invalid_grant")
+	require.Zero(t, reads.reads, "with no shared credential left there is nothing to wait for")
+}
