+// The provider revoked the user, or the credential died otherwise: the refusal
+// is final (invalid_grant), the dead credential is dropped so that no client
+// presents it again, and one login of any client restores the refresh of every
+// client.
+func TestUpstreamCredentialRevoked(t *testing.T) {
+	answers := []struct {
+		name   string
+		answer error
+	}{
+		{"invalid_grant", fmt.Errorf("oidc: failed to get refresh token: %w: %w", refusedGrant(), connector.ErrRefreshRefused)},
+		{"invalid_request of dex up to v2.45", fmt.Errorf("oidc: failed to get refresh token: %w: %w", claimedByAnotherClient(), connector.ErrRefreshRefused)},
+		{"bad_refresh_token", oauth2Answer(http.StatusBadRequest, "bad_refresh_token", "")},
+	}
+	for _, kind := range providerKinds {
+		for _, tc := range answers {
+			t.Run(kind.name+"/"+tc.name, func(t *testing.T) {
+				w := newUpstreamWorld(t, kind.kind, 2, 0)
+				w.login("webapp", 0)
+				w.login("kubeconfig-generator", 1)
+				w.clk.advance(3 * time.Minute)
+				w.provider.answers = []error{tc.answer}
+				w.requireRefresh("webapp", 0, http.StatusBadRequest)
+				require.Empty(t, w.session().ConnectorData, "the dead credential is dropped")
+				w.requireRefresh("kubeconfig-generator", 1, http.StatusBadRequest)
+				calls, _, _, _ := w.provider.snapshot()
+				require.Equal(t, 1, calls, "the second client, with nothing to offer, does not ask the provider")
+
+				w.login("grafana", 1)
+				w.requireEveryClientRefreshes()
+			})
+		}
+	}
+}
