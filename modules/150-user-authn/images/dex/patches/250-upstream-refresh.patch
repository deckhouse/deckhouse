+// failingUpstream refreshes nothing: it answers every credential with err.
+type failingUpstream struct {
+	errs  []error
+	calls int
+}
+
+func (f *failingUpstream) Refresh(context.Context, connector.Scopes, connector.Identity) (connector.Identity, error) {
+	err := f.errs[min(f.calls, len(f.errs)-1)]
+	f.calls++
+	return connector.Identity{}, err
+}
+
+func (f *failingUpstream) LoginURL(_ connector.Scopes, callbackURL, state string) (string, []byte, error) {
+	return callbackURL + "?state=" + state, nil, nil
+}
+
+func (f *failingUpstream) HandleCallback(connector.Scopes, []byte, *http.Request) (connector.Identity, error) {
+	return connector.Identity{}, nil
+}
