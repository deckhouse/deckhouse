+++ b/server/tokens/refresh_lease_test.go
@@ -0,0 +1,471 @@
+package tokens
+
+import (
+	"context"
+	"log/slog"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// leaseFixture is a store over a memory storage with an offline session of
+// user u1, a clock that moves only when told to, waits that count polls
+// without sleeping, and renewals that happen when the test ticks them.
+type leaseFixture struct {
+	rt      *RefreshStore
+	store   storage.Storage
+	hooks   *hookStorage
+	tickers []chan time.Time // of the renewals, in the order they started
+
+	mu    sync.Mutex
+	now   time.Time
+	polls int
+}
+
+func newLeaseFixture(t *testing.T) *leaseFixture {
+	t.Helper()
+	f := &leaseFixture{
+		store: memory.New(slog.New(slog.DiscardHandler)),
+		now:   time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC),
+	}
+	f.hooks = &hookStorage{Storage: f.store}
+	f.rt = NewRefreshStore(f.hooks, f.clock, slog.New(slog.DiscardHandler))
+	f.rt.Sleep = func(ctx context.Context, _ time.Duration) error {
+		f.mu.Lock()
+		f.polls++
+		f.mu.Unlock()
+		return ctx.Err()
+	}
+	f.rt.LeaseTicker = func(time.Duration) (<-chan time.Time, func()) {
+		ticks := make(chan time.Time)
+		f.mu.Lock()
+		f.tickers = append(f.tickers, ticks)
+		f.mu.Unlock()
+		return ticks, func() {}
+	}
+	require.NoError(t, f.store.CreateOfflineSessions(t.Context(), storage.OfflineSessions{
+		UserID: "u1", ConnID: "mock", Refresh: map[string]*storage.RefreshTokenRef{}, ConnectorData: []byte("shared"),
+	}))
+	return f
+}
