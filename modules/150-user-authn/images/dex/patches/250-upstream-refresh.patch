+// A fallback to the shared credential combined with a storage that runs the
+// updater more than once: later runs are served from the first result, and the
+// credential refused before the accepted one leaves nothing behind in it.
+func TestUpstreamRotationFallbackSurvivesRetriedUpdater(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
+		c.Storage = &retryingUpdaterStorage{Storage: c.Storage}
+	})
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	stale := upstream.mint()
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, stale, clk.now)
+	upstream.spend(t, stale)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, upstream.mint())
+
+	requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+	require.Equal(t, 2, upstream.calls, "the provider is contacted once per credential, however often the updater runs")
+	requireSessionCredentialValid(t, s, upstream)
