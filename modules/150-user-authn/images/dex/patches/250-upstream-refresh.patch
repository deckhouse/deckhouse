+package tokens
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// Only a final answer of the provider about the user makes a refresh
+// invalid_grant; a provider that fails to answer says nothing about it.
+func TestIdentityRefused(t *testing.T) {
+	unreachable := &url.Error{Op: "Post", URL: "https://idp.example.com/token", Err: errors.New("connection refused")}
+	tests := []struct {
+		name            string
+		err             error
+		isCredential    bool
+		isIdentityFinal bool
+	}{
+		{
+			name: "account locked by an upstream Deckhouse dex",
+			err: fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{
+				Response: &http.Response{StatusCode: http.StatusBadRequest}, ErrorCode: "invalid_grant", ErrorDescription: "Account locked"}),
+		},
+		{
+			name: "account an administrator locked at an upstream Deckhouse dex",
+			err: fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{
+				Response: &http.Response{StatusCode: http.StatusBadRequest}, ErrorCode: "invalid_grant", ErrorDescription: "Account locked by an administrator"}),
+		},
+		{
+			name: "another invalid_grant that names a lock",
+			err: fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{
+				Response: &http.Response{StatusCode: http.StatusBadRequest}, ErrorCode: "invalid_grant", ErrorDescription: "Account locked forever"}),
+			isCredential:    true,
+			isIdentityFinal: true,
+		},
+		{
+			name:            "refresh token refused",
+			err:             fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{ErrorCode: "invalid_grant"}),
+			isCredential:    true,
+			isIdentityFinal: true,
+		},
+		{
+			name:            "github refresh token refused",
+			err:             fmt.Errorf("github: get user: %w", &url.Error{Err: &oauth2.RetrieveError{ErrorCode: "bad_refresh_token"}}),
+			isCredential:    true,
+			isIdentityFinal: true,
+		},
+		{
+			name:            "user gone",
+			err:             fmt.Errorf("ldap: user not found %q: %w", "jane", connector.ErrIdentityGone),
+			isIdentityFinal: true,
+		},
+		{
+			name:            "user left the required groups",
+			err:             fmt.Errorf("gitlab: get groups: %w", &connector.UserNotInRequiredGroupsError{UserID: "1"}),
+			isIdentityFinal: true,
+		},
+		{
+			name: "provider error",
+			err:  fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{ErrorCode: "server_error"}),
+		},
+		{name: "provider unreachable", err: fmt.Errorf("gitlab: failed to get refresh token: %w", unreachable)},
+		{name: "flattened error", err: fmt.Errorf("oidc: failed to get refresh token: %v", &oauth2.RetrieveError{ErrorCode: "invalid_grant"})},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.isCredential, credentialRefused(tc.err), "credentialRefused")
+			assert.Equal(t, tc.isIdentityFinal, identityRefused(tc.err), "identityRefused")
+		})
+	}
+}
+
+// A 4xx answer to the token request is a refusal only with an OAuth2 error of the
+// provider in its body: without one, or with another JSON error, it comes from a
+// proxy in front of the provider. A 408 is no answer, and so is a 429 unless it
+// carries access_denied, the refusal of a locked account by an older Deckhouse
+// dex. A 401 stays an answer about dex as a client, whatever its code.
+func TestRefreshRefused(t *testing.T) {
+	answer := func(status int, code string) error {
+		return fmt.Errorf("oidc: failed to get refresh token: %w",
+			&oauth2.RetrieveError{Response: &http.Response{StatusCode: status}, ErrorCode: code})
+	}
+	tests := []struct {
+		name        string
+		err         error
+		refused     bool
+		unavailable bool
+	}{
+		{name: "invalid_grant", err: answer(http.StatusBadRequest, "invalid_grant"), refused: true},
+		{name: "invalid_client", err: answer(http.StatusUnauthorized, "invalid_client"), refused: true},
+		{name: "a 403 with an OAuth2 error", err: answer(http.StatusForbidden, "unauthorized_client"), refused: true},
+		{name: "a 404 of a proxy", err: answer(http.StatusNotFound, "")},
+		{name: "a 403 of a proxy", err: answer(http.StatusForbidden, "")},
+		{name: "a 405 of a proxy", err: answer(http.StatusMethodNotAllowed, "")},
+		{name: "a 403 of a gateway with a JSON error", err: answer(http.StatusForbidden, "Forbidden")},
+		{name: "bad_refresh_token", err: answer(http.StatusBadRequest, "bad_refresh_token"), refused: true},
+		{name: "a 408", err: answer(http.StatusRequestTimeout, ""), unavailable: true},
+		{name: "a 429", err: answer(http.StatusTooManyRequests, "slow_down"), unavailable: true},
+		{name: "a 429 of a proxy", err: answer(http.StatusTooManyRequests, ""), unavailable: true},
+		{name: "a 429 access_denied of an automatic lock", err: answer(http.StatusTooManyRequests, "access_denied"), refused: true},
+		{name: "a 403 access_denied of the lock of an administrator", err: answer(http.StatusForbidden, "access_denied"), refused: true},
+		{name: "an invalid_grant of a lock", err: fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{
+			Response: &http.Response{StatusCode: http.StatusBadRequest}, ErrorCode: "invalid_grant", ErrorDescription: "Account locked"}), refused: true},
+		{name: "a 401 access_denied", err: answer(http.StatusUnauthorized, "access_denied")},
+		{name: "a 408 access_denied", err: answer(http.StatusRequestTimeout, "access_denied"), unavailable: true},
+		{name: "a 503 access_denied", err: answer(http.StatusServiceUnavailable, "access_denied"), unavailable: true},
+		{name: "a 503", err: answer(http.StatusServiceUnavailable, ""), unavailable: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.unavailable, connector.Unavailable(tc.err), "Unavailable")
+			if !tc.unavailable {
+				assert.Equal(t, tc.refused, refreshRefused(tc.err), "refreshRefused")
+			}
+		})
+	}
+}
+
+func TestNotFinal(t *testing.T) {
+	cause := errors.New("refused")
+	err := notFinal(&UpstreamError{Refused: true, Err: cause})
+
+	var upstreamErr *UpstreamError
+	assert.True(t, errors.As(err, &upstreamErr))
+	assert.False(t, upstreamErr.Refused)
+	assert.ErrorIs(t, err, cause)
+
+	other := errors.New("storage")
+	assert.Equal(t, other, notFinal(other))
+}
+
+// ctxStorage fails every update whose context has ended, as a storage that
+// honours its context does.
+type ctxStorage struct {
+	storage.Storage
+}
+
+func (s ctxStorage) UpdateOfflineSessions(ctx context.Context, userID, connID string, updater func(storage.OfflineSessions) (storage.OfflineSessions, error)) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return s.Storage.UpdateOfflineSessions(ctx, userID, connID, updater)
+}
+
+// The successor of a spent credential is kept by a write with a time of its
+// own: an earlier write of the request that used up the time it shared with it
+// does not take the successor with it.
+func TestPersistRotatedCredentialAfterDeadline(t *testing.T) {
+	store := memory.New(slog.New(slog.DiscardHandler))
+	require.NoError(t, store.CreateOfflineSessions(t.Context(), storage.OfflineSessions{
+		UserID: "u1", ConnID: "mock", Refresh: map[string]*storage.RefreshTokenRef{}, ConnectorData: []byte("spent"),
+	}))
+	rt := NewRefreshStore(ctxStorage{store}, time.Now, slog.New(slog.DiscardHandler))
+	src := &upstreamRefresher{
+		isSpent:   true,
+		spentRef:  credentialRef{data: []byte("spent"), source: credentialFromSession},
+		successor: []byte("successor"),
+	}
+
+	ctx, cancel := context.WithDeadline(t.Context(), time.Now().Add(-time.Second))
+	defer cancel()
+	rt.persistRotatedCredential(ctx, &storage.RefreshToken{ConnectorID: "mock", Claims: storage.Claims{UserID: "u1"}}, src)
+
+	session, err := store.GetOfflineSessions(t.Context(), "u1", "mock")
+	require.NoError(t, err)
+	assert.Equal(t, []byte("successor"), session.ConnectorData)
+}
