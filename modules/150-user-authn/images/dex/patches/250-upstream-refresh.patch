diff --git a/server/tokens/refresh_upstream.go b/server/tokens/refresh_upstream.go
new file mode 100644
index 00000000..8229dc17
--- /dev/null
+++ b/server/tokens/refresh_upstream.go
@@ -0,0 +1,450 @@
+package tokens
+
+// refresh_upstream.go refreshes the identity of a refresh token through the
+// upstream connector and keeps the upstream credential it spends in one place.
+//
+// Providers that rotate refresh tokens (GitLab, GitHub, OIDC providers with
+// rotation) invalidate the presented credential as soon as it is used, so a
+// credential must have exactly one holder that may spend it, and its successor
+// has to go back to that holder. A login keeps its credential on the refresh
+// token it issues; the offline session keeps the one shared by the clients that
+// have none of their own (tokens issued before, providers with one credential
+// per user).
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"slices"
+	"time"
+
+	"golang.org/x/oauth2"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/storage"
+)
+
+// Recovering from a lost race costs an upstream round trip per attempt, so the
+// failure path is kept tight: a request whose credential nobody rotated pays two
+// reads of the offline session and one wait before it gives up, and the retries
+// beyond that are spent only while the shared credential is actually advancing.
+// Waiting is counted in attempts, not against a deadline, because the clock of
+// the server is injectable and frozen in tests.
+const (
+	sharedCredentialRetries    = 2
+	sharedCredentialPollTries  = 2
+	sharedCredentialPollPeriod = 150 * time.Millisecond
+
+	// persistTimeout bounds the writes that keep a rotated credential when the
+	// request is failing anyway.
+	persistTimeout = 10 * time.Second
+)
+
+// UpstreamRefresh re-reads an identity from the upstream connector, offering it
+// the upstream credential in ident.ConnectorData. The identity it returns carries
+// the credential that replaces the offered one when the provider rotated it.
+type UpstreamRefresh func(ctx context.Context, ident connector.Identity) (connector.Identity, error)
+
+// Upstream is the connector a refresh token is refreshed through.
+type Upstream struct {
+	// Refresh re-reads the identity; nil when the connector cannot refresh
+	// identities, and the stored claims are kept then.
+	Refresh UpstreamRefresh
+	// IsLoginIdentity is set when the connector data is the identity of the login
+	// that obtained it rather than a credential (SAML, which replays it). The
+	// offline session holds the latest login's, and every client refreshes to it;
+	// a copy on a refresh token only stands in for a session that has none.
+	IsLoginIdentity bool
+}
+
+// UpstreamError reports that the upstream connector did not refresh the
+// identity. Refused is set when the provider answered with a final refusal for
+// every credential offered: the user is gone or its access was revoked. A
+// provider that failed to answer leaves it unset.
+type UpstreamError struct {
+	Refused bool
+	Err     error
+}
+
+func (e *UpstreamError) Error() string { return "upstream refresh: " + e.Err.Error() }
+
+func (e *UpstreamError) Unwrap() error { return e.Err }
+
+// errCredentialMoved reports that the credential a request spent is no longer
+// the stored one, so its successor is not the one to store either.
+var errCredentialMoved = errors.New("upstream credential already rotated")
+
+// credentialSource is the storage object an upstream credential was read from,
+// and so the object its successor is written back to.
+type credentialSource int
+
+const (
+	// credentialFromToken is held by a single refresh token: only the client
+	// owning that token may spend it.
+	credentialFromToken credentialSource = iota
+	// credentialFromSession is held by the offline session of the user, where
+	// every client of the user may spend it.
+	credentialFromSession
+)
+
+func (c credentialSource) String() string {
+	if c == credentialFromToken {
+		return "refresh_token"
+	}
+	return "offline_session"
+}
+
+// credentialRef is an upstream credential together with the object holding it.
+type credentialRef struct {
+	data   []byte
+	source credentialSource
+}
+
+// identitySource supplies the identity a refresh token is rotated to.
+type identitySource interface {
+	// identity returns the refreshed identity, starting from base (the stored
+	// claims). It runs inside the storage transaction, which a storage may run
+	// more than once, so every call after the first returns the first result.
+	identity(ctx context.Context, base connector.Identity) (connector.Identity, error)
+	// spent reports the upstream credential the provider accepted and where it
+	// was read from; ok is false when no credential was spent.
+	spent() (credential []byte, source credentialSource, ok bool)
+}
+
+// storedIdentity is an identity that needs no upstream credential, such as the
+// claims stored at the last login. It spends nothing, so the stored credential
+// is left alone.
+type storedIdentity func(context.Context) (connector.Identity, error)
+
+func (f storedIdentity) identity(ctx context.Context, _ connector.Identity) (connector.Identity, error) {
+	return f(ctx)
+}
+
+func (storedIdentity) spent() ([]byte, credentialSource, bool) {
+	return nil, credentialFromToken, false
+}
+
+// upstreamRefresher refreshes the identity through the connector, offering the
+// credentials in order until one is accepted, and contacts the connector on the
+// first call only: a storage that retries its updater (the Kubernetes storage
+// does on conflicts) must not make it spend an already rotated credential again.
+type upstreamRefresher struct {
+	refresh     UpstreamRefresh // nil when the connector cannot refresh
+	credentials []credentialRef
+	logger      *slog.Logger
+	connectorID string
+
+	isDone bool
+	ident  connector.Identity
+	err    error
+
+	// accepted is the credential the provider accepted, valid when isAccepted.
+	isAccepted bool
+	accepted   credentialRef
+
+	// last is the last credential offered. isRefused records that the provider
+	// refused it as invalid, expired or revoked, as opposed to failing to answer:
+	// only a refusal says anything about the credential.
+	last      credentialRef
+	isRefused bool
+}
+
+func (u *upstreamRefresher) identity(ctx context.Context, base connector.Identity) (connector.Identity, error) {
+	if u.isDone {
+		return u.ident, u.err
+	}
+	u.isDone = true
+	u.ident = base
+	if u.refresh == nil {
+		return u.ident, nil
+	}
+
+	candidates := u.credentials
+	if len(candidates) == 0 {
+		// Refresh even without a credential, so that a connector that needs none
+		// still gets to refuse an identity that is gone upstream. The offline
+		// session is where a credential made out of nothing is kept.
+		candidates = []credentialRef{{source: credentialFromSession}}
+	}
+
+	allRefused := true
+	var lastErr error
+	for _, credential := range candidates {
+		offered := base
+		offered.ConnectorData = credential.data
+		u.last = credential
+
+		ident, err := u.refresh(ctx, offered)
+		if err == nil {
+			// A credential refused before this one leaves no trace: this result is
+			// what every later run of the updater gets.
+			u.ident, u.accepted, u.isAccepted = ident, credential, true
+			u.isRefused, u.err = false, nil
+			return u.ident, nil
+		}
+
+		u.logger.ErrorContext(ctx, "failed to refresh identity",
+			"connector_id", u.connectorID, "credential_source", credential.source.String(), "err", err)
+		u.isRefused = credentialRefused(err)
+		allRefused = allRefused && identityRefused(err)
+		lastErr = err
+	}
+
+	u.err = &UpstreamError{Refused: allRefused, Err: lastErr}
+	return u.ident, u.err
+}
+
+func (u *upstreamRefresher) spent() ([]byte, credentialSource, bool) {
+	return u.accepted.data, u.accepted.source, u.isAccepted
+}
+
+// credentialRefused reports whether the provider refused the credential offered
+// to it as invalid, expired or revoked, rather than failing to answer: RFC 6749
+// invalid_grant, or bad_refresh_token, which GitHub answers instead. Only such a
+// refusal lets dex treat a stored credential as dead.
+func credentialRefused(err error) bool {
+	var retrieveErr *oauth2.RetrieveError
+	if !errors.As(err, &retrieveErr) {
+		return false
+	}
+	return retrieveErr.ErrorCode == "invalid_grant" || retrieveErr.ErrorCode == "bad_refresh_token"
+}
+
+// identityRefused reports whether the provider gave a final answer that the
+// identity cannot be refreshed: its credential is refused, the user is gone or
+// the access was revoked, or the user left the groups the connector requires.
+func identityRefused(err error) bool {
+	var groupsErr *connector.UserNotInRequiredGroupsError
+	return credentialRefused(err) || errors.Is(err, connector.ErrIdentityGone) || errors.As(err, &groupsErr)
+}
+
+// RotateUpstream is Rotate with the identity refreshed through the upstream
+// connector.
+//
+// The upstream credentials are offered own first: the token's own credential,
+// then the one of the offline session. A token whose own credential turned out
+// to be spent rejoins the shared one instead of failing until the next login. A
+// request that lost the race for the shared credential to another client of the
+// user continues from the credential the winner published; a shared credential
+// the provider refused and nobody rotated is dropped, so that the next login of
+// any client restores it for all of them.
+//
+// A failed refresh returns an *UpstreamError.
+func (rt *RefreshStore) RotateUpstream(ctx context.Context, storageToken *storage.RefreshToken, requestToken *internal.RefreshToken, strategy *RefreshStrategy, upstream Upstream) (string, connector.Identity, error) {
+	credentials, err := rt.upstreamCredentials(ctx, storageToken, upstream.IsLoginIdentity)
+	if err != nil {
+		return "", IdentityFromClaims(storageToken.Claims), err
+	}
+
+	tried := make([][]byte, 0, len(credentials)+sharedCredentialRetries)
+	for _, credential := range credentials {
+		tried = append(tried, credential.data)
+	}
+
+	for attempt := 0; ; attempt++ {
+		refresher := &upstreamRefresher{
+			refresh:     upstream.Refresh,
+			credentials: credentials,
+			logger:      rt.logger,
+			connectorID: storageToken.ConnectorID,
+		}
+
+		rawToken, ident, err := rt.rotate(ctx, storageToken, requestToken, strategy, refresher)
+		if err == nil {
+			return rawToken, ident, nil
+		}
+
+		// Only the provider refusing a credential that other clients could have
+		// rotated is worth another attempt. A provider that failed to answer says
+		// nothing about the credential, and a credential of the token's own cannot
+		// have been spent by anybody else.
+		lostRace := len(credentials) > 0 && refresher.isRefused && refresher.last.source == credentialFromSession
+		if !lostRace {
+			return "", ident, err
+		}
+		if attempt == sharedCredentialRetries {
+			// The shared credential kept moving under this request: other clients
+			// of the user are spending it, so it is alive and the refusal is not
+			// the provider's last word about the user.
+			return "", ident, notFinal(err)
+		}
+
+		rotated, ok := rt.awaitRotatedCredential(ctx, storageToken, tried)
+		if !ok {
+			// Nobody rotated it: the credential is dead, not merely spent by
+			// another client.
+			rt.retireDeadSharedCredential(ctx, storageToken, refresher.last.data)
+			return "", ident, err
+		}
+
+		tried = append(tried, rotated)
+		credentials = []credentialRef{{data: rotated, source: credentialFromSession}}
+	}
+}
+
+// notFinal turns a refusal into a failure that says nothing about the user.
+func notFinal(err error) error {
+	var upstreamErr *UpstreamError
+	if errors.As(err, &upstreamErr) {
+		return &UpstreamError{Err: upstreamErr.Err}
+	}
+	return err
+}
+
+// upstreamCredentials returns the upstream credentials a refresh offers, in
+// order. A login stores the credential it obtained in the token it issues and,
+// when the offline session has none yet, in the session too; a copy byte-equal
+// to the session's is that same shared credential, not one of the token's own.
+//
+// The identity of a login (isLoginIdentity) is offered from the session, where
+// the latest login put it; the token's copy stands in for a session that has
+// none and moves there, as the session is the one place it is kept.
+func (rt *RefreshStore) upstreamCredentials(ctx context.Context, token *storage.RefreshToken, isLoginIdentity bool) ([]credentialRef, error) {
+	session, err := rt.storage.GetOfflineSessions(ctx, token.Claims.UserID, token.ConnectorID)
+	if err != nil && !errors.Is(err, storage.ErrNotFound) {
+		rt.logger.ErrorContext(ctx, "failed to get offline session", "err", err)
+		return nil, fmt.Errorf("get offline session: %w", err)
+	}
+
+	if isLoginIdentity {
+		data := session.ConnectorData
+		if len(data) == 0 {
+			data = token.ConnectorData
+		}
+		if len(data) == 0 {
+			return nil, nil
+		}
+		return []credentialRef{{data: data, source: credentialFromSession}}, nil
+	}
+
+	var credentials []credentialRef
+	if len(token.ConnectorData) > 0 && !bytes.Equal(token.ConnectorData, session.ConnectorData) {
+		credentials = append(credentials, credentialRef{data: token.ConnectorData, source: credentialFromToken})
+	}
+	if len(session.ConnectorData) > 0 {
+		credentials = append(credentials, credentialRef{data: session.ConnectorData, source: credentialFromSession})
+	}
+	return credentials, nil
+}
+
+// awaitRotatedCredential waits for the credential of the offline session to
+// become one this request has not offered yet, and returns it. It reports false
+// when the credential does not move: then no other client caused the failure.
+func (rt *RefreshStore) awaitRotatedCredential(ctx context.Context, token *storage.RefreshToken, tried [][]byte) ([]byte, bool) {
+	for attempt := 0; ; attempt++ {
+		session, err := rt.storage.GetOfflineSessions(ctx, token.Claims.UserID, token.ConnectorID)
+		if err != nil {
+			if !errors.Is(err, storage.ErrNotFound) {
+				rt.logger.ErrorContext(ctx, "failed to get offline session", "err", err)
+			}
+			return nil, false
+		}
+
+		isNew := !slices.ContainsFunc(tried, func(c []byte) bool { return bytes.Equal(c, session.ConnectorData) })
+		if len(session.ConnectorData) > 0 && isNew {
+			return session.ConnectorData, true
+		}
+
+		if attempt == sharedCredentialPollTries-1 {
+			return nil, false
+		}
+
+		// The client that won the race may still be waiting for the provider.
+		select {
+		case <-time.After(sharedCredentialPollPeriod):
+		case <-ctx.Done():
+			return nil, false
+		}
+	}
+}
+
+// retireDeadSharedCredential removes the credential of the offline session once
+// the provider refused it and nothing rotated it meanwhile. No refresh can
+// revive it, and while it stays no login replaces it either, since a login only
+// seeds a session that has none. Dropping it lets the next login of any client
+// restore the shared credential for every client of the user.
+func (rt *RefreshStore) retireDeadSharedCredential(ctx context.Context, token *storage.RefreshToken, refused []byte) {
+	if len(refused) == 0 {
+		return
+	}
+
+	// The request is failing, so its context may end at any moment.
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), persistTimeout)
+	defer cancel()
+
+	err := rt.storage.UpdateOfflineSessions(ctx, token.Claims.UserID, token.ConnectorID,
+		func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+			// Only the credential that was refused: anything else is a successor
+			// published meanwhile, and it belongs to whoever put it there.
+			if !bytes.Equal(old.ConnectorData, refused) {
+				return old, errCredentialMoved
+			}
+			old.ConnectorData = nil
+			return old, nil
+		})
+
+	switch {
+	case errors.Is(err, errCredentialMoved):
+		rt.logger.DebugContext(ctx, "upstream credential rotated while waiting, keeping it")
+	case err != nil:
+		rt.logger.ErrorContext(ctx, "failed to retire refused upstream credential", "err", err)
+	default:
+		rt.logger.WarnContext(ctx, "upstream provider refused the credential shared by the clients of the user, dropped it so that the next login restores it",
+			"connector_id", token.ConnectorID, "user_id", token.Claims.UserID)
+	}
+}
+
+// persistRotatedCredential stores a credential the provider rotated during a
+// request that failed afterwards, on the object the spent one was read from.
+// Dropping it would leave the holder with a spent credential, and every further
+// refresh would fail until the next login.
+func (rt *RefreshStore) persistRotatedCredential(ctx context.Context, token *storage.RefreshToken, src identitySource, ident connector.Identity) {
+	spent, source, ok := src.spent()
+	if !ok || len(ident.ConnectorData) == 0 || bytes.Equal(ident.ConnectorData, spent) {
+		return
+	}
+
+	// The request is failing, so its context may end at any moment. This write is
+	// what keeps the session usable, hence a context of its own.
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), persistTimeout)
+	defer cancel()
+
+	replace := func(stored []byte) ([]byte, error) {
+		switch {
+		case bytes.Equal(stored, ident.ConnectorData):
+			return stored, nil // already stored
+		case len(stored) > 0 && !bytes.Equal(stored, spent):
+			return stored, errCredentialMoved
+		}
+		// The holder still has the spent credential, or none at all: a request
+		// that lost the race to this one may have dropped it as dead.
+		return ident.ConnectorData, nil
+	}
+
+	var err error
+	if source == credentialFromToken {
+		err = rt.storage.UpdateRefreshToken(ctx, token.ID, func(old storage.RefreshToken) (storage.RefreshToken, error) {
+			var rerr error
+			old.ConnectorData, rerr = replace(old.ConnectorData)
+			return old, rerr
+		})
+	} else {
+		err = rt.storage.UpdateOfflineSessions(ctx, token.Claims.UserID, token.ConnectorID,
+			func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+				var rerr error
+				old.ConnectorData, rerr = replace(old.ConnectorData)
+				return old, rerr
+			})
+	}
+
+	switch {
+	case errors.Is(err, errCredentialMoved):
+		rt.logger.DebugContext(ctx, "upstream credential rotated by another request, discarding ours",
+			"credential_source", source.String())
+	case err != nil:
+		rt.logger.ErrorContext(ctx, "failed to save rotated connector data", "err", err)
+	}
+}
diff --git a/server/tokens/refresh_upstream_test.go b/server/tokens/refresh_upstream_test.go
new file mode 100644
index 00000000..2b05002e
--- /dev/null
+++ b/server/tokens/refresh_upstream_test.go
@@ -0,0 +1,73 @@
+package tokens
+
+import (
+	"errors"
+	"fmt"
+	"net/url"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"golang.org/x/oauth2"
+
+	"github.com/dexidp/dex/connector"
+)
+
+// Only a final answer of the provider about the user makes a refresh
+// invalid_grant; a provider that fails to answer says nothing about it.
+func TestIdentityRefused(t *testing.T) {
+	unreachable := &url.Error{Op: "Post", URL: "https://idp.example.com/token", Err: errors.New("connection refused")}
+	tests := []struct {
+		name            string
+		err             error
+		isCredential    bool
+		isIdentityFinal bool
+	}{
+		{
+			name:            "refresh token refused",
+			err:             fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{ErrorCode: "invalid_grant"}),
+			isCredential:    true,
+			isIdentityFinal: true,
+		},
+		{
+			name:            "github refresh token refused",
+			err:             fmt.Errorf("github: get user: %w", &url.Error{Err: &oauth2.RetrieveError{ErrorCode: "bad_refresh_token"}}),
+			isCredential:    true,
+			isIdentityFinal: true,
+		},
+		{
+			name:            "user gone",
+			err:             fmt.Errorf("ldap: user not found %q: %w", "jane", connector.ErrIdentityGone),
+			isIdentityFinal: true,
+		},
+		{
+			name:            "user left the required groups",
+			err:             fmt.Errorf("gitlab: get groups: %w", &connector.UserNotInRequiredGroupsError{UserID: "1"}),
+			isIdentityFinal: true,
+		},
+		{
+			name: "provider error",
+			err:  fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{ErrorCode: "server_error"}),
+		},
+		{name: "provider unreachable", err: fmt.Errorf("gitlab: failed to get refresh token: %w", unreachable)},
+		{name: "flattened error", err: fmt.Errorf("oidc: failed to get refresh token: %v", &oauth2.RetrieveError{ErrorCode: "invalid_grant"})},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.isCredential, credentialRefused(tc.err), "credentialRefused")
+			assert.Equal(t, tc.isIdentityFinal, identityRefused(tc.err), "identityRefused")
+		})
+	}
+}
+
+func TestNotFinal(t *testing.T) {
+	cause := errors.New("refused")
+	err := notFinal(&UpstreamError{Refused: true, Err: cause})
+
+	var upstreamErr *UpstreamError
+	assert.True(t, errors.As(err, &upstreamErr))
+	assert.False(t, upstreamErr.Refused)
+	assert.ErrorIs(t, err, cause)
+
+	other := errors.New("storage")
+	assert.Equal(t, other, notFinal(other))
+}
