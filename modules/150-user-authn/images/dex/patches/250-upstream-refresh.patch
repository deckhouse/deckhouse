+// When the provider answers that the user is gone or its access was revoked, the
+// refresh is refused with invalid_grant, not a server error (R30); a provider
+// that fails to answer is still a server error.
+func TestUpstreamRefreshRefused(t *testing.T) {
+	unreachable := &url.Error{Op: "Post", URL: "https://idp.example.com/token", Err: errors.New("connection refused")}
+	tests := []struct {
+		name     string
+		own      bool
+		errs     []error
+		status   int
+		expected string
+	}{
+		{
+			name:     "user gone",
+			errs:     []error{fmt.Errorf("ldap: user not found %q: %w", "jane", connector.ErrIdentityGone)},
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "refresh token refused",
+			errs:     []error{fmt.Errorf("oidc: failed to get refresh token: %w", refusedGrant())},
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name: "github refresh token refused",
+			errs: []error{fmt.Errorf("github: get user: %w", &url.Error{
+				Op: "Get", URL: "https://api.github.com/user",
+				Err: &oauth2.RetrieveError{ErrorCode: "bad_refresh_token"},
+			})},
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "user left the required groups",
+			errs:     []error{&connector.UserNotInRequiredGroupsError{UserID: "1", Groups: []string{"admins"}}},
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "every credential refused",
+			own:      true,
+			errs:     []error{refusedGrant(), refusedGrant()},
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "own credential refused, provider then unreachable",
+			own:      true,
+			errs:     []error{refusedGrant(), unreachable},
+			status:   http.StatusInternalServerError,
+			expected: "invalid_request",
+		},
+		{
+			name:     "provider unreachable",
+			errs:     []error{unreachable},
+			status:   http.StatusInternalServerError,
+			expected: "invalid_request",
+		},
+		{
+			name:     "provider error without an answer about the user",
+			errs:     []error{errors.New("gitlab: get groups: 502 Bad Gateway")},
+			status:   http.StatusInternalServerError,
+			expected: "invalid_request",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+			clk := &testClock{now: time.Now()}
+			httpServer, s := newTestServer(t, rotatingPolicy(clk))
+			defer httpServer.Close()
+
+			upstream := &failingUpstream{errs: tc.errs}
+			registerUpstreamConnector(t, s, upstreamConnID, upstream)
+			registerClients(t, s, clientID)
+
+			var own []byte
+			if tc.own {
+				own = []byte(`{"refreshToken":"own"}`)
+			}
+			createRefreshToken(t, s, upstreamConnID, refreshID, clientID, own, clk.now)
+			createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, []byte(`{"refreshToken":"shared"}`))
+
+			rr := refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+			requireOAuth2Error(t, rr, tc.status, tc.expected)
+		})
+	}
+}
