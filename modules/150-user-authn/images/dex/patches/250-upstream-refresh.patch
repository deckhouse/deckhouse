+// racingStorage stands for other clients of the user that win every race for the
+// shared credential: each read of the offline session returns the credential it
+// holds, by then spent by another client that published its successor.
+type racingStorage struct {
+	storage.Storage
+	t        *testing.T
+	upstream *rotatingUpstream
+}
+
+func (r *racingStorage) GetOfflineSessions(ctx context.Context, userID, connID string) (storage.OfflineSessions, error) {
+	session, err := r.Storage.GetOfflineSessions(ctx, userID, connID)
+	if err != nil || len(session.ConnectorData) == 0 {
+		return session, err
+	}
+	r.upstream.spend(r.t, session.ConnectorData)
+	successor := r.upstream.mint()
+	require.NoError(r.t, r.Storage.UpdateOfflineSessions(ctx, userID, connID,
+		func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+			old.ConnectorData = successor
+			return old, nil
+		}))
+	return session, nil
+}
