+// Clients holding a credential of their own do not interfere: each spends only
+// its own chain, and the shared credential is left to the clients without one.
+func TestUpstreamRotationOwnCredentialsAreIndependent(t *testing.T) {
+	const (
+		webClient, cliClient   = "webapp", "kubeconfig-generator"
+		webRefresh, cliRefresh = "web-refresh-id", "cli-refresh-id"
+	)
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, webClient, cliClient)
+
+	createRefreshToken(t, s, upstreamConnID, webRefresh, webClient, upstream.mint(), clk.now)
+	createRefreshToken(t, s, upstreamConnID, cliRefresh, cliClient, upstream.mint(), clk.now)
+	shared := upstream.mint()
+	createOfflineSession(t, s, upstreamConnID, map[string]string{webClient: webRefresh, cliClient: cliRefresh}, shared)
+
+	web, cli := requestToken(webRefresh), requestToken(cliRefresh)
+	for range 3 {
+		web = requireRefreshSucceeds(t, s, webClient, web)
+		cli = requireRefreshSucceeds(t, s, cliClient, cli)
+		clk.advance(5 * time.Minute)
