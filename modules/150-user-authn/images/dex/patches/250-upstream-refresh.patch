+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, upstream.mint(), clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, nil)
+
+	requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+
+	require.True(t, upstream.lastHasDeadline)
+	// Room for the API calls under the lock and for clocks that differ.
+	const margin = 5 * time.Second
+	assert.LessOrEqual(t, upstream.lastTimeLeft, kubernetesRefreshTokenLock-margin)
