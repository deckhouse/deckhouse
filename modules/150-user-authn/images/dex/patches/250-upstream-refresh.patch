diff --git a/connector/atlassiancrowd/atlassiancrowd_refresh_test.go b/connector/atlassiancrowd/atlassiancrowd_refresh_test.go
new file mode 100644
index 00000000..5811319f
--- /dev/null
+++ b/connector/atlassiancrowd/atlassiancrowd_refresh_test.go
@@ -0,0 +1,78 @@
+package atlassiancrowd
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/dexidp/dex/connector"
+)
+
+// A refresh tells a user that Crowd says is gone or may no longer sign in from
+// a Crowd that failed to answer: only the former is final.
+func TestRefreshIdentityGone(t *testing.T) {
+	const userPath = "/rest/usermanagement/1/user?username=jane"
+	const sessionPath = "/rest/usermanagement/1/session?validate-password=false"
+	active := TestServerResponse{Body: crowdUser{Key: "jane-key", Name: "jane", Active: true, Email: "jane@example.com"}, Code: 200}
+
+	tests := []struct {
+		name      string
+		responses map[string]TestServerResponse
+		isGone    bool
+	}{
+		{
+			name: "user deleted",
+			responses: map[string]TestServerResponse{
+				userPath: {Body: crowdAuthenticationError{Reason: "USER_NOT_FOUND", Message: "User <jane> does not exist"}, Code: 404},
+			},
+			isGone: true,
+		},
+		{
+			name: "user deactivated",
+			responses: map[string]TestServerResponse{
+				userPath:    active,
+				sessionPath: {Body: crowdAuthenticationError{Reason: "INACTIVE_ACCOUNT", Message: "Account is inactive"}, Code: 400},
+			},
+			isGone: true,
+		},
+		{
+			name: "not found by something in front of crowd",
+			responses: map[string]TestServerResponse{
+				userPath: {Body: "<html>Not Found</html>", Code: 404},
+			},
+		},
+		{
+			name: "crowd failing",
+			responses: map[string]TestServerResponse{
+				userPath: {Body: crowdAuthenticationError{Reason: "OPERATION_FAILED", Message: "test"}, Code: 500},
+			},
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			// Refresh builds its own HTTP client, so the test server speaks plain HTTP.
+			s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				response, ok := tc.responses[r.RequestURI]
+				if !ok {
+					response = TestServerResponse{Body: "unexpected request", Code: http.StatusTeapot}
+				}
+				w.Header().Add("Content-Type", "application/json")
+				w.WriteHeader(response.Code)
+				_ = json.NewEncoder(w).Encode(response.Body)
+			}))
+			defer s.Close()
+
+			c := newTestCrowdConnector(s.URL)
+			_, err := c.Refresh(context.Background(), connector.Scopes{}, connector.Identity{ConnectorData: []byte(`{"username":"jane"}`)})
+			if err == nil {
+				t.Fatal("expected the refresh to fail")
+			}
+			if got := errors.Is(err, connector.ErrIdentityGone); got != tc.isGone {
+				t.Errorf("errors.Is(%v, ErrIdentityGone) = %v, expected %v", err, got, tc.isGone)
+			}
+		})
+	}
+}
