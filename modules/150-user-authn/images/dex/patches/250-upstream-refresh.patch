 	return fmt.Sprintf("user %q is not in any of the required groups %v", e.UserID, e.Groups)
 }
 
+// ErrIdentityGone reports that the upstream provider answered that the user no
+// longer exists, or that the access dex holds for the user was revoked. Unlike a
+// provider that fails to answer, the answer is final: a connector returns it,
+// wrapped, from Refresh, and the server refuses the refresh with invalid_grant
+// rather than a server error, so the client asks the user to log in again.
+var ErrIdentityGone = errors.New("identity no longer valid upstream")
+
+// ErrRefreshRefused reports that the upstream provider answered the refresh, but
+// the answer cannot refresh the identity: the provider refused the request, gave
+// no refresh token to present, or returned an answer without the claims of the
+// user. Only a new login brings what the refresh lacks, so the server answers
+// invalid_grant, as for ErrIdentityGone, and the client asks the user to log in
+// again. A connector wraps it into the error of Refresh.
+var ErrRefreshRefused = errors.New("refresh refused upstream")
+
+// ErrUpstreamUnavailable reports that the upstream provider did not answer the
+// refresh: a connector wraps it when the failure is not a network error the
+// server recognizes by itself (see Unavailable).
+var ErrUpstreamUnavailable = errors.New("upstream provider unavailable")
+
+// Unavailable reports whether err says the upstream provider did not answer: the
+// connection failed or timed out, or the provider answered 408, 429 or a 5xx
+// status. Nothing is known about the user then, and the refresh may succeed later.
+// A 429 with access_denied is an answer about the user (see AccessDenied).
+func Unavailable(err error) bool {
+	if errors.Is(err, ErrUpstreamUnavailable) {
+		return true
+	}
+	var retrieveErr *oauth2.RetrieveError
+	if errors.As(err, &retrieveErr) {
+		if retrieveErr.Response == nil || AccessDenied(err) {
+			return false
+		}
+		status := retrieveErr.Response.StatusCode
+		return status == http.StatusRequestTimeout || status == http.StatusTooManyRequests ||
+			status >= http.StatusInternalServerError
+	}
+	// A failed connection (*url.Error) and a timeout (context.DeadlineExceeded)
+	// are both net.Error.
+	var netErr net.Error
+	return errors.As(err, &netErr) || errors.Is(err, context.Canceled)
+}
+
+// OAuth2Refusal reports whether err carries an error answer of an OAuth2 token
+// endpoint: a code of RFC 6749, section 5.2, or bad_refresh_token, which GitHub
+// answers instead of invalid_grant. The oauth2 package takes the code from any
+// JSON body with an "error" field, so the answer of a proxy in front of the
+// provider, such as {"status":403,"error":"Forbidden"} of a Spring gateway,
+// carries one too; such a code is no answer of the provider.
+func OAuth2Refusal(err error) bool {
+	var retrieveErr *oauth2.RetrieveError
+	return errors.As(err, &retrieveErr) && oauth2RefusalCodes[retrieveErr.ErrorCode]
+}
+
+// AccessDenied reports whether err carries an access_denied answer of an OAuth2
+// token endpoint with a 4xx status other than 401 and 408: the refusal of a locked
+// account by Deckhouse dex up to v1.78, HTTP 429 after failed password attempts
+// and 403 for the lock of an administrator. RFC 6749, section 5.2, has no
+// access_denied for the token endpoint, so the code comes from the provider and
+// not from a proxy in front of it. A 401 is left to the authentication of dex
+// itself as a client, a 408 to a request that got no answer.
+func AccessDenied(err error) bool {
+	var retrieveErr *oauth2.RetrieveError
+	if !errors.As(err, &retrieveErr) || retrieveErr.Response == nil || retrieveErr.ErrorCode != "access_denied" {
+		return false
+	}
+	status := retrieveErr.Response.StatusCode
+	return status >= http.StatusBadRequest && status < http.StatusInternalServerError &&
+		status != http.StatusUnauthorized && status != http.StatusRequestTimeout
+}
+
+var oauth2RefusalCodes = map[string]bool{
+	"invalid_request":        true,
+	"invalid_client":         true,
+	"invalid_grant":          true,
+	"unauthorized_client":    true,
+	"unsupported_grant_type": true,
+	"invalid_scope":          true,
+	"bad_refresh_token":      true,
+}
+
 // Connector is a mechanism for federating login to a remote identity service.
 //
 // Implementations are expected to implement either the PasswordConnector or
@@ -113,6 +198,31 @@ type RefreshConnector interface {
 	Refresh(ctx context.Context, s Scopes, identity Identity) (Identity, error)
 }
 
+// RefreshCredentialReporter is implemented by a refresh connector whose connector
+// data may lack the credential a refresh spends (Deckhouse): an OAuth2 provider
+// answers a login without a refresh token when the user did not consent to
+// offline access again, as Google does. The server keeps one credential per user
+// and connector for every client of the user, and a login replaces it only with
+// data that can refresh. The data of a connector that does not implement it
+// counts as such a credential whenever it is not empty.
+type RefreshCredentialReporter interface {
+	HasRefreshCredential(connectorData []byte) bool
+}
+
+// RefreshedError is returned by Refresh when the provider issued new connector
+// data, a rotated refresh token, and a later step of the refresh failed, such as
+// reading the user or its groups (Deckhouse). A provider that rotates refresh
+// tokens has spent the presented one by then, so the server keeps ConnectorData
+// in its place although the refresh fails with Err.
+type RefreshedError struct {
+	ConnectorData []byte
+	Err           error
+}
+
+func (e *RefreshedError) Error() string { return e.Err.Error() }
+
+func (e *RefreshedError) Unwrap() error { return e.Err }
+
