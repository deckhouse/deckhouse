+// A login gives its credential to the refresh token it issues and leaves the
+// credential of the offline session alone: publishing it would hand one single-use
+// credential to every client of the user.
+func TestUpstreamRotationLoginKeepsSharedCredential(t *testing.T) {
+	const clientID = "kubeconfig-generator"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	shared := upstream.mint()
+	createOfflineSession(t, s, upstreamConnID, nil, shared)
+
+	obtained := upstream.mint()
+	issued := exchangeAuthCode(t, s, clientID, obtained, clk.now)
