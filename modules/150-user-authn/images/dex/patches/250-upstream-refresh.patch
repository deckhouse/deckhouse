+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, upstream.mint())
+
+	token := requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+	requireSessionCredentialValid(t, s, upstream)
+
+	clk.advance(5 * time.Minute)
+	requireRefreshSucceeds(t, s, clientID, token)
+}
+
+// samlUpstream refreshes the way the SAML connector does: it replays the
+// identity cached at a login, which is no credential and is never refused.
+type samlUpstream struct{}
+
+func (samlUpstream) POSTData(connector.Scopes, string) (string, string, error) {
+	return "", "", nil
+}
+
+func (samlUpstream) HandlePOST(connector.Scopes, string, string) (connector.Identity, error) {
+	return connector.Identity{}, nil
+}
+
+func (samlUpstream) Refresh(_ context.Context, _ connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	var cached struct {
+		Groups []string `json:"groups"`
+	}
+	if err := json.Unmarshal(ident.ConnectorData, &cached); err != nil {
+		return ident, fmt.Errorf("saml: unmarshal cached identity: %v", err)
+	}
+	ident.Groups = cached.Groups
+	return ident, nil
+}
+
+// The connector data of SAML is the identity of a login. The offline session
+// holds the latest login's, and every refresh token refreshes to it, whatever
+// copy it got at its own login (D10); a copy only stands in for a session that
+// has none, and moves there.
+func TestUpstreamRefreshSAMLFollowsLatestLogin(t *testing.T) {
+	loginA := []byte(`{"groups":["login-a"]}`)
+	loginB := []byte(`{"groups":["login-b"]}`)
+
+	tests := []struct {
+		name          string
+		own, shared   []byte
+		expected      []string
+		expectedShare []byte
+	}{
+		{name: "another client logged in since", own: loginA, shared: loginB, expected: []string{"login-b"}, expectedShare: loginB},
+		{name: "the session has none", own: loginA, expected: []string{"login-a"}, expectedShare: loginA},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+			clk := &testClock{now: time.Now()}
+			httpServer, s := newTestServer(t, rotatingPolicy(clk))
+			defer httpServer.Close()
+
+			registerUpstreamConnector(t, s, upstreamConnID, samlUpstream{})
+			registerClients(t, s, clientID)
+			createRefreshToken(t, s, upstreamConnID, refreshID, clientID, tc.own, clk.now)
+			createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, tc.shared)
