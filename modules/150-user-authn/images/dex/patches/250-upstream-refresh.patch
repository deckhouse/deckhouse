+// The code exchange leaves the credential of the offline session alone: the
+// login put its credential there when it finished (authflow), and a refresh of
+// another client may have rotated it since, which the exchange must not undo.
+// The issued token keeps no copy: it would be spent as soon as another client
+// refreshes.
+func TestUpstreamRotationLoginKeepsSharedCredential(t *testing.T) {
+	const clientID = "kubeconfig-generator"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	shared := upstream.mint()
+	createOfflineSession(t, s, upstreamConnID, nil, shared)
+
+	obtained := upstream.mint()
+	issued := exchangeAuthCode(t, s, clientID, obtained, clk.now)
+
+	stored, err := s.storage.GetRefresh(t.Context(), issued.RefreshId)
+	require.NoError(t, err)
+	require.Empty(t, stored.ConnectorData, "the issued token holds no copy of the credential")
+
+	session, err := s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+	require.NoError(t, err)
+	require.Equal(t, shared, session.ConnectorData, "the code exchange does not replace the credential other clients rely on")
+}
