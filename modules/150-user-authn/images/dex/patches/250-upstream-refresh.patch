diff --git a/server/tokens/refresh_upstream.go b/server/tokens/refresh_upstream.go
new file mode 100644
index 00000000..da98493b
--- /dev/null
+++ b/server/tokens/refresh_upstream.go
@@ -0,0 +1,903 @@
+package tokens
+
+// refresh_upstream.go refreshes the identity of a refresh token through the
+// upstream connector and keeps the upstream credential it spends in one place.
+//
+// Providers that rotate refresh tokens (GitLab, GitHub, OIDC providers with
+// rotation) invalidate the presented credential as soon as it is used, and some
+// of them (Auth0, Okta, Keycloak) revoke every credential of the grant when a
+// spent one is presented again. For the provider dex is one client with one
+// grant per user, so the offline session of the user keeps one credential for
+// every client of the user. It is spent by one request at a time, under a lease
+// on the offline session that every replica honours, and its successor goes back
+// to the offline session before the lease ends. A refresh token keeps no copy:
+// a copy is spent the moment another client refreshes, and presenting it then is
+// the reuse those providers punish.
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"slices"
+	"strings"
+	"time"
+
+	"golang.org/x/oauth2"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/storage"
+)
+
+const (
+	// UpstreamRefreshTimeout bounds an upstream refresh, which runs detached
+	// from the request so that a client that hangs up does not lose a rotated
+	// credential.
+	UpstreamRefreshTimeout = 5 * time.Second
+
+	// publishTimeout bounds each write that follows an upstream refresh and
+	// keeps its result: the offline session with the successor of the
+	// credential, the claims read, the refresh token and the offline session
+	// with its last use, which releases the lease. It bounds a renewal of the
+	// lease and its release too. A storage that ignores the context (the
+	// Kubernetes one) takes as long as it takes; the renewal of the lease keeps
+	// the lease meanwhile.
+	publishTimeout = 3 * time.Second
+
+	// leaseClockMargin is the room left for the wall clocks of the replicas,
+	// which decide when a lease ends, to differ.
+	leaseClockMargin = 2 * time.Second
+
+	// DefaultUpstreamLeaseTTL is RefreshStore.UpstreamLeaseTTL unless
+	// configured. The holder renews the lease every third of it for as long as
+	// it holds it, so it bounds no request: it is how long a holder that died
+	// keeps the others waiting, and how long renewals may fail before another
+	// request takes the lease over. It is long enough for the upstream call and
+	// one write after it, with room for the clocks of the replicas to differ.
+	DefaultUpstreamLeaseTTL = UpstreamRefreshTimeout + publishTimeout + leaseClockMargin
+
+	// DefaultUpstreamPollPeriod is RefreshStore.UpstreamPollPeriod unless
+	// configured.
+	DefaultUpstreamPollPeriod = 50 * time.Millisecond
+
+	// sharedCredentialRetries is how often a request whose credential another
+	// Dex spent meanwhile retries with the successor that Dex published. Only a
+	// Dex that does not take the lease (an older version during a rollout, or a
+	// storage that does not keep the lease) can spend it under this request.
+	sharedCredentialRetries = 2
+
+	// persistTimeout bounds the writes that keep a rotated credential when the
+	// request is failing anyway, outside a lease.
+	persistTimeout = 10 * time.Second
+)
+
+// UpstreamRefresh re-reads an identity from the upstream connector, offering it
+// the upstream credential in ident.ConnectorData. The identity it returns carries
+// the credential that replaces the offered one when the provider rotated it.
+type UpstreamRefresh func(ctx context.Context, ident connector.Identity) (connector.Identity, error)
+
+// Upstream is the connector a refresh token is refreshed through.
+type Upstream struct {
+	// Refresh re-reads the identity; nil when the connector cannot refresh
+	// identities, and the stored claims are kept then.
+	Refresh UpstreamRefresh
+	// IsLoginIdentity is set when the connector data is the identity of the login
+	// that obtained it rather than a credential (SAML, which replays it). The
+	// offline session holds the latest login's, and every client refreshes to it;
+	// a copy on a refresh token only stands in for a session that has none.
+	IsLoginIdentity bool
+
+	// Stored, when set, returns the identity dex stores for the pair while it is
+	// fresh enough to be served without the connector (Deckhouse). It is asked
+	// again once the lease is taken: a request that waited for the lease is
+	// served the identity the holder has just read instead of spending the
+	// credential again.
+	Stored func(ctx context.Context) (connector.Identity, bool)
+	// Read, when set, is told of an identity read from the connector while the
+	// request still holds the lease (Deckhouse), so that it stores it before the
+	// requests waiting for the lease look for it (Stored).
+	Read func(ctx context.Context, ident connector.Identity)
+	// NeedsCredential is set when the connector refreshes only with a
+	// credential of its own in the connector data (OIDC, GitLab; see
+	// connector.RefreshCredentialReporter): without one it is not asked
+	// (Deckhouse).
+	NeedsCredential bool
+}
+
+// errNoUpstreamCredential refuses the refresh of a pair that holds no
+// credential for a connector that needs one: the provider refused it, or the
+// login issued none. Only a login brings one (Deckhouse).
+var errNoUpstreamCredential = fmt.Errorf("no upstream credential stored: %w", connector.ErrRefreshRefused)
+
+// UpstreamError reports that the upstream connector did not refresh the
+// identity. Refused is set when the provider answered for every credential
+// offered and no answer refreshes the identity: the user is gone or its access
+// was revoked, the provider refused the credential or the request, or its
+// answer lacks the user (see refreshRefused). Unavailable is set when the
+// provider did not answer for at least one of them and refused the others (see
+// connector.Unavailable), when it refused dex itself as a client (see
+// clientRefused), or when other requests kept the credential busy: the refresh
+// may succeed later. Neither is set for a failure the connector does not
+// explain.
+type UpstreamError struct {
+	Refused     bool
+	Unavailable bool
+	Err         error
+}
+
+func (e *UpstreamError) Error() string { return "upstream refresh: " + e.Err.Error() }
+
+func (e *UpstreamError) Unwrap() error { return e.Err }
+
+var (
+	// errCredentialMoved reports that the credential a request spent is no
+	// longer the stored one, so its successor is not the one to store either.
+	errCredentialMoved = errors.New("upstream credential already rotated")
+
+	// errNotPrepared reports that a refresh token turned out to need a new
+	// identity after the request decided it did not: the connector is called
+	// before the storage transaction, never inside it.
+	errNotPrepared = errors.New("upstream identity not read before the update")
+
+	// errCredentialNotReplaced reports that the credential of the offline
+	// session is still one the provider refused to this request.
+	errCredentialNotReplaced = errors.New("refused upstream credential not replaced")
+)
+
+// credentialSource is the storage object an upstream credential was read from.
+type credentialSource int
+
+const (
+	// credentialFromToken is the credential a refresh token issued before the
+	// offline session kept the only one holds. It is offered only while the
+	// session has none, and its successor goes to the session.
+	credentialFromToken credentialSource = iota
+	// credentialFromSession is held by the offline session of the user, where
+	// every client of the user spends it in turn.
+	credentialFromSession
+)
+
+func (c credentialSource) String() string {
+	if c == credentialFromToken {
+		return "refresh_token"
+	}
+	return "offline_session"
+}
+
+// credentialRef is an upstream credential together with the object holding it.
+type credentialRef struct {
+	data   []byte
+	source credentialSource
+}
+
+// identitySource supplies the identity a refresh token is rotated to.
+type identitySource interface {
+	// identity returns the refreshed identity, starting from base (the stored
+	// claims). It runs inside the storage transaction, which a storage may run
+	// more than once, so every call after the first returns the first result.
+	identity(ctx context.Context, base connector.Identity) (connector.Identity, error)
+	// spent reports the upstream credential the provider consumed, the
+	// credential that replaces it and where the spent one was read from; ok is
+	// false when no credential was spent.
+	spent() (credential credentialRef, successor []byte, ok bool)
+	// lease returns the lease the credential was spent under, nil for none.
+	lease() *upstreamLease
+}
+
+// storedIdentity is an identity that needs no upstream credential, such as the
+// claims stored at the last login. It spends nothing, so the stored credential
+// is left alone.
+type storedIdentity func(context.Context) (connector.Identity, error)
+
+func (f storedIdentity) identity(ctx context.Context, _ connector.Identity) (connector.Identity, error) {
+	return f(ctx)
+}
+
+func (storedIdentity) spent() (credentialRef, []byte, bool) { return credentialRef{}, nil, false }
+
+func (storedIdentity) lease() *upstreamLease { return nil }
+
+// upstreamRefresher refreshes the identity through the connector, offering the
+// credentials in order until one is accepted, and contacts the connector on the
+// first call only: a storage that retries its updater (the Kubernetes storage
+// does on conflicts) must not make it spend an already rotated credential again.
+type upstreamRefresher struct {
+	refresh     UpstreamRefresh // nil when the connector cannot refresh
+	credentials []credentialRef
+	logger      *slog.Logger
+	connectorID string
+
+	// leased is the lease the credential is spent under, nil for none.
+	leased *upstreamLease
+	// mustPrepare is set when the connector is called by prepare, before any
+	// storage transaction, and identity only returns its result.
+	mustPrepare bool
+	// needsCredential is Upstream.NeedsCredential.
+	needsCredential bool
+
+	isDone bool
+	ident  connector.Identity
+	err    error
+
+	// spentRef is the credential the provider consumed and successor the one
+	// that replaces it, valid when isSpent: accepted, or rotated before the
+	// connector failed (connector.RefreshedError).
+	isSpent   bool
+	spentRef  credentialRef
+	successor []byte
+
+	// last is the last credential offered. isRefused records that the provider
+	// refused it as invalid, expired or revoked, as opposed to failing to answer:
+	// only a refusal says anything about the credential.
+	last      credentialRef
+	isRefused bool
+}
+
+func (u *upstreamRefresher) identity(ctx context.Context, base connector.Identity) (connector.Identity, error) {
+	if !u.isDone && u.mustPrepare {
+		return base, errNotPrepared
+	}
+	return u.prepare(ctx, base)
+}
+
+// prepare calls the connector, once.
+func (u *upstreamRefresher) prepare(ctx context.Context, base connector.Identity) (connector.Identity, error) {
+	if u.isDone {
+		return u.ident, u.err
+	}
+	u.isDone = true
+	u.ident = base
+	if u.refresh == nil {
+		return u.ident, nil
+	}
+
+	candidates := u.credentials
+	if len(candidates) == 0 {
+		if u.needsCredential {
+			// Nothing to refresh with, and the connector would only fail to read
+			// the empty connector data: refused as it would refuse, without a
+			// line about a failed refresh in the log.
+			u.err = &UpstreamError{Refused: true, Err: errNoUpstreamCredential}
+			return u.ident, u.err
+		}
+		// Refresh even without a credential, so that a connector that needs none
+		// still gets to refuse an identity that is gone upstream. The offline
+		// session is where a credential made out of nothing is kept.
+		candidates = []credentialRef{{source: credentialFromSession}}
+	}
+
+	allRefused := true
+	var anyUnavailable, anyUnexplained bool
+	var lastErr error
+	for _, credential := range candidates {
+		offered := base
+		offered.ConnectorData = credential.data
+		u.last = credential
+
+		ident, err := u.refresh(ctx, offered)
+		if err == nil {
+			// A credential refused before this one leaves no trace: this result is
+			// what every later run of the updater gets.
+			u.ident, u.isSpent, u.spentRef, u.successor = ident, true, credential, ident.ConnectorData
+			u.isRefused, u.err = false, nil
+			return u.ident, nil
+		}
+
+		unavailable := connector.Unavailable(err) || clientRefused(err)
+
+		u.logger.ErrorContext(ctx, "failed to refresh identity",
+			"connector_id", u.connectorID, "credential_source", credential.source.String(), "err", err)
+		// A provider that did not answer, or refused dex itself, said nothing
+		// about the credential.
+		u.isRefused = credentialRefused(err) && !unavailable
+		switch {
+		case unavailable:
+			allRefused, anyUnavailable = false, true
+		case refreshRefused(err) || len(u.credentials) == 0:
+			// With no credential to offer, nothing but a login can refresh the
+			// identity, whatever the connector says.
+		default:
+			allRefused, anyUnexplained = false, true
+		}
+		lastErr = err
+
+		var refreshed *connector.RefreshedError
+		if errors.As(err, &refreshed) && len(refreshed.ConnectorData) > 0 {
+			// The provider rotated the credential before the connector failed:
+			// it is spent, and its successor is the only one left to offer.
+			u.isSpent, u.spentRef, u.successor = true, credential, refreshed.ConnectorData
+			break
+		}
+	}
+
+	u.err = &UpstreamError{Refused: allRefused, Unavailable: anyUnavailable && !anyUnexplained, Err: lastErr}
+	return u.ident, u.err
+}
+
+func (u *upstreamRefresher) spent() (credentialRef, []byte, bool) {
+	return u.spentRef, u.successor, u.isSpent
+}
+
+func (u *upstreamRefresher) lease() *upstreamLease { return u.leased }
+
+// credentialRefused reports whether the provider refused the credential offered
+// to it as invalid, expired or revoked, rather than failing to answer: RFC 6749
+// invalid_grant, or bad_refresh_token, which GitHub answers instead. Only such a
+// refusal lets dex treat a stored credential as dead.
+//
+// Dex up to v2.45 answers a refresh token it no longer holds, ended at a newer
+// login of the user or already rotated, with 400 invalid_request and the
+// description "Refresh token is invalid or has already been claimed by another
+// client." instead of invalid_grant, so that answer counts too. Any other
+// invalid_request is a request the provider could not read, and says nothing
+// about the credential.
+func credentialRefused(err error) bool {
+	var retrieveErr *oauth2.RetrieveError
+	if !errors.As(err, &retrieveErr) {
+		return false
+	}
+	switch retrieveErr.ErrorCode {
+	case "invalid_grant":
+		return !lockRefusal(retrieveErr)
+	case "bad_refresh_token":
+		return true
+	case "invalid_request":
+		return retrieveErr.Response != nil && retrieveErr.Response.StatusCode == http.StatusBadRequest &&
+			strings.Contains(retrieveErr.ErrorDescription, "already been claimed")
+	}
+	return false
+}
+
+// lockRefusal reports whether retrieveErr is the refusal of a locked account by
+// Deckhouse Dex (Deckhouse): invalid_grant with the description of the lock,
+// "Account locked" or "Account locked by an administrator" (server/grants
+// refreshRefusal; 1.77 answers the first with its patch 019). It refuses the
+// refresh, but the credential is alive and serves again once the lock ends: it
+// is not dropped, and no rotation by another Dex is waited for. Only the exact
+// descriptions of Dex count, as the "already been claimed" of invalid_request
+// does; any other invalid_grant is a dead credential.
+func lockRefusal(retrieveErr *oauth2.RetrieveError) bool {
+	switch retrieveErr.ErrorDescription {
+	case "Account locked", "Account locked by an administrator":
+		return true
+	}
+	return false
+}
+
+// clientRefused reports whether the provider refused dex itself as its client
+// rather than the credential of the user: RFC 6749 invalid_client, or any OAuth2
+// error answered with 401, which section 5.2 reserves for a client that failed
+// to authenticate. Its client secret was rotated at the provider before dex was
+// told, or the client was disabled there: every user gets the same answer, and
+// nothing the user does fixes it. The refresh is answered as one the provider
+// did not answer, so the tokens of the users are kept for when dex is fixed.
+func clientRefused(err error) bool {
+	var retrieveErr *oauth2.RetrieveError
+	if !errors.As(err, &retrieveErr) {
+		return false
+	}
+	if retrieveErr.ErrorCode == "invalid_client" {
+		return true
+	}
+	return retrieveErr.Response != nil && retrieveErr.Response.StatusCode == http.StatusUnauthorized &&
+		connector.OAuth2Refusal(err)
+}
+
+// identityRefused reports whether the provider gave a final answer that the
+// identity cannot be refreshed: its credential is refused, the user is gone or
+// the access was revoked, or the user left the groups the connector requires.
+func identityRefused(err error) bool {
+	var groupsErr *connector.UserNotInRequiredGroupsError
+	return credentialRefused(err) || errors.Is(err, connector.ErrIdentityGone) || errors.As(err, &groupsErr)
+}
+
+// refreshRefused reports whether the provider answered the refresh and the answer
+// cannot refresh the identity until the user logs in again: a final refusal of the
+// identity, a 4xx answer to the token request with an OAuth2 error of the
+// provider (connector.OAuth2Refusal: RFC 6749, section 5.2, and
+// bad_refresh_token) in its body, the refusal of a locked account by an older
+// Deckhouse dex (connector.AccessDenied), or a connector that marked its failure
+// as connector.ErrRefreshRefused (Deckhouse). A 4xx without such an error, the
+// {"error":"Forbidden"} of a gateway among them, comes from a proxy in front of
+// the provider and is no answer about the user, and a 408 or a 429 is no answer
+// at all: connector.Unavailable, checked first, takes them, as clientRefused
+// takes a refusal of dex itself.
+func refreshRefused(err error) bool {
+	if identityRefused(err) || connector.AccessDenied(err) || errors.Is(err, connector.ErrRefreshRefused) {
+		return true
+	}
+	var retrieveErr *oauth2.RetrieveError
+	if !errors.As(err, &retrieveErr) || retrieveErr.Response == nil || !connector.OAuth2Refusal(err) {
+		return false
+	}
+	status := retrieveErr.Response.StatusCode
+	return status >= http.StatusBadRequest && status < http.StatusInternalServerError
+}
+
+// RotateUpstream is Rotate with the identity refreshed through the upstream
+// connector.
+//
+// The credential spent is the one of the offline session, under its lease; a
+// refresh token issued before the session kept the only credential offers its
+// own while the session has none. A request whose credential another Dex
+// spent meanwhile (one that does not take the lease) continues from the
+// credential that Dex published; a credential the provider refused and nobody
+// rotated is dropped, so that the next login of any client restores it for all
+// of them.
+//
+// A failed refresh returns an *UpstreamError.
+func (rt *RefreshStore) RotateUpstream(ctx context.Context, storageToken *storage.RefreshToken, requestToken *internal.RefreshToken, strategy *RefreshStrategy, upstream Upstream) (string, connector.Identity, error) {
+	if upstream.Refresh == nil || upstream.IsLoginIdentity {
+		// Nothing single-use is spent: no lease.
+		return rt.rotateReplayed(ctx, storageToken, requestToken, strategy, upstream)
+	}
+
+	// A refresh within the reuse interval reads no identity: it needs no lease,
+	// and does not wait for one.
+	if !mints(*storageToken, requestToken, strategy) {
+		rawToken, ident, err := rt.rotate(ctx, storageToken, requestToken, strategy, &upstreamRefresher{mustPrepare: true})
+		if !errors.Is(err, errNotPrepared) {
+			return rawToken, ident, err
+		}
+	}
+
+	lease := rt.newUpstreamLease(storageToken)
+	defer lease.release(ctx)
+
+	var tried [][]byte // shared credentials the provider refused to this request
+	for attempt := 0; ; attempt++ {
+		rawToken, ident, refresher, err := rt.rotateLeased(ctx, lease, storageToken, requestToken, strategy, upstream, tried)
+		if err == nil || refresher == nil {
+			return rawToken, ident, err
+		}
+
+		if refresher.isRefused && refresher.last.source == credentialFromToken {
+			// The own credential of an old refresh token is dead: it is never
+			// offered again.
+			rt.retireDeadOwnCredential(ctx, storageToken, refresher.last.data)
+			return "", ident, err
+		}
+
+		// Only the provider refusing the shared credential is worth another
+		// attempt: another Dex may have spent it under this request. A provider
+		// that failed to answer says nothing about the credential.
+		lostRace := refresher.isRefused && refresher.last.source == credentialFromSession && len(refresher.last.data) > 0
+		if !lostRace {
+			return "", ident, err
+		}
+		tried = append(tried, refresher.last.data)
+		if attempt == sharedCredentialRetries {
+			// The shared credential kept moving under this request: other clients
+			// of the user are spending it, so it is alive and the refusal is not
+			// the provider's last word about the user.
+			return "", ident, notFinal(err)
+		}
+
+		// The wait is part of the critical section, under the lease, which is
+		// kept alive meanwhile: the requests of this Dex waiting for it would
+		// offer the refused credential again.
+		if !lease.valid() {
+			return "", ident, notFinal(err)
+		}
+		if !rt.awaitRotatedCredential(ctx, storageToken, tried) {
+			// Nobody rotated it: the credential is dead, not merely spent by
+			// another Dex.
+			rt.retireDeadSharedCredential(ctx, storageToken, refresher.last.data)
+			return "", ident, err
+		}
+	}
+}
+
+// rotateLeased is one attempt of RotateUpstream: it takes the lease, reads the
+// credential under it, calls the connector when the token is due a new
+// identity, publishes the successor of the credential, stores the claims read,
+// rotates the token and releases the lease with the last write. refresher is
+// nil when the connector was not asked.
+func (rt *RefreshStore) rotateLeased(ctx context.Context, lease *upstreamLease, storageToken *storage.RefreshToken, requestToken *internal.RefreshToken, strategy *RefreshStrategy, upstream Upstream, tried [][]byte) (string, connector.Identity, *upstreamRefresher, error) {
+	stored := IdentityFromClaims(storageToken.Claims)
+
+	// A pass starts over when the token moved on between deciding that it
+	// needs a new identity and the update (a refresh at the end of the reuse
+	// interval), or when the lease was lost before the connector call.
+	for pass := 0; ; pass++ {
+		session, err := lease.acquire(ctx, storageToken.ConnectorData)
+		switch {
+		case err == nil, errors.Is(err, errNothingToLease), errors.Is(err, storage.ErrNotFound):
+			// Without a credential to spend there is nothing to lease: a connector
+			// that keeps none (local users) neither writes nor waits.
+		default:
+			return "", stored, nil, err
+		}
+
+		if upstream.Stored != nil {
+			if ident, ok := upstream.Stored(ctx); ok {
+				// The request this one waited for has read the identity.
+				lease.release(ctx)
+				rawToken, ident, err := rt.Rotate(ctx, storageToken, requestToken, strategy,
+					func(context.Context) (connector.Identity, error) { return ident, nil })
+				return rawToken, ident, nil, err
+			}
+		}
+
+		token, isGone := *storageToken, false
+		switch current, err := rt.storage.GetRefresh(ctx, storageToken.ID); {
+		case err == nil:
+			token = current
+		case errors.Is(err, storage.ErrNotFound):
+			// Revoked meanwhile: the update below says so, and nothing is spent.
+			isGone = true
+		default:
+			rt.logger.ErrorContext(ctx, "failed to get refresh token", "err", err)
+			return "", stored, nil, fmt.Errorf("get refresh token: %w", err)
+		}
+
+		credentials := upstreamCredentials(token, session, false)
+		if len(credentials) > 0 && credentials[0].source == credentialFromSession &&
+			slices.ContainsFunc(tried, func(c []byte) bool { return bytes.Equal(c, credentials[0].data) }) {
+			// Never offered twice: a spent credential presented again is what a
+			// provider that detects reuse revokes the whole grant for.
+			return "", stored, nil, &UpstreamError{Unavailable: true, Err: errCredentialNotReplaced}
+		}
+
+		refresher := &upstreamRefresher{
+			refresh:     upstream.Refresh,
+			credentials: credentials,
+			logger:      rt.logger,
+			connectorID: storageToken.ConnectorID,
+			leased:      lease,
+			mustPrepare: true,
+		}
+		refresher.needsCredential = upstream.NeedsCredential
+
+		if isGone || !mints(token, requestToken, strategy) {
+			// Served from the token without a new identity, or refused.
+			rawToken, ident, err := rt.rotate(ctx, storageToken, requestToken, strategy, refresher)
+			if errors.Is(err, errNotPrepared) && pass < maxLeasedPasses {
+				continue
+			}
+			return rawToken, ident, nil, err
+		}
+
+		// The credential was read when the lease was taken. A lease lost since
+		// (renewals that failed for a whole lease time, a request stalled as
+		// long) may have let another request spend it and publish its
+		// successor: the request starts over from the offline session as it is
+		// now, which the next lease brings, rather than present a credential
+		// that may be spent. Failing instead would cost the client a retry for
+		// a credential that is most likely alive.
+		if lease.isTaken() && !lease.valid() {
+			if pass < maxLeasedPasses {
+				continue
+			}
+			return "", stored, nil, &UpstreamError{Unavailable: true, Err: errLeaseLost}
+		}
+		ident, err := refresher.prepare(ctx, stored)
+
+		// The provider has spent the credential: what it answered is kept even
+		// when the client hangs up, by writes with a time of their own each.
+		if err != nil {
+			rt.persistRotatedCredential(ctx, storageToken, refresher)
+			return "", ident, refresher, err
+		}
+		// The successor first: until this write the credential other requests
+		// would read is spent. Then the claims, still under the lease, so that a
+		// request waiting for it is served them (Stored) instead of spending
+		// the successor at once. The lease goes with the last write
+		// (updateOfflineSession).
+		rt.publishSuccessor(ctx, storageToken, refresher)
+		if upstream.Read != nil {
+			rctx, cancel := detached(ctx, publishTimeout)
+			upstream.Read(rctx, ident)
+			cancel()
+		}
+		rctx, cancel := detached(ctx, publishTimeout)
+		defer cancel()
+		rawToken, ident, err := rt.rotate(rctx, storageToken, requestToken, strategy, refresher)
+		return rawToken, ident, refresher, err
+	}
+}
+
+// maxLeasedPasses bounds the passes of rotateLeased that start over.
+const maxLeasedPasses = 2
+
+// publishSuccessor stores the successor of a spent credential in the offline
+// session, with the guards of updateOfflineSession, which repeats the
+// publication with the last use of the token and finds it done. A provider
+// that answered with the presented credential (no rotation) changed nothing to
+// publish, and nothing is written.
+func (rt *RefreshStore) publishSuccessor(ctx context.Context, token *storage.RefreshToken, src identitySource) {
+	spent, successor, isSpent := src.spent()
+	if !isSpent || len(successor) == 0 || bytes.Equal(successor, spent.data) {
+		return
+	}
+	ctx, cancel := detached(ctx, publishTimeout)
+	defer cancel()
+	err := rt.storage.UpdateOfflineSessions(ctx, token.Claims.UserID, token.ConnectorID,
+		func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+			publishSpent(&old, src)
+			return old, nil
+		})
+	if err != nil && !errors.Is(err, storage.ErrNotFound) {
+		// updateOfflineSession, or persistRotatedCredential, tries again.
+		rt.logger.ErrorContext(ctx, "failed to publish the rotated upstream credential", "err", err)
+	}
+}
+
+// publishSpent puts the successor of the credential src spent into the offline
+// session o, only while o still holds the spent credential, or none: a request
+// that lost the race to this one may have dropped it as dead, and the own
+// credential of an old token stands in for a session that has none. Anything
+// else means a concurrent login has moved the shared credential on, and ours
+// is the stale duplicate.
+func publishSpent(o *storage.OfflineSessions, src identitySource) {
+	spent, successor, isSpent := src.spent()
+	holdsSpent := len(o.ConnectorData) == 0 || bytes.Equal(o.ConnectorData, spent.data)
+	if isSpent && len(successor) > 0 && holdsSpent {
+		o.ConnectorData = successor
+	}
+}
+
+// rotateReplayed rotates a token of a connector whose refresh spends nothing:
+// SAML replays the identity of a login, and a connector without Refresh keeps
+// the stored claims.
+func (rt *RefreshStore) rotateReplayed(ctx context.Context, storageToken *storage.RefreshToken, requestToken *internal.RefreshToken, strategy *RefreshStrategy, upstream Upstream) (string, connector.Identity, error) {
+	session, err := rt.storage.GetOfflineSessions(ctx, storageToken.Claims.UserID, storageToken.ConnectorID)
+	if err != nil && !errors.Is(err, storage.ErrNotFound) {
+		rt.logger.ErrorContext(ctx, "failed to get offline session", "err", err)
+		return "", IdentityFromClaims(storageToken.Claims), fmt.Errorf("get offline session: %w", err)
+	}
+	refresher := &upstreamRefresher{
+		refresh:     upstream.Refresh,
+		credentials: upstreamCredentials(*storageToken, session, upstream.IsLoginIdentity),
+		logger:      rt.logger,
+		connectorID: storageToken.ConnectorID,
+	}
+	return rt.rotate(ctx, storageToken, requestToken, strategy, refresher)
+}
+
+// mints reports whether rotating old with requestToken under strategy reads a
+// new identity, as the updater of rotate decides it.
+func mints(old storage.RefreshToken, requestToken *internal.RefreshToken, strategy *RefreshStrategy) bool {
+	switch {
+	case strategy.AllowedToReuse(old.LastUsed):
+		return false
+	case strategy.RotationEnabled():
+		return old.Token == requestToken.Token
+	}
+	return true
+}
+
+// notFinal turns a refusal into a failure that says nothing about the user and
+// may pass: the credential is alive, other clients are spending it.
+func notFinal(err error) error {
+	var upstreamErr *UpstreamError
+	if errors.As(err, &upstreamErr) {
+		return &UpstreamError{Unavailable: true, Err: upstreamErr.Err}
+	}
+	return err
+}
+
+// upstreamCredentials returns the upstream credential a refresh offers: the one
+// of the offline session, or the token's own while the session has none. Only
+// a refresh token issued before the offline session kept the only credential
+// holds one of its own; a copy of the shared credential it may hold is spent as
+// soon as another client refreshes, and is never offered next to it.
+//
+// The identity of a login (isLoginIdentity) is offered from the session, where
+// the latest login put it; the token's copy stands in for a session that has
+// none and moves there, as the session is the one place it is kept.
+func upstreamCredentials(token storage.RefreshToken, session storage.OfflineSessions, isLoginIdentity bool) []credentialRef {
+	switch {
+	case len(session.ConnectorData) > 0:
+		return []credentialRef{{data: session.ConnectorData, source: credentialFromSession}}
+	case len(token.ConnectorData) == 0:
+		return nil
+	case isLoginIdentity:
+		return []credentialRef{{data: token.ConnectorData, source: credentialFromSession}}
+	}
+	return []credentialRef{{data: token.ConnectorData, source: credentialFromToken}}
+}
+
+// maxPollFactor caps the backoff of a wait: it looks again at most every
+// maxPollFactor poll periods, 500 ms by default.
+const maxPollFactor = 10
+
+// pollsWithin is how many times a request waiting up to wait looks: the first
+// look and one after each pause of the backoff (see pollDelay) until the pauses
+// cover wait. It ends a wait whose clock does not move (tests); on a moving
+// clock the deadline ends it first.
+func pollsWithin(wait, period time.Duration) int {
+	if period <= 0 {
+		return 1
+	}
+	looks, slept := 1, time.Duration(0)
+	for d := period; slept < wait; d = min(2*d, maxPollFactor*period) {
+		slept += d
+		looks++
+	}
+	return looks
+}
+
+// pollDelay is the pause of a wait before its look after look (0 for the
+// first), backing off (Deckhouse): UpstreamPollPeriod, twice that, and so on up
+// to maxPollFactor periods, never past deadline. Each look reads the storage,
+// and a waiter looking every 50 ms made about 200 reads to the Kubernetes API
+// in a lease time, about 20 a second for every waiting client of every pair
+// while a provider is slow; the backoff makes it 24. A lease released is
+// noticed at most one pause late, 500 ms at the most.
+func (rt *RefreshStore) pollDelay(look int, deadline time.Time) time.Duration {
+	d := rt.UpstreamPollPeriod
+	for range look {
+		if d >= maxPollFactor*rt.UpstreamPollPeriod {
+			break
+		}
+		d *= 2
+	}
+	d = min(d, maxPollFactor*rt.UpstreamPollPeriod)
+	if left := deadline.Sub(rt.now()); left > 0 && left < d {
+		return left
+	}
+	return d
+}
+
+// waitBounds bounds a wait of up to wait that looks again after the pauses of
+// pollDelay: by the clock, at the deadline, and by the number of looks.
+// Each look reads the storage, which takes time of its own (a round trip to the
+// Kubernetes API), so counting looks alone overran the wait by that time on
+// every look: 5 seconds became 6.5. The count still ends a wait whose clock does
+// not move, as in tests.
+func (rt *RefreshStore) waitBounds(wait time.Duration) (time.Time, int) {
+	return rt.now().Add(wait), pollsWithin(wait, rt.UpstreamPollPeriod)
+}
+
+// awaitRotatedCredential waits for the credential of the offline session to
+// become one this request has not offered yet. It reports false when the
+// credential does not move: then no other Dex caused the failure. It waits as
+// long as an upstream refresh may take, the time another Dex needs to publish
+// the successor of the credential it spent (see waitBounds).
+func (rt *RefreshStore) awaitRotatedCredential(ctx context.Context, token *storage.RefreshToken, tried [][]byte) bool {
+	deadline, polls := rt.waitBounds(UpstreamRefreshTimeout)
+	for attempt := 0; ; attempt++ {
+		session, err := rt.storage.GetOfflineSessions(ctx, token.Claims.UserID, token.ConnectorID)
+		if err != nil {
+			if !errors.Is(err, storage.ErrNotFound) {
+				rt.logger.ErrorContext(ctx, "failed to get offline session", "err", err)
+			}
+			return false
+		}
+
+		isNew := !slices.ContainsFunc(tried, func(c []byte) bool { return bytes.Equal(c, session.ConnectorData) })
+		if len(session.ConnectorData) > 0 && isNew {
+			return true
+		}
+
+		if attempt >= polls-1 || !rt.now().Before(deadline) {
+			return false
+		}
+		// The Dex that spent the credential may still be waiting for the provider.
+		if rt.Sleep(ctx, rt.pollDelay(attempt, deadline)) != nil {
+			return false
+		}
+	}
+}
+
+// detached returns a context for writes that keep what the provider answered:
+// they must not end with the request, nor with an earlier write that used up
+// its own time, so they get a deadline of their own.
+func detached(ctx context.Context, timeout time.Duration) (context.Context, context.CancelFunc) {
+	return context.WithTimeout(context.WithoutCancel(ctx), timeout)
+}
+
+// retireDeadSharedCredential removes the credential of the offline session once
+// the provider refused it and nothing rotated it meanwhile. No refresh can
+// revive it. Dropping it lets every client of the user fail at once instead of
+// presenting it again, and the next login of any client restores the shared
+// credential for all of them.
+func (rt *RefreshStore) retireDeadSharedCredential(ctx context.Context, token *storage.RefreshToken, refused []byte) {
+	if len(refused) == 0 {
+		return
+	}
+
+	// The request is failing, so its context may end at any moment.
+	ctx, cancel := detached(ctx, persistTimeout)
+	defer cancel()
+
+	err := rt.storage.UpdateOfflineSessions(ctx, token.Claims.UserID, token.ConnectorID,
+		func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+			// Only the credential that was refused: anything else is a successor
+			// published meanwhile, and it belongs to whoever put it there.
+			if !bytes.Equal(old.ConnectorData, refused) {
+				return old, errCredentialMoved
+			}
+			old.ConnectorData = nil
+			return old, nil
+		})
+
+	switch {
+	case errors.Is(err, errCredentialMoved):
+		rt.logger.DebugContext(ctx, "upstream credential rotated while waiting, keeping it")
+	case err != nil:
+		rt.logger.ErrorContext(ctx, "failed to retire refused upstream credential", "err", err)
+	default:
+		rt.logger.WarnContext(ctx, "upstream provider refused the credential shared by the clients of the user, dropped it so that the next login restores it",
+			"connector_id", token.ConnectorID, "user_id", token.Claims.UserID)
+	}
+}
+
+// retireDeadOwnCredential removes the own credential of a refresh token once the
+// provider refused it: offering it again at every refresh would only repeat the
+// refusal, and to a provider that detects reuse it is a spent credential.
+func (rt *RefreshStore) retireDeadOwnCredential(ctx context.Context, token *storage.RefreshToken, refused []byte) {
+	ctx, cancel := detached(ctx, persistTimeout)
+	defer cancel()
+	if err := rt.clearOwnCredential(ctx, token.ID, refused); err != nil {
+		rt.logger.ErrorContext(ctx, "failed to retire refused upstream credential of a refresh token", "err", err)
+	}
+}
+
+// clearOwnCredential removes credential from the refresh token id if it still
+// holds it.
+func (rt *RefreshStore) clearOwnCredential(ctx context.Context, id string, credential []byte) error {
+	err := rt.storage.UpdateRefreshToken(ctx, id, func(old storage.RefreshToken) (storage.RefreshToken, error) {
+		if !bytes.Equal(old.ConnectorData, credential) {
+			return old, errCredentialMoved
+		}
+		old.ConnectorData = nil
+		return old, nil
+	})
+	if errors.Is(err, errCredentialMoved) || errors.Is(err, storage.ErrNotFound) {
+		return nil
+	}
+	return err
+}
+
+// persistRotatedCredential stores a credential the provider rotated during a
+// request that failed afterwards in the offline session, and takes a spent own
+// credential from the refresh token. Dropping the successor would leave every
+// client of the user with a spent credential, and every further refresh would
+// fail until the next login.
+func (rt *RefreshStore) persistRotatedCredential(ctx context.Context, token *storage.RefreshToken, src identitySource) {
+	spent, successor, ok := src.spent()
+	if !ok {
+		return
+	}
+
+	// The request is failing, so its context may end at any moment. This write is
+	// what keeps the session usable, hence a context of its own.
+	ctx, cancel := detached(ctx, persistTimeout)
+	defer cancel()
+
+	if spent.source == credentialFromToken && !bytes.Equal(successor, spent.data) {
+		if err := rt.clearOwnCredential(ctx, token.ID, spent.data); err != nil {
+			rt.logger.ErrorContext(ctx, "failed to drop a spent upstream credential of a refresh token", "err", err)
+		}
+	}
+	if len(successor) == 0 || bytes.Equal(successor, spent.data) {
+		return
+	}
+
+	err := rt.storage.UpdateOfflineSessions(ctx, token.Claims.UserID, token.ConnectorID,
+		func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+			switch {
+			case bytes.Equal(old.ConnectorData, successor):
+				return old, errCredentialMoved // already stored
+			case len(old.ConnectorData) > 0 && !bytes.Equal(old.ConnectorData, spent.data):
+				return old, errCredentialMoved
+			}
+			// The session still has the spent credential, or none at all: a request
+			// that lost the race to this one may have dropped it as dead.
+			old.ConnectorData = successor
+			return old, nil
+		})
+
+	switch {
+	case errors.Is(err, errCredentialMoved):
+		rt.logger.DebugContext(ctx, "upstream credential rotated by another request, discarding ours",
+			"credential_source", spent.source.String())
+	case err != nil:
+		rt.logger.ErrorContext(ctx, "failed to save rotated connector data", "err", err)
+	}
+}
diff --git a/server/tokens/refresh_upstream_claimed_test.go b/server/tokens/refresh_upstream_claimed_test.go
new file mode 100644
index 00000000..9a685124
--- /dev/null
+++ b/server/tokens/refresh_upstream_claimed_test.go
@@ -0,0 +1,153 @@
+package tokens
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+
+	"github.com/dexidp/dex/connector"
+)
+
+// Dex up to v2.45 answers a refresh token it no longer holds with 400
+// invalid_request and "already been claimed": the credential is dead, as with
+// invalid_grant. Any other invalid_request, or one without the status of a 400
+// answer, says nothing about the credential.
+func TestCredentialRefusedClaimedElsewhere(t *testing.T) {
+	claimed := func(status int) error {
+		retrieveErr := &oauth2.RetrieveError{
+			ErrorCode:        "invalid_request",
+			ErrorDescription: "Refresh token is invalid or has already been claimed by another client.",
+		}
+		if status != 0 {
+			retrieveErr.Response = &http.Response{StatusCode: status}
+		}
+		return fmt.Errorf("oidc: failed to get refresh token: %w", retrieveErr)
+	}
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{name: "answered 400", err: claimed(http.StatusBadRequest), want: true},
+		{name: "marked as a refusal by the OIDC connector", err: fmt.Errorf("%w: %w", claimed(http.StatusBadRequest), connector.ErrRefreshRefused), want: true},
+		{name: "answered 401", err: claimed(http.StatusUnauthorized)},
+		{name: "answered 500", err: claimed(http.StatusInternalServerError)},
+		{name: "no answer status", err: claimed(0)},
+		{
+			name: "invalid_request without the text of old dex",
+			err: fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{
+				Response:         &http.Response{StatusCode: http.StatusBadRequest},
+				ErrorCode:        "invalid_request",
+				ErrorDescription: "Missing parameter: refresh_token",
+			}),
+		},
+		{
+			name: "invalid_request without a description",
+			err: fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{
+				Response:  &http.Response{StatusCode: http.StatusBadRequest},
+				ErrorCode: "invalid_request",
+			}),
+		},
+		{
+			name: "another code with 400",
+			err: fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{
+				Response:  &http.Response{StatusCode: http.StatusBadRequest},
+				ErrorCode: "invalid_scope",
+			}),
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, credentialRefused(tc.err))
+		})
+	}
+}
+
+// A refusal of dex itself as the client of the provider is no answer about the
+// user: invalid_client with any status, and any OAuth2 error with 401. The
+// other client errors of RFC 6749 section 5.2 stay refusals.
+func TestClientRefused(t *testing.T) {
+	answered := func(status int, code string) error {
+		retrieveErr := &oauth2.RetrieveError{ErrorCode: code}
+		if status != 0 {
+			retrieveErr.Response = &http.Response{StatusCode: status}
+		}
+		return fmt.Errorf("oidc: failed to get refresh token: %w", retrieveErr)
+	}
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{name: "invalid_client 401", err: answered(http.StatusUnauthorized, "invalid_client"), want: true},
+		{name: "invalid_client 400", err: answered(http.StatusBadRequest, "invalid_client"), want: true},
+		{name: "invalid_client without status", err: answered(0, "invalid_client"), want: true},
+		{name: "unauthorized_client 401", err: answered(http.StatusUnauthorized, "unauthorized_client"), want: true},
+		{name: "invalid_grant 401", err: answered(http.StatusUnauthorized, "invalid_grant"), want: true},
+		{name: "unauthorized_client 400", err: answered(http.StatusBadRequest, "unauthorized_client")},
+		{name: "unsupported_grant_type 400", err: answered(http.StatusBadRequest, "unsupported_grant_type")},
+		{name: "invalid_grant 400", err: answered(http.StatusBadRequest, "invalid_grant")},
+		{name: "a 401 of a proxy", err: answered(http.StatusUnauthorized, "")},
+		{name: "a 401 of a gateway with a JSON error", err: answered(http.StatusUnauthorized, "Unauthorized")},
+		{name: "access_denied 401", err: answered(http.StatusUnauthorized, "access_denied")},
+		{name: "access_denied 429 of a locked account", err: answered(http.StatusTooManyRequests, "access_denied")},
+		{name: "marked as a refusal by the OIDC connector", err: fmt.Errorf("%w: %w", answered(http.StatusUnauthorized, "invalid_client"), connector.ErrRefreshRefused), want: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, clientRefused(tc.err))
+		})
+	}
+}
+
+// A refresh the provider refused because of dex itself is one the provider did
+// not answer: the refresh may succeed once dex is fixed, and the credential is
+// not taken for dead.
+func TestUpstreamRefresherClientRefused(t *testing.T) {
+	u := &upstreamRefresher{
+		refresh: func(context.Context, connector.Identity) (connector.Identity, error) {
+			return connector.Identity{}, fmt.Errorf("%w: %w", &oauth2.RetrieveError{
+				Response:  &http.Response{StatusCode: http.StatusUnauthorized},
+				ErrorCode: "invalid_client",
+			}, connector.ErrRefreshRefused)
+		},
+		credentials: []credentialRef{{data: []byte("x"), source: credentialFromSession}},
+		logger:      slog.New(slog.DiscardHandler),
+	}
+	_, err := u.prepare(t.Context(), connector.Identity{})
+	var upstreamErr *UpstreamError
+	require.ErrorAs(t, err, &upstreamErr)
+	assert.True(t, upstreamErr.Unavailable)
+	assert.False(t, upstreamErr.Refused)
+	assert.False(t, u.isRefused, "the credential is not taken for dead")
+}
+
+// A connector that failed after the provider rotated the credential reports the
+// successor: the credential counts as spent, and the successor is what replaces
+// it, although the refresh fails.
+func TestUpstreamRefresherRefreshedError(t *testing.T) {
+	cause := fmt.Errorf("gitlab: get groups: %w", connector.ErrUpstreamUnavailable)
+	u := &upstreamRefresher{
+		refresh: func(context.Context, connector.Identity) (connector.Identity, error) {
+			return connector.Identity{}, &connector.RefreshedError{ConnectorData: []byte("successor"), Err: cause}
+		},
+		credentials: []credentialRef{{data: []byte("spent"), source: credentialFromSession}},
+		logger:      slog.New(slog.DiscardHandler),
+	}
+	_, err := u.prepare(t.Context(), connector.Identity{})
+	require.ErrorIs(t, err, cause)
+	var upstreamErr *UpstreamError
+	require.ErrorAs(t, err, &upstreamErr)
+	assert.True(t, upstreamErr.Unavailable)
+
+	spent, successor, ok := u.spent()
+	require.True(t, ok)
+	assert.Equal(t, []byte("spent"), spent.data)
+	assert.Equal(t, []byte("successor"), successor)
+}
