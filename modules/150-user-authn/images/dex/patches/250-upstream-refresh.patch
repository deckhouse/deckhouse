+// oauth2Answer is an error answer of a token endpoint, as the OIDC connector
+// returns it.
+func oauth2Answer(status int, code, description string) error {
+	return fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{
+		Response:         &http.Response{StatusCode: status},
+		Body:             []byte(`{"error":"` + code + `"}`),
+		ErrorCode:        code,
+		ErrorDescription: description,
+	})
+}
+
+// requireNotFatalForDexAuthenticator checks a 503 answer for the error codes
+// dex-authenticator matches anywhere in an answer to end the session of the
+// user.
+func requireNotFatalForDexAuthenticator(t *testing.T, rr *httptest.ResponseRecorder) {
+	t.Helper()
+	for _, fatal := range []string{"invalid_grant", "invalid_client", "access_denied"} {
+		require.NotContains(t, rr.Body.String(), fatal)
+	}
+}
+
+// The provider has spent the shared credential, and its answer, with the write
+// that publishes the successor, takes several lease times: on the Kubernetes
+// storage the writes take as long as the API server does, whatever the context
+// of the request says. The holder keeps renewing the lease, so the other
+// replica waits instead of taking an expired lease over and presenting the
+// spent credential, which a provider that detects reuse revokes the whole grant
+// for. Real time: the renewal runs on its own goroutine.
+func TestUpstreamLeaseRenewedDuringSlowCriticalSection(t *testing.T) {
+	// Renewed every third of it, a lease of a second survives a scheduler that
+	// stalls the renewal for most of a second, as a loaded machine running the
+	// race detector may.
+	const ttl = time.Second
+	w := newUpstreamWorld(t, familyProvider, 2, 0, worldOptions{realTime: true, leaseTTL: ttl})
+	w.login("webapp", 0)
+	w.login("kubeconfig-generator", 1)
+	holder := &upstreamWorld{t: t, clk: w.clk, provider: w.provider, servers: w.servers,
+		tokens: map[string]*internal.RefreshToken{"webapp": w.tokens["webapp"]}}
+	other := &upstreamWorld{t: t, clk: w.clk, provider: w.provider, servers: w.servers,
+		tokens: map[string]*internal.RefreshToken{"kubeconfig-generator": w.tokens["kubeconfig-generator"]}}
+
+	spent, answer := make(chan struct{}), make(chan struct{})
+	w.provider.mu.Lock()
+	w.provider.afterSpend = func() {
+		close(spent)
+		<-answer
+	}
+	w.provider.mu.Unlock()
+
+	var wg sync.WaitGroup
+	var held *httptest.ResponseRecorder
+	wg.Go(func() { held = holder.refresh("webapp", 0) })
+	select {
+	case <-spent:
+	case <-time.After(5 * time.Second):
+		wg.Wait()
+		t.Fatalf("the provider spent nothing: %d %s", held.Code, held.Body.String())
+	}
+	// The other replica keeps trying for two lease times.
+	for deadline := time.Now().Add(2 * ttl); time.Now().Before(deadline); {
+		rr := other.refresh("kubeconfig-generator", 1)
+		require.Equal(t, http.StatusServiceUnavailable, rr.Code, "the lease of a live holder is not taken over: %s", rr.Body.String())
+	}
+	close(answer)
+	wg.Wait()
+
+	require.Equal(t, http.StatusOK, held.Code, held.Body.String())
+	_, reused, maxInFlight, _ := w.provider.snapshot()
+	require.Zero(t, reused, "I1: the spent credential is never presented")
+	require.Equal(t, 1, maxInFlight)
+	other.requireRefresh("kubeconfig-generator", 1, http.StatusOK)
+	require.True(t, w.provider.isLive(w.session().ConnectorData))
+}
+
+// stallingStorage runs a hook at a chosen read of a refresh token: a replica
+// that stalls there, its lease renewals failing.
+type stallingStorage struct {
+	storage.Storage
+
+	mu    sync.Mutex
+	reads int
+	at    int
+	hook  func()
+}
+
+func (s *stallingStorage) arm(at int, hook func()) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.reads, s.at, s.hook = 0, at, hook
+}
+
+func (s *stallingStorage) GetRefresh(ctx context.Context, id string) (storage.RefreshToken, error) {
+	s.mu.Lock()
+	s.reads++
+	var hook func()
+	if s.hook != nil && s.reads == s.at {
+		hook, s.hook = s.hook, nil
+	}
+	s.mu.Unlock()
+	if hook != nil {
+		hook()
+	}
+	return s.Storage.GetRefresh(ctx, id)
+}
+
+// A replica loses its lease between reading the credential and the connector
+// call: it stalled past the lease time, its renewals failing, and another
+// replica took the lease over, spent the credential and published the
+// successor. The first one never presents the credential it read: it starts
+// over from the offline session as it is now.
+func TestUpstreamLeaseLostBeforeTheCallStartsOver(t *testing.T) {
+	var stall *stallingStorage
+	w := newUpstreamWorld(t, familyProvider, 2, 0, worldOptions{wrap: func(i int, s storage.Storage) storage.Storage {
+		if i != 0 {
+			return s
+		}
+		stall = &stallingStorage{Storage: s}
+		return stall
+	}})
+	w.login("webapp", 0)
+	w.login("kubeconfig-generator", 1)
+	w.clk.advance(3 * time.Minute)
+
+	other := &upstreamWorld{t: t, clk: w.clk, provider: w.provider, servers: w.servers,
+		tokens: map[string]*internal.RefreshToken{"kubeconfig-generator": w.tokens["kubeconfig-generator"]}}
+	var raced *httptest.ResponseRecorder
+	// The first read is the lookup of the token, the second the one under the
+	// lease, right before the connector call.
+	stall.arm(2, func() {
+		w.clk.advance(tokens.DefaultUpstreamLeaseTTL)
+		raced = other.refresh("kubeconfig-generator", 1)
+	})
+	w.requireRefresh("webapp", 0, http.StatusOK)
+	require.Equal(t, http.StatusOK, raced.Code, "the other replica took the expired lease over: %s", raced.Body.String())
+	calls, reused, _, _ := w.provider.snapshot()
+	require.Zero(t, reused, "I1: the credential read before the lease was lost is not presented")
+	require.Equal(t, 2, calls)
+	w.tokens["kubeconfig-generator"] = other.tokens["kubeconfig-generator"]
+	w.requireEveryClientRefreshes()
+}
+
+// The connector is asked for the connector data of the successor whatever
+// scopes the client narrowed its refresh to: GitLab and OIDC return it with
+// offline access only, and without it the successor of the credential every
+// client of the user shares would be lost.
+func TestUpstreamRefreshAsksForOfflineAccess(t *testing.T) {
+	w := newUpstreamWorld(t, rotatingProvider, 1, 0)
+	w.login("webapp", 0)
+	w.clk.advance(3 * time.Minute)
+
+	raw, err := internal.Marshal(w.tokens["webapp"])
+	require.NoError(t, err)
+	body := url.Values{"grant_type": {"refresh_token"}, "refresh_token": {raw}, "scope": {"openid email"}}
+	req := httptest.NewRequest(http.MethodPost, "/token", strings.NewReader(body.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth("webapp", upstreamSecret)
+	rr := httptest.NewRecorder()
+	w.servers[0].ServeHTTP(rr, req)
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+
+	w.provider.mu.Lock()
+	scopes := w.provider.lastScopes
+	w.provider.mu.Unlock()
+	require.True(t, scopes.OfflineAccess, "the connector is asked for the data of the successor")
+	require.True(t, w.provider.isLive(w.session().ConnectorData))
+}
+
+// leaseWriteStorage counts the writes of offline sessions and tells whether any
+// of them stored a lease.
+type leaseWriteStorage struct {
+	storage.Storage
+
+	mu       sync.Mutex
+	updates  int
+	isLeased bool
+}
+
+func (s *leaseWriteStorage) UpdateOfflineSessions(ctx context.Context, userID, connID string, updater func(storage.OfflineSessions) (storage.OfflineSessions, error)) error {
+	return s.Storage.UpdateOfflineSessions(ctx, userID, connID, func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+		updated, err := updater(old)
+		if err == nil {
+			s.mu.Lock()
+			s.updates++
+			s.isLeased = s.isLeased || !updated.UpstreamLease.IsZero()
+			s.mu.Unlock()
+		}
+		return updated, err
+	})
+}
+
+// A connector that keeps no credential, as the password connector of local
+// users, spends nothing: its refresh takes no lease, writes the offline session
+// no more than before and never waits for another request. Its read of the
+// password, from the storage of the server itself, runs outside the
+// transaction that rotates the refresh token, so the memory storage does not
+// deadlock (sessions off and no identity refresh maxAge: the connector is
+// called).
+func TestUpstreamRefreshLocalUserTakesNoLease(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	var writes *leaseWriteStorage
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
+		c.SessionConfig = nil
+		writes = &leaseWriteStorage{Storage: c.Storage}
+		c.Storage = writes
+	})
+	defer httpServer.Close()
+
+	require.NoError(t, s.storage.CreatePassword(t.Context(), storage.Password{
+		Email: "jane@example.com", Username: "jane", UserID: upstreamUserID, Hash: []byte("$2a$10$"),
+	}))
+	registerUpstreamConnector(t, s, connectors.LocalConnector, connectors.NewPasswordDB(s.storage))
+	registerClients(t, s, clientID)
+	createRefreshToken(t, s, connectors.LocalConnector, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, connectors.LocalConnector, map[string]string{clientID: refreshID}, nil)
+
+	done := make(chan *httptest.ResponseRecorder, 1)
+	go func() { done <- refreshTokenRequest(t, context.Background(), s, clientID, requestToken(refreshID)) }()
+	select {
+	case rr := <-done:
+		require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	case <-time.After(10 * time.Second):
+		t.Fatal("the refresh of a local user deadlocks on the memory storage")
+	}
+
+	writes.mu.Lock()
+	defer writes.mu.Unlock()
+	require.False(t, writes.isLeased, "nothing to spend, no lease")
+	require.Equal(t, 1, writes.updates, "one write: the last-used time of the grant")
+}
+
+// The own copy of the shared credential an old refresh token holds is offered
+// while the offline session has none; it may be spent already. Refused, it is
+// dropped, and never presented again.
+func TestUpstreamRotationRefusedOwnCopyIsNotOfferedAgain(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	// A copy of a shared credential another client has rotated since; the
+	// session lost its own (dropped as dead).
+	copied := upstream.mint()
+	upstream.calls = 0
+	_, err := upstream.Refresh(t.Context(), connector.Scopes{}, connector.Identity{ConnectorData: copied})
+	require.NoError(t, err)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, copied, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, nil)
+
+	rr := refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+	requireOAuth2Error(t, rr, http.StatusBadRequest, "invalid_grant")
+	require.Equal(t, 1, upstream.reused, "the copy is presented once")
+
+	stored, err := s.storage.GetRefresh(t.Context(), refreshID)
+	require.NoError(t, err)
+	require.Empty(t, stored.ConnectorData, "and dropped")
+
+	clk.advance(5 * time.Minute)
+	rr = refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+	requireOAuth2Error(t, rr, http.StatusBadRequest, "invalid_grant")
+	require.Equal(t, 1, upstream.reused, "never again")
+}
