+// A provider that fails to answer costs a request nothing beyond its own failure:
+// the credential is neither recovered from nor dropped, so an outage does not
+// turn into users logging in again, and the client is told to try later (503).
+func TestUpstreamRotationKeepsCredentialWhenProviderUnreachable(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	var reads *sessionReadStorage
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
+		reads = &sessionReadStorage{Storage: c.Storage}
+		c.Storage = reads
+	})
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	upstream.unreachable = true
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	shared := upstream.mint()
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, shared)
+
+	rr := refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+	requireOAuth2Error(t, rr, http.StatusServiceUnavailable, "temporarily_unavailable")
+	require.Equal(t, 1, upstream.calls)
+	require.Zero(t, reads.reads, "an unreachable provider costs no wait for a successor")
