+// A refresh tells GitLab refusing the user (a refused refresh token, a revoked
+// access token) from GitLab failing to answer: only a refusal is final.
+func TestRefreshRefused(t *testing.T) {
+	withRefresh := connectorData{RefreshToken: "old-refresh-token"}
+	accessOnly := connectorData{AccessToken: "old-access-token"}
+
+	tests := []struct {
+		name      string
+		data      connectorData
+		handler   http.HandlerFunc
+		isGone    bool
+		errorCode string
+	}{
+		{
+			name: "refresh token refused",
+			data: withRefresh,
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(http.StatusBadRequest)
+				_ = json.NewEncoder(w).Encode(map[string]string{"error": "invalid_grant"})
+			},
+			errorCode: "invalid_grant",
+		},
+		{
+			name: "access token revoked",
+			data: accessOnly,
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				http.Error(w, `{"message":"401 Unauthorized"}`, http.StatusUnauthorized)
+			},
+			isGone: true,
+		},
+		{
+			name: "gitlab failing",
+			data: withRefresh,
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				http.Error(w, "unavailable", http.StatusBadGateway)
+			},
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := httptest.NewTLSServer(tc.handler)
+			defer s.Close()
+
+			connData, err := json.Marshal(tc.data)
+			expectNil(t, err)
+
+			c := gitlabConnector{baseURL: s.URL, httpClient: newClient()}
+			_, err = c.Refresh(context.Background(), connector.Scopes{OfflineAccess: true}, connector.Identity{ConnectorData: connData})
+			if err == nil {
+				t.Fatal("expected the refresh to fail")
+			}
+
+			if got := errors.Is(err, connector.ErrIdentityGone); got != tc.isGone {
+				t.Errorf("errors.Is(%v, ErrIdentityGone) = %v, expected %v", err, got, tc.isGone)
+			}
+			var retrieveErr *oauth2.RetrieveError
+			var errorCode string
+			if errors.As(err, &retrieveErr) {
+				errorCode = retrieveErr.ErrorCode
+			}
+			expectEquals(t, errorCode, tc.errorCode)
+		})
+	}
+}
