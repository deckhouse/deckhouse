+package authflow
+
+import (
+	"context"
+	"encoding/json"
+	"log/slog"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/connector/mock"
+	"github.com/dexidp/dex/storage"
+)
+
+// samlRefreshConnector is a SAML connector that refreshes from the identity it
+// cached at login, as the SAML connector of dex does.
+type samlRefreshConnector struct{}
+
+func (samlRefreshConnector) POSTData(connector.Scopes, string) (string, string, error) {
+	return "", "", nil
+}
+
+func (samlRefreshConnector) HandlePOST(connector.Scopes, string, string) (connector.Identity, error) {
+	return connector.Identity{}, nil
+}
+
+func (samlRefreshConnector) Refresh(_ context.Context, _ connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	return ident, nil
+}
+
+// reportingConnector is a callback connector that tells whether its connector
+// data holds a refresh token, as the OIDC and GitLab connectors do.
+type reportingConnector struct {
+	connector.CallbackConnector
+}
+
+func (reportingConnector) Refresh(_ context.Context, _ connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	return ident, nil
+}
+
+func (reportingConnector) HasRefreshCredential(data []byte) bool {
+	var cd struct {
+		RefreshToken string `json:"refreshToken"`
+	}
+	return json.Unmarshal(data, &cd) == nil && cd.RefreshToken != ""
+}
+
+// The upstream credential a login obtained replaces the one the offline session
+// shares between the clients of the user, when it can refresh: a provider such
+// as dex ends the credentials of the earlier logins. A login without a refresh
+// token (Google asks for consent to offline access once) keeps the shared one,
+// which still refreshes. The identity of a SAML login is replaced the same way
+// (D10).
+func TestFinalizeLoginSharedConnectorData(t *testing.T) {
+	reporting := reportingConnector{mock.NewCallbackConnector(slog.New(slog.DiscardHandler)).(connector.CallbackConnector)}
+	tests := []struct {
+		name     string
+		conn     connector.Connector
+		shared   []byte
+		obtained []byte
+		expected []byte
+	}{
+		{
+			name:     "an empty session is seeded",
+			conn:     mock.NewCallbackConnector(slog.New(slog.DiscardHandler)),
+			shared:   nil,
+			obtained: []byte(`{"refreshToken":"login"}`),
+			expected: []byte(`{"refreshToken":"login"}`),
+		},
+		{
+			name:     "a shared credential is replaced",
+			conn:     mock.NewCallbackConnector(slog.New(slog.DiscardHandler)),
+			shared:   []byte(`{"refreshToken":"shared"}`),
+			obtained: []byte(`{"refreshToken":"login"}`),
+			expected: []byte(`{"refreshToken":"login"}`),
+		},
+		{
+			name:     "a login without connector data keeps the shared credential",
+			conn:     mock.NewCallbackConnector(slog.New(slog.DiscardHandler)),
+			shared:   []byte(`{"refreshToken":"shared"}`),
+			obtained: nil,
+			expected: []byte(`{"refreshToken":"shared"}`),
+		},
+		{
+			name:     "a login with a refresh token replaces the shared credential",
+			conn:     reporting,
+			shared:   []byte(`{"refreshToken":"shared"}`),
+			obtained: []byte(`{"refreshToken":"login"}`),
+			expected: []byte(`{"refreshToken":"login"}`),
+		},
+		{
+			name:     "a login without a refresh token keeps the shared credential",
+			conn:     reporting,
+			shared:   []byte(`{"refreshToken":"shared"}`),
+			obtained: []byte(`{"refreshToken":""}`),
+			expected: []byte(`{"refreshToken":"shared"}`),
+		},
+		{
+			name:     "a login without a refresh token does not seed a session",
+			conn:     reporting,
+			shared:   nil,
+			obtained: []byte(`{"refreshToken":""}`),
+			expected: nil,
+		},
+		{
+			name:     "a SAML login replaces the shared identity",
+			conn:     samlRefreshConnector{},
+			shared:   []byte(`{"groups":["before"]}`),
+			obtained: []byte(`{"groups":["after"]}`),
+			expected: []byte(`{"groups":["after"]}`),
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, server := newTestHandler(t, nil)
+			defer httpServer.Close()
+			ctx := t.Context()
+
+			authReq := storage.AuthRequest{
+				ID:          "login-req",
+				ClientID:    "example-app",
+				Expiry:      time.Now().Add(time.Hour),
+				ConnectorID: "mock",
+				Scopes:      []string{"openid", "offline_access"},
+			}
+			require.NoError(t, server.Storage.CreateAuthRequest(ctx, authReq))
+			// finalizeLogin reads the client for its allow-lists (200).
+			require.NoError(t, server.Storage.CreateClient(ctx, storage.Client{ID: authReq.ClientID}))
+			require.NoError(t, server.Storage.CreateOfflineSessions(ctx, storage.OfflineSessions{
+				UserID:        "user-1",
+				ConnID:        "mock",
+				Refresh:       map[string]*storage.RefreshTokenRef{},
+				ConnectorData: tc.shared,
+			}))
+
+			ident := connector.Identity{UserID: "user-1", Email: "user@example.com", ConnectorData: tc.obtained}
+			_, err := server.finalizeLogin(ctx, ident, authReq, tc.conn)
+			require.NoError(t, err)
+
+			session, err := server.Storage.GetOfflineSessions(ctx, "user-1", "mock")
+			require.NoError(t, err)
+			assert.Equal(t, tc.expected, session.ConnectorData)
+
+			finalized, err := server.Storage.GetAuthRequest(ctx, authReq.ID)
+			require.NoError(t, err)
+			assert.Equal(t, tc.obtained, finalized.ConnectorData, "the login's own data goes to the token it issues")
+		})
+	}
+}
+
+// The offline session a first login creates holds the credential of the login
+// only when it can refresh.
+func TestFinalizeLoginCreatesSharedConnectorData(t *testing.T) {
+	reporting := reportingConnector{mock.NewCallbackConnector(slog.New(slog.DiscardHandler)).(connector.CallbackConnector)}
+	tests := []struct {
+		name     string
+		obtained []byte
+		expected []byte
+	}{
+		{name: "with a refresh token", obtained: []byte(`{"refreshToken":"login"}`), expected: []byte(`{"refreshToken":"login"}`)},
+		{name: "without a refresh token", obtained: []byte(`{"refreshToken":""}`)},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, server := newTestHandler(t, nil)
+			defer httpServer.Close()
+			ctx := t.Context()
+
+			authReq := storage.AuthRequest{
+				ID:          "login-req",
+				ClientID:    "example-app",
+				Expiry:      time.Now().Add(time.Hour),
+				ConnectorID: "mock",
+				Scopes:      []string{"openid", "offline_access"},
+			}
+			require.NoError(t, server.Storage.CreateAuthRequest(ctx, authReq))
+			require.NoError(t, server.Storage.CreateClient(ctx, storage.Client{ID: authReq.ClientID}))
+
+			ident := connector.Identity{UserID: "user-1", Email: "user@example.com", ConnectorData: tc.obtained}
+			_, err := server.finalizeLogin(ctx, ident, authReq, reporting)
+			require.NoError(t, err)
+
+			session, err := server.Storage.GetOfflineSessions(ctx, "user-1", "mock")
+			require.NoError(t, err)
+			assert.Equal(t, tc.expected, session.ConnectorData)
+		})
+	}
+}
