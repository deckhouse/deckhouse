+// exchangeAuthCode logs clientID in through the authorization code grant with an
+// upstream credential obtained by the login, and returns the issued refresh token.
+func exchangeAuthCode(t *testing.T, s *Server, clientID string, obtained []byte, now time.Time) *internal.RefreshToken {
+	t.Helper()
+	code := storage.NewID()
+	require.NoError(t, s.storage.CreateAuthCode(t.Context(), storage.AuthCode{
+		ID:            code,
+		ClientID:      clientID,
+		ConnectorID:   upstreamConnID,
+		RedirectURI:   upstreamRedirect,
+		Scopes:        []string{"openid", "email", "offline_access"},
+		Claims:        upstreamClaims(),
+		ConnectorData: obtained,
+		Expiry:        now.Add(time.Hour),
