--- /dev/null
+++ b/connector/github/github_refresh_test.go
@@ -0,0 +1,84 @@
+package github
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+
+	"golang.org/x/oauth2"
+
+	"github.com/dexidp/dex/connector"
+)
+
+// A refresh tells GitHub refusing the user (a revoked token, a refused refresh
+// token) from GitHub failing to answer: only a refusal is final.
+func TestRefreshRefused(t *testing.T) {
+	expired := connectorData{AccessToken: "old-access-token", RefreshToken: "old-refresh-token", Expiry: time.Now().Add(-time.Hour)}
+	accessOnly := connectorData{AccessToken: "old-access-token"}
+
+	tests := []struct {
+		name      string
+		data      connectorData
+		handler   http.HandlerFunc
+		isGone    bool
+		errorCode string
+	}{
+		{
+			name: "access token revoked",
+			data: accessOnly,
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				http.Error(w, `{"message":"Bad credentials"}`, http.StatusUnauthorized)
+			},
+			isGone: true,
+		},
+		{
+			name: "refresh token refused",
+			data: expired,
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				// GitHub answers a bad refresh token with 200 and an error code.
+				w.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(w).Encode(map[string]string{"error": "bad_refresh_token"})
+			},
+			errorCode: "bad_refresh_token",
+		},
+		{
+			name: "github failing",
+			data: accessOnly,
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				http.Error(w, "unavailable", http.StatusBadGateway)
+			},
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := httptest.NewTLSServer(tc.handler)
+			defer s.Close()
+			hostURL, err := url.Parse(s.URL)
+			expectNil(t, err)
+
+			connData, err := json.Marshal(tc.data)
+			expectNil(t, err)
+
+			c := githubConnector{apiURL: s.URL, hostName: hostURL.Host, httpClient: newClient()}
+			_, err = c.Refresh(context.Background(), connector.Scopes{OfflineAccess: true}, connector.Identity{ConnectorData: connData})
+			if err == nil {
+				t.Fatal("expected the refresh to fail")
+			}
+
+			if got := errors.Is(err, connector.ErrIdentityGone); got != tc.isGone {
+				t.Errorf("errors.Is(%v, ErrIdentityGone) = %v, expected %v", err, got, tc.isGone)
+			}
+			var retrieveErr *oauth2.RetrieveError
+			var errorCode string
+			if errors.As(err, &retrieveErr) {
+				errorCode = retrieveErr.ErrorCode
+			}
+			expectEquals(t, errorCode, tc.errorCode)
+		})
+	}
+}
