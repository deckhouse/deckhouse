+// Two clients of one user refresh within the same upstream round trip: the one
+// that loses the race for the shared credential continues from the credential
+// the winner published.
+func TestUpstreamRotationRecoversFromLostRace(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	upstream := newRotatingUpstream()
+
+	// What this request read from the offline session, and what the winner spent
+	// and published in its place.
+	lost := upstream.mint()
+	upstream.spend(t, lost)
+	published := upstream.mint()
+
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
+		c.Storage = &sessionReadStorage{Storage: c.Storage, stale: lost}
+	})
+	defer httpServer.Close()
+
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, published)
+
+	requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+	require.Equal(t, 2, upstream.calls, "the credential published by the winner is offered once")
+	requireSessionCredentialValid(t, s, upstream)
+}
+
+// A refusal nobody caused by rotating the shared credential fails the request with
+// invalid_grant (R30) without spending further credentials, and the dead
+// credential is dropped, since no refresh can revive it. The cost of reaching
+// that conclusion is asserted too: every client of a user whose upstream
+// credential died pays it on every refresh.
+func TestUpstreamRotationRetiresRefusedSharedCredential(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	var reads *sessionReadStorage
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
+		reads = &sessionReadStorage{Storage: c.Storage}
+		c.Storage = reads
+	})
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	// A credential the provider never issued, as after the user revoked the
+	// application upstream.
+	revoked, err := json.Marshal(upstreamConnectorData{RefreshToken: "revoked-upstream"})
+	require.NoError(t, err)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, revoked)
+
+	rr := refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+	requireOAuth2Error(t, rr, http.StatusBadRequest, "invalid_grant")
+	require.Equal(t, 1, upstream.calls, "a credential nobody rotated is offered once")
+	require.Equal(t, 3, reads.reads, "one read to pick the credential and two to conclude nothing rotated it")
+
+	session, err := s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+	require.NoError(t, err)
+	require.Empty(t, session.ConnectorData, "a refused credential nothing rotated is not left in place")
+
+	// Once it is gone, the clients relying on it stop paying for the conclusion.
+	reads.reads = 0
+	rr = refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+	require.Equal(t, http.StatusInternalServerError, rr.Code, "nothing to refresh with is not a refusal")
+	require.Equal(t, 1, reads.reads, "with no shared credential left there is nothing to wait for")
+}
