@@ -0,0 +1,212 @@
+package server
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/storage"
+)
+
+// claimingUpstream answers a refresh token it does not hold the way dex up to
+// v2.45 does, 400 invalid_request, marked as a refusal the way the OIDC connector
+// marks it.
+type claimingUpstream struct {
+	*rotatingUpstream
+}
+
+func (u claimingUpstream) Refresh(ctx context.Context, s connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	ident, err := u.rotatingUpstream.Refresh(ctx, s, ident)
+	if retrieveErr, ok := errors.AsType[*oauth2.RetrieveError](err); !ok || retrieveErr.ErrorCode != "invalid_grant" {
+		return ident, err
+	}
+	const desc = "Refresh token is invalid or has already been claimed by another client."
+	claimed := &oauth2.RetrieveError{
+		Response:         &http.Response{StatusCode: http.StatusBadRequest},
+		Body:             []byte(`{"error":"invalid_request","error_description":"` + desc + `"}`),
+		ErrorCode:        "invalid_request",
+		ErrorDescription: desc,
+	}
+	return ident, fmt.Errorf("oidc: failed to get refresh token: %w: %w", claimed, connector.ErrRefreshRefused)
+}
+
+// A shared credential the provider answers with invalid_request, as dex up to
+// v2.45 answers a refresh token ended at a newer login of the user, is dropped
+// like one refused with invalid_grant.
+func TestUpstreamRotationRetiresSharedCredentialClaimedElsewhere(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, claimingUpstream{upstream})
+	registerClients(t, s, clientID)
+
+	deleted, err := json.Marshal(upstreamConnectorData{RefreshToken: "deleted-upstream"})
+	require.NoError(t, err)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, deleted)
+
+	rr := refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+	requireOAuth2Error(t, rr, http.StatusBadRequest, "invalid_grant")
+	require.Equal(t, 1, upstream.calls, "a credential nobody rotated is offered once")
+
+	session, err := s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+	require.NoError(t, err)
+	require.Empty(t, session.ConnectorData, "a dead shared credential is dropped")
+}
+
+// A Dex that does not take the lease spends the shared credential under this
+// request, and the provider answers this request the way dex up to v2.45 does,
+// with invalid_request: the request continues from the credential the other Dex
+// published instead of dropping it.
+func TestUpstreamRotationRecoversFromLostRaceClaimedElsewhere(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, &rolloutRacer{RefreshConnector: claimingUpstream{upstream}, t: t, upstream: upstream, storage: s.storage, races: 1})
+	registerClients(t, s, clientID)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, upstream.mint())
+
+	requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+	require.Equal(t, 2, upstream.calls, "the credential published by the other Dex is offered once")
+	requireSessionCredentialValid(t, s, upstream)
+}
+
+// endingUpstream is a provider that, like dex, ends the refresh tokens of the
+// earlier logins of the user to the same client at every login: every credential
+// dex got before is dead after a login of any client of the user.
+type endingUpstream struct {
+	connector.RefreshConnector
+	upstream *rotatingUpstream
+	logins   int
+}
+
+func (u *endingUpstream) LoginURL(_ connector.Scopes, callbackURL, state string) (string, []byte, error) {
+	return callbackURL + "?state=" + state, nil, nil
+}
+
+func (u *endingUpstream) HandleCallback(connector.Scopes, []byte, *http.Request) (connector.Identity, error) {
+	u.logins++
+	clear(u.upstream.valid)
+	claims := upstreamClaims()
+	return connector.Identity{
+		UserID:        claims.UserID,
+		Username:      claims.Username,
+		Email:         claims.Email,
+		EmailVerified: claims.EmailVerified,
+		ConnectorData: u.upstream.mint(),
+	}, nil
+}
+
+// loginThroughCallback logs clientID in through the upstream connector the way a
+// browser does, from the callback to the code exchange, and returns the issued
+// refresh token.
+func loginThroughCallback(t *testing.T, s *Server, clientID string, now time.Time) *internal.RefreshToken {
+	t.Helper()
+	return loginThroughCallbackWith(t, s, clientID, now, url.Values{})
+}
+
+// loginThroughCallbackWith is loginThroughCallback with the parameters the
+// provider adds to the callback, such as the code a real OIDC connector
+// exchanges.
+func loginThroughCallbackWith(t *testing.T, s *Server, clientID string, now time.Time, callback url.Values) *internal.RefreshToken {
+	t.Helper()
+	authReq := storage.AuthRequest{
+		ID:            storage.NewID(),
+		ClientID:      clientID,
+		ConnectorID:   upstreamConnID,
+		RedirectURI:   upstreamRedirect,
+		ResponseTypes: []string{"code"},
+		Scopes:        []string{"openid", "email", "offline_access"},
+		Expiry:        now.Add(time.Hour),
+	}
+	require.NoError(t, s.storage.CreateAuthRequest(t.Context(), authReq))
+
+	rr := httptest.NewRecorder()
+	callback.Set("state", authReq.ID)
+	s.ServeHTTP(rr, httptest.NewRequest(http.MethodGet, "/callback/"+upstreamConnID+"?"+callback.Encode(), nil))
+	rr, _ = followFlow(t, s, rr)
+	location, err := url.Parse(rr.Header().Get("Location"))
+	require.NoError(t, err)
+	code := location.Query().Get("code")
+	require.NotEmpty(t, code, "the login must end at the client with a code: %d %s", rr.Code, rr.Body.String())
+
+	body := url.Values{"grant_type": {"authorization_code"}, "code": {code}, "redirect_uri": {upstreamRedirect}}
+	req := httptest.NewRequest(http.MethodPost, "/token", bytes.NewBufferString(body.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth(clientID, upstreamSecret)
+	rr = httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	require.Equal(t, http.StatusOK, rr.Code, "the code exchange must succeed: %s", rr.Body.String())
+
+	var resp struct {
+		RefreshToken string `json:"refresh_token"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &resp))
+	issued := new(internal.RefreshToken)
+	require.NoError(t, internal.Unmarshal(resp.RefreshToken, issued))
+	return issued
+}
+
+// Two applications of one user log in one after the other through a provider
+// that ends the credentials of the earlier logins, as dex does. The second login
+// ends the credential the first application holds, so the login replaces the
+// shared credential, and both applications go on refreshing without a login of
+// their own, whichever way the provider refuses a credential it ended.
+func TestUpstreamLoginRestoresRefreshForEveryClient(t *testing.T) {
+	const webClient, cliClient = "webapp", "kubeconfig-generator"
+	tests := []struct {
+		name    string
+		refresh func(*rotatingUpstream) connector.RefreshConnector
+	}{
+		{name: "refused with invalid_grant", refresh: func(u *rotatingUpstream) connector.RefreshConnector { return u }},
+		{name: "refused with invalid_request, as dex up to v2.45", refresh: func(u *rotatingUpstream) connector.RefreshConnector {
+			return claimingUpstream{u}
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			clk := &testClock{now: time.Now()}
+			httpServer, s := newTestServer(t, func(c *Config) {
+				rotatingPolicy(clk)(c)
+				c.SkipApprovalScreen = true
+			})
+			defer httpServer.Close()
+
+			rotating := newRotatingUpstream()
+			upstream := &endingUpstream{RefreshConnector: tc.refresh(rotating), upstream: rotating}
+			registerUpstreamConnector(t, s, upstreamConnID, upstream)
+			registerClients(t, s, webClient, cliClient)
+
+			web := loginThroughCallback(t, s, webClient, clk.now)
+			cli := loginThroughCallback(t, s, cliClient, clk.now)
+			requireSessionCredentialValid(t, s, rotating)
+
+			for range 3 {
+				clk.advance(10 * time.Minute)
+				web = requireRefreshSucceeds(t, s, webClient, web)
+				cli = requireRefreshSucceeds(t, s, cliClient, cli)
+			}
+			require.Equal(t, 2, upstream.logins, "no client needs another login")
+			requireSessionCredentialValid(t, s, rotating)
+		})
+	}
+}
diff --git a/server/server_grant_refresh_upstream_fuzz_test.go b/server/server_grant_refresh_upstream_fuzz_test.go
