+// loginDuringRefresh stands for a login of another client that replaces the
+// shared credential while this request spends the one it read.
+type loginDuringRefresh struct {
+	*rotatingUpstream
+	t       *testing.T
+	storage storage.Storage
+	newer   []byte
+}
+
+func (l *loginDuringRefresh) Refresh(ctx context.Context, s connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	if l.newer == nil {
+		l.newer = l.mint()
+		require.NoError(l.t, l.storage.UpdateOfflineSessions(ctx, upstreamUserID, upstreamConnID,
+			func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+				old.ConnectorData = l.newer
+				return old, nil
+			}))
+	}
+	return l.rotatingUpstream.Refresh(ctx, s, ident)
+}
