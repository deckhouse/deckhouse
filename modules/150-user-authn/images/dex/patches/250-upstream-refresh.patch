+package bitbucketcloud
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/dexidp/dex/connector"
+)
+
+// An API call tells Bitbucket refusing the token (revoked, the application
+// deauthorized) from Bitbucket failing to answer: only a refusal is final.
+func TestGetIdentityGone(t *testing.T) {
+	tests := []struct {
+		name   string
+		status int
+		isGone bool
+	}{
+		{name: "token revoked", status: http.StatusUnauthorized, isGone: true},
+		{name: "bitbucket failing", status: http.StatusBadGateway},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				http.Error(w, "refused", tc.status)
+			}))
+			defer s.Close()
+
+			var u user
+			err := get(context.Background(), newClient(), s.URL+"/user", &u)
+			if err == nil {
+				t.Fatal("expected the request to fail")
+			}
+			if got := errors.Is(err, connector.ErrIdentityGone); got != tc.isGone {
+				t.Errorf("errors.Is(%v, ErrIdentityGone) = %v, expected %v", err, got, tc.isGone)
+			}
+		})
+	}
+}
