+// oidcTestProvider is an OIDC provider served over HTTP for the real OIDC
+// connector. It signs ID tokens with a key made for the test, issues a refresh
+// token at the code exchange only while refreshTokens is set, and rotates the
+// refresh tokens presented to it, recording each.
+type oidcTestProvider struct {
+	*httptest.Server
+	key *jose.JSONWebKey
+
+	mu            sync.Mutex
+	refreshTokens bool
+	seq           int
+	valid         map[string]bool
+	presented     []string
+	// refusal, when set, answers the next refresh in place of the provider.
+	refusal *testAnswer
+}
+
+// testAnswer is an HTTP answer of a token endpoint.
+type testAnswer struct {
+	status      int
+	contentType string
+	body        string
+}
+
+func newOIDCTestProvider(t *testing.T) *oidcTestProvider {
+	t.Helper()
+	rsaKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	p := &oidcTestProvider{
+		key:           &jose.JSONWebKey{Key: rsaKey, KeyID: "test", Algorithm: string(jose.RS256), Use: "sig"},
+		refreshTokens: true,
+		valid:         map[string]bool{},
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/.well-known/openid-configuration", func(w http.ResponseWriter, _ *http.Request) {
+		writeTestJSON(w, http.StatusOK, map[string]string{
+			"issuer":                 p.URL,
+			"authorization_endpoint": p.URL + "/authorize",
+			"token_endpoint":         p.URL + "/token",
+			"jwks_uri":               p.URL + "/keys",
+		})
+	})
+	mux.HandleFunc("/keys", func(w http.ResponseWriter, _ *http.Request) {
+		writeTestJSON(w, http.StatusOK, jose.JSONWebKeySet{Keys: []jose.JSONWebKey{p.key.Public()}})
+	})
+	mux.HandleFunc("/token", p.token)
+	p.Server = httptest.NewServer(mux)
+	t.Cleanup(p.Close)
+	return p
+}
+
+func (p *oidcTestProvider) token(w http.ResponseWriter, r *http.Request) {
+	if err := r.ParseForm(); err != nil {
+		writeTestJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid_request"})
+		return
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+
+	issueRefreshToken := p.refreshTokens
+	switch r.PostForm.Get("grant_type") {
+	case "authorization_code":
+	case "refresh_token":
+		presented := r.PostForm.Get("refresh_token")
+		p.presented = append(p.presented, presented)
+		if refusal := p.refusal; refusal != nil {
+			p.refusal = nil
+			w.Header().Set("Content-Type", refusal.contentType)
+			w.WriteHeader(refusal.status)
+			_, _ = io.WriteString(w, refusal.body)
+			return
+		}
+		if !p.valid[presented] {
+			writeTestJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid_grant"})
+			return
+		}
+		delete(p.valid, presented)
+		issueRefreshToken = true
+	default:
+		writeTestJSON(w, http.StatusBadRequest, map[string]string{"error": "unsupported_grant_type"})
+		return
+	}
+
+	idToken, err := p.idToken()
+	if err != nil {
+		writeTestJSON(w, http.StatusInternalServerError, map[string]string{"error": "server_error"})
+		return
+	}
+	resp := map[string]any{"access_token": "access", "token_type": "Bearer", "expires_in": 300, "id_token": idToken}
+	if issueRefreshToken {
+		p.seq++
+		refreshToken := fmt.Sprintf("refresh-%d", p.seq)
+		p.valid[refreshToken] = true
+		resp["refresh_token"] = refreshToken
+	}
+	writeTestJSON(w, http.StatusOK, resp)
+}
+
+func (p *oidcTestProvider) idToken() (string, error) {
+	signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.RS256, Key: p.key}, nil)
+	if err != nil {
+		return "", err
+	}
+	now := time.Now()
+	payload, err := json.Marshal(map[string]any{
+		"iss":            p.URL,
+		"sub":            upstreamUserID,
+		"aud":            "dex",
+		"iat":            now.Unix(),
+		"exp":            now.Add(time.Hour).Unix(),
+		"name":           "jane",
+		"email":          "jane@example.com",
+		"email_verified": true,
+	})
+	if err != nil {
+		return "", err
+	}
+	signed, err := signer.Sign(payload)
+	if err != nil {
+		return "", err
+	}
+	return signed.CompactSerialize()
+}
+
+func (p *oidcTestProvider) setRefreshTokens(on bool) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.refreshTokens = on
+}
+
+func (p *oidcTestProvider) refuseNextRefresh(answer testAnswer) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.refusal = &answer
+}
+
+func (p *oidcTestProvider) presentedTokens() []string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return append([]string(nil), p.presented...)
+}
+
+func writeTestJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+// A login through an OIDC provider that answers the code exchange without a
+// refresh token (Google without consent, refresh tokens turned off for the
+// client) leaves the shared credential of the user alone, from the callback of
+// the real connector to the stored session: the connector reports that its data
+// carries no refresh token, and both clients go on refreshing with the
+// credential of the earlier login.
+func TestUpstreamOIDCLoginWithoutRefreshTokenKeepsSharedCredential(t *testing.T) {
+	const webClient, cliClient = "webapp", "kubeconfig-generator"
+	idp := newOIDCTestProvider(t)
+	clk := &testClock{now: time.Now()}
+	s, conn := newOIDCUpstreamServer(t, idp, clk, webClient, cliClient)
+
+	sharedCredential := func() []byte {
+		t.Helper()
+		session, err := s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+		require.NoError(t, err)
+		return session.ConnectorData
+	}
+	reporter, ok := conn.(connector.RefreshCredentialReporter)
+	require.True(t, ok, "the OIDC connector tells whether its data carries a refresh token")
+
+	web := loginThroughCallbackWith(t, s, webClient, clk.now, url.Values{"code": {"web-code"}})
+	before := sharedCredential()
+	require.True(t, reporter.HasRefreshCredential(before), "the first login shares the refresh token it got")
+
+	idp.setRefreshTokens(false)
+	cli := loginThroughCallbackWith(t, s, cliClient, clk.now, url.Values{"code": {"cli-code"}})
+	require.Equal(t, before, sharedCredential(), "a login without a refresh token keeps the shared credential")
+
+	clk.advance(3 * time.Minute)
+	requireRefreshSucceeds(t, s, webClient, web)
+	requireRefreshSucceeds(t, s, cliClient, cli)
+	require.Equal(t, []string{"refresh-1", "refresh-2"}, idp.presentedTokens(),
+		"each refresh presents the shared credential once, starting from the first login's")
+}
+
+// newOIDCUpstreamServer is a dex server with the real OIDC connector to idp and
+// the given clients.
+func newOIDCUpstreamServer(t *testing.T, idp *oidcTestProvider, clk *testClock, clients ...string) (*Server, connector.Connector) {
+	t.Helper()
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
+		c.SkipApprovalScreen = true
+	})
+	t.Cleanup(httpServer.Close)
+
+	conn, err := (&oidc.Config{
+		Issuer:       idp.URL,
+		ClientID:     "dex",
+		ClientSecret: upstreamSecret,
+		RedirectURI:  upstreamRedirect,
+		Scopes:       []string{"openid", "email"},
+	}).Open(upstreamConnID, slog.New(slog.DiscardHandler))
+	require.NoError(t, err)
+	registerUpstreamConnector(t, s, upstreamConnID, conn)
+	registerClients(t, s, clients...)
+	return s, conn
+}
+
+// The refusal of a locked account by Deckhouse dex up to v1.78, access_denied
+// with HTTP 429 or 403, ends the session through the real OIDC connector as
+// invalid_grant does: the client gets invalid_grant. The credential is not
+// taken for dead, the lock may end. A 429 without an OAuth2 error is a rate
+// limit, no answer about the user: the client gets 503 and refreshes once the
+// provider answers.
+func TestUpstreamOIDCRefusalOfLockedAccount(t *testing.T) {
+	const jsonType = "application/json"
+	tests := []struct {
+		name       string
+		answer     testAnswer
+		wantStatus int
+		wantCode   string
+		keepsCred  bool
+	}{
+		{
+			name:       "automatic lock of an older Deckhouse dex",
+			answer:     testAnswer{http.StatusTooManyRequests, jsonType, `{"error":"access_denied","error_description":"Account locked"}`},
+			wantStatus: http.StatusBadRequest, wantCode: "invalid_grant", keepsCred: true,
+		},
+		{
+			name:       "lock of an administrator of an older Deckhouse dex",
+			answer:     testAnswer{http.StatusForbidden, jsonType, `{"error":"access_denied","error_description":"Account locked by an administrator"}`},
+			wantStatus: http.StatusBadRequest, wantCode: "invalid_grant", keepsCred: true,
+		},
+		{
+			name:       "lock answered as RFC 6749 has it",
+			answer:     testAnswer{http.StatusBadRequest, jsonType, `{"error":"invalid_grant","error_description":"Account locked"}`},
+			wantStatus: http.StatusBadRequest, wantCode: "invalid_grant", keepsCred: true,
+		},
+		{
+			name:       "a credential the provider refused",
+			answer:     testAnswer{http.StatusBadRequest, jsonType, `{"error":"invalid_grant","error_description":"Token is not active"}`},
+			wantStatus: http.StatusBadRequest, wantCode: "invalid_grant",
+		},
+		{
+			name:       "rate limit",
+			answer:     testAnswer{http.StatusTooManyRequests, "text/plain; charset=utf-8", "Too many requests\n"},
+			wantStatus: http.StatusServiceUnavailable, wantCode: "temporarily_unavailable", keepsCred: true,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			const client = "webapp"
+			idp := newOIDCTestProvider(t)
+			clk := &testClock{now: time.Now()}
+			s, _ := newOIDCUpstreamServer(t, idp, clk, client)
+
+			token := loginThroughCallbackWith(t, s, client, clk.now, url.Values{"code": {"web-code"}})
+			session, err := s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+			require.NoError(t, err)
+			before := session.ConnectorData
+
+			clk.advance(3 * time.Minute)
+			idp.refuseNextRefresh(tc.answer)
+			rr := refreshTokenRequest(t, t.Context(), s, client, token)
+			requireOAuth2Error(t, rr, tc.wantStatus, tc.wantCode)
+
+			session, err = s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+			require.NoError(t, err)
+			if tc.keepsCred {
+				require.Equal(t, before, session.ConnectorData, "the shared credential is kept")
+			} else {
+				require.Empty(t, session.ConnectorData, "the refused credential is dropped")
+			}
+			if tc.wantStatus == http.StatusServiceUnavailable {
+				requireRefreshSucceeds(t, s, client, token)
+			}
+		})
+	}
+}
