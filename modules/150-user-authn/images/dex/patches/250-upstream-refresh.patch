+// KeepsLoginIdentity reports whether the connector data of c is the identity of
+// the login that obtained it rather than an upstream credential. SAML cannot ask
+// the provider again, so its refresh replays the identity of a login, and the
+// latest login's is the one every client of the user refreshes to.
+func KeepsLoginIdentity(c connector.Connector) bool {
+	_, isSAML := c.(connector.SAMLConnector)
+	return isSAML
+}
