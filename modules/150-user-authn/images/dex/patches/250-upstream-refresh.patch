+// A refresh token whose own credential turned out to be spent, which is the state
+// of every token issued before credentials became per-token, rejoins the shared
+// credential instead of failing until the user logs in again.
+func TestUpstreamRotationStaleOwnCredentialFallsBackToSession(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+
+	stale := upstream.mint()
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, stale, clk.now)
+	upstream.spend(t, stale)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, upstream.mint())
+
+	requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+	require.Equal(t, 2, upstream.calls, "the own credential is offered before the shared one")
