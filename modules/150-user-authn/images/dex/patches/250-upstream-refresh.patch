+			token:         answer(http.StatusNotFound, `<html>Not Found</html>`),
+		},
+		{
+			name:          "token request forbidden by a proxy",
+			connectorData: withRefreshToken,
+			token:         answer(http.StatusForbidden, ``),
+		},
+		{
+			name:          "token request forbidden by a gateway with a JSON error",
+			connectorData: withRefreshToken,
+			token:         answer(http.StatusForbidden, `{"status":403,"error":"Forbidden","path":"/token"}`),
+		},
+		{
+			name:          "ID token for another client",
+			connectorData: withRefreshToken,
+			clientID:      "renamedClientID",
+			refused:       true,
+		},
+		{
+			name:          "token request timed out",
+			connectorData: withRefreshToken,
+			token:         answer(http.StatusRequestTimeout, ``),
+			unavailable:   true,
+		},
+		{
+			name:          "keys of the provider failed",
+			connectorData: withRefreshToken,
+			keys:          answer(http.StatusServiceUnavailable, `unavailable`),
+			unavailable:   true,
+		},
+		{
+			name:          "keys of the provider unreachable",
+			connectorData: withRefreshToken,
+			keys:          dropConnection,
+			unavailable:   true,
+		},
+		{
+			name:          "token endpoint failed",
+			connectorData: withRefreshToken,
+			token:         answer(http.StatusServiceUnavailable, `{"error":"temporarily_unavailable"}`),
+			unavailable:   true,
+		},
+		{
+			name:          "token endpoint throttled",
+			connectorData: withRefreshToken,
+			token:         answer(http.StatusTooManyRequests, `{"error":"slow_down"}`),
+			unavailable:   true,
+		},
+		{
+			name:          "user info failed",
+			connectorData: withRefreshToken,
+			noIDToken:     true,
+			userInfo:      answer(http.StatusInternalServerError, `oops`),
+			unavailable:   true,
+		},
+		{
+			name:          "user info throttled",
+			connectorData: withRefreshToken,
+			noIDToken:     true,
+			userInfo:      answer(http.StatusTooManyRequests, `slow down`),
+			unavailable:   true,
+		},
+		{
+			name:          "provider down",
+			connectorData: withRefreshToken,
+			down:          true,
+			unavailable:   true,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			mux, err := oidcTestMux(claims, !tc.noIDToken)
+			require.NoError(t, err)
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch {
+				case r.URL.Path == "/token" && tc.token != nil:
+					tc.token(w, r)
+				case r.URL.Path == "/userinfo" && tc.userInfo != nil:
+					tc.userInfo(w, r)
+				case r.URL.Path == "/keys" && tc.keys != nil:
+					tc.keys(w, r)
+				default:
+					mux.ServeHTTP(w, r)
+				}
+			}))
+			defer srv.Close()
+
+			clientID := "clientID" // the audience of the ID tokens of oidcTestMux
+			if tc.clientID != "" {
+				clientID = tc.clientID
+			}
+			conn, err := newConnector(Config{
+				Issuer:       srv.URL,
+				ClientID:     clientID,
+				ClientSecret: "clientSecret",
+				Scopes:       []string{"openid", "offline_access"},
+				RedirectURI:  srv.URL + "/callback",
+				GetUserInfo:  !tc.noUserInfo,
+			})
+			require.NoError(t, err)
+			if tc.down {
+				srv.Close()
+			}
+
+			var data []byte
+			if tc.connectorData != "" {
+				data = []byte(tc.connectorData)
+			}
+			_, err = conn.Refresh(t.Context(), connector.Scopes{OfflineAccess: true}, connector.Identity{ConnectorData: data})
+			require.Error(t, err)
+			require.Equal(t, tc.refused, errors.Is(err, connector.ErrRefreshRefused), "refused: %v", err)
+			require.Equal(t, tc.unavailable, connector.Unavailable(err), "unavailable: %v", err)
+		})
+	}
+}
+
+// dropConnection closes the connection without an answer.
+func dropConnection(w http.ResponseWriter, _ *http.Request) {
+	conn, _, err := w.(http.Hijacker).Hijack()
+	if err == nil {
+		_ = conn.Close()
+	}
+}
+
+// A provider that rotated the refresh token before a later step of the refresh
+// failed has spent the presented one: the connector returns the new one with
+// the failure (connector.RefreshedError), classified as before (Deckhouse). A
+// provider that answered without a new refresh token keeps the presented one
+// valid, and there is nothing to return.
+func TestRefreshKeepsRotatedRefreshToken(t *testing.T) {
+	claims := map[string]interface{}{"sub": "subvalue", "name": "namevalue"}
+	failed := func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusInternalServerError) }
+	tests := []struct {
+		name        string
+		rotated     string
+		userInfo    http.HandlerFunc
+		keys        http.HandlerFunc
+		wantData    string
+		unavailable bool
+	}{
+		{name: "user info failed after rotation", rotated: "rotated", userInfo: failed, wantData: `{"RefreshToken":"cm90YXRlZA=="}`, unavailable: true},
+		{name: "keys failed after rotation", rotated: "rotated", keys: failed, wantData: `{"RefreshToken":"cm90YXRlZA=="}`, unavailable: true},
+		{name: "user info failed, no new refresh token", userInfo: failed, unavailable: true},
+		{name: "user info failed, the same refresh token", rotated: "asdf", userInfo: failed, unavailable: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			mux, err := oidcTestMux(claims, true)
+			require.NoError(t, err)
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch {
+				case r.URL.Path == "/token":
+					rec := httptest.NewRecorder()
+					mux.ServeHTTP(rec, r)
+					var body map[string]any
+					require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &body))
+					if tc.rotated != "" {
+						body["refresh_token"] = tc.rotated
+					}
+					w.Header().Set("Content-Type", "application/json")
+					_ = json.NewEncoder(w).Encode(body)
+				case r.URL.Path == "/userinfo" && tc.userInfo != nil:
+					tc.userInfo(w, r)
+				case r.URL.Path == "/keys" && tc.keys != nil:
+					tc.keys(w, r)
+				default:
+					mux.ServeHTTP(w, r)
+				}
+			}))
+			defer srv.Close()
+
+			conn, err := newConnector(Config{
+				Issuer:       srv.URL,
+				ClientID:     "clientID",
+				ClientSecret: "clientSecret",
+				Scopes:       []string{"openid", "offline_access"},
+				RedirectURI:  srv.URL + "/callback",
+				GetUserInfo:  true,
+			})
+			require.NoError(t, err)
+
+			_, err = conn.Refresh(t.Context(), connector.Scopes{OfflineAccess: true},
+				connector.Identity{ConnectorData: []byte(`{"RefreshToken":"YXNkZg=="}`)})
+			require.Error(t, err)
+			require.Equal(t, tc.unavailable, connector.Unavailable(err), "unavailable: %v", err)
+
+			refreshed, ok := errors.AsType[*connector.RefreshedError](err)
+			if tc.wantData == "" {
+				require.False(t, ok, "nothing rotated: %v", err)
+				return
+			}
+			require.True(t, ok, "the rotated refresh token is returned: %v", err)
+			require.JSONEq(t, tc.wantData, string(refreshed.ConnectorData))
+			require.True(t, conn.HasRefreshCredential(refreshed.ConnectorData))
+		})
+	}
+}
+
+// Connector data of a login holds a refresh credential only with a refresh
+// token: a provider answers without one when offline access was not granted at
+// this login (Deckhouse).
+func TestHasRefreshCredential(t *testing.T) {
+	tests := []struct {
+		name string
+		data string
+		want bool
+	}{
+		{name: "refresh token", data: `{"RefreshToken":"YXNkZg=="}`, want: true},
+		{name: "empty refresh token", data: `{"RefreshToken":""}`},
+		{name: "no refresh token", data: `{}`},
+		{name: "nothing", data: ``},
+		{name: "not json", data: `garbage`},
+	}
+	conn := &oidcConnector{}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			require.Equal(t, tc.want, conn.HasRefreshCredential([]byte(tc.data)))
+		})
+	}
+}
