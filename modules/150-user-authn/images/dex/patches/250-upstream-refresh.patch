+
+// When the provider answers and the answer cannot refresh the identity, the
+// refresh is refused with invalid_grant, not a server error (R30): the user is
+// gone or its access was revoked, the provider refused the credential or the
+// request, or the connector found nothing to refresh with. A provider that fails
+// to answer, or refuses dex itself as its client (invalid_client, or any OAuth2
+// error with 401), is temporarily_unavailable (503) and keeps every token: no
+// login of the user fixes the client of dex. A failure the connector does not
+// explain stays a server error. Only a refusal of the credential itself drops it.
+func TestUpstreamRefreshRefused(t *testing.T) {
+	unreachable := &url.Error{Op: "Post", URL: "https://idp.example.com/token", Err: errors.New("connection refused")}
+	answered := func(status int, code string) error {
+		return fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{
+			Response:  &http.Response{StatusCode: status},
+			Body:      []byte(`{"error":"` + code + `"}`),
+			ErrorCode: code,
+		})
+	}
+	// As the OIDC connector marks a refusal.
+	marked := func(err error) error { return fmt.Errorf("%w: %w", err, connector.ErrRefreshRefused) }
+	unexplained := errors.New("gitlab: get groups: 502 Bad Gateway")
+	tests := []struct {
+		name string
+		// own makes the credential the own one of an old refresh token, with
+		// none in the offline session.
+		own      bool
+		err      error
+		status   int
+		expected string
+		// retired is set when the credential offered is dropped.
+		retired bool
+	}{
+		{
+			name:     "user gone",
+			err:      fmt.Errorf("ldap: user not found %q: %w", "jane", connector.ErrIdentityGone),
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "refresh token refused",
+			err:      fmt.Errorf("oidc: failed to get refresh token: %w", refusedGrant()),
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+			retired:  true,
+		},
+		{
+			name:     "own refresh token refused",
+			own:      true,
+			err:      fmt.Errorf("oidc: failed to get refresh token: %w", refusedGrant()),
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+			retired:  true,
+		},
+		{
+			name: "github refresh token refused",
+			err: fmt.Errorf("github: get user: %w", &url.Error{
+				Op: "Get", URL: "https://api.github.com/user",
+				Err: &oauth2.RetrieveError{ErrorCode: "bad_refresh_token"},
+			}),
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+			retired:  true,
+		},
+		{
+			name:     "user left the required groups",
+			err:      &connector.UserNotInRequiredGroupsError{UserID: "1", Groups: []string{"admins"}},
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "provider refused the request",
+			err:      marked(answered(http.StatusBadRequest, "invalid_request")),
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "provider refused the client",
+			err:      marked(answered(http.StatusUnauthorized, "invalid_client")),
+			status:   http.StatusServiceUnavailable,
+			expected: "temporarily_unavailable",
+		},
+		{
+			name:     "provider refused the client with 400",
+			err:      marked(answered(http.StatusBadRequest, "invalid_client")),
+			status:   http.StatusServiceUnavailable,
+			expected: "temporarily_unavailable",
+		},
+		{
+			name:     "another OAuth2 error with 401",
+			err:      marked(answered(http.StatusUnauthorized, "unauthorized_client")),
+			status:   http.StatusServiceUnavailable,
+			expected: "temporarily_unavailable",
+		},
+		{
+			name:     "a 401 of a proxy",
+			err:      answered(http.StatusUnauthorized, ""),
+			status:   http.StatusInternalServerError,
+			expected: "invalid_request",
+		},
+		{
+			name:     "client not allowed the grant",
+			err:      marked(answered(http.StatusBadRequest, "unauthorized_client")),
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "grant type not supported",
+			err:      marked(answered(http.StatusBadRequest, "unsupported_grant_type")),
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "connector refused: no upstream refresh token",
+			err:      fmt.Errorf("oidc: failed to get refresh token: %w", fmt.Errorf("%w: %w", errors.New("oauth2: token expired and refresh token is not set"), connector.ErrRefreshRefused)),
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "provider unreachable",
+			err:      unreachable,
+			status:   http.StatusServiceUnavailable,
+			expected: "temporarily_unavailable",
+		},
+		{
+			name:     "own credential, provider unreachable",
+			own:      true,
+			err:      unreachable,
+			status:   http.StatusServiceUnavailable,
+			expected: "temporarily_unavailable",
+		},
+		{
+			name:     "provider timed out",
+			err:      fmt.Errorf("oidc: failed to get refresh token: %w", context.DeadlineExceeded),
+			status:   http.StatusServiceUnavailable,
+			expected: "temporarily_unavailable",
+		},
+		{
+			name:     "provider call canceled",
+			err:      fmt.Errorf("oidc: failed to get refresh token: %w", context.Canceled),
+			status:   http.StatusServiceUnavailable,
+			expected: "temporarily_unavailable",
+		},
+		{
+			name:     "provider answered 5xx",
+			err:      answered(http.StatusBadGateway, "server_error"),
+			status:   http.StatusServiceUnavailable,
+			expected: "temporarily_unavailable",
+		},
+		{
+			name:     "provider answered 429",
+			err:      answered(http.StatusTooManyRequests, "slow_down"),
+			status:   http.StatusServiceUnavailable,
+			expected: "temporarily_unavailable",
+		},
+		{
+			name:     "connector says the provider did not answer",
+			err:      fmt.Errorf("oidc: error loading userinfo: %w", connector.ErrUpstreamUnavailable),
+			status:   http.StatusServiceUnavailable,
+			expected: "temporarily_unavailable",
+		},
+		{
+			name:     "failure the connector does not explain",
+			err:      unexplained,
+			status:   http.StatusInternalServerError,
+			expected: "invalid_request",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+			clk := &testClock{now: time.Now()}
+			httpServer, s := newTestServer(t, rotatingPolicy(clk))
+			defer httpServer.Close()
+
+			upstream := &failingUpstream{errs: []error{tc.err}}
+			registerUpstreamConnector(t, s, upstreamConnID, upstream)
+			registerClients(t, s, clientID)
+
+			credential := []byte(`{"refreshToken":"credential"}`)
+			own, shared := []byte(nil), credential
+			if tc.own {
+				own, shared = credential, nil
+			}
+			createRefreshToken(t, s, upstreamConnID, refreshID, clientID, own, clk.now)
+			createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, shared)
+
+			rr := refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+			requireOAuth2Error(t, rr, tc.status, tc.expected)
+			require.Equal(t, 1, upstream.calls, "one credential, offered once")
+			if tc.status == http.StatusServiceUnavailable {
+				// dex-authenticator ends the session of the user on any of these
+				// in the answer, whatever the error code.
+				for _, fatal := range []string{"invalid_grant", "invalid_client", "access_denied"} {
+					require.NotContains(t, rr.Body.String(), fatal)
+				}
+			}
+
+			stored, err := s.storage.GetRefresh(t.Context(), refreshID)
+			require.NoError(t, err, "the refresh token is kept")
+			session, err := s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+			require.NoError(t, err)
+			held := session.ConnectorData
+			if tc.own {
+				held = stored.ConnectorData
+			}
+			if tc.retired {
+				require.Empty(t, held, "a refused credential is dropped")
+			} else {
+				require.Equal(t, credential, held, "a credential the provider did not refuse is kept")
+			}
+		})
+	}
+}
