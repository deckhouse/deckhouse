+// UpstreamLease is a lease on the upstream credential of an offline session
+// (Deckhouse). The zero value is a free lease.
+type UpstreamLease struct {
+	// Holder is the ID of the request holding the lease.
+	Holder string
+	// Expiry is when the lease ends without being released, should its holder
+	// die: other requests take it over after that.
+	Expiry time.Time
+}
+
+// IsZero reports whether the lease is free.
+func (l UpstreamLease) IsZero() bool { return l.Holder == "" }
