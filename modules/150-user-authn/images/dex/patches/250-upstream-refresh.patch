+// The shared credential dies for good when the application is revoked upstream.
+// It is dropped, and one login of any client of the user restores a live shared
+// credential for every client that has none of its own.
+func TestUpstreamRotationRetiredSharedCredentialIsRestoredByLogin(t *testing.T) {
+	const (
+		webClient, cliClient = "webapp", "kubeconfig-generator"
+		cliRefresh           = "cli-refresh-id"
+	)
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, webClient, cliClient)
+
+	revoked, err := json.Marshal(upstreamConnectorData{RefreshToken: "revoked-upstream"})
+	require.NoError(t, err)
+	createRefreshToken(t, s, upstreamConnID, cliRefresh, cliClient, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{cliClient: cliRefresh}, revoked)
+
+	rr := refreshTokenRequest(t, t.Context(), s, cliClient, requestToken(cliRefresh))
+	requireOAuth2Error(t, rr, http.StatusBadRequest, "invalid_grant")
+
+	// The other client logs in: its code exchange issues a refresh token holding
+	// the credential of the login, and seeds the emptied offline session with it.
+	obtained := upstream.mint()
