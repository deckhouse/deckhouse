new file mode 100644
index 00000000..8ba73a90
--- /dev/null
+++ b/server/server_grant_refresh_upstream_state_test.go
@@ -0,0 +1,1031 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/internal"
+	dexoauth2 "github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/storage"
+)
+
+// The states of the upstream credential a user's clients share, across the
+// providers dex brokers and the transitions that move it: logins, code
+// exchanges, refreshes with fresh and stale claims, races of clients and
+// replicas, the answers of RFC 6749 section 5.2, failures after the token
+// endpoint, and a lease holder that died. Every transition keeps the invariants
+// the fuzz test checks over random interleavings too:
+//
+//   - I1: a spent upstream refresh token is never presented again;
+//   - I2: after a login every client refreshes without another login, unless
+//     the provider revoked the user;
+//   - I3: at most one request spends the shared credential at a time;
+//   - I4: a rotated upstream refresh token is never lost.
+
+// providerKind is how an upstream provider treats its refresh tokens.
+type providerKind int
+
+const (
+	// rotatingProvider spends a refresh token at every refresh and issues a
+	// new one, as GitLab does.
+	rotatingProvider providerKind = iota
+	// familyProvider rotates, and revokes every refresh token of a login when
+	// one it spent is presented again, as Auth0, Okta and Keycloak do.
+	familyProvider
+	// stableProvider keeps a refresh token valid across refreshes, and issues
+	// one only at the login the user consented to offline access at, as
+	// Google does.
+	stableProvider
+	// endingProvider rotates, and ends the refresh tokens of the earlier
+	// logins of the user at every login that issues one, as dex does.
+	endingProvider
+	// claimingProvider rotates and answers a refresh token it does not hold
+	// with 400 invalid_request, as dex up to v2.45 does.
+	claimingProvider
+)
+
+var providerKinds = []struct {
+	name string
+	kind providerKind
+}{
+	{"rotating", rotatingProvider},
+	{"family revoked on reuse", familyProvider},
+	{"not rotating", stableProvider},
+	{"login ends earlier tokens", endingProvider},
+	{"dex up to v2.45", claimingProvider},
+}
+
+func (k providerKind) rotates() bool { return k != stableProvider }
+
+// fakeProvider is an upstream provider of one user, safe for concurrent use.
+// It records what the invariants are about: reused counts the presentations of
+// a refresh token it spent (I1), and maxInFlight the most refreshes it answered
+// at once (I3).
+type fakeProvider struct {
+	connector.CallbackConnector
+
+	mu     sync.Mutex
+	kind   providerKind
+	seq    int
+	valid  map[string]int // live refresh tokens, by the login they descend from
+	spent  map[string]int // spent refresh tokens, likewise
+	logins int
+
+	calls, inFlight, maxInFlight, reused int
+	// lastScopes are the scopes of the last refresh.
+	lastScopes connector.Scopes
+
+	// withoutRefreshToken makes the next login issue no refresh token.
+	withoutRefreshToken bool
+	// answers are returned, in order, by the next refreshes instead of
+	// refreshing.
+	answers []error
+	// failAfterRotation makes the next refreshes rotate the token and then fail
+	// to read the user (connector.RefreshedError).
+	failAfterRotation int
+	// afterSpend, when set, runs once inside the next refresh that spends a
+	// refresh token, after it is spent and before dex has the answer: what
+	// other requests do while the answer, and the write that publishes the
+	// successor, are on their way.
+	afterSpend func()
+	// during, when set, runs once inside the next refresh, before the provider
+	// answers: what other requests do while one waits for the provider.
+	during func()
+}
+
+func newFakeProvider(kind providerKind) *fakeProvider {
+	return &fakeProvider{kind: kind, valid: map[string]int{}, spent: map[string]int{}}
+}
+
+func (p *fakeProvider) mintLocked(login int) []byte {
+	p.seq++
+	token := fmt.Sprintf("upstream-%d", p.seq)
+	p.valid[token] = login
+	data, _ := json.Marshal(upstreamConnectorData{RefreshToken: token})
+	return data
+}
+
+func (p *fakeProvider) LoginURL(_ connector.Scopes, callbackURL, state string) (string, []byte, error) {
+	return callbackURL + "?state=" + state, nil, nil
+}
+
+func (p *fakeProvider) HandleCallback(connector.Scopes, []byte, *http.Request) (connector.Identity, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.logins++
+	claims := upstreamClaims()
+	ident := connector.Identity{UserID: claims.UserID, Username: claims.Username, Email: claims.Email, EmailVerified: claims.EmailVerified}
+	if p.withoutRefreshToken {
+		p.withoutRefreshToken = false
+		ident.ConnectorData = []byte(`{"refreshToken":""}`)
+		return ident, nil
+	}
+	if p.kind == endingProvider {
+		clear(p.valid)
+	}
+	ident.ConnectorData = p.mintLocked(p.logins)
+	return ident, nil
+}
+
+// HasRefreshCredential tells data without a refresh token apart, as the OIDC
+// connector does.
+func (p *fakeProvider) HasRefreshCredential(data []byte) bool {
+	var parsed upstreamConnectorData
+	return json.Unmarshal(data, &parsed) == nil && parsed.RefreshToken != ""
+}
+
+func (p *fakeProvider) Refresh(_ context.Context, scopes connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	p.mu.Lock()
+	p.lastScopes = scopes
+	p.calls++
+	p.inFlight++
+	p.maxInFlight = max(p.maxInFlight, p.inFlight)
+	during := p.during
+	p.during = nil
+	p.mu.Unlock()
+	defer func() {
+		p.mu.Lock()
+		p.inFlight--
+		p.mu.Unlock()
+	}()
+	if during != nil {
+		during()
+	}
+
+	ident, err, afterSpend := p.answer(ident)
+	if afterSpend != nil {
+		afterSpend()
+	}
+	return ident, err
+}
+
+// answer is the answer of the provider to a refresh of ident, and the hook to
+// run once it spent a refresh token.
+func (p *fakeProvider) answer(ident connector.Identity) (connector.Identity, error, func()) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if len(p.answers) > 0 {
+		answer := p.answers[0]
+		p.answers = p.answers[1:]
+		return ident, answer, nil
+	}
+
+	var data upstreamConnectorData
+	if err := json.Unmarshal(ident.ConnectorData, &data); err != nil || data.RefreshToken == "" {
+		return ident, fmt.Errorf("oidc: no refresh token: %w", connector.ErrRefreshRefused), nil
+	}
+	login, ok := p.valid[data.RefreshToken]
+	if !ok {
+		if login, isSpent := p.spent[data.RefreshToken]; isSpent {
+			p.reused++
+			if p.kind == familyProvider {
+				for token, l := range p.valid {
+					if l == login {
+						delete(p.valid, token)
+					}
+				}
+			}
+		}
+		if p.kind == claimingProvider {
+			return ident, fmt.Errorf("oidc: failed to get refresh token: %w: %w", claimedByAnotherClient(), connector.ErrRefreshRefused), nil
+		}
+		return ident, fmt.Errorf("oidc: failed to get refresh token: %w: %w", refusedGrant(), connector.ErrRefreshRefused), nil
+	}
+	if !p.kind.rotates() {
+		return ident, nil, nil
+	}
+
+	delete(p.valid, data.RefreshToken)
+	p.spent[data.RefreshToken] = login
+	successor := p.mintLocked(login)
+	afterSpend := p.afterSpend
+	p.afterSpend = nil
+	if p.failAfterRotation > 0 {
+		p.failAfterRotation--
+		return ident, &connector.RefreshedError{
+			ConnectorData: successor,
+			Err:           fmt.Errorf("oidc: error loading userinfo: %w", connector.ErrUpstreamUnavailable),
+		}, afterSpend
+	}
+	ident.ConnectorData = successor
+	return ident, nil, afterSpend
+}
+
+// isLive reports whether data holds a refresh token the provider accepts.
+func (p *fakeProvider) isLive(data []byte) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	var parsed upstreamConnectorData
+	if json.Unmarshal(data, &parsed) != nil {
+		return false
+	}
+	_, ok := p.valid[parsed.RefreshToken]
+	return ok
+}
+
+func (p *fakeProvider) snapshot() (calls, reused, maxInFlight, logins int) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.calls, p.reused, p.maxInFlight, p.logins
+}
+
+// claimedByAnotherClient is the answer of dex up to v2.45 to a refresh token it
+// no longer holds.
+func claimedByAnotherClient() *oauth2.RetrieveError {
+	const desc = "Refresh token is invalid or has already been claimed by another client."
+	return &oauth2.RetrieveError{
+		Response:         &http.Response{StatusCode: http.StatusBadRequest},
+		Body:             []byte(`{"error":"invalid_request","error_description":"` + desc + `"}`),
+		ErrorCode:        "invalid_request",
+		ErrorDescription: desc,
+	}
+}
+
+// lockedClock is a testClock that requests on several goroutines may read.
+type lockedClock struct {
+	mu  sync.Mutex
+	now time.Time
+}
+
+func (c *lockedClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.now
+}
+
+func (c *lockedClock) advance(d time.Duration) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.now = c.now.Add(d)
+}
+
+// upstreamWorld is a user with several clients signed in through one provider,
+// served by replicas of dex that share one storage.
+type upstreamWorld struct {
+	t        *testing.T
+	clk      *lockedClock
+	provider *fakeProvider
+	servers  []*Server
+	tokens   map[string]*internal.RefreshToken // the latest refresh token of each client
+
+	// ticks renew the leases of the upstream credential, when the test sends
+	// them (renewLease): the replicas renew nothing on their own.
+	ticks chan time.Time
+}
+
+// worldOptions configure an upstreamWorld.
+type worldOptions struct {
+	// realTime runs the replicas on the clock of the machine, with real waits
+	// and renewals, a lease of leaseTTL and no reuse interval.
+	realTime bool
+	leaseTTL time.Duration
+	// wrap wraps the storage of replica i.
+	wrap func(i int, s storage.Storage) storage.Storage
+}
+
+var worldClients = []string{"webapp", "kubeconfig-generator", "grafana"}
+
+// newUpstreamWorld starts replicas of dex on one memory storage, with
+// sessions off. maxAge is the identity refresh maxAge of their config, which
+// takes effect with identityRefresh (310).
+func newUpstreamWorld(t *testing.T, kind providerKind, replicas int, maxAge time.Duration, opts ...worldOptions) *upstreamWorld {
+	t.Helper()
+	var opt worldOptions
+	if len(opts) > 0 {
+		opt = opts[0]
+	}
+	w := &upstreamWorld{
+		t:        t,
+		clk:      &lockedClock{now: time.Date(2026, 11, 12, 12, 0, 0, 0, time.UTC)},
+		provider: newFakeProvider(kind),
+		tokens:   map[string]*internal.RefreshToken{},
+		ticks:    make(chan time.Time),
+	}
+	if opt.realTime {
+		w.clk.now = time.Now()
+	}
+	var shared storage.Storage
+	for i := range replicas {
+		// The mock connector of the first replica is in the shared storage.
+		var conns []storage.Connector
+		if i == 0 {
+			conns = []storage.Connector{mockConnector("mock")}
+		}
+		httpServer, s := newTestServerWith(t, conns, func(c *Config) {
+			c.AllowedGrantTypes = []string{dexoauth2.GrantTypeAuthorizationCode, dexoauth2.GrantTypeRefreshToken}
+			if shared == nil {
+				shared = c.Storage
+			}
+			c.Storage = shared
+			if opt.wrap != nil {
+				c.Storage = opt.wrap(i, shared)
+			}
+			c.Now = w.clk.Now
+			c.RefreshTokenPolicy = tokens.NewRefreshStrategy(true, 0, 0, 2*time.Minute, w.clk.Now)
+			if opt.realTime {
+				c.Now = time.Now
+				c.RefreshTokenPolicy = tokens.NewRefreshStrategy(true, 0, 0, 0, time.Now)
+			}
+			c.SessionConfig = nil
+		})
+		t.Cleanup(httpServer.Close)
+		if i == 0 {
+			require.NoError(t, s.storage.CreateConnector(t.Context(), storage.Connector{
+				ID: upstreamConnID, Type: "mockCallback", Name: "Upstream", ResourceVersion: "1",
+			}))
+			registerClients(t, s, worldClients...)
+		}
+		s.connectors.Set(upstreamConnID, connectors.Connector{ResourceVersion: "1", Connector: w.provider})
+		if opt.realTime {
+			s.issuer.Refresh.UpstreamLeaseTTL = opt.leaseTTL
+			s.issuer.Refresh.UpstreamPollPeriod = 5 * time.Millisecond
+			s.issuer.Refresh.Sleep = func(ctx context.Context, d time.Duration) error {
+				time.Sleep(d)
+				return ctx.Err()
+			}
+		} else {
+			s.issuer.Refresh.LeaseTicker = func(time.Duration) (<-chan time.Time, func()) { return w.ticks, func() {} }
+		}
+		w.servers = append(w.servers, s)
+	}
+	return w
+}
+
+// renewLease renews the lease of the upstream credential, as the request
+// holding it does on its own, if one holds it: the second tick goes through
+// only once the renewal of the first is done.
+func (w *upstreamWorld) renewLease() {
+	w.t.Helper()
+	if w.session().UpstreamLease.IsZero() {
+		return
+	}
+	for range 2 {
+		select {
+		case w.ticks <- w.clk.Now():
+		case <-time.After(time.Second):
+			w.t.Fatal("the lease is held but not renewed")
+		}
+	}
+}
+
+func (w *upstreamWorld) login(client string, replica int) {
+	w.t.Helper()
+	w.tokens[client] = loginThroughCallback(w.t, w.servers[replica], client, w.clk.Now())
+}
+
+// refresh refreshes the latest token of client on replica, and keeps the
+// rotated one.
+func (w *upstreamWorld) refresh(client string, replica int) *httptest.ResponseRecorder {
+	w.t.Helper()
+	token := w.tokens[client]
+	raw, err := internal.Marshal(token)
+	require.NoError(w.t, err)
+	body := url.Values{"grant_type": {"refresh_token"}, "refresh_token": {raw}}
+	req := httptest.NewRequest(http.MethodPost, "/token", strings.NewReader(body.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth(client, upstreamSecret)
+	rr := httptest.NewRecorder()
+	w.servers[replica].ServeHTTP(rr, req)
+	if rr.Code == http.StatusOK {
+		var resp struct {
+			RefreshToken string `json:"refresh_token"`
+		}
+		require.NoError(w.t, json.Unmarshal(rr.Body.Bytes(), &resp))
+		rotated := new(internal.RefreshToken)
+		require.NoError(w.t, internal.Unmarshal(resp.RefreshToken, rotated))
+		w.tokens[client] = rotated
+	}
+	return rr
+}
+
+func (w *upstreamWorld) requireRefresh(client string, replica, status int) *httptest.ResponseRecorder {
+	w.t.Helper()
+	rr := w.refresh(client, replica)
+	require.Equal(w.t, status, rr.Code, "refresh of %s on replica %d: %s", client, replica, rr.Body.String())
+	return rr
+}
+
+func (w *upstreamWorld) session() storage.OfflineSessions {
+	w.t.Helper()
+	session, err := w.servers[0].storage.GetOfflineSessions(context.Background(), upstreamUserID, upstreamConnID)
+	if errors.Is(err, storage.ErrNotFound) {
+		return storage.OfflineSessions{} // nobody logged in yet
+	}
+	require.NoError(w.t, err)
+	return session
+}
+
+// requireInvariants checks I1 and I3, and that no lease is left behind.
+func (w *upstreamWorld) requireInvariants() {
+	w.t.Helper()
+	_, reused, maxInFlight, _ := w.provider.snapshot()
+	require.Zero(w.t, reused, "I1: a spent upstream refresh token is never presented")
+	require.LessOrEqual(w.t, maxInFlight, 1, "I3: one request spends the shared credential at a time")
+	require.True(w.t, w.session().UpstreamLease.IsZero(), "no lease outlives its request")
+}
+
+// requireEveryClientRefreshes checks I2 and I4: once the reuse interval has
+// passed, every client that logged in refreshes on every replica, with no
+// login, and the offline session holds a live credential.
+func (w *upstreamWorld) requireEveryClientRefreshes() {
+	w.t.Helper()
+	_, _, _, logins := w.provider.snapshot()
+	for round := range 2 {
+		w.clk.advance(3 * time.Minute)
+		for _, client := range worldClients {
+			if w.tokens[client] == nil {
+				continue
+			}
+			w.requireRefresh(client, round%len(w.servers), http.StatusOK)
+		}
+	}
+	_, _, _, after := w.provider.snapshot()
+	require.Equal(w.t, logins, after, "I2: no client needs another login")
+	require.True(w.t, w.provider.isLive(w.session().ConnectorData), "I4: the offline session holds a live credential")
+	w.requireInvariants()
+}
+
+// TestUpstreamCredentialStates runs every transition against every kind of
+// provider.
+func TestUpstreamCredentialStates(t *testing.T) {
+	transitions := []struct {
+		name string
+		// replicas and maxAge configure the world.
+		replicas int
+		maxAge   time.Duration
+		// kinds limits the transition to some providers; all when empty.
+		kinds []providerKind
+		run   func(t *testing.T, w *upstreamWorld)
+	}{
+		{
+			name: "logins with refresh tokens",
+			run: func(t *testing.T, w *upstreamWorld) {
+				w.login("webapp", 0)
