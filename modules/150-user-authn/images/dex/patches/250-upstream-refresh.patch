+			session, err := s.storage.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+			require.NoError(t, err)
+			assert.Equal(t, tc.expectedShare, session.ConnectorData)
+
+			clk.advance(5 * time.Minute)
+			requireRefreshSucceeds(t, s, clientID, token)
+		})
+	}
+}
