+// kubernetesRefreshTokenLock is how long the kubernetes storage holds the lock
+// of a refresh token before another request may break it (lockTimeout in
+// storage/kubernetes/lock.go).
+const kubernetesRefreshTokenLock = 10 * time.Second
+
+// The connector call ends early enough within the lease of the shared credential
+// to leave room for the writes that publish its successor: a request that takes
+// an expired lease over must not spend a credential whose successor is still
+// on its way.
+func TestUpstreamRefreshEndsWithinLease(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := newRotatingUpstream()
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, upstream.mint())
+
+	requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+
+	require.True(t, upstream.lastHasDeadline)
+	assert.LessOrEqual(t, upstream.lastTimeLeft, tokens.UpstreamRefreshTimeout)
+	// Room for the writes after the call and for clocks that differ.
+	const margin = 5 * time.Second
+	assert.LessOrEqual(t, tokens.UpstreamRefreshTimeout+margin, tokens.DefaultUpstreamLeaseTTL)
+}
