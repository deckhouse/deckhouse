+
+// droppingStorage stands for a request that lost the race to this one and,
+// seeing nothing rotated in time, dropped the shared credential as dead right
+// before this request publishes the successor: before the second update of the
+// offline session, the first being the lease.
+type droppingStorage struct {
+	storage.Storage
+	updates int
+}
+
+func (d *droppingStorage) UpdateOfflineSessions(ctx context.Context, userID, connID string, updater func(storage.OfflineSessions) (storage.OfflineSessions, error)) error {
+	d.updates++
+	if d.updates == 2 {
+		if err := d.Storage.UpdateOfflineSessions(ctx, userID, connID,
+			func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+				old.ConnectorData = nil
+				return old, nil
+			}); err != nil {
+			return err
+		}
+	}
+	return d.Storage.UpdateOfflineSessions(ctx, userID, connID, updater)
+}
