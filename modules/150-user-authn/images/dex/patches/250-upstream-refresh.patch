+// racingStorage stands for other clients of the user that win every race for the
+// shared credential: each read of the offline session returns the credential it
+// holds, by then spent by another client that published its successor.
+type racingStorage struct {
+	storage.Storage
+	t        *testing.T
+	upstream *rotatingUpstream
+}
+
+func (r *racingStorage) GetOfflineSessions(ctx context.Context, userID, connID string) (storage.OfflineSessions, error) {
+	session, err := r.Storage.GetOfflineSessions(ctx, userID, connID)
+	if err != nil || len(session.ConnectorData) == 0 {
+		return session, err
+	}
+	r.upstream.spend(r.t, session.ConnectorData)
+	successor := r.upstream.mint()
+	require.NoError(r.t, r.Storage.UpdateOfflineSessions(ctx, userID, connID,
+		func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+			old.ConnectorData = successor
+			return old, nil
+		}))
+	return session, nil
+}
+
+// A request that keeps losing the race for the shared credential gives up after
+// a bounded number of attempts with a server error, not invalid_grant: the
+// credential is alive, other clients are spending it, and the user is fine.
+func TestUpstreamRotationContendedSharedCredentialIsNotRefused(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	upstream := newRotatingUpstream()
+	var inner storage.Storage
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
+		inner = c.Storage
+		c.Storage = &racingStorage{Storage: c.Storage, t: t, upstream: upstream}
+	})
+	defer httpServer.Close()
+
+	registerUpstreamConnector(t, s, upstreamConnID, upstream)
+	registerClients(t, s, clientID)
+	createRefreshToken(t, s, upstreamConnID, refreshID, clientID, nil, clk.now)
+	createOfflineSession(t, s, upstreamConnID, map[string]string{clientID: refreshID}, upstream.mint())
+
+	rr := refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+	requireOAuth2Error(t, rr, http.StatusInternalServerError, "invalid_request")
+	require.Equal(t, 3, upstream.calls, "the first attempt and two more, each with the credential the winner published")
+
+	session, err := inner.GetOfflineSessions(t.Context(), upstreamUserID, upstreamConnID)
+	require.NoError(t, err)
+	requireCredentialValid(t, upstream, session.ConnectorData, "a credential that keeps moving is not dropped as dead")
+}
+
+// droppingStorage stands for a request that lost the race to this one and,
+// seeing nothing rotated in time, dropped the shared credential as dead right
+// before this request publishes the successor.
+type droppingStorage struct {
+	storage.Storage
+	isDropped bool
+}
+
+func (d *droppingStorage) UpdateOfflineSessions(ctx context.Context, userID, connID string, updater func(storage.OfflineSessions) (storage.OfflineSessions, error)) error {
+	if !d.isDropped {
+		d.isDropped = true
+		if err := d.Storage.UpdateOfflineSessions(ctx, userID, connID,
+			func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+				old.ConnectorData = nil
+				return old, nil
+			}); err != nil {
+			return err
+		}
+	}
+	return d.Storage.UpdateOfflineSessions(ctx, userID, connID, updater)
+}
+
+// The successor of a shared credential goes to an offline session that lost its
+// credential meanwhile: it is the only live one, and the request that dropped
+// the spent one could not know that it had a successor.
+func TestUpstreamRotationRestoresDroppedSharedCredential(t *testing.T) {
+	const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, func(c *Config) {
+		rotatingPolicy(clk)(c)
