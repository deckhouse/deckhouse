+	"log/slog"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// failingPasswordStorage fails every read of a password.
+type failingPasswordStorage struct {
+	storage.Storage
+}
+
+func (failingPasswordStorage) GetPassword(context.Context, string) (storage.Password, error) {
+	return storage.Password{}, errors.New("storage unavailable")
+}
+
+// The refresh of a local user deleted from the password store, or replaced by
+// another user with the same email, is refused for good; a storage that fails
+// to answer says nothing about the user and is a provider that did not answer.
+func TestPasswordDBRefreshIdentityGone(t *testing.T) {
+	store := memory.New(slog.New(slog.DiscardHandler))
+	require.NoError(t, store.CreatePassword(context.Background(), storage.Password{
+		Email: "jane@example.com", Username: "jane", UserID: "jane-id", Hash: []byte("$2a$10$"),
+	}))
+
+	tests := []struct {
+		name          string
+		storage       storage.Storage
+		ident         connector.Identity
+		isGone        bool
+		isUnavailable bool
+	}{
+		{name: "user deleted", storage: store, ident: connector.Identity{UserID: "john-id", Email: "john@example.com"}, isGone: true},
+		{name: "email reused by another user", storage: store, ident: connector.Identity{UserID: "old-jane-id", Email: "jane@example.com"}, isGone: true},
+		{name: "storage failing", storage: failingPasswordStorage{store}, ident: connector.Identity{UserID: "jane-id", Email: "jane@example.com"}, isUnavailable: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := NewPasswordDB(tc.storage).(connector.RefreshConnector).Refresh(context.Background(), connector.Scopes{}, tc.ident)
+			require.Error(t, err)
+			assert.Equal(t, tc.isGone, errors.Is(err, connector.ErrIdentityGone), "error: %v", err)
+			assert.Equal(t, tc.isUnavailable, connector.Unavailable(err), "error: %v", err)
+		})
+	}
+
+	ident, err := NewPasswordDB(store).(connector.RefreshConnector).Refresh(context.Background(), connector.Scopes{},
+		connector.Identity{UserID: "jane-id", Email: "jane@example.com"})
+	require.NoError(t, err)
+	assert.Equal(t, "jane", ident.Username)
+}
