+// The refresh of a local user reads its password: a password store that fails to
+// answer is a provider that did not answer, and the refresh token is kept for the
+// next attempt; a user deleted from the store, or replaced by another one with the
+// same email, is refused as before.
+func TestUpstreamRefreshLocalPasswordStore(t *testing.T) {
+	jane := storage.Password{Email: "jane@example.com", Username: "jane", UserID: upstreamUserID, Hash: []byte("$2a$10$")}
+	replaced := jane
+	replaced.UserID = "2"
+	tests := []struct {
+		name      string
+		password  *storage.Password
+		throttled bool
+		status    int
+		expected  string
+	}{
+		{
+			name:      "password store throttled",
+			password:  &jane,
+			throttled: true,
+			status:    http.StatusServiceUnavailable,
+			expected:  "temporarily_unavailable",
+		},
+		{
+			name:     "user deleted",
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+		{
+			name:     "email reused by another user",
+			password: &replaced,
+			status:   http.StatusBadRequest,
+			expected: "invalid_grant",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			const clientID, refreshID = "kubeconfig-generator", "cli-refresh-id"
+			clk := &testClock{now: time.Now()}
+			httpServer, s := newTestServer(t, rotatingPolicy(clk))
+			defer httpServer.Close()
+
+			// A store of its own: a read of the password from the memory storage of
+			// the server, under its lock of the refresh token, would deadlock.
+			passwords := &throttledPasswordStore{Storage: memory.New(slog.New(slog.DiscardHandler)), throttled: tc.throttled}
+			if tc.password != nil {
+				require.NoError(t, passwords.CreatePassword(t.Context(), *tc.password))
+			}
+			registerUpstreamConnector(t, s, connectors.LocalConnector, connectors.NewPasswordDB(passwords))
+			registerClients(t, s, clientID)
+			createRefreshToken(t, s, connectors.LocalConnector, refreshID, clientID, nil, clk.now)
+			createOfflineSession(t, s, connectors.LocalConnector, map[string]string{clientID: refreshID}, nil)
+
+			rr := refreshTokenRequest(t, t.Context(), s, clientID, requestToken(refreshID))
+			requireOAuth2Error(t, rr, tc.status, tc.expected)
+
+			stored, err := s.storage.GetRefresh(t.Context(), refreshID)
+			require.NoError(t, err)
+			require.Equal(t, "token-"+refreshID, stored.Token, "the refresh token is not rotated")
+			if !tc.throttled {
+				return
+			}
+			passwords.throttled = false
+			requireRefreshSucceeds(t, s, clientID, requestToken(refreshID))
+		})
+	}
+}
