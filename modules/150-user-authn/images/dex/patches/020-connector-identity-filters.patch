diff --git a/server/connector_filters_test.go b/server/connector_filters_test.go
new file mode 100644
index 00000000..ce40b3d7
--- /dev/null
+++ b/server/connector_filters_test.go
@@ -0,0 +1,139 @@
+package server
+
+import (
+	"log/slog"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+func TestApplyConnectorAccessFilters(t *testing.T) {
+	tests := []struct {
+		name           string
+		conn           storage.Connector
+		claims         storage.Claims
+		expectedGroups []string
+		expectedErr    bool
+	}{
+		{
+			name:           "no limits keep email and groups",
+			claims:         storage.Claims{Email: "jane@example.com", Groups: []string{"a", "b"}},
+			expectedGroups: []string{"a", "b"},
+		},
+		{
+			name:           "exact email accepted case-insensitively",
+			conn:           storage.Connector{AllowedEmails: []string{"Jane@Example.com"}},
+			claims:         storage.Claims{Email: "jane@example.com", Groups: []string{"a"}},
+			expectedGroups: []string{"a"},
+		},
+		{
+			name:        "email outside the list is refused",
+			conn:        storage.Connector{AllowedEmails: []string{"jane@example.com"}},
+			claims:      storage.Claims{Email: "john@example.com"},
+			expectedErr: true,
+		},
+		{
+			name:           "domain accepted case-insensitively",
+			conn:           storage.Connector{AllowedEmailDomains: []string{"Contractor.Example"}},
+			claims:         storage.Claims{Email: "alice@contractor.example", Groups: []string{"a"}},
+			expectedGroups: []string{"a"},
+		},
+		{
+			name:        "subdomain is not the domain",
+			conn:        storage.Connector{AllowedEmailDomains: []string{"example.com"}},
+			claims:      storage.Claims{Email: "alice@corp.example.com"},
+			expectedErr: true,
+		},
+		{
+			name:        "domain is taken after the last at sign",
+			conn:        storage.Connector{AllowedEmailDomains: []string{"evil.example"}},
+			claims:      storage.Claims{Email: "\"x@evil.example\"@corp.example"},
+			expectedErr: true,
+		},
+		{
+			name:           "either an email or a domain match is enough",
+			conn:           storage.Connector{AllowedEmails: []string{"boss@partner.example"}, AllowedEmailDomains: []string{"contractor.example"}},
+			claims:         storage.Claims{Email: "boss@partner.example"},
+			expectedGroups: nil,
+		},
+		{
+			name:        "email without a domain is refused when only domains are allowed",
+			conn:        storage.Connector{AllowedEmailDomains: []string{"contractor.example"}},
+			claims:      storage.Claims{Email: "alice"},
+			expectedErr: true,
+		},
+		{
+			name:           "groups reduced to the intersection",
+			conn:           storage.Connector{AllowedGroups: []string{"contractors"}},
+			claims:         storage.Claims{Email: "alice@contractor.example", Groups: []string{"contractors", "other-team"}},
+			expectedGroups: []string{"contractors"},
+		},
+		{
+			name:        "empty intersection is refused",
+			conn:        storage.Connector{AllowedGroups: []string{"contractors"}},
+			claims:      storage.Claims{Email: "carol@contractor.example", Groups: []string{"other-team"}},
+			expectedErr: true,
+		},
+		{
+			name:        "user without groups is refused when groups are limited",
+			conn:        storage.Connector{AllowedGroups: []string{"contractors"}},
+			claims:      storage.Claims{Email: "carol@contractor.example"},
+			expectedErr: true,
+		},
+		{
+			name:           "both axes pass together",
+			conn:           storage.Connector{AllowedEmailDomains: []string{"contractor.example"}, AllowedGroups: []string{"contractors"}},
+			claims:         storage.Claims{Email: "alice@contractor.example", Groups: []string{"contractors", "other-team"}},
+			expectedGroups: []string{"contractors"},
+		},
+		{
+			name:        "email limit is checked before groups",
+			conn:        storage.Connector{AllowedEmailDomains: []string{"contractor.example"}, AllowedGroups: []string{"contractors"}},
+			claims:      storage.Claims{Email: "bob@other.example", Groups: []string{"contractors"}},
+			expectedErr: true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			claims := tc.claims
+			err := applyConnectorAccessFilters(tc.conn, &claims)
+			if tc.expectedErr {
+				require.Error(t, err)
+				var nae *NotAllowedError
+				require.ErrorAs(t, err, &nae)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tc.expectedGroups, claims.Groups)
+		})
+	}
+}
+
+func TestApplyAccessFiltersLooksUpStaticConnector(t *testing.T) {
+	ctx := t.Context()
+	s := storage.WithStaticConnectors(memory.New(slog.Default()), []storage.Connector{{
+		ID: "corp", Type: "mock", Name: "Corp",
+		AllowedEmailDomains: []string{"corp.example"},
+		AllowedGroups:       []string{"staff"},
+	}})
+	srv := &Server{storage: s}
+	client := storage.Client{AllowedGroups: []string{"staff", "guests"}}
+
+	claims := storage.Claims{Email: "ann@corp.example", Groups: []string{"staff", "guests", "x"}}
+	require.NoError(t, srv.applyAccessFilters(ctx, client, "corp", &claims))
+	// client keeps staff+guests, connector then keeps staff only
+	require.Equal(t, []string{"staff"}, claims.Groups)
+
+	claims = storage.Claims{Email: "ann@other.example", Groups: []string{"staff"}}
+	err := srv.applyAccessFilters(ctx, client, "corp", &claims)
+	var nae *NotAllowedError
+	require.ErrorAs(t, err, &nae)
+
+	// a connector unknown to storage (no limits configured anywhere) does not block
+	claims = storage.Claims{Email: "ann@other.example", Groups: []string{"staff"}}
+	require.NoError(t, srv.applyAccessFilters(ctx, client, "missing", &claims))
+}
diff --git a/server/handlers.go b/server/handlers.go
index ede7a28f..651d8724 100644
--- a/server/handlers.go
+++ b/server/handlers.go
@@ -791,6 +791,63 @@ func applyClientAccessFilters(client storage.Client, claims *storage.Claims) err
 	return nil
 }
 
+// applyConnectorAccessFilters enforces the connector's allowedEmails /
+// allowedEmailDomains / allowedGroups on the claims that will be issued, for
+// every connector type alike. Emails and domains compare case-insensitively;
+// a domain is the part of the email after the last '@' and must match
+// exactly. Groups are reduced to the intersection with allowedGroups. An
+// empty allow-list means no restriction.
+func applyConnectorAccessFilters(conn storage.Connector, claims *storage.Claims) error {
+	if len(conn.AllowedEmails) > 0 || len(conn.AllowedEmailDomains) > 0 {
+		email := strings.ToLower(strings.TrimSpace(claims.Email))
+		allowed := false
+		for _, e := range conn.AllowedEmails {
+			if strings.ToLower(strings.TrimSpace(e)) == email {
+				allowed = true
+				break
+			}
+		}
+		if !allowed {
+			if at := strings.LastIndex(email, "@"); at >= 0 && at < len(email)-1 {
+				domain := email[at+1:]
+				for _, d := range conn.AllowedEmailDomains {
+					if strings.ToLower(strings.TrimSpace(d)) == domain {
+						allowed = true
+						break
+					}
+				}
+			}
+		}
+		if !allowed {
+			return &NotAllowedError{Reason: fmt.Sprintf("Email %s not allowed by connector", claims.Email)}
+		}
+	}
+	if len(conn.AllowedGroups) > 0 {
+		claims.Groups = groups.Filter(claims.Groups, conn.AllowedGroups)
+		if len(claims.Groups) == 0 {
+			return &NotAllowedError{Reason: fmt.Sprintf("Email %s not in groups allowed by connector", claims.Email)}
+		}
+	}
+	return nil
+}
+
+// applyAccessFilters runs the DexClient filters and then the connector's own
+// limits. Both must pass; the connector is looked up in storage, where static
+// (config file) connectors are visible through WithStaticConnectors.
+func (s *Server) applyAccessFilters(ctx context.Context, client storage.Client, connectorID string, claims *storage.Claims) error {
+	if err := applyClientAccessFilters(client, claims); err != nil {
+		return err
+	}
+	conn, err := s.storage.GetConnector(ctx, connectorID)
+	if err != nil {
+		if errors.Is(err, storage.ErrNotFound) {
+			return nil
+		}
+		return fmt.Errorf("failed to retrieve connector %q: %w", connectorID, err)
+	}
+	return applyConnectorAccessFilters(conn, claims)
+}
