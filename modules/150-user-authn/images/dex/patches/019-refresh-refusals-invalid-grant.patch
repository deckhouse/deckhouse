 func (cli *client) getRefreshToken(id string) (r RefreshToken, err error) {
+	// The ID comes from the refresh token a client presents: one that no object
+	// can be named after names no stored token, as with the other storages
+	// (Deckhouse). Asked for anyway, the client refuses the name with an error
+	// that is no ErrNotFound, and the refresh answered 500 instead of
+	// invalid_grant.
+	if !validResourceName(id) {
