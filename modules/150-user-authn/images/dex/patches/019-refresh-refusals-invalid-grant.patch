+// connectorRefreshError is the answer to a refresh the connector failed:
+// invalid_grant when the provider answered that the user is gone
+// (connector.ErrIdentityGone) or refused the refresh with OAuth2 invalid_grant
+// (the stored credential, or a locked account), a server error for anything
+// else, a provider that did not answer among them (Deckhouse). Whether patch 017
+// retries with another credential is decided by credentialRefused alone, apart
+// from this answer.
+func connectorRefreshError(err error) *refreshError {
+	if errors.Is(err, connector.ErrIdentityGone) || grantRefused(err) {
+		return newInvalidGrantError("The identity provider refused to refresh the identity.")
+	}
+	return newInternalServerError()
