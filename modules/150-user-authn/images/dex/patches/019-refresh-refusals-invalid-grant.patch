+
+// Tests of 019-refresh-refusals-invalid-grant (Deckhouse): a refresh token that
+// cannot be used is refused with invalid_grant, as RFC 6749, section 5.2, has it.
+
+const refusedByProvider = `{"error":"invalid_grant","error_description":"The identity provider refused to refresh the identity."}`
+
+// The password store answers that a deleted user, or a user replaced by a new one
+// with the same email, is gone; a failure to read it is no such answer.
+func TestPasswordDBRefreshOfGoneUser(t *testing.T) {
+	ident := connector.Identity{UserID: "1", Username: "jane", Email: "jane@example.com"}
+	tests := []struct {
+		name     string
+		password *storage.Password
+		gone     bool
+	}{
+		{name: "user deleted", gone: true},
+		{name: "a new user with the same email", password: &storage.Password{Email: "jane@example.com", Username: "jane", UserID: "2"}, gone: true},
+		{name: "user still there", password: &storage.Password{Email: "jane@example.com", Username: "jane", UserID: "1"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := memory.New(slog.New(slog.DiscardHandler))
+			if tc.password != nil {
+				require.NoError(t, s.CreatePassword(t.Context(), *tc.password))
+			}
+			_, err := passwordDB{s}.Refresh(t.Context(), connector.Scopes{}, ident)
+			if tc.gone {
+				require.ErrorIs(t, err, connector.ErrIdentityGone)
+				return
+			}
+			require.NoError(t, err)
+		})
+	}
+
+	_, err := passwordDB{failingPasswordStorage{memory.New(slog.New(slog.DiscardHandler))}}.Refresh(t.Context(), connector.Scopes{}, ident)
+	require.Error(t, err)
+	require.NotErrorIs(t, err, connector.ErrIdentityGone, "a store that did not answer says nothing about the user")
+}
+
+type failingPasswordStorage struct {
+	storage.Storage
+}
+
+func (failingPasswordStorage) GetPassword(context.Context, string) (storage.Password, error) {
+	return storage.Password{}, errors.New("storage down")
+}
+
+// goneUpstream is a provider that answers every refresh that the user is gone,
+// the way the LDAP connector reports a user it no longer finds.
+type goneUpstream struct {
+	calls int
+}
+
+func (u *goneUpstream) Refresh(_ context.Context, _ connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	u.calls++
