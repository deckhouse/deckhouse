+	return connector.Identity{}, nil
+}
+
+// The refresh of a user the provider no longer knows is refused with
+// invalid_grant, so the client asks the user to log in again instead of
+// retrying a server error. The shared credential is not taken for dead.
+func TestRefreshOfUserGoneUpstream(t *testing.T) {
+	const (
+		connID    = "ldap"
+		clientID  = "kubeconfig-generator"
+		refreshID = "cli-refresh-id"
+	)
+	clk := &testClock{now: time.Now()}
+	httpServer, s := newTestServer(t, rotatingPolicy(clk))
+	defer httpServer.Close()
+
+	upstream := &goneUpstream{}
+	require.NoError(t, s.storage.CreateConnector(t.Context(), storage.Connector{
+		ID: connID, Type: "mockCallback", Name: "LDAP", ResourceVersion: "1",
+	}))
+	s.mu.Lock()
+	s.connectors[connID] = Connector{ResourceVersion: "1", Connector: upstream}
+	s.mu.Unlock()
+	registerClients(t, s, "secret", clientID)
+
+	shared := []byte(`{"username":"jane"}`)
+	createRefreshToken(t, s, connID, refreshID, clientID, nil, clk.now)
+	require.NoError(t, s.storage.CreateOfflineSessions(t.Context(), storage.OfflineSessions{
+		UserID:        "1",
+		ConnID:        connID,
+		Refresh:       map[string]*storage.RefreshTokenRef{clientID: {ID: refreshID, ClientID: clientID}},
+		ConnectorData: shared,
+	}))
+
+	rr := refreshTokenRequest(t, s, clientID, "secret", refreshID, "token-"+refreshID)
+	require.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+	require.JSONEq(t, refusedByProvider, rr.Body.String())
+	require.Equal(t, 1, upstream.calls, "the answer about the user is final, nothing is retried")
+
+	session, err := s.storage.GetOfflineSessions(t.Context(), "1", connID)
+	require.NoError(t, err)
+	require.Equal(t, shared, session.ConnectorData, "the credential is not taken for dead")
+}
+
+// A connector that reports the user gone, or a provider that refused the stored
+// credential, gets invalid_grant; any other failure, a provider that did not
+// answer among them, stays a server error.
+func TestConnectorRefreshError(t *testing.T) {
+	gone := fmt.Errorf("ldap: user not found %q: %w", "jane", connector.ErrIdentityGone)
+	require.Equal(t, newInvalidGrantError("The identity provider refused to refresh the identity."), connectorRefreshError(gone))
+	refused := fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{ErrorCode: "invalid_grant"})
+	require.Equal(t, newInvalidGrantError("The identity provider refused to refresh the identity."), connectorRefreshError(refused),
+		"a stored credential the provider refused, as main answers it")
+	require.Equal(t, newInternalServerError(), connectorRefreshError(errors.New("ldap: connection refused")))
+	require.Equal(t, newInternalServerError(), connectorRefreshError(fmt.Errorf("get password: %v", errors.New("storage down"))))
+}
+
+// lockingUpstream is a rotating provider that, while locked, refuses every
+// refresh as Deckhouse Dex refuses a locked account.
+type lockingUpstream struct {
+	*rotatingUpstream
+	lock string
+}
+
+func (u *lockingUpstream) Refresh(ctx context.Context, s connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	if u.lock == "" {
+		return u.rotatingUpstream.Refresh(ctx, s, ident)
+	}
+	u.calls++
+	return ident, fmt.Errorf("oidc: failed to get refresh token: %w", &oauth2.RetrieveError{
+		Response:         &http.Response{StatusCode: http.StatusBadRequest},
+		ErrorCode:        "invalid_grant",
+		ErrorDescription: u.lock,
+	})
+}
+
+// The refusal of a locked account by an upstream Deckhouse Dex (1.77 with this
+// patch, 1.78) is invalid_grant for the client, but the shared credential
+// outlives the lock: it is not dropped and no rotation is waited for, and once
+// the lock ends the refresh goes on without a login.
+func TestUpstreamLockKeepsSharedCredential(t *testing.T) {
+	for _, lock := range []string{"Account locked", "Account locked by an administrator"} {
+		t.Run(lock, func(t *testing.T) {
+			const (
+				connID    = "upstream-dex"
+				clientID  = "kubeconfig-generator"
+				refreshID = "cli-refresh-id"
+			)
+			clk := &testClock{now: time.Now()}
+			var reads *sessionReadStorage
+			httpServer, s := newTestServer(t, func(c *Config) {
+				rotatingPolicy(clk)(c)
+				reads = &sessionReadStorage{Storage: c.Storage}
+				c.Storage = reads
+			})
+			defer httpServer.Close()
+
+			upstream := &lockingUpstream{rotatingUpstream: &rotatingUpstream{valid: map[string]bool{}}, lock: lock}
+			require.NoError(t, s.storage.CreateConnector(t.Context(), storage.Connector{
+				ID: connID, Type: "mockCallback", Name: "Dex", ResourceVersion: "1",
+			}))
+			s.mu.Lock()
+			s.connectors[connID] = Connector{ResourceVersion: "1", Connector: upstream}
+			s.mu.Unlock()
+			registerClients(t, s, "secret", clientID)
+
+			shared := upstream.mint()
+			createRefreshToken(t, s, connID, refreshID, clientID, nil, clk.now)
+			require.NoError(t, s.storage.CreateOfflineSessions(t.Context(), storage.OfflineSessions{
+				UserID:        "1",
+				ConnID:        connID,
+				Refresh:       map[string]*storage.RefreshTokenRef{clientID: {ID: refreshID, ClientID: clientID}},
+				ConnectorData: shared,
+			}))
+
+			reads.reads = 0
+			rr := refreshTokenRequest(t, s, clientID, "secret", refreshID, "token-"+refreshID)
+			require.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+			require.JSONEq(t, refusedByProvider, rr.Body.String())
+			require.Equal(t, 1, upstream.calls, "one call")
+			require.Equal(t, lockCheckReads+1, reads.reads, "no wait for a rotation by another Dex")
+			session, err := s.storage.GetOfflineSessions(t.Context(), "1", connID)
+			require.NoError(t, err)
+			require.Equal(t, shared, session.ConnectorData, "the shared credential outlives the lock")
+
+			// The lock ended.
+			upstream.lock = ""
+			clk.advance(3 * time.Minute)
+			rr = refreshTokenRequest(t, s, clientID, "secret", refreshID, "token-"+refreshID)
+			require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+		})
+	}
+}
