+// lockRefusal reports whether retrieveErr is the refusal of a locked account by
+// Deckhouse Dex (Deckhouse): invalid_grant with the description of the lock,
+// "Account locked" or "Account locked by an administrator" (this patch, and the
+// Dex of 1.78). The refresh is refused, but the credential is alive and serves
+// again once the lock ends: it is no credential refusal, so 017 neither drops
+// it nor waits for a rotation. Only the exact descriptions of Dex count; any
+// other invalid_grant is a dead credential.
+func lockRefusal(retrieveErr *oauth2.RetrieveError) bool {
+	switch retrieveErr.ErrorDescription {
+	case "Account locked", "Account locked by an administrator":
+		return true
+	}
+	return false
