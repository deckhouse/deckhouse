@@ -0,0 +1,32 @@
+package templates
+
+import (
+	"log/slog"
+	"net/http"
+)
+
+// ErrCodeLoginExpired is the ErrCode of the error page of a sign-in whose auth
+// request has expired (Deckhouse patch 280). The request lives
+// expiry.authRequests from the start of the sign-in, so a login form, an
+// approval or a second factor left open longer than that finds nothing. A
+// theme tells the page apart by the code and explains it in its own words; a
+// theme that does not know the code shows ErrMsg.
+const ErrCodeLoginExpired = "login_expired"
+
+// loginExpiredMsg is the ErrMsg of the page of an expired sign-in.
+const loginExpiredMsg = "The sign-in has expired. Go back to the application and sign in again."
+
+// LoginExpired renders the error page of an expired sign-in with 400.
+// returnURL, when not empty, is the origin of the client of the sign-in (see
+// authflow.loginExpiredReturnURL): the theme offers it as a button back to the
+// application.
+func (t *Templates) LoginExpired(r *http.Request, w http.ResponseWriter, returnURL string) error {
+	return t.renderErr(r, w, http.StatusBadRequest, loginExpiredMsg, ErrCodeLoginExpired, returnURL)
+}
+
+// RenderLoginExpired is RenderError for an expired sign-in.
+func RenderLoginExpired(t *Templates, logger *slog.Logger, r *http.Request, w http.ResponseWriter, returnURL string) {
+	if err := t.LoginExpired(r, w, returnURL); err != nil {
+		logger.ErrorContext(r.Context(), "server template error", "err", err)
+	}
+}
