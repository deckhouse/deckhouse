@@ -1,8 +1,13 @@
 package authflow
 
 import (
+	"context"
 	"net/http"
+	"net/url"
 
+	"github.com/gorilla/mux"
+
+	"github.com/dexidp/dex/server/signinlog"
 	"github.com/dexidp/dex/server/templates"
 )
 
@@ -10,3 +15,52 @@ import (
 func (h *Handler) renderError(r *http.Request, w http.ResponseWriter, status int, description string) {
 	templates.RenderError(h.Templates, h.Logger, r, w, status, description)
 }
+
+// renderLoginExpired logs and renders a step of a sign-in whose auth request
+// has expired or is gone (Deckhouse patch 280). returnURL is the application
+// to go back to, when the step can tell it (loginExpiredReturnURL).
+func (h *Handler) renderLoginExpired(r *http.Request, w http.ResponseWriter, returnURL string) {
+	signinlog.LoginExpired(r.Context(), h.Logger, mux.Vars(r)["connector"], r.URL.Path)
+	templates.RenderLoginExpired(h.Templates, h.Logger, r, w, returnURL)
+}
+
+// loginExpiredReturnURL is the application an expired sign-in goes back to: the
+// origin of the redirect_uri in the connector selection of its login form
+// (back, "/auth?client_id=...&redirect_uri=..."), for the button of the page of
+// an expired sign-in (Deckhouse patch 280). The connector selection itself would
+// start the same sign-in of the client again, whose own state has expired too,
+// so the client would restart it once more.
+//
+// The back link comes from the address of the form, so it is checked as /auth
+// checks a sign-in: the client exists, and the redirect_uri passes
+// validateRedirectURI. The redirect_uri must also be https, so it is one of the
+// RedirectURIs of the client exactly: the other addresses validateRedirectURI
+// lets a public client use (loopback, out-of-band, the device callback) are not
+// https. Only the scheme and the host are kept; the path, the query, the
+// fragment and any userinfo are dropped. Empty when any of it fails: the page
+// then has no button.
+func (h *Handler) loginExpiredReturnURL(ctx context.Context, backLink string) string {
+	if backLink == "" {
+		return ""
+	}
+	back, err := url.Parse(backLink)
+	if err != nil {
+		return ""
+	}
+	clientID, redirectURI := back.Query().Get("client_id"), back.Query().Get("redirect_uri")
+	if clientID == "" || redirectURI == "" {
+		return ""
+	}
+	client, err := h.Storage.GetClient(ctx, clientID)
+	if err != nil {
+		return ""
+	}
+	if !validateRedirectURI(client, redirectURI) {
+		return ""
+	}
+	u, err := url.Parse(redirectURI)
+	if err != nil || u.Scheme != "https" || u.Host == "" {
+		return ""
+	}
+	return (&url.URL{Scheme: "https", Host: u.Host, Path: "/"}).String()
+}
