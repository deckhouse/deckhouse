@@ -0,0 +1,29 @@
+package signinlog
+
+import (
+	"context"
+	"log/slog"
+
+	"github.com/dexidp/dex/pkg/logsafe"
+)
+
+// ReasonLoginExpired: a step of a sign-in came after its auth request expired
+// (expiry.authRequests from the start of the sign-in) or was collected, for
+// example a login form left open longer than that (Deckhouse patch 280).
+const ReasonLoginExpired = "login_expired"
+
+// LoginExpiredMsg is the message of the line about an expired sign-in, the
+// text upstream logs (at ERROR) for an auth request it cannot find.
+const LoginExpiredMsg = "invalid 'state' parameter provided"
+
+// LoginExpired logs a step of a sign-in refused because its auth request has
+// expired: a warning, as the user caused it by waiting. The client and the user
+// are unknown, they were in the auth request; connectorID is the connector the
+// URL names, if any, and path the path of the step.
+func LoginExpired(ctx context.Context, logger *slog.Logger, connectorID, path string) {
+	attrs := []any{"reason", ReasonLoginExpired, "path", logsafe.Value(path)}
+	if connectorID != "" {
+		attrs = append(attrs, "connector_id", logsafe.Value(connectorID))
+	}
+	logger.WarnContext(ctx, LoginExpiredMsg, attrs...)
+}
