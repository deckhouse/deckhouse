 func (t *Templates) Err(r *http.Request, w http.ResponseWriter, errCode int, errMsg string) error {
+	return t.renderErr(r, w, errCode, errMsg, "", "")
+}
+
+// renderErr renders the error page. ErrCode names a case a theme may explain in
+// its own words, and ReturnURL is the application the page may send the user
+// back to; both are empty on other errors (Deckhouse patch 280, see expired.go).
+func (t *Templates) renderErr(r *http.Request, w http.ResponseWriter, errCode int, errMsg, code, returnURL string) error {
 	w.WriteHeader(errCode)
 	data := struct {
 		ErrType         string
 		ErrMsg          string
+		ErrCode         string
+		ReturnURL       string
 		ReqPath         string
 		BuildIdentifier string
-	}{http.StatusText(errCode), errMsg, r.URL.Path, t.buildID}
+	}{http.StatusText(errCode), errMsg, code, returnURL, r.URL.Path, t.buildID}
 	if err := t.errorTmpl.Execute(w, data); err != nil {
 		return fmt.Errorf("rendering template %s failed: %s", t.errorTmpl.Name(), err)
 	}
