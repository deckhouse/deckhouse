diff --git a/server/server_login_expired_test.go b/server/server_login_expired_test.go
new file mode 100644
index 00000000..d496b234
--- /dev/null
+++ b/server/server_login_expired_test.go
@@ -0,0 +1,253 @@
+package server
+
+import (
+	"io/fs"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"testing/fstest"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/mfa"
+	"github.com/dexidp/dex/server/signinlog"
+	"github.com/dexidp/dex/storage"
+	dexweb "github.com/dexidp/dex/web"
+)
+
+// overlayFS serves files over the web assets of dex.
+type overlayFS struct {
+	base  fs.FS
+	files fstest.MapFS
+}
+
+func (o overlayFS) Open(name string) (fs.File, error) {
+	if _, ok := o.files[name]; ok {
+		return o.files.Open(name)
+	}
+	return o.base.Open(name)
+}
+
+// newLoginExpiredServer is the sign-in log test server with a second factor and an error page that
+// prints its data.
+func newLoginExpiredServer(t *testing.T) (*Server, *signInLogs) {
+	t.Helper()
+	return newSignInLogServer(t, func(c *Config) {
+		c.MFAProviders = map[string]mfa.Provider{"totp": mfa.NewTOTPProvider("dex", nil)}
+		c.DefaultMFAChain = []string{"totp"}
+		c.Web = WebConfig{WebFS: loginExpiredWeb()}
+	})
+}
+
+// loginExpiredWeb is the web assets of dex with an error page that prints its data.
+func loginExpiredWeb() fs.FS {
+	return overlayFS{base: dexweb.FS(), files: fstest.MapFS{
+		"templates/error.html": {Data: []byte(`code={{.ErrCode}} return={{.ReturnURL}} msg={{.ErrMsg}}`)},
+	}}
+}
+
+// TestLoginExpired: every step of a sign-in whose auth request is gone — the login form left open
+// longer than expiry.authRequests and collected, the connector callback, the approval, the second
+// factor, the password change page, the dispatcher — answers 400 with the page of an expired
+// sign-in and one WARN line of the sign-in log, not "Requested resource does not exist" or a 500
+// (Deckhouse patch 280).
+func TestLoginExpired(t *testing.T) {
+	gone := storage.AuthRequest{ID: "gone", HMACKey: []byte("0123456789abcdef0123456789abcdef")}
+	tests := []struct {
+		name      string
+		method    string
+		target    string
+		form      url.Values
+		connector string
+	}{
+		{"login form", http.MethodGet, "/auth/test/login?state=gone", nil, "test"},
+		{"login form submit", http.MethodPost, "/auth/test/login?state=gone", url.Values{"login": {"test"}, "password": {"test"}}, "test"},
+		{"connector callback", http.MethodGet, "/callback?state=gone&code=x", nil, ""},
+		{"connector callback by name", http.MethodGet, "/callback/mock?state=gone&code=x", nil, "mock"},
+		{"approval", http.MethodPost, internal.StepURL("/approval", gone, internal.StepApproval, nil), url.Values{"approval": {"approve"}}, ""},
+		{"dispatcher", http.MethodGet, internal.StepURL("/auth", gone, internal.StepContinue, nil), nil, ""},
+		{"second factor", http.MethodPost, internal.StepURL("/mfa/totp", gone, internal.Authenticator("totp"), url.Values{"authenticator": {"totp"}}),
+			url.Values{"totp": {"000000"}}, ""},
+		{"second factor entry", http.MethodGet, internal.StepURL("/mfa", gone, internal.StepMFA, nil), nil, ""},
+		{"password change", http.MethodGet, "/password/change?req=gone", nil, ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s, logs := newLoginExpiredServer(t)
+
+			rr := serveRequest(s, rateLimitedRequest(tc.method, tc.target, tc.form))
+
+			assert.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+			assert.Equal(t, "code=login_expired return= msg=The sign-in has expired. Go back to the application and sign in again.", rr.Body.String())
+			line := logs.last(t, signinlog.LoginExpiredMsg)
+			assert.Equal(t, "WARN", line["level"], "%v", line)
+			assert.Equal(t, signinlog.ReasonLoginExpired, line["reason"], "%v", line)
+			assert.Equal(t, strings.SplitN(tc.target, "?", 2)[0], line["path"], "%v", line)
+			if tc.connector != "" {
+				assert.Equal(t, tc.connector, line["connector_id"], "%v", line)
+			} else {
+				assert.NotContains(t, line, "connector_id")
+			}
+			for _, l := range logs.lines(t) {
+				assert.NotEqual(t, "ERROR", l["level"], "%v", l)
+			}
+		})
+	}
+}
+
+// createReturnClients stores the clients the return button is checked against: "app" with an https
+// redirect URI of DexAuthenticator and one with a port, "plain" with an http one, and "pub", a public
+// client without redirect URIs, which /auth lets redirect to a loopback address.
+func createReturnClients(t *testing.T, s *Server) {
+	t.Helper()
+	for _, c := range []storage.Client{
+		{ID: "app", Secret: "app-secret", RedirectURIs: []string{
+			"https://app.example.com/dex-authenticator/callback",
+			"https://app.example.com:8443/dex-authenticator/callback",
+			"https://deploy@user.example.com/dex-authenticator/callback?x=1#f",
+		}},
+		{ID: "plain", Secret: "plain-secret", RedirectURIs: []string{"http://plain.example.com/dex-authenticator/callback"}},
+		{ID: "pub", Public: true},
+	} {
+		require.NoError(t, s.storage.CreateClient(t.Context(), c))
+	}
+}
+
+// loginFormBack is the connector selection link that login.go puts into the address of a login
+// form, for a client and a redirect URI.
+func loginFormBack(clientID, redirectURI string) string {
+	q := url.Values{"response_type": {"code"}, "scope": {"openid"}, "state": {"app-state"}}
+	if clientID != "" {
+		q.Set("client_id", clientID)
+	}
+	if redirectURI != "" {
+		q.Set("redirect_uri", redirectURI)
+	}
+	return "/auth?" + q.Encode()
+}
+
+// TestLoginExpiredReturnsToTheApplication: the page of an expired login form offers to go back to
+// the application: the origin of the redirect URI of its back link, only when the client exists
+// and registered exactly that https URI, as /auth would accept it. Anything else in the address of
+// the form gets no button, so the button cannot send the user anywhere the client did not register.
+func TestLoginExpiredReturnsToTheApplication(t *testing.T) {
+	tests := []struct {
+		name string
+		back string
+		want string
+	}{
+		{"a registered redirect URI", loginFormBack("app", "https://app.example.com/dex-authenticator/callback"), "https://app.example.com/"},
+		{"a registered redirect URI with a port", loginFormBack("app", "https://app.example.com:8443/dex-authenticator/callback"), "https://app.example.com:8443/"},
+		{"only the origin of a registered redirect URI", loginFormBack("app", "https://deploy@user.example.com/dex-authenticator/callback?x=1#f"), "https://user.example.com/"},
+		{"no back link", "", ""},
+		{"no redirect URI", loginFormBack("app", ""), ""},
+		{"no client", loginFormBack("", "https://app.example.com/dex-authenticator/callback"), ""},
+		{"an unknown client", loginFormBack("nobody", "https://app.example.com/dex-authenticator/callback"), ""},
+		{"a foreign domain", loginFormBack("app", "https://evil.example.com/dex-authenticator/callback"), ""},
+		{"another path of the domain", loginFormBack("app", "https://app.example.com/other"), ""},
+		{"a query added", loginFormBack("app", "https://app.example.com/dex-authenticator/callback?next=https://evil.example.com"), ""},
+		{"userinfo", loginFormBack("app", "https://app.example.com@evil.example.com/dex-authenticator/callback"), ""},
+		{"scheme-relative", loginFormBack("app", "//evil.example.com/dex-authenticator/callback"), ""},
+		{"javascript", loginFormBack("app", "javascript:alert(1)"), ""},
+		{"a registered http redirect URI", loginFormBack("plain", "http://plain.example.com/dex-authenticator/callback"), ""},
+		{"a loopback address of a public client", loginFormBack("pub", "http://localhost:8000/callback"), ""},
+		{"an https loopback address of a public client", loginFormBack("pub", "https://localhost:8000/callback"), ""},
+		{"a back link off the origin", "https://evil.example.com" + loginFormBack("app", "https://app.example.com/dex-authenticator/callback"), ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s, _ := newLoginExpiredServer(t)
+			createReturnClients(t, s)
+			target := "/auth/test/login?state=gone"
+			if tc.back != "" {
+				target += "&back=" + url.QueryEscape(tc.back)
+			}
+
+			rr := serveRequest(s, rateLimitedRequest(http.MethodGet, target, nil))
+
+			assert.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+			assert.Equal(t, "code=login_expired return="+tc.want+" msg=The sign-in has expired. Go back to the application and sign in again.", rr.Body.String())
+		})
+	}
+}
+
+// TestLoginExpiredBeforeCollection: an auth request past its expiry that the garbage collection has
+// not removed yet is expired too. The login form refuses it before it checks the password, and the
+// authorization response refuses it instead of "User session has expired."
+func TestLoginExpiredBeforeCollection(t *testing.T) {
+	t.Run("login form", func(t *testing.T) {
+		s, logs := newLoginExpiredServer(t)
+		require.NoError(t, s.storage.CreateAuthRequest(t.Context(), storage.AuthRequest{
+			ID: "stale", ClientID: "test", ConnectorID: "test", RedirectURI: "foo://bar.com/",
+			ResponseTypes: []string{"code"}, Expiry: time.Now().Add(-time.Second),
+			HMACKey: []byte("0123456789abcdef0123456789abcdef"),
+		}))
+
+		createReturnClients(t, s)
+		back := url.QueryEscape(loginFormBack("app", "https://app.example.com/dex-authenticator/callback"))
+
+		rr := serveRequest(s, rateLimitedRequest(http.MethodPost, "/auth/test/login?state=stale&back="+back, url.Values{"login": {"test"}, "password": {"wrong"}}))
+
+		assert.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+		assert.Contains(t, rr.Body.String(), "code=login_expired return=https://app.example.com/ ")
+		assert.Equal(t, signinlog.ReasonLoginExpired, logs.last(t, signinlog.LoginExpiredMsg)["reason"])
+		// The password was not checked: no refusal for the wrong one.
+		for _, l := range logs.lines(t) {
+			assert.NotEqual(t, "failed login attempt: Invalid credentials.", l["msg"], "%v", l)
+		}
+	})
+
+	t.Run("authorization response", func(t *testing.T) {
+		s, logs := newSignInLogServer(t, func(c *Config) { c.Web = WebConfig{WebFS: loginExpiredWeb()} })
+		req := storage.AuthRequest{
+			ID: "stale", ClientID: "test", ConnectorID: "mock", RedirectURI: "foo://bar.com/",
+			ResponseTypes: []string{"code"}, Expiry: time.Now().Add(-time.Second), LoggedIn: true,
+			Claims:  storage.Claims{UserID: "u1", Username: "Jane", Email: "u1@example.com"},
+			HMACKey: []byte("0123456789abcdef0123456789abcdef"),
+		}
+		require.NoError(t, s.storage.CreateAuthRequest(t.Context(), req))
+
+		// A step returns to the dispatcher, which issues the response: no second factor and no
+		// approval are left for this client.
+		rr := serveRequest(s, rateLimitedRequest(http.MethodGet, internal.StepURL("/auth", req, internal.StepContinue, nil), nil))
+
+		assert.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+		assert.Contains(t, rr.Body.String(), "code=login_expired")
+		assert.Equal(t, signinlog.ReasonLoginExpired, logs.last(t, signinlog.LoginExpiredMsg)["reason"])
+	})
+
+	// The callback of an expired sign-in stops before the connector: the code of the identity
+	// provider is not exchanged, and no user identity is recorded.
+	t.Run("connector callback", func(t *testing.T) {
+		s, logs := newLoginExpiredServer(t)
+		require.NoError(t, s.storage.CreateAuthRequest(t.Context(), storage.AuthRequest{
+			ID: "stale", ClientID: "test", ConnectorID: "mock", RedirectURI: "foo://bar.com/",
+			ResponseTypes: []string{"code"}, Expiry: time.Now().Add(-time.Second),
+			HMACKey: []byte("0123456789abcdef0123456789abcdef"),
+		}))
+
+		rr := serveRequest(s, rateLimitedRequest(http.MethodGet, "/callback?state=stale&code=from-the-idp", nil))
+
+		assert.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+		assert.Contains(t, rr.Body.String(), "code=login_expired")
+		assert.Equal(t, signinlog.ReasonLoginExpired, logs.last(t, signinlog.LoginExpiredMsg)["reason"])
+		identities, err := s.storage.ListUserIdentities(t.Context())
+		require.NoError(t, err)
+		assert.Empty(t, identities, "the callback of an expired sign-in recorded a user identity")
+	})
+}
+
+// TestOtherErrorsKeepTheirPage: an error page that is not an expired sign-in carries no code and no
+// back link, so the theme shows it as before.
+func TestOtherErrorsKeepTheirPage(t *testing.T) {
+	s, _ := newLoginExpiredServer(t)
+
+	rr := serveRequest(s, rateLimitedRequest(http.MethodGet, "/auth/test/login", nil))
+
+	assert.Equal(t, http.StatusBadRequest, rr.Code)
+	assert.Equal(t, "code= return= msg=User session error.", rr.Body.String())
+}
