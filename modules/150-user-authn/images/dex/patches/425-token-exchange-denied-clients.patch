 func (g *tokenExchange) Authorize(ctx context.Context, req *Request, client storage.Client, conn connectors.Connector) (Responder, error) {
+	// A client whose secret its users know must not exchange: anyone holding
+	// a token of the upstream issuer could get a token of this cluster for it.
+	if slices.Contains(g.deniedClients, client.ID) {
+		g.logger.WarnContext(ctx, "token exchange denied: client may not exchange tokens", "client_id", client.ID)
+		return nil, &oauth2.Error{Type: oauth2.UnauthorizedClient, Description: "The client may not use the token exchange grant.", Status: http.StatusBadRequest}
+	}
+
+	// Scopes pass through unvalidated, but a cross-client scope the peer does not
+	// grant this client is refused here, as by the other grants, instead of
+	// failing the signature with a server error.
+	if oerr := g.checkCrossClientScopes(ctx, client.ID, req.Scopes); oerr != nil {
+		return nil, oerr
+	}
+
 	switch req.SubjectTokenType {
