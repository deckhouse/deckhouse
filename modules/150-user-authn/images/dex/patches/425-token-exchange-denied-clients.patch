diff --git a/server/server_grant_tokenexchange_denied_test.go b/server/server_grant_tokenexchange_denied_test.go
new file mode 100644
index 00000000..dc4ae3af
--- /dev/null
+++ b/server/server_grant_tokenexchange_denied_test.go
@@ -0,0 +1,78 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/storage"
+)
+
+// TestTokenExchangeDeniedClients refuses the token-exchange grant to the
+// clients whose secret their users know, whatever the connector, and serves
+// the others.
+func TestTokenExchangeDeniedClients(t *testing.T) {
+	ctx := t.Context()
+	httpServer, s := newTestServer(t, func(c *Config) {
+		require.NoError(t, c.Storage.CreateClient(ctx, storage.Client{ID: "kubeconfig-generator", Secret: "shared"}))
+		require.NoError(t, c.Storage.CreateClient(ctx, storage.Client{ID: "ci", Secret: "ci"}))
+		c.TokenExchangeDeniedClients = []string{"kubeconfig-generator", "kubeconfig-publish-api"}
+	})
+	defer httpServer.Close()
+
+	exchange := func(clientID, secret string) *httptest.ResponseRecorder {
+		vals := url.Values{}
+		vals.Set("grant_type", oauth2.GrantTypeTokenExchange)
+		vals.Set("connector_id", "mock")
+		vals.Set("scope", "openid")
+		vals.Set("subject_token_type", oauth2.TokenTypeID)
+		vals.Set("subject_token", "foobar")
+		vals.Set("client_id", clientID)
+		vals.Set("client_secret", secret)
+		rr := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, httpServer.URL+"/token", strings.NewReader(vals.Encode()))
+		req.Header.Set("content-type", "application/x-www-form-urlencoded")
+		s.ServeHTTP(rr, req)
+		return rr
+	}
+
+	rr := exchange("kubeconfig-generator", "shared")
+	require.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+	require.Contains(t, rr.Body.String(), oauth2.UnauthorizedClient)
+
+	rr = exchange("ci", "ci")
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+}
+
+// TestTokenExchangeUntrustedCrossClientScope refuses a cross-client scope whose
+// peer does not trust the client with invalid_scope instead of a server error.
+func TestTokenExchangeUntrustedCrossClientScope(t *testing.T) {
+	ctx := t.Context()
+	httpServer, s := newTestServer(t, func(c *Config) {
+		require.NoError(t, c.Storage.CreateClient(ctx, storage.Client{ID: "ci", Secret: "ci"}))
+		require.NoError(t, c.Storage.CreateClient(ctx, storage.Client{ID: "kubernetes", Secret: "k8s"}))
+	})
+	defer httpServer.Close()
+
+	vals := url.Values{}
+	vals.Set("grant_type", oauth2.GrantTypeTokenExchange)
+	vals.Set("connector_id", "mock")
+	vals.Set("scope", "openid audience:server:client_id:kubernetes")
+	vals.Set("subject_token_type", oauth2.TokenTypeID)
+	vals.Set("subject_token", "foobar")
+	vals.Set("requested_token_type", oauth2.TokenTypeID)
+	vals.Set("client_id", "ci")
+	vals.Set("client_secret", "ci")
+	rr := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, httpServer.URL+"/token", strings.NewReader(vals.Encode()))
+	req.Header.Set("content-type", "application/x-www-form-urlencoded")
+	s.ServeHTTP(rr, req)
+
+	require.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+	require.Contains(t, rr.Body.String(), oauth2.InvalidScope)
+}
