+func seedFuzzStorage(t *testing.T, store storage.Storage) {
+	t.Helper()
+	ctx := t.Context()
+	now := time.Now()
+	claims := storage.Claims{UserID: fuzzUserID, Username: "u", Email: "u@example.com", EmailVerified: true}
+	must := func(what string, err error) {
+		if err != nil {
+			t.Fatalf("create %s: %v", what, err)
+		}
+	}
+
+	must("client", store.CreateClient(ctx, storage.Client{
+		ID:           "client",
+		Secret:       "secret",
+		RedirectURIs: []string{fuzzRedirectURI, oauth2.DeviceCallbackURI},
+		TrustedPeers: []string{"client"},
+		Name:         "Client",
+	}))
+	must("restricted client", store.CreateClient(ctx, storage.Client{
+		ID:            fuzzRestrictedClient,
+		Secret:        "secret",
+		RedirectURIs:  []string{fuzzRedirectURI},
+		Name:          "Restricted",
+		AllowedEmails: []string{"nobody@example.com"},
+	}))
+	previous, err := bcrypt.GenerateFromPassword([]byte("Prev1ous"), bcrypt.MinCost)
+	must("previous password hash", err)
+	must("password", store.CreatePassword(ctx, storage.Password{
+		Email: fuzzLocalEmail, Username: "u", UserID: fuzzUserID, Hash: fuzzPasswordHash(), HashUpdatedAt: now,
+		PreviousHashes: [][]byte{previous}, RequireResetHashOnNextSuccLogin: true,
+	}))
+	must("user identity", store.CreateUserIdentity(ctx, storage.UserIdentity{
+		UserID: fuzzUserID, ConnectorID: fuzzPwConnector, Claims: claims,
+		Consents:   map[string][]string{"client": {"openid", "email", "offline_access"}},
+		MFASecrets: map[string]*storage.MFASecret{"totp": {AuthenticatorID: "totp", Type: "TOTP", Secret: fuzzTOTPSecret, Confirmed: true}},
+		CreatedAt:  now, LastLogin: now,
+	}))
+
+	authReq := func(id string, loggedIn bool) storage.AuthRequest {
+		ar := storage.AuthRequest{
+			ID: id, ClientID: "client", ResponseTypes: []string{"code"},
+			Scopes: []string{"openid", "email", "offline_access"}, RedirectURI: fuzzRedirectURI,
+			Nonce: "n", State: id, ConnectorID: fuzzPwConnector, Expiry: now.Add(time.Hour), HMACKey: fuzzHMACKey,
+		}
+		if loggedIn {
+			ar.LoggedIn, ar.Claims, ar.AuthTime = true, claims, now
+		}
+		return ar
+	}
+	must("auth request", store.CreateAuthRequest(ctx, authReq(fuzzAuthReqLogin, false)))
+	local := authReq(fuzzAuthReqLocal, false)
+	local.ConnectorID = "local"
+	binding := sha256.Sum256([]byte(strings.TrimPrefix(fuzzChangeCookie, "dex_password_change=")))
+	local.PasswordChangeBinding = binding[:]
+	must("auth request", store.CreateAuthRequest(ctx, local))
+	must("auth request", store.CreateAuthRequest(ctx, authReq(fuzzAuthReqMFA, true)))
+	done := authReq(fuzzAuthReqDone, true)
+	done.MFAValidated = true
+	must("auth request", store.CreateAuthRequest(ctx, done))
+	denied := authReq(fuzzAuthReqDenied, false)
+	denied.ClientID = fuzzRestrictedClient
+	must("auth request", store.CreateAuthRequest(ctx, denied))
+	deniedCb := authReq(fuzzAuthReqDeniedCb, false)
+	deniedCb.ClientID, deniedCb.ConnectorID = fuzzRestrictedClient, fuzzCbConnector
+	must("auth request", store.CreateAuthRequest(ctx, deniedCb))
+
+	// The refresh token a login through the callback connector left with the
+	// restricted client before its allow-lists changed.
+	cbClaims := storage.Claims{UserID: "0-385-28089-0", Username: "Kilgore Trout", Email: "kilgore@kilgore.trout", EmailVerified: true}
+	must("refresh token", store.CreateRefresh(ctx, storage.RefreshToken{
+		ID: fuzzDeniedRefreshID, Token: "t", ClientID: fuzzRestrictedClient, ConnectorID: fuzzCbConnector,
+		Scopes: []string{"openid", "email", "offline_access"}, Claims: cbClaims, ConnectorData: []byte(`{}`),
+		CreatedAt: now, LastUsed: now,
+	}))
+	must("offline session", store.CreateOfflineSessions(ctx, storage.OfflineSessions{
+		UserID: cbClaims.UserID, ConnID: fuzzCbConnector,
+		Refresh: map[string]*storage.RefreshTokenRef{
+			fuzzRestrictedClient: {ID: fuzzDeniedRefreshID, ClientID: fuzzRestrictedClient, CreatedAt: now, LastUsed: now},
+		},
+	}))
+
+	for _, code := range []storage.AuthCode{
+		{ID: "code-1", PKCE: storage.PKCE{}},
+		{ID: "code-pkce", PKCE: storage.PKCE{CodeChallengeMethod: "S256", CodeChallenge: "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"}},
+		{ID: "code-plain", PKCE: storage.PKCE{CodeChallengeMethod: "plain", CodeChallenge: "abc123"}},
+	} {
+		code.ClientID, code.RedirectURI, code.Nonce = "client", fuzzRedirectURI, "n"
+		code.Scopes, code.ConnectorID, code.Claims = []string{"openid", "email", "offline_access"}, fuzzCbConnector, claims
+		code.Expiry = now.Add(30 * time.Minute)
+		must("auth code", store.CreateAuthCode(ctx, code))
+	}
+
+	must("device request", store.CreateDeviceRequest(ctx, storage.DeviceRequest{
+		UserCode: "ABCD-EFGH", DeviceCode: "device-1", ClientID: "client", ClientSecret: "secret",
+		Scopes: []string{"openid"}, Expiry: now.Add(time.Hour),
+	}))
+	must("device token", store.CreateDeviceToken(ctx, storage.DeviceToken{
+		DeviceCode: "device-1", Status: "pending", Expiry: now.Add(time.Hour), PollIntervalSeconds: 0,
+	}))
+}
