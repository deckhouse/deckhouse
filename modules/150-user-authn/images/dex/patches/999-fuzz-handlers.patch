+// FuzzAllHandlers sends the same input to every route.
+func FuzzAllHandlers(f *testing.F) {
+	addDiskSeeds(f, "FuzzAllHandlers")
+	addDiskSeeds(f, "FuzzHandleToken")
+	f.Add([]byte(`{"method":"POST","url":"/token","postForm":{"grant_type":["authorization_code"],"code":["code-1"],"redirect_uri":["http://127.0.0.1/cb"]},"headers":{"Authorization":["` + fuzzClientAuth + `"]}}`))
+	f.Add([]byte(`{"method":"GET","url":"/auth?response_type=code&client_id=client&redirect_uri=http://127.0.0.1/cb&scope=openid"}`))
+	f.Add([]byte("\x01login=u&password=p&totp=123456&user_code=ABCD-EFGH"))
+	f.Fuzz(func(t *testing.T, data []byte) {
+		s, toks := newFuzzServer(t)
+		for _, route := range []fuzzRoute{
+			routeToken, routeKeys, routeUserInfo, routeIntrospect, routeRevoke, routeAuthorize, routeConnector,
+			routePasswordLogin, routeCallback, routePasswordChg, routeApproval, routeMFA, routeTOTP, routeWebAuthn,
+			routeDevice, routeVerifyCode, routeDeviceCode, routeDeviceCb, routeLogout, routeHome,
+		} {
+			req := newFuzzRequest(t, data, route, toks)
+			switch route {
+			case routeToken, routeIntrospect, routeRevoke:
+				withClientAuth(req, toks)
+			case routeUserInfo:
+				withBearer(req, toks)
+			}
+			s.ServeHTTP(httptest.NewRecorder(), req)
+		}
+	})
+}
