+// fuzzLogin signs in through the password grant for tokens that the token,
+// userinfo and introspection targets can present.
+func fuzzLogin(t *testing.T, s *Server) fuzzTokens {
+	t.Helper()
+	form := url.Values{
+		"grant_type": {oauth2.GrantTypePassword},
+		"username":   {"u"},
+		"password":   {"p"},
+		"scope":      {"openid email offline_access"},
+	}
+	req := httptest.NewRequestWithContext(t.Context(), http.MethodPost, fuzzIssuer+"/token", strings.NewReader(form.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.Header.Set("Authorization", fuzzClientAuth)
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+
+	var out struct {
+		AccessToken  string `json:"access_token"`
+		RefreshToken string `json:"refresh_token"`
+		IDToken      string `json:"id_token"`
+	}
+	if err := json.Unmarshal(rr.Body.Bytes(), &out); err != nil || out.AccessToken == "" {
+		t.Fatalf("password grant for fuzz tokens: %d %s", rr.Code, rr.Body.String())
+	}
+	return fuzzTokens{Access: out.AccessToken, Refresh: out.RefreshToken, IDToken: out.IDToken}
+}
