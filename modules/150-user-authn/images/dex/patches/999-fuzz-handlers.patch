+// fuzzDeniedRefreshToken is the refresh token of the restricted client as the
+// client presents it.
+func fuzzDeniedRefreshToken(f *testing.F) string {
+	f.Helper()
+	token, err := internal.Marshal(&internal.RefreshToken{RefreshId: fuzzDeniedRefreshID, Token: "t"})
+	if err != nil {
+		f.Fatalf("marshal refresh token: %v", err)
+	}
+	return token
+}
