+// Fuzz targets for every HTTP handler that accepts attacker-controlled input:
+// query, form, headers, cookies, tokens and path parameters. Each target sends
+// its input through Server.ServeHTTP to one route, so the router, the request
+// context (client address, request ID) and the handler package all run as in
+// production. A target is named after the handler of its route:
+//
+//	FuzzHandleToken             /token                      grants
+//	FuzzHandlePublicKeys        /keys                       discovery
+//	FuzzHandleUserInfo          /userinfo                   userinfo
+//	FuzzHandleIntrospect        /token/introspect           introspection
+//	FuzzHandleRevoke            /token/revoke               grants
+//	FuzzHandleAuthorization     /auth                       authflow
+//	FuzzHandleConnectorLogin    /auth/{connector}           authflow
+//	FuzzHandlePasswordLogin     /auth/{connector}/login     authflow
+//	FuzzHandleConnectorCallback /callback[/{connector}]     authflow
+//	FuzzHandlePasswordChange    /password/change            authflow
+//	FuzzHandleApproval          /approval                   consent
+//	FuzzHandleMFA               /mfa                        mfa
+//	FuzzHandleTOTPVerify        /mfa/totp                   mfa
+//	FuzzHandleWebAuthn          /mfa/webauthn[/...]         mfa
+//	FuzzHandleDeviceExchange    /device                     device
+//	FuzzVerifyUserCode          /device/auth/verify_code    device
+//	FuzzHandleDeviceCode        /device/code                device
+//	FuzzHandleDeviceCallback    /device/callback            device
+//	FuzzHandleLogout            /logout[/callback]          logout
+//	FuzzHandleHome              /                           home
+//	FuzzServeHTTP               any route
+//	FuzzAllHandlers             every route above with the same input
+//
+// The file is the last Deckhouse patch (999-fuzz-handlers), so it compiles
+// against the fully patched tree; *_test.go is not built into the binary. Every
+// input gets a server of its own, so an execution costs milliseconds; bound the
+// minimization of new inputs or the engine spends minutes on each:
+//
+//	go test -vet=off -run=^$ -fuzz=^FuzzAllHandlers$ -fuzztime=12h -fuzzminimizetime=10x ./server
+
+// fuzzSeedRequest is the JSON form of a fuzz input. Any other input is a method
+// selector byte followed by a form-encoded body. In either form $ACCESS_TOKEN,
+// $REFRESH_TOKEN and $ID_TOKEN stand for tokens issued to the fuzz user.
+type fuzzSeedRequest struct {
+	Method   string              `json:"method"`
+	URL      string              `json:"url"`
+	Headers  map[string][]string `json:"headers"`
+	Form     url.Values          `json:"form"`
+	PostForm url.Values          `json:"postForm"`
+	Body     string              `json:"body"`
+}
+
+// fuzzRoute is the route a target sends its input to. A URL whose path is not
+// under prefix is sent to path instead, so that mutations stay on the route.
+type fuzzRoute struct {
+	method string
+	path   string
+	prefix string
+}
+
+const (
+	fuzzIssuer       = "http://127.0.0.1"
+	fuzzClientAuth   = "Basic Y2xpZW50OnNlY3JldA==" // client:secret
+	fuzzUserID       = "u"
+	fuzzPwConnector  = "mockpw"
+	fuzzCbConnector  = "mock"
+	fuzzTOTPSecret   = "otpauth://totp/dex:u?issuer=dex&secret=JBSWY3DPEHPK3PXP"
+	fuzzRedirectURI  = "http://127.0.0.1/cb"
+	fuzzAuthReqLogin = "s_pw"
+	fuzzAuthReqLocal = "s_local"
+	fuzzLocalEmail   = "u@example.com"
+	// fuzzChangeCookie is the cookie that binds the password change page of the
+	// local auth request to the browser of its login (220).
+	fuzzChangeCookie = "dex_password_change=fuzz-binding"
+	fuzzAuthReqMFA   = "s_mfa"
+	fuzzAuthReqDone  = "s_done"
+
+	// The allow-lists of the restricted client (200) refuse every user of the
+	// fuzz server: the login form and the callback for its auth requests, and
+	// the grants for its credentials and refresh token.
+	fuzzRestrictedClient = "restricted"
+	fuzzRestrictedAuth   = "Basic cmVzdHJpY3RlZDpzZWNyZXQ=" // restricted:secret
+	fuzzAuthReqDenied    = "s_denied"
+	fuzzAuthReqDeniedCb  = "s_denied_cb"
+	fuzzDeniedRefreshID  = "refresh-denied"
+)
+
+var fuzzHMACKey = []byte("0123456789abcdef0123456789abcdef")
+
+// fuzzPasswordHash is the hash of the local user's password "p", made once: the
+// local connector refuses hashes below bcrypt.DefaultCost, which are slow to make
+// for every input.
+var fuzzPasswordHash = sync.OnceValue(func() []byte {
+	hash, err := bcrypt.GenerateFromPassword([]byte("p"), bcrypt.DefaultCost)
+	if err != nil {
+		panic(err)
+	}
+	return hash
+})
