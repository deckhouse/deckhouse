+func newFuzzRequest(t *testing.T, data []byte, route fuzzRoute, toks fuzzTokens) *http.Request {
+	t.Helper()
+	data = []byte(strings.NewReplacer(
+		"$ACCESS_TOKEN", toks.Access,
+		"$REFRESH_TOKEN", toks.Refresh,
+		"$ID_TOKEN", toks.IDToken,
+	).Replace(string(data)))
+	method, rawURL, body := route.method, route.path, ""
+	header := http.Header{}
+
+	var seed fuzzSeedRequest
+	if len(data) > 0 && data[0] == '{' && json.Unmarshal(data, &seed) == nil {
+		if seed.Method != "" {
+			method = seed.Method
+		}
+		if seed.URL != "" {
+			rawURL = seed.URL
+		}
+		body = seed.Body
+		if seed.PostForm != nil {
+			body = seed.PostForm.Encode()
+			header.Set("Content-Type", "application/x-www-form-urlencoded")
+		}
+		for k, vs := range seed.Headers {
+			for _, v := range vs {
+				header.Add(k, v)
+			}
+		}
+	} else {
+		// Non-JSON input: the first byte picks the method, the rest is the body.
+		methods := []string{route.method, http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodHead, http.MethodDelete}
+		if len(data) > 0 {
+			method = methods[int(data[0])%len(methods)]
+			body = string(data[1:])
+		}
+		header.Set("Content-Type", "application/x-www-form-urlencoded")
+	}
+
+	u, err := url.Parse(rawURL)
+	if err != nil {
+		t.Skip(err)
+	}
+	if !strings.HasPrefix(u.Path, route.prefix) {
+		u.Path, u.RawPath = route.path, ""
+	}
+	if seed.Form != nil {
+		q := u.Query()
+		for k, vs := range seed.Form {
+			for _, v := range vs {
+				q.Add(k, v)
+			}
+		}
+		u.RawQuery = q.Encode()
+	}
+
+	req, err := http.NewRequestWithContext(t.Context(), method, fuzzIssuer+u.RequestURI(), strings.NewReader(body))
+	if err != nil {
+		t.Skip(err)
+	}
+	for k, vs := range header {
+		req.Header[k] = vs
+	}
+	req.RemoteAddr = "127.0.0.1:1"
+	return req
+}
