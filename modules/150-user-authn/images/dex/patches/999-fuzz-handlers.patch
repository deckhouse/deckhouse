+// newFuzzServer builds a server with sessions, a TOTP second factor, every grant
+// type, the rate limit of failed attempts, and storage holding one object of
+// each kind a request can name.
+func newFuzzServer(t *testing.T) (*Server, fuzzTokens) {
+	t.Helper()
+	ctx := t.Context()
+	store := memory.New(slog.New(slog.DiscardHandler))
+	sig, err := signer.NewMockSigner(testKey)
+	if err != nil {
+		t.Fatalf("signer: %v", err)
+	}
+
+	for _, c := range []storage.Connector{
+		{ID: fuzzCbConnector, Type: "mockCallback", Name: "Mock", ResourceVersion: "1"},
+		{ID: fuzzPwConnector, Type: "mockPassword", Name: "MockPW", ResourceVersion: "1", Config: []byte(`{"username":"u","password":"p"}`)},
+		{ID: "local", Type: connectors.LocalConnector, Name: "Email", ResourceVersion: "1"},
+	} {
+		if err := store.CreateConnector(ctx, c); err != nil {
+			t.Fatalf("create connector %s: %v", c.ID, err)
+		}
+	}
+
+	s, err := newServer(ctx, Config{
+		Issuer:            fuzzIssuer,
+		Storage:           store,
+		Web:               WebConfig{Dir: "../web"},
+		Logger:            slog.New(slog.DiscardHandler),
+		HealthChecker:     gosundheit.New(),
+		Signer:            sig,
+		PasswordConnector: fuzzPwConnector,
+		RealIPHeader:      "X-Forwarded-For",
+		RateLimit:         &ratelimit.Config{RequestsPerMinute: 10, Burst: 10},
+		SessionConfig:     testSessionConfig(),
+		MFAProviders:      map[string]mfa.Provider{"totp": mfa.NewTOTPProvider("dex", []string{"mockPassword"})},
+		DefaultMFAChain:   []string{"totp"},
+		GCFrequency:       24 * time.Hour,
+		Now:               time.Now,
+		// cmd/dex always sets a policy; the server does not default one.
+		RefreshTokenPolicy: tokens.NewRefreshStrategy(true, 0, 0, 0, time.Now),
+		AllowedGrantTypes: []string{
+			oauth2.GrantTypeAuthorizationCode,
+			oauth2.GrantTypeClientCredentials,
+			oauth2.GrantTypeDeviceCode,
+			oauth2.GrantTypeImplicit,
+			oauth2.GrantTypePassword,
+			oauth2.GrantTypeRefreshToken,
+			oauth2.GrantTypeTokenExchange,
+		},
+		PasswordPolicy: &passwordpolicy.Policy{
+			Complexity:       passwordpolicy.Rules{MinLength: 8, Lowercase: true, Uppercase: true, Number: true},
+			HistoryLimit:     3,
+			RotationInterval: 24 * time.Hour,
+		},
+		Lockout: &lockout.Policy{MaxAttempts: 3, Duration: time.Minute, ConnectorTypes: []string{"mockPassword"}},
+	})
+	if err != nil {
+		t.Fatalf("newServer: %v", err)
+	}
+	seedFuzzStorage(t, store)
+	return s, fuzzLogin(t, s)
+}
