+// fuzzPasswordChangeURL is the password change URL the local login issues for
+// username (server/authflow/passwordchange.go), with extra query values.
+func fuzzPasswordChangeURL(username string, extra url.Values) string {
+	q := url.Values{
+		"req":          {fuzzAuthReqLocal},
+		"hmac":         {internal.ComputeHMAC(fuzzHMACKey, fuzzAuthReqLocal, "step:password-change", username)},
+		"username":     {username},
+		"changeReason": {"forced"},
+	}
+	for k, vs := range extra {
+		q[k] = vs
+	}
+	return authflow.PasswordChangePath + "?" + q.Encode()
+}
+
+// fuzzStepURL is the HMAC-protected URL of a flow step, as the server issues it.
+func fuzzStepURL(path, authReqID string, step internal.Step, extra url.Values) string {
+	return internal.StepURL(path, storage.AuthRequest{ID: authReqID, HMACKey: fuzzHMACKey}, step, extra)
+}
