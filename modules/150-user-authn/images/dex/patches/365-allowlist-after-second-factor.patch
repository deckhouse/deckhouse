 	// "Add a key" (Deckhouse patch 360): the registered key has confirmed the sign-in, and the user registers a
 	// new one next. The login completes after the registration.
-	if r.FormValue("addKey") != "" && provider.CanAdd(mfa.identity, mfa.authenticatorID) {
+	// A login an allow-list refused completes instead, to be refused (see refusedLogin).
+	if r.FormValue("addKey") != "" && provider.CanAdd(mfa.identity, mfa.authenticatorID) && !refusedLogin(mfa.authReq) {
 		if err := h.setKeyConfirmed(ctx, mfa.authReq, mfa.authenticatorID); err != nil {
 			h.Logger.ErrorContext(ctx, "failed to update session data", "err", err)
 			writeJSONError(w, http.StatusInternalServerError, "Internal server error.")
diff --git a/server/server_allowlist_mfa_test.go b/server/server_allowlist_mfa_test.go
new file mode 100644
index 0000000..c2b77e1
--- /dev/null
+++ b/server/server_allowlist_mfa_test.go
@@ -0,0 +1,672 @@
+package server
+
+// A login that the allow-lists refuse is refused after its second factor, so
+// that the answers to its password do not tell whether the user may sign in
+// (Deckhouse, see authflow.finalizeLogin).
+
+import (
+	"bytes"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/pquerna/otp/totp"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/mfa"
+	"github.com/dexidp/dex/storage"
+)
+
+const (
+	// mfaAllowListSecret is the TOTP secret of the users that have one.
+	mfaAllowListSecret = "JBSWY3DPEHPK3PXP"
+	// mfaAllowListClient admits the group admins only.
+	mfaAllowListClient   = "app"
+	mfaAllowListRedirect = "https://app.example/cb"
+	// mfaAllowListPassword is the password of every user: the users differ in
+	// their groups and factors.
+	mfaAllowListPassword = "dh-test-secret-0123456789abcdef"
+)
+
+// mfaAllowListUser is a local user of the tests.
+type mfaAllowListUser struct {
+	id, email, password string
+	groups              []string
+	// totp reports whether the user has a confirmed TOTP secret.
+	totp bool
+}
+
+var (
+	// mfaAdmitted is in the group the client admits.
+	mfaAdmitted = mfaAllowListUser{id: "jane-id", email: "jane@example.com", password: mfaAllowListPassword, groups: []string{"admins"}, totp: true}
+	// mfaRefused is not.
+	mfaRefused = mfaAllowListUser{id: "john-id", email: "john@example.com", password: mfaAllowListPassword, groups: []string{"guests"}, totp: true}
+	// mfaAdmittedNoFactor and mfaRefusedNoFactor have no second factor yet.
+	mfaAdmittedNoFactor = mfaAllowListUser{id: "ann-id", email: "ann@example.com", password: mfaAllowListPassword, groups: []string{"admins"}}
+	mfaRefusedNoFactor  = mfaAllowListUser{id: "bob-id", email: "bob@example.com", password: mfaAllowListPassword, groups: []string{"guests"}}
+)
+
+// mfaDeviceHash is the device mark hash of every browser of the tests.
+const mfaDeviceHash = "device-hash"
+
+// mfaLastLogin is the LastLogin the users with a factor start with.
+var mfaLastLogin = time.Date(2026, 11, 1, 10, 0, 0, 0, time.UTC)
+
+// newMFAAllowListServer serves the local connector with the users above, the
+// chain [totp] and the client app limited to the group admins. client changes
+// the client before it is stored.
+func newMFAAllowListServer(t *testing.T, sessions bool, logs *bytes.Buffer, updateConfig func(*Config), client func(*storage.Client)) *Server {
+	t.Helper()
+	ctx := t.Context()
+	setSessionsEnabled(t, sessions)
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.PasswordConnector = connectors.LocalConnector
+		c.MFAProviders = map[string]mfa.Provider{"totp": mfa.NewTOTPProvider("dex", nil)}
+		c.DefaultMFAChain = []string{"totp"}
+		c.SkipApprovalScreen = true
+		c.Now = time.Now
+		if logs != nil {
+			c.Logger = slog.New(slog.NewJSONHandler(logs, &slog.HandlerOptions{Level: slog.LevelInfo}))
+		}
+		if updateConfig != nil {
+			updateConfig(c)
+		}
+	})
+	t.Cleanup(httpServer.Close)
+
+	app := storage.Client{ID: mfaAllowListClient, Secret: "secret", RedirectURIs: []string{mfaAllowListRedirect}, AllowedGroups: []string{"admins"}}
+	if client != nil {
+		client(&app)
+	}
+	require.NoError(t, s.storage.CreateClient(ctx, app))
+	localConn := storage.Connector{ID: connectors.LocalConnector, Type: connectors.LocalConnector, Name: "Email", ResourceVersion: "1"}
+	require.NoError(t, s.storage.CreateConnector(ctx, localConn))
+	_, err := s.connectors.Open(localConn)
+	require.NoError(t, err)
+
+	for _, u := range []mfaAllowListUser{mfaAdmitted, mfaRefused, mfaAdmittedNoFactor, mfaRefusedNoFactor} {
+		hash, err := bcrypt.GenerateFromPassword([]byte(u.password), bcrypt.DefaultCost)
+		require.NoError(t, err)
+		require.NoError(t, s.storage.CreatePassword(ctx, storage.Password{
+			Email: u.email, Username: strings.Split(u.email, "@")[0], UserID: u.id, Groups: u.groups, Hash: hash, HashUpdatedAt: time.Now(),
+		}))
+		if !u.totp {
+			continue
+		}
+		require.NoError(t, s.storage.CreateUserIdentity(ctx, storage.UserIdentity{
+			UserID: u.id, ConnectorID: connectors.LocalConnector, LastLogin: mfaLastLogin,
+			Claims: storage.Claims{UserID: u.id, Email: u.email, Groups: u.groups},
+			MFASecrets: map[string]*storage.MFASecret{"totp": {
+				AuthenticatorID: "totp", Type: "TOTP", Confirmed: true,
+				Secret: "otpauth://totp/dex:" + u.email + "?issuer=dex&secret=" + mfaAllowListSecret,
+			}},
+		}))
+	}
+	return s
+}
+
+// mfaBrowser is one browser: its auth request and its cookies.
+type mfaBrowser struct {
+	t       *testing.T
+	s       *Server
+	request string
+	cookies map[string]*http.Cookie
+}
+
+func newMFABrowser(t *testing.T, s *Server, request string) *mfaBrowser {
+	t.Helper()
+	require.NoError(t, s.storage.CreateAuthRequest(t.Context(), storage.AuthRequest{
+		ID: request, ClientID: mfaAllowListClient, ConnectorID: connectors.LocalConnector,
+		ResponseTypes: []string{"code"}, Scopes: []string{"openid", "email", "groups"}, RedirectURI: mfaAllowListRedirect,
+		Expiry: time.Now().Add(time.Hour), HMACKey: []byte("0123456789abcdef0123456789abcdef"),
+		DeviceHash: mfaDeviceHash,
+	}))
+	return &mfaBrowser{t: t, s: s, request: request, cookies: map[string]*http.Cookie{}}
+}
+
+func (b *mfaBrowser) do(req *http.Request) *httptest.ResponseRecorder {
+	for _, c := range b.cookies {
+		req.AddCookie(c)
+	}
+	rr := httptest.NewRecorder()
+	b.s.ServeHTTP(rr, req)
+	for _, c := range rr.Result().Cookies() {
+		if c.MaxAge < 0 || c.Value == "" {
+			delete(b.cookies, c.Name)
+			continue
+		}
+		b.cookies[c.Name] = c
+	}
+	return rr
+}
+
+func (b *mfaBrowser) post(target string, form url.Values) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(http.MethodPost, target, strings.NewReader(form.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	return b.do(req)
+}
+
+func (b *mfaBrowser) login(u mfaAllowListUser) *httptest.ResponseRecorder {
+	return b.post("/auth/local/login?state="+b.request, url.Values{"login": {u.email}, "password": {u.password}})
+}
+
+// follow serves rr's redirects within dex and returns the first answer that is
+// not one, with the address it answered. A redirect to the client ends the walk.
+func (b *mfaBrowser) follow(rr *httptest.ResponseRecorder) (*httptest.ResponseRecorder, string) {
+	b.t.Helper()
+	target := ""
+	for range 8 {
+		location := rr.Header().Get("Location")
+		if rr.Code != http.StatusSeeOther && rr.Code != http.StatusFound || strings.HasPrefix(location, mfaAllowListRedirect) {
+			return rr, target
+		}
+		next, err := url.Parse(location)
+		require.NoError(b.t, err)
+		target = next.RequestURI()
+		rr = b.do(httptest.NewRequest(http.MethodGet, target, nil))
+	}
+	b.t.Fatalf("too many redirects, last to %s", target)
+	return nil, ""
+}
+
+// passTOTP posts a code of the TOTP page at totpURL.
+func (b *mfaBrowser) passTOTP(totpURL string, valid bool) *httptest.ResponseRecorder {
+	b.t.Helper()
+	code := "000000"
+	if valid {
+		var err error
+		code, err = totp.GenerateCode(mfaAllowListSecret, time.Now())
+		require.NoError(b.t, err)
+	}
+	return b.post(totpURL, url.Values{"totp": {code}})
+}
+
+// answerShape is what an observer of a response sees apart from the values
+// bound to the request: the status, the path of the redirect and the names of
+// the cookies set.
+type answerShape struct {
+	Status      int
+	Path        string
+	Query       []string
+	SetsCookies []string
+}
+
+func shapeOf(t *testing.T, rr *httptest.ResponseRecorder) answerShape {
+	t.Helper()
+	shape := answerShape{Status: rr.Code}
+	if location := rr.Header().Get("Location"); location != "" {
+		u, err := url.Parse(location)
+		require.NoError(t, err)
+		shape.Path = u.Path
+		for key := range u.Query() {
+			shape.Query = append(shape.Query, key)
+		}
+		slices.Sort(shape.Query)
+	}
+	for _, c := range rr.Result().Cookies() {
+		shape.SetsCookies = append(shape.SetsCookies, c.Name)
+	}
+	slices.Sort(shape.SetsCookies)
+	return shape
+}
+
+func requireAccessDenied(t *testing.T, rr *httptest.ResponseRecorder) {
+	t.Helper()
+	require.Equal(t, http.StatusUnauthorized, rr.Code, rr.Body.String())
+	require.Contains(t, rr.Body.String(), "Access denied. Please contact your administrator.")
+}
+
+// The password of a user the client refuses is answered as the one of a user it
+// admits: the second factor follows. A wrong code is a wrong code; a right one
+// is refused, and the refusal records no login, no device and no session.
+func TestAllowListRefusalAfterSecondFactor(t *testing.T) {
+	for _, sessions := range []bool{false, true} {
+		t.Run(map[bool]string{false: "sessions off", true: "sessions on"}[sessions], func(t *testing.T) {
+			ctx := t.Context()
+			var logs bytes.Buffer
+			s := newMFAAllowListServer(t, sessions, &logs, nil, nil)
+			admitted := newMFABrowser(t, s, "req-admitted")
+			refused := newMFABrowser(t, s, "req-refused")
+
+			// The password: the same answer for both, a redirect on to the second factor.
+			admittedAnswer := admitted.login(mfaAdmitted)
+			refusedAnswer := refused.login(mfaRefused)
+			require.Equal(t, http.StatusSeeOther, refusedAnswer.Code, refusedAnswer.Body.String())
+			require.Equal(t, shapeOf(t, admittedAnswer), shapeOf(t, refusedAnswer))
+			require.NotContains(t, shapeOf(t, refusedAnswer).SetsCookies, "dex_session", "the session waits for the second factor")
+
+			admittedPage, admittedTOTP := admitted.follow(admittedAnswer)
+			refusedPage, refusedTOTP := refused.follow(refusedAnswer)
+			require.True(t, strings.HasPrefix(refusedTOTP, "/mfa/totp?"), "%s: %s", refusedTOTP, refusedPage.Body.String())
+			require.True(t, strings.HasPrefix(admittedTOTP, "/mfa/totp?"), admittedTOTP)
+			require.Equal(t, admittedPage.Code, refusedPage.Code)
+			require.Equal(t, http.StatusOK, refusedPage.Code)
+
+			// A wrong code: the code page again, as for the admitted user, no refusal.
+			wrong := refused.passTOTP(refusedTOTP, false)
+			require.Equal(t, admitted.passTOTP(admittedTOTP, false).Code, wrong.Code)
+			require.Contains(t, wrong.Body.String(), "Invalid code.")
+			require.NotContains(t, wrong.Body.String(), "Access denied")
+			authReq, err := s.storage.GetAuthRequest(ctx, refused.request)
+			require.NoError(t, err)
+			require.False(t, authReq.MFAValidated)
+
+			// The right code: refused, no code issued.
+			denied, _ := refused.follow(refused.passTOTP(refusedTOTP, true))
+			requireAccessDenied(t, denied)
+			require.NotContains(t, denied.Body.String(), mfaRefused.email, "the page must not name the user")
+			authReq, err = s.storage.GetAuthRequest(ctx, refused.request)
+			require.NoError(t, err, "a code was issued: the request is gone")
+			require.Equal(t, "client_allowed_groups", authReq.AllowListRefusal)
+
+			ui, err := s.storage.GetUserIdentity(ctx, mfaRefused.id, connectors.LocalConnector)
+			require.NoError(t, err)
+			require.True(t, ui.LastLogin.Equal(mfaLastLogin), "LastLogin moved to %s", ui.LastLogin)
+			require.Empty(t, ui.KnownDevices)
+
+			authSessions, err := s.storage.ListAuthSessions(ctx)
+			require.NoError(t, err)
+			for _, as := range authSessions {
+				require.NotEqual(t, mfaRefused.id, as.UserID, "the refused login keeps a session: %+v", as)
+			}
+			require.NotContains(t, refused.cookies, "dex_session")
+
+			// The admitted user signs in.
+			issued, _ := admitted.follow(admitted.passTOTP(admittedTOTP, true))
+			require.True(t, strings.HasPrefix(issued.Header().Get("Location"), mfaAllowListRedirect+"?code="),
+				"%d %s %s", issued.Code, issued.Header().Get("Location"), issued.Body.String())
+			ui, err = s.storage.GetUserIdentity(ctx, mfaAdmitted.id, connectors.LocalConnector)
+			require.NoError(t, err)
+			require.True(t, ui.LastLogin.After(mfaLastLogin))
+			require.Len(t, ui.KnownDevices, 1, "the device of the admitted login is remembered")
+			if sessions {
+				// The session is made after the second factor, which it records,
+				// and the code is issued from a request that carries it.
+				require.Contains(t, admitted.cookies, "dex_session")
+				authSessions, err := s.storage.ListAuthSessions(ctx)
+				require.NoError(t, err)
+				require.Len(t, authSessions, 1)
+				require.Equal(t, mfaAdmitted.id, authSessions[0].UserID)
+				require.Contains(t, authSessions[0].ClientStates, mfaAllowListClient)
+				require.Equal(t, []string{"totp"}, authSessions[0].MFAAuthenticators)
+			}
+
+			// The log keeps the reason, and no success for the refused user.
+			var deniedLines, finalLines, refusedSuccess int
+			for line := range strings.Lines(logs.String()) {
+				var record map[string]any
+				require.NoError(t, json.Unmarshal([]byte(line), &record))
+				switch record["msg"] {
+				case "access denied":
+					deniedLines++
+					require.Equal(t, "client_allowed_groups", record["rule"])
+					require.Equal(t, true, record["after_second_factor"])
+				case "access denied after the second factor":
+					finalLines++
+					require.Equal(t, "WARN", record["level"])
+					require.Equal(t, "client_allowed_groups", record["rule"])
+				case "login successful":
+					if record["user_id"] == mfaRefused.id {
+						refusedSuccess++
+					}
+				}
+			}
+			require.Equal(t, 1, deniedLines, logs.String())
+			require.Equal(t, 1, finalLines, logs.String())
+			require.Zero(t, refusedSuccess)
+		})
+	}
+}
+
+// A refused login on a browser that has a session of the user for another
+// client leaves that session as it was: no new secret, no activity, no device.
+func TestAllowListRefusalLeavesTheSessionAlone(t *testing.T) {
+	ctx := t.Context()
+	s := newMFAAllowListServer(t, true, nil, nil, nil)
+	require.NoError(t, s.storage.CreateClient(ctx, storage.Client{ID: "other", Secret: "secret", RedirectURIs: []string{mfaAllowListRedirect}}))
+	browser := newMFABrowser(t, s, "req-other")
+	require.NoError(t, s.storage.UpdateAuthRequest(ctx, "req-other", func(a storage.AuthRequest) (storage.AuthRequest, error) {
+		a.ClientID = "other"
+		return a, nil
+	}))
+	_, totpURL := browser.follow(browser.login(mfaRefused))
+	issued, _ := browser.follow(browser.passTOTP(totpURL, true))
+	require.True(t, strings.HasPrefix(issued.Header().Get("Location"), mfaAllowListRedirect+"?code="), issued.Body.String())
+
+	// The same browser signs in to app, which refuses the user. The code of the
+	// first login would be a replay.
+	require.NoError(t, s.storage.UpdateUserIdentity(ctx, mfaRefused.id, connectors.LocalConnector, func(old storage.UserIdentity) (storage.UserIdentity, error) {
+		old.MFASecrets["totp"].LastUsedCounter = 0
+		return old, nil
+	}))
+	browser.request = "req-app"
+	require.NoError(t, s.storage.CreateAuthRequest(ctx, storage.AuthRequest{
+		ID: "req-app", ClientID: mfaAllowListClient, ConnectorID: connectors.LocalConnector,
+		ResponseTypes: []string{"code"}, Scopes: []string{"openid"}, RedirectURI: mfaAllowListRedirect,
+		Expiry: time.Now().Add(time.Hour), HMACKey: []byte("0123456789abcdef0123456789abcdef"),
+	}))
+	before, err := s.storage.ListAuthSessions(ctx)
+	require.NoError(t, err)
+	require.Len(t, before, 1)
+	cookie := browser.cookies["dex_session"]
+	require.NotNil(t, cookie)
+
+	password := browser.login(mfaRefused)
+	require.Empty(t, password.Result().Cookies())
+	_, totpURL = browser.follow(password)
+	require.True(t, strings.HasPrefix(totpURL, "/mfa/totp?"), totpURL)
+	denied, _ := browser.follow(browser.passTOTP(totpURL, true))
+	requireAccessDenied(t, denied)
+
+	after, err := s.storage.ListAuthSessions(ctx)
+	require.NoError(t, err)
+	require.Equal(t, before, after)
+	require.Equal(t, cookie, browser.cookies["dex_session"])
+}
