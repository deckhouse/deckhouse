+// While Dex pods without the refusal serve too (a rolling update), such a pod
+// drops AllowListRefusal when it writes the request. The login is still sent to
+// the password change page without a signature, which refuses it, and no code
+// is issued: a password change the login put off included.
+func TestAllowListRefusalSurvivesADexWithoutIt(t *testing.T) {
+	for _, tc := range []struct {
+		name           string
+		passwordChange bool
+	}{
+		{name: "no password change"},
+		{name: "a password change put off", passwordChange: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s := newMFAAllowListServer(t, false, nil, nil, nil)
+			if tc.passwordChange {
+				require.NoError(t, s.storage.UpdatePassword(ctx, mfaRefused.email, func(old storage.Password) (storage.Password, error) {
+					old.RequireResetHashOnNextSuccLogin = true
+					return old, nil
+				}))
+			}
+			admitted := newMFABrowser(t, s, "req-admitted")
+			refused := newMFABrowser(t, s, "req-refused")
+			admitted.login(mfaAdmitted)
+			_, totpURL := refused.follow(refused.login(mfaRefused))
+			require.True(t, strings.HasPrefix(totpURL, "/mfa/totp?"), totpURL)
+
+			authReq, err := s.storage.GetAuthRequest(ctx, admitted.request)
+			require.NoError(t, err)
+			require.Empty(t, authReq.PendingPasswordChange)
+			authReq, err = s.storage.GetAuthRequest(ctx, refused.request)
+			require.NoError(t, err)
+			require.Equal(t, "/password/change?req="+refused.request, authReq.PendingPasswordChange)
+
+			// A pod without the refusal writes the request.
+			require.NoError(t, s.storage.UpdateAuthRequest(ctx, refused.request, func(a storage.AuthRequest) (storage.AuthRequest, error) {
+				a.AllowListRefusal = ""
+				return a, nil
+			}))
+			denied, target := refused.follow(refused.passTOTP(totpURL, true))
+			require.False(t, strings.HasPrefix(denied.Header().Get("Location"), mfaAllowListRedirect), "a code was issued")
+			require.True(t, strings.HasPrefix(target, "/password/change?"), target)
+			require.Equal(t, http.StatusUnauthorized, denied.Code, denied.Body.String())
+			_, err = s.storage.GetAuthRequest(ctx, refused.request)
+			require.NoError(t, err, "a code was issued: the request is gone")
+		})
+	}
+}
