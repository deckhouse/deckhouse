+// A refused user without a second factor is refused where an admitted one
+// registers it, and registers nothing.
+func TestAllowListRefusalWithoutRegisteredFactor(t *testing.T) {
+	for _, tc := range []struct {
+		name             string
+		choice, sessions bool
+	}{
+		{name: "every factor"},
+		{name: "one of the factors", choice: true},
+		{name: "sessions on", sessions: true},
+	} {
+		choice := tc.choice
+		t.Run(tc.name, func(t *testing.T) {
+			s := newMFAAllowListServer(t, tc.sessions, nil, func(c *Config) {
+				if choice {
+					c.MFAOneOfConnectorTypes = []string{connectors.LocalConnector}
+				}
+			}, nil)
+			admitted := newMFABrowser(t, s, "req-admitted")
+			refused := newMFABrowser(t, s, "req-refused")
+
+			admittedAnswer := admitted.login(mfaAdmittedNoFactor)
+			refusedAnswer := refused.login(mfaRefusedNoFactor)
+			require.Equal(t, shapeOf(t, admittedAnswer), shapeOf(t, refusedAnswer))
+
+			page, target := admitted.follow(admittedAnswer)
+			require.Equal(t, http.StatusOK, page.Code, "%s: %s", target, page.Body.String())
+
+			denied, target := refused.follow(refusedAnswer)
+			require.True(t, strings.HasPrefix(target, "/mfa?"), target)
+			requireAccessDenied(t, denied)
+
+			_, err := s.storage.GetUserIdentity(t.Context(), mfaRefusedNoFactor.id, connectors.LocalConnector)
+			require.ErrorIs(t, err, storage.ErrNotFound, "a refused login records nothing")
+			authSessions, err := s.storage.ListAuthSessions(t.Context())
+			require.NoError(t, err)
+			for _, as := range authSessions {
+				require.NotEqual(t, mfaRefusedNoFactor.id, as.UserID, "the refused login keeps a session")
+			}
+		})
+	}
+}
