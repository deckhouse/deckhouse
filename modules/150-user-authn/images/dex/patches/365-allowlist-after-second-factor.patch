+// No browser session is made before the second factor, for an admitted user
+// either: a login abandoned there leaves none, and a new sign-in to the client
+// from the browser does not tell whether the client admits the user.
+func TestAllowListRefusalNoSessionBeforeSecondFactor(t *testing.T) {
