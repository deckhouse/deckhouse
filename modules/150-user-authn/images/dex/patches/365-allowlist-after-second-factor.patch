diff --git a/server/mfa/refused.go b/server/mfa/refused.go
new file mode 100644
index 0000000..0fca6ed
--- /dev/null
+++ b/server/mfa/refused.go
@@ -0,0 +1,34 @@
+package mfa
+
+// refused.go keeps a login that an allow-list refused from registering a factor
+// (Deckhouse).
+
+import (
+	"net/http"
+
+	"github.com/dexidp/dex/server/signinlog"
+	"github.com/dexidp/dex/storage"
+)
+
+// accessDeniedMsg is the text of the refusal of an allow-list, the one the login
+// form shows (authflow.ErrMsgAccessDenied).
+const accessDeniedMsg = "Access denied. Please contact your administrator."
+
+// refusedLogin reports whether an allow-list refused the user of authReq. Such
+// a login passes the factors the user has, as any other, and the dispatcher
+// refuses it after them (authflow.finalizeLogin), so that the answers until
+// then do not tell whether the user may sign in. It registers no factor: where
+// the login would offer to register one, every factor the user has is passed,
+// and the login is refused there, or completes to be refused.
+func refusedLogin(authReq storage.AuthRequest) bool {
+	return authReq.AllowListRefusal != ""
+}
+
+// renderRefused refuses a login that an allow-list refused where it would
+// register a factor.
+func (h *Handler) renderRefused(r *http.Request, w http.ResponseWriter, authReq storage.AuthRequest) {
+	h.Logger.WarnContext(r.Context(), "access denied instead of the registration of a second factor",
+		append(signinlog.Refused(signinlog.ReasonNotAllowed, authReq.ConnectorID, authReq.ClientID,
+			signinlog.ClaimsUser(authReq.Claims)), "rule", authReq.AllowListRefusal)...)
+	h.renderError(r, w, http.StatusUnauthorized, accessDeniedMsg)
+}
