diff --git a/server/authflow/allowlist_refusal_test.go b/server/authflow/allowlist_refusal_test.go
new file mode 100644
index 0000000..c18397a
--- /dev/null
+++ b/server/authflow/allowlist_refusal_test.go
@@ -0,0 +1,94 @@
+package authflow
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/mfa"
+	"github.com/dexidp/dex/storage"
+)
+
+// TestRefusalAfterSecondFactor checks that a login an allow-list refused before
+// its second factor is refused once the factor is done, before the password
+// change it put off and the last login, and that no path issues a response to
+// it (Deckhouse).
+func TestRefusalAfterSecondFactor(t *testing.T) {
+	httpServer, server := newTestHandler(t, func(c *testFlowConfig) {
+		c.MFAProviders = map[string]mfa.Provider{"totp": mfa.NewTOTPProvider("test-issuer", nil)}
+		c.DefaultMFAChain = []string{"totp"}
+	})
+	defer httpServer.Close()
+	ctx := t.Context()
+
+	require.NoError(t, server.Storage.CreateClient(ctx, storage.Client{
+		ID: "example-app", Secret: "secret", RedirectURIs: []string{"https://example.com/callback"},
+	}))
+	require.NoError(t, server.Storage.CreateUserIdentity(ctx, storage.UserIdentity{UserID: "user-1", ConnectorID: "mock"}))
+	newRequest := func(id string, validated bool) storage.AuthRequest {
+		t.Helper()
+		authReq := storage.AuthRequest{
+			ID: id, ClientID: "example-app", ConnectorID: "mock",
+			ResponseTypes: []string{"code"}, Scopes: []string{"openid"},
+			RedirectURI: "https://example.com/callback", Expiry: time.Now().Add(time.Hour),
+			LoggedIn: true, AuthTime: time.Now(), Claims: storage.Claims{UserID: "user-1"},
+			MFAValidated: validated, AllowListRefusal: "client_allowed_groups",
+			PendingPasswordChange: "/password/change?req=" + id,
+		}
+		require.NoError(t, server.Storage.CreateAuthRequest(ctx, authReq))
+		return authReq
+	}
+	requireRefused := func(w *httptest.ResponseRecorder, id string) {
+		t.Helper()
+		require.Equal(t, http.StatusUnauthorized, w.Code, w.Body.String())
+		require.Contains(t, w.Body.String(), ErrMsgAccessDenied)
+		_, err := server.Storage.GetAuthRequest(ctx, id)
+		require.NoError(t, err, "the request is deleted when a response is issued")
+		ui, err := server.Storage.GetUserIdentity(ctx, "user-1", "mock")
+		require.NoError(t, err)
+		require.True(t, ui.LastLogin.IsZero())
+		require.Empty(t, ui.KnownDevices)
+	}
+
+	tests := []struct {
+		name  string
+		serve func(w http.ResponseWriter, r *http.Request, authReq storage.AuthRequest)
+	}{
+		{
+			name: "dispatcher",
+			serve: func(w http.ResponseWriter, r *http.Request, authReq storage.AuthRequest) {
+				server.dispatch(w, r, authReq, false)
+			},
+		},
+		{
+			name: "dispatcher after consent",
+			serve: func(w http.ResponseWriter, r *http.Request, authReq storage.AuthRequest) {
+				server.dispatch(w, r, authReq, true)
+			},
+		},
+		{
+			name: "response",
+			serve: func(w http.ResponseWriter, r *http.Request, authReq storage.AuthRequest) {
+				server.writeResponse(w, r, authReq)
+			},
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			authReq := newRequest(tc.name, true)
+			w := httptest.NewRecorder()
+			tc.serve(w, httptest.NewRequest(http.MethodGet, "/auth", nil), authReq)
+			requireRefused(w, authReq.ID)
+		})
+	}
+
+	// The second factor is pending: the dispatcher sends the login to it, as any other.
+	authReq := newRequest("pending", false)
+	w := httptest.NewRecorder()
+	server.dispatch(w, httptest.NewRequest(http.MethodGet, "/auth", nil), authReq, false)
+	require.Equal(t, http.StatusSeeOther, w.Code)
+	require.Contains(t, w.Header().Get("Location"), "/mfa")
+}
