+// The remember-me choice of the password form reaches the session made after
+// the second factor.
+func TestAllowListSessionAfterSecondFactorRemembers(t *testing.T) {
+	for _, remember := range []bool{false, true} {
+		t.Run(map[bool]string{false: "forget", true: "remember"}[remember], func(t *testing.T) {
+			s := newMFAAllowListServer(t, true, nil, nil, nil)
+			browser := newMFABrowser(t, s, "req-admitted")
+			form := url.Values{"login": {mfaAdmitted.email}, "password": {mfaAdmitted.password}}
+			if remember {
+				form.Set("remember_me", "on")
+			}
+			_, totpURL := browser.follow(browser.post("/auth/local/login?state="+browser.request, form))
+			issued, _ := browser.follow(browser.passTOTP(totpURL, true))
+			require.True(t, strings.HasPrefix(issued.Header().Get("Location"), mfaAllowListRedirect+"?code="), issued.Body.String())
+
+			authSessions, err := s.storage.ListAuthSessions(t.Context())
+			require.NoError(t, err)
+			require.Len(t, authSessions, 1)
+			require.Equal(t, remember, authSessions[0].RememberMe)
+			cookie := browser.cookies["dex_session"]
+			require.NotNil(t, cookie)
+			require.Equal(t, remember, cookie.MaxAge > 0 || !cookie.Expires.IsZero(), "a persistent cookie only when remembered")
+		})
+	}
+}
