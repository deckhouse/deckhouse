+// A login through the callback of a provider is refused after the second
+// factor as the one through the password form, and its callback is answered
+// as the one of an admitted user.
+func TestAllowListRefusalAfterSecondFactorOfCallback(t *testing.T) {
+	ctx := t.Context()
+	s := newMFAAllowListServer(t, true, nil, nil, nil)
+	// callbackBrowser signs in through a callback connector of its own, which
+	// asserts one user in groups.
+	callbackBrowser := func(connectorID, userID, email string, groups []string) *mfaBrowser {
+		t.Helper()
+		conn := storage.Connector{ID: connectorID, Type: "mockCallback", Name: connectorID, ResourceVersion: "1"}
+		require.NoError(t, s.storage.CreateConnector(ctx, conn))
+		s.connectors.Set(connectorID, connectors.Connector{
+			ResourceVersion: conn.ResourceVersion,
+			Connector: allowListIdentityConnector{connector.Identity{
+				UserID: userID, Email: email, EmailVerified: true, Groups: groups,
+			}},
+		})
+		require.NoError(t, s.storage.CreateUserIdentity(ctx, storage.UserIdentity{
+			UserID: userID, ConnectorID: connectorID, LastLogin: mfaLastLogin,
+			Claims: storage.Claims{UserID: userID, Email: email, Groups: groups},
+			MFASecrets: map[string]*storage.MFASecret{"totp": {
+				AuthenticatorID: "totp", Type: "TOTP", Confirmed: true,
+				Secret: "otpauth://totp/dex:" + email + "?issuer=dex&secret=" + mfaAllowListSecret,
+			}},
+		}))
+		browser := newMFABrowser(t, s, "req-"+connectorID)
+		require.NoError(t, s.storage.UpdateAuthRequest(ctx, browser.request, func(a storage.AuthRequest) (storage.AuthRequest, error) {
+			a.ConnectorID = connectorID
+			return a, nil
+		}))
+		return browser
+	}
+	refused := callbackBrowser("corp", mockCallbackUser, mockCallbackEmail, []string{"authors"})
+	admitted := callbackBrowser("corp-admins", "admin-id", "admin@corp.example", []string{"admins"})
+
+	refusedAnswer := refused.do(httptest.NewRequest(http.MethodGet, "/callback/corp?state="+refused.request, nil))
+	admittedAnswer := admitted.do(httptest.NewRequest(http.MethodGet, "/callback/corp-admins?state="+admitted.request, nil))
+	require.Equal(t, http.StatusSeeOther, refusedAnswer.Code, refusedAnswer.Body.String())
+	require.Equal(t, shapeOf(t, admittedAnswer), shapeOf(t, refusedAnswer))
+	require.NotContains(t, shapeOf(t, refusedAnswer).SetsCookies, "dex_session")
+
+	_, totpURL := refused.follow(refusedAnswer)
+	require.True(t, strings.HasPrefix(totpURL, "/mfa/totp?"), totpURL)
+	denied, _ := refused.follow(refused.passTOTP(totpURL, true))
+	requireAccessDenied(t, denied)
+
+	ui, err := s.storage.GetUserIdentity(ctx, mockCallbackUser, "corp")
+	require.NoError(t, err)
+	require.True(t, ui.LastLogin.Equal(mfaLastLogin))
+	require.Empty(t, ui.KnownDevices)
+	require.NotContains(t, refused.cookies, "dex_session")
+}
