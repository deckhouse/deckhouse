+// With a chain of both factors, a refused user who has the code and no key is
+// refused once the code is passed, where an admitted one registers the key.
+func TestAllowListRefusalBeforeRegistrationOfNextFactor(t *testing.T) {
+	s := newMFAAllowListServer(t, false, nil, func(c *Config) {
+		webAuthn, err := mfa.NewWebAuthnProvider("dex", "", nil, "", "", "http://localhost", nil)
+		require.NoError(t, err)
+		c.MFAProviders["webauthn"] = webAuthn
+		c.DefaultMFAChain = []string{"totp", "webauthn"}
+	}, nil)
+	admitted := newMFABrowser(t, s, "req-admitted")
+	refused := newMFABrowser(t, s, "req-refused")
+
+	_, admittedTOTP := admitted.follow(admitted.login(mfaAdmitted))
+	_, refusedTOTP := refused.follow(refused.login(mfaRefused))
+	require.True(t, strings.HasPrefix(refusedTOTP, "/mfa/totp?"), refusedTOTP)
+
+	// The key page of the login before the code: back to the code, as for anyone.
+	keyPage := strings.Replace(strings.Replace(refusedTOTP, "/mfa/totp?", "/mfa/webauthn?", 1), "authenticator=totp", "authenticator=webauthn", 1)
+	_, target := refused.follow(refused.do(httptest.NewRequest(http.MethodGet, keyPage, nil)))
+	require.NotContains(t, target, "/mfa/webauthn")
+
+	page, target := admitted.follow(admitted.passTOTP(admittedTOTP, true))
+	require.Equal(t, http.StatusOK, page.Code, page.Body.String())
+	require.True(t, strings.HasPrefix(target, "/mfa/webauthn?"), target)
+
+	denied, target := refused.follow(refused.passTOTP(refusedTOTP, true))
+	requireAccessDenied(t, denied)
+	require.False(t, strings.HasPrefix(target, "/mfa/webauthn"), target)
+	ui, err := s.storage.GetUserIdentity(t.Context(), mfaRefused.id, connectors.LocalConnector)
+	require.NoError(t, err)
+	require.Empty(t, ui.WebAuthnCredentials)
+	require.True(t, ui.LastLogin.Equal(mfaLastLogin))
+}
