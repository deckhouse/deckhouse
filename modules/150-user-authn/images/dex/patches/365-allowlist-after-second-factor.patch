@@ -0,0 +1,40 @@
+package kubernetes
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/storage"
+)
+
+// TestAuthRequestAllowListRefusalRoundTrip checks that the refusal a login keeps
+// until its second factor is done survives the custom resource (Deckhouse).
+func TestAuthRequestAllowListRefusalRoundTrip(t *testing.T) {
+	cli := newTypesTestClient()
+	want := storage.AuthRequest{
+		ID:               "req",
+		ClientID:         "client",
+		RedirectURI:      "https://client.example.com/callback",
+		ConnectorID:      "local",
+		Expiry:           time.Date(2026, 11, 23, 12, 10, 0, 0, time.UTC),
+		HMACKey:          []byte("key"),
+		MaxAge:           -1,
+		LoggedIn:         true,
+		AllowListRefusal: "client_allowed_groups",
+
+		SessionAfterSecondFactor: true,
+		RememberMe:               true,
+	}
+
+	raw, err := json.Marshal(cli.fromStorageAuthRequest(want))
+	require.NoError(t, err)
+	require.Contains(t, string(raw), `"allowListRefusal":"client_allowed_groups"`)
+	require.Contains(t, string(raw), `"sessionAfterSecondFactor":true`)
+	var decoded AuthRequest
+	require.NoError(t, json.Unmarshal(raw, &decoded))
+
+	require.Equal(t, want, toStorageAuthRequest(decoded))
+}
diff --git a/storage/storage.go b/storage/storage.go
index e975bb2..521bb2c 100644
--- a/storage/storage.go
+++ b/storage/storage.go
@@ -375,6 +375,17 @@ type AuthRequest struct {
 	// password policy requires a new password and a second factor comes first, so
 	// that a login that knows only the password cannot set a new one.
 	PendingPasswordChange string
+	// AllowListRefusal is the rule of the allow-list that refused the user of
+	// the login (Deckhouse, allowlist.Rule), empty when none did. The login
+	// passes its second factor first, so that until then its answers do not
+	// depend on the refusal, and it is refused after it: no code is issued.
+	AllowListRefusal string
+	// SessionAfterSecondFactor reports that the browser session of the login
+	// waits for its second factor (Deckhouse): the dispatcher creates or joins
+	// it once the factor is done, with RememberMe, the remember-me choice of
+	// the login.
+	SessionAfterSecondFactor bool
+	RememberMe               bool
 }
 
 // AuthCode represents a code which can be exchanged for an OAuth2 token response.
