diff --git a/server/authflow/deferredsession.go b/server/authflow/deferredsession.go
new file mode 100644
index 0000000..5047e15
--- /dev/null
+++ b/server/authflow/deferredsession.go
@@ -0,0 +1,73 @@
+package authflow
+
+// deferredsession.go puts the browser session of a login off until its second
+// factor is done (Deckhouse).
+
+import (
+	"context"
+	"net/http"
+
+	"github.com/dexidp/dex/storage"
+)
+
+// startSession records a login that passed its first factor on the browser
+// session, as upstream does, unless a second factor is still to pass: then the
+// session waits for it, and the dispatcher creates or joins it once the factor
+// is done (startDeferredSession).
+//
+// The first factor of a login the allow-lists refused is answered as the one of
+// a login they admit (see finalizeLogin), and the session must not tell them
+// apart either: a session created for the one and not for the other would. A
+// session made before the second factor would also outlive a login abandoned
+// there, and a login from it would answer by the allow-lists of the client
+// before the second factor. So no session is made before the second factor, for
+// any login.
+func (h *Handler) startSession(ctx context.Context, r *http.Request, w http.ResponseWriter, authReq storage.AuthRequest, rememberMe bool) {
+	if !h.Sessions.Enabled() {
+		return
+	}
+	outstanding, err := h.mfaOutstanding(ctx, authReq)
+	if err != nil {
+		// Without a session: the user signs in again next time.
+		h.Logger.ErrorContext(ctx, "failed to check the second factor of the login, no session", "err", err)
+		return
+	}
+	if !outstanding {
+		if err := h.Sessions.CreateOrUpdateAuthSession(ctx, r, w, authReq, rememberMe); err != nil {
+			h.Logger.ErrorContext(ctx, "failed to create/update auth session", "err", err)
+		}
+		return
+	}
+	if err := h.Storage.UpdateAuthRequest(ctx, authReq.ID, func(a storage.AuthRequest) (storage.AuthRequest, error) {
+		a.SessionAfterSecondFactor = true
+		a.RememberMe = rememberMe
+		return a, nil
+	}); err != nil {
+		h.Logger.ErrorContext(ctx, "failed to put the auth session off until the second factor", "err", err)
+	}
+}
+
+// startDeferredSession creates or joins the browser session a login put off
+// until its second factor (startSession), and reports whether it answered the
+// request. It sends the browser back to the dispatcher, so that the response is
+// issued from a request that carries the cookie of the session: the code and
+// the second factor recorded on the session name it.
+func (h *Handler) startDeferredSession(w http.ResponseWriter, r *http.Request, authReq storage.AuthRequest) bool {
+	if !authReq.SessionAfterSecondFactor {
+		return false
+	}
+	ctx := r.Context()
+	if err := h.Sessions.CreateOrUpdateAuthSession(ctx, r, w, authReq, authReq.RememberMe); err != nil {
+		h.Logger.ErrorContext(ctx, "failed to create/update auth session", "err", err)
+	}
+	if err := h.Storage.UpdateAuthRequest(ctx, authReq.ID, func(a storage.AuthRequest) (storage.AuthRequest, error) {
+		a.SessionAfterSecondFactor = false
+		return a, nil
+	}); err != nil {
+		h.Logger.ErrorContext(ctx, "failed to record the auth session of the login", "err", err)
+		h.renderError(r, w, http.StatusInternalServerError, ErrMsgInternalServerError)
+		return true
+	}
+	http.Redirect(w, r, h.buildContinueURL(authReq), http.StatusSeeOther)
+	return true
+}
