+// TestGetUserIdentityWithoutObject checks a pair that has no identity yet: what
+// the old fields hold for it reads as its identity, so a check made before the
+// first login, the lock before the password, sees it.
+func TestGetUserIdentityWithoutObject(t *testing.T) {
+	now := time.Now().UTC().Truncate(time.Second)
+	later := now.Add(time.Hour)
+	earlier := now.Add(-time.Hour)
+
+	tests := []struct {
+		name        string
+		connectorID string
+		session     map[string]any // OfflineSessions fields of the pair, nil for none
+		password    map[string]any // Password fields of jane@example.com, nil for none
+		wantFound   bool
+		wantTOTP    *storage.MFASecret
+		wantBlocked time.Time
+		// wantList: the Password objects are looked through for the user ID.
+		wantList bool
+	}{
+		{
+			name:        "lock of an external user",
+			connectorID: "ldap",
+			session:     map[string]any{"lockedUntil": later},
+			wantFound:   true,
+			wantBlocked: later,
+		},
+		{
+			name:        "totp of a local user",
+			connectorID: "local",
+			session:     map[string]any{"totp": legacyTOTPURL, "totpConfirmed": true},
+			wantFound:   true,
+			wantTOTP:    &storage.MFASecret{AuthenticatorID: "totp", Type: "TOTP", Secret: legacyTOTPURL, Confirmed: true},
+			wantList:    true,
+		},
+		{
+			name:        "lock of a local user on the password",
+			connectorID: "local",
+			password:    map[string]any{"userID": "jane", "lockedUntil": later},
+			wantFound:   true,
+			wantBlocked: later,
+			wantList:    true,
+		},
+		{
+			name:        "password lock of another user",
+			connectorID: "local",
+			password:    map[string]any{"userID": "john", "lockedUntil": later},
+			wantList:    true,
+		},
+		{
+			name:        "password lock does not apply to other connectors",
+			connectorID: "ldap",
+			password:    map[string]any{"userID": "jane", "lockedUntil": later},
+		},
+		{
+			name:        "expired lock",
+			connectorID: "ldap",
+			session:     map[string]any{"lockedUntil": earlier},
+		},
+		{
+			name:        "offline session without a second factor or a lock",
+			connectorID: "ldap",
+			session:     map[string]any{"incorrectPasswordLoginAttempts": 2},
+		},
+		{
+			name:        "nothing in the old fields",
+			connectorID: "local",
+			wantList:    true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			cli, api := newFakeAPIClient(t)
+			name := cli.offlineTokenName("jane", tc.connectorID)
+			if tc.session != nil {
+				tc.session["userID"] = "jane"
+				tc.session["connID"] = tc.connectorID
+				api.set(t, cli, resourceOfflineSessions, name, tc.session)
+			}
+			if tc.password != nil {
+				tc.password["email"] = "jane@example.com"
+				api.set(t, cli, resourcePassword, cli.idToName("jane@example.com"), tc.password)
+			}
+
+			got, err := cli.GetUserIdentity(t.Context(), "jane", tc.connectorID)
+
+			assert.Equal(t, tc.wantList, api.listed(t, cli, resourcePassword), "passwords listed")
+			assert.False(t, api.has(t, cli, resourceUserIdentity, name), "a read stores nothing")
+			if !tc.wantFound {
+				require.ErrorIs(t, err, storage.ErrNotFound)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, "jane", got.UserID)
+			assert.Equal(t, tc.connectorID, got.ConnectorID)
+			assert.Equal(t, storage.Claims{UserID: "jane"}, got.Claims)
+			totp := got.MFASecrets["totp"]
+			if totp != nil {
+				totp.CreatedAt = time.Time{}
+			}
+			assert.Equal(t, tc.wantTOTP, totp)
+			assert.True(t, tc.wantBlocked.Equal(got.BlockedUntil), "blocked until %v, want %v", got.BlockedUntil, tc.wantBlocked)
+			// A pair without an identity has revoked nothing yet.
+			assert.Zero(t, got.Generation)
+		})
+	}
+}
