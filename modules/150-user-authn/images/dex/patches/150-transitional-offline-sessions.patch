+// TestLegacyPasswordLockIndex checks that the sign-in attempts of local users
+// without an identity, which come before any password is checked, list the
+// Password objects at most once per legacyLockIndexTTL, however many there are
+// at once, and that a lock written in between reaches dex once the index is
+// listed again.
+func TestLegacyPasswordLockIndex(t *testing.T) {
+	ctx := t.Context()
+	cli, api := newFakeAPIClient(t)
+	clock := time.Now()
+	cli.legacyLocks.now = func() time.Time { return clock }
+	later := clock.Add(time.Hour).UTC().Truncate(time.Second)
+	api.set(t, cli, resourcePassword, cli.idToName("jane@example.com"), map[string]any{
+		"email": "jane@example.com", "userID": "jane", "lockedUntil": later,
+	})
+	api.set(t, cli, resourcePassword, cli.idToName("john@example.com"), map[string]any{
+		"email": "john@example.com", "userID": "john",
+	})
+
+	const attempts = 32
+	var wg sync.WaitGroup
+	blocked := make([]time.Time, attempts)
+	for i := range attempts {
+		wg.Go(func() {
+			got, err := cli.GetUserIdentity(ctx, "jane", "local")
+			if err == nil {
+				blocked[i] = got.BlockedUntil
+			}
+		})
+	}
+	wg.Wait()
+	for i, b := range blocked {
+		require.True(t, later.Equal(b), "attempt %d: blocked until %v", i, b)
+	}
+	require.Equal(t, 1, api.listings(t, cli, resourcePassword), "parallel attempts wait for one list")
+
+	// A lock written to the old field only, within the interval: not seen yet.
+	api.set(t, cli, resourcePassword, cli.idToName("john@example.com"), map[string]any{
+		"email": "john@example.com", "userID": "john", "lockedUntil": later,
+	})
+	_, err := cli.GetUserIdentity(ctx, "john", "local")
+	require.ErrorIs(t, err, storage.ErrNotFound)
+	require.Equal(t, 1, api.listings(t, cli, resourcePassword))
+
+	clock = clock.Add(legacyLockIndexTTL)
+	got, err := cli.GetUserIdentity(ctx, "john", "local")
+	require.NoError(t, err)
+	require.True(t, later.Equal(got.BlockedUntil), "the lock reaches dex with the next list")
+	require.Equal(t, 2, api.listings(t, cli, resourcePassword))
+
+	// A failed list is not kept: the next attempt lists again.
+	clock = clock.Add(legacyLockIndexTTL)
+	api.fail[api.path(t, cli, resourcePassword, "")] = http.StatusInternalServerError
+	_, err = cli.GetUserIdentity(ctx, "jane", "local")
+	require.Error(t, err)
+	require.NotErrorIs(t, err, storage.ErrNotFound)
+	delete(api.fail, api.path(t, cli, resourcePassword, ""))
+	got, err = cli.GetUserIdentity(ctx, "jane", "local")
+	require.NoError(t, err)
+	require.True(t, later.Equal(got.BlockedUntil))
+	require.Equal(t, 4, api.listings(t, cli, resourcePassword))
+}
