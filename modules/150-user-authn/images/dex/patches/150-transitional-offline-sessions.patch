+// TestUserIdentityWritesStoreLegacyState checks that the first write of an
+// identity by this dex keeps what the pair had in the old fields, so it is not
+// lost once the old fields are no longer read.
+func TestUserIdentityWritesStoreLegacyState(t *testing.T) {
+	later := time.Now().Add(time.Hour).UTC().Truncate(time.Second)
+
+	t.Run("update", func(t *testing.T) {
+		cli, api := newFakeAPIClient(t)
+		name := cli.offlineTokenName("jane", "local")
+		api.set(t, cli, resourceUserIdentity, name, map[string]any{"userID": "jane", "connectorID": "local"})
+		api.set(t, cli, resourceOfflineSessions, name, map[string]any{
+			"userID": "jane", "connID": "local", "totp": legacyTOTPURL, "totpConfirmed": true, "lockedUntil": later,
+		})
+
+		err := cli.UpdateUserIdentity(t.Context(), "jane", "local", func(old storage.UserIdentity) (storage.UserIdentity, error) {
+			require.NotNil(t, old.MFASecrets["totp"], "the updater sees the legacy secret")
+			old.MFASecrets["totp"].LastUsedCounter = 42
+			return old, nil
+		})
+		require.NoError(t, err)
+
+		stored := api.get(t, cli, resourceUserIdentity, name)
+		secret := stored["mfaSecrets"].(map[string]any)["totp"].(map[string]any)
+		require.Equal(t, legacyTOTPURL, secret["secret"])
+		require.Equal(t, true, secret["confirmed"])
+		require.EqualValues(t, 42, secret["lastUsedCounter"])
+		require.Equal(t, later.Format(time.RFC3339), stored["blockedUntil"])
+	})
+
+	t.Run("create", func(t *testing.T) {
+		cli, api := newFakeAPIClient(t)
+		name := cli.offlineTokenName("jane", "ldap")
+		api.set(t, cli, resourceOfflineSessions, name, map[string]any{"userID": "jane", "connID": "ldap", "lockedUntil": later})
+
+		err := cli.CreateUserIdentity(t.Context(), storage.UserIdentity{
+			UserID:      "jane",
+			ConnectorID: "ldap",
+			Claims:      storage.Claims{UserID: "jane", Email: "jane@example.com"},
+		})
+		require.NoError(t, err)
+
+		stored := api.get(t, cli, resourceUserIdentity, name)
+		require.Equal(t, later.Format(time.RFC3339), stored["blockedUntil"])
+	})
+}
