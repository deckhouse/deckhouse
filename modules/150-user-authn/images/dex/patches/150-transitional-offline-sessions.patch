+// TestUserIdentityWithoutObjectFirstWrite checks that the identity a pair
+// without one reads as is created, not updated, by the first write: the callers
+// update first and create on storage.ErrNotFound, and the create stores the old
+// values the read showed.
+func TestUserIdentityWithoutObjectFirstWrite(t *testing.T) {
+	later := time.Now().Add(time.Hour).UTC().Truncate(time.Second)
+	ctx := t.Context()
+	cli, api := newFakeAPIClient(t)
+	name := cli.offlineTokenName("jane", "local")
+	api.set(t, cli, resourceOfflineSessions, name, map[string]any{
+		"userID": "jane", "connID": "local", "totp": legacyTOTPURL, "totpConfirmed": true,
+	})
+	api.set(t, cli, resourcePassword, cli.idToName("jane@example.com"), map[string]any{
+		"email": "jane@example.com", "userID": "jane", "lockedUntil": later,
+	})
+
+	read, err := cli.GetUserIdentity(ctx, "jane", "local")
+	require.NoError(t, err)
+	require.NotNil(t, read.MFASecrets["totp"])
+	require.True(t, later.Equal(read.BlockedUntil))
+
+	err = cli.UpdateUserIdentity(ctx, "jane", "local", func(u storage.UserIdentity) (storage.UserIdentity, error) {
+		t.Error("an update of a pair without an identity has nothing to update")
+		return u, nil
+	})
+	require.ErrorIs(t, err, storage.ErrNotFound)
+
+	require.NoError(t, cli.CreateUserIdentity(ctx, storage.UserIdentity{
+		UserID:      "jane",
+		ConnectorID: "local",
+		Claims:      storage.Claims{UserID: "jane", Email: "jane@example.com"},
+	}))
+	stored := api.get(t, cli, resourceUserIdentity, name)
+	secret := stored["mfaSecrets"].(map[string]any)["totp"].(map[string]any)
+	assert.Equal(t, legacyTOTPURL, secret["secret"])
+	assert.Equal(t, true, secret["confirmed"])
+	assert.Equal(t, later.Format(time.RFC3339), stored["blockedUntil"])
+
+	got, err := cli.GetUserIdentity(ctx, "jane", "local")
+	require.NoError(t, err)
+	assert.Equal(t, "jane@example.com", got.Claims.Email, "read from the stored object")
+	assert.Equal(t, read.MFASecrets["totp"].Secret, got.MFASecrets["totp"].Secret)
+	assert.True(t, read.BlockedUntil.Equal(got.BlockedUntil))
+}
