+func (f *fakeAPI) setAnnotation(t *testing.T, cli *client, resource, name, key, value string) {
+	t.Helper()
+	obj := f.get(t, cli, resource, name)
+	meta := obj["metadata"].(map[string]any)
+	meta["annotations"] = map[string]any{key: value}
+	raw, err := json.Marshal(obj)
+	require.NoError(t, err)
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.objects[f.path(t, cli, resource, name)] = raw
+}
