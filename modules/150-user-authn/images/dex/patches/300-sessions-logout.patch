+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s := newTestSessionServer(t)
+			s.SkipApproval = true
+			now := s.Now()
+			const email = "jane@example.com"
+
+			ensureSessionLoginConnector(t, s, "local")
+			require.NoError(t, s.Storage.CreateAuthSession(ctx, storage.AuthSession{
+				ID: "test-nonce", Secret: "test-nonce", UserID: "jane-id", ConnectorID: "local",
+				ClientStates:   map[string]*storage.ClientAuthState{"client-1": {AuthenticatedAt: now, LastActivity: now}},
+				CreatedAt:      now,
+				LastActivity:   now,
+				AbsoluteExpiry: now.Add(time.Hour),
+				IdleExpiry:     now.Add(time.Hour),
+			}))
+			require.NoError(t, s.Storage.CreateUserIdentity(ctx, storage.UserIdentity{
+				UserID: "jane-id", ConnectorID: "local",
+				Claims:    storage.Claims{UserID: "jane-id", Username: "jane", Email: email},
+				Consents:  map[string][]string{"client-1": {"openid"}},
+				LastLogin: now,
+			}))
+			if tc.password != nil {
+				pw := *tc.password
+				pw.Email, pw.UserID, pw.Username, pw.Hash = email, "jane-id", "jane", []byte("$2a$10$hash")
+				require.NoError(t, s.Storage.CreatePassword(ctx, pw))
+			}
+			authReq := storage.AuthRequest{
+				ID: storage.NewID(), ClientID: "client-1", ConnectorID: "local",
+				Scopes: []string{"openid"}, RedirectURI: "http://localhost/callback", MaxAge: -1,
+				HMACKey: storage.NewHMACKey(crypto.SHA256), Expiry: now.Add(10 * time.Minute),
+			}
+			require.NoError(t, s.Storage.CreateAuthRequest(ctx, authReq))
+			ensureSessionLoginClient(t, s, storage.Client{ID: "client-1", Secret: "secret"})
+
+			ok := s.trySessionLogin(ctx, sessionCookieRequest("test-nonce"), httptest.NewRecorder(), &authReq)
+			assert.Equal(t, tc.want, ok)
+		})
+	}
+}
+
+// TestTrySessionLogin_StorageUnavailable: a session that cannot be read is no
+// session for this login, which goes on interactively, but the cookie stays, so the
+// session serves again once the storage does (Deckhouse).
+func TestTrySessionLogin_StorageUnavailable(t *testing.T) {
+	ctx := t.Context()
+	s := newTestSessionServer(t)
+	authReq := setupSessionLoginFixture(t, s)
+
+	failing := &sessionsDown{Storage: s.Storage}
+	s.Storage = failing
+	s.Sessions.Storage = failing
+
+	w := httptest.NewRecorder()
+	ok := s.trySessionLogin(ctx, sessionCookieRequest("test-nonce"), w, &authReq)
+	assert.False(t, ok)
+	assert.Empty(t, w.Result().Cookies(), "the cookie of a session that could not be read is kept")
+}
+
+// sessionsDown is a storage whose auth sessions cannot be read.
+type sessionsDown struct {
+	storage.Storage
+}
+
+func (s *sessionsDown) GetAuthSession(context.Context, string) (storage.AuthSession, error) {
+	return storage.AuthSession{}, errors.New("storage unavailable")
+}
+
+// TestTrySessionLogin_SecondFactor: a login from a session asks for no second
+// factor again when the session passed the whole MFA chain of the client
+// (Deckhouse); upstream asks for it at every login from a session.
+func TestTrySessionLogin_SecondFactor(t *testing.T) {
+	tests := []struct {
+		name   string
+		passed []string
+		chain  []string
+		want   bool
+	}{
+		{name: "chain passed on the session", passed: []string{"totp"}, chain: []string{"totp"}, want: true},
+		{name: "part of the chain passed", passed: []string{"totp"}, chain: []string{"totp", "webauthn"}},
+		{name: "nothing passed", chain: []string{"totp"}},
+		{name: "no chain", passed: []string{"totp"}},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s := newTestSessionServer(t)
+			s.SkipApproval = true
+			s.MFAEnabled = true
+			s.MFAChain = func(context.Context, string, string) ([]string, error) { return tc.chain, nil }
+			authReq := setupSessionLoginFixture(t, s)
+			require.NoError(t, s.Storage.UpdateAuthSession(ctx, "test-nonce", func(old storage.AuthSession) (storage.AuthSession, error) {
+				old.MFAAuthenticators = tc.passed
+				return old, nil
+			}))
+
+			require.True(t, s.trySessionLogin(ctx, sessionCookieRequest("test-nonce"), httptest.NewRecorder(), &authReq))
+			got, err := s.Storage.GetAuthRequest(ctx, authReq.ID)
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, got.MFAValidated)
+		})
+	}
+}
+
+// TestRecordSessionMFA: issuing the response of a login that passed the second
+// factor records its chain on the session of the browser (Deckhouse).
+func TestRecordSessionMFA(t *testing.T) {
+	for _, validated := range []bool{true, false} {
+		ctx := t.Context()
+		s := newTestSessionServer(t)
+		s.MFAChain = func(context.Context, string, string) ([]string, error) { return []string{"totp"}, nil }
+		authReq := setupSessionLoginFixture(t, s)
+		authReq.Claims.UserID = "user-1"
+		authReq.MFAValidated = validated
+
+		w := httptest.NewRecorder()
+		s.recordSessionMFA(ctx, w, "test-nonce", authReq)
+		session, err := s.Storage.GetAuthSession(ctx, "test-nonce")
+		require.NoError(t, err)
+		if validated {
+			assert.Equal(t, []string{"totp"}, session.MFAAuthenticators)
+			assert.NotEqual(t, "test-nonce", session.Secret, "the second factor gives the session a new secret")
+			assert.Len(t, w.Result().Cookies(), 1)
+		} else {
+			assert.Empty(t, session.MFAAuthenticators, "a login that passed no second factor records none")
+			assert.Equal(t, "test-nonce", session.Secret, "a login without a second factor keeps the secret")
+			assert.Empty(t, w.Result().Cookies())
+		}
+	}
+}
