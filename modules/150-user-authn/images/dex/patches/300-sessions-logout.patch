+		// A kubeconfig is signed in through the browser, but its refreshes must not keep the browser
+		// signed in to the other applications.
+		{name: "a standalone client", idleFor: 30 * time.Minute, standalone: true},
+		{name: "live session, used a moment ago", idleFor: time.Minute},
+		{name: "session gone idle", idleFor: 2 * time.Hour},
+		{name: "the user signed in again on another browser", idleFor: 30 * time.Minute, otherLive: true, expectedUse: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, s := newTestServerWithSessions(t, nil)
+			defer httpServer.Close()
+
+			ctx := t.Context()
+			mockRefreshTokenTestStorage(t, s.storage, false)
