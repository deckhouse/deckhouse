diff --git a/server/session/session_mfa_test.go b/server/session/session_mfa_test.go
new file mode 100644
index 00000000..75ef933d
--- /dev/null
+++ b/server/session/session_mfa_test.go
@@ -0,0 +1,105 @@
+package session
+
+import (
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// TestRecordMFA: the authenticators a login passed are added to its session, and
+// only to a session of the same user, connector and generation (Deckhouse).
+func TestRecordMFA(t *testing.T) {
+	ctx := t.Context()
+	s := memory.New(slog.Default())
+	m := &Manager{Storage: s, Config: &Config{CookieName: "dex_session"}, Now: time.Now, Logger: slog.Default()}
+	require.NoError(t, s.CreateAuthSession(ctx, storage.AuthSession{
+		ID: "sid", Secret: "secret", UserID: "jane", ConnectorID: "local", Generation: 2,
+		MFAAuthenticators: []string{"webauthn"},
+	}))
+	login := storage.AuthRequest{Claims: storage.Claims{UserID: "jane"}, ConnectorID: "local", Generation: 2}
+
+	require.NoError(t, m.RecordMFA(ctx, httptest.NewRecorder(), "sid", login, []string{"totp", "webauthn"}))
+	got, err := s.GetAuthSession(ctx, "sid")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"webauthn", "totp"}, got.MFAAuthenticators)
+
+	for name, other := range map[string]storage.AuthRequest{
+		"another user":       {Claims: storage.Claims{UserID: "john"}, ConnectorID: "local", Generation: 2},
+		"another connector":  {Claims: storage.Claims{UserID: "jane"}, ConnectorID: "ldap", Generation: 2},
+		"another generation": {Claims: storage.Claims{UserID: "jane"}, ConnectorID: "local", Generation: 1},
+	} {
+		require.NoError(t, m.RecordMFA(ctx, httptest.NewRecorder(), "sid", other, []string{"sms"}), name)
+	}
+	got, err = s.GetAuthSession(ctx, "sid")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"webauthn", "totp"}, got.MFAAuthenticators, "a session of another login is left alone")
+
+	require.NoError(t, m.RecordMFA(ctx, httptest.NewRecorder(), "gone", login, []string{"totp"}), "a session that is gone is no error")
+}
+
+// TestRecordMFARotatesTheSecret: recording a second factor gives the session a
+// new secret and the browser a new cookie (Deckhouse), so a copy of the cookie
+// taken between the password and the second factor does not carry the second
+// factor. The new cookie keeps the remember-me choice of the session; a record
+// that adds nothing, as at a login from the session, changes nothing.
+func TestRecordMFARotatesTheSecret(t *testing.T) {
+	for _, rememberMe := range []bool{true, false} {
+		ctx := t.Context()
+		s := memory.New(slog.Default())
+		m := &Manager{
+			Storage: s, Now: time.Now, Logger: slog.Default(), IssuerURL: oauth2.IssuerURL{URL: url.URL{Scheme: "https", Host: "dex.example.com"}},
+			Config: &Config{CookieName: "dex_session", AbsoluteLifetime: 24 * time.Hour, ValidIfNotUsedFor: time.Hour},
+		}
+		now := time.Now()
+		require.NoError(t, s.CreateAuthSession(ctx, storage.AuthSession{
+			ID: "sid", Secret: "secret", UserID: "jane", ConnectorID: "local", Generation: 2, RememberMe: rememberMe,
+			ClientStates: map[string]*storage.ClientAuthState{"console": {AuthenticatedAt: now, LastActivity: now}},
+			CreatedAt:    now, LastActivity: now, AbsoluteExpiry: now.Add(24 * time.Hour), IdleExpiry: now.Add(time.Hour),
+		}))
+		login := storage.AuthRequest{Claims: storage.Claims{UserID: "jane"}, ConnectorID: "local", Generation: 2}
+		copied := &http.Cookie{Name: "dex_session", Value: internal.SessionCookieValue("sid", "secret", nil)}
+
+		w := httptest.NewRecorder()
+		require.NoError(t, m.RecordMFA(ctx, w, "sid", login, []string{"totp"}))
+		cookies := w.Result().Cookies()
+		require.Len(t, cookies, 1)
+		assert.NotEqual(t, copied.Value, cookies[0].Value)
+		assert.Equal(t, rememberMe, cookies[0].MaxAge > 0, "the new cookie keeps the remember-me choice")
+
+		r := httptest.NewRequest(http.MethodGet, "/", nil)
+		r.AddCookie(copied)
+		assert.Nil(t, m.ValidSession(ctx, httptest.NewRecorder(), r), "a cookie copied before the second factor")
+		r = httptest.NewRequest(http.MethodGet, "/", nil)
+		r.AddCookie(cookies[0])
+		session := m.ValidSession(ctx, httptest.NewRecorder(), r)
+		require.NotNil(t, session)
+		assert.True(t, MFASatisfied(*session, []string{"totp"}))
+
+		// The second factor is already there: nothing to write, no new cookie.
+		w = httptest.NewRecorder()
+		require.NoError(t, m.RecordMFA(ctx, w, "sid", login, []string{"totp"}))
+		assert.Empty(t, w.Result().Cookies())
+		again, err := s.GetAuthSession(ctx, "sid")
+		require.NoError(t, err)
+		assert.Equal(t, session.Secret, again.Secret)
+	}
+}
+
+func TestMFASatisfied(t *testing.T) {
+	session := storage.AuthSession{MFAAuthenticators: []string{"totp"}}
+	assert.True(t, MFASatisfied(session, []string{"totp"}))
+	assert.False(t, MFASatisfied(session, []string{"totp", "webauthn"}), "every authenticator of the chain")
+	assert.False(t, MFASatisfied(session, nil), "an empty chain is the dispatcher's")
+	assert.False(t, MFASatisfied(storage.AuthSession{}, []string{"totp"}))
+}
