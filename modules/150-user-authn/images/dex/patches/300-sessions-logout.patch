+// TestCodeExchangeAfterLogout: an authorization code minted in a browser session
+// is refused once that session has ended, exactly as a spent code is, instead of
+// minting tokens on a session that signing out was meant to end (Deckhouse). The
+// generation of the pair is unchanged by a logout, so the revocation check alone
+// lets such a code through.
+func TestCodeExchangeAfterLogout(t *testing.T) {
+	ctx := t.Context()
+	httpServer, s := newTestServerWithSessions(t, nil)
+	defer httpServer.Close()
+
+	const userID, connectorID = "test-user", "mock"
+	require.NoError(t, s.storage.CreateClient(ctx, storage.Client{
+		ID: "test", Secret: "barfoo", RedirectURIs: []string{"foo://bar.com/"},
+	}))
+
+	// mintCode stores a live session and an authorization code minted in it, as a
+	// browser login does (the code carries the session's ID), and returns both.
+	mintCode := func(t *testing.T) (sessionID, code string) {
+		t.Helper()
+		sessionID = storage.NewID()
+		require.NoError(t, s.storage.CreateAuthSession(ctx, storage.AuthSession{
+			ID: sessionID, Secret: testSessionSecret(sessionID),
+			UserID: userID, ConnectorID: connectorID,
+			ClientStates:   map[string]*storage.ClientAuthState{"test": {AuthenticatedAt: time.Now()}},
+			CreatedAt:      time.Now(),
+			LastActivity:   time.Now(),
+			AbsoluteExpiry: time.Now().Add(time.Hour),
+			IdleExpiry:     time.Now().Add(time.Hour),
+		}))
+		code = storage.NewID()
+		require.NoError(t, s.storage.CreateAuthCode(ctx, storage.AuthCode{
+			ID: code, SessionID: sessionID,
+			ClientID: "test", ConnectorID: connectorID,
+			Claims:      storage.Claims{UserID: userID},
+			Scopes:      []string{"openid", "offline_access"},
+			RedirectURI: "foo://bar.com/",
+			Expiry:      time.Now().Add(time.Minute),
+		}))
+		return sessionID, code
+	}
+
+	t.Run("the session is still there", func(t *testing.T) {
+		_, code := mintCode(t)
+		resp := tokenResponse(t, exchangeCode(t, s, code))
+		require.NotEmpty(t, resp.AccessToken, "a live session issues tokens")
+	})
+
+	t.Run("the session has ended", func(t *testing.T) {
+		sessionID, code := mintCode(t)
+		require.NoError(t, s.storage.DeleteAuthSession(ctx, sessionID))
+
+		requireErrorResponse(t, exchangeCode(t, s, code),
+			http.StatusBadRequest, oauth2.InvalidGrant, "Invalid or expired code parameter.")
+		_, err := s.storage.GetAuthCode(ctx, code)
+		require.ErrorIs(t, err, storage.ErrNotFound, "the code is spent")
+	})
+}
+
+// flakyStorage is a storage whose auth sessions or offline sessions can be made
+// unreadable. It keeps the revocations of the storage it wraps.
+type flakyStorage struct {
+	storage.Storage
+	sessionsDown atomic.Bool
+	offlineDown  atomic.Bool
+}
+
+var errStorageDown = errors.New("storage unavailable")
+
+func (s *flakyStorage) GetAuthSession(ctx context.Context, id string) (storage.AuthSession, error) {
+	if s.sessionsDown.Load() {
+		return storage.AuthSession{}, errStorageDown
+	}
+	return s.Storage.GetAuthSession(ctx, id)
+}
+
+func (s *flakyStorage) GetOfflineSessions(ctx context.Context, userID, connID string) (storage.OfflineSessions, error) {
+	if s.offlineDown.Load() {
+		return storage.OfflineSessions{}, errStorageDown
+	}
+	return s.Storage.GetOfflineSessions(ctx, userID, connID)
+}
+
+func (s *flakyStorage) CreateRevocation(ctx context.Context, r storage.Revocation) error {
+	c, ok := storage.AsRevocationCreator(s.Storage)
+	if !ok {
+		return nil
+	}
+	return c.CreateRevocation(ctx, r)
+}
