+
+				require.Equal(t, http.StatusFound, rr.Code, rr.Body.String())
+				assert.Equal(t, logoutClientURL+"?state=xyz", rr.Header().Get("Location"))
+				_, err := server.storage.GetAuthSession(t.Context(), "testnonce")
+				require.ErrorIs(t, err, storage.ErrNotFound)
+			})
+		}
+	})
+
+	t.Run("anything else asks to confirm and carries the request on", func(t *testing.T) {
+		for _, tc := range []struct{ name, site, dest string }{
