+// RecordMFA adds the authenticators of a second factor passed by a login of
+// authReq to the session sessionID (Deckhouse), so that a login from the session
+// to a client with the same chain does not ask for it again (see MFASatisfied).
+// The session must be of the user, the connector and the generation of the login:
+// a session of anyone else is left alone.
+//
+// The session is made after the first factor, so a copy of its cookie taken
+// before the second one would carry the second factor once it is recorded. A
+// record that adds an authenticator therefore gives the session a new secret and
+// w a new cookie, with the remember-me choice of the session. A record that adds
+// nothing — a login from the session — writes nothing.
+func (m *Manager) RecordMFA(ctx context.Context, w http.ResponseWriter, sessionID string, authReq storage.AuthRequest, authenticators []string) error {
+	if m.Config == nil || sessionID == "" || len(authenticators) == 0 {
+		return nil
+	}
+	secret := storage.NewID()
+	var rememberMe bool
+	err := m.Storage.UpdateAuthSession(ctx, sessionID, func(old storage.AuthSession) (storage.AuthSession, error) {
+		if old.UserID != authReq.Claims.UserID || old.ConnectorID != authReq.ConnectorID || old.Generation != authReq.Generation {
+			return old, errSessionNotOfLogin
+		}
+		added := false
+		for _, id := range authenticators {
+			if !slices.Contains(old.MFAAuthenticators, id) {
+				old.MFAAuthenticators = append(old.MFAAuthenticators, id)
+				added = true
+			}
+		}
+		if !added {
+			return old, errNothingRecorded
+		}
+		old.Secret = secret
+		rememberMe = old.RememberMe
+		return old, nil
+	})
+	if errors.Is(err, errSessionNotOfLogin) || errors.Is(err, errNothingRecorded) || errors.Is(err, storage.ErrNotFound) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	m.SetCookie(w, sessionID, secret, rememberMe)
+	return nil
+}
+
+// errSessionNotOfLogin aborts RecordMFA on a session of another login.
+var errSessionNotOfLogin = errors.New("session: not the session of the login")
+
+// errNothingRecorded aborts RecordMFA when the session already holds every
+// authenticator.
+var errNothingRecorded = errors.New("session: the second factor is already recorded")
+
+// MFASatisfied reports whether the second factor of a client with the MFA chain
+// was passed on the session (Deckhouse): every authenticator of the chain was. An
+// empty chain needs nothing to be recorded and reports false, leaving it to the
+// dispatcher.
+func MFASatisfied(session storage.AuthSession, chain []string) bool {
+	if len(chain) == 0 {
+		return false
+	}
+	for _, id := range chain {
+		if !slices.Contains(session.MFAAuthenticators, id) {
+			return false
+		}
+	}
+	return true
+}
+
+// maxRefreshUseInterval is the longest a session goes without a write while the
+// applications bound to it refresh their tokens (see UsedByRefresh).
+const maxRefreshUseInterval = 5 * time.Minute
+
+// refreshUseInterval is how long after its last use a session is written again
+// when an application bound to it refreshes its tokens: a tenth of the idle
+// timeout, at most maxRefreshUseInterval. The idle timeout then counts from up to
+// that much earlier than the last refresh.
+func refreshUseInterval(validIfNotUsedFor time.Duration) time.Duration {
+	return min(validIfNotUsedFor/10, maxRefreshUseInterval)
+}
+
+// errSessionNotUsed aborts UsedByRefresh on a session it does not write.
+var errSessionNotUsed = errors.New("session: not used by the refresh")
+
+// UsedByRefresh records that clientID, signed in through the session sessionID,
+// refreshed its tokens (Deckhouse): the session counts as used, and its idle
+// timeout starts again, as at a sign-in through it. While any application of the
+// browser is in use, the browser then signs in to the others without a password,
+// until the absolute lifetime of the session.
+//
+// Nothing is written for a session that has ended — a bound token outlives its
+// session (see the refresh grant), and its refresh does not bring the session
+// back — for a session of another pair or of another generation of the pair, or
+// within refreshUseInterval of the last use. The refresh goes on whatever
+// happens here.
+func (m *Manager) UsedByRefresh(ctx context.Context, sessionID, clientID, userID, connectorID string, generation uint64) {
+	if m == nil || m.Config == nil || sessionID == "" {
+		return
+	}
+	now := m.Now()
+	err := m.Storage.UpdateAuthSession(ctx, sessionID, func(old storage.AuthSession) (storage.AuthSession, error) {
+		switch {
+		case old.UserID != userID || old.ConnectorID != connectorID || old.Generation != generation,
+			expiryReason(old, now) != "",
+			now.Sub(old.LastActivity) < refreshUseInterval(m.Config.ValidIfNotUsedFor):
+			return old, errSessionNotUsed
+		}
+		old.LastActivity = now
+		old.IdleExpiry = now.Add(m.Config.ValidIfNotUsedFor)
+		if cs, ok := old.ClientStates[clientID]; ok {
+			cs.LastActivity = now
+		}
+		return old, nil
+	})
+	if err != nil && !errors.Is(err, errSessionNotUsed) && !errors.Is(err, storage.ErrNotFound) {
+		m.Logger.WarnContext(ctx, "failed to record the use of a session by a refresh",
+			"session_id", sessionID, "client_id", clientID, "err", err)
+	}
+}
