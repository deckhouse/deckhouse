+func TestRefreshUsesItsSession(t *testing.T) {
+	const sid = "sessionid"
+	tests := []struct {
+		name string
+		// idleFor is how long the session has gone unused at the refresh.
+		idleFor   time.Duration
+		otherLive bool
+		// standalone leaves the refresh tokens of the client unbound from the session.
+		standalone  bool
+		expectedUse bool
+	}{
