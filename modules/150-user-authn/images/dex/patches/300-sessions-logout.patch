new file mode 100644
index 00000000..341507cd
--- /dev/null
+++ b/server/session/session_refresh_test.go
@@ -0,0 +1,89 @@
+package session
+
+import (
+	"log/slog"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// TestUsedByRefresh checks that the refresh of an application bound to a live
+// session starts the idle timeout of the session again, at most once per
+// refreshUseInterval, and never for a session that ended, of another pair or of
+// another generation (Deckhouse).
+func TestUsedByRefresh(t *testing.T) {
+	created := time.Date(2026, 10, 17, 9, 0, 0, 0, time.UTC)
+	live := func() storage.AuthSession {
+		return storage.AuthSession{
+			ID: "sid-1", UserID: "jane", ConnectorID: "local", Generation: 2,
+			ClientStates:   map[string]*storage.ClientAuthState{"console": {LastActivity: created}},
+			CreatedAt:      created,
+			LastActivity:   created,
+			AbsoluteExpiry: created.Add(24 * time.Hour),
+			IdleExpiry:     created.Add(time.Hour),
+		}
+	}
+
+	tests := []struct {
+		name        string
+		at          time.Duration
+		userID      string
+		generation  uint64
+		expectedUse bool
+	}{
+		{name: "used after the interval", at: 30 * time.Minute, userID: "jane", generation: 2, expectedUse: true},
+		{name: "within the interval", at: 5*time.Minute - time.Second, userID: "jane", generation: 2},
+		{name: "after the idle timeout", at: time.Hour + time.Second, userID: "jane", generation: 2},
+		{name: "another user", at: 30 * time.Minute, userID: "john", generation: 2},
+		{name: "another generation", at: 30 * time.Minute, userID: "jane", generation: 3},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := t.Context()
+			store := memory.New(slog.New(slog.DiscardHandler))
+			require.NoError(t, store.CreateAuthSession(ctx, live()))
+			now := created.Add(tt.at)
+			m := &Manager{
+				Storage: store,
+				Config:  &Config{AbsoluteLifetime: 24 * time.Hour, ValidIfNotUsedFor: time.Hour},
+				Now:     func() time.Time { return now },
+				Logger:  slog.New(slog.DiscardHandler),
+			}
+
+			m.UsedByRefresh(ctx, "sid-1", "console", tt.userID, "local", tt.generation)
+
+			got, err := store.GetAuthSession(ctx, "sid-1")
+			require.NoError(t, err)
+			if !tt.expectedUse {
+				require.Equal(t, created, got.LastActivity)
+				require.Equal(t, created.Add(time.Hour), got.IdleExpiry)
+				return
+			}
+			require.Equal(t, now, got.LastActivity)
+			require.Equal(t, now.Add(time.Hour), got.IdleExpiry)
+			require.Equal(t, now, got.ClientStates["console"].LastActivity)
+			require.Equal(t, created.Add(24*time.Hour), got.AbsoluteExpiry, "the absolute lifetime does not move")
+		})
+	}
+
+	t.Run("no session", func(t *testing.T) {
+		m := &Manager{
+			Storage: memory.New(slog.New(slog.DiscardHandler)),
+			Config:  &Config{ValidIfNotUsedFor: time.Hour},
+			Now:     time.Now,
+			Logger:  slog.New(slog.DiscardHandler),
+		}
+		m.UsedByRefresh(t.Context(), "sid-gone", "console", "jane", "local", 2)
+		m.UsedByRefresh(t.Context(), "", "console", "jane", "local", 2)
+	})
+}
+
+func TestRefreshUseInterval(t *testing.T) {
+	require.Equal(t, 12*time.Second, refreshUseInterval(2*time.Minute))
+	require.Equal(t, 5*time.Minute, refreshUseInterval(time.Hour))
+	require.Equal(t, 5*time.Minute, refreshUseInterval(24*time.Hour))
+}
