+	t.Run("a navigation from the same site ends the session", func(t *testing.T) {
+		for _, site := range []string{"same-origin", "same-site", "none"} {
+			t.Run(site, func(t *testing.T) {
+				httpServer, server, _ := newLogoutByClientServer(t)
