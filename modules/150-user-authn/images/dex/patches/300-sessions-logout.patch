+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// TestLogoutPostWithoutHintNeedsOwnOrigin: a POST to /logout without an
+// id_token_hint ends the session only from a page of dex's own origin, the
+// confirmation form (Deckhouse). A form of another host of the same site, whose
+// POST the Lax cookie goes with, gets the confirmation page instead.
+func TestLogoutPostWithoutHintNeedsOwnOrigin(t *testing.T) {
+	tests := []struct {
+		name    string
+		site    string
+		origin  string
+		confirm bool
+	}{
+		{name: "confirmation form of dex", site: "same-origin"},
+		{name: "another host of the site", site: "same-site", confirm: true},
+		{name: "another site", site: "cross-site", confirm: true},
+		{name: "no fetch metadata, own origin", origin: "own"},
+		{name: "no fetch metadata, other origin", origin: "https://app.example.com", confirm: true},
+		{name: "no fetch metadata, no origin", confirm: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, server, _ := newLogoutByClientServer(t)
+			defer httpServer.Close()
+
+			req := httptest.NewRequest(http.MethodPost, "/logout", strings.NewReader(url.Values{}.Encode()))
+			req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+			if tc.site != "" {
+				req.Header.Set("Sec-Fetch-Site", tc.site)
+			}
+			switch tc.origin {
+			case "":
+			case "own":
+				req.Header.Set("Origin", server.issuerURL.Scheme+"://"+server.issuerURL.Host)
+			default:
+				req.Header.Set("Origin", tc.origin)
+			}
+			req.AddCookie(testSessionCookie("testnonce"))
+			rr := httptest.NewRecorder()
+			server.ServeHTTP(rr, req)
+
+			require.Equal(t, http.StatusOK, rr.Code)
+			if tc.confirm {
+				require.Contains(t, rr.Body.String(), "Do you want to log out?")
+			} else {
+				require.Contains(t, rr.Body.String(), "successfully logged out")
+			}
+		})
+	}
+}
