+// TestTrySessionLogin_RefusedSSOLeavesSession: an SSO login the checks refuse
+// writes nothing to the session (Deckhouse): the client is not listed in it, so
+// a logout neither revokes it nor notifies it, and the refused attempt does not
+// count as activity that keeps the session from going idle.
+func TestTrySessionLogin_RefusedSSOLeavesSession(t *testing.T) {
+	ctx := t.Context()
+	s := newTestSessionServer(t)
+	s.SkipApproval = true
+	now := s.Now()
+
+	require.NoError(t, s.Storage.CreateClient(ctx, storage.Client{ID: "client-1", Secret: "secret", SSOSharedWith: []string{"client-2"}}))
+	ensureSessionLoginClient(t, s, storage.Client{ID: "client-2", Secret: "secret", AllowedEmails: []string{"other@example.com"}})
+	ensureSessionLoginConnector(t, s, "mock")
+
+	idle := now.Add(59 * time.Minute)
+	require.NoError(t, s.Storage.CreateAuthSession(ctx, storage.AuthSession{
+		ID: "test-nonce", Secret: "test-nonce",
+		UserID: "user-1", ConnectorID: "mock",
+		ClientStates: map[string]*storage.ClientAuthState{
+			"client-1": {AuthenticatedAt: now.Add(-time.Minute), LastActivity: now.Add(-time.Minute)},
+		},
+		CreatedAt:      now.Add(-30 * time.Minute),
+		LastActivity:   now.Add(-time.Minute),
+		AbsoluteExpiry: now.Add(24 * time.Hour),
+		IdleExpiry:     idle,
+	}))
+	require.NoError(t, s.Storage.CreateUserIdentity(ctx, storage.UserIdentity{
+		UserID: "user-1", ConnectorID: "mock",
+		Claims:    storage.Claims{UserID: "user-1", Username: "testuser", Email: "test@example.com"},
+		Consents:  map[string][]string{"client-2": {"openid"}},
+		CreatedAt: now.Add(-time.Hour),
+		LastLogin: now.Add(-30 * time.Minute),
+	}))
+	authReq := storage.AuthRequest{
+		ID: storage.NewID(), ClientID: "client-2", ConnectorID: "mock",
+		Scopes: []string{"openid"}, RedirectURI: "http://localhost/callback", MaxAge: -1,
+		HMACKey: storage.NewHMACKey(crypto.SHA256), Expiry: now.Add(10 * time.Minute),
+	}
+	require.NoError(t, s.Storage.CreateAuthRequest(ctx, authReq))
+
+	require.False(t, s.trySessionLogin(ctx, sessionCookieRequest("test-nonce"), httptest.NewRecorder(), &authReq))
+
+	session, err := s.Storage.GetAuthSession(ctx, "test-nonce")
+	require.NoError(t, err)
+	require.NotContains(t, session.ClientStates, "client-2")
+	require.Equal(t, idle, session.IdleExpiry)
+}
