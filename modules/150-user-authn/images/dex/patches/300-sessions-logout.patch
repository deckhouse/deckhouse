+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/storage"
+)
+
+// The logout of an application that sends the browser to dex by its client_id,
+// without an ID token in the address (Deckhouse).
+
+const (
+	logoutClient     = "app"
+	logoutClientURL  = "https://app.example.com/"
+	logoutConfirmMsg = "Do you want to log out?"
+)
+
+// newLogoutByClientServer serves a client with a registered post-logout address and
+// a live session of a user, and returns the server and its storage seen through
+// flaky, which can be told to fail.
+func newLogoutByClientServer(t *testing.T) (*httptest.Server, *Server, *flakyStorage) {
+	t.Helper()
+	flaky := &flakyStorage{}
+	httpServer, server := newTestServerWithSessions(t, func(c *Config) {
+		flaky.Storage = c.Storage
+		c.Storage = flaky
+	})
+	require.NoError(t, server.storage.CreateClient(t.Context(), storage.Client{
+		ID: logoutClient, Secret: "secret",
+		RedirectURIs:           []string{"https://app.example.com/callback"},
+		PostLogoutRedirectURIs: []string{logoutClientURL},
+	}))
+	newTestAuthSession(t, server, "test-user", "mock", "testnonce")
+	return httpServer, server, flaky
+}
+
+// logoutRequest is a request to /logout with the session cookie and the given
+// Sec-Fetch-Site and Sec-Fetch-Dest; an empty site sends no fetch metadata at all.
+func logoutRequest(method string, params url.Values, site, dest string) *http.Request {
+	var req *http.Request
+	if method == http.MethodPost {
+		req = httptest.NewRequest(method, "/logout", strings.NewReader(params.Encode()))
