+
+// TestTrySessionLogin_OfflineAccess: a client that asks for offline access gets a
+// grant from the session only when its refresh tokens end with the session; any
+// other — kubeconfig, a device, an application keeping its own tokens — signs the
+// user in interactively (Deckhouse).
+func TestTrySessionLogin_OfflineAccess(t *testing.T) {
+	tests := []struct {
+		name string
+		// lifetime is the RefreshTokenLifetime of the client; noClient leaves the
+		// client out of the storage.
+		lifetime string
+		noClient bool
+		scopes   []string
+		want     bool
+	}{
+		{
+			name:   "standalone client asking for offline access",
+			scopes: []string{"openid", "offline_access"},
+			want:   false,
+		},
+		{
+			name:     "session-bound client asking for offline access",
+			lifetime: storage.RefreshTokenLifetimeSession,
+			scopes:   []string{"openid", "offline_access"},
+			want:     true,
+		},
+		{
+			name:   "standalone client without offline access",
+			scopes: []string{"openid", "email"},
+			want:   true,
+		},
+		{
+			name:     "unknown client asking for offline access",
+			noClient: true,
+			scopes:   []string{"openid", "offline_access"},
+			want:     false,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s := newTestSessionServer(t)
+			s.SkipApproval = true
+			authReq := setupSessionLoginFixture(t, s)
+			authReq.Scopes = tc.scopes
+
+			if tc.noClient {
+				require.NoError(t, s.Storage.DeleteClient(ctx, authReq.ClientID))
+			} else {
+				require.NoError(t, s.Storage.UpdateClient(ctx, authReq.ClientID, func(old storage.Client) (storage.Client, error) {
+					old.RefreshTokenLifetime = tc.lifetime
+					return old, nil
+				}))
+			}
+
+			w := httptest.NewRecorder()
+			ok := s.trySessionLogin(ctx, sessionCookieRequest("test-nonce"), w, &authReq)
+			assert.Equal(t, tc.want, ok)
+
+			// Either way the session is the user's to keep.
+			_, err := s.Storage.GetAuthSession(ctx, "test-nonce")
+			require.NoError(t, err)
+			assert.Empty(t, w.Result().Cookies(), "the session cookie is left alone")
+		})
+	}
+}
+
+// TestTrySessionLogin_AllowLists: the allow-lists of the client and the connector
+// refuse a session login as they refuse the interactive one, and narrow the groups
+// the tokens carry the same way (Deckhouse).
+func TestTrySessionLogin_AllowLists(t *testing.T) {
+	tests := []struct {
+		name       string
+		client     storage.Client
+		connector  storage.Connector
+		want       bool
+		wantGroups []string
+	}{
+		{
+			name:       "no lists",
+			want:       true,
+			wantGroups: []string{"admins", "devs"},
+		},
+		{
+			name:   "client email list without the user",
+			client: storage.Client{AllowedEmails: []string{"other@example.com"}},
+		},
+		{
+			name:      "connector group list without the user",
+			connector: storage.Connector{AllowedGroups: []string{"ops"}},
+		},
+		{
+			name:       "client group list narrows the groups",
+			client:     storage.Client{AllowedGroups: []string{"devs"}},
+			want:       true,
+			wantGroups: []string{"devs"},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s := newTestSessionServer(t)
+			s.SkipApproval = true
+			authReq := setupSessionLoginFixture(t, s)
+
+			require.NoError(t, s.Storage.UpdateUserIdentity(ctx, "user-1", "mock", func(old storage.UserIdentity) (storage.UserIdentity, error) {
+				old.Claims.Groups = []string{"admins", "devs"}
+				return old, nil
+			}))
+			require.NoError(t, s.Storage.UpdateClient(ctx, authReq.ClientID, func(old storage.Client) (storage.Client, error) {
+				old.AllowedEmails, old.AllowedGroups = tc.client.AllowedEmails, tc.client.AllowedGroups
+				return old, nil
+			}))
+			require.NoError(t, s.Storage.UpdateConnector(ctx, "mock", func(old storage.Connector) (storage.Connector, error) {
+				old.AllowedGroups = tc.connector.AllowedGroups
+				return old, nil
+			}))
+
+			ok := s.trySessionLogin(ctx, sessionCookieRequest("test-nonce"), httptest.NewRecorder(), &authReq)
+			require.Equal(t, tc.want, ok)
+			if !tc.want {
+				return
+			}
+
+			issued, err := s.Storage.GetAuthRequest(ctx, authReq.ID)
+			require.NoError(t, err)
+			assert.Equal(t, tc.wantGroups, issued.Claims.Groups)
+		})
+	}
+}
+
+// TestTrySessionLogin_LocalPassword: a local user is signed in from the session
+// only while the password is there and need not be changed (Deckhouse).
