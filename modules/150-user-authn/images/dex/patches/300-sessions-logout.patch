+// recordSessionMFA records on the browser session the MFA chain the login passed
+// (Deckhouse), so that a login from the session to a client with the same chain
+// asks for no second factor again (see trySessionLoginWithSession). A failure
+// costs only that convenience and does not stop the response.
+func (h *Handler) recordSessionMFA(ctx context.Context, w http.ResponseWriter, sessionID string, authReq storage.AuthRequest) {
+	if sessionID == "" || !authReq.MFAValidated || h.MFAChain == nil {
+		return
+	}
+	chain, err := h.MFAChain(ctx, authReq.ClientID, authReq.ConnectorID)
+	if err == nil {
+		err = h.Sessions.RecordMFA(ctx, w, sessionID, authReq, chain)
+	}
+	if err != nil {
+		h.Logger.WarnContext(ctx, "session: failed to record the second factor", "session_id", sessionID, "err", err)
+	}
+}
