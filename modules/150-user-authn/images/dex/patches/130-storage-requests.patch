+// newRequestsClient returns a client of the API server handler, with a limiter
+// of maxInFlight slots, the first backoff retryBase and the budget of a call.
+func newRequestsClient(t *testing.T, handler http.Handler, maxInFlight int, retryBase, callBudget time.Duration) *client {
+	t.Helper()
+	server := httptest.NewServer(handler)
+	t.Cleanup(server.Close)
+	l := newRequestLimiter(maxInFlight)
+	l.retryBase, l.callBudget = retryBase, callBudget
+	return &client{
+		client:     server.Client(),
+		baseURL:    server.URL,
+		namespace:  "dex",
+		apiVersion: "dex.coreos.com/v1",
+		logger:     slog.New(slog.DiscardHandler),
+		hash:       func() hash.Hash { return fnv.New64() },
+		requests:   l,
+	}
+}
+
+// throttling answers the first throttled requests with 429 and retryAfter,
+// then passes them to next; it records the bodies it got.
+type throttling struct {
+	mu         sync.Mutex
+	throttled  int
+	retryAfter string
+	next       http.Handler
+	bodies     [][]byte
+}
+
+func (h *throttling) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	body, _ := io.ReadAll(r.Body)
+	h.mu.Lock()
+	h.bodies = append(h.bodies, body)
+	throttle := h.throttled != 0
+	if h.throttled > 0 {
+		h.throttled--
+	}
+	h.mu.Unlock()
+
+	if throttle {
+		if h.retryAfter != "" {
+			w.Header().Set("Retry-After", h.retryAfter)
+		}
+		w.WriteHeader(http.StatusTooManyRequests)
+		return
+	}
+	r.Body = io.NopCloser(bytes.NewReader(body))
+	h.next.ServeHTTP(w, r)
+}
+
+func (h *throttling) requests() int {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return len(h.bodies)
+}
+
+func okHandler(status int) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(status)
+		w.Write([]byte(`{}`))
+	})
+}
+
+func TestDoSendsThrottledRequestsAgain(t *testing.T) {
+	tests := []struct {
+		name       string
+		throttled  int
+		retryAfter string
+		minElapsed time.Duration
+	}{
+		{name: "without Retry-After", throttled: 3},
+		{name: "with Retry-After", throttled: 1, retryAfter: "1", minElapsed: time.Second},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			h := &throttling{throttled: tt.throttled, retryAfter: tt.retryAfter, next: okHandler(http.StatusOK)}
+			cli := newRequestsClient(t, h, 4, time.Millisecond, 3*time.Second)
+
+			start := time.Now()
+			var got map[string]any
+			require.NoError(t, cli.get(t.Context(), resourceAuthRequest, "req", &got))
+			require.GreaterOrEqual(t, time.Since(start), tt.minElapsed)
+			require.Equal(t, tt.throttled+1, h.requests())
+			require.InDelta(t, float64(tt.throttled), testutil.ToFloat64(cli.requests.throttled.WithLabelValues("retried")), 0)
+			require.Zero(t, testutil.ToFloat64(cli.requests.throttled.WithLabelValues("failed")))
+		})
+	}
+}
+
+// TestDoSendsThrottledCreateAgain checks that a create is sent again with the
+// same body: the same object, with the same create ID.
+func TestDoSendsThrottledCreateAgain(t *testing.T) {
+	api := &schemaAPI{objects: map[string][]byte{}}
+	h := &throttling{throttled: 2, next: api}
+	cli := newRequestsClient(t, h, 4, time.Millisecond, time.Second)
+
+	require.NoError(t, cli.CreateAuthRequest(t.Context(), storage.AuthRequest{ID: "req", ClientID: "app"}))
+	require.Len(t, h.bodies, 3)
+	require.Equal(t, h.bodies[0], h.bodies[2])
