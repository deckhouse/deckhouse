+// Only a create is told apart by the reason of its 409: an update that
+// conflicts stays a conflict, and a create of a CRD that exists stays
+// ErrAlreadyExists.
+func TestConflictReasons(t *testing.T) {
+	for _, tc := range []struct {
+		name, method, body string
+		alreadyExists      bool
+	}{
+		{"update, Conflict", http.MethodPut, quotaConflict, false},
+		{"update, no status", http.MethodPut, "", false},
+		{"create, Conflict", http.MethodPost, quotaConflict, false},
+		{"create, AlreadyExists", http.MethodPost, `{"kind": "Status", "reason": "AlreadyExists", "code": 409}`, true},
+		{"create, no status", http.MethodPost, "", true},
+		{"create, not a Status", http.MethodPost, `{"reason": "Conflict"}`, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.WriteHeader(http.StatusConflict)
+				w.Write([]byte(tc.body))
+			})
+			cli := newRequestsClient(t, h, 4, time.Millisecond, time.Second)
+
+			var err error
+			if tc.method == http.MethodPut {
+				err = cli.put(t.Context(), resourceAuthRequest, "req", map[string]any{})
+			} else {
+				err = cli.postResource(t.Context(), cli.apiVersion, cli.namespace, resourceAuthRequest, map[string]any{})
+			}
+			if tc.alreadyExists {
+				require.ErrorIs(t, err, storage.ErrAlreadyExists)
+				return
+			}
+			require.NotErrorIs(t, err, storage.ErrAlreadyExists)
+			require.True(t, isKubernetesAPIConflictError(err))
+		})
+	}
+}
