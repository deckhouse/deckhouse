+package storage
+
+import "context"
+
+// WithoutRequestLimit returns a context whose storage requests do not wait for
+// the limit of requests in flight of a storage that has one (Deckhouse, the
+// Kubernetes storage). Their other bounds stay. The scrape of the connector
+// metrics lists the connectors so: one request per scrape, which reports the
+// connectors, not whether Dex is throttling its own requests at the moment.
+func WithoutRequestLimit(ctx context.Context) context.Context {
+	return context.WithValue(ctx, requestLimitKey{}, true)
+}
+
+// RequestLimitSkipped reports whether ctx comes from WithoutRequestLimit.
+func RequestLimitSkipped(ctx context.Context) bool {
+	skipped, _ := ctx.Value(requestLimitKey{}).(bool)
+	return skipped
+}
+
+type requestLimitKey struct{}
