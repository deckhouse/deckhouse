+// quotaConflict is the response of the API server to a create that the
+// ResourceQuota admission refused when its update of the quota conflicted.
+const quotaConflict = `{"kind": "Status", "apiVersion": "v1", "status": "Failure",
+	"message": "Operation cannot be fulfilled on resourcequotas \"authrequest-quota\": the object has been modified; please apply your changes to the latest version and try again",
+	"reason": "Conflict", "details": {"name": "authrequest-quota", "kind": "resourcequotas"}, "code": 409}`
+
+// refusing answers the first creates with 409 Conflict and body (-1 refuses
+// every one), without passing them to next, and records the bodies of the
+// creates and the number of reads; getStatus, if set, answers every read.
+type refusing struct {
+	mu        sync.Mutex
+	refuse    int
+	body      string
+	getStatus int
+	next      http.Handler
+	posts     [][]byte
+	gets      int
+}
+
+func (h *refusing) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	body, _ := io.ReadAll(r.Body)
+	h.mu.Lock()
+	refuse, getStatus := false, h.getStatus
+	switch r.Method {
+	case http.MethodPost:
+		h.posts = append(h.posts, body)
+		refuse = h.refuse != 0
+		if h.refuse > 0 {
+			h.refuse--
+		}
+	case http.MethodGet:
+		h.gets++
+	}
+	h.mu.Unlock()
+
+	switch {
+	case refuse:
+		w.WriteHeader(http.StatusConflict)
+		w.Write([]byte(h.body))
+	case r.Method == http.MethodGet && getStatus != 0:
+		w.WriteHeader(getStatus)
+	default:
+		r.Body = io.NopCloser(bytes.NewReader(body))
+		h.next.ServeHTTP(w, r)
+	}
+}
+
+func (h *refusing) counts() (posts, gets int) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return len(h.posts), h.gets
+}
