diff --git a/storage/kubernetes/requests.go b/storage/kubernetes/requests.go
new file mode 100644
index 00000000..586cc01e
--- /dev/null
+++ b/storage/kubernetes/requests.go
@@ -0,0 +1,525 @@
+package kubernetes
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math/rand/v2"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/kubernetes/k8sapi"
+)
+
+// Every request of Dex to the Kubernetes API goes through do (Deckhouse): it
+// waits for one of a limited number of slots, and a request the API server
+// throttles is sent again.
+//
+// The requests of Dex have a priority level of their own in the API server
+// (Deckhouse templates/dex/flowcontrol.yaml): about 40 seats of each API
+// server, and 8 queues of 50 requests that one flow, all of Dex, fills. Past
+// those 440 requests in one API server, every request of Dex is refused with
+// 429 Too Many Requests. Each replica keeps its requests on one HTTP/2
+// connection, so to one API server, and at a cold start, with every DexAuthenticator
+// refreshing its users at once, two replicas filled the level and got 1849
+// refusals in 45 seconds; a refresh is 7 to 9 requests one after another, and
+// each refusal was a 500 to the user.
+const (
+	// defaultMaxRequestsInFlight is how many requests one Dex replica sends to
+	// the API server at once: three replicas (two in HA and one more during a
+	// rolling update) on one API server send at most 384, under the 440 its
+	// priority level of Dex holds. A request takes milliseconds, so 128 serve
+	// thousands of requests a second; the limit only holds Dex back when the API
+	// server slows down, and the requests wait in Dex instead of in the queues
+	// of the API server.
+	defaultMaxRequestsInFlight = 128
+	// defaultCallBudget is how long one storage request takes at most, with the
+	// waits for a slot, the attempts and the pauses between them: the 15 s one
+	// attempt could take before (the timeout of the HTTP client). A context
+	// with an earlier deadline ends it earlier; the background tasks (garbage
+	// collection, the sweep of the expired tokens) run in contexts without one.
+	defaultCallBudget = 15 * time.Second
+	// maxRetryAfter caps the Retry-After of the API server: a longer pause is
+	// past the budget of any call anyway.
+	maxRetryAfter = time.Hour
+	// defaultRetryBase is the first pause before a throttled request that came
+	// without Retry-After is sent again; each pause doubles, up to
+	// maxRetryPause.
+	defaultRetryBase = 100 * time.Millisecond
+	maxRetryPause    = 2 * time.Second
+)
+
+// createIDAnnotation names the create ID a Dex object is created with
+// (Deckhouse). The object keeps it: an update writes the metadata it read.
+const createIDAnnotation = "user-authn.deckhouse.io/create-id"
+
+// errNoSlot is returned for a request that found no free slot in time.
+var errNoSlot = errors.New("no free slot for a request to the Kubernetes API")
+
+// requestLimiter limits the requests of the client in flight at once and
+// sends the throttled ones again (Deckhouse).
+type requestLimiter struct {
+	slots      chan struct{}
+	callBudget time.Duration
+	retryBase  time.Duration
+
+	limit     prometheus.Gauge
+	inFlight  prometheus.Gauge
+	waiting   prometheus.Gauge
+	rejected  prometheus.Counter
+	throttled *prometheus.CounterVec
+	refused   *prometheus.CounterVec
+}
+
+func newRequestLimiter(maxInFlight int) *requestLimiter {
+	l := &requestLimiter{
+		slots:      make(chan struct{}, maxInFlight),
+		callBudget: defaultCallBudget,
+		retryBase:  defaultRetryBase,
+		limit: prometheus.NewGauge(prometheus.GaugeOpts{
+			Name: "dex_kubernetes_requests_limit",
+			Help: "How many requests to the Kubernetes API Dex sends at once at most.",
+		}),
+		inFlight: prometheus.NewGauge(prometheus.GaugeOpts{
+			Name: "dex_kubernetes_requests_in_flight",
+			Help: "Requests to the Kubernetes API in flight.",
+		}),
+		waiting: prometheus.NewGauge(prometheus.GaugeOpts{
+			Name: "dex_kubernetes_requests_waiting",
+			Help: "Requests to the Kubernetes API waiting for a free slot.",
+		}),
+		rejected: prometheus.NewCounter(prometheus.CounterOpts{
+			Name: "dex_kubernetes_requests_rejected_total",
+			Help: "Requests to the Kubernetes API that found no free slot before their context or their budget ended.",
+		}),
+		throttled: prometheus.NewCounterVec(prometheus.CounterOpts{
+			Name: "dex_kubernetes_requests_throttled_total",
+			Help: "Responses 429 Too Many Requests of the Kubernetes API, by outcome: retried, or failed when the next attempt would start past the budget of the request.",
+		}, []string{"outcome"}),
+		refused: prometheus.NewCounterVec(prometheus.CounterOpts{
+			Name: "dex_kubernetes_requests_refused_creates_total",
+			Help: "Creates the Kubernetes API answered with 409 Conflict without storing the object (the ResourceQuota admission whose update of the quota conflicted), by outcome: retried, or failed when the next attempt would start past the budget of the request.",
+		}, []string{"outcome"}),
+	}
+	l.limit.Set(float64(maxInFlight))
+	// Both outcomes are exported from the start, so that their rates are.
+	for _, outcome := range []string{"retried", "failed"} {
+		l.throttled.WithLabelValues(outcome)
+		l.refused.WithLabelValues(outcome)
+	}
+	return l
+}
+
+func (l *requestLimiter) collectors() []prometheus.Collector {
+	return []prometheus.Collector{l.limit, l.inFlight, l.waiting, l.rejected, l.throttled, l.refused}
+}
+
+// withBudget ends ctx with the budget of one call, or earlier with the
+// deadline ctx has, and returns the deadline.
+func (l *requestLimiter) withBudget(ctx context.Context) (context.Context, time.Time, context.CancelFunc) {
+	deadline := time.Now().Add(l.callBudget)
+	if d, ok := ctx.Deadline(); ok && d.Before(deadline) {
+		return ctx, d, func() {}
+	}
+	ctx, cancel := context.WithDeadline(ctx, deadline)
+	return ctx, deadline, cancel
+}
+
+// fits reports whether an attempt after pause starts within the budget that
+// ends at deadline: a pause that leaves the attempt less than retryBase of the
+// budget is not waited for, the attempt would be cut.
+func (l *requestLimiter) fits(deadline time.Time, pause time.Duration) bool {
+	return time.Until(deadline) >= pause+l.retryBase
+}
+
+// sleep waits pause, or until ctx ends.
+func sleep(ctx context.Context, pause time.Duration) error {
+	timer := time.NewTimer(pause)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		return nil
+	case <-ctx.Done():
+		return context.Cause(ctx)
+	}
+}
+
+// acquire takes a slot, waiting at most until ctx ends. The returned function
+// frees it.
+func (l *requestLimiter) acquire(ctx context.Context) (func(), error) {
+	select {
+	case l.slots <- struct{}{}:
+	default:
+		if err := l.wait(ctx); err != nil {
+			return nil, err
+		}
+	}
+	l.inFlight.Inc()
+	return func() {
+		l.inFlight.Dec()
+		<-l.slots
+	}, nil
+}
+
+func (l *requestLimiter) wait(ctx context.Context) error {
+	l.waiting.Inc()
+	defer l.waiting.Dec()
+
+	select {
+	case l.slots <- struct{}{}:
+		return nil
+	case <-ctx.Done():
+		l.rejected.Inc()
+		return fmt.Errorf("%w: %w", errNoSlot, context.Cause(ctx))
+	}
+}
+
+// retryPause is the pause before attempt+1 of a throttled request (attempt 0
+// is the first). The pause the API server asks for in Retry-After, in seconds,
+// gets up to half of it more at random, so that the requests it throttled at
+// once do not come back at once; without it, the pause doubles from retryBase,
+// each half random.
+func (l *requestLimiter) retryPause(attempt int, retryAfter string) time.Duration {
+	if seconds, err := strconv.ParseInt(strings.TrimSpace(retryAfter), 10, 64); err == nil && seconds > 0 {
+		pause := maxRetryAfter
+		if seconds < int64(maxRetryAfter/time.Second) {
+			pause = time.Duration(seconds) * time.Second
+		}
+		return pause + jitter(pause/2)
+	}
+	pause := maxRetryPause
+	if attempt < 16 {
+		pause = min(l.retryBase<<attempt, maxRetryPause)
+	}
+	if pause <= 0 {
+		pause = maxRetryPause
+	}
+	return pause/2 + jitter(pause/2)
+}
+
+// jitter returns a random pause from 0 to limit.
+func jitter(limit time.Duration) time.Duration {
+	if limit <= 0 {
+		return 0
+	}
+	return rand.N(limit + 1)
+}
+
+// do sends a request to the Kubernetes API in a slot and returns the response
+// with its body read, so that the slot is free once do returns. The waits for
+// a slot, the attempts and the pauses between them end with ctx and within the
+// budget of the call. A response 429 Too Many Requests is sent again while the
+// next attempt starts within the budget, and returned otherwise. The API
+// server answers 429 before it handles a request (priority and fairness, the
+// limit of requests in flight, a server shutting down), so even a create is
+// safe to send again; a create the API server answers 409 Conflict to is told
+// apart by create. A 503 is not sent again: the API server answers it
+// once a request has reached its handler, and a create may be done.
+//
+// A client without a requestLimiter (tests build one by hand) neither waits
+// nor retries.
+func (cli *client) do(ctx context.Context, method, url, contentType string, body []byte) (*http.Response, error) {
+	l := cli.requests
+	if l == nil {
+		return cli.send(ctx, method, url, contentType, body)
+	}
+	ctx, deadline, cancel := l.withBudget(ctx)
+	defer cancel()
+	for attempt := 0; ; attempt++ {
+		resp, err := cli.send(ctx, method, url, contentType, body)
+		if err != nil || resp.StatusCode != http.StatusTooManyRequests {
+			return resp, err
+		}
+
+		// A 429 past the budget is returned: it says more than a cut attempt.
+		pause := l.retryPause(attempt, resp.Header.Get("Retry-After"))
+		if !l.fits(deadline, pause) {
+			l.throttled.WithLabelValues("failed").Inc()
+			return resp, nil
+		}
+		l.throttled.WithLabelValues("retried").Inc()
+		if err := sleep(ctx, pause); err != nil {
+			return nil, fmt.Errorf("%s %s: wait to send a throttled request again: %w", method, url, err)
+		}
+	}
+}
+
+// send is one attempt of do.
+func (cli *client) send(ctx context.Context, method, url, contentType string, body []byte) (*http.Response, error) {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	reqCtx, cancel := requestContext(ctx, method)
+	defer cancel()
+	req, err := http.NewRequestWithContext(reqCtx, method, url, reader)
+	if err != nil {
+		return nil, fmt.Errorf("create request: %w", err)
+	}
+	if contentType != "" {
+		req.Header.Set("Content-Type", contentType)
+	}
+
+	if cli.requests != nil && !storage.RequestLimitSkipped(ctx) {
+		release, err := cli.requests.acquire(ctx)
+		if err != nil {
+			return nil, err
+		}
+		defer release()
+	}
+
+	resp, err := cli.client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	data, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, fmt.Errorf("read response body: %w", err)
+	}
+	resp.Body = io.NopCloser(bytes.NewReader(data))
+	return resp, nil
+}
+
+// requestContext is the context of the HTTP request of a storage call in ctx
+// (Deckhouse). A read ends with ctx. A write keeps the deadline of ctx but not
+// its cancellation: the storage did not pass the context to its requests
+// before, and a user who hangs up still does not cut a write on its way, or the
+// rollback after a failed one. The end of ctx ends the wait for a slot and the
+// pauses before a throttled request is sent again either way, where a request
+// that nobody waits for only adds to the load. A deadline, of the call (its
+// budget) or one Dex sets, still ends the write.
+func requestContext(ctx context.Context, method string) (context.Context, context.CancelFunc) {
+	if method == http.MethodGet {
+		return ctx, func() {}
+	}
+	detached := context.WithoutCancel(ctx)
+	if deadline, ok := ctx.Deadline(); ok {
+		return context.WithDeadline(detached, deadline)
+	}
+	return detached, func() {}
+}
+
+// withCreateID marshals a Dex object with a new create ID in its annotations,
+// and returns the body, the name of the object and the ID.
+//
+// A create may reach the API server twice (Deckhouse): a layer below Dex may
+// send the same request again after the answer to the first one was lost, and
+// the second one finds the object the first one created and gets 409
+// Conflict, and Dex would fail a login whose create had succeeded. A create
+// ID tells such a create from a create of an object that someone else created: the ID is new
+// for every create, and the same in every attempt of it. The IDs of most
+// objects are random as well, but some are names derived from a user, and a
+// storage must keep refusing a second create of the same object.
+func withCreateID(v interface{}) (body []byte, name, createID string, err error) {
+	raw, err := json.Marshal(v)
+	if err != nil {
+		return nil, "", "", fmt.Errorf("marshal object: %v", err)
+	}
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &object); err != nil {
+		return nil, "", "", fmt.Errorf("unmarshal object: %w", err)
+	}
+	var meta k8sapi.ObjectMeta
+	if m, ok := object["metadata"]; ok {
+		if err := json.Unmarshal(m, &meta); err != nil {
+			return nil, "", "", fmt.Errorf("unmarshal object metadata: %w", err)
+		}
+	}
+	createID = storage.NewID()
+	if meta.Annotations == nil {
+		meta.Annotations = map[string]string{}
+	}
+	meta.Annotations[createIDAnnotation] = createID
+	if object["metadata"], err = json.Marshal(meta); err != nil {
+		return nil, "", "", fmt.Errorf("marshal object metadata: %w", err)
+	}
+	if body, err = json.Marshal(object); err != nil {
+		return nil, "", "", fmt.Errorf("marshal object: %w", err)
+	}
+	return body, meta.Name, createID, nil
+}
+
+// apiStatus is the part of a Status of the Kubernetes API that Dex reads.
+type apiStatus struct {
+	Kind    string `json:"kind"`
+	Reason  string `json:"reason"`
+	Message string `json:"message"`
+	Details struct {
+		Kind string `json:"kind"`
+	} `json:"details"`
+}
+
+// parseStatus reads the Status in the body of an error response; ok is false
+// for a body without one (an old API server, a proxy).
+func parseStatus(body []byte) (status apiStatus, ok bool) {
+	if err := json.Unmarshal(body, &status); err != nil || status.Kind != "Status" {
+		return apiStatus{}, false
+	}
+	return status, true
+}
+
+// refusedCreate reports whether the body of a 409 Conflict to a create says
+// that the API server refused the create before it stored the object: reason
+// Conflict, where an object that exists gives AlreadyExists. The ResourceQuota
+// admission answers so when its update of the status of a quota still
+// conflicts after its own tries, which it makes from the quota in the cache of
+// its API server: another writer of the quota status (the admission in
+// another API server, the quota controller) was ahead of that cache
+// (kubernetes/kubernetes#67761).
+func refusedCreate(body []byte) bool {
+	status, ok := parseStatus(body)
+	return ok && status.Reason == "Conflict"
+}
+
+// create sends a create of a Dex object to url, with the create ID createID of
+// the object name of resource (Deckhouse). Every attempt sends the same body.
+//
+// A 409 Conflict means one of three things:
+//   - the API server refused the create before it stored the object (reason
+//     Conflict, refusedCreate): the create is sent again;
+//   - the object exists (reason AlreadyExists, or a 409 without a status): if
+//     it carries createID, an earlier attempt, or a layer below Dex sending the
+//     same request again, created it, and the create succeeded; an object of
+//     someone else gives storage.ErrAlreadyExists;
+//   - a 409 without a status whose object does not exist: an API server or a
+//     proxy that dropped the Status of a refusal, and the create is sent again.
+//
+// The attempts, the pauses between them and the reads of the object end with
+// ctx and within the budget of one call. A client without a requestLimiter
+// does not send a create again.
+func (cli *client) create(ctx context.Context, resource, url, name, createID string, body []byte) error {
+	l := cli.requests
+	var deadline time.Time
+	if l != nil {
+		var cancel context.CancelFunc
+		ctx, deadline, cancel = l.withBudget(ctx)
+		defer cancel()
+	}
+	for attempt := 0; ; attempt++ {
+		status, err := cli.createOnce(ctx, url, body)
+		switch {
+		case err == nil:
+			return nil
+		case isKubernetesAPIConflictError(err):
+			// Refused before the object was stored.
+		case errors.Is(err, storage.ErrAlreadyExists):
+			switch cli.createdBy(ctx, resource, name, createID) {
+			case createdHere:
+				cli.logger.InfoContext(ctx, "a create sent again found the object it created", "resource", resource)
+				return nil
+			case notCreated:
+				if status.Reason != "" || l == nil {
+					// The object existed, and was deleted since; or the
+					// create is not sent again.
+					return err
+				}
+				err = fmt.Errorf("create %s %s: 409 Conflict without a status, and the object does not exist", resource, name)
+			case createdElsewhere, createUnknown:
+				return err
+			}
+		default:
+			return err
+		}
+
+		if l == nil {
+			return err
+		}
+		pause := l.retryPause(attempt, "")
+		if !l.fits(deadline, pause) {
+			l.refused.WithLabelValues("failed").Inc()
+			return err
+		}
+		l.refused.WithLabelValues("retried").Inc()
+		cli.logger.InfoContext(ctx, "a create the API server refused with 409 Conflict is sent again",
+			"resource", resource, "attempt", attempt+1, "reason", status.Reason,
+			"status_kind", status.Details.Kind, "message", status.Message)
+		if err := sleep(ctx, pause); err != nil {
+			return fmt.Errorf("create %s %s: wait to send a refused create again: %w", resource, name, err)
+		}
+	}
+}
+
+// createOnce is one attempt of create. It returns the Status of a 409 Conflict
+// as well, empty for a 409 without one.
+func (cli *client) createOnce(ctx context.Context, url string, body []byte) (apiStatus, error) {
+	resp, err := cli.do(ctx, http.MethodPost, url, "application/json", body)
+	if err != nil {
+		return apiStatus{}, err
+	}
+	defer closeResp(resp)
+	var status apiStatus
+	if resp.StatusCode == http.StatusConflict {
+		// send read the body: reading it here leaves it for checkHTTPErr.
+		data, err := io.ReadAll(resp.Body)
+		if err != nil {
+			return apiStatus{}, fmt.Errorf("read response body: %w", err)
+		}
+		resp.Body = io.NopCloser(bytes.NewReader(data))
+		status, _ = parseStatus(data)
+	}
+	return status, checkHTTPErr(resp, http.StatusCreated)
+}
+
+// createOutcome is what the object of a create that got 409 Conflict tells.
+type createOutcome int
+
+const (
+	// createUnknown: the object could not be read.
+	createUnknown createOutcome = iota
+	// createdHere: the object carries the create ID of the create.
+	createdHere
+	// createdElsewhere: the object is someone else's.
+	createdElsewhere
+	// notCreated: the object does not exist.
+	notCreated
+)
+
+// createdBy reads the object name of resource and tells whether the create
+// with createID that got 409 Conflict had created it.
+func (cli *client) createdBy(ctx context.Context, resource, name, createID string) createOutcome {
+	if name == "" {
+		return createUnknown
+	}
+	var object struct {
+		k8sapi.ObjectMeta `json:"metadata"`
+	}
+	switch err := cli.get(ctx, resource, name, &object); {
+	case errors.Is(err, storage.ErrNotFound):
+		return notCreated
+	case err != nil:
+		return createUnknown
+	case object.Annotations[createIDAnnotation] == createID:
+		return createdHere
+	default:
+		return createdElsewhere
+	}
+}
+
+// Describe and Collect export the metrics of the requests to the Kubernetes API
+// (Deckhouse): Dex registers a storage that is a prometheus.Collector.
+func (cli *client) Describe(ch chan<- *prometheus.Desc) {
+	if cli.requests == nil {
+		return
+	}
+	for _, c := range cli.requests.collectors() {
+		c.Describe(ch)
+	}
+}
+
+func (cli *client) Collect(ch chan<- prometheus.Metric) {
+	if cli.requests == nil {
+		return
+	}
+	for _, c := range cli.requests.collectors() {
+		c.Collect(ch)
+	}
+}
