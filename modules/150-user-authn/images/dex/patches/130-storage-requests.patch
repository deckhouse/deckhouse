+func TestRetryPause(t *testing.T) {
+	l := newRequestLimiter(1)
+	tests := []struct {
+		name       string
+		attempt    int
+		retryAfter string
+		min, max   time.Duration
+	}{
+		{name: "Retry-After", retryAfter: "2", min: 2 * time.Second, max: 3 * time.Second},
+		{name: "first backoff", min: 50 * time.Millisecond, max: 100 * time.Millisecond},
+		{name: "third backoff", attempt: 2, min: 200 * time.Millisecond, max: 400 * time.Millisecond},
+		{name: "capped backoff", attempt: 40, min: time.Second, max: 2 * time.Second},
+		{name: "zero Retry-After", retryAfter: "0", min: 50 * time.Millisecond, max: 100 * time.Millisecond},
+		{name: "HTTP date Retry-After", retryAfter: "Wed, 21 Oct 2015 07:28:00 GMT", min: 50 * time.Millisecond, max: 100 * time.Millisecond},
+		{name: "negative Retry-After", retryAfter: "-5", min: 50 * time.Millisecond, max: 100 * time.Millisecond},
+		{name: "huge Retry-After", retryAfter: "9999999999999", min: time.Hour, max: 90 * time.Minute},
+		{name: "Retry-After past int64", retryAfter: "99999999999999999999", min: 50 * time.Millisecond, max: 100 * time.Millisecond},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			for range 100 {
+				pause := l.retryPause(tt.attempt, tt.retryAfter)
+				require.GreaterOrEqual(t, pause, tt.min)
+				require.LessOrEqual(t, pause, tt.max)
+			}
+		})
+	}
+}
+
+// blocking holds every request until released, and records how many it held
+// at once at most.
+type blocking struct {
+	release  chan struct{}
+	held     atomic.Int32
+	maxHeld  atomic.Int32
+	received atomic.Int32
+}
+
+func (h *blocking) ServeHTTP(w http.ResponseWriter, _ *http.Request) {
+	n := h.held.Add(1)
+	h.received.Add(1)
+	for {
+		m := h.maxHeld.Load()
+		if n <= m || h.maxHeld.CompareAndSwap(m, n) {
+			break
+		}
+	}
+	<-h.release
+	h.held.Add(-1)
+	w.Write([]byte(`{}`))
+}
