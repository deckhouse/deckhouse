+// A create the ResourceQuota admission refused with 409 Conflict was not
+// stored and is sent again, with the same body, within the budget of the call.
+func TestCreateRefusedBeforeItWasStored(t *testing.T) {
+	req := storage.AuthRequest{ID: "req", ClientID: "app", State: "s", Nonce: "n"}
+
+	t.Run("sent again", func(t *testing.T) {
+		api := &schemaAPI{objects: map[string][]byte{}}
+		h := &refusing{refuse: 2, body: quotaConflict, next: api}
+		cli := newRequestsClient(t, h, 4, time.Millisecond, 5*time.Second)
+
+		require.NoError(t, cli.CreateAuthRequest(t.Context(), req))
+		got, err := cli.GetAuthRequest(t.Context(), "req")
+		require.NoError(t, err)
+		require.Equal(t, "s", got.State)
+
+		posts, gets := h.counts()
+		require.Equal(t, 3, posts)
+		require.Equal(t, 1, gets, "a refusal reads no object, only GetAuthRequest does")
+		require.Equal(t, h.posts[0], h.posts[2], "every attempt sends the same create ID")
+		require.InDelta(t, 2, testutil.ToFloat64(cli.requests.refused.WithLabelValues("retried")), 0)
+	})
+
+	t.Run("past the budget", func(t *testing.T) {
+		h := &refusing{refuse: -1, body: quotaConflict, next: okHandler(http.StatusCreated)}
+		cli := newRequestsClient(t, h, 4, time.Millisecond, 100*time.Millisecond)
+
+		start := time.Now()
+		err := cli.CreateAuthRequest(t.Context(), req)
+		require.Error(t, err)
+		require.NotErrorIs(t, err, storage.ErrAlreadyExists, "the object was never stored")
+		require.True(t, isKubernetesAPIConflictError(err))
+		require.Less(t, time.Since(start), time.Second)
+		require.InDelta(t, 1, testutil.ToFloat64(cli.requests.refused.WithLabelValues("failed")), 0)
+	})
+
+	t.Run("without a limiter", func(t *testing.T) {
+		h := &refusing{refuse: 1, body: quotaConflict, next: okHandler(http.StatusCreated)}
+		cli := newRequestsClient(t, h, 4, time.Millisecond, time.Second)
+		cli.requests = nil
+
+		err := cli.CreateAuthRequest(t.Context(), req)
+		require.True(t, isKubernetesAPIConflictError(err))
+		posts, _ := h.counts()
+		require.Equal(t, 1, posts)
+	})
+}
