+// replayingAPI sends every create to api twice and answers with the second
+// response, as when a transport sends a create again whose first answer was
+// lost.
+type replayingAPI struct{ api *schemaAPI }
+
+func (h replayingAPI) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		h.api.ServeHTTP(w, r)
+		return
+	}
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	for _, rw := range []http.ResponseWriter{httptest.NewRecorder(), w} {
+		r.Body = io.NopCloser(bytes.NewReader(body))
+		h.api.ServeHTTP(rw, r)
+	}
+}
