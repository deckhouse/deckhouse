+func TestRequestLimiterUnderLoad(t *testing.T) {
+	h := &blocking{release: make(chan struct{})}
+	cli := newRequestsClient(t, h, 2, time.Millisecond, time.Second)
+
+	const requests = 10
+	errs := make(chan error, requests)
+	get := func(ctx context.Context) {
+		var got map[string]any
+		errs <- cli.get(ctx, resourceAuthRequest, "req", &got)
+	}
+	for range requests - 1 {
+		go get(t.Context())
+	}
+	require.Eventually(t, func() bool {
+		return h.received.Load() == 2 && testutil.ToFloat64(cli.requests.waiting) == requests-3
+	}, 5*time.Second, time.Millisecond)
+	require.InDelta(t, 2, testutil.ToFloat64(cli.requests.inFlight), 0)
+
+	// A request waiting for a slot gives up when its context ends.
+	canceled, cancel := context.WithCancel(t.Context())
+	go get(canceled)
+	require.Eventually(t, func() bool {
+		return testutil.ToFloat64(cli.requests.waiting) == requests-2
+	}, 5*time.Second, time.Millisecond)
+	cancel()
+	require.Eventually(t, func() bool {
+		return testutil.ToFloat64(cli.requests.rejected) == 1 && testutil.ToFloat64(cli.requests.waiting) == requests-3
+	}, 5*time.Second, time.Millisecond)
+	require.Equal(t, int32(2), h.received.Load())
+
+	close(h.release)
+	var failed []error
+	for range requests {
+		if err := <-errs; err != nil {
+			failed = append(failed, err)
+		}
+	}
+	require.Len(t, failed, 1)
+	require.ErrorIs(t, failed[0], errNoSlot)
+	require.ErrorIs(t, failed[0], context.Canceled)
+	require.Equal(t, int32(2), h.maxHeld.Load())
+	require.Equal(t, int32(requests-1), h.received.Load())
+	require.Zero(t, testutil.ToFloat64(cli.requests.waiting))
+	require.Zero(t, testutil.ToFloat64(cli.requests.inFlight))
+}
+
+// The wait for a slot counts in the budget of the call.
+func TestRequestLimiterWaitWithinTheBudget(t *testing.T) {
+	cli := newRequestsClient(t, okHandler(http.StatusOK), 1, time.Millisecond, 50*time.Millisecond)
+	release, err := cli.requests.acquire(t.Context())
+	require.NoError(t, err)
+	defer release()
+
+	start := time.Now()
+	var got map[string]any
+	err = cli.get(t.Context(), resourceAuthRequest, "req", &got)
+	require.ErrorIs(t, err, errNoSlot)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Less(t, time.Since(start), 500*time.Millisecond)
+	require.InDelta(t, 1, testutil.ToFloat64(cli.requests.rejected), 0)
