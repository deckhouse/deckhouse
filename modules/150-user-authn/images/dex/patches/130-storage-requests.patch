+}
+
+func TestDoGivesUpOnceTheBudgetRunsOut(t *testing.T) {
+	tests := []struct {
+		name       string
+		retryAfter string
+		requests   int
+	}{
+		// 10 ms, 20 ms, 40 ms, each half random, and 10 ms left for the attempt
+		// after each: the budget of 50 ms ends after one to three pauses.
+		{name: "without Retry-After", requests: -1},
+		// A pause longer than the budget is not waited for.
+		{name: "Retry-After past the budget", retryAfter: "1", requests: 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			h := &throttling{throttled: -1, retryAfter: tt.retryAfter, next: okHandler(http.StatusOK)}
+			cli := newRequestsClient(t, h, 4, 10*time.Millisecond, 50*time.Millisecond)
+
+			start := time.Now()
+			var got map[string]any
+			err := cli.get(t.Context(), resourceAuthRequest, "req", &got)
+			var herr httpError
+			require.ErrorAs(t, err, &herr)
+			require.Equal(t, http.StatusTooManyRequests, herr.StatusCode())
+			require.Less(t, time.Since(start), 500*time.Millisecond)
