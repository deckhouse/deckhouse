+			return w, true
+		case staticClientsStorage:
+			s = w.Storage
+		case staticPasswordsStorage:
+			s = w.Storage
+		case staticConnectorsStorage:
+			s = w.Storage
+		default:
+			return nil, false
+		}
+	}
+}
