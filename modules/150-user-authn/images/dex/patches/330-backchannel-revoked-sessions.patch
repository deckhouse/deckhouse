+	"github.com/dexidp/dex/server/signer"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// TestNotifyRevoked: the relying parties of a browser session another component
+// ended get its logout token once, over every pass and replica; the sessions dex
+// ended itself and those ended too long ago get none.
+func TestNotifyRevoked(t *testing.T) {
+	ctx := t.Context()
+	logger := slog.New(slog.DiscardHandler)
+	s := memory.New(logger)
+	now := time.Date(2026, 10, 19, 12, 0, 0, 0, time.UTC)
+
+	for _, c := range []storage.Client{
+		{
+			ID: "web", Secret: "secret",
+			RedirectURIs:         []string{"https://web.example.com/callback"},
+			BackchannelLogoutURI: "https://web.example.com/backchannel-logout",
+		},
+		{ID: "kubectl", Secret: "secret", RedirectURIs: []string{"http://localhost:8000"}},
+	} {
+		require.NoError(t, s.CreateClient(ctx, c))
+	}
+
+	creator, ok := storage.AsRevocationCreator(s)
+	require.True(t, ok)
+	for _, r := range []storage.Revocation{
+		{SessionID: "ended-by-controller", Clients: []string{"kubectl", "web"}, Source: "user-authn-controller", CreatedAt: now.Add(-time.Minute)},
+		{SessionID: "ended-by-dex", Clients: []string{"web"}, Source: "dex", CreatedAt: now.Add(-time.Minute), Claimed: true},
+		{SessionID: "ended-by-earlier-dex", Clients: []string{"web"}, Source: "dex", CreatedAt: now.Add(-time.Minute)},
+		{SessionID: "ended-long-ago", Clients: []string{"web"}, Source: "user-authn-controller", CreatedAt: now.Add(-2 * time.Hour)},
+	} {
+		r.Type = storage.RevocationSession
+		r.UserID, r.ConnectorID = "jane", "local"
+		require.NoError(t, creator.CreateRevocation(ctx, r))
+	}
+	claimer, ok := storage.AsRevocationClaimer(s)
+	require.True(t, ok)
+
+	sign, err := (&signer.MockConfig{}).Open(ctx)
+	require.NoError(t, err)
+	issuer, err := url.Parse("https://dex.example.com")
+	require.NoError(t, err)
+	rp := &recordingRP{}
+	n := &Notifier{
+		Storage:    s,
+		Signer:     sign,
+		IssuerURL:  oauth2.IssuerURL{URL: *issuer},
+		Logger:     logger,
+		Now:        func() time.Time { return now },
+		HTTPClient: &http.Client{Transport: rp},
+	}
+
+	require.NoError(t, n.NotifyRevoked(ctx, claimer))
+	// Delivery is fire-and-forget, so the call returns before the POST lands.
+	require.Eventually(t, func() bool { return len(rp.got()) == 1 }, 2*time.Second, 10*time.Millisecond)
+
+	pending, err := claimer.PendingSessionRevocations(ctx)
+	require.NoError(t, err)
+	require.Empty(t, pending, "every revocation is claimed")
+	require.NoError(t, n.NotifyRevoked(ctx, claimer))
+	require.Never(t, func() bool { return len(rp.got()) > 1 }, 200*time.Millisecond, 10*time.Millisecond)
+
+	is := assert.New(t)
+	delivered := rp.got()[0]
+	is.Equal("https://web.example.com/backchannel-logout", delivered.uri)
+	claims := logoutTokenPayload(t, delivered.token)
+	is.Equal("ended-by-controller", claims.SessionID)
+	is.Equal("web", claims.Audience)
+	is.Equal("CgRqYW5lEgVsb2NhbA", claims.Subject)
+	is.Equal("https://dex.example.com", claims.Issuer)
+	is.Contains(claims.Events, backchannelLogoutEvent)
+}
+
+// recordingRP answers every logout token 200 and keeps it.
+type recordingRP struct {
+	mu         sync.Mutex
+	deliveries []delivery
+}
+
+type delivery struct {
+	uri   string
+	token string
+}
+
+func (rp *recordingRP) RoundTrip(r *http.Request) (*http.Response, error) {
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		return nil, err
+	}
+	form, err := url.ParseQuery(string(body))
+	if err != nil {
+		return nil, err
+	}
+	rp.mu.Lock()
+	rp.deliveries = append(rp.deliveries, delivery{uri: r.URL.String(), token: form.Get("logout_token")})
+	rp.mu.Unlock()
+	return &http.Response{StatusCode: http.StatusOK, Body: http.NoBody, Request: r}, nil
+}
+
+func (rp *recordingRP) got() []delivery {
+	rp.mu.Lock()
+	defer rp.mu.Unlock()
+	return append([]delivery(nil), rp.deliveries...)
+}
+
+// logoutTokenPayload decodes the claims of a signed logout token, unverified.
+func logoutTokenPayload(t *testing.T, token string) logoutTokenClaims {
+	t.Helper()
+	parts := strings.Split(token, ".")
+	require.Len(t, parts, 3)
+	raw, err := base64.RawURLEncoding.DecodeString(parts[1])
+	require.NoError(t, err)
+	var claims logoutTokenClaims
+	require.NoError(t, json.Unmarshal(raw, &claims))
+	return claims
+}
