+// revocationAPI serves Revocation objects as the API server does for
+// TestClaimRevocation: it selects by the labels of PendingSessionRevocations and
+// refuses the write of an object whose resourceVersion is not the stored one.
+type revocationAPI struct {
+	mu      sync.Mutex
+	objects map[string]Revocation
+	// afterGet changes an object after it is read, as another writer would.
+	afterGet func(*Revocation)
+}
+
+func (f *revocationAPI) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+
+	const collection = "/apis/dex.coreos.com/v1/namespaces/dex/revocations"
+	name := strings.TrimPrefix(strings.TrimPrefix(r.URL.Path, collection), "/")
+	switch {
+	case r.Method == http.MethodGet && name == "":
+		list := RevocationList{Revocations: []Revocation{}}
+		for _, obj := range f.objects {
+			if selects(r.URL.Query().Get("labelSelector"), obj.Labels) {
+				list.Revocations = append(list.Revocations, obj)
+			}
+		}
+		_ = json.NewEncoder(w).Encode(list)
+	case r.Method == http.MethodGet:
+		obj, ok := f.objects[name]
+		if !ok {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(obj)
+		if f.afterGet != nil {
+			f.afterGet(&obj)
+			f.objects[name] = obj
+		}
+	case r.Method == http.MethodPost:
+		var obj Revocation
+		if err := json.NewDecoder(r.Body).Decode(&obj); err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		obj.ResourceVersion = "1"
+		f.objects[obj.Name] = obj
+		w.WriteHeader(http.StatusCreated)
+	case r.Method == http.MethodPut:
+		var obj Revocation
+		if err := json.NewDecoder(r.Body).Decode(&obj); err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		stored, ok := f.objects[name]
+		if !ok {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		if obj.ResourceVersion != stored.ResourceVersion {
+			w.WriteHeader(http.StatusConflict)
+			return
+		}
+		obj.ResourceVersion += "1"
+		f.objects[name] = obj
+		_ = json.NewEncoder(w).Encode(obj)
+	default:
+		w.WriteHeader(http.StatusMethodNotAllowed)
+	}
+}
+
+// selects reports whether labels match selector, of terms "key=value" and "!key".
+func selects(selector string, labels map[string]string) bool {
+	for term := range strings.SplitSeq(selector, ",") {
+		if key, absent := strings.CutPrefix(term, "!"); absent {
+			if _, ok := labels[key]; ok {
+				return false
+			}
+			continue
+		}
+		key, value, _ := strings.Cut(term, "=")
+		if labels[key] != value {
+			return false
+		}
+	}
+	return true
+}
