+// PendingSessionRevocations lists the revocations of browser sessions not claimed yet,
+// oldest first; the handle is the session ID (Deckhouse).
+func (s *memStorage) PendingSessionRevocations(ctx context.Context) (pending []storage.PendingRevocation, err error) {
+	s.tx(func() {
+		for key, r := range s.revocations {
+			if key.typ == storage.RevocationSession && !r.Claimed {
+				pending = append(pending, storage.PendingRevocation{Revocation: r, Handle: key.sessionID})
+			}
+		}
+	})
+	slices.SortStableFunc(pending, func(a, b storage.PendingRevocation) int {
+		return a.CreatedAt.Compare(b.CreatedAt)
+	})
+	return
+}
+
+// ClaimRevocation claims the session revocation handle; a revocation claimed before or
+// gone is not claimed again (Deckhouse).
+func (s *memStorage) ClaimRevocation(ctx context.Context, handle string) (ok bool, err error) {
+	s.tx(func() {
+		for key, r := range s.revocations {
+			if key.typ == storage.RevocationSession && key.sessionID == handle && !r.Claimed {
+				r.Claimed = true
+				s.revocations[key] = r
+				ok = true
+				return
+			}
+		}
+	})
+	return
+}
