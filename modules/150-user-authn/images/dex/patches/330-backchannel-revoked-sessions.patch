@@ -0,0 +1,52 @@
+package backchannel
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/dexidp/dex/server/revocation"
+	"github.com/dexidp/dex/storage"
+)
+
+// revokedMaxAge bounds how late dex sends the back-channel logout of a session
+// another component ended (Deckhouse). An older revocation is claimed without a
+// logout: dex was down while it was written, and by now the relying party has
+// most likely checked the session on its own.
+const revokedMaxAge = time.Hour
+
+// NotifyRevoked sends the back-channel logout of the browser sessions others ended
+// and recorded as revocations: user-authn-controller for a UserOperation, a
+// sign-out through user-api, a deleted user (Deckhouse). Each revocation is
+// claimed first, so of all replicas of dex one sends it, once. The revocations dex
+// records itself are created claimed; those of an earlier version of dex are
+// claimed here without a logout, it was sent then.
+//
+// The caller runs it periodically. Delivery itself is as best-effort as Notify's.
+func (n *Notifier) NotifyRevoked(ctx context.Context, claimer storage.RevocationClaimer) error {
+	pending, err := claimer.PendingSessionRevocations(ctx)
+	if err != nil {
+		return fmt.Errorf("list session revocations: %w", err)
+	}
+
+	now := n.now()
+	var errs []error
+	for _, p := range pending {
+		ok, err := claimer.ClaimRevocation(ctx, p.Handle)
+		if err != nil {
+			errs = append(errs, err)
+			continue
+		}
+		if !ok || p.Source == revocation.SourceDex {
+			continue
+		}
+		if now.Sub(p.CreatedAt) > revokedMaxAge {
+			n.Logger.DebugContext(ctx, "logout: backchannel skipped, session revoked too long ago",
+				"session_id", p.SessionID, "created_at", p.CreatedAt)
+			continue
+		}
+		n.notify(ctx, p.UserID, p.ConnectorID, p.SessionID, p.Clients)
+	}
+	return errors.Join(errs...)
+}
