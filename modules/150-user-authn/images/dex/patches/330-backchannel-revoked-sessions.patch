+// PendingSessionRevocations lists the Revocation objects of browser sessions without
+// the claimed label, oldest first (Deckhouse). The handle is the object name.
+// Every replica lists every few seconds, so the list is served from the cache of
+// the API server (resourceVersion=0); ClaimRevocation reads the object afresh.
+func (cli *client) PendingSessionRevocations(ctx context.Context) ([]storage.PendingRevocation, error) {
+	params := url.Values{}
+	params.Set("labelSelector", revocationTypeLabel+"="+string(storage.RevocationSession)+",!"+revocationClaimedLabel)
+	params.Set("resourceVersion", "0")
+	u, err := cli.urlForWithParams(cli.apiVersion, cli.namespace, resourceRevocation, "", params)
+	if err != nil {
+		return nil, err
+	}
+	var list RevocationList
+	if err := cli.getURL(u, &list); err != nil {
+		return nil, fmt.Errorf("list revocations: %w", err)
+	}
+	pending := make([]storage.PendingRevocation, 0, len(list.Revocations))
+	for _, r := range list.Revocations {
+		pending = append(pending, storage.PendingRevocation{Revocation: toStorageRevocation(r), Handle: r.Name})
+	}
+	slices.SortStableFunc(pending, func(a, b storage.PendingRevocation) int {
+		return a.CreatedAt.Compare(b.CreatedAt)
+	})
+	return pending, nil
+}
+
+// ClaimRevocation sets the claimed label on the Revocation object handle (Deckhouse).
+// The write carries the resourceVersion that was read: of two replicas claiming at
+// once, one gets a conflict and leaves the revocation to the other.
+func (cli *client) ClaimRevocation(ctx context.Context, handle string) (bool, error) {
+	var r Revocation
+	err := cli.get(resourceRevocation, handle, &r)
+	if errors.Is(err, storage.ErrNotFound) {
+		return false, nil
+	}
+	if err != nil {
+		return false, fmt.Errorf("get revocation %s: %w", handle, err)
+	}
+	if _, claimed := r.Labels[revocationClaimedLabel]; claimed {
+		return false, nil
+	}
+	if r.Labels == nil {
+		r.Labels = map[string]string{}
+	}
+	r.Labels[revocationClaimedLabel] = "true"
+	err = cli.put(resourceRevocation, handle, r)
+	if errors.Is(err, storage.ErrNotFound) || isKubernetesAPIConflictError(err) {
+		return false, nil
+	}
+	if err != nil {
+		return false, fmt.Errorf("claim revocation %s: %w", handle, err)
+	}
+	return true, nil
+}
