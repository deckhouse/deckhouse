+func TestRefreshWithUnopenedConnector(t *testing.T) {
+	httpServer, s := newTestServer(t, nil)
+	defer httpServer.Close()
+	mockRefreshTokenTestStorage(t, s.storage, false)
+	ctx := t.Context()
+	tokenData, err := internal.Marshal(&internal.RefreshToken{RefreshId: "test", Token: "bar"})
+	require.NoError(t, err)
+
+	refresh := func() *httptest.ResponseRecorder {
+		form := url.Values{"grant_type": {"refresh_token"}, "refresh_token": {tokenData}}
+		req := httptest.NewRequest(http.MethodPost, "/token", strings.NewReader(form.Encode()))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		req.SetBasicAuth("test", "barfoo")
+		rr := httptest.NewRecorder()
+		s.ServeHTTP(rr, req)
+		return rr
+	}
+
+	require.NoError(t, s.storage.UpdateConnector(ctx, "test", func(c storage.Connector) (storage.Connector, error) {
+		c.Type = "unknown"
+		return c, nil
+	}))
+	s.connectors.Close("test")
+	requireOAuth2Error(t, refresh(), http.StatusServiceUnavailable, "temporarily_unavailable")
+	_, err = s.storage.GetRefresh(ctx, "test")
+	require.NoError(t, err)
+
+	require.NoError(t, s.storage.DeleteConnector(ctx, "test"))
+	requireOAuth2Error(t, refresh(), http.StatusBadRequest, "invalid_request")
+}
