+++ b/server/connector_open_test.go
@@ -0,0 +1,94 @@
+package server
+
+import (
+	"bytes"
+	"context"
+	"log/slog"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	gosundheit "github.com/AppsFlyer/go-sundheit"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/signer"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// TestOpenConnectorsSkipsSilentIssuer: an OIDC issuer that accepts connections and
+// never answers no longer holds the startup. Its discovery hits the deadline, the
+// connector is skipped with DEX_CONTINUE_ON_CONNECTOR_FAILURE, the next connector
+// opens, and every attempt is logged before it starts.
+func TestOpenConnectorsSkipsSilentIssuer(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	var mu sync.Mutex
+	var held []net.Conn
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			held = append(held, c)
+			mu.Unlock()
+		}
+	}()
+	t.Cleanup(func() {
+		ln.Close()
+		mu.Lock()
+		defer mu.Unlock()
+		for _, c := range held {
+			c.Close()
+		}
+	})
+
+	var logs bytes.Buffer
+	logger := slog.New(slog.NewTextHandler(&logs, &slog.HandlerOptions{Level: slog.LevelInfo}))
+	sig, err := signer.NewMockSigner(testKey)
+	require.NoError(t, err)
+
+	ctx := context.Background()
+	config := Config{
+		Issuer:                     "http://localhost",
+		Storage:                    memory.New(logger),
+		Web:                        WebConfig{Dir: "../web"},
+		Logger:                     logger,
+		PrometheusRegistry:         prometheus.NewRegistry(),
+		HealthChecker:              gosundheit.New(),
+		ContinueOnConnectorFailure: true,
+		Signer:                     sig,
+	}
+	for _, conn := range []storage.Connector{
+		{
+			ID:     "silent",
+			Type:   "oidc",
+			Name:   "Silent issuer",
+			Config: []byte(`{"issuer": "http://` + ln.Addr().String() + `", "discoveryTimeout": "200ms"}`),
+		},
+		{ID: "mock", Type: "mockCallback", Name: "Mock"},
+	} {
+		require.NoError(t, config.Storage.CreateConnector(ctx, conn))
+	}
+
+	start := time.Now()
+	server, err := newServer(ctx, config)
+	require.NoError(t, err)
+	require.Less(t, time.Since(start), 5*time.Second, "the silent issuer must not hold the startup")
+
+	_, ok := server.connectors.Cached("mock")
+	require.True(t, ok, "the next connector must open")
+	_, ok = server.connectors.Cached("silent")
+	require.False(t, ok, "the silent connector must be skipped")
+
+	out := logs.String()
+	require.Contains(t, out, `msg="opening connector" connector_id=silent connector_type=oidc`)
+	require.Contains(t, out, `msg="opening connector" connector_id=mock connector_type=mockCallback`)
+	require.Contains(t, out, `msg="server: Failed to open connector" id=silent`)
+	require.True(t, strings.Contains(out, "did not answer within 200ms"), out)
+}
