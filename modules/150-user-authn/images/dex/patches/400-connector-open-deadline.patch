@@ -0,0 +1,85 @@
+package oidc
+
+import (
+	"log/slog"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// silentIssuer accepts TCP connections and never answers them: the issuer that
+// held the startup of Dex before the discovery request got a deadline.
+func silentIssuer(t *testing.T) string {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+
+	var mu sync.Mutex
+	var conns []net.Conn
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			conns = append(conns, c)
+			mu.Unlock()
+		}
+	}()
+	t.Cleanup(func() {
+		ln.Close()
+		mu.Lock()
+		defer mu.Unlock()
+		for _, c := range conns {
+			c.Close()
+		}
+	})
+	return "http://" + ln.Addr().String()
+}
+
+func TestOpenBoundsProviderDiscovery(t *testing.T) {
+	issuer := silentIssuer(t)
+	c := Config{Issuer: issuer, DiscoveryTimeout: "200ms"}
+
+	start := time.Now()
+	_, err := c.Open("silent", slog.New(slog.DiscardHandler))
+	elapsed := time.Since(start)
+
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "provider discovery at "+issuer+" did not answer within 200ms")
+	require.Less(t, elapsed, 5*time.Second, "Open must return once the discovery deadline passes")
+}
+
+func TestDiscoveryTimeout(t *testing.T) {
+	for _, tc := range []struct {
+		value   string
+		want    time.Duration
+		wantErr bool
+	}{
+		{"", 10 * time.Second, false},
+		{"3s", 3 * time.Second, false},
+		{"1m30s", 90 * time.Second, false},
+		{"0s", 0, true},
+		{"-1s", 0, true},
+		{"10", 0, true},
+	} {
+		got, err := (&Config{DiscoveryTimeout: tc.value}).discoveryTimeout()
+		if tc.wantErr {
+			require.Error(t, err, tc.value)
+			require.True(t, strings.Contains(err.Error(), "invalid discoveryTimeout"), err.Error())
+			continue
+		}
+		require.NoError(t, err, tc.value)
+		require.Equal(t, tc.want, got, tc.value)
+	}
+}
+
+func TestOpenRejectsInvalidDiscoveryTimeout(t *testing.T) {
+	_, err := (&Config{Issuer: "http://127.0.0.1:1", DiscoveryTimeout: "soon"}).Open("bad", slog.New(slog.DiscardHandler))
+	require.ErrorContains(t, err, `invalid discoveryTimeout "soon"`)
+}
