+++ b/server/connector_open_test.go
@@ -0,0 +1,184 @@
+package server
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	gosundheit "github.com/AppsFlyer/go-sundheit"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/signer"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// TestOpenConnectorsSkipsSilentIssuer: an OIDC issuer that accepts connections and
+// never answers no longer holds the startup. Its discovery hits the deadline, the
+// connector is skipped with DEX_CONTINUE_ON_CONNECTOR_FAILURE, the next connector
+// opens, and every attempt is logged before it starts.
+func TestOpenConnectorsSkipsSilentIssuer(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	var mu sync.Mutex
+	var held []net.Conn
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			held = append(held, c)
+			mu.Unlock()
+		}
+	}()
+	t.Cleanup(func() {
+		ln.Close()
+		mu.Lock()
+		defer mu.Unlock()
+		for _, c := range held {
+			c.Close()
+		}
+	})
+
+	var logs bytes.Buffer
+	logger := slog.New(slog.NewTextHandler(&logs, &slog.HandlerOptions{Level: slog.LevelInfo}))
+	sig, err := signer.NewMockSigner(testKey)
+	require.NoError(t, err)
+
+	ctx := context.Background()
+	config := Config{
+		Issuer:                     "http://localhost",
+		Storage:                    memory.New(logger),
+		Web:                        WebConfig{Dir: "../web"},
+		Logger:                     logger,
+		PrometheusRegistry:         prometheus.NewRegistry(),
+		HealthChecker:              gosundheit.New(),
+		ContinueOnConnectorFailure: true,
+		Signer:                     sig,
+	}
+	for _, conn := range []storage.Connector{
+		{
+			ID:     "silent",
+			Type:   "oidc",
+			Name:   "Silent issuer",
+			Config: []byte(`{"issuer": "http://` + ln.Addr().String() + `", "discoveryTimeout": "200ms"}`),
+		},
+		{ID: "mock", Type: "mockCallback", Name: "Mock"},
+	} {
+		require.NoError(t, config.Storage.CreateConnector(ctx, conn))
+	}
+
+	start := time.Now()
+	server, err := newServer(ctx, config)
+	require.NoError(t, err)
+	require.Less(t, time.Since(start), 5*time.Second, "the silent issuer must not hold the startup")
+
+	_, ok := server.connectors.Cached("mock")
+	require.True(t, ok, "the next connector must open")
+	_, ok = server.connectors.Cached("silent")
+	require.False(t, ok, "the silent connector must be skipped")
+
+	out := logs.String()
+	require.Contains(t, out, `msg="opening connector" connector_id=silent connector_type=oidc`)
+	require.Contains(t, out, `msg="opening connector" connector_id=mock connector_type=mockCallback`)
+	require.Contains(t, out, `msg="server: Failed to open connector" id=silent`)
+	require.True(t, strings.Contains(out, "did not answer within 200ms"), out)
+}
+
+// TestServerStartsWithoutOpenConnectors: the only connector is an OIDC provider
+// that is down at startup. With DEX_CONTINUE_ON_CONNECTOR_FAILURE Dex starts
+// instead of exiting, serves the discovery document and the signing keys, shows
+// the error of the connector on the login page, and opens the connector on the
+// first login after the provider comes up.
+func TestServerStartsWithoutOpenConnectors(t *testing.T) {
+	// An address nothing listens on yet: the provider is down.
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	addr := ln.Addr().String()
+	require.NoError(t, ln.Close())
+	issuer := "http://" + addr
+
+	conn := storage.Connector{
+		ID:     "upstream",
+		Type:   "oidc",
+		Name:   "Upstream",
+		Config: []byte(`{"issuer": "` + issuer + `", "clientID": "dex", "clientSecret": "dh-test-secret-0123456789abcdef", "redirectURI": "http://localhost/callback", "discoveryTimeout": "2s"}`),
+	}
+	var store storage.Storage
+	httpServer, server := newTestServerWith(t, []storage.Connector{conn}, func(c *Config) {
+		c.ContinueOnConnectorFailure = true
+		store = c.Storage
+	})
+	t.Cleanup(httpServer.Close)
+
+	_, ok := server.connectors.Cached("upstream")
+	require.False(t, ok, "the connector of the provider that is down must not be open")
+
+	for _, path := range []string{"/.well-known/openid-configuration", "/keys"} {
+		resp, err := http.Get(httpServer.URL + path)
+		require.NoError(t, err, path)
+		resp.Body.Close()
+		require.Equal(t, http.StatusOK, resp.StatusCode, path)
+	}
+
+	ctx := t.Context()
+	require.NoError(t, store.CreateClient(ctx, storage.Client{
+		ID:           "app",
+		Secret:       "dh-test-secret-0123456789abcdef",
+		RedirectURIs: []string{"https://app.example.com/callback"},
+	}))
+	login := httpServer.URL + "/auth/upstream?" + url.Values{
+		"client_id":     {"app"},
+		"redirect_uri":  {"https://app.example.com/callback"},
+		"response_type": {"code"},
+		"scope":         {"openid"},
+		"state":         {"state"},
+	}.Encode()
+	resp, err := http.Get(login)
+	require.NoError(t, err)
+	body, err := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	require.NoError(t, err)
+	require.Equal(t, http.StatusBadRequest, resp.StatusCode, string(body))
+	require.Contains(t, string(body), "Connector failed to initialize")
+
+	// The provider comes up: the next use opens the connector.
+	provider := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{
+  "issuer": "`+issuer+`",
+  "authorization_endpoint": "`+issuer+`/auth",
+  "token_endpoint": "`+issuer+`/token",
+  "jwks_uri": "`+issuer+`/keys",
+  "userinfo_endpoint": "`+issuer+`/userinfo",
+  "id_token_signing_alg_values_supported": ["RS256"]
+}`)
+	}))
+	providerListener, err := net.Listen("tcp", addr)
+	require.NoError(t, err)
+	provider.Listener = providerListener
+	provider.Start()
+	t.Cleanup(provider.Close)
+
+	_, err = server.connectors.Get(ctx, "upstream")
+	require.NoError(t, err)
+	_, ok = server.connectors.Cached("upstream")
+	require.True(t, ok, "the connector must open once the provider answers")
+
+	resp, err = http.Get(login)
+	require.NoError(t, err)
+	resp.Body.Close()
+	require.NotEqual(t, http.StatusBadRequest, resp.StatusCode, "the login must go on to the provider")
+}
