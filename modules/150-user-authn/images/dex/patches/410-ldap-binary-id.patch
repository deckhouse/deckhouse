--- a/connector/ldap/ldap.go
+++ b/connector/ldap/ldap.go
@@ -498,13 +498,43 @@ func (c *ldapConnector) getAttr(e ldap.Entry, name string) string {
 	return ""
 }
 
+// binaryGUIDAttrs are the attributes in which Active Directory keeps a GUID as 16 raw bytes:
+// objectGUID, and mS-DS-ConsistencyGuid, which carries the GUID of the user across directories.
+// They are compared in lower case: LDAP attribute names are case-insensitive.
+var binaryGUIDAttrs = map[string]struct{}{
+	"objectguid":            {},
+	"ms-ds-consistencyguid": {},
+}
+
+// userID returns the user ID from the IDAttr attribute of the entry. A binary GUID of Active
+// Directory becomes its string form: as raw bytes it is usually not valid UTF-8, which the proto3
+// subject of the tokens refuses, and the storage of Dex keeps it as JSON, which replaces the
+// invalid bytes, so the identity and the offline sessions read back no longer match the one the
+// connector returns, and the user cannot sign in. Any other value is returned as it is,
+// and so is a GUID attribute that does not hold 16 bytes (a directory that already returns the
+// string form).
+func (c *ldapConnector) userID(e ldap.Entry) string {
+	id := c.getAttr(e, c.UserSearch.IDAttr)
+	if _, binary := binaryGUIDAttrs[strings.ToLower(c.UserSearch.IDAttr)]; binary && len(id) == 16 {
+		return formatGUID([]byte(id))
+	}
+	return id
+}
+
+// formatGUID returns the string form of a binary GUID of Active Directory, as its tools show it:
+// the first three groups are little-endian, the last two are in byte order.
+func formatGUID(b []byte) string {
+	return fmt.Sprintf("%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+		b[3], b[2], b[1], b[0], b[5], b[4], b[7], b[6], b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15])
+}
+
 func (c *ldapConnector) identityFromEntry(user ldap.Entry) (ident connector.Identity, err error) {
 	// If we're missing any attributes, such as email or ID, we want to report
 	// an error rather than continuing.
 	missing := []string{}
 
 	// Fill the identity struct using the attributes from the user entry.
-	if ident.UserID = c.getAttr(user, c.UserSearch.IDAttr); ident.UserID == "" {
+	if ident.UserID = c.userID(user); ident.UserID == "" {
 		missing = append(missing, c.UserSearch.IDAttr)
 	}
 
