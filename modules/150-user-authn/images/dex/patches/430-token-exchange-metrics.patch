+
+// tokenExchangeCounter is dex_token_exchange_total on the registry, or nil
+// without one (Deckhouse). An alert of the platform reads it to find the
+// exchanges that still go through a sign-in provider.
+//
+// The success series of every connector that is not a token-exchange
+// connector starts at zero: a series born at its first exchange starts at 1,
+// and increase() over it misses that exchange. These are the connectors of the
+// config file, which a change of reaches Dex by a restart. increase() sees the
+// first exchange once Prometheus has scraped the zero: an exchange between the
+// start of a pod and its first scrape is still missed.
+func tokenExchangeCounter(registry *prometheus.Registry, s storage.Storage, logger *slog.Logger) *prometheus.CounterVec {
+	if registry == nil {
+		return nil
+	}
+	counter := prometheus.NewCounterVec(prometheus.CounterOpts{
+		Name: "dex_token_exchange_total",
+		Help: "Token exchanges by connector and outcome: success, denied or error.",
+	}, []string{"connector_id", "connector_type", "result"})
+	if err := registry.Register(counter); err != nil {
+		var registered prometheus.AlreadyRegisteredError
+		if errors.As(err, &registered) {
+			if existing, ok := registered.ExistingCollector.(*prometheus.CounterVec); ok {
+				return existing
+			}
+		}
+		logger.Warn("token exchange metric: register, the metric is off", "err", err)
+		return nil
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	conns, err := s.ListConnectors(ctx)
+	if err != nil {
+		logger.Warn("token exchange metric: list connectors to start their series", "err", err)
+		return counter
+	}
+	for _, conn := range conns {
+		if conn.Type != tokenexchange.Type {
+			counter.WithLabelValues(conn.ID, conn.Type, "success").Add(0)
+		}
+	}
+	return counter
+}
