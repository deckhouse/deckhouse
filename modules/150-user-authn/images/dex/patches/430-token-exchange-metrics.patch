+++ b/server/server_grant_tokenexchange_metrics_test.go
@@ -0,0 +1,65 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/client_golang/prometheus/testutil"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector/tokenexchange"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/storage"
+)
+
+// TestTokenExchangeMetrics counts every exchange by connector and outcome.
+func TestTokenExchangeMetrics(t *testing.T) {
+	ctx := t.Context()
+	registry := prometheus.NewRegistry()
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.PrometheusRegistry = registry
+		require.NoError(t, c.Storage.CreateClient(ctx, storage.Client{ID: "ci", Secret: "ci"}))
+		// A token-exchange connector gets no zero series: the alert does not
+		// look at it.
+		require.NoError(t, c.Storage.CreateConnector(ctx, storage.Connector{
+			ID: "tep-ci", Type: tokenexchange.Type, Name: "tep-ci",
+			Config: []byte(`{"issuer":"https://ci.example","keys":{"discovery":{}},"audiences":[{"exact":"dex"}],"identity":{"username":{"claim":"sub"}},"clients":["ci"]}`),
+		}))
+	})
+	defer httpServer.Close()
+
+	exchange := func(subjectTokenType string) {
+		vals := url.Values{}
+		vals.Set("grant_type", oauth2.GrantTypeTokenExchange)
+		vals.Set("connector_id", "mock")
+		vals.Set("scope", "openid")
+		vals.Set("subject_token_type", subjectTokenType)
+		vals.Set("subject_token", "foobar")
+		vals.Set("client_id", "ci")
+		vals.Set("client_secret", "ci")
+		rr := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, httpServer.URL+"/token", strings.NewReader(vals.Encode()))
+		req.Header.Set("content-type", "application/x-www-form-urlencoded")
+		s.ServeHTTP(rr, req)
+	}
+
+	// Registering again hands back the counter the server registered.
+	counter := tokenExchangeCounter(registry, s.storage, s.logger)
+	require.NotNil(t, counter)
+
+	// The success series of a sign-in connector exists at zero before any
+	// exchange, so that increase() sees the first one.
+	require.Equal(t, 1, testutil.CollectAndCount(counter, "dex_token_exchange_total"))
+	require.InDelta(t, 0, testutil.ToFloat64(counter.WithLabelValues("mock", "mockCallback", "success")), 0)
+
+	exchange(oauth2.TokenTypeID)
+	exchange(oauth2.TokenTypeID)
+	exchange("urn:example:unsupported")
+
+	require.InDelta(t, 2, testutil.ToFloat64(counter.WithLabelValues("mock", "mockCallback", "success")), 0)
+	require.InDelta(t, 1, testutil.ToFloat64(counter.WithLabelValues("mock", "mockCallback", "denied")), 0)
+}
