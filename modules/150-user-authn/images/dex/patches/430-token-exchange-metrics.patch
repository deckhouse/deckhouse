+// Authorize serves the exchange and counts its outcome (Deckhouse).
 func (g *tokenExchange) Authorize(ctx context.Context, req *Request, client storage.Client, conn connectors.Connector) (Responder, error) {
+	resp, err := g.authorize(ctx, req, client, conn)
+	g.count(req.ConnectorID, conn.Type, err)
+	return resp, err
+}
+
+// count adds the outcome of an exchange to the exchanges metric: success, denied
+// for a refusal of the request (HTTP 4xx), error for a failure of Dex (HTTP
+// 5xx). A subject token the connector could not verify is denied even when the
+// cause is an issuer that is down: the connector reports both alike.
+func (g *tokenExchange) count(connectorID, connectorType string, err error) {
+	if g.exchanges == nil {
+		return
+	}
+	result := "success"
+	if err != nil {
+		result = "error"
+		var oerr *oauth2.Error
+		if errors.As(err, &oerr) && oerr.Status < http.StatusInternalServerError {
+			result = "denied"
+		}
+	}
+	g.exchanges.WithLabelValues(connectorID, connectorType, result).Inc()
+}
