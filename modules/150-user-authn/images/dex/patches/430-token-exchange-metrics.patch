index 00000000..5fa36049
--- /dev/null
+++ b/server/grants/tokenexchange_metrics_test.go
@@ -0,0 +1,30 @@
+package grants
+
+import (
+	"errors"
+	"net/http"
+	"testing"
+
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/client_golang/prometheus/testutil"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/oauth2"
+)
+
+func TestTokenExchangeCountOutcome(t *testing.T) {
+	counter := prometheus.NewCounterVec(prometheus.CounterOpts{Name: "dex_token_exchange_total"}, []string{"connector_id", "connector_type", "result"})
+	g := &tokenExchange{exchanges: counter}
+
+	g.count("c", "oidc", nil)
+	g.count("c", "oidc", &oauth2.Error{Status: http.StatusUnauthorized})
+	g.count("c", "oidc", &oauth2.Error{Status: http.StatusInternalServerError})
+	g.count("c", "oidc", errors.New("storage is down"))
+
+	require.InDelta(t, 1, testutil.ToFloat64(counter.WithLabelValues("c", "oidc", "success")), 0)
+	require.InDelta(t, 1, testutil.ToFloat64(counter.WithLabelValues("c", "oidc", "denied")), 0)
+	require.InDelta(t, 2, testutil.ToFloat64(counter.WithLabelValues("c", "oidc", "error")), 0)
+
+	// Without a counter nothing is counted and nothing fails.
+	(&tokenExchange{}).count("c", "oidc", nil)
+}
