+// followRedirects serves rr's redirects within dex and returns the first answer
+// that is not one, with the path it answered.
+func followRedirects(t *testing.T, s *Server, rr *httptest.ResponseRecorder) (*httptest.ResponseRecorder, string) {
+	t.Helper()
+	target := ""
+	for range 5 {
+		if rr.Code != http.StatusSeeOther && rr.Code != http.StatusFound {
+			return rr, target
+		}
+		location, err := url.Parse(rr.Header().Get("Location"))
+		require.NoError(t, err)
+		target = location.Path
+		rr = httptest.NewRecorder()
+		s.ServeHTTP(rr, httptest.NewRequest(http.MethodGet, location.RequestURI(), nil))
+	}
+	t.Fatalf("too many redirects, last to %s", target)
+	return nil, ""
+}
+
+// The first login of a user who enrolled TOTP before the update asks for a code
+// of that secret instead of a new enrollment, and stores the identity with it.
+func TestFirstLoginKeepsOldPlaceTOTP(t *testing.T) {
+	ctx := t.Context()
+	const (
+		connID = "mockPw"
+		secret = "otpauth://totp/Deckhouse:(local)%20kilgore@kilgore.trout?issuer=Deckhouse&secret=JBSWY3DPEHPK3PXP"
+	)
+	var store *oldPlaceStorage
+	httpServer, s := newTestServer(t, func(c *Config) {
+		store = &oldPlaceStorage{Storage: c.Storage, old: map[oldPlacePair]storage.UserIdentity{
+			{userID: mockUserID, connectorID: connID}: {
+				UserID: mockUserID, ConnectorID: connID,
+				MFASecrets: map[string]*storage.MFASecret{"totp": {AuthenticatorID: "totp", Type: "TOTP", Secret: secret, Confirmed: true}},
+			},
+		}}
+		c.Storage = store
+		c.MFAProviders = map[string]mfa.Provider{"totp": mfa.NewTOTPProvider("dex", nil)}
+		c.DefaultMFAChain = []string{"totp"}
+	})
+	defer httpServer.Close()
+
+	sc := storage.Connector{
+		ID: connID, Type: "mockPassword", Name: "MockPassword", ResourceVersion: "1",
+		Config: []byte(`{"username": "foo", "password": "password"}`),
+	}
+	require.NoError(t, s.storage.CreateConnector(ctx, sc))
+	_, err := s.connectors.Open(sc)
+	require.NoError(t, err)
+	require.NoError(t, s.storage.CreateClient(ctx, storage.Client{ID: "test", RedirectURIs: []string{"https://client.example/cb"}}))
+	require.NoError(t, s.storage.CreateAuthRequest(ctx, storage.AuthRequest{
+		ID: "old-totp", ClientID: "test", ConnectorID: connID, RedirectURI: "https://client.example/cb",
+		ResponseTypes: []string{oauth2.ResponseTypeCode}, Scopes: []string{"openid"},
+		Expiry: time.Now().Add(time.Hour), HMACKey: []byte("0123456789abcdef0123456789abcdef"),
+	}))
+
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, httptest.NewRequest(http.MethodPost, "/auth/"+connID+"/login?state=old-totp&login=foo&password=password", nil))
+	page, path := followRedirects(t, s, rr)
+
+	require.Equal(t, http.StatusOK, page.Code, page.Body.String())
+	require.Equal(t, "/mfa/totp", path)
+	require.NotContains(t, page.Body.String(), "data:image/png", "a code is asked, no QR code to enroll")
+
+	stored, err := store.Storage.GetUserIdentity(ctx, mockUserID, connID)
+	require.NoError(t, err, "the first login stores the identity")
+	require.Equal(t, "kilgore@kilgore.trout", stored.Claims.Email)
+	require.NotNil(t, stored.MFASecrets["totp"])
+	require.Equal(t, secret, stored.MFASecrets["totp"].Secret)
+	require.True(t, stored.MFASecrets["totp"].Confirmed)
+	require.True(t, stored.LastLogin.IsZero(), "the login is complete only after the code")
+}
diff --git a/server/useridentity/useridentity.go b/server/useridentity/useridentity.go
new file mode 100644
index 00000000..4a372a44
--- /dev/null
+++ b/server/useridentity/useridentity.go
@@ -0,0 +1,242 @@
+// Package useridentity keeps the persistent record of a (user, connector) pair,
+// storage.UserIdentity, for every login, whether browser sessions are enabled or
+// not, and answers whether the pair is blocked.
+//
+// Upstream creates the record only when sessions are enabled. Deckhouse keeps the
+// second factor, the lock and the last login of every user on it, so every login
+// path records it, and the lock is checked by every login (the login form, the
+// connector callbacks, SPNEGO, the password change page, a login from a browser
+// session) and by the password, refresh-token and token-exchange grants. The
+// code and device-code exchanges do not check it again: they finish a login that
+// was checked, and the generation of the pair revokes them (290).
+package useridentity
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"math/rand/v2"
+	"slices"
+	"time"
+
+	"github.com/dexidp/dex/storage"
+)
+
+// BlockedError refuses a login or a token request of a blocked pair.
+type BlockedError struct {
+	Until time.Time
+}
+
+func (e *BlockedError) Error() string {
+	return fmt.Sprintf("account is locked until %s", e.Until.Format(time.RFC3339))
+}
+
+// errUnchanged aborts an update that has nothing to write.
+var errUnchanged = errors.New("useridentity: unchanged")
+
+// lastLoginPrecision is how much older than a login of the password grant the
+// stored LastLogin may stay. UserAccount shows the last login to the minute, and
+// a client may send many such logins a minute for one user (basic-auth-proxy
+// sends one for every request it cannot answer from its cache): writing the
+// identity for each of them makes parallel ones conflict on it.
+const lastLoginPrecision = time.Minute
+
+// A write of the identity that fails is tried identityWriteAttempts times, the
+// second try identityWriteBackoff later with a random share of it on top. The
+// kubernetes storage already retries a conflict with parallel logins of the same
+// user for 0.4 to 0.8 s; the second try here covers the other failures of a
+// write, such as an API request that timed out, and the storages that do not
+// retry a conflict themselves.
+const (
+	identityWriteAttempts = 2
+	identityWriteBackoff  = 10 * time.Millisecond
+)
+
+// Login is a successful first-factor login of a pair.
+type Login struct {
+	ConnectorID string
+	Claims      storage.Claims
+	// Time is when the first factor passed; it becomes the auth time of the login.
+	Time time.Time
+	// Complete reports that no second factor follows, so LastLogin is set now.
+	// Otherwise Completed sets it once the last factor is done.
+	Complete bool
+	// CoarseLastLogin keeps a stored LastLogin younger than lastLoginPrecision
+	// instead of rewriting the identity for this login: the password grant,
+	// which a client may repeat many times a minute and whose auth time is not
+	// taken from LastLogin. A browser login keeps LastLogin exact, as sessions
+	// report it as the auth time.
+	CoarseLastLogin bool
+	// Logger logs a write of the identity given up for the stored one (see
+	// Record). Nil logs nothing.
+	Logger *slog.Logger
+}
+
+// movesLastLogin reports whether a complete login l rewrites the LastLogin
+// stored. LastLogin never moves back.
+func (l Login) movesLastLogin(stored time.Time) bool {
+	if l.CoarseLastLogin {
+		return l.Time.Sub(stored) >= lastLoginPrecision
+	}
+	return stored.Before(l.Time)
+}
+
+// Record records l: it creates the pair's identity or refreshes its claims, and
+// refuses a blocked pair with *BlockedError, writing nothing for it. A login
+// that changes nothing (the same claims, and no LastLogin to move) writes
+// nothing either.
+//
+// An identity that exists but cannot be written after several tries is read
+// instead: the login goes on when it is not blocked, without refreshing the
+// claims or LastLogin, and l.Logger logs the failed write. Only a failed read
+// fails the login.
+func Record(ctx context.Context, s storage.Storage, l Login) error {
+	err := update(ctx, s, l)
+	if !errors.Is(err, storage.ErrNotFound) {
+		return err
+	}
+
+	// The first login of the pair.
+	err = s.CreateUserIdentity(ctx, storage.UserIdentity{
+		UserID:      l.Claims.UserID,
+		ConnectorID: l.ConnectorID,
+		Claims:      l.Claims,
+		Consents:    make(map[string][]string),
+		CreatedAt:   l.Time,
+	})
+	if err != nil && !errors.Is(err, storage.ErrAlreadyExists) {
+		return fmt.Errorf("create user identity: %w", err)
+	}
+
+	// Created meanwhile (by a parallel login or by the user-authn controller), or
+	// created here. The storage may give a new identity state the pair had before
+	// it existed (see storage/kubernetes/transitional.go), a lock included, so the
+	// lock is checked on what was stored, and LastLogin is set only for a login
+	// that is not refused.
+	return update(ctx, s, l)
+}
+
+// update applies l to the stored identity of its pair, trying a failing write
+// again; see Record for a write that keeps failing.
+func update(ctx context.Context, s storage.Storage, l Login) error {
+	updater := func(old storage.UserIdentity) (storage.UserIdentity, error) {
+		if blocked(old, l.Time) {
+			return old, &BlockedError{Until: old.BlockedUntil}
+		}
+		movesLastLogin := l.Complete && l.movesLastLogin(old.LastLogin)
+		if sameClaims(old.Claims, l.Claims) && !movesLastLogin {
+			return old, errUnchanged
+		}
+		old.Claims = l.Claims
+		if movesLastLogin {
+			old.LastLogin = l.Time
+		}
+		return old, nil
+	}
+
+	err := s.UpdateUserIdentity(ctx, l.Claims.UserID, l.ConnectorID, updater)
+	for try := 1; isWriteFailure(err) && try < identityWriteAttempts; try++ {
+		if !wait(ctx, identityWriteBackoff*time.Duration(try)) {
+			break
+		}
+		err = s.UpdateUserIdentity(ctx, l.Claims.UserID, l.ConnectorID, updater)
+	}
+	switch {
+	case err == nil, errors.Is(err, errUnchanged):
+		return nil
+	case !isWriteFailure(err):
+		return err // storage.ErrNotFound or *BlockedError
+	}
+
+	// The identity is there, it could not be written: a login is not refused for
+	// that. The lock is what must hold, and it is read.
+	if rerr := CheckBlocked(ctx, s, l.Claims.UserID, l.ConnectorID, l.Time); rerr != nil {
+		return errors.Join(fmt.Errorf("update user identity: %w", err), rerr)
+	}
+	if l.Logger != nil {
+		l.Logger.WarnContext(ctx, "failed to record the user identity of a login, going on with the stored one",
+			"connector_id", l.ConnectorID, "user_id", l.Claims.UserID, "err", err)
+	}
+	return nil
+}
+
+// isWriteFailure reports whether err is a failure to write an identity, as
+// opposed to the identity missing, the pair blocked or nothing to write.
+func isWriteFailure(err error) bool {
+	return err != nil && !errors.Is(err, errUnchanged) && !errors.Is(err, storage.ErrNotFound) && !isBlocked(err)
+}
+
+// wait waits for about d, a random share of identityWriteBackoff added, and
+// reports false when ctx ends first.
+func wait(ctx context.Context, d time.Duration) bool {
+	timer := time.NewTimer(d + rand.N(identityWriteBackoff))
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return false
+	case <-timer.C:
+		return true
+	}
+}
+
+// sameClaims reports whether a and b are the same claims; groups compare by
+// content, so a nil list equals an empty one.
+func sameClaims(a, b storage.Claims) bool {
+	return a.UserID == b.UserID &&
+		a.Username == b.Username &&
+		a.PreferredUsername == b.PreferredUsername &&
+		a.Email == b.Email &&
+		a.EmailVerified == b.EmailVerified &&
+		slices.Equal(a.Groups, b.Groups)
+}
+
+// Completed sets LastLogin of the pair to at, the time its login passed the first
+// factor, once every factor of that login is done. LastLogin never moves back, so
+// repeating the call for the same login, or calling it for a login served from a
+// session (whose auth time is the LastLogin it continues), writes nothing. A pair
+// without an identity has nothing to record.
+func Completed(ctx context.Context, s storage.Storage, userID, connectorID string, at time.Time) error {
+	err := s.UpdateUserIdentity(ctx, userID, connectorID, func(old storage.UserIdentity) (storage.UserIdentity, error) {
+		if !old.LastLogin.Before(at) {
+			return old, errUnchanged
+		}
+		old.LastLogin = at
+		return old, nil
+	})
+	if err == nil || errors.Is(err, errUnchanged) || errors.Is(err, storage.ErrNotFound) {
+		return nil
+	}
+	return fmt.Errorf("record last login: %w", err)
+}
+
+// CheckBlocked returns *BlockedError when the pair is blocked at now. A pair
+// without an identity, one that never logged in since the identity was
+// introduced, is not blocked.
+func CheckBlocked(ctx context.Context, s storage.Storage, userID, connectorID string, now time.Time) error {
+	ui, err := s.GetUserIdentity(ctx, userID, connectorID)
+	switch {
+	case errors.Is(err, storage.ErrNotFound):
+		return nil
+	case err != nil:
+		return fmt.Errorf("get user identity: %w", err)
+	}
+	return CheckBlockedIdentity(ui, now)
+}
+
+// CheckBlockedIdentity is CheckBlocked for an identity already read.
+func CheckBlockedIdentity(ui storage.UserIdentity, now time.Time) error {
+	if blocked(ui, now) {
+		return &BlockedError{Until: ui.BlockedUntil}
+	}
+	return nil
+}
+
+func blocked(ui storage.UserIdentity, now time.Time) bool {
+	return now.Before(ui.BlockedUntil)
+}
+
+func isBlocked(err error) bool {
+	var blockedErr *BlockedError
+	return errors.As(err, &blockedErr)
+}
diff --git a/server/useridentity/useridentity_test.go b/server/useridentity/useridentity_test.go
new file mode 100644
index 00000000..d8ab0e14
--- /dev/null
+++ b/server/useridentity/useridentity_test.go
@@ -0,0 +1,461 @@
+package useridentity
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"log/slog"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+var (
+	t0     = time.Date(2026, 10, 14, 12, 0, 0, 0, time.UTC)
+	claims = storage.Claims{UserID: "jane", Username: "jane", Email: "jane@example.com", Groups: []string{"admins"}}
+)
+
+func newStorage(t *testing.T) storage.Storage {
+	t.Helper()
+	return memory.New(slog.New(slog.DiscardHandler))
+}
+
+func TestRecord(t *testing.T) {
+	tests := []struct {
+		name          string
+		existing      *storage.UserIdentity
+		complete      bool
+		wantLastLogin time.Time
+		wantCreatedAt time.Time
+	}{
+		{
+			name:          "first login without a second factor",
+			complete:      true,
+			wantLastLogin: t0,
+			wantCreatedAt: t0,
+		},
+		{
+			name:          "first login before a second factor",
+			wantCreatedAt: t0,
+		},
+		{
+			name: "next login keeps what the identity holds",
+			existing: &storage.UserIdentity{
+				UserID: "jane", ConnectorID: "local",
+				Claims:     storage.Claims{UserID: "jane", Email: "old@example.com"},
+				MFASecrets: map[string]*storage.MFASecret{"totp": {Secret: "s", Confirmed: true}},
+				CreatedAt:  t0.Add(-time.Hour), LastLogin: t0.Add(-time.Minute),
+				BlockedUntil: t0.Add(-time.Second), IncorrectPasswordLoginAttempts: 2,
+			},
+			complete:      true,
+			wantLastLogin: t0,
+			wantCreatedAt: t0.Add(-time.Hour),
+		},
+		{
+			name: "next login before a second factor keeps the last login",
+			existing: &storage.UserIdentity{
+				UserID: "jane", ConnectorID: "local",
+				CreatedAt: t0.Add(-time.Hour), LastLogin: t0.Add(-time.Minute),
+			},
+			wantLastLogin: t0.Add(-time.Minute),
+			wantCreatedAt: t0.Add(-time.Hour),
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s := newStorage(t)
+			if tc.existing != nil {
+				require.NoError(t, s.CreateUserIdentity(ctx, *tc.existing))
+			}
+
+			err := Record(ctx, s, Login{ConnectorID: "local", Claims: claims, Time: t0, Complete: tc.complete})
+			require.NoError(t, err)
+
+			got, err := s.GetUserIdentity(ctx, "jane", "local")
+			require.NoError(t, err)
+			require.Equal(t, claims, got.Claims)
+			require.Equal(t, tc.wantLastLogin, got.LastLogin)
+			require.Equal(t, tc.wantCreatedAt, got.CreatedAt)
+			if tc.existing != nil {
+				require.Equal(t, tc.existing.MFASecrets, got.MFASecrets)
+				require.Equal(t, tc.existing.BlockedUntil, got.BlockedUntil)
+				require.Equal(t, tc.existing.IncorrectPasswordLoginAttempts, got.IncorrectPasswordLoginAttempts)
+			}
+		})
+	}
+}
+
+func TestRecordBlocked(t *testing.T) {
+	ctx := t.Context()
+	s := newStorage(t)
+	old := storage.UserIdentity{
+		UserID: "jane", ConnectorID: "local",
+		Claims:    storage.Claims{UserID: "jane", Email: "old@example.com"},
+		LastLogin: t0.Add(-time.Hour), BlockedUntil: t0.Add(time.Hour),
+	}
+	require.NoError(t, s.CreateUserIdentity(ctx, old))
+
+	err := Record(ctx, s, Login{ConnectorID: "local", Claims: claims, Time: t0, Complete: true})
+
+	var blocked *BlockedError
+	require.ErrorAs(t, err, &blocked)
+	require.Equal(t, t0.Add(time.Hour), blocked.Until)
+	got, err := s.GetUserIdentity(ctx, "jane", "local")
+	require.NoError(t, err)
+	require.Equal(t, old, got, "a refused login writes nothing")
+}
+
+// createRace creates the identity right before the login creates it, as a
+// parallel login or the user-authn controller can.
+type createRace struct {
+	storage.Storage
+	raced bool
+}
+
+func (s *createRace) CreateUserIdentity(ctx context.Context, u storage.UserIdentity) error {
+	if !s.raced {
+		s.raced = true
+		if err := s.Storage.CreateUserIdentity(ctx, storage.UserIdentity{UserID: u.UserID, ConnectorID: u.ConnectorID, CreatedAt: t0.Add(-time.Hour)}); err != nil {
+			return err
+		}
+	}
+	return s.Storage.CreateUserIdentity(ctx, u)
+}
+
+func TestRecordCreateRace(t *testing.T) {
+	ctx := t.Context()
+	s := &createRace{Storage: newStorage(t)}
+
+	require.NoError(t, Record(ctx, s, Login{ConnectorID: "local", Claims: claims, Time: t0, Complete: true}))
+
+	got, err := s.GetUserIdentity(ctx, "jane", "local")
+	require.NoError(t, err)
+	require.Equal(t, claims, got.Claims)
+	require.Equal(t, t0, got.LastLogin)
+	require.Equal(t, t0.Add(-time.Hour), got.CreatedAt)
+}
+
+// lockOnCreate gives a new identity a lock, as the transitional kubernetes
+// storage does for a pair locked before the update.
+type lockOnCreate struct {
+	storage.Storage
+}
+
+func (s lockOnCreate) CreateUserIdentity(ctx context.Context, u storage.UserIdentity) error {
+	u.BlockedUntil = t0.Add(time.Hour)
+	return s.Storage.CreateUserIdentity(ctx, u)
+}
+
+func TestRecordFirstLoginOfLockedPair(t *testing.T) {
+	ctx := t.Context()
+	s := lockOnCreate{Storage: newStorage(t)}
+
+	err := Record(ctx, s, Login{ConnectorID: "ldap", Claims: claims, Time: t0, Complete: true})
+
+	var blocked *BlockedError
+	require.ErrorAs(t, err, &blocked)
+	got, err := s.GetUserIdentity(ctx, "jane", "ldap")
+	require.NoError(t, err)
+	require.True(t, got.LastLogin.IsZero(), "a refused login is not a last login")
+}
+
+// TestRecordWritesOnlyChanges checks that a login writes the identity only for
+// new claims or a LastLogin to move, and that the password grant
+// (CoarseLastLogin) moves LastLogin only once it is a minute old.
+func TestRecordWritesOnlyChanges(t *testing.T) {
+	newClaims := claims
+	newClaims.Groups = []string{"admins", "developers"}
+
+	tests := []struct {
+		name          string
+		lastLogin     time.Time
+		login         Login
+		wantClaims    storage.Claims
+		wantLastLogin time.Time
+	}{
+		{
+			name:          "password grant within a minute of the last login writes nothing",
+			lastLogin:     t0.Add(-59 * time.Second),
+			login:         Login{Claims: claims, Complete: true, CoarseLastLogin: true},
+			wantClaims:    claims,
+			wantLastLogin: t0.Add(-59 * time.Second),
+		},
+		{
+			name:          "password grant a minute after the last login moves it",
+			lastLogin:     t0.Add(-time.Minute),
+			login:         Login{Claims: claims, Complete: true, CoarseLastLogin: true},
+			wantClaims:    claims,
+			wantLastLogin: t0,
+		},
+		{
+			name:          "password grant with new claims within a minute writes the claims",
+			lastLogin:     t0.Add(-time.Second),
+			login:         Login{Claims: newClaims, Complete: true, CoarseLastLogin: true},
+			wantClaims:    newClaims,
+			wantLastLogin: t0.Add(-time.Second),
+		},
+		{
+			name:          "browser login keeps the last login exact",
+			lastLogin:     t0.Add(-time.Second),
+			login:         Login{Claims: claims, Complete: true},
+			wantClaims:    claims,
+			wantLastLogin: t0,
+		},
+		{
+			name:          "browser login before a second factor with the same claims writes nothing",
+			lastLogin:     t0.Add(-time.Hour),
+			login:         Login{Claims: claims},
+			wantClaims:    claims,
+			wantLastLogin: t0.Add(-time.Hour),
+		},
+		{
+			name:          "last login never moves back",
+			lastLogin:     t0.Add(time.Hour),
+			login:         Login{Claims: newClaims, Complete: true},
+			wantClaims:    newClaims,
+			wantLastLogin: t0.Add(time.Hour),
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s := &countingUpdate{Storage: newStorage(t)}
+			require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{
+				UserID: "jane", ConnectorID: "local", Claims: claims, LastLogin: tc.lastLogin,
+			}))
+			login := tc.login
+			login.ConnectorID, login.Time = "local", t0
+
+			require.NoError(t, Record(ctx, s, login))
+
+			got, err := s.GetUserIdentity(ctx, "jane", "local")
+			require.NoError(t, err)
+			require.Equal(t, tc.wantClaims, got.Claims)
+			require.Equal(t, tc.wantLastLogin, got.LastLogin)
+			wantWrites := 0
+			if !sameClaims(tc.wantClaims, claims) || !tc.wantLastLogin.Equal(tc.lastLogin) {
+				wantWrites = 1
+			}
+			require.Equal(t, wantWrites, s.writes)
+		})
+	}
+}
+
+// countingUpdate counts the writes of an identity.
+type countingUpdate struct {
+	storage.Storage
+	writes int
+}
+
+func (s *countingUpdate) UpdateUserIdentity(ctx context.Context, userID, connectorID string, updater func(storage.UserIdentity) (storage.UserIdentity, error)) error {
+	return s.Storage.UpdateUserIdentity(ctx, userID, connectorID, func(old storage.UserIdentity) (storage.UserIdentity, error) {
+		updated, err := updater(old)
+		if err == nil {
+			s.writes++
+		}
+		return updated, err
+	})
+}
+
+// failingUpdate fails the first failures writes of an identity (every write
+// when negative), as a conflict with writers on other replicas does. The
+// updater still runs on what is stored, as in a storage that writes after it,
+// so a blocked pair is refused and an update with nothing to write ends there.
+type failingUpdate struct {
+	storage.Storage
+	failures int
+	tries    int
+}
+
+var errConflict = errors.New("conflict")
+
+func (s *failingUpdate) UpdateUserIdentity(ctx context.Context, userID, connectorID string, updater func(storage.UserIdentity) (storage.UserIdentity, error)) error {
+	s.tries++
+	if s.failures >= 0 && s.tries > s.failures {
+		return s.Storage.UpdateUserIdentity(ctx, userID, connectorID, updater)
+	}
+	old, err := s.GetUserIdentity(ctx, userID, connectorID)
+	if err != nil {
+		return err
+	}
+	if _, err := updater(old); err != nil {
+		return err
+	}
+	return errConflict
+}
+
+func TestRecordRetriesWrite(t *testing.T) {
+	ctx := t.Context()
+	s := &failingUpdate{Storage: newStorage(t), failures: identityWriteAttempts - 1}
+	require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{UserID: "jane", ConnectorID: "local"}))
+
+	require.NoError(t, Record(ctx, s, Login{ConnectorID: "local", Claims: claims, Time: t0, Complete: true}))
+
+	require.Equal(t, identityWriteAttempts, s.tries)
+	got, err := s.GetUserIdentity(ctx, "jane", "local")
+	require.NoError(t, err)
+	require.Equal(t, claims, got.Claims)
+	require.Equal(t, t0, got.LastLogin)
+}
+
+// A write of an existing identity that keeps failing does not fail the login:
+// the identity is read instead, and its lock still refuses a blocked pair.
+func TestRecordWriteKeepsFailing(t *testing.T) {
+	stored := storage.UserIdentity{
+		UserID: "jane", ConnectorID: "local",
+		Claims:    storage.Claims{UserID: "jane", Email: "old@example.com"},
+		LastLogin: t0.Add(-time.Hour),
+	}
+
+	t.Run("the login goes on with the stored identity", func(t *testing.T) {
+		ctx := t.Context()
+		s := &failingUpdate{Storage: newStorage(t), failures: -1}
+		require.NoError(t, s.CreateUserIdentity(ctx, stored))
+		var logs bytes.Buffer
+
+		err := Record(ctx, s, Login{
+			ConnectorID: "local", Claims: claims, Time: t0, Complete: true,
+			Logger: slog.New(slog.NewTextHandler(&logs, nil)),
+		})
+
+		require.NoError(t, err)
+		require.Equal(t, identityWriteAttempts, s.tries)
+		got, err := s.GetUserIdentity(ctx, "jane", "local")
+		require.NoError(t, err)
+		require.Equal(t, stored, got)
+		require.Contains(t, logs.String(), "level=WARN")
+		require.Contains(t, logs.String(), "failed to record the user identity of a login")
+		require.Contains(t, logs.String(), errConflict.Error())
+	})
+
+	t.Run("a blocked pair is refused", func(t *testing.T) {
+		ctx := t.Context()
+		s := &failingUpdate{Storage: newStorage(t), failures: -1}
+		locked := stored
+		locked.BlockedUntil = t0.Add(time.Hour)
+		require.NoError(t, s.CreateUserIdentity(ctx, locked))
+
+		err := Record(ctx, s, Login{ConnectorID: "local", Claims: claims, Time: t0, Complete: true})
+
+		var blocked *BlockedError
+		require.ErrorAs(t, err, &blocked)
+		require.Equal(t, t0.Add(time.Hour), blocked.Until)
+	})
+
+	t.Run("an identity that cannot be read fails the login", func(t *testing.T) {
+		ctx := t.Context()
+		memory := newStorage(t)
+		require.NoError(t, memory.CreateUserIdentity(ctx, stored))
+		s := &failingUpdate{Storage: failingGet{Storage: memory}, failures: -1}
+
+		err := Record(ctx, s, Login{ConnectorID: "local", Claims: claims, Time: t0, Complete: true})
+
+		require.ErrorIs(t, err, errStorage)
+		var blocked *BlockedError
+		require.False(t, errors.As(err, &blocked))
+	})
+
+	t.Run("a canceled login stops trying", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(t.Context())
+		cancel()
+		s := &failingUpdate{Storage: newStorage(t), failures: -1}
+		require.NoError(t, s.CreateUserIdentity(ctx, stored))
+
+		require.NoError(t, Record(ctx, s, Login{ConnectorID: "local", Claims: claims, Time: t0, Complete: true}))
+		require.Equal(t, 1, s.tries)
+	})
+}
