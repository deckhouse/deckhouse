+func TestBuildMFAProviders(t *testing.T) {
+	logger := slog.New(slog.DiscardHandler)
+	const issuer = "https://dex.example.com"
+
+	tests := []struct {
+		name           string
+		authenticators []MFAAuthenticator
+		wantIDs        []string
+		wantErr        string
+	}{
+		{
+			name: "no authenticators",
+		},
+		{
+			name: "TOTP and WebAuthn",
+			authenticators: []MFAAuthenticator{
+				{ID: "totp", Type: "TOTP", Config: json.RawMessage(`{"issuer":"Dex"}`), ConnectorTypes: []string{"local"}},
+				{ID: "webauthn", Type: "WebAuthn", Config: json.RawMessage(`{"rpID":"example.com","attestationPreference":"none","timeout":"90s"}`), ConnectorTypes: []string{"ldap"}},
+			},
+			wantIDs: []string{"totp", "webauthn"},
+		},
+		{
+			name: "a WebAuthn timeout that is no duration",
+			authenticators: []MFAAuthenticator{
+				{ID: "webauthn", Type: "WebAuthn", Config: json.RawMessage(`{"timeout":"soon"}`)},
+			},
+			wantErr: `create the WebAuthn authenticator "webauthn"`,
+		},
+		{
+			name: "a WebAuthn config that is no object",
+			authenticators: []MFAAuthenticator{
+				{ID: "webauthn", Type: "WebAuthn", Config: json.RawMessage(`"rpID"`)},
+			},
+			wantErr: `parse the WebAuthn config of "webauthn"`,
+		},
+		{
+			name: "a TOTP config that is no object",
+			authenticators: []MFAAuthenticator{
+				{ID: "totp", Type: "TOTP", Config: json.RawMessage(`[]`)},
+			},
+			wantErr: `parse the TOTP config of "totp"`,
+		},
+		{
+			name: "an unknown type",
+			authenticators: []MFAAuthenticator{
+				{ID: "sms", Type: "SMS", Config: json.RawMessage(`{}`)},
+			},
+			wantErr: `unknown type "SMS" of "sms"`,
+		},
+		{
+			// One bad authenticator stops the start even when a good one comes first: a login that asked for
+			// the bad one would otherwise pass without it.
+			name: "a bad authenticator after a good one",
+			authenticators: []MFAAuthenticator{
+				{ID: "totp", Type: "TOTP", Config: json.RawMessage(`{"issuer":"Dex"}`)},
+				{ID: "webauthn", Type: "WebAuthn", Config: json.RawMessage(`{"timeout":"soon"}`)},
+			},
+			wantErr: `"webauthn"`,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			providers, err := buildMFAProviders(tt.authenticators, issuer, logger)
+			if tt.wantErr != "" {
+				require.ErrorContains(t, err, tt.wantErr)
+				require.Nil(t, providers)
+				return
+			}
+			require.NoError(t, err)
+			ids := make([]string, 0, len(providers))
+			for id := range providers {
+				ids = append(ids, id)
+			}
+			require.ElementsMatch(t, tt.wantIDs, ids)
+		})
+	}
+}
