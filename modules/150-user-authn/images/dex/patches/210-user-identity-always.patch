+// oldPlaceStorage serves the second factor and the lock that the storage of the
+// v2.44-based Deckhouse dex kept outside UserIdentity, the way the transitional
+// kubernetes storage does: a pair without an identity reads as one with that
+// state, which is not stored, and the first create of the identity stores it.
+type oldPlaceStorage struct {
+	storage.Storage
+	old map[oldPlacePair]storage.UserIdentity
+}
+
+type oldPlacePair struct{ userID, connectorID string }
+
+func (s *oldPlaceStorage) oldState(userID, connectorID string) (storage.UserIdentity, bool) {
+	old, ok := s.old[oldPlacePair{userID: userID, connectorID: connectorID}]
+	if !ok {
+		return storage.UserIdentity{}, false
+	}
+	secrets := make(map[string]*storage.MFASecret, len(old.MFASecrets))
+	for id, secret := range old.MFASecrets {
+		secretCopy := *secret
+		secrets[id] = &secretCopy
+	}
+	old.MFASecrets = secrets
+	return old, true
+}
+
+func (s *oldPlaceStorage) GetUserIdentity(ctx context.Context, userID, connectorID string) (storage.UserIdentity, error) {
+	u, err := s.Storage.GetUserIdentity(ctx, userID, connectorID)
+	if errors.Is(err, storage.ErrNotFound) {
+		if old, ok := s.oldState(userID, connectorID); ok {
+			return old, nil
+		}
+	}
+	return u, err
+}
+
+func (s *oldPlaceStorage) CreateUserIdentity(ctx context.Context, u storage.UserIdentity) error {
+	if old, ok := s.oldState(u.UserID, u.ConnectorID); ok {
+		if old.BlockedUntil.After(u.BlockedUntil) {
+			u.BlockedUntil = old.BlockedUntil
+		}
+		for id, secret := range old.MFASecrets {
+			if u.MFASecrets == nil {
+				u.MFASecrets = make(map[string]*storage.MFASecret)
+			}
+			if u.MFASecrets[id] == nil {
+				u.MFASecrets[id] = secret
+			}
+		}
+	}
+	return s.Storage.CreateUserIdentity(ctx, u)
+}
