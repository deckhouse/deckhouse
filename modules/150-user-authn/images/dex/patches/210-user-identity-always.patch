diff --git a/server/mfa/order.go b/server/mfa/order.go
new file mode 100644
index 00000000..6fbeafa8
--- /dev/null
+++ b/server/mfa/order.go
@@ -0,0 +1,195 @@
+package mfa
+
+// The order of the factors of a login (Deckhouse). A login whose chain asks for every factor passes first the
+// factors the user has, in the order of the chain, and registers the missing ones after them, in the order of the
+// chain too. Upstream sent every login to the first factor of the chain, so a user who had only a key registered a
+// code with the password alone, before the key was asked for. A user who has every factor, or none, passes the
+// chain in its order, as upstream.
+//
+// The factors passed in the login are kept in the auth request, and a factor that the user does not have yet is
+// registered only after every factor the user has is passed in the login, whatever address the request comes to.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"slices"
+
+	"github.com/go-webauthn/webauthn/webauthn"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/storage"
+)
+
+// webAuthnState is what an auth request keeps of the second factor: the WebAuthn ceremony in progress and the
+// authenticators passed in the login. It is stored in WebAuthnSessionData with the session embedded, so the data of
+// an earlier dex reads the same.
+type webAuthnState struct {
+	webauthn.SessionData
+	Passed []string `json:"deckhousePassed,omitempty"`
+	// PassedUserID and PassedConnectorID are the user the factors of Passed belong to.
+	PassedUserID      string `json:"deckhousePassedUserID,omitempty"`
+	PassedConnectorID string `json:"deckhousePassedConnectorID,omitempty"`
+}
+
+func readWebAuthnState(data []byte) webAuthnState {
+	var state webAuthnState
+	_ = json.Unmarshal(data, &state) // no data, or data that does not parse, is no state
+	return state
+}
+
+// passedBy returns the authenticators the user of authReq passed in the login. The passes recorded for another user,
+// who signed the request in before, count for nothing: a factor of one user never stands for a factor of another.
+func (s webAuthnState) passedBy(authReq storage.AuthRequest) []string {
+	if s.PassedUserID != authReq.Claims.UserID || s.PassedConnectorID != authReq.ConnectorID {
+		return nil
+	}
+	return s.Passed
+}
+
+// errNotPassedYet is returned from an UpdateUserIdentity closure when the identity got a factor the login has not
+// passed after the request had loaded it.
+var errNotPassedYet = errors.New("a factor of the user is not passed in the login")
+
+// notPassedYetMsg is the answer of the WebAuthn API to a registration before the factors the user has.
+const notPassedYetMsg = "Confirm the sign-in with the second factor you have first."
+
+// hasFactor reports whether the user has the authenticator: a TOTP secret confirmed by a code, or at least one
+// WebAuthn credential. A TOTP secret not confirmed yet is missing.
+func (h *Handler) hasFactor(identity storage.UserIdentity, authenticatorID string) bool {
+	provider, ok := h.MFAProviders[authenticatorID]
+	if !ok {
+		return false
+	}
+	switch provider.Type() {
+	case "TOTP":
+		secret := identity.MFASecrets[authenticatorID]
+		return secret != nil && secret.Confirmed
+	case "WebAuthn":
+		return webAuthnRegistered(identity, authenticatorID)
+	default:
+		return false
+	}
+}
+
+// orderForIdentity returns chain with the authenticators the user has first and the missing ones after them.
+func (h *Handler) orderForIdentity(identity storage.UserIdentity, chain []string) []string {
+	ordered := make([]string, 0, len(chain))
+	for _, id := range chain {
+		if h.hasFactor(identity, id) {
+			ordered = append(ordered, id)
+		}
+	}
+	for _, id := range chain {
+		if !h.hasFactor(identity, id) {
+			ordered = append(ordered, id)
+		}
+	}
+	return ordered
+}
+
+// nextFactor returns the first authenticator of the ordered chain the login has not passed, empty when it passed
+// every one.
+func (h *Handler) nextFactor(identity storage.UserIdentity, chain, passed []string) string {
+	for _, id := range h.orderForIdentity(identity, chain) {
+		if !slices.Contains(passed, id) {
+			return id
+		}
+	}
+	return ""
+}
+
+// mayRegister reports whether the login may register authenticatorID: it has passed every other authenticator of
+// the chain the user has.
+func (h *Handler) mayRegister(identity storage.UserIdentity, chain, passed []string, authenticatorID string) bool {
+	for _, id := range chain {
+		if id != authenticatorID && h.hasFactor(identity, id) && !slices.Contains(passed, id) {
+			return false
+		}
+	}
+	return true
+}
+
+// loadIdentity returns the identity of the login; a login without one has no factor.
+func (h *Handler) loadIdentity(ctx context.Context, authReq storage.AuthRequest) (storage.UserIdentity, error) {
+	identity, err := h.Storage.GetUserIdentity(ctx, authReq.Claims.UserID, authReq.ConnectorID)
+	if err != nil && !errors.Is(err, storage.ErrNotFound) {
+		return storage.UserIdentity{}, err
+	}
+	return identity, nil
+}
+
+// registration is what a request that registers a factor checks against: the chain of the login and the
+// authenticators it passed. The auth request is read again, so the passes are current.
+type registration struct {
+	h               *Handler
+	chain, passed   []string
+	authenticatorID string
+}
+
+func (h *Handler) registration(ctx context.Context, authReq storage.AuthRequest, authenticatorID string) (registration, error) {
+	chain, err := h.chainForClient(ctx, authReq.ClientID, authReq.ConnectorID)
+	if err != nil {
+		return registration{}, err
+	}
+	current, err := h.Storage.GetAuthRequest(ctx, authReq.ID)
+	if err != nil {
+		return registration{}, err
+	}
+	return registration{
+		h:               h,
+		chain:           chain,
+		passed:          readWebAuthnState(current.WebAuthnSessionData).passedBy(current),
+		authenticatorID: authenticatorID,
+	}, nil
+}
+
+// allowed reports whether the login may register the factor for the user it was loaded for, or stored since.
+func (g registration) allowed(identity storage.UserIdentity) bool {
+	return g.h.mayRegister(identity, g.chain, g.passed, g.authenticatorID)
+}
+
+// webAuthnRegistration resolves the registration of a WebAuthn API request, answering the request itself when it
+// cannot.
+func (h *Handler) webAuthnRegistration(w http.ResponseWriter, r *http.Request, mfa *mfaRequestContext) (registration, bool) {
+	gate, err := h.registration(r.Context(), mfa.authReq, mfa.authenticatorID)
+	if err != nil {
+		h.Logger.ErrorContext(r.Context(), "failed to determine MFA chain", "err", err)
+		writeJSONError(w, http.StatusInternalServerError, "Internal server error.")
+		return registration{}, false
+	}
+	return gate, true
+}
+
+// recordPassed adds the authenticator to the ones the user of the login passed and returns them.
+func (h *Handler) recordPassed(ctx context.Context, authReqID, authenticatorID string) ([]string, error) {
+	var passed []string
+	err := h.Storage.UpdateAuthRequest(ctx, authReqID, func(old storage.AuthRequest) (storage.AuthRequest, error) {
+		state := readWebAuthnState(old.WebAuthnSessionData)
+		state.Passed = state.passedBy(old)
+		if !slices.Contains(state.Passed, authenticatorID) {
+			state.Passed = append(state.Passed, authenticatorID)
+		}
+		state.PassedUserID, state.PassedConnectorID = old.Claims.UserID, old.ConnectorID
+		data, err := json.Marshal(state)
+		if err != nil {
+			return old, fmt.Errorf("marshal state: %w", err)
+		}
+		old.WebAuthnSessionData = data
+		passed = state.Passed
+		return old, nil
+	})
+	return passed, err
+}
+
+// entryURL is the signed address of the MFA entry, which sends the login to its next factor.
+func (h *Handler) entryURL(authReq storage.AuthRequest) string {
+	return internal.StepURL(h.IssuerURL.AbsPath("/mfa"), authReq, internal.StepMFA, nil)
+}
+
+// redirectToEntry sends a request for a factor the login cannot register yet back to the MFA entry.
+func (h *Handler) redirectToEntry(w http.ResponseWriter, r *http.Request, authReq storage.AuthRequest) {
+	http.Redirect(w, r, h.entryURL(authReq), http.StatusSeeOther)
+}
diff --git a/server/mfa/order_test.go b/server/mfa/order_test.go
new file mode 100644
index 00000000..aa1436b8
--- /dev/null
+++ b/server/mfa/order_test.go
@@ -0,0 +1,249 @@
+package mfa
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-webauthn/webauthn/webauthn"
+	"github.com/pquerna/otp"
+	"github.com/pquerna/otp/totp"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/storage"
+)
+
+// orderTest is a login of a client whose chain asks for every factor, a code and a key, in that order (Deckhouse).
+type orderTest struct {
+	h       *Handler
+	router  http.Handler
+	store   storage.Storage
+	authReq storage.AuthRequest
+}
+
+func newOrderTest(t *testing.T, identity storage.UserIdentity) orderTest {
+	t.Helper()
+	key, err := NewWebAuthnProvider("Test", "", nil, "", "", "http://localhost", nil)
+	require.NoError(t, err)
+	key.finishRegistration = func(webauthn.User, webauthn.SessionData, *http.Request) (*webauthn.Credential, error) {
+		return &webauthn.Credential{ID: []byte("new-key")}, nil
+	}
+	h, router, store := newTestHandler(t,
+		map[string]Provider{"totp": NewTOTPProvider("test-issuer", nil), "webauthn": key}, nil)
+
+	ctx := t.Context()
+	authReq := storage.AuthRequest{
+		ID: "order-req", ClientID: "app", Expiry: time.Now().Add(time.Hour),
+		HMACKey: randomHMACKey(t), LoggedIn: true,
+		Claims:      storage.Claims{UserID: "user-1", Email: "user@example.com"},
+		ConnectorID: "mock",
+	}
+	require.NoError(t, store.CreateAuthRequest(ctx, authReq))
+	require.NoError(t, store.CreateClient(ctx, storage.Client{ID: "app", Secret: "s", MFAChain: []string{"totp", "webauthn"}}))
+	identity.UserID, identity.ConnectorID, identity.Claims = "user-1", "mock", authReq.Claims
+	require.NoError(t, store.CreateUserIdentity(ctx, identity))
+	return orderTest{h: h, router: router, store: store, authReq: authReq}
+}
+
+func (o orderTest) serve(t *testing.T, method, target string, form url.Values) *httptest.ResponseRecorder {
+	t.Helper()
+	var req *http.Request
+	if form != nil {
+		req = httptest.NewRequest(method, target, strings.NewReader(form.Encode()))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	} else {
+		req = httptest.NewRequest(method, target, nil)
+	}
+	w := httptest.NewRecorder()
+	o.router.ServeHTTP(w, req)
+	return w
+}
+
+// entry is where the /mfa entry sends the login.
+func (o orderTest) entry(t *testing.T) string {
+	t.Helper()
+	w := o.serve(t, http.MethodGet, "/mfa?req="+o.authReq.ID+"&hmac="+url.QueryEscape(internal.SignStep(o.authReq, internal.StepMFA)), nil)
+	require.Equal(t, http.StatusSeeOther, w.Code)
+	return w.Header().Get("Location")
+}
+
+// factorURL is the signed address of the page of a factor, as the server hands it out.
+func (o orderTest) factorURL(authenticatorID string) string {
+	return o.h.buildRedirectURL(o.authReq, authenticatorID)
+}
+
+func (o orderTest) identity(t *testing.T) storage.UserIdentity {
+	t.Helper()
+	identity, err := o.store.GetUserIdentity(t.Context(), "user-1", "mock")
+	require.NoError(t, err)
+	return identity
+}
+
+func (o orderTest) validated(t *testing.T) bool {
+	t.Helper()
+	authReq, err := o.store.GetAuthRequest(t.Context(), o.authReq.ID)
+	require.NoError(t, err)
+	return authReq.MFAValidated
+}
+
+func totpCode(t *testing.T, keyURL string) string {
+	t.Helper()
+	key, err := otp.NewKeyFromURL(keyURL)
+	require.NoError(t, err)
+	code, err := totp.GenerateCodeCustom(key.Secret(), time.Now(), totpOpts())
+	require.NoError(t, err)
+	return code
+}
+
+func orderCode(t *testing.T) *storage.MFASecret {
+	t.Helper()
+	key, err := totp.Generate(totp.GenerateOpts{Issuer: "test-issuer", AccountName: "user@example.com"})
+	require.NoError(t, err)
+	return &storage.MFASecret{AuthenticatorID: "totp", Type: "TOTP", Secret: key.String(), Confirmed: true}
+}
+
+func orderKey() map[string][]storage.WebAuthnCredential {
+	return map[string][]storage.WebAuthnCredential{"webauthn": {{CredentialID: []byte("key-1"), PublicKey: []byte("pk")}}}
+}
+
+// A user who has only a key passes it first, and registers the code after it: the password alone registers
+// nothing in an account protected by the key.
+func TestOrderAUserWithAKeyPassesItBeforeRegisteringACode(t *testing.T) {
+	o := newOrderTest(t, storage.UserIdentity{WebAuthnCredentials: orderKey()})
+
+	first := o.entry(t)
+	require.Contains(t, first, "/mfa/webauthn?")
+	require.Contains(t, first, "authenticator=webauthn")
+
+	// The page of the code before the key: back to the entry, and no secret.
+	for _, method := range []string{http.MethodGet, http.MethodPost} {
+		w := o.serve(t, method, o.factorURL("totp"), url.Values{"totp": {"123456"}})
+		require.Equal(t, http.StatusSeeOther, w.Code, method)
+		require.Contains(t, w.Header().Get("Location"), "/mfa?", method)
+		require.Nil(t, o.identity(t).MFASecrets["totp"], method)
+	}
+	require.False(t, o.validated(t))
+
+	// The key passes: the code is registered next, and the login completes with it.
+	next, err := o.h.CompleteStep(t.Context(), o.authReq, "webauthn")
+	require.NoError(t, err)
+	require.Contains(t, next, "/mfa/totp?")
+	require.Equal(t, http.StatusOK, o.serve(t, http.MethodGet, next, nil).Code)
+	secret := o.identity(t).MFASecrets["totp"]
+	require.NotNil(t, secret)
+	require.False(t, secret.Confirmed)
+
+	w := o.serve(t, http.MethodPost, next, url.Values{"totp": {totpCode(t, secret.Secret)}})
+	require.Equal(t, http.StatusSeeOther, w.Code)
+	require.Contains(t, w.Header().Get("Location"), "/auth?")
+	require.True(t, o.identity(t).MFASecrets["totp"].Confirmed)
+	require.True(t, o.validated(t))
+}
+
+// A code registration someone started is not a factor of the user: it is confirmed only after the key.
+func TestOrderAnUnconfirmedCodeCountsAsMissing(t *testing.T) {
+	started := orderCode(t)
+	started.Confirmed = false
+	o := newOrderTest(t, storage.UserIdentity{
+		WebAuthnCredentials: orderKey(),
+		MFASecrets:          map[string]*storage.MFASecret{"totp": started},
+	})
+
+	require.Contains(t, o.entry(t), "authenticator=webauthn")
+	w := o.serve(t, http.MethodPost, o.factorURL("totp"), url.Values{"totp": {totpCode(t, started.Secret)}})
+	require.Equal(t, http.StatusSeeOther, w.Code)
+	require.Contains(t, w.Header().Get("Location"), "/mfa?")
+	require.False(t, o.identity(t).MFASecrets["totp"].Confirmed)
+	require.False(t, o.validated(t))
+}
+
+// A user who has only a code passes it first, and registers a key after it.
+func TestOrderAUserWithACodePassesItBeforeRegisteringAKey(t *testing.T) {
+	o := newOrderTest(t, storage.UserIdentity{MFASecrets: map[string]*storage.MFASecret{"totp": orderCode(t)}})
+
+	require.Contains(t, o.entry(t), "authenticator=totp")
+
+	// The key before the code: the page sends back to the entry, the registration is refused.
+	w := o.serve(t, http.MethodGet, o.factorURL("webauthn"), nil)
+	require.Equal(t, http.StatusSeeOther, w.Code)
+	require.Contains(t, w.Header().Get("Location"), "/mfa?")
+	query := o.factorURL("webauthn")[strings.Index(o.factorURL("webauthn"), "?"):]
+	for _, step := range []string{"begin", "finish"} {
+		w := o.serve(t, http.MethodPost, "/mfa/webauthn/register/"+step+query, nil)
+		require.Equal(t, http.StatusForbidden, w.Code, step)
+	}
+	require.Empty(t, o.identity(t).WebAuthnCredentials["webauthn"])
+
+	// The code passes: the key is registered next.
+	next, err := o.h.CompleteStep(t.Context(), o.authReq, "totp")
+	require.NoError(t, err)
+	require.Contains(t, next, "/mfa/webauthn?")
+	require.Equal(t, http.StatusOK, o.serve(t, http.MethodGet, next, nil).Code)
+	query = next[strings.Index(next, "?"):]
+	require.Equal(t, http.StatusOK, o.serve(t, http.MethodPost, "/mfa/webauthn/register/begin"+query, nil).Code)
+	w = o.serve(t, http.MethodPost, "/mfa/webauthn/register/finish"+query, nil)
+	require.Equal(t, http.StatusOK, w.Code, w.Body.String())
+	require.Len(t, o.identity(t).WebAuthnCredentials["webauthn"], 1)
+	require.True(t, o.validated(t))
+}
+
+// A user who has every factor, or none, passes them in the order of the chain.
+func TestOrderFollowsTheChainForAllOrNone(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		identity func(t *testing.T) storage.UserIdentity
+	}{
+		{name: "none", identity: func(*testing.T) storage.UserIdentity { return storage.UserIdentity{} }},
+		{name: "all", identity: func(t *testing.T) storage.UserIdentity {
+			return storage.UserIdentity{
+				MFASecrets:          map[string]*storage.MFASecret{"totp": orderCode(t)},
+				WebAuthnCredentials: orderKey(),
+			}
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := newOrderTest(t, tc.identity(t))
+			require.Contains(t, o.entry(t), "authenticator=totp")
+			require.Equal(t, http.StatusOK, o.serve(t, http.MethodGet, o.factorURL("totp"), nil).Code)
+
+			next, err := o.h.CompleteStep(t.Context(), o.authReq, "totp")
+			require.NoError(t, err)
+			require.Contains(t, next, "authenticator=webauthn")
+			next, err = o.h.CompleteStep(t.Context(), o.authReq, "webauthn")
+			require.NoError(t, err)
+			require.Contains(t, next, "/auth?")
+			require.True(t, o.validated(t))
+		})
+	}
+}
+
+// The factors passed in a login count for the user who passed them. A request another user signed in before keeps
+// that user's passes, also from a dex that recorded no user with them: they let the next user neither skip a factor
+// nor register one before it.
+func TestOrderPassesOfAnotherUserCountForNothing(t *testing.T) {
+	for _, tc := range []struct{ name, state string }{
+		{name: "passed by another user", state: `{"deckhousePassed":["totp"],"deckhousePassedUserID":"user-0","deckhousePassedConnectorID":"mock"}`},
+		{name: "passed through another connector", state: `{"deckhousePassed":["totp"],"deckhousePassedUserID":"user-1","deckhousePassedConnectorID":"other"}`},
+		{name: "recorded with no user", state: `{"deckhousePassed":["totp"]}`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := newOrderTest(t, storage.UserIdentity{MFASecrets: map[string]*storage.MFASecret{"totp": orderCode(t)}})
+			require.NoError(t, o.store.UpdateAuthRequest(t.Context(), o.authReq.ID, func(a storage.AuthRequest) (storage.AuthRequest, error) {
+				a.WebAuthnSessionData = []byte(tc.state)
+				return a, nil
+			}))
+
+			require.Contains(t, o.entry(t), "authenticator=totp", "the code of this user is asked first")
+			w := o.serve(t, http.MethodGet, o.factorURL("webauthn"), nil)
+			require.Equal(t, http.StatusSeeOther, w.Code, "the key is not registered before the code of this user")
+			w = o.serve(t, http.MethodPost, strings.Replace(o.factorURL("webauthn"), "/mfa/webauthn?", "/mfa/webauthn/register/begin?", 1), nil)
+			require.Equal(t, http.StatusForbidden, w.Code)
+			require.Empty(t, o.identity(t).WebAuthnCredentials["webauthn"])
+			require.False(t, o.validated(t))
+		})
+	}
+}
