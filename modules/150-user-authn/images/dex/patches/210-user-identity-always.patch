+func TestCompleted(t *testing.T) {
+	tests := []struct {
+		name      string
+		lastLogin time.Time
+		at        time.Time
+		want      time.Time
+	}{
+		{name: "login after a second factor", at: t0, want: t0},
+		{name: "repeated for the same login", lastLogin: t0, at: t0, want: t0},
+		{name: "never moves back", lastLogin: t0, at: t0.Add(-time.Hour), want: t0},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s := newStorage(t)
+			require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{UserID: "jane", ConnectorID: "local", LastLogin: tc.lastLogin}))
+
+			require.NoError(t, Completed(ctx, s, "jane", "local", tc.at))
+
+			got, err := s.GetUserIdentity(ctx, "jane", "local")
+			require.NoError(t, err)
+			require.Equal(t, tc.want, got.LastLogin)
+		})
+	}
+
+	t.Run("pair without an identity", func(t *testing.T) {
+		require.NoError(t, Completed(t.Context(), newStorage(t), "jane", "local", t0))
+	})
+}
+
+// failingGet fails every read of an identity.
+type failingGet struct {
+	storage.Storage
+}
+
+var errStorage = errors.New("storage unavailable")
+
+func (failingGet) GetUserIdentity(context.Context, string, string) (storage.UserIdentity, error) {
+	return storage.UserIdentity{}, errStorage
+}
+
+func TestCheckBlocked(t *testing.T) {
+	ctx := t.Context()
+	s := newStorage(t)
+	require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{UserID: "locked", ConnectorID: "ldap", BlockedUntil: t0.Add(time.Hour)}))
+	require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{UserID: "expired", ConnectorID: "ldap", BlockedUntil: t0.Add(-time.Hour)}))
+	require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{UserID: "free", ConnectorID: "ldap"}))
+
+	var blocked *BlockedError
+	require.ErrorAs(t, CheckBlocked(ctx, s, "locked", "ldap", t0), &blocked)
+	require.Equal(t, t0.Add(time.Hour), blocked.Until)
+	require.NoError(t, CheckBlocked(ctx, s, "expired", "ldap", t0))
+	require.NoError(t, CheckBlocked(ctx, s, "free", "ldap", t0))
+	require.NoError(t, CheckBlocked(ctx, s, "unknown", "ldap", t0), "a pair without an identity is not locked")
+	require.NoError(t, CheckBlocked(ctx, s, "locked", "local", t0), "the lock is per connector")
+
+	err := CheckBlocked(ctx, failingGet{Storage: s}, "locked", "ldap", t0)
+	require.ErrorIs(t, err, errStorage)
+	require.False(t, errors.As(err, &blocked))
+}
