+	t.Setenv("DEX_SESSIONS_ENABLED", "false")
+
+	c := Config{MFA: MFAConfig{
+		Authenticators:  []MFAAuthenticator{{ID: "totp", Type: "TOTP", ConnectorTypes: []string{"local"}}},
+		DefaultMFAChain: []string{"totp"},
+	}}
+	require.NoError(t, c.validateMFA())
+}
+
+// An authenticator bound to a connector type Dex does not know would ask nobody, and the users of the type meant would
+// sign in without it (Deckhouse).
+func TestValidateMFARefusesAnUnknownConnectorType(t *testing.T) {
+	for _, tc := range []struct {
+		types   []string
+		wantErr bool
+	}{
+		{types: []string{"local", "ldap", "atlassian-crowd"}},
+		{types: nil},
+		{types: []string{"crowd"}, wantErr: true},
+		{types: []string{"local", "LDAP"}, wantErr: true},
+	} {
+		c := Config{MFA: MFAConfig{
+			Authenticators:  []MFAAuthenticator{{ID: "totp", Type: "TOTP", ConnectorTypes: tc.types}},
+			DefaultMFAChain: []string{"totp"},
+		}}
+		err := c.validateMFA()
+		if tc.wantErr {
+			require.ErrorContains(t, err, "unknown connector type", "%v", tc.types)
+		} else {
+			require.NoError(t, err, "%v", tc.types)
+		}
+	}
+}
