+// TestSameClaims changes every field of storage.Claims in turn: a field added
+// upstream that sameClaims does not compare fails it.
+func TestSameClaims(t *testing.T) {
+	require.True(t, sameClaims(claims, claims))
+	require.True(t, sameClaims(storage.Claims{Groups: nil}, storage.Claims{Groups: []string{}}))
+
+	typ := reflect.TypeFor[storage.Claims]()
+	for i := range typ.NumField() {
+		field := typ.Field(i)
+		t.Run(field.Name, func(t *testing.T) {
+			changed := claims
+			v := reflect.ValueOf(&changed).Elem().Field(i)
+			switch v.Kind() { //nolint:exhaustive // a new kind of field fails the test below
+			case reflect.String:
+				v.SetString(v.String() + "-changed")
+			case reflect.Bool:
+				v.SetBool(!v.Bool())
+			case reflect.Slice:
+				v.Set(reflect.Append(v, reflect.ValueOf("changed")))
+			default:
+				t.Fatalf("storage.Claims.%s of kind %s: compare it in sameClaims and here", field.Name, v.Kind())
+			}
+			require.False(t, sameClaims(claims, changed))
+		})
+	}
+}
