@@ -0,0 +1,29 @@
+package grants
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"net/http"
+
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/server/useridentity"
+)
+
+// identityError maps the outcome of recording a user identity or checking its
+// lock to the token response, or returns nil when err is nil. A locked account
+// gets access_denied with HTTP 429, as from the v2.44-based Deckhouse dex.
+// attrs name the request in the log line.
+func identityError(ctx context.Context, logger *slog.Logger, err error, attrs ...any) *oauth2.Error {
+	var blocked *useridentity.BlockedError
+	switch {
+	case err == nil:
+		return nil
+	case errors.As(err, &blocked):
+		logger.WarnContext(ctx, "token request rejected for locked account", append(attrs, "blocked_until", blocked.Until)...)
+		return &oauth2.Error{Type: oauth2.AccessDenied, Description: "Account locked", Status: http.StatusTooManyRequests}
+	default:
+		logger.ErrorContext(ctx, "failed to read the user identity", append(attrs, "err", err)...)
+		return &oauth2.Error{Type: oauth2.ServerError, Status: http.StatusInternalServerError}
+	}
+}
