+
+// The user identity keeps the groups the connector gave, whatever the
+// allow-lists of the client let into the tokens; a login they refuse records
+// nothing.
+func TestPasswordGrantRecordsConnectorGroups(t *testing.T) {
+	s := newAllowListServer(t, allowListLimits{client: storage.Client{AllowedGroups: []string{"developers"}}})
+
+	rr := postAllowListToken(t, s, allowListPasswordGrant)
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	require.Equal(t, []string{"developers"}, tokenGroups(t, rr, "id_token"))
+	ui, err := s.storage.GetUserIdentity(t.Context(), allowListUserID, connectors.LocalConnector)
+	require.NoError(t, err)
+	require.Equal(t, allowListGroups, ui.Claims.Groups)
+
+	s = newAllowListServer(t, allowListLimits{client: storage.Client{AllowedGroups: []string{"guests"}}})
+	rr = postAllowListToken(t, s, allowListPasswordGrant)
+	require.Equal(t, http.StatusUnauthorized, rr.Code, rr.Body.String())
+	_, err = s.storage.GetUserIdentity(t.Context(), allowListUserID, connectors.LocalConnector)
+	require.ErrorIs(t, err, storage.ErrNotFound)
+}
+
+// Parallel password grants of one user, as basic-auth-proxy sends them, all get
+// their tokens. On the kubernetes storage they conflict on the user identity
+// whenever each of them writes it.
+func TestParallelPasswordGrants(t *testing.T) {
+	const grants = 32
+	tests := []struct {
+		name    string
+		storage func(t *testing.T) storage.Storage
+	}{
+		{name: "memory storage", storage: func(*testing.T) storage.Storage { return nil }},
+		{name: "kubernetes storage", storage: newFakeKubernetesStorage},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			_, s := newLockTestServerWith(t, tc.storage(t))
+			// No refresh token: one would make every grant rewrite the offline
+			// session of the user as well, an upstream write that conflicts the
+			// same way.
+			form := url.Values{
+				"grant_type": {oauth2.GrantTypePassword},
+				"scope":      {"openid email profile groups"},
+				"username":   {"test"},
+				"password":   {"test"},
+			}
+
+			for round := range 2 { // the first logins of the pair, then the next ones
+				codes := make([]int, grants)
+				var wg sync.WaitGroup
+				for i := range grants {
+					wg.Go(func() {
+						rr := postToken(t, s, form)
+						codes[i] = rr.Code
+					})
+				}
+				wg.Wait()
+				for i, code := range codes {
+					require.Equal(t, http.StatusOK, code, "round %d, grant %d", round, i)
+				}
+			}
+
+			ui, err := s.storage.GetUserIdentity(t.Context(), mockUserID, "test")
+			require.NoError(t, err)
+			require.Equal(t, "kilgore@kilgore.trout", ui.Claims.Email)
+			require.WithinDuration(t, time.Now(), ui.LastLogin, time.Minute)
+		})
+	}
+}
+
+func TestPasswordGrantOfLockedAccount(t *testing.T) {
+	_, s := newLockTestServer(t)
+	setBlockedUntil(t, s, "test", time.Now().Add(time.Hour))
+
+	requireAccountLocked(t, passwordGrant(t, s))
+
+	setBlockedUntil(t, s, "test", time.Now().Add(-time.Second))
+	require.Equal(t, http.StatusOK, passwordGrant(t, s).Code)
+}
+
+func TestRefreshOfLockedAccount(t *testing.T) {
+	_, s := newLockTestServer(t)
+	rr := passwordGrant(t, s)
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	var tokens struct {
+		RefreshToken string `json:"refresh_token"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &tokens))
+	require.NotEmpty(t, tokens.RefreshToken)
+	refresh := url.Values{"grant_type": {oauth2.GrantTypeRefreshToken}, "refresh_token": {tokens.RefreshToken}}
+
+	setBlockedUntil(t, s, "test", time.Now().Add(time.Hour))
+	requireAccountLocked(t, postToken(t, s, refresh))
+
+	// The refresh token survives the lock.
+	setBlockedUntil(t, s, "test", time.Time{})
+	require.Equal(t, http.StatusOK, postToken(t, s, refresh).Code)
+}
+
+func TestTokenExchangeOfLockedAccount(t *testing.T) {
+	_, s := newLockTestServer(t)
+	exchange := url.Values{
+		"grant_type":         {oauth2.GrantTypeTokenExchange},
+		"connector_id":       {"mock"},
+		"scope":              {"openid"},
+		"subject_token_type": {oauth2.TokenTypeID},
+		"subject_token":      {"foobar"},
+	}
+
+	rr := postToken(t, s, exchange)
+	require.Equal(t, http.StatusOK, rr.Code, "a user without an identity is not locked: %s", rr.Body.String())
+
+	setBlockedUntil(t, s, "mock", time.Now().Add(time.Hour))
+	requireAccountLocked(t, postToken(t, s, exchange))
+}
