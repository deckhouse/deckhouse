+	_, err := server.finalizeLogin(ctx, connector.Identity{UserID: "user-1", Email: "user@example.com"}, authReq, nil)
+	require.NoError(t, err)
+
+	ui, err := server.Storage.GetUserIdentity(ctx, "user-1", "mock")
+	require.NoError(t, err)
+	require.Equal(t, "user@example.com", ui.Claims.Email)
+	require.True(t, ui.LastLogin.IsZero())
+}
