@@ -0,0 +1,65 @@
+package authflow
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/mfa"
+	"github.com/dexidp/dex/storage"
+)
+
+// TestDispatchRecordsLastLoginAfterSecondFactor checks that a login counts as
+// the last login only once its second factor is done, and only once.
+func TestDispatchRecordsLastLoginAfterSecondFactor(t *testing.T) {
+	httpServer, server := newTestHandler(t, func(c *testFlowConfig) {
+		c.MFAProviders = map[string]mfa.Provider{"totp": mfa.NewTOTPProvider("test-issuer", nil)}
+		c.DefaultMFAChain = []string{"totp"}
+	})
+	defer httpServer.Close()
+	ctx := t.Context()
+
+	require.NoError(t, server.Storage.CreateClient(ctx, storage.Client{
+		ID: "example-app", Secret: "secret", RedirectURIs: []string{"https://example.com/callback"},
+	}))
+	authTime := time.Now().Add(-time.Minute).Truncate(time.Second)
+	authReq := storage.AuthRequest{
+		ID: "login-req", ClientID: "example-app", ConnectorID: "mock",
+		ResponseTypes: []string{"code"}, Scopes: []string{"openid"},
+		RedirectURI: "https://example.com/callback", Expiry: time.Now().Add(time.Hour),
+		LoggedIn: true, AuthTime: authTime, Claims: storage.Claims{UserID: "user-1"},
+	}
+	require.NoError(t, server.Storage.CreateAuthRequest(ctx, authReq))
+	require.NoError(t, server.Storage.CreateUserIdentity(ctx, storage.UserIdentity{UserID: "user-1", ConnectorID: "mock"}))
+	lastLogin := func() time.Time {
+		ui, err := server.Storage.GetUserIdentity(ctx, "user-1", "mock")
+		require.NoError(t, err)
+		return ui.LastLogin
+	}
+
+	// The second factor is pending: the dispatcher sends the user to it.
+	w := httptest.NewRecorder()
+	server.dispatch(w, httptest.NewRequest(http.MethodGet, "/auth", nil), authReq, false)
+	require.Equal(t, http.StatusSeeOther, w.Code)
+	require.Contains(t, w.Header().Get("Location"), "/mfa")
+	require.True(t, lastLogin().IsZero())
+
+	// The second factor is done: the login counts from the time the first one passed.
+	authReq.MFAValidated = true
+	w = httptest.NewRecorder()
+	server.dispatch(w, httptest.NewRequest(http.MethodGet, "/auth", nil), authReq, false)
+	require.Equal(t, authTime, lastLogin())
+
+	// A session login continues the login it was issued from and records nothing.
+	require.NoError(t, server.Storage.UpdateUserIdentity(ctx, "user-1", "mock", func(u storage.UserIdentity) (storage.UserIdentity, error) {
+		u.LastLogin = authTime.Add(time.Second)
+		return u, nil
+	}))
+	authReq.ID = "session-req"
+	require.NoError(t, server.Storage.CreateAuthRequest(ctx, authReq))
+	server.dispatch(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/auth", nil), authReq, false)
+	require.Equal(t, authTime.Add(time.Second), lastLogin(), "LastLogin never moves back")
+}
