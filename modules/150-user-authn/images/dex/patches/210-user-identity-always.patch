+func TestFinalizeLoginBlockedAccountWithoutSessions(t *testing.T) {
+	httpServer, server := newTestHandler(t, nil)
+	defer httpServer.Close()
+	ctx := t.Context()
+
+	authReq := storage.AuthRequest{ID: "login-req", ClientID: "example-app", Expiry: time.Now().Add(time.Hour), ConnectorID: "mock"}
+	require.NoError(t, server.Storage.CreateClient(ctx, storage.Client{ID: "example-app"}))
+	require.NoError(t, server.Storage.CreateAuthRequest(ctx, authReq))
+	lastLogin := time.Now().Add(-time.Hour).Truncate(time.Second)
+	require.NoError(t, server.Storage.CreateUserIdentity(ctx, storage.UserIdentity{
+		UserID: "user-1", ConnectorID: "mock", LastLogin: lastLogin, BlockedUntil: time.Now().Add(time.Hour),
