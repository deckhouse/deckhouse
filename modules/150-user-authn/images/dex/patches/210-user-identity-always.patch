diff --git a/server/kubernetes_fake_test.go b/server/kubernetes_fake_test.go
new file mode 100644
index 00000000..b9cc60b4
--- /dev/null
+++ b/server/kubernetes_fake_test.go
@@ -0,0 +1,187 @@
+package server
+
+import (
+	"encoding/json"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/kubernetes"
+)
+
+// fakeKubernetesAPI serves, in memory, the part of the Kubernetes API the
+// kubernetes storage uses, with the optimistic concurrency of the real one: a PUT
+// that carries another resourceVersion than the stored object gets 409 Conflict.
+// Parallel writes of one object conflict as they do in a cluster, which the
+// memory storage, serialized by one mutex, never shows.
+type fakeKubernetesAPI struct {
+	mu      sync.Mutex
+	objects map[string]map[string]any // by path
+	version int
+}
+
+// The path of an object is /apis/<group>/<version>/namespaces/<ns>/<resource>/<name>;
+// a path one segment shorter is the collection of its resource.
+const fakeKubernetesObjectSegments = 7
+
+func (f *fakeKubernetesAPI) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if r.URL.Path == "/version" {
+		writeFakeKubernetesJSON(w, http.StatusOK, map[string]any{"gitVersion": "v1.33.0"})
+		return
+	}
+	segments := strings.Split(strings.Trim(r.URL.Path, "/"), "/")
+	isObject := len(segments) == fakeKubernetesObjectSegments
+
+	f.mu.Lock()
+	defer f.mu.Unlock()
+
+	switch {
+	case r.Method == http.MethodGet && isObject:
+		obj, ok := f.objects[r.URL.Path]
+		if !ok {
+			writeFakeKubernetesJSON(w, http.StatusNotFound, map[string]any{})
+			return
+		}
+		writeFakeKubernetesJSON(w, http.StatusOK, obj)
+	case r.Method == http.MethodGet:
+		f.list(w, r.URL.Path)
+	case r.Method == http.MethodPost:
+		obj, ok := readFakeKubernetesObject(w, r)
+		if !ok {
+			return
+		}
+		p := r.URL.Path + "/" + fakeKubernetesMetadata(obj)["name"].(string)
+		if _, exists := f.objects[p]; exists {
+			writeFakeKubernetesJSON(w, http.StatusConflict, map[string]any{})
+			return
+		}
+		f.store(p, obj)
+		writeFakeKubernetesJSON(w, http.StatusCreated, obj)
+	case r.Method == http.MethodPut && isObject:
+		obj, ok := readFakeKubernetesObject(w, r)
+		if !ok {
+			return
+		}
+		stored, exists := f.objects[r.URL.Path]
+		if !exists {
+			writeFakeKubernetesJSON(w, http.StatusNotFound, map[string]any{})
+			return
+		}
+		if fakeKubernetesMetadata(obj)["resourceVersion"] != fakeKubernetesMetadata(stored)["resourceVersion"] {
+			writeFakeKubernetesJSON(w, http.StatusConflict, map[string]any{})
+			return
+		}
+		f.store(r.URL.Path, obj)
+		writeFakeKubernetesJSON(w, http.StatusOK, obj)
+	case r.Method == http.MethodDelete && isObject:
+		if _, exists := f.objects[r.URL.Path]; !exists {
+			writeFakeKubernetesJSON(w, http.StatusNotFound, map[string]any{})
+			return
+		}
+		delete(f.objects, r.URL.Path)
+		writeFakeKubernetesJSON(w, http.StatusOK, map[string]any{})
+	default:
+		writeFakeKubernetesJSON(w, http.StatusMethodNotAllowed, map[string]any{})
+	}
+}
+
+// store keeps obj at p under a new resourceVersion.
+func (f *fakeKubernetesAPI) store(p string, obj map[string]any) {
+	f.version++
+	fakeKubernetesMetadata(obj)["resourceVersion"] = strconv.Itoa(f.version)
+	f.objects[p] = obj
+}
+
+// list answers the objects of collection, in path order.
+func (f *fakeKubernetesAPI) list(w http.ResponseWriter, collection string) {
+	var paths []string
+	for p := range f.objects {
+		if name, ok := strings.CutPrefix(p, collection+"/"); ok && !strings.Contains(name, "/") {
+			paths = append(paths, p)
+		}
+	}
+	slices.Sort(paths)
+	items := make([]map[string]any, 0, len(paths))
+	for _, p := range paths {
+		items = append(items, f.objects[p])
+	}
+	writeFakeKubernetesJSON(w, http.StatusOK, map[string]any{"items": items})
+}
+
+func readFakeKubernetesObject(w http.ResponseWriter, r *http.Request) (map[string]any, bool) {
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		writeFakeKubernetesJSON(w, http.StatusBadRequest, map[string]any{})
+		return nil, false
+	}
+	var obj map[string]any
+	if err := json.Unmarshal(body, &obj); err != nil {
+		writeFakeKubernetesJSON(w, http.StatusBadRequest, map[string]any{})
+		return nil, false
+	}
+	if _, ok := fakeKubernetesMetadata(obj)["name"].(string); !ok {
+		writeFakeKubernetesJSON(w, http.StatusBadRequest, map[string]any{})
+		return nil, false
+	}
+	return obj, true
+}
+
+// fakeKubernetesMetadata returns the metadata of obj, adding it when missing.
+func fakeKubernetesMetadata(obj map[string]any) map[string]any {
+	meta, ok := obj["metadata"].(map[string]any)
+	if !ok {
+		meta = map[string]any{}
+		obj["metadata"] = meta
+	}
+	return meta
+}
+
+func writeFakeKubernetesJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(v)
+}
+
+// newFakeKubernetesStorage returns the kubernetes storage of dex on a
+// fakeKubernetesAPI.
+func newFakeKubernetesStorage(t *testing.T) storage.Storage {
+	t.Helper()
+	api := httptest.NewServer(&fakeKubernetesAPI{objects: map[string]map[string]any{}})
+	t.Cleanup(api.Close)
+
+	kubeconfig := filepath.Join(t.TempDir(), "kubeconfig")
+	require.NoError(t, os.WriteFile(kubeconfig, []byte(`apiVersion: v1
+kind: Config
+clusters:
+- name: fake
+  cluster:
+    server: `+api.URL+`
+users:
+- name: fake
+  user: {}
+contexts:
+- name: fake
+  context:
+    cluster: fake
+    user: fake
+    namespace: dex
+current-context: fake
+`), 0o600))
+
+	config := kubernetes.Config{KubeConfigFile: kubeconfig, CRDHandling: "check"}
+	s, err := config.Open(slog.New(slog.DiscardHandler))
+	require.NoError(t, err)
+	t.Cleanup(func() { s.Close() })
+	return s
+}
