+// unknownAuthenticatorError is the refusal of a chain that names an authenticator Dex does not have (Deckhouse).
+// chainForClient returns it unwrapped, so handleMFA can tell it from a storage error.
+type unknownAuthenticatorError struct {
+	clientID        string
+	authenticatorID string
+}
+
+func (e unknownAuthenticatorError) Error() string {
+	return fmt.Sprintf("the MFA chain of client %q names the unknown authenticator %q", e.clientID, e.authenticatorID)
+}
+
+// misconfiguredSignIn is what the user sees when the chain of the client names an unknown authenticator: the
+// cause is the configuration of the client, not the storage, and only an administrator can fix it (Deckhouse).
+const misconfiguredSignIn = "The second factor of this application is misconfigured. Contact your administrator."
