+}
+
+// newLockTestServerWith is newLockTestServer on st, the memory storage when nil.
+func newLockTestServerWith(t *testing.T, st storage.Storage) (*httptest.Server, *Server) {
+	t.Helper()
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.PasswordConnector = "test"
+		c.Now = time.Now
+		if st != nil {
+			c.Storage = st
+		}
+	})
+	t.Cleanup(httpServer.Close)
+	mockConnectorDataTestStorage(t, s.storage)
+	return httpServer, s
+}
+
+func postToken(t *testing.T, s *Server, form url.Values) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodPost, s.issuerURL.String()+"/token", strings.NewReader(form.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth("test", "barfoo")
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	return rr
+}
+
+func passwordGrant(t *testing.T, s *Server) *httptest.ResponseRecorder {
+	t.Helper()
+	return postToken(t, s, url.Values{
+		"grant_type": {oauth2.GrantTypePassword},
+		"scope":      {"openid email offline_access"},
+		"username":   {"test"},
+		"password":   {"test"},
+	})
+}
+
+func setBlockedUntil(t *testing.T, s *Server, connectorID string, until time.Time) {
+	t.Helper()
+	ctx := t.Context()
+	err := s.storage.UpdateUserIdentity(ctx, mockUserID, connectorID, func(u storage.UserIdentity) (storage.UserIdentity, error) {
+		u.BlockedUntil = until
+		return u, nil
+	})
+	if err == storage.ErrNotFound {
+		err = s.storage.CreateUserIdentity(ctx, storage.UserIdentity{UserID: mockUserID, ConnectorID: connectorID, BlockedUntil: until})
+	}
+	require.NoError(t, err)
+}
+
+func requireAccountLocked(t *testing.T, rr *httptest.ResponseRecorder) {
+	t.Helper()
+	require.Equal(t, http.StatusTooManyRequests, rr.Code, rr.Body.String())
+	var resp struct {
+		Error string `json:"error"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &resp))
+	require.Equal(t, oauth2.AccessDenied, resp.Error)
+}
+
+// A login through the password grant is recorded like a browser login, sessions
+// or not.
+func TestPasswordGrantRecordsUserIdentity(t *testing.T) {
+	_, s := newLockTestServer(t)
+
+	rr := passwordGrant(t, s)
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+
+	ui, err := s.storage.GetUserIdentity(t.Context(), mockUserID, "test")
+	require.NoError(t, err)
