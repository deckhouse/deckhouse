+func newTypesTestClient() *client {
+	return &client{
+		hash:       func() hash.Hash { return fnv.New64() },
+		namespace:  "dex",
+		apiVersion: "dex.coreos.com/v1",
+	}
+}
+
+func TestPasswordPolicyFieldsRoundTrip(t *testing.T) {
+	cli := newTypesTestClient()
+	updatedAt := time.Date(2026, 10, 1, 12, 0, 0, 0, time.UTC)
+	want := storage.Password{
+		Email:                           "jane@example.com",
+		Hash:                            []byte("hash-3"),
+		Username:                        "jane",
+		UserID:                          "jane",
+		Groups:                          []string{"admins"},
+		PreviousHashes:                  [][]byte{[]byte("hash-1"), []byte("hash-2")},
+		HashUpdatedAt:                   updatedAt,
+		RequireResetHashOnNextSuccLogin: true,
+		IncorrectPasswordLoginAttempts:  3,
+	}
+
+	raw, err := json.Marshal(cli.fromStoragePassword(want))
+	require.NoError(t, err)
+	var decoded Password
+	require.NoError(t, json.Unmarshal(raw, &decoded))
+
+	require.Equal(t, want, toStoragePassword(decoded))
+}
+
+// TestPasswordReadsObjectsOfPreviousRelease reads a Password object in the form
+// the v2.44-based Deckhouse dex and the user-authn controller write it: a new dex
+// that dropped one of these fields would erase it on the next update.
+func TestPasswordReadsObjectsOfPreviousRelease(t *testing.T) {
+	const object = `{
+		"apiVersion": "dex.coreos.com/v1",
+		"kind": "Password",
+		"metadata": {"name": "nfuxe3tbfzsxqylnobwgkltdn5wsfr4", "namespace": "d8-user-authn"},
+		"email": "jane@example.com",
+		"hash": "aGFzaC0z",
+		"username": "jane",
+		"userID": "jane",
+		"groups": ["admins"],
+		"hashUpdatedAt": "2026-10-01T12:00:00Z",
+		"previousHashes": ["aGFzaC0x", "aGFzaC0y"],
+		"requireResetHashOnNextSuccLogin": true,
+		"incorrectPasswordLoginAttempts": 3
+	}`
+
+	var p Password
+	require.NoError(t, json.Unmarshal([]byte(object), &p))
+	got := toStoragePassword(p)
+
+	require.Equal(t, [][]byte{[]byte("hash-1"), []byte("hash-2")}, got.PreviousHashes)
+	require.Equal(t, time.Date(2026, 10, 1, 12, 0, 0, 0, time.UTC), got.HashUpdatedAt)
+	require.True(t, got.RequireResetHashOnNextSuccLogin)
+	require.Equal(t, uint64(3), got.IncorrectPasswordLoginAttempts)
+}
+
+func TestUserIdentityFailedAttemptsRoundTrip(t *testing.T) {
+	cli := newTypesTestClient()
+	want := storage.UserIdentity{
+		UserID:                         "uid=jane,ou=people",
+		ConnectorID:                    "ldap",
+		Claims:                         storage.Claims{UserID: "uid=jane,ou=people", Email: "jane@example.com"},
+		Consents:                       map[string][]string{},
+		IncorrectPasswordLoginAttempts: 4,
+	}
+
+	raw, err := json.Marshal(cli.fromStorageUserIdentity(want))
+	require.NoError(t, err)
+	require.Contains(t, string(raw), `"incorrectPasswordLoginAttempts":4`)
+
+	var decoded UserIdentity
+	require.NoError(t, json.Unmarshal(raw, &decoded))
+	require.Equal(t, want, toStorageUserIdentity(decoded))
+}
+
+// TestUserIdentityReadsAdminLock reads the lock of an administrator from the
+// annotation the user-authn controller writes, and never writes it back.
+func TestUserIdentityReadsAdminLock(t *testing.T) {
+	const blockedUntil = "2026-10-17T00:53:29.123456789Z"
+	read := func(t *testing.T, annotation string) storage.UserIdentity {
+		t.Helper()
+		var u UserIdentity
+		require.NoError(t, json.Unmarshal([]byte(`{
+			"apiVersion": "dex.coreos.com/v1",
+			"kind": "UserIdentity",
+			"metadata": {"name": "mfsgi2lo", "annotations": {"user-authn.deckhouse.io/admin-lock": "`+annotation+`"}},
+			"userID": "admin",
+			"connectorID": "local",
+			"blockedUntil": "`+blockedUntil+`"
+		}`), &u))
+		return toStorageUserIdentity(u)
+	}
+
+	got := read(t, blockedUntil)
+	require.True(t, got.AdminLockedUntil.Equal(got.BlockedUntil), "admin lock %s, blocked until %s", got.AdminLockedUntil, got.BlockedUntil)
+	require.Zero(t, read(t, "tomorrow").AdminLockedUntil, "a value that does not parse is no lock")
+
+	raw, err := json.Marshal(newTypesTestClient().fromStorageUserIdentity(got))
+	require.NoError(t, err)
+	require.NotContains(t, string(raw), adminLockAnnotation)
+}
