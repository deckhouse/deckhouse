+	var name string
+	switch r.Type {
+	case storage.RevocationPair:
+		name = fmt.Sprintf("pair-%s-g%d", pair, r.Generation)
+	case storage.RevocationSession:
+		name = "session-" + r.SessionID
+	case storage.RevocationGrant:
