+func TestAuthRequestPasswordChangeBindingRoundTrip(t *testing.T) {
+	cli := newTypesTestClient()
+	want := storage.AuthRequest{
+		ID:                    "req",
+		ClientID:              "client",
+		RedirectURI:           "https://client.example.com/callback",
+		ConnectorID:           "local",
+		Expiry:                time.Date(2026, 10, 1, 12, 10, 0, 0, time.UTC),
+		HMACKey:               []byte("key"),
+		MaxAge:                -1,
+		PasswordChangeBinding: []byte("sha-256 of the cookie"),
+		PendingPasswordChange: "/dex/password/change?req=req",
