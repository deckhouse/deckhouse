+			Namespace: cli.namespace,
+			Labels: map[string]string{
+				revocationTypeLabel: string(r.Type),
+				revocationPairLabel: pair,
+			},
+		},
+		Type:        r.Type,
+		ConnectorID: r.ConnectorID,
+		UserID:      r.UserID,
+		Subject:     r.Subject,
+		Generation:  r.Generation,
+		SessionID:   r.SessionID,
+		GrantID:     r.GrantID,
+		ClientID:    r.ClientID,
+		Clients:     r.Clients,
+		Reason:      r.Reason,
+		Source:      r.Source,
+		CreatedAt:   r.CreatedAt,
+	}, nil
+}
+
+func toStorageRevocation(r Revocation) storage.Revocation {
+	return storage.Revocation{
+		Type:        r.Type,
+		ConnectorID: r.ConnectorID,
+		UserID:      r.UserID,
+		Subject:     r.Subject,
+		Generation:  r.Generation,
+		SessionID:   r.SessionID,
+		GrantID:     r.GrantID,
+		ClientID:    r.ClientID,
+		Clients:     r.Clients,
+		Reason:      r.Reason,
+		Source:      r.Source,
+		CreatedAt:   r.CreatedAt,
+	}
+}
