+// schemaAPI answers the requests the storage makes for single objects, the way
+// the Kubernetes API does, and keeps every object as the JSON last written.
+type schemaAPI struct {
+	mu      sync.Mutex
+	objects map[string][]byte
+}
+
+func (f *schemaAPI) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+
+	switch r.Method {
+	case http.MethodGet:
+		obj, ok := f.objects[r.URL.Path]
+		if !ok {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		w.Write(obj)
+	case http.MethodPost:
+		body, _ := io.ReadAll(r.Body)
+		var meta struct {
+			Metadata struct {
+				Name string `json:"name"`
+			} `json:"metadata"`
+		}
+		if err := json.Unmarshal(body, &meta); err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		p := r.URL.Path + "/" + meta.Metadata.Name
+		if _, ok := f.objects[p]; ok {
+			w.WriteHeader(http.StatusConflict)
+			return
+		}
+		f.objects[p] = body
+		w.WriteHeader(http.StatusCreated)
+	case http.MethodPut:
+		body, _ := io.ReadAll(r.Body)
+		f.objects[r.URL.Path] = body
+		w.Write(body)
+	default:
+		w.WriteHeader(http.StatusMethodNotAllowed)
+	}
+}
+
+func newSchemaAPIClient(t *testing.T) (*client, *schemaAPI) {
+	t.Helper()
+	api := &schemaAPI{objects: map[string][]byte{}}
+	server := httptest.NewServer(api)
+	t.Cleanup(server.Close)
+	return &client{
+		client:     server.Client(),
+		baseURL:    server.URL,
+		namespace:  "dex",
+		apiVersion: "dex.coreos.com/v1",
+		logger:     slog.New(slog.DiscardHandler),
+		hash:       func() hash.Hash { return fnv.New64() },
+	}, api
+}
+
+// object returns the object resource/name as stored, or nil.
+func (f *schemaAPI) object(t *testing.T, cli *client, resource, name string) map[string]any {
+	t.Helper()
+	u, err := cli.urlFor(cli.apiVersion, cli.namespace, resource, name)
+	require.NoError(t, err)
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	raw, ok := f.objects[u[len(cli.baseURL):]]
+	if !ok {
+		return nil
+	}
+	var obj map[string]any
+	require.NoError(t, json.Unmarshal(raw, &obj))
+	return obj
+}
+
+func (f *schemaAPI) set(t *testing.T, cli *client, resource, name, object string) {
+	t.Helper()
+	u, err := cli.urlFor(cli.apiVersion, cli.namespace, resource, name)
+	require.NoError(t, err)
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.objects[u[len(cli.baseURL):]] = []byte(object)
+}
