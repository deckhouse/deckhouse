+// TestRetryOnConflictTries: a write that conflicts is tried again after every
+// pause of conflictRetrySteps, and one that stops conflicting succeeds (Deckhouse).
+func TestRetryOnConflictTries(t *testing.T) {
+	conflicting := func(times int, calls *int) func() error {
+		return func() error {
+			*calls++
+			if *calls <= times {
+				return &httpErr{status: 409}
+			}
+			return nil
+		}
+	}
+
+	var calls int
+	require.NoError(t, retryOnConflict(t.Context(), conflicting(len(conflictRetrySteps), &calls)))
+	require.Equal(t, len(conflictRetrySteps)+1, calls, "the last try succeeds")
+
+	calls = 0
+	err := retryOnConflict(t.Context(), conflicting(len(conflictRetrySteps)+1, &calls))
+	require.ErrorContains(t, err, "maximum timeout reached while retrying a conflicted request")
+	require.Equal(t, len(conflictRetrySteps)+1, calls, "no try after the last pause")
+}
