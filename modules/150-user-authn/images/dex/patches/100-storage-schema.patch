+}
+
+// TestClientReadsObjectsOfPreviousRelease reads an OAuth2Client in the form the
+// user-authn templates render a DexClient and a DexAuthenticator: a dex that
+// dropped the allow-lists would let everyone in.
+func TestClientReadsObjectsOfPreviousRelease(t *testing.T) {
+	const object = `{
+		"apiVersion": "dex.coreos.com/v1",
+		"kind": "OAuth2Client",
+		"metadata": {"name": "nbxwyzlsfzsxqylnobwgkltdn5wsfr4", "namespace": "d8-user-authn"},
+		"id": "dex-client-app@ns",
+		"name": "dex-client-app@ns",
+		"secret": "secret",
+		"redirectURIs": ["https://app.example.com/callback"],
+		"allowedEmails": ["jane@example.com"],
+		"allowedGroups": ["admins"]
+	}`
+
+	var c Client
+	require.NoError(t, json.Unmarshal([]byte(object), &c))
+	got := toStorageClient(c)
+
+	require.Equal(t, []string{"jane@example.com"}, got.AllowedEmails)
+	require.Equal(t, []string{"admins"}, got.AllowedGroups)
+}
+
+func TestConnectorAllowListsRoundTrip(t *testing.T) {
+	cli := newTypesTestClient()
+	want := storage.Connector{
+		ID:                  "corp",
+		Type:                "oidc",
+		Name:                "Corp",
+		Config:              []byte(`{"issuer":"https://idp.example.com"}`),
