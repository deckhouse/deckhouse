+// CreateRevocation keeps r. A revocation of the same credentials kept before
+// gives storage.ErrAlreadyExists.
+func (s *memStorage) CreateRevocation(ctx context.Context, r storage.Revocation) (err error) {
+	key := revocationKey{
+		typ:        r.Type,
+		pair:       compositeKeyID{userID: r.UserID, connID: r.ConnectorID},
+		generation: r.Generation,
+		sessionID:  r.SessionID,
+		grantID:    r.GrantID,
+	}
+	s.tx(func() {
+		if _, ok := s.revocations[key]; ok {
+			err = storage.ErrAlreadyExists
+		} else {
+			s.revocations[key] = r
+		}
+	})
+	return
+}
+
+// ListRevocations returns the revocations kept, oldest first. Only tests read
+// them: dex writes revocations for others and never reads them back.
+func (s *memStorage) ListRevocations(ctx context.Context) (revocations []storage.Revocation, err error) {
+	s.tx(func() {
+		for _, r := range s.revocations {
+			revocations = append(revocations, r)
+		}
+	})
+	slices.SortStableFunc(revocations, func(a, b storage.Revocation) int {
+		return a.CreatedAt.Compare(b.CreatedAt)
+	})
+	return
+}
