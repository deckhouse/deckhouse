+// TestUserIdentityGenerationIsReadOnly checks that dex never writes the
+// generation: a write that lost the race to the user-authn controller is
+// repeated on the object the controller wrote, and must not take the generation
+// back.
+func TestUserIdentityGenerationIsReadOnly(t *testing.T) {
+	ctx := t.Context()
+	cli, api := newSchemaAPIClient(t)
+	name := cli.offlineTokenName("jane", "ldap")
+
+	t.Run("create does not write it", func(t *testing.T) {
+		err := cli.CreateUserIdentity(ctx, storage.UserIdentity{
+			UserID:      "jane",
+			ConnectorID: "ldap",
+			Claims:      storage.Claims{UserID: "jane"},
+			Generation:  5,
+		})
+		require.NoError(t, err)
+		require.Nil(t, annotations(t, api.object(t, cli, resourceUserIdentity, name)))
+
+		got, err := cli.GetUserIdentity(ctx, "jane", "ldap")
+		require.NoError(t, err)
+		require.Zero(t, got.Generation)
+	})
+
+	t.Run("update keeps the controller's", func(t *testing.T) {
+		api.set(t, cli, resourceUserIdentity, name, `{
+			"metadata": {"name": "`+name+`", "annotations": {"user-authn.deckhouse.io/generation": "3", "example.com/other": "kept"}},
+			"userID": "jane",
+			"connectorID": "ldap",
+			"claims": {"userID": "jane"}
+		}`)
+
+		got, err := cli.GetUserIdentity(ctx, "jane", "ldap")
+		require.NoError(t, err)
+		require.Equal(t, uint64(3), got.Generation)
+
+		err = cli.UpdateUserIdentity(ctx, "jane", "ldap", func(old storage.UserIdentity) (storage.UserIdentity, error) {
+			require.Equal(t, uint64(3), old.Generation)
+			old.Generation = 7
+			old.Claims.Email = "jane@example.com"
+			return old, nil
+		})
+		require.NoError(t, err)
+
+		stored := api.object(t, cli, resourceUserIdentity, name)
+		require.Equal(t, map[string]any{
+			"user-authn.deckhouse.io/generation": "3",
+			"example.com/other":                  "kept",
+		}, annotations(t, stored))
+		require.Equal(t, "jane@example.com", stored["claims"].(map[string]any)["email"])
+	})
+
+	t.Run("a generation that does not parse fails reads and writes", func(t *testing.T) {
+		const object = `{
+			"metadata": {"name": "NAME", "annotations": {"user-authn.deckhouse.io/generation": "x"}},
+			"userID": "jane",
+			"connectorID": "ldap"
+		}`
+		api.set(t, cli, resourceUserIdentity, name, strings.ReplaceAll(object, "NAME", name))
+
+		_, err := cli.GetUserIdentity(ctx, "jane", "ldap")
+		require.ErrorContains(t, err, generationAnnotation)
+
+		err = cli.UpdateUserIdentity(ctx, "jane", "ldap", func(old storage.UserIdentity) (storage.UserIdentity, error) {
+			t.Fatal("updater called for an identity that does not parse")
+			return old, nil
+		})
+		require.ErrorContains(t, err, generationAnnotation)
+		require.Equal(t, "x", annotations(t, api.object(t, cli, resourceUserIdentity, name))[generationAnnotation])
+	})
+}
+
+func TestCreateRevocation(t *testing.T) {
+	ctx := t.Context()
+	cli, api := newSchemaAPIClient(t)
+	r := storage.Revocation{
+		Type:        storage.RevocationGrant,
+		ConnectorID: "local",
+		UserID:      "jane",
+		Subject:     "CgRqYW5lEgVsb2NhbA",
+		GrantID:     "3w4l2zgokgsohvjnqzjrv7lmz",
+		ClientID:    "kubeconfig-generator-0",
+		Clients:     []string{"kubeconfig-generator-0"},
+		Reason:      "TokenRevoked",
+		Source:      "dex",
+		CreatedAt:   time.Date(2026, 10, 16, 10, 0, 0, 0, time.UTC),
+	}
+
+	require.NoError(t, cli.CreateRevocation(ctx, r))
+	stored := api.object(t, cli, resourceRevocation, "grant-3w4l2zgokgsohvjnqzjrv7lmz")
+	require.NotNil(t, stored)
+	require.Equal(t, "Revocation", stored["kind"])
+	require.Equal(t, "grant", stored["type"])
+	require.Equal(t, "kubeconfig-generator-0", stored["clientID"])
+	require.Equal(t, map[string]any{
+		"user-authn.deckhouse.io/revocation-type": "grant",
+		"user-authn.deckhouse.io/pair":            cli.offlineTokenName("jane", "local"),
+	}, stored["metadata"].(map[string]any)["labels"])
+
+	// The same revocation written again is the same object.
+	require.ErrorIs(t, cli.CreateRevocation(ctx, r), storage.ErrAlreadyExists)
+}
