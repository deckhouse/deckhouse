+func TestRevocations(t *testing.T) {
+	ctx := t.Context()
+	s := New(slog.New(slog.DiscardHandler))
+	creator, ok := storage.AsRevocationCreator(s)
+	require.True(t, ok)
+
+	at := time.Date(2026, 10, 16, 10, 0, 0, 0, time.UTC)
+	grant := storage.Revocation{Type: storage.RevocationGrant, UserID: "jane", ConnectorID: "local", GrantID: "g1", CreatedAt: at.Add(time.Second)}
+	session := storage.Revocation{Type: storage.RevocationSession, UserID: "jane", ConnectorID: "local", SessionID: "s1", CreatedAt: at}
+	require.NoError(t, creator.CreateRevocation(ctx, grant))
+	require.NoError(t, creator.CreateRevocation(ctx, session))
+
+	// The same credentials revoked again are one revocation.
+	again := grant
+	again.CreatedAt = at.Add(time.Minute)
+	require.ErrorIs(t, creator.CreateRevocation(ctx, again), storage.ErrAlreadyExists)
+
+	got, err := s.(*memStorage).ListRevocations(ctx)
+	require.NoError(t, err)
+	require.Equal(t, []storage.Revocation{session, grant}, got)
