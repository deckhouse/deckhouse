+	var decoded AuthRequest
+	require.NoError(t, json.Unmarshal(raw, &decoded))
+
+	require.Equal(t, want, toStorageAuthRequest(decoded))
+}
+
+// TestCustomResourceDefinitionManifests keeps scripts/manifests/crds in step with
+// the resources the storage registers: Deckhouse ships these manifests and checks
+// its copy against them, so a resource without a manifest is never installed.
+func TestCustomResourceDefinitionManifests(t *testing.T) {
+	for _, crd := range customResourceDefinitions(crdAPIVersion) {
+		t.Run(crd.Spec.Names.Plural, func(t *testing.T) {
+			raw, err := os.ReadFile(filepath.Join("..", "..", "scripts", "manifests", "crds", crd.Spec.Names.Plural+".yaml"))
+			require.NoError(t, err)
+
+			var manifest struct {
+				Metadata struct {
+					Name string `json:"name"`
+				} `json:"metadata"`
+				Spec struct {
+					Group string `json:"group"`
+					Scope string `json:"scope"`
+					Names struct {
+						Kind     string `json:"kind"`
+						Plural   string `json:"plural"`
+						Singular string `json:"singular"`
+					} `json:"names"`
+				} `json:"spec"`
+			}
+			require.NoError(t, yaml.Unmarshal(raw, &manifest))
+
+			require.Equal(t, crd.ObjectMeta.Name, manifest.Metadata.Name)
+			require.Equal(t, crd.Spec.Group, manifest.Spec.Group)
+			require.Equal(t, string(crd.Spec.Scope), manifest.Spec.Scope)
+			require.Equal(t, crd.Spec.Names.Kind, manifest.Spec.Names.Kind)
+			require.Equal(t, crd.Spec.Names.Plural, manifest.Spec.Names.Plural)
+			require.Equal(t, crd.Spec.Names.Singular, manifest.Spec.Names.Singular)
+		})
+	}
+}
