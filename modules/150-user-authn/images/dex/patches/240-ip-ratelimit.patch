+package main
+
+import (
+	"testing"
+
+	"github.com/ghodss/yaml"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/ratelimit"
+)
+
+func TestRateLimitConfig(t *testing.T) {
+	// Unknown keys are refused, so a key the struct does not know fails the test.
+	t.Setenv("DEX_CONFIG_DISALLOW_UNKNOWN_FIELDS", "true")
+
+	tests := []struct {
+		name     string
+		raw      string
+		expected *ratelimit.Config
+	}{
+		{
+			name: "as Deckhouse renders it",
+			raw: `
+rateLimit:
+  enabled: true
+  perIP:
+    requestsPerMinute: 20
+    burst: 5
+`,
+			expected: &ratelimit.Config{RequestsPerMinute: 20, Burst: 5},
+		},
+		{
+			name: "defaults",
+			raw: `
+rateLimit:
+  enabled: true
+`,
+			expected: &ratelimit.Config{RequestsPerMinute: 10, Burst: 10},
+		},
+		{
+			name: "disabled",
+			raw: `
+rateLimit:
+  enabled: false
+  perIP:
+    requestsPerMinute: 20
+`,
+		},
+		{
+			name: "absent",
+			raw:  `issuer: https://dex.example.com`,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			data, err := yaml.YAMLToJSON([]byte(tc.raw))
+			require.NoError(t, err)
+
+			var c Config
+			require.NoError(t, configUnmarshaller(data, &c))
+			assert.Equal(t, tc.expected, c.RateLimit.config())
+		})
+	}
+}
