+func TestLimiterWrapCountsClientAddressesSeparately(t *testing.T) {
+	clock := newTestClock()
+	l := New(Config{RequestsPerMinute: 1, Burst: 2}, clock.Now, nil)
+	h := l.Wrap(&statusHandler{status: http.StatusUnauthorized})
+
+	for range 3 {
+		serve(h, requestFrom("192.0.2.1"))
+	}
+	require.Equal(t, http.StatusTooManyRequests, serve(h, requestFrom("192.0.2.1")).Code)
+
+	rr := serve(h, requestFrom("192.0.2.2"))
+	assert.Equal(t, http.StatusUnauthorized, rr.Code, "another client address has a bucket of its own")
+}
+
+func TestExempt(t *testing.T) {
+	clock := newTestClock()
+	l := New(Config{RequestsPerMinute: 1, Burst: 2}, clock.Now, nil)
+	exempt := true
+	h := l.Wrap(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if exempt {
+			Exempt(r.Context())
+		}
+		w.WriteHeader(http.StatusBadRequest)
+	}))
+
+	for range 5 {
+		require.Equal(t, http.StatusBadRequest, serve(h, requestFrom("192.0.2.1")).Code, "an exempted failure does not count")
+	}
+
+	exempt = false
+	for range 2 {
+		require.Equal(t, http.StatusBadRequest, serve(h, requestFrom("192.0.2.1")).Code, "a failure within the burst")
+	}
+	exempt = true
+	assert.Equal(t, http.StatusTooManyRequests, serve(h, requestFrom("192.0.2.1")).Code,
+		"an exempted request is still refused once the failures that count are used up")
+
+	assert.NotPanics(t, func() { Exempt(t.Context()) }, "outside a limited route nothing happens")
+}
