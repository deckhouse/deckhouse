+// TestRateLimitClientAddress checks that the limiter counts the client address
+// the router resolves, so clients behind one ingress pod are counted separately
+// whenever the router takes their address from the header (SC6).
+func TestRateLimitClientAddress(t *testing.T) {
+	peer := netip.MustParsePrefix("192.0.2.10/32")
+
+	tests := []struct {
+		name    string
+		header  string
+		trusted []netip.Prefix
+	}{
+		{name: "header from a trusted proxy", header: "X-Real-IP", trusted: []netip.Prefix{peer}},
+		{name: "header without trusted proxies", header: "X-Real-IP"},
+		{name: "no header", header: ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, s := newTestServer(t, func(c *Config) {
+				c.RateLimit = rateLimitTestConfig
+				c.RealIPHeader = tc.header
+				c.TrustedRealIPCIDRs = tc.trusted
+			})
+			defer httpServer.Close()
+
+			resolve := router.ParseRealIP(tc.header, tc.trusted)
+			addrOf := func(r *http.Request) string {
+				if tc.header == "" {
+					return ratelimit.ClientAddress(r)
+				}
+				addr, err := resolve(r)
+				require.NoError(t, err)
+				return addr
+			}
+
+			first, second := badClientTokenRequest("198.51.100.1"), badClientTokenRequest("198.51.100.2")
+			separate := addrOf(first) != addrOf(second)
+			if tc.trusted != nil {
+				require.True(t, separate, "a trusted proxy's header names the client")
+			}
+
+			for range 2 {
+				serveRequest(s, badClientTokenRequest("198.51.100.1"))
+			}
+			require.Equal(t, http.StatusTooManyRequests, serveRequest(s, badClientTokenRequest("198.51.100.1")).Code)
+
+			rr := serveRequest(s, badClientTokenRequest("198.51.100.2"))
+			if separate {
+				assert.Equal(t, http.StatusUnauthorized, rr.Code, "another client behind the same proxy has a bucket of its own")
+			} else {
+				assert.Equal(t, http.StatusTooManyRequests, rr.Code, "clients the router cannot tell apart share the peer's bucket")
+			}
+		})
+	}
+}
+
+func TestRateLimitDisabled(t *testing.T) {
+	httpServer, s := newTestServer(t, nil)
+	defer httpServer.Close()
+
+	for range 10 {
+		require.Equal(t, http.StatusUnauthorized, serveRequest(s, badClientTokenRequest("")).Code,
+			"without a rate limit config the routes are as upstream")
+	}
+}
