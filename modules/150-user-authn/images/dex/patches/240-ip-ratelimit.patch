+// Once the client is authenticated, only the password grant counts at the token
+// endpoint: a refresh token or a code cannot be guessed, and dex-authenticator
+// refreshes the tokens of all its users from the address of its pod.
+func TestRateLimitTokenEndpointCountsCredentialsOnly(t *testing.T) {
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.RateLimit = rateLimitTestConfig
+		c.PasswordConnector = "test"
+	})
+	defer httpServer.Close()
+	mockConnectorDataTestStorage(t, s.storage)
+
+	token := func(form url.Values) int {
+		r := rateLimitedRequest(http.MethodPost, "/token", form)
+		r.SetBasicAuth("test", "barfoo")
+		return serveRequest(s, r).Code
+	}
+	refresh := url.Values{"grant_type": {"refresh_token"}, "refresh_token": {"no-such-token"}}
+	code := url.Values{"grant_type": {"authorization_code"}, "code": {"no-such-code"}, "redirect_uri": {"foo://bar.com/"}}
+	for range 5 {
+		require.Equal(t, http.StatusBadRequest, token(refresh), "a failed refresh does not count")
+		require.Equal(t, http.StatusBadRequest, token(code), "a failed code exchange does not count")
+	}
+
+	wrongPassword := url.Values{"grant_type": {"password"}, "scope": {"openid"}, "username": {"test"}, "password": {"wrong"}}
+	for range 2 {
+		require.Equal(t, http.StatusUnauthorized, token(wrongPassword), "a wrong password within the burst")
+	}
+	assert.Equal(t, http.StatusTooManyRequests, token(wrongPassword))
+	assert.Equal(t, http.StatusTooManyRequests, token(refresh), "the address has used up its failures")
