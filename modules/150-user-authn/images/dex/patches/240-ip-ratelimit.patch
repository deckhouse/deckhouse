+func TestRateLimitPasswordLogin(t *testing.T) {
+	ctx := t.Context()
+	const connID = "mockPw"
+
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.RateLimit = rateLimitTestConfig
+	})
+	defer httpServer.Close()
+
+	sc := storage.Connector{
+		ID:              connID,
+		Type:            "mockPassword",
+		Name:            "MockPassword",
+		ResourceVersion: "1",
+		Config:          []byte(`{"username": "foo", "password": "password"}`),
+	}
+	require.NoError(t, s.storage.CreateConnector(ctx, sc))
+	_, err := s.connectors.Open(sc)
+	require.NoError(t, err)
+	// The login reads the client of its auth request (allow-lists, 200).
+	require.NoError(t, s.storage.CreateClient(ctx, storage.Client{ID: "test", RedirectURIs: []string{"cb"}}))
+
+	login := func(password string) *httptest.ResponseRecorder {
+		authReqID := storage.NewID()
+		require.NoError(t, s.storage.CreateAuthRequest(ctx, storage.AuthRequest{
+			ID:            authReqID,
+			ClientID:      "test",
+			ConnectorID:   connID,
+			RedirectURI:   "cb",
+			ResponseTypes: []string{"code"},
+			Expiry:        time.Now().Add(time.Minute),
+		}))
+		form := url.Values{"login": {"foo"}, "password": {password}}
+		return serveRequest(s, rateLimitedRequest(http.MethodPost, "/auth/"+connID+"/login?state="+authReqID, form))
+	}
+
+	for range 5 {
+		require.Equal(t, http.StatusSeeOther, login("password").Code, "a successful login does not count")
+	}
+	for range 2 {
+		require.Equal(t, http.StatusUnauthorized, login("wrong").Code, "a wrong password within the burst")
+	}
+
+	rr := login("wrong")
+	assert.Equal(t, http.StatusTooManyRequests, rr.Code)
+	assert.NotEmpty(t, rr.Header().Get("Retry-After"))
+	assert.Equal(t, http.StatusTooManyRequests, login("password").Code,
+		"once limited, even the right password waits for the bucket to refill")
+}
