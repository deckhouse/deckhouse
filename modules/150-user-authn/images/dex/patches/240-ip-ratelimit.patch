+// rateLimitTestConfig allows two failed attempts per client address, and no
+// refill within a test: the clock of the test servers does not move.
+var rateLimitTestConfig = &ratelimit.Config{RequestsPerMinute: 1, Burst: 2}
+
+const rateLimitPeer = "192.0.2.10:4711"
+
+func rateLimitedRequest(method, target string, body url.Values) *http.Request {
+	var r *http.Request
+	if body != nil {
+		r = httptest.NewRequest(method, target, strings.NewReader(body.Encode()))
+		r.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	} else {
+		r = httptest.NewRequest(method, target, nil)
+	}
+	r.RemoteAddr = rateLimitPeer
+	return r
+}
+
+// badClientTokenRequest fails client authentication at the token endpoint, the
+// cheapest failed attempt there is.
+func badClientTokenRequest(clientAddr string) *http.Request {
+	r := rateLimitedRequest(http.MethodPost, "/token", url.Values{"grant_type": {"refresh_token"}, "refresh_token": {"x"}})
+	r.SetBasicAuth("no-such-client", "secret")
+	if clientAddr != "" {
+		r.Header.Set("X-Real-IP", clientAddr)
+	}
+	return r
+}
+
+func serveRequest(s *Server, r *http.Request) *httptest.ResponseRecorder {
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, r)
+	return rr
+}
