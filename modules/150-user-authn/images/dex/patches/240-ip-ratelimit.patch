+func TestLimiterKeepsOnlyBucketsOfRecentFailures(t *testing.T) {
+	clock := newTestClock()
+	l := New(Config{RequestsPerMinute: 60, Burst: 2}, clock.Now, nil)
+	next := &statusHandler{status: http.StatusOK}
+	h := l.Wrap(next)
+
+	for i := range 100 {
+		serve(h, requestFrom("198.51.100."+strconv.Itoa(i)))
+	}
+	assert.Empty(t, l.buckets, "successes leave no bucket behind")
+
+	next.set(http.StatusUnauthorized)
+	serve(h, requestFrom("192.0.2.1"))
+	serve(h, requestFrom("192.0.2.2"))
+	assert.Len(t, l.buckets, 2, "a failure keeps the bucket until it fills up again")
+
+	clock.advance(sweepInterval)
+	next.set(http.StatusOK)
+	serve(h, requestFrom("192.0.2.3"))
+	assert.Empty(t, l.buckets, "the sweep drops buckets that filled up again")
+}
+
+func TestLimiterLogsFirstRefusalOnly(t *testing.T) {
+	clock := newTestClock()
+	var logs bytes.Buffer
+	logger := slog.New(slog.NewTextHandler(&logs, nil))
+	l := New(Config{RequestsPerMinute: 60, Burst: 1}, clock.Now, logger)
+	h := l.Wrap(&statusHandler{status: http.StatusUnauthorized})
+
+	for range 5 {
+		serve(h, requestFrom("192.0.2.1"))
+	}
+	assert.Equal(t, 1, strings.Count(logs.String(), "client address rate limited"), "one line however many refusals")
+
+	clock.advance(time.Second)
+	serve(h, requestFrom("192.0.2.1")) // let through, fails again
+	serve(h, requestFrom("192.0.2.1")) // refused again
+	assert.Equal(t, 2, strings.Count(logs.String(), "client address rate limited"), "a new episode is logged again")
+
+	r := httptest.NewRequest(http.MethodPost, "/auth/local/login", nil)
+	r.RemoteAddr = "203.0.113.9:1234"
+	serve(h, r)
+	serve(h, r)
+	assert.Contains(t, logs.String(), "client_remote_addr=203.0.113.9", "the peer address is named when the router resolved none")
+}
