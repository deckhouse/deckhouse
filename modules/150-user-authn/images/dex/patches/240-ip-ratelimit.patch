+func TestLimiterConcurrentFailures(t *testing.T) {
+	clock := newTestClock()
+	const burst = 20
+	l := New(Config{RequestsPerMinute: 1, Burst: burst}, clock.Now, nil)
+	next := &statusHandler{status: http.StatusUnauthorized}
+	h := l.Wrap(next)
+
+	var wg sync.WaitGroup
+	for range 100 {
+		wg.Go(func() {
+			serve(h, requestFrom("192.0.2.1"))
+		})
+	}
+	wg.Wait()
+
+	assert.Equal(t, burst, next.calls, "exactly the burst reaches the handler")
+}
+
+// recordingMux remembers the handler mounted for each pattern.
+type recordingMux struct {
+	handlers map[string]http.Handler
+}
+
+func (m *recordingMux) Handle(p string, h http.Handler)         { m.handlers[p] = h }
+func (m *recordingMux) HandleFunc(p string, h http.HandlerFunc) { m.handlers[p] = h }
+func (m *recordingMux) HandleCORS(p string, h http.HandlerFunc) { m.handlers[p] = h }
+func (m *recordingMux) HandlePrefix(p string, h http.Handler)   { m.handlers[p] = h }
+
+func TestLimiterMux(t *testing.T) {
+	clock := newTestClock()
+	l := New(Config{RequestsPerMinute: 1, Burst: 1}, clock.Now, nil)
+	rec := &recordingMux{handlers: map[string]http.Handler{}}
+	var m router.Mux = l.Mux(rec, "/token", "/auth/{connector}/login", "/mfa", "/mfa/")
+
+	failing := &statusHandler{status: http.StatusUnauthorized}
+	m.HandleCORS("/token", failing.ServeHTTP)
+	m.HandleCORS("/token/introspect", failing.ServeHTTP)
+	m.HandleFunc("/auth/{connector}/login", failing.ServeHTTP)
+	m.HandleFunc("/auth/{connector}", failing.ServeHTTP)
+	m.HandleFunc("/mfa", failing.ServeHTTP)
+	m.HandleFunc("/mfa/totp", failing.ServeHTTP)
+	m.Handle("/mfa/webauthn/login/finish", failing)
+	m.HandleFunc("/mfactor", failing.ServeHTTP)
+	m.HandlePrefix("/mfa/static", failing)
+
+	limited := map[string]bool{
+		"/token":                     true,
+		"/token/introspect":          false,
+		"/auth/{connector}/login":    true,
+		"/auth/{connector}":          false,
+		"/mfa":                       true,
+		"/mfa/totp":                  true,
+		"/mfa/webauthn/login/finish": true,
+		"/mfactor":                   false,
+		"/mfa/static":                false,
+	}
+	for pattern, isLimited := range limited {
+		t.Run(pattern, func(t *testing.T) {
+			h, ok := rec.handlers[pattern]
+			require.True(t, ok, "the route is mounted")
+
+			// A client address of its own per route, so the routes do not share a bucket.
+			r := requestFrom(pattern)
+			serve(h, r)
+			rr := serve(h, r)
+			if isLimited {
+				assert.Equal(t, http.StatusTooManyRequests, rr.Code)
+			} else {
+				assert.Equal(t, http.StatusUnauthorized, rr.Code)
+			}
+		})
+	}
+}
