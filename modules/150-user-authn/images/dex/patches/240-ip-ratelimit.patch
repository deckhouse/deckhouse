diff --git a/server/ratelimit/ratelimit.go b/server/ratelimit/ratelimit.go
new file mode 100644
index 00000000..7bb04066
--- /dev/null
+++ b/server/ratelimit/ratelimit.go
@@ -0,0 +1,311 @@
+// Package ratelimit limits failed attempts per client address on the routes
+// where a client proves a secret: the login form of password connectors, the
+// token endpoint and the steps of the second factor.
+//
+// Only failures are counted. A request takes a token from the bucket of its
+// client address before it reaches the handler and gets it back unless the
+// response is an error (status 400 and above), so successful logins, token
+// refreshes and the pages of a login flow do not use up the budget. A handler
+// that finds a request proves no secret a client could guess, such as a refresh
+// token, gives the token back whatever the answer (Exempt). A client address
+// with an empty bucket gets 429 with Retry-After and does not reach the handler.
+//
+// The client address is the one the router resolved for the request (the
+// configured client IP header, see router.ParseRealIP), otherwise the peer
+// address. Buckets live in the memory of one dex replica, so with N replicas a
+// client address gets N times the configured rate: this is a backstop that the
+// account lockout complements, a stricter limit belongs in front of dex.
+package ratelimit
+
+import (
+	"context"
+	"log/slog"
+	"math"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/dexidp/dex/server/reqctx"
+	"github.com/dexidp/dex/server/router"
+)
+
+// Defaults for a Config field that is not positive.
+const (
+	DefaultRequestsPerMinute = 10
+	DefaultBurst             = 10
+)
+
+// sweepInterval is how often buckets that have filled up again are dropped.
+const sweepInterval = time.Minute
+
+// Config configures a Limiter.
+type Config struct {
+	// RequestsPerMinute is the sustained rate of failed attempts allowed per
+	// client address.
+	RequestsPerMinute int
+	// Burst is how many failed attempts a client address may make at once.
+	Burst int
+}
+
+// WithDefaults returns c with every field that is not positive set to its default.
+func (c Config) WithDefaults() Config {
+	if c.RequestsPerMinute <= 0 {
+		c.RequestsPerMinute = DefaultRequestsPerMinute
+	}
+	if c.Burst <= 0 {
+		c.Burst = DefaultBurst
+	}
+	return c
+}
+
+// Limiter is a token bucket per client address. A full bucket is the same as no
+// bucket, so a bucket is dropped once it has filled up again: the memory held is
+// bounded by the addresses that failed recently, not by every address seen.
+type Limiter struct {
+	perSecond float64
+	burst     float64
+	now       func() time.Time
+	logger    *slog.Logger
+
+	mu        sync.Mutex
+	buckets   map[string]*bucket
+	lastSweep time.Time
+}
+
+// bucket is the state of one client address, guarded by Limiter.mu.
+type bucket struct {
+	tokens  float64
+	updated time.Time
+	// isLimited is set by the first refused request and cleared by the next one
+	// let through, so a client address that keeps hammering is logged once.
+	isLimited bool
+}
+
+// New returns a limiter for c (non-positive fields take their defaults). now is
+// the clock, time.Now when nil.
+func New(c Config, now func() time.Time, logger *slog.Logger) *Limiter {
+	c = c.WithDefaults()
+	if now == nil {
+		now = time.Now
+	}
+	if logger == nil {
+		logger = slog.New(slog.DiscardHandler)
+	}
+	return &Limiter{
+		perSecond: float64(c.RequestsPerMinute) / 60,
+		burst:     float64(c.Burst),
+		now:       now,
+		logger:    logger,
+		buckets:   make(map[string]*bucket),
+		lastSweep: now(),
+	}
+}
+
+// Wrap limits h per client address: a request is refused with 429 while the
+// bucket of its client address is empty, and a response below 400, or any
+// response to a request h exempted, gives the token it took back.
+func (l *Limiter) Wrap(h http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		addr := ClientAddress(r)
+
+		wait, ok, isFirstRefusal := l.take(addr)
+		if !ok {
+			if isFirstRefusal {
+				l.logRefusal(r, addr)
+			}
+			w.Header().Set("Retry-After", strconv.Itoa(retryAfterSeconds(wait)))
+			http.Error(w, "Too many requests", http.StatusTooManyRequests)
+			return
+		}
+
+		exempt := new(atomic.Bool)
+		r = r.WithContext(context.WithValue(r.Context(), exemptKey{}, exempt))
+		rec := &statusRecorder{ResponseWriter: w}
+		h.ServeHTTP(rec, r)
+		if rec.status < http.StatusBadRequest || exempt.Load() {
+			l.giveBack(addr)
+		}
+	})
+}
+
+// exemptKey is the context key of the flag Exempt sets.
+type exemptKey struct{}
+
+// Exempt keeps a failure of the request of ctx out of the count of its client
+// address. A handler calls it once it knows the request proves no secret a
+// client could guess: a refresh token, an authorization code or a device code
+// fails for a client that holds no valid one, not for one that guesses. The
+// request was still refused up front if its client address had used up its
+// failures. Outside a limited route, Exempt does nothing.
+func Exempt(ctx context.Context) {
+	if exempt, ok := ctx.Value(exemptKey{}).(*atomic.Bool); ok {
+		exempt.Store(true)
+	}
+}
+
+// Mux returns m with the routes matching patterns limited by l. A pattern that
+// ends in "/" matches every route below it, as in net/http; any other pattern
+// matches only the route of that name. Routes are named as handlers mount them,
+// relative to the issuer path.
+func (l *Limiter) Mux(m router.Mux, patterns ...string) router.Mux {
+	return limitedMux{Mux: m, limiter: l, patterns: patterns}
+}
+
+// take takes a token from the bucket of addr. When the bucket is empty it
+// reports how long until a token is available, and whether this is the first
+// refusal since the client address was last let through.
+func (l *Limiter) take(addr string) (wait time.Duration, ok, isFirstRefusal bool) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	now := l.now()
+	if now.Sub(l.lastSweep) >= sweepInterval {
+		l.sweepLocked(now)
+	}
+
+	b, found := l.buckets[addr]
+	if !found {
+		b = &bucket{tokens: l.burst, updated: now}
+		l.buckets[addr] = b
+	}
+	l.refillLocked(b, now)
+
+	if b.tokens >= 1 {
+		b.tokens--
+		b.isLimited = false
+		return 0, true, false
+	}
+
+	isFirstRefusal = !b.isLimited
+	b.isLimited = true
+	return time.Duration((1 - b.tokens) / l.perSecond * float64(time.Second)), false, isFirstRefusal
+}
+
+// logRefusal logs that a client address ran out of attempts. It is called for
+// the first refusal only: a client that keeps trying while limited would write a
+// line per request. The request context carries the client address when the
+// router resolved one; otherwise the peer address is added here.
+func (l *Limiter) logRefusal(r *http.Request, addr string) {
+	attrs := []any{"path", r.URL.Path}
+	if _, ok := r.Context().Value(reqctx.RequestKeyRemoteIP).(string); !ok {
+		attrs = append(attrs, string(reqctx.RequestKeyRemoteIP), addr)
+	}
+	l.logger.WarnContext(r.Context(), "client address rate limited", attrs...)
+}
+
+// giveBack returns the token a request took. A bucket dropped in the meantime
+// was full, so there is nothing to return it to.
+func (l *Limiter) giveBack(addr string) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	b, ok := l.buckets[addr]
+	if !ok {
+		return
+	}
+	l.refillLocked(b, l.now())
+	b.tokens = min(b.tokens+1, l.burst)
+	if b.tokens >= l.burst {
+		delete(l.buckets, addr)
+	}
+}
+
+// refillLocked adds the tokens earned since the bucket was last updated. A clock
+// that went backwards earns nothing.
+func (l *Limiter) refillLocked(b *bucket, now time.Time) {
+	elapsed := now.Sub(b.updated)
+	if elapsed <= 0 {
+		return
+	}
+	b.tokens = min(b.tokens+elapsed.Seconds()*l.perSecond, l.burst)
+	b.updated = now
+}
+
+// sweepLocked drops the buckets that have filled up again.
+func (l *Limiter) sweepLocked(now time.Time) {
+	for addr, b := range l.buckets {
+		l.refillLocked(b, now)
+		if b.tokens >= l.burst {
+			delete(l.buckets, addr)
+		}
+	}
+	l.lastSweep = now
+}
+
+// retryAfterSeconds is the Retry-After value for a wait, at least one second.
+func retryAfterSeconds(wait time.Duration) int {
+	return max(1, int(math.Ceil(wait.Seconds())))
+}
+
+// ClientAddress is the address a request is counted against: the client address
+// the router resolved for it, otherwise the host of the peer address.
+func ClientAddress(r *http.Request) string {
+	if addr, ok := r.Context().Value(reqctx.RequestKeyRemoteIP).(string); ok && addr != "" {
+		return addr
+	}
+	if host, _, err := net.SplitHostPort(r.RemoteAddr); err == nil {
+		return host
+	}
+	return r.RemoteAddr
+}
+
+// statusRecorder remembers the status of the response written through it.
+type statusRecorder struct {
+	http.ResponseWriter
+	status int
+}
+
+func (s *statusRecorder) WriteHeader(code int) {
+	// Informational responses precede the final status, which is the one that
+	// tells a failure from a success.
+	if s.status == 0 && code >= http.StatusOK {
+		s.status = code
+	}
+	s.ResponseWriter.WriteHeader(code)
+}
+
+func (s *statusRecorder) Write(b []byte) (int, error) {
+	if s.status == 0 {
+		s.status = http.StatusOK
+	}
+	return s.ResponseWriter.Write(b)
+}
+
+// Unwrap lets http.ResponseController reach the underlying writer.
+func (s *statusRecorder) Unwrap() http.ResponseWriter {
+	return s.ResponseWriter
+}
+
+// limitedMux is a router.Mux that limits the routes matching its patterns.
+// Prefix routes (static assets) are never limited.
+type limitedMux struct {
+	router.Mux
+	limiter  *Limiter
+	patterns []string
+}
+
+func (m limitedMux) Handle(pattern string, h http.Handler) {
+	m.Mux.Handle(pattern, m.wrap(pattern, h))
+}
+
+func (m limitedMux) HandleFunc(pattern string, h http.HandlerFunc) {
+	m.Mux.HandleFunc(pattern, m.wrap(pattern, h).ServeHTTP)
+}
+
+func (m limitedMux) HandleCORS(pattern string, h http.HandlerFunc) {
+	m.Mux.HandleCORS(pattern, m.wrap(pattern, h).ServeHTTP)
+}
+
+func (m limitedMux) wrap(pattern string, h http.Handler) http.Handler {
+	for _, p := range m.patterns {
+		matchesSubtree := strings.HasSuffix(p, "/") && strings.HasPrefix(pattern, p)
+		if pattern == p || matchesSubtree {
+			return m.limiter.Wrap(h)
+		}
+	}
+	return h
+}
diff --git a/server/ratelimit/ratelimit_test.go b/server/ratelimit/ratelimit_test.go
new file mode 100644
index 00000000..d9d4ae30
--- /dev/null
+++ b/server/ratelimit/ratelimit_test.go
@@ -0,0 +1,363 @@
+package ratelimit
+
+import (
+	"bytes"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/reqctx"
+	"github.com/dexidp/dex/server/router"
+)
+
+// testClock is a clock the tests advance by hand.
+type testClock struct {
+	mu  sync.Mutex
+	now time.Time
+}
+
+func (c *testClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.now
+}
+
+func (c *testClock) advance(d time.Duration) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.now = c.now.Add(d)
+}
+
+func newTestClock() *testClock {
+	return &testClock{now: time.Date(2026, 10, 14, 12, 0, 0, 0, time.UTC)}
+}
+
+// statusHandler answers every request with status and counts the requests that
+// reached it.
+type statusHandler struct {
+	mu     sync.Mutex
+	status int
+	calls  int
+}
+
+func (h *statusHandler) ServeHTTP(w http.ResponseWriter, _ *http.Request) {
+	h.mu.Lock()
+	h.calls++
+	status := h.status
+	h.mu.Unlock()
+	w.WriteHeader(status)
+}
+
+func (h *statusHandler) set(status int) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.status = status
+}
+
+// requestFrom is a request whose client address the router resolved to addr.
+func requestFrom(addr string) *http.Request {
+	r := httptest.NewRequest(http.MethodPost, "/token", nil)
+	return r.WithContext(reqctx.WithRemoteIP(r.Context(), addr))
+}
+
+func serve(h http.Handler, r *http.Request) *httptest.ResponseRecorder {
+	rr := httptest.NewRecorder()
+	h.ServeHTTP(rr, r)
+	return rr
+}
+
+func TestConfigWithDefaults(t *testing.T) {
+	tests := []struct {
+		name     string
+		in       Config
+		expected Config
+	}{
+		{name: "zero", in: Config{}, expected: Config{RequestsPerMinute: 10, Burst: 10}},
+		{name: "negative", in: Config{RequestsPerMinute: -1, Burst: -5}, expected: Config{RequestsPerMinute: 10, Burst: 10}},
+		{name: "set", in: Config{RequestsPerMinute: 30, Burst: 5}, expected: Config{RequestsPerMinute: 30, Burst: 5}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.expected, tc.in.WithDefaults())
+		})
+	}
+}
+
+func TestLimiterWrapLimitsFailures(t *testing.T) {
+	clock := newTestClock()
+	l := New(Config{RequestsPerMinute: 60, Burst: 3}, clock.Now, nil)
+	next := &statusHandler{status: http.StatusUnauthorized}
+	h := l.Wrap(next)
+
+	for i := range 3 {
+		rr := serve(h, requestFrom("192.0.2.1"))
+		require.Equal(t, http.StatusUnauthorized, rr.Code, "failure %d is within the burst", i+1)
+	}
+
+	rr := serve(h, requestFrom("192.0.2.1"))
+	require.Equal(t, http.StatusTooManyRequests, rr.Code)
+	assert.Equal(t, "1", rr.Header().Get("Retry-After"), "one token a second")
+	assert.Equal(t, 3, next.calls, "a limited request does not reach the handler")
+
+	clock.advance(time.Second)
+	rr = serve(h, requestFrom("192.0.2.1"))
+	assert.Equal(t, http.StatusUnauthorized, rr.Code, "a token earned since lets one more attempt through")
+	rr = serve(h, requestFrom("192.0.2.1"))
+	assert.Equal(t, http.StatusTooManyRequests, rr.Code)
+}
+
+func TestLimiterWrapRetryAfterRoundsUp(t *testing.T) {
+	clock := newTestClock()
+	// Ten a minute: one token every six seconds.
+	l := New(Config{RequestsPerMinute: 10, Burst: 1}, clock.Now, nil)
+	h := l.Wrap(&statusHandler{status: http.StatusUnauthorized})
+
+	serve(h, requestFrom("192.0.2.1"))
+	clock.advance(500 * time.Millisecond)
+
+	rr := serve(h, requestFrom("192.0.2.1"))
+	require.Equal(t, http.StatusTooManyRequests, rr.Code)
+	assert.Equal(t, "6", rr.Header().Get("Retry-After"), "5.5 seconds left, rounded up")
+}
+
+func TestLimiterWrapGivesBackSuccesses(t *testing.T) {
+	clock := newTestClock()
+	l := New(Config{RequestsPerMinute: 1, Burst: 2}, clock.Now, nil)
+	next := &statusHandler{}
+	h := l.Wrap(next)
+
+	for _, status := range []int{http.StatusOK, http.StatusFound, http.StatusSeeOther, http.StatusNotModified} {
+		next.set(status)
+		for range 5 {
+			rr := serve(h, requestFrom("192.0.2.1"))
+			require.Equal(t, status, rr.Code, "a response below 400 never runs into the limit")
+		}
+	}
+
+	next.set(http.StatusBadRequest)
+	serve(h, requestFrom("192.0.2.1"))
+	next.set(http.StatusInternalServerError)
+	serve(h, requestFrom("192.0.2.1"))
+
+	rr := serve(h, requestFrom("192.0.2.1"))
+	assert.Equal(t, http.StatusTooManyRequests, rr.Code, "4xx and 5xx both count as failures")
+}
+
+func TestLimiterWrapStatusWithoutWriteHeader(t *testing.T) {
+	clock := newTestClock()
+	l := New(Config{RequestsPerMinute: 1, Burst: 1}, clock.Now, nil)
+
+	tests := []struct {
+		name    string
+		handler http.HandlerFunc
+	}{
+		{name: "body only", handler: func(w http.ResponseWriter, _ *http.Request) { _, _ = w.Write([]byte("ok")) }},
+		{name: "nothing written", handler: func(http.ResponseWriter, *http.Request) {}},
+		{name: "early hints first", handler: func(w http.ResponseWriter, _ *http.Request) {
+			w.WriteHeader(http.StatusEarlyHints)
+			w.WriteHeader(http.StatusOK)
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h := l.Wrap(tc.handler)
+			for range 3 {
+				rr := serve(h, requestFrom("192.0.2.1"))
+				require.NotEqual(t, http.StatusTooManyRequests, rr.Code, "an implicit 200 is a success")
+			}
+		})
+	}
+}
