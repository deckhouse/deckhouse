@@ -0,0 +1,452 @@
+package mfa
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/go-webauthn/webauthn/webauthn"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/storage"
+)
+
+// The tests of several keys per user (Deckhouse patch 360): a key beyond the first is added only after a
+// registered key confirmed the sign-in, and only under the limit.
+
+// fewerKeysStorage serves a Get of the identity with one key fewer than it has, while Update sees them all: a
+// request that loaded the account before a parallel one added a key.
+type fewerKeysStorage struct {
+	storage.Storage
+}
+
+func (s fewerKeysStorage) GetUserIdentity(ctx context.Context, userID, connectorID string) (storage.UserIdentity, error) {
+	u, err := s.Storage.GetUserIdentity(ctx, userID, connectorID)
+	if err != nil {
+		return u, err
+	}
+	keys := u.WebAuthnCredentials["webauthn"]
+	if len(keys) > 0 {
+		u.WebAuthnCredentials = map[string][]storage.WebAuthnCredential{"webauthn": keys[:len(keys)-1]}
+	}
+	return u, nil
+}
+
+type keysFixture struct {
+	h       *Handler
+	router  http.Handler
+	store   storage.Storage
+	authReq storage.AuthRequest
+	key     *WebAuthnProvider
+	// ceremonies counts the registration ceremonies that ran.
+	ceremonies *int
+}
+
+// newKeysFixture is a handler with a WebAuthn authenticator of the limit, a user with keys keys, and a sign-in
+// whose WebAuthn state is state. totp adds a confirmed TOTP authenticator, the chain [totp, webauthn] and a
+// choice (require: Any).
+func newKeysFixture(t *testing.T, limit, keys int, state string, totp bool) keysFixture {
+	t.Helper()
+	key, err := NewWebAuthnProvider("Test", "", nil, "", "", "http://localhost", nil)
+	require.NoError(t, err)
+	key.SetMaxCredentials(limit)
+	ceremonies := 0
+	key.finishRegistration = func(webauthn.User, webauthn.SessionData, *http.Request) (*webauthn.Credential, error) {
+		ceremonies++
+		return &webauthn.Credential{ID: []byte(fmt.Sprintf("new-%d", ceremonies))}, nil
+	}
+	providers := map[string]Provider{"webauthn": key}
+	chain := []string{"webauthn"}
+	if totp {
+		providers["totp"] = NewTOTPProvider("test-issuer", nil)
+		chain = []string{"totp", "webauthn"}
+	}
+	h, router, store := newTestHandler(t, providers, chain)
+	if totp {
+		h.OneOfConnectorTypes = []string{choiceType}
+	}
+	authReq := storage.AuthRequest{
+		ID: "keys-req", ClientID: "app", Expiry: time.Now().Add(time.Hour),
+		HMACKey: randomHMACKey(t), LoggedIn: true,
+		Claims:              storage.Claims{UserID: "user-1", Email: "user@example.com"},
+		ConnectorID:         "mock",
+		WebAuthnSessionData: []byte(state),
+	}
+	ctx := t.Context()
+	require.NoError(t, store.CreateAuthRequest(ctx, authReq))
+	require.NoError(t, store.CreateClient(ctx, storage.Client{ID: "app", Secret: "s"}))
+	identity := storage.UserIdentity{UserID: "user-1", ConnectorID: "mock", Claims: authReq.Claims}
+	for i := 0; i < keys; i++ {
+		if identity.WebAuthnCredentials == nil {
+			identity.WebAuthnCredentials = map[string][]storage.WebAuthnCredential{}
+		}
+		identity.WebAuthnCredentials["webauthn"] = append(identity.WebAuthnCredentials["webauthn"],
+			storage.WebAuthnCredential{CredentialID: []byte(fmt.Sprintf("old-%d", i)), PublicKey: []byte("pk")})
+	}
+	if totp {
+		secret, _ := confirmedTOTP(t)
+		identity.MFASecrets = map[string]*storage.MFASecret{"totp": secret}
+	}
+	require.NoError(t, store.CreateUserIdentity(ctx, identity))
+	return keysFixture{h: h, router: router, store: store, authReq: authReq, key: key, ceremonies: &ceremonies}
+}
+
+const (
+	unconfirmed = `{}`
+	// confirmed is a sign-in a registered key confirmed for adding a key: a begin takes the confirmation over.
+	confirmed = `{"deckhouseKeyConfirmedFor":"webauthn","deckhouseKeyUserID":"user-1","deckhouseKeyConnectorID":"mock"}`
+	// adding is a registration of a further key that took the confirmation over: its finish uses it up.
+	adding = `{"deckhouseKeyAddingFor":"webauthn","deckhouseKeyUserID":"user-1","deckhouseKeyConnectorID":"mock"}`
+)
+
+// stateFor is the state a step of the registration of a further key needs.
+func stateFor(step string) string {
+	if step == "begin" {
+		return confirmed
+	}
+	return adding
+}
+
+func (f keysFixture) post(t *testing.T, step string) *httptest.ResponseRecorder {
+	t.Helper()
+	return f.postFor(t, step, "webauthn")
+}
+
+func (f keysFixture) postFor(t *testing.T, step, authenticatorID string) *httptest.ResponseRecorder {
+	t.Helper()
+	hmacVal := internal.SignStep(f.authReq, internal.Authenticator(authenticatorID))
+	rr := httptest.NewRecorder()
+	f.router.ServeHTTP(rr, httptest.NewRequest(http.MethodPost,
+		"/mfa/webauthn/register/"+step+"?req="+f.authReq.ID+"&hmac="+hmacVal+"&authenticator="+authenticatorID, nil))
+	return rr
+}
+
+func (f keysFixture) page(t *testing.T) *httptest.ResponseRecorder {
+	t.Helper()
+	rr := httptest.NewRecorder()
+	f.router.ServeHTTP(rr, httptest.NewRequest(http.MethodGet, f.h.buildRedirectURL(f.authReq, "webauthn"), nil))
+	return rr
+}
+
+func (f keysFixture) keys(t *testing.T) int {
+	t.Helper()
+	ident, err := f.store.GetUserIdentity(t.Context(), "user-1", "mock")
+	require.NoError(t, err)
+	return len(ident.WebAuthnCredentials["webauthn"])
+}
+
+func (f keysFixture) state(t *testing.T) (webAuthnState, bool) {
+	t.Helper()
+	got, err := f.store.GetAuthRequest(t.Context(), f.authReq.ID)
+	require.NoError(t, err)
+	return readWebAuthnState(got.WebAuthnSessionData), got.MFAValidated
+}
+
+// A key confirmed the sign-in, and there is room: the new key is stored, the confirmation is used up, and the
+// sign-in completes.
+func TestKeysAddAfterAConfirmation(t *testing.T) {
+	f := newKeysFixture(t, 3, 1, confirmed, false)
+
+	require.Equal(t, http.StatusOK, f.post(t, "begin").Code)
+	rr := f.post(t, "finish")
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	require.Equal(t, 2, f.keys(t))
+	state, validated := f.state(t)
+	require.Empty(t, state.KeyConfirmedFor+state.KeyAddingFor, "the confirmation must be used once")
+	require.True(t, validated)
+
+	// The confirmation does not add a third key: the completed sign-in moves on.
+	rr = f.post(t, "finish")
+	require.NotEqual(t, http.StatusOK, rr.Code)
+	require.Equal(t, 2, f.keys(t))
+}
+
+// A password alone never adds a key to an account that has one, whatever the limit.
+func TestKeysRefuseAKeyWithoutAConfirmation(t *testing.T) {
+	for _, step := range []string{"begin", "finish"} {
+		t.Run(step, func(t *testing.T) {
+			f := newKeysFixture(t, 3, 1, unconfirmed, false)
+			rr := f.post(t, step)
+			require.Contains(t, []int{http.StatusForbidden, http.StatusBadRequest}, rr.Code)
+			require.Contains(t, rr.Body.String(), "A key is already registered.")
+			require.Equal(t, 1, f.keys(t))
+			require.Zero(t, *f.ceremonies, "the registration ran without a confirmation")
+			_, validated := f.state(t)
+			require.False(t, validated)
+		})
+	}
+}
+
+// At the limit, and over a limit lowered below the keys the user has, no key is added and the keys stay.
+func TestKeysRefuseAKeyOverTheLimit(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		limit, keys int
+	}{
+		{name: "at the limit", limit: 3, keys: 3},
+		{name: "a lowered limit", limit: 2, keys: 3},
+	} {
+		for _, step := range []string{"begin", "finish"} {
+			t.Run(tc.name+"/"+step, func(t *testing.T) {
+				f := newKeysFixture(t, tc.limit, tc.keys, stateFor(step), false)
+				rr := f.post(t, step)
+				require.Contains(t, []int{http.StatusForbidden, http.StatusBadRequest}, rr.Code)
+				require.Contains(t, rr.Body.String(), webAuthnLimitMsg)
+				require.Equal(t, tc.keys, f.keys(t))
+				require.Zero(t, *f.ceremonies)
+			})
+		}
+	}
+}
+
+// The request loaded the account before a parallel one added a key: the limit is checked again inside the update.
+func TestKeysCheckTheLimitInTheUpdate(t *testing.T) {
+	f := newKeysFixture(t, 2, 2, adding, false)
+	f.h.Storage = fewerKeysStorage{Storage: f.store}
+
+	rr := f.post(t, "finish")
+	require.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+	require.Contains(t, rr.Body.String(), webAuthnLimitMsg)
+	require.Equal(t, 2, f.keys(t))
+	_, validated := f.state(t)
+	require.False(t, validated)
+}
+
+// The ceremony of a new key takes the confirmation over with its session: a second begin needs a key to confirm the
+// sign-in again.
+func TestKeysBeginTakesTheConfirmationOver(t *testing.T) {
+	f := newKeysFixture(t, 3, 1, confirmed, false)
+
+	rr := f.post(t, "begin")
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	state, _ := f.state(t)
+	require.Empty(t, state.KeyConfirmedFor)
+	require.Equal(t, "webauthn", state.KeyAddingFor)
+	require.NotEmpty(t, state.Challenge, "the session of the ceremony is stored")
+
+	rr = f.post(t, "begin")
+	require.Equal(t, http.StatusForbidden, rr.Code)
+	require.Contains(t, rr.Body.String(), keyNotConfirmedMsg)
+}
+
+// A finish that fails uses the confirmation up: neither a finish nor a new begin adds a key without another
+// confirmation by a registered key.
+func TestKeysAFailedFinishUsesTheConfirmationUp(t *testing.T) {
+	f := newKeysFixture(t, 3, 1, confirmed, false)
+	f.key.finishRegistration = func(webauthn.User, webauthn.SessionData, *http.Request) (*webauthn.Credential, error) {
+		return nil, errors.New("the browser refused")
+	}
+	require.Equal(t, http.StatusOK, f.post(t, "begin").Code)
+	require.Equal(t, http.StatusBadRequest, f.post(t, "finish").Code)
+	state, _ := f.state(t)
+	require.Empty(t, state.KeyConfirmedFor+state.KeyAddingFor)
+
+	f.key.finishRegistration = func(webauthn.User, webauthn.SessionData, *http.Request) (*webauthn.Credential, error) {
+		return &webauthn.Credential{ID: []byte("attacker")}, nil
+	}
+	rr := f.post(t, "begin")
+	require.Equal(t, http.StatusForbidden, rr.Code)
+	rr = f.post(t, "finish")
+	require.Equal(t, http.StatusBadRequest, rr.Code)
+	require.Contains(t, rr.Body.String(), keyNotConfirmedMsg)
+	require.Equal(t, 1, f.keys(t))
+	_, validated := f.state(t)
+	require.False(t, validated)
+}
+
+// Of parallel finishes under one confirmation one adds a key.
+func TestKeysParallelFinishesAddOneKey(t *testing.T) {
+	for range 20 {
+		f := newKeysFixture(t, 5, 1, adding, false)
+		var mu sync.Mutex
+		ids := 0
+		f.key.finishRegistration = func(webauthn.User, webauthn.SessionData, *http.Request) (*webauthn.Credential, error) {
+			mu.Lock()
+			defer mu.Unlock()
+			ids++
+			return &webauthn.Credential{ID: []byte(fmt.Sprintf("parallel-%d", ids))}, nil
+		}
+		codes := make([]int, 2)
+		var wg sync.WaitGroup
+		for i := range codes {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				codes[i] = f.post(t, "finish").Code
+			}()
+		}
+		wg.Wait()
+		// The other one is refused, or sent on when the sign-in has completed already.
+		ok := 0
+		for _, code := range codes {
+			if code == http.StatusOK {
+				ok++
+			}
+		}
+		require.Equal(t, 1, ok, "%v", codes)
+		require.Equal(t, 2, f.keys(t))
+	}
+}
+
+// A confirmation by a key of one authenticator adds no key to another: the chain [webauthn, webauthn2] asks for
+// both, and a key of the first does not stand for the second. A completed step uses the confirmation up.
+func TestKeysTheConfirmationIsOfItsAuthenticator(t *testing.T) {
+	second, err := NewWebAuthnProvider("Test", "", nil, "", "", "http://localhost", nil)
+	require.NoError(t, err)
+	stored := false
+	second.finishRegistration = func(webauthn.User, webauthn.SessionData, *http.Request) (*webauthn.Credential, error) {
+		stored = true
+		return &webauthn.Credential{ID: []byte("attacker")}, nil
+	}
+	for _, step := range []string{"begin", "finish"} {
+		t.Run(step, func(t *testing.T) {
+			f := newKeysFixture(t, 3, 1, stateFor(step), false)
+			f.h.MFAProviders["webauthn2"] = second
+			f.h.DefaultMFAChain = []string{"webauthn", "webauthn2"}
+			require.NoError(t, f.store.UpdateUserIdentity(t.Context(), "user-1", "mock", func(old storage.UserIdentity) (storage.UserIdentity, error) {
+				old.WebAuthnCredentials["webauthn2"] = []storage.WebAuthnCredential{{CredentialID: []byte("b"), PublicKey: []byte("pk")}}
+				return old, nil
+			}))
+			rr := f.postFor(t, step, "webauthn2")
+			require.Contains(t, []int{http.StatusForbidden, http.StatusBadRequest}, rr.Code)
+			require.Contains(t, rr.Body.String(), keyNotConfirmedMsg)
+			require.False(t, stored)
+			_, validated := f.state(t)
+			require.False(t, validated)
+		})
+	}
+
+	t.Run("a completed step", func(t *testing.T) {
+		f := newKeysFixture(t, 3, 1, confirmed, false)
+		_, err := f.h.CompleteStep(t.Context(), f.authReq, "webauthn")
+		require.NoError(t, err)
+		state, _ := f.state(t)
+		require.Empty(t, state.KeyConfirmedFor+state.KeyAddingFor)
+	})
+}
+
+// A confirmation by a key of one user adds no key for another: the sign-in of user-1 carries a confirmation given
+// by a key of another user, or of the same user of another connector.
+func TestKeysTheConfirmationIsOfItsUser(t *testing.T) {
+	for _, tc := range []struct{ name, user, connector string }{
+		{name: "another user", user: "user-2", connector: "mock"},
+		{name: "another connector", user: "user-1", connector: "other"},
+		{name: "no user", user: "", connector: ""},
+	} {
+		for _, step := range []string{"begin", "finish"} {
+			t.Run(tc.name+"/"+step, func(t *testing.T) {
+				field := "deckhouseKeyConfirmedFor"
+				if step == "finish" {
+					field = "deckhouseKeyAddingFor"
+				}
+				state := fmt.Sprintf(`{%q:"webauthn","deckhouseKeyUserID":%q,"deckhouseKeyConnectorID":%q}`, field, tc.user, tc.connector)
+				f := newKeysFixture(t, 3, 1, state, false)
+				rr := f.post(t, step)
+				require.Contains(t, []int{http.StatusForbidden, http.StatusBadRequest}, rr.Code)
+				require.Contains(t, rr.Body.String(), keyNotConfirmedMsg)
+				require.Equal(t, 1, f.keys(t))
+				require.Zero(t, *f.ceremonies)
+				_, validated := f.state(t)
+				require.False(t, validated)
+			})
+		}
+	}
+
+	t.Run("a confirmation records its user", func(t *testing.T) {
+		f := newKeysFixture(t, 3, 1, unconfirmed, false)
+		require.NoError(t, f.h.setKeyConfirmed(t.Context(), f.authReq, "webauthn"))
+		state, _ := f.state(t)
+		require.Equal(t, "webauthn", state.keyConfirmedFor(f.authReq))
+		other := f.authReq
+		other.Claims.UserID = "user-2"
+		require.Empty(t, state.keyConfirmedFor(other))
+	})
+}
+
+// With a choice of the second factor, a user who has both methods adds a key: the key is the user's own method,
+// not a second one.
+func TestKeysAddWithAChoice(t *testing.T) {
+	f := newKeysFixture(t, 3, 1, adding, true)
+
+	rr := f.post(t, "finish")
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	require.Equal(t, 2, f.keys(t))
+}
+
+// The page offers to add a key after the registered one, while there is room.
+func TestKeysPageOffersToAdd(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		limit, keys int
+		want        bool
+	}{
+		{name: "room for one more", limit: 3, keys: 1, want: true},
+		{name: "at the limit", limit: 2, keys: 2, want: false},
+		{name: "one key allowed", limit: 0, keys: 1, want: false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newKeysFixture(t, tc.limit, tc.keys, unconfirmed, false)
+			rr := f.page(t)
+			require.Equal(t, http.StatusOK, rr.Code)
+			require.Equal(t, tc.want, strings.Contains(rr.Body.String(), `id="add-key-btn"`))
+		})
+	}
+}
+
+// The ceremony of a new key excludes the keys the user has, so the browser does not register one of them again.
+func TestKeysBeginExcludesTheKeysOfTheUser(t *testing.T) {
+	f := newKeysFixture(t, 3, 2, confirmed, false)
+
+	rr := f.post(t, "begin")
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	var creation struct {
+		PublicKey struct {
+			ExcludeCredentials []struct {
+				ID string `json:"id"`
+			} `json:"excludeCredentials"`
+		} `json:"publicKey"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &creation))
+	require.Len(t, creation.PublicKey.ExcludeCredentials, 2)
+	for i, c := range creation.PublicKey.ExcludeCredentials {
+		require.Equal(t, base64.RawURLEncoding.EncodeToString([]byte(fmt.Sprintf("old-%d", i))), c.ID)
+	}
+}
+
+// A key the user has is refused as a new one, also for a request that loaded the account before a parallel one
+// stored that key: the check is inside the update.
+func TestKeysRefuseAKeyTheUserHas(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		stale bool
+	}{
+		{name: "a key the request saw"},
+		{name: "a key stored after the request read the account", stale: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newKeysFixture(t, 3, 2, adding, false)
+			if tc.stale {
+				f.h.Storage = fewerKeysStorage{Storage: f.store}
