+// endPair ends everything dex holds for a pair whose identity provider answered
+// that the user is gone or no longer let in (Deckhouse): its browser sessions and
+// its refresh tokens. Each is announced to the components that trust the tokens
+// without asking dex (see server/revocation) before it goes. Failures are logged:
+// the refusal stands either way, and a token or session left behind fails at its
+// next use against the same provider.
+func (g *refresh) endPair(ctx context.Context, userID, connectorID string) {
+	var sessions []storage.AuthSession
+	all, err := g.storage.ListAuthSessions(ctx)
+	if err != nil {
+		g.logger.ErrorContext(ctx, "failed to list auth sessions", "err", err)
+	}
+	for _, session := range all {
+		if session.UserID == userID && session.ConnectorID == connectorID {
+			sessions = append(sessions, session)
+		}
+	}
+
+	var refreshes []storage.RefreshToken
+	offline, err := g.storage.GetOfflineSessions(ctx, userID, connectorID)
+	if err != nil && !errors.Is(err, storage.ErrNotFound) {
+		g.logger.ErrorContext(ctx, "failed to get offline sessions", "err", err)
+	}
+	for _, ref := range offline.Refresh {
+		refresh, err := g.storage.GetRefresh(ctx, ref.ID)
+		if err != nil {
+			continue
+		}
+		refreshes = append(refreshes, refresh)
+	}
+
+	if err := g.revocations.PairEnded(ctx, sessions, refreshes); err != nil {
+		g.logger.ErrorContext(ctx, "failed to record the end of the sessions of a user", "err", err)
+	}
