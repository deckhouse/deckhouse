+
+// With sessions on, a refresh serves the identity stored at the last login only
+// while it is younger than identityRefresh.maxAge, and reads it from the connector
+// after (Deckhouse).
+func TestRefreshReadsStaleIdentity(t *testing.T) {
+	now := time.Now().UTC().Round(time.Second)
+	const (
+		maxAge = 10 * time.Minute
+		grace  = 5 * time.Minute
+	)
+	stored := storage.Claims{UserID: "1", Username: "jane", Email: "jane.doe@example.com", Groups: []string{"a", "b"}}
+	upstream := connector.Identity{UserID: "1", Username: "jane2", Email: "jane.doe@example.com", Groups: []string{"x"}}
+
+	tests := []struct {
+		name string
+		// age is the age of the stored claims.
+		age         time.Duration
+		upstreamErr error
+		wantStatus  int
+		wantCalls   int
+		// wantUsername is the name the ID token carries.
+		wantUsername string
+		// wantStored is the identity stored after the refresh.
+		wantStored storage.Claims
+		// wantEnded expects everything of the pair to be ended.
+		wantEnded bool
+	}{
+		{
+			name:         "fresh claims are served stored",
+			age:          maxAge - time.Second,
+			wantStatus:   http.StatusOK,
+			wantUsername: "jane",
+			wantStored:   stored,
+		},
+		{
+			name:         "stale claims are read and stored",
+			age:          maxAge,
+			wantStatus:   http.StatusOK,
+			wantCalls:    1,
+			wantUsername: "jane2",
+			wantStored:   storage.Claims{UserID: "1", Username: "jane2", Email: "jane.doe@example.com", Groups: []string{"x"}},
+		},
+		{
+			name:        "provider answers the user is gone",
+			age:         maxAge,
+			upstreamErr: fmt.Errorf("user not found: %w", connector.ErrIdentityGone),
+			wantStatus:  http.StatusBadRequest,
+			wantCalls:   1,
+			wantStored:  stored,
+			wantEnded:   true,
+		},
+		{
+			name:        "provider refuses only the credential",
+			age:         maxAge,
+			upstreamErr: &xoauth2.RetrieveError{ErrorCode: "invalid_grant"},
+			wantStatus:  http.StatusBadRequest,
+			wantCalls:   1,
+			wantStored:  stored,
+		},
+		{
+			name:         "provider fails within the grace period",
+			age:          maxAge + grace - time.Second,
+			upstreamErr:  errors.New("connection refused"),
+			wantStatus:   http.StatusOK,
+			wantCalls:    1,
+			wantUsername: "jane",
+			wantStored:   stored,
+		},
+		{
+			name:        "provider fails after the grace period",
+			age:         maxAge + grace,
+			upstreamErr: errors.New("connection refused"),
+			wantStatus:  http.StatusInternalServerError,
+			wantCalls:   1,
+			wantStored:  stored,
+		},
+		{
+			name:        "provider unreachable after the grace period",
+			age:         maxAge + grace,
+			upstreamErr: &url.Error{Op: "Post", URL: "https://idp.example.com/token", Err: errors.New("connection refused")},
+			wantStatus:  http.StatusServiceUnavailable,
+			wantCalls:   1,
+			wantStored:  stored,
+		},
+		{
+			name:        "provider answers without anything to refresh with, within the grace period",
+			age:         maxAge,
+			upstreamErr: fmt.Errorf("oidc: failed to get refresh token: %w", connector.ErrRefreshRefused),
+			wantStatus:  http.StatusBadRequest,
+			wantCalls:   1,
+			wantStored:  stored,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, s := newTestServer(t, func(c *Config) {
+				c.Now = func() time.Time { return now }
+				c.SessionConfig = &session.Config{
+					CookieName:          "dex_session",
+					AbsoluteLifetime:    24 * time.Hour,
+					ValidIfNotUsedFor:   time.Hour,
+					IdentityMaxAge:      maxAge,
+					IdentityGracePeriod: grace,
+				}
+			})
+			defer httpServer.Close()
+
+			ctx := t.Context()
+			mockRefreshTokenTestStorage(t, s.storage, false)
+			conn := &scriptedRefreshConnector{identity: upstream, err: tc.upstreamErr}
+			s.connectors.Set("test", connectors.Connector{Connector: conn})
+
+			require.NoError(t, s.storage.CreateUserIdentity(ctx, storage.UserIdentity{
+				UserID: "1", ConnectorID: "test", Claims: stored,
+				LastLogin: now.Add(-time.Hour), ClaimsRefreshedAt: now.Add(-tc.age),
+			}))
+			// Another client's token of the pair, its browser session, and a
+			// session of another pair.
+			other := newTestRefreshToken(t, s, "1", "test", "other")
+			require.NoError(t, s.storage.UpdateOfflineSessions(ctx, "1", "test", func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+				old.Refresh["other"] = &storage.RefreshTokenRef{ID: other, ClientID: "other"}
+				return old, nil
+			}))
+			newTestAuthSession(t, s, "1", "test", "pair-session")
+			newTestAuthSession(t, s, "2", "test", "another-pair")
+
+			rr := postRefresh(t, s, "test", "bar")
+			require.Equal(t, tc.wantStatus, rr.Code, rr.Body.String())
+			assert.Equal(t, tc.wantCalls, conn.calls, "calls to the connector")
+
+			ui, err := s.storage.GetUserIdentity(ctx, "1", "test")
+			require.NoError(t, err)
+			assert.Equal(t, tc.wantStored, ui.Claims)
+			if tc.wantCalls == 1 && tc.wantStatus == http.StatusOK && tc.upstreamErr == nil {
+				assert.Equal(t, now, ui.ClaimsRefreshedAt)
+			}
+
+			if tc.wantStatus == http.StatusOK {
+				var resp struct {
+					IDToken string `json:"id_token"`
+				}
+				require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &resp))
+				assert.Equal(t, tc.wantUsername, decodeJWTClaims(t, resp.IDToken)["name"])
+			}
+
+			_, errToken := s.storage.GetRefresh(ctx, "test")
+			_, errOther := s.storage.GetRefresh(ctx, other)
+			_, errSession := s.storage.GetAuthSession(ctx, "pair-session")
+			_, errAnother := s.storage.GetAuthSession(ctx, "another-pair")
+			require.NoError(t, errAnother, "another pair is left alone")
+			if !tc.wantEnded {
+				require.NoError(t, errOther, "the pair's other token is kept")
+				require.NoError(t, errSession, "the pair's session is kept")
+				if tc.wantStatus != http.StatusBadRequest {
+					require.NoError(t, errToken, "the token is kept")
+				}
+				return
+			}
+
+			require.ErrorIs(t, errToken, storage.ErrNotFound)
+			require.ErrorIs(t, errOther, storage.ErrNotFound)
+			require.ErrorIs(t, errSession, storage.ErrNotFound)
+
+			var kinds []string
+			for _, rev := range serverRevocations(t, s) {
+				assert.Equal(t, revocation.ReasonIdentityGone, rev.Reason)
+				kinds = append(kinds, string(rev.Type)+":"+rev.SessionID+rev.GrantID)
+			}
+			assert.ElementsMatch(t, []string{"session:pair-session", "grant:test", "grant:" + other}, kinds)
+		})
+	}
+}
+
+// TestRefreshEndedPairNotifiesBackchannel: when the provider answers that the user is
+// gone, the relying parties of the browser sessions it ends get a logout token, as
+// at a logout (Deckhouse).
+func TestRefreshEndedPairNotifiesBackchannel(t *testing.T) {
+	now := time.Now().UTC().Round(time.Second)
+	rp, wait := startBackchannelRP(t, http.StatusOK)
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.Now = func() time.Time { return now }
+		c.SessionConfig = &session.Config{
+			CookieName:        "dex_session",
+			AbsoluteLifetime:  24 * time.Hour,
+			ValidIfNotUsedFor: time.Hour,
+			IdentityMaxAge:    10 * time.Minute,
+		}
+	})
+	defer httpServer.Close()
+
+	ctx := t.Context()
+	mockRefreshTokenTestStorage(t, s.storage, false)
+	s.connectors.Set("test", connectors.Connector{Connector: &scriptedRefreshConnector{
+		err: fmt.Errorf("user not found: %w", connector.ErrIdentityGone),
+	}})
+	require.NoError(t, s.storage.CreateUserIdentity(ctx, storage.UserIdentity{
+		UserID: "1", ConnectorID: "test", Claims: storage.Claims{UserID: "1", Username: "jane"},
+		LastLogin: now.Add(-time.Hour), ClaimsRefreshedAt: now.Add(-time.Hour),
+	}))
+	require.NoError(t, s.storage.CreateClient(ctx, storage.Client{
+		ID: "web-a", Secret: "secret", RedirectURIs: []string{"https://example.com/callback"},
+		BackchannelLogoutURI: rp.URL + "/web-a",
+	}))
+	require.NoError(t, s.storage.CreateAuthSession(ctx, storage.AuthSession{
+		ID: "pair-session", Secret: testSessionSecret("pair-session"),
+		UserID: "1", ConnectorID: "test", CreatedAt: now, LastActivity: now,
+		ClientStates: map[string]*storage.ClientAuthState{"web-a": {AuthenticatedAt: now}},
+	}))
+
+	rr := postRefresh(t, s, "test", "bar")
+	require.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+
+	got := wait(1)
+	require.Len(t, got, 1)
+	assert.Equal(t, "web-a", got[0].clientID)
+	assert.Equal(t, "pair-session", decodeJWTClaims(t, got[0].token)["sid"])
+}
+
+// postRefresh posts a refresh of the token id with its secret token for the client
+// "test".
+func postRefresh(t *testing.T, s *Server, id, token string) *httptest.ResponseRecorder {
+	t.Helper()
+	tokenData, err := internal.Marshal(&internal.RefreshToken{RefreshId: id, Token: token})
+	require.NoError(t, err)
+	v := url.Values{"grant_type": {"refresh_token"}, "refresh_token": {tokenData}}
+	req := httptest.NewRequest(http.MethodPost, "/token", bytes.NewBufferString(v.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth("test", "barfoo")
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	return rr
+}
+
+// scriptedRefreshConnector answers every refresh with identity, or with err, and
+// counts the refreshes.
+type scriptedRefreshConnector struct {
+	identity connector.Identity
+	err      error
+	calls    int
+}
+
+func (c *scriptedRefreshConnector) LoginURL(_ connector.Scopes, callbackURL, state string) (string, []byte, error) {
+	return callbackURL + "?state=" + url.QueryEscape(state), nil, nil
+}
+
+func (c *scriptedRefreshConnector) HandleCallback(connector.Scopes, []byte, *http.Request) (connector.Identity, error) {
+	return c.identity, nil
+}
+
+func (c *scriptedRefreshConnector) Refresh(context.Context, connector.Scopes, connector.Identity) (connector.Identity, error) {
+	c.calls++
+	if c.err != nil {
+		return connector.Identity{}, c.err
+	}
+	return c.identity, nil
+}
