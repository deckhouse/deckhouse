+// resolveIdentityRefresh returns the identity refresh of c (Deckhouse): the
+// top-level identityRefresh, or sessions.identityRefresh when only that one is
+// set, whether sessions are enabled or not; nil when neither is.
+func resolveIdentityRefresh(c Config) (*session.IdentityRefresh, error) {
+	r := c.IdentityRefresh
+	if r == nil && c.Sessions != nil {
+		r = c.Sessions.IdentityRefresh
+	}
+	if r == nil {
+		return nil, nil
+	}
+	var (
+		resolved session.IdentityRefresh
+		err      error
+	)
+	if resolved.MaxAge, err = parseNonNegativeDuration("identityRefresh.maxAge", r.MaxAge); err != nil {
+		return nil, err
+	}
+	if resolved.GracePeriod, err = parseNonNegativeDuration("identityRefresh.gracePeriod", r.GracePeriod); err != nil {
+		return nil, err
+	}
+	return &resolved, nil
 }
 
+// parseNonNegativeDuration parses the duration of the option name; an empty one
+// is zero.
+func parseNonNegativeDuration(name, value string) (time.Duration, error) {
+	if value == "" {
+		return 0, nil
+	}
+	d, err := time.ParseDuration(value)
+	if err != nil {
+		return 0, fmt.Errorf("invalid %s %q: %v", name, value, err)
+	}
+	if d < 0 {
+		return 0, fmt.Errorf("%s must not be negative, got %v", name, d)
+	}
+	return d, nil
+}
