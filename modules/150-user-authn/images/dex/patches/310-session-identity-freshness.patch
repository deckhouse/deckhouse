+// localClaims reads the claims of a local user from its password through the
+// local connector (Deckhouse); false when the user is gone or the read failed.
+func (h *Handler) localClaims(ctx context.Context, stored storage.Claims) (storage.Claims, bool) {
+	conn, err := h.Connectors.Get(ctx, connectors.LocalConnector)
+	if err != nil {
+		h.Logger.ErrorContext(ctx, "session: failed to get the local connector", "err", err)
+		return storage.Claims{}, false
+	}
+	refresher, ok := conn.Connector.(connector.RefreshConnector)
+	if !ok {
+		return stored, true
+	}
+	ident, err := refresher.Refresh(ctx, connector.Scopes{Groups: true}, tokens.IdentityFromClaims(stored))
+	if err != nil {
+		h.Logger.DebugContext(ctx, "session: failed to read the local user, falling back to the login", "err", err)
+		return storage.Claims{}, false
+	}
+	return tokens.ClaimsFromIdentity(ident), true
+}
