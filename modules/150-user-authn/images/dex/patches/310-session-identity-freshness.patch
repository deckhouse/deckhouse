+// TestRefreshed: claims read again outside a login replace the stored ones, unless
+// those were read later (Deckhouse).
+func TestRefreshed(t *testing.T) {
+	ctx := t.Context()
+	s := newStorage(t)
+	require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{
+		UserID: "jane", ConnectorID: "ldap", Claims: claims, ClaimsRefreshedAt: t0,
+	}))
+
+	newClaims := claims
+	newClaims.Groups = []string{"admins"}
+
+	require.NoError(t, Refreshed(ctx, s, "jane", "ldap", newClaims, t0.Add(-time.Second)))
+	got, err := s.GetUserIdentity(ctx, "jane", "ldap")
+	require.NoError(t, err)
+	require.Equal(t, claims, got.Claims, "claims read before the stored ones do not replace them")
+
+	require.NoError(t, Refreshed(ctx, s, "jane", "ldap", newClaims, t0.Add(time.Second)))
+	got, err = s.GetUserIdentity(ctx, "jane", "ldap")
+	require.NoError(t, err)
+	require.Equal(t, newClaims, got.Claims)
+	require.Equal(t, t0.Add(time.Second), got.ClaimsRefreshedAt)
+
+	require.ErrorIs(t, Refreshed(ctx, s, "gone", "ldap", newClaims, t0), storage.ErrNotFound)
