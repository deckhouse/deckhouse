+
+// TestParseSessionConfigIdentityRefresh: how long the stored identity is served
+// with sessions on (Deckhouse).
+func TestParseSessionConfigIdentityRefresh(t *testing.T) {
+	t.Run("defaults read the identity at every refresh", func(t *testing.T) {
+		sc, err := parseSessionConfig(&Sessions{})
+		require.NoError(t, err)
+		assert.Zero(t, sc.IdentityMaxAge)
+		assert.Zero(t, sc.IdentityGracePeriod)
+	})
+
+	t.Run("values", func(t *testing.T) {
+		sc, err := parseSessionConfig(&Sessions{IdentityRefresh: &IdentityRefresh{MaxAge: "10m", GracePeriod: "30s"}})
+		require.NoError(t, err)
+		assert.Equal(t, 10*time.Minute, sc.IdentityMaxAge)
+		assert.Equal(t, 30*time.Second, sc.IdentityGracePeriod)
+	})
+
+	for _, tc := range []struct {
+		name    string
+		refresh IdentityRefresh
+	}{
+		{"negative max age", IdentityRefresh{MaxAge: "-1m"}},
+		{"negative grace period", IdentityRefresh{GracePeriod: "-1s"}},
+		{"not a duration", IdentityRefresh{MaxAge: "10 minutes"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := parseSessionConfig(&Sessions{IdentityRefresh: &tc.refresh})
+			require.Error(t, err)
+		})
+	}
+}
+
+// TestResolveIdentityRefresh: the identity refresh applies whether sessions are
+// enabled or not (Deckhouse). The top-level identityRefresh wins over
+// sessions.identityRefresh, which stays accepted alone.
+func TestResolveIdentityRefresh(t *testing.T) {
+	tenMinutes := &IdentityRefresh{MaxAge: "10m", GracePeriod: "30s"}
+	tests := []struct {
+		name    string
+		config  Config
+		want    *session.IdentityRefresh
+		wantErr bool
+	}{
+		{name: "neither", config: Config{}},
+		{name: "sessions without identityRefresh", config: Config{Sessions: &Sessions{}}},
+		{
+			name:   "top-level",
+			config: Config{IdentityRefresh: tenMinutes},
+			want:   &session.IdentityRefresh{MaxAge: 10 * time.Minute, GracePeriod: 30 * time.Second},
+		},
+		{
+			name:   "sessions only",
+			config: Config{Sessions: &Sessions{IdentityRefresh: tenMinutes}},
+			want:   &session.IdentityRefresh{MaxAge: 10 * time.Minute, GracePeriod: 30 * time.Second},
+		},
+		{
+			name:   "top-level wins",
+			config: Config{IdentityRefresh: &IdentityRefresh{MaxAge: "5m"}, Sessions: &Sessions{IdentityRefresh: tenMinutes}},
+			want:   &session.IdentityRefresh{MaxAge: 5 * time.Minute},
+		},
+		{name: "negative max age", config: Config{IdentityRefresh: &IdentityRefresh{MaxAge: "-1m"}}, wantErr: true},
+		{name: "not a duration", config: Config{IdentityRefresh: &IdentityRefresh{GracePeriod: "soon"}}, wantErr: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := resolveIdentityRefresh(tc.config)
+			if tc.wantErr {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, got)
+		})
+	}
+}
