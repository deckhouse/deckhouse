+		// The relying parties of the session learn that it ended, as at a logout
+		// (OpenID Connect Back-Channel Logout).
+		if g.backchannel != nil {
+			g.backchannel.Notify(ctx, &session)
+		}
+		if err := g.storage.DeleteAuthSession(ctx, session.ID); err != nil && !errors.Is(err, storage.ErrNotFound) {
+			g.logger.ErrorContext(ctx, "failed to delete auth session", "session_id", session.ID, "err", err)
+		}
