+	// with the groups whatever this token asked for. The token carries only what
+	// it asked for (see tokens.Issuer).
+	up := upstream(conn, append(slices.Clone(scopes), tokens.ScopeGroups))
+	// A request that waited for another one to read the identity is served what
+	// that one stored, and spends no credential of its own.
+	up.Stored = func(ctx context.Context) (connector.Identity, bool) {
+		fresh, err := g.storage.GetUserIdentity(ctx, ui.UserID, ui.ConnectorID)
+		if err != nil || !g.sessions.ClaimsFresh(fresh, g.now()) {
+			return connector.Identity{}, false
+		}
+		return tokens.IdentityFromClaims(fresh.Claims), true
+	}
