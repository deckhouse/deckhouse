+// TestRecordWithoutGroups checks that a login which did not ask the connector for
+// the groups keeps the groups stored and leaves the claims as old as they were
+// (Deckhouse).
+func TestRecordWithoutGroups(t *testing.T) {
+	ctx := t.Context()
+	noGroups := claims
+	noGroups.Groups = nil
+	noGroups.Email = "jane.new@example.com"
+
+	t.Run("an identity read before", func(t *testing.T) {
+		s := newStorage(t)
+		readAt := t0.Add(-time.Hour)
+		require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{
+			UserID: "jane", ConnectorID: "ldap", Claims: claims, ClaimsRefreshedAt: readAt,
+		}))
+
+		_, err := Record(ctx, s, Login{ConnectorID: "ldap", Claims: noGroups, Time: t0, Complete: true})
+		require.NoError(t, err)
+
+		got, err := s.GetUserIdentity(ctx, "jane", "ldap")
+		require.NoError(t, err)
+		require.Equal(t, claims.Groups, got.Claims.Groups, "the groups stored are kept")
+		require.Equal(t, "jane.new@example.com", got.Claims.Email, "the rest of the claims is the login's")
+		require.Equal(t, readAt, got.ClaimsRefreshedAt, "the claims are as old as before")
+		require.Equal(t, t0, got.LastLogin)
+	})
+
+	t.Run("the first login", func(t *testing.T) {
+		s := newStorage(t)
+		_, err := Record(ctx, s, Login{ConnectorID: "ldap", Claims: noGroups, Time: t0, Complete: true})
+		require.NoError(t, err)
+
+		got, err := s.GetUserIdentity(ctx, "jane", "ldap")
+		require.NoError(t, err)
+		require.Empty(t, got.Claims.Groups)
+		require.Equal(t, claimsOfUnknownAge, got.ClaimsRefreshedAt, "claims without the groups are stale from the start")
+	})
+}
