+	var upstreamErr *tokens.UpstreamError
+	switch {
+	case errors.As(err, &upstreamErr) && upstreamErr.Refused && identityGone(upstreamErr.Err):
+		g.logger.WarnContext(ctx, "refresh refused by the upstream provider, ending the sessions of the user",
+			upstreamRefusal(upstreamErr.Err, refreshToken)...)
+		g.endPair(ctx, refreshToken.Claims.UserID, refreshToken.ConnectorID)
