+// the one of the session configuration, or none, which reads the claims at every
+// refresh.
+func (m *Manager) identityRefresh() IdentityRefresh {
+	switch {
+	case m.IdentityRefresh != nil:
+		return *m.IdentityRefresh
+	case m.Config != nil:
+		return IdentityRefresh{MaxAge: m.Config.IdentityMaxAge, GracePeriod: m.Config.IdentityGracePeriod}
+	}
+	return IdentityRefresh{}
+}
+
+// ClaimsFresh reports whether the claims stored for ui may be served at now
+// without reading them from the connector (Deckhouse): they are younger than
+// the identity refresh max age. The claims of a local user are never served
+// stored: reading them again costs one read of its password, and a deleted user
+// or a changed group then shows at once.
+func (m *Manager) ClaimsFresh(ui storage.UserIdentity, now time.Time) bool {
+	if ui.ConnectorID == localConnector {
+		return false
+	}
+	return claimsAge(ui, now) < m.identityRefresh().MaxAge
+}
+
+// ClaimsUsable reports whether the stored claims of ui may still be served at now
+// when the connector failed to answer (Deckhouse): they are younger than the
+// identity refresh max age and grace period together.
+func (m *Manager) ClaimsUsable(ui storage.UserIdentity, now time.Time) bool {
+	r := m.identityRefresh()
+	return claimsAge(ui, now) < r.MaxAge+r.GracePeriod
+}
+
+// claimsAge is how long ago the stored claims of ui were read from the connector.
+// An identity stored before ClaimsRefreshedAt existed has the claims of its last
+// login, and one that has no login either has claims of unknown age.
+func claimsAge(ui storage.UserIdentity, now time.Time) time.Duration {
+	readAt := ui.ClaimsRefreshedAt
+	if readAt.IsZero() {
+		readAt = ui.LastLogin
+	}
+	if readAt.IsZero() {
+		return math.MaxInt64
+	}
+	return now.Sub(readAt)
+}
