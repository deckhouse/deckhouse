+		g.logger.WarnContext(ctx, "refresh: the upstream provider did not answer, serving the stored identity",
+			"connector_id", refreshToken.ConnectorID, "client_id", refreshToken.ClientID,
+			"claims_refreshed_at", ui.ClaimsRefreshedAt, "err", err)
+		return rotateStoredClaims()
+	default:
+		return "", ident, g.rotateError(ctx, err, refreshToken)
