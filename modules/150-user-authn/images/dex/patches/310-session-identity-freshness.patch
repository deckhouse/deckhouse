+			if err := useridentity.Refreshed(ctx, g.storage, ui.UserID, ui.ConnectorID, tokens.ClaimsFromIdentity(ident), now); err != nil {
+				g.logger.ErrorContext(ctx, "failed to store the identity read from the connector", "err", err)
+			}
+		}
+	}
+	rawNewToken, ident, err := g.issuer.Refresh.RotateUpstream(ctx, refreshToken, req.refreshID, g.policy, up)
+	if err == nil {
+		return rawNewToken, ident, nil
+	}
