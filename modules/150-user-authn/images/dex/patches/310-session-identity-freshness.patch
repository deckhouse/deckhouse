+// rotateStored rotates the refresh token of a pair whose identity dex stores.
+// Upstream serves the stored claims with sessions on and never asks the
+// connector; here (Deckhouse) they are served, with sessions on or off, while
+// younger than identityRefresh maxAge (see session.Manager.ClaimsFresh), and read
+// from the connector after, and stored for the refreshes to come.
+//
+// A provider that answers the user is gone or no longer let in ends everything
+// the pair holds (see endPair); another answer that cannot refresh the identity is
+// invalid_grant at once (see rotateError). A provider that fails to answer leaves
+// the stored claims served for the grace period beyond maxAge; after it the refresh
+// fails with temporarily_unavailable (a server error when the connector does not
+// explain the failure), and the token is kept for when the provider is back.
+func (g *refresh) rotateStored(ctx context.Context, req *Request, refreshToken *storage.RefreshToken, ui storage.UserIdentity, conn connectors.Connector, scopes []string) (string, connector.Identity, *oauth2.Error) {
+	now := g.now()
+	stored := func(context.Context) (connector.Identity, error) { return tokens.IdentityFromClaims(ui.Claims), nil }
+	rotateStoredClaims := func() (string, connector.Identity, *oauth2.Error) {
+		rawNewToken, ident, err := g.issuer.Refresh.Rotate(ctx, refreshToken, req.refreshID, g.policy, stored)
+		if err != nil {
+			return "", ident, g.rotateError(ctx, err, refreshToken)
+		}
+		return rawNewToken, ident, nil
+	}
