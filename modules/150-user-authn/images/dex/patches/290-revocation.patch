+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/signer"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// The refresh token of the test vectors. Kept in constants so that secret scanners do not
+// take the literal for a credential.
+const (
+	vectorRefreshID   = "3w4l2zgokgsohvjnqzjrv7lmz"
+	vectorRefreshBody = "pbtiicr6kqrwrlqv3vn6h3pdr"
+)
+
+var t0 = time.Date(2026, 10, 16, 10, 0, 0, 0, time.UTC)
+
+func newStorage(t *testing.T) storage.Storage {
+	t.Helper()
+	return memory.New(slog.New(slog.DiscardHandler))
+}
+
+// failingGet fails every read of an identity.
+type failingGet struct {
+	storage.Storage
+}
+
+var errStorage = errors.New("storage unavailable")
+
+func (failingGet) GetUserIdentity(context.Context, string, string) (storage.UserIdentity, error) {
+	return storage.UserIdentity{}, errStorage
+}
+
+func TestCurrent(t *testing.T) {
+	ctx := t.Context()
+	s := newStorage(t)
+	require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{UserID: "jane", ConnectorID: "local", Generation: 3}))
+
+	gen, err := Current(ctx, s, "jane", "local")
+	require.NoError(t, err)
+	require.Equal(t, uint64(3), gen)
+
+	gen, err = Current(ctx, s, "john", "local")
+	require.NoError(t, err, "a pair without an identity revoked nothing")
+	require.Zero(t, gen)
+
+	_, err = Current(ctx, failingGet{Storage: s}, "jane", "local")
+	require.ErrorIs(t, err, errStorage)
+}
+
+func TestCheck(t *testing.T) {
+	ctx := t.Context()
+	s := newStorage(t)
+	require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{UserID: "jane", ConnectorID: "local", Generation: 3}))
+
+	tests := []struct {
+		name       string
+		userID     string
+		generation uint64
+		expected   error
+	}{
+		{name: "current generation", userID: "jane", generation: 3},
+		{name: "revoked since", userID: "jane", generation: 2, expected: ErrRevoked},
+		{name: "issued to a record created again", userID: "jane", generation: 4, expected: ErrRevoked},
+		{name: "pair without an identity", userID: "john", generation: 0},
+		{name: "pair whose identity was deleted", userID: "john", generation: 1, expected: ErrRevoked},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := Check(t.Context(), s, tt.userID, "local", tt.generation)
+			if tt.expected == nil {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, tt.expected)
+		})
+	}
+
+	err := Check(ctx, failingGet{Storage: s}, "jane", "local", 3)
+	require.ErrorIs(t, err, errStorage)
+	require.NotErrorIs(t, err, ErrRevoked)
+}
+
+func TestCheckToken(t *testing.T) {
+	ctx := t.Context()
+	s := newStorage(t)
+	require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{UserID: "jane", ConnectorID: "local", Generation: 3}))
+
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	sig, err := signer.NewMockSigner(key)
+	require.NoError(t, err)
+	issuerURL, err := url.Parse("https://issuer.example.com")
+	require.NoError(t, err)
+	issuer := tokens.NewIssuer(s, sig, *issuerURL, time.Hour, time.Now, slog.New(slog.DiscardHandler))
+	verifier := oidc.NewVerifier(issuerURL.String(), &signer.KeySet{Signer: sig}, &oidc.Config{SkipClientIDCheck: true})
+
+	token := func(userID, connectorID string, generation uint64) *oidc.IDToken {
+		t.Helper()
+		raw, _, err := issuer.SignAccessToken(ctx, tokens.Authorization{
+			Client:      storage.Client{ID: "client"},
+			Claims:      storage.Claims{UserID: userID},
+			ConnectorID: connectorID,
+			Generation:  generation,
+		})
+		require.NoError(t, err)
+		idToken, err := verifier.Verify(ctx, raw)
+		require.NoError(t, err)
+		return idToken
+	}
+
+	require.NoError(t, CheckToken(ctx, s, token("jane", "local", 3)))
+	require.ErrorIs(t, CheckToken(ctx, s, token("jane", "local", 2)), ErrRevoked)
+	require.ErrorIs(t, CheckToken(ctx, s, token("jane", "local", 0)), ErrRevoked, "no claim is generation 0")
+	require.NoError(t, CheckToken(ctx, s, token("john", "local", 0)), "a token without the claim stays valid")
+	require.NoError(t, CheckToken(ctx, failingGet{Storage: s}, token("client", "", 0)),
+		"a client's own token (client_credentials) has no pair to read")
+}
+
+// TestSubjectVectors checks the encoding of "sub" that the subscribers of
+// revocations decode (contract MR3, appendix A).
+func TestSubjectVectors(t *testing.T) {
+	for _, tc := range []struct {
+		userID, connectorID, expected string
+	}{
+		{"jane", "local", "CgRqYW5lEgVsb2NhbA"},
+		{"cn=jdoe,ou=people,dc=example,dc=org", "ldap", "CiNjbj1qZG9lLG91PXBlb3BsZSxkYz1leGFtcGxlLGRjPW9yZxIEbGRhcA"},
+	} {
+		sub, err := tokens.GenSubject(tc.userID, tc.connectorID)
+		require.NoError(t, err)
+		require.Equal(t, tc.expected, sub)
+	}
+
+	refresh, err := internal.Marshal(&internal.RefreshToken{RefreshId: vectorRefreshID, Token: vectorRefreshBody})
+	require.NoError(t, err)
+	require.Equal(t, "ChkzdzRsMnpnb2tnc29odmpucXpqcnY3bG16EhlwYnRpaWNyNmtxcndybHF2M3ZuNmgzcGRy", refresh)
+}
+
+func TestRecorder(t *testing.T) {
+	ctx := t.Context()
+	s := newStorage(t)
+	r := NewRecorder(storage.WithStaticClients(s, nil), func() time.Time { return t0 })
+	require.True(t, r.Enabled(), "found behind the static wrappers")
+
+	session := storage.AuthSession{
+		ID:          "fehzwdh5qy4oyqcn7qhkcgzbm",
+		UserID:      "jane",
+		ConnectorID: "local",
+		ClientStates: map[string]*storage.ClientAuthState{
+			"kubeconfig-generator-0":               {},
+			"console-d8-console-dex-authenticator": {},
+		},
+	}
+	require.NoError(t, r.SessionEnded(ctx, session))
+	require.NoError(t, r.SessionEnded(ctx, session), "a session ended twice is one revocation")
+
+	refresh := storage.RefreshToken{
+		ID:          "3w4l2zgokgsohvjnqzjrv7lmz",
+		ClientID:    "kubeconfig-generator-0",
+		ConnectorID: "local",
+		Claims:      storage.Claims{UserID: "jane"},
+	}
+	require.NoError(t, r.GrantRevoked(ctx, refresh))
+
+	got, err := s.(interface {
+		ListRevocations(context.Context) ([]storage.Revocation, error)
+	}).ListRevocations(ctx)
+	require.NoError(t, err)
+	require.ElementsMatch(t, []storage.Revocation{
+		{
+			Type:        storage.RevocationSession,
+			ConnectorID: "local",
+			UserID:      "jane",
+			Subject:     "CgRqYW5lEgVsb2NhbA",
+			SessionID:   "fehzwdh5qy4oyqcn7qhkcgzbm",
+			Clients:     []string{"console-d8-console-dex-authenticator", "kubeconfig-generator-0"},
+			Reason:      "SessionLogout",
+			Source:      "dex",
+			CreatedAt:   t0,
+		},
+		{
+			Type:        storage.RevocationGrant,
+			ConnectorID: "local",
+			UserID:      "jane",
+			Subject:     "CgRqYW5lEgVsb2NhbA",
+			GrantID:     "3w4l2zgokgsohvjnqzjrv7lmz",
+			ClientID:    "kubeconfig-generator-0",
+			Clients:     []string{"kubeconfig-generator-0"},
+			Reason:      "TokenRevoked",
+			Source:      "dex",
+			CreatedAt:   t0,
+		},
+	}, got)
+}
+
+// noRevocations is a storage that keeps no revocations, as SQL, ent and etcd.
+type noRevocations struct {
+	storage.Storage
+}
+
+// failingRevocations cannot write revocations.
+type failingRevocations struct {
+	storage.Storage
+}
+
+func (failingRevocations) CreateRevocation(context.Context, storage.Revocation) error {
+	return errStorage
+}
+
+func TestRecorderWithoutRevocations(t *testing.T) {
+	ctx := t.Context()
+	session := storage.AuthSession{ID: "s1", UserID: "jane", ConnectorID: "local"}
+
+	r := NewRecorder(noRevocations{Storage: newStorage(t)}, time.Now)
+	require.False(t, r.Enabled())
+	require.NoError(t, r.SessionEnded(ctx, session), "nothing to record")
+
+	var nilRecorder *Recorder
+	require.False(t, nilRecorder.Enabled())
+	require.NoError(t, nilRecorder.GrantRevoked(ctx, storage.RefreshToken{ID: "r1"}))
+
+	r = NewRecorder(failingRevocations{Storage: newStorage(t)}, time.Now)
+	require.True(t, r.Enabled())
+	require.ErrorIs(t, r.SessionEnded(ctx, session), errStorage)
+}
