+package grants
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/go-jose/go-jose/v4"
+
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/server/ratelimit"
+	"github.com/dexidp/dex/server/signinlog"
+	"github.com/dexidp/dex/server/tokens"
+)
+
+// RevokePath is the token revocation endpoint (RFC 7009).
+const RevokePath = "/token/revoke"
+
+// jwtAlgorithms are the algorithms dex signs its tokens with.
+var jwtAlgorithms = []jose.SignatureAlgorithm{jose.RS256, jose.RS384, jose.RS512, jose.ES256, jose.ES384, jose.ES512}
+
+// handleRevoke serves /token/revoke, OAuth 2.0 Token Revocation (RFC 7009), for
+// the refresh tokens of dex. Its access and ID tokens are JWTs dex keeps no
+// state for: one of them cannot be revoked alone, so they get
+// unsupported_token_type. token_type_hint is ignored: the form of the token
+// tells which it is, and RFC 7009 §2.1 asks to look beyond the hint anyway.
+//
+// The token is looked up before its client is compared, so its secret is
+// checked first: a client learns nothing about a grant it does not hold the
+// token of. A token dex does not know or no longer honors is revoked already,
+// which is no error (RFC 7009 §2.2). The Revocation is recorded before the token
+// is deleted, so the subscribers hear of every token that goes; when it cannot
+// be recorded, nothing is deleted and the client may retry.
+func (h *Handler) handleRevoke(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	if r.Method != http.MethodPost {
+		h.writeError(ctx, w, &oauth2.Error{Type: oauth2.InvalidRequest, Description: "method not allowed", Status: http.StatusBadRequest})
+		return
+	}
+	req, oerr := parseRequest(r)
+	if oerr != nil {
+		h.writeError(ctx, w, oerr)
+		return
+	}
+	client, ok := h.authenticateClient(ctx, w, req)
+	if !ok {
+		return
+	}
+	// As at /token, the rate limit of the client address counts failed client
+	// credentials only: a refresh token cannot be guessed, and dex-authenticator
+	// revokes the tokens of all its users from one address.
+	ratelimit.Exempt(ctx)
+
+	token := r.PostFormValue("token")
+	if token == "" {
+		h.writeError(ctx, w, &oauth2.Error{Type: oauth2.InvalidRequest, Description: "Required param: token.", Status: http.StatusBadRequest})
+		return
+	}
+	if isJWT(token) {
+		h.writeError(ctx, w, &oauth2.Error{Type: oauth2.UnsupportedTokenType, Description: "Only refresh tokens can be revoked.", Status: http.StatusBadRequest})
+		return
+	}
+	refreshID, oerr := parseRefreshToken(token)
+	if oerr != nil {
+		h.writeError(ctx, w, oerr)
+		return
+	}
+
+	refresh, err := tokens.LookupRefreshToken(ctx, h.Storage, h.RefreshPolicy, h.Logger, nil, refreshID)
+	switch {
+	case errors.Is(err, tokens.ErrRefreshTokenInvalid), errors.Is(err, tokens.ErrRefreshTokenExpired):
+		writeRevoked(w)
+		return
+	case err != nil:
+		// Logged by the lookup.
+		h.writeError(ctx, w, &oauth2.Error{Type: oauth2.TemporarilyUnavailable, Status: http.StatusServiceUnavailable})
+		return
+	}
+
+	user := signinlog.ClaimsUser(refresh.Claims)
+	if refresh.ClientID != client.ID {
+		h.Logger.WarnContext(ctx, "token revocation refused: the token was issued to another client",
+			append(signinlog.Attrs(refresh.ConnectorID, client.ID, user), "token_client_id", refresh.ClientID)...)
+		h.writeError(ctx, w, &oauth2.Error{Type: oauth2.InvalidGrant, Description: "The token was issued to another client.", Status: http.StatusBadRequest})
+		return
+	}
+
+	if err := h.Revocations.GrantRevoked(ctx, *refresh); err != nil {
+		h.Logger.ErrorContext(ctx, "failed to record the revocation of a refresh token",
+			signinlog.Failed(err, refresh.ConnectorID, client.ID, user)...)
+		h.writeError(ctx, w, &oauth2.Error{Type: oauth2.TemporarilyUnavailable, Status: http.StatusServiceUnavailable})
+		return
+	}
+	// The revocation is recorded: a retry after a failure here finds the token
+	// gone or still there, and either way ends with it gone.
+	if err := h.Issuer.Refresh.RevokeGrant(ctx, refresh); err != nil {
+		h.Logger.ErrorContext(ctx, "failed to delete a revoked refresh token",
+			signinlog.Failed(err, refresh.ConnectorID, client.ID, user)...)
+		h.writeError(ctx, w, &oauth2.Error{Type: oauth2.ServerError, Status: http.StatusInternalServerError})
+		return
+	}
+
+	h.Logger.InfoContext(ctx, signinlog.TokenRevoked, signinlog.Attrs(refresh.ConnectorID, client.ID, user)...)
+	writeRevoked(w)
+}
+
+// writeRevoked answers a revocation that is done: 200 with an empty body.
+func writeRevoked(w http.ResponseWriter) {
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("Pragma", "no-cache")
+	w.WriteHeader(http.StatusOK)
+}
+
+// isJWT reports whether token is a signed JWT, the form of the access and ID
+// tokens of dex. Its refresh tokens are base64url without dots.
+func isJWT(token string) bool {
+	_, err := jose.ParseSigned(token, jwtAlgorithms)
+	return err == nil
+}
