+
+// TestIssuerGenerationClaim checks "d8_gen": present exactly when the pair has
+// a generation, so tokens of generation 0, all tokens before generations
+// existed among them, look as they did.
+func TestIssuerGenerationClaim(t *testing.T) {
+	ctx := t.Context()
+	iss, _ := newTestIssuer(t)
+
+	for _, tc := range []struct {
+		name       string
+		generation uint64
+		wantClaim  bool
+	}{
+		{name: "generation 0", generation: 0},
+		{name: "generation 3", generation: 3, wantClaim: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			auth := testAuthorization()
+			auth.Generation = tc.generation
+
+			ts, err := iss.Issue(ctx, auth, "", false)
+			require.NoError(t, err)
+			for _, token := range []string{ts.IDToken, ts.AccessToken} {
+				claims := decodeTestClaims(t, token)
+				gen, ok := claims["d8_gen"]
+				require.Equal(t, tc.wantClaim, ok, "d8_gen in %v", claims)
+				if ok {
+					require.EqualValues(t, tc.generation, gen)
+				}
+			}
+		})
+	}
+}
+
+// decodeTestClaims decodes the payload of a signed token without verifying it.
+func decodeTestClaims(t *testing.T, token string) map[string]any {
+	t.Helper()
+	parts := strings.Split(token, ".")
+	require.Len(t, parts, 3)
+	payload, err := base64.RawURLEncoding.DecodeString(parts[1])
+	require.NoError(t, err)
+	var claims map[string]any
+	require.NoError(t, json.Unmarshal(payload, &claims))
+	return claims
+}
