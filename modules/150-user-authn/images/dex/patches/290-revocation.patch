--- /dev/null
+++ b/server/session/session_generation_test.go
@@ -0,0 +1,47 @@
+package session
+
+import (
+	"log/slog"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// TestCreateOrUpdateAuthSessionGeneration checks that a session takes the
+// generation of the pair from each login on it: the session login refuses a
+// session whose generation is not the pair's.
+func TestCreateOrUpdateAuthSessionGeneration(t *testing.T) {
+	ctx := t.Context()
+	now := time.Date(2026, 10, 16, 12, 0, 0, 0, time.UTC)
+	store := memory.New(slog.New(slog.DiscardHandler))
+	m := &Manager{
+		Storage: store,
+		Config:  &Config{CookieName: "dex_session", AbsoluteLifetime: time.Hour, ValidIfNotUsedFor: time.Hour},
+		Now:     func() time.Time { return now },
+		Logger:  slog.New(slog.DiscardHandler),
+	}
+	login := storage.AuthRequest{ClientID: "client-1", ConnectorID: "local", Claims: storage.Claims{UserID: "jane"}, Generation: 4}
+
+	w := httptest.NewRecorder()
+	require.NoError(t, m.CreateOrUpdateAuthSession(ctx, httptest.NewRequest("GET", "/", nil), w, login, false))
+	sessions, err := store.ListAuthSessions(ctx)
+	require.NoError(t, err)
+	require.Len(t, sessions, 1)
+	require.Equal(t, uint64(4), sessions[0].Generation)
+
+	// The next login on the same browser updates it.
+	login.Generation = 5
+	r := httptest.NewRequest("GET", "/", nil)
+	r.AddCookie(w.Result().Cookies()[0])
+	require.NoError(t, m.CreateOrUpdateAuthSession(ctx, r, httptest.NewRecorder(), login, false))
+	session, err := store.GetAuthSession(ctx, sessions[0].ID)
+	require.NoError(t, err)
+	require.Equal(t, uint64(5), session.Generation)
+	require.Equal(t, internal.SessionCookieValue(session.ID, session.Secret, nil), w.Result().Cookies()[0].Value)
+}
