+		require.ErrorIs(t, err, storage.ErrNotFound)
+		requireErrorResponse(t, postToken(t, s, url.Values{"grant_type": {oauth2.GrantTypeRefreshToken}, "refresh_token": {second.RefreshToken}}),
+			http.StatusBadRequest, oauth2.InvalidGrant, "")
