@@ -0,0 +1,769 @@
+package server
+
+import (
+	"context"
+	"crypto"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/storage"
+)
+
+// The refresh token of the test vectors. Kept in constants so that secret scanners do not
+// take the literal for a credential.
+const (
+	vectorRefreshID   = "3w4l2zgokgsohvjnqzjrv7lmz"
+	vectorRefreshBody = "pbtiicr6kqrwrlqv3vn6h3pdr"
+)
+
+// The generations a pair moves to when its credentials issued at generation 2
+// are no longer valid: a revocation raised it, or its record was deleted and
+// created again from a lower one.
+var revokedGenerations = []struct {
+	name    string
+	current uint64
+}{
+	{name: "revoked", current: 3},
+	{name: "record created again", current: 1},
+}
+
+// setGeneration sets the generation of the pair, as the user-authn controller
+// does to revoke it.
+func setGeneration(t *testing.T, s *Server, userID, connectorID string, generation uint64) {
+	t.Helper()
+	ctx := t.Context()
+	err := s.storage.UpdateUserIdentity(ctx, userID, connectorID, func(u storage.UserIdentity) (storage.UserIdentity, error) {
+		u.Generation = generation
+		return u, nil
+	})
+	if errors.Is(err, storage.ErrNotFound) {
+		err = s.storage.CreateUserIdentity(ctx, storage.UserIdentity{UserID: userID, ConnectorID: connectorID, Generation: generation})
+	}
+	require.NoError(t, err)
+}
+
+// tokenResponse decodes a token response.
+func tokenResponse(t *testing.T, rr *httptest.ResponseRecorder) tokens.Response {
+	t.Helper()
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	var resp tokens.Response
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &resp))
+	return resp
+}
+
+// requireErrorResponse checks an OAuth2 error response and, when given, its
+// description.
+func requireErrorResponse(t *testing.T, rr *httptest.ResponseRecorder, status int, typ, description string) {
+	t.Helper()
+	require.Equal(t, status, rr.Code, rr.Body.String())
+	var resp struct {
+		Error       string `json:"error"`
+		Description string `json:"error_description"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &resp))
+	require.Equal(t, typ, resp.Error)
+	if description != "" {
+		require.Equal(t, description, resp.Description)
+	}
+}
+
+// requireGeneration checks the "d8_gen" claim of a token: absent for 0.
+func requireGeneration(t *testing.T, token string, generation uint64) {
+	t.Helper()
+	claims := idTokenClaims(t, token)
+	gen, ok := claims["d8_gen"]
+	if generation == 0 {
+		require.False(t, ok, "d8_gen in %v", claims)
+		return
+	}
+	require.True(t, ok, "no d8_gen in %v", claims)
+	require.EqualValues(t, generation, gen)
+}
+
+func refreshID(t *testing.T, refreshToken string) string {
+	t.Helper()
+	var token internal.RefreshToken
+	require.NoError(t, internal.Unmarshal(refreshToken, &token))
+	return token.RefreshId
+}
+
+// loginCode signs the user of the mock password connector "test" in through
+// the login form of client "test" and returns the authorization code.
+func loginCode(t *testing.T, s *Server, scopes ...string) string {
+	t.Helper()
+	ctx := t.Context()
+	authReq := storage.AuthRequest{
+		ID:            storage.NewID(),
+		ClientID:      "test",
+		ConnectorID:   "test",
+		RedirectURI:   "foo://bar.com/",
+		ResponseTypes: []string{oauth2.ResponseTypeCode},
+		Scopes:        append([]string{"openid"}, scopes...),
+		Expiry:        time.Now().Add(time.Minute),
+		HMACKey:       storage.NewHMACKey(crypto.SHA256),
+		MaxAge:        -1,
+	}
+	require.NoError(t, s.storage.CreateAuthRequest(ctx, authReq))
+
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, httptest.NewRequest(http.MethodPost, "/auth/test/login?state="+authReq.ID+"&login=test&password=test", nil))
+	require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+	rr, _ = followFlow(t, s, rr)
+	location, err := url.Parse(rr.Header().Get("Location"))
+	require.NoError(t, err)
+	code := location.Query().Get("code")
+	require.NotEmpty(t, code, "redirected to %s", location)
+	return code
+}
+
+func exchangeCode(t *testing.T, s *Server, code string) *httptest.ResponseRecorder {
+	t.Helper()
+	return postToken(t, s, url.Values{
+		"grant_type":   {oauth2.GrantTypeAuthorizationCode},
+		"code":         {code},
+		"redirect_uri": {"foo://bar.com/"},
+	})
+}
+
+// TestLoginCarriesGeneration follows the generation of the pair from the login
+// form to the code, the tokens and the refresh token.
+func TestLoginCarriesGeneration(t *testing.T) {
+	_, s := newLockTestServer(t)
+	setGeneration(t, s, mockUserID, "test", 2)
+
+	code := loginCode(t, s, "offline_access")
+	authCode, err := s.storage.GetAuthCode(t.Context(), code)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), authCode.Generation)
+
+	resp := tokenResponse(t, exchangeCode(t, s, code))
+	requireGeneration(t, resp.IDToken, 2)
+	requireGeneration(t, resp.AccessToken, 2)
+	refresh, err := s.storage.GetRefresh(t.Context(), refreshID(t, resp.RefreshToken))
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), refresh.Generation)
+
+	// A refresh at the current generation keeps it.
+	resp = tokenResponse(t, postToken(t, s, url.Values{
+		"grant_type": {oauth2.GrantTypeRefreshToken}, "refresh_token": {resp.RefreshToken},
+	}))
+	requireGeneration(t, resp.IDToken, 2)
+}
+
+func TestCodeExchangeOfRevokedPair(t *testing.T) {
+	for _, tc := range revokedGenerations {
+		t.Run(tc.name, func(t *testing.T) {
+			s, logs := newSignInLogServer(t, nil)
+			setGeneration(t, s, mockUserID, "test", 2)
+			code := loginCode(t, s)
+
+			setGeneration(t, s, mockUserID, "test", tc.current)
+			requireErrorResponse(t, exchangeCode(t, s, code), http.StatusBadRequest, oauth2.InvalidGrant, "Invalid or expired code parameter.")
+			requireRefusal(t, logs.last(t, "token request denied: credentials revoked"), "revoked", "test")
+
+			_, err := s.storage.GetAuthCode(t.Context(), code)
+			require.ErrorIs(t, err, storage.ErrNotFound, "the code is spent")
+		})
+	}
+}
+
+func TestRefreshOfRevokedPair(t *testing.T) {
+	for _, tc := range revokedGenerations {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s, logs := newSignInLogServer(t, nil)
+			setGeneration(t, s, mockUserID, "test", 2)
+			resp := tokenResponse(t, passwordGrant(t, s))
+			requireGeneration(t, resp.IDToken, 2)
+			refresh := url.Values{"grant_type": {oauth2.GrantTypeRefreshToken}, "refresh_token": {resp.RefreshToken}}
+
+			setGeneration(t, s, mockUserID, "test", tc.current)
+			requireErrorResponse(t, postToken(t, s, refresh), http.StatusBadRequest, oauth2.InvalidGrant,
+				"The credentials of this user were revoked. Sign in again.")
+			line := logs.last(t, "refresh denied: credentials revoked")
+			requireRefusal(t, line, "revoked", "test")
+			assert.Equal(t, mockUserID, line["user_id"])
+
+			// The grant is gone for good, with its reference.
+			_, err := s.storage.GetRefresh(ctx, refreshID(t, resp.RefreshToken))
+			require.ErrorIs(t, err, storage.ErrNotFound)
+			offline, err := s.storage.GetOfflineSessions(ctx, mockUserID, "test")
+			require.NoError(t, err)
+			require.NotContains(t, offline.Refresh, "test")
+
+			// The password grant authenticates anew: it is not refused, and its
+			// tokens carry the current generation.
+			resp = tokenResponse(t, passwordGrant(t, s))
+			requireGeneration(t, resp.IDToken, tc.current)
+			requireGeneration(t, resp.AccessToken, tc.current)
+		})
+	}
+}
+
+// A lock refuses first and keeps the refresh token, as without generations.
+func TestRefreshOfRevokedLockedPair(t *testing.T) {
+	_, s := newLockTestServer(t)
+	resp := tokenResponse(t, passwordGrant(t, s))
+	refresh := url.Values{"grant_type": {oauth2.GrantTypeRefreshToken}, "refresh_token": {resp.RefreshToken}}
+
+	setGeneration(t, s, mockUserID, "test", 1)
+	setBlockedUntil(t, s, "test", time.Now().Add(time.Hour))
+	requireAccountLocked(t, postToken(t, s, refresh))
+	_, err := s.storage.GetRefresh(t.Context(), refreshID(t, resp.RefreshToken))
+	require.NoError(t, err)
+}
+
+func TestTokenExchangeCarriesGeneration(t *testing.T) {
+	_, s := newLockTestServer(t)
+	exchange := url.Values{
+		"grant_type":           {oauth2.GrantTypeTokenExchange},
+		"connector_id":         {"mock"},
+		"scope":                {"openid"},
+		"subject_token_type":   {oauth2.TokenTypeID},
+		"subject_token":        {"foobar"},
+		"requested_token_type": {oauth2.TokenTypeID},
+	}
+	requireGeneration(t, tokenResponse(t, postToken(t, s, exchange)).AccessToken, 0)
+
+	setGeneration(t, s, mockUserID, "mock", 5)
+	requireGeneration(t, tokenResponse(t, postToken(t, s, exchange)).AccessToken, 5)
+}
+
+// TestAuthResponseOfRevokedPair checks the last step of a browser login: no code
+// and no token of a generation revoked after the login recorded it.
+func TestAuthResponseOfRevokedPair(t *testing.T) {
+	cases := append([]struct {
+		name    string
+		current uint64
+	}{{name: "current generation", current: 2}}, revokedGenerations...)
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s, logs := newSignInLogServer(t, nil)
+			authReq := storage.AuthRequest{
+				ID:            storage.NewID(),
+				ClientID:      "test",
+				ConnectorID:   "test",
+				RedirectURI:   "foo://bar.com/",
+				ResponseTypes: []string{oauth2.ResponseTypeCode},
+				Scopes:        []string{"openid"},
+				Claims:        storage.Claims{UserID: mockUserID},
+				LoggedIn:      true,
+				MFAValidated:  true,
+				Expiry:        time.Now().Add(time.Minute),
+				HMACKey:       storage.NewHMACKey(crypto.SHA256),
+				Generation:    2,
+			}
+			require.NoError(t, s.storage.CreateAuthRequest(ctx, authReq))
+			setGeneration(t, s, mockUserID, "test", tc.current)
+
+			rr := httptest.NewRecorder()
+			s.ServeHTTP(rr, httptest.NewRequest(http.MethodGet, internal.StepURL("/auth", authReq, internal.StepContinue, nil), nil))
+
+			_, err := s.storage.GetAuthRequest(ctx, authReq.ID)
+			require.ErrorIs(t, err, storage.ErrNotFound, "the request is over either way")
+			if tc.current == authReq.Generation {
+				require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+				require.Contains(t, rr.Header().Get("Location"), "code=")
+				return
+			}
+			require.Equal(t, http.StatusBadRequest, rr.Code)
+			require.Contains(t, rr.Body.String(), "The login is no longer valid. Please sign in again.")
+			require.Empty(t, rr.Header().Get("Location"))
+			requireRefusal(t, logs.last(t, "token request denied: credentials revoked"), "revoked", "test")
+		})
+	}
+}
+
+func introspect(t *testing.T, s *Server, token string) bool {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodPost, "/token/introspect", strings.NewReader(url.Values{"token": {token}}.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	var resp struct {
+		Active bool `json:"active"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &resp))
+	return resp.Active
+}
+
+func userInfo(t *testing.T, s *Server, accessToken string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodGet, "/userinfo", nil)
+	req.Header.Set("Authorization", "Bearer "+accessToken)
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	return rr
+}
+
+func TestIntrospectionAndUserInfoOfRevokedPair(t *testing.T) {
+	for _, tc := range revokedGenerations {
+		t.Run(tc.name, func(t *testing.T) {
+			_, s := newLockTestServer(t)
+			setGeneration(t, s, mockUserID, "test", 2)
+			resp := tokenResponse(t, passwordGrant(t, s))
+
+			require.True(t, introspect(t, s, resp.AccessToken))
+			require.True(t, introspect(t, s, resp.RefreshToken))
+			require.Equal(t, http.StatusOK, userInfo(t, s, resp.AccessToken).Code)
+
+			setGeneration(t, s, mockUserID, "test", tc.current)
+			require.False(t, introspect(t, s, resp.AccessToken), "access token")
+			require.False(t, introspect(t, s, resp.RefreshToken), "refresh token")
+
+			rr := userInfo(t, s, resp.AccessToken)
+			requireErrorResponse(t, rr, http.StatusUnauthorized, oauth2.InvalidToken, "")
+			require.Equal(t, `Bearer error="invalid_token"`, rr.Header().Get("WWW-Authenticate"))
+		})
+	}
+}
+
+// Tokens of a client itself have no pair: nothing revokes them this way.
+func TestIntrospectionOfClientCredentials(t *testing.T) {
+	_, s := newLockTestServer(t)
+	resp := tokenResponse(t, postToken(t, s, url.Values{
+		"grant_type": {oauth2.GrantTypeClientCredentials},
+		"scope":      {"openid"},
+	}))
+	requireGeneration(t, resp.AccessToken, 0)
+	require.True(t, introspect(t, s, resp.AccessToken))
+}
+
+// --- RFC 7009 ---
+
+// revocationLister is the view of the memory storage on the revocations it
+// keeps.
+type revocationLister interface {
+	ListRevocations(ctx context.Context) ([]storage.Revocation, error)
+}
+
+func listRevocations(t *testing.T, s storage.Storage) []storage.Revocation {
+	t.Helper()
+	lister, ok := s.(revocationLister)
+	require.True(t, ok, "%T keeps no revocations", s)
+	got, err := lister.ListRevocations(t.Context())
+	require.NoError(t, err)
+	return got
+}
+
+// serverRevocations returns the revocations the memory storage of a test server
+// keeps.
+func serverRevocations(t *testing.T, s *Server) []storage.Revocation {
+	t.Helper()
+	cacher, ok := s.storage.(*keyCacher)
+	require.True(t, ok)
+	return listRevocations(t, cacher.Storage)
+}
+
+func postRevoke(t *testing.T, s *Server, form url.Values, clientID, secret string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodPost, "/token/revoke", strings.NewReader(form.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth(clientID, secret)
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	return rr
+}
+
+func requireRevoked(t *testing.T, rr *httptest.ResponseRecorder) {
+	t.Helper()
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	require.Empty(t, rr.Body.String())
+	require.Equal(t, "no-store", rr.Header().Get("Cache-Control"))
+}
+
+func TestTokenRevocation(t *testing.T) {
+	t.Run("refresh token", func(t *testing.T) {
+		ctx := t.Context()
+		s, logs := newSignInLogServer(t, nil)
+		resp := tokenResponse(t, passwordGrant(t, s))
+		id := refreshID(t, resp.RefreshToken)
+		refresh := url.Values{"grant_type": {oauth2.GrantTypeRefreshToken}, "refresh_token": {resp.RefreshToken}}
+
+		requireRevoked(t, postRevoke(t, s, url.Values{"token": {resp.RefreshToken}, "token_type_hint": {"refresh_token"}}, "test", "barfoo"))
+
+		_, err := s.storage.GetRefresh(ctx, id)
+		require.ErrorIs(t, err, storage.ErrNotFound)
+		offline, err := s.storage.GetOfflineSessions(ctx, mockUserID, "test")
+		require.NoError(t, err)
+		require.NotContains(t, offline.Refresh, "test")
+		requireErrorResponse(t, postToken(t, s, refresh), http.StatusBadRequest, oauth2.InvalidGrant, "")
+
+		revocations := serverRevocations(t, s)
+		require.Len(t, revocations, 1)
+		got := revocations[0]
+		require.False(t, got.CreatedAt.IsZero())
+		got.CreatedAt = time.Time{}
+		sub, err := tokens.GenSubject(mockUserID, "test")
+		require.NoError(t, err)
+		require.Equal(t, storage.Revocation{
+			Type:        storage.RevocationGrant,
+			ConnectorID: "test",
+			UserID:      mockUserID,
+			Subject:     sub,
+			GrantID:     id,
+			ClientID:    "test",
+			Clients:     []string{"test"},
+			Reason:      "TokenRevoked",
+			Source:      "dex",
+		}, got)
+
+		line := logs.last(t, "token revoked")
+		assert.Equal(t, "INFO", line["level"])
+		assert.Equal(t, "test", line["connector_id"])
+		assert.Equal(t, "test", line["client_id"])
+		assert.Equal(t, mockUserID, line["user_id"])
+		assert.NotContains(t, line, "reason")
+
+		// Revoked already: no error, nothing recorded again (RFC 7009 §2.2).
+		requireRevoked(t, postRevoke(t, s, url.Values{"token": {resp.RefreshToken}}, "test", "barfoo"))
+		require.Len(t, serverRevocations(t, s), 1)
+	})
+
+	t.Run("refresh token of another client", func(t *testing.T) {
+		ctx := t.Context()
+		s, logs := newSignInLogServer(t, nil)
+		require.NoError(t, s.storage.CreateClient(ctx, storage.Client{ID: "other", Secret: "other-secret"}))
+		resp := tokenResponse(t, passwordGrant(t, s))
+
+		requireErrorResponse(t, postRevoke(t, s, url.Values{"token": {resp.RefreshToken}}, "other", "other-secret"),
+			http.StatusBadRequest, oauth2.InvalidGrant, "The token was issued to another client.")
