+	})
+
+	t.Run("unknown token", func(t *testing.T) {
+		_, s := newLockTestServer(t)
+		forged, err := internal.Marshal(&internal.RefreshToken{RefreshId: vectorRefreshID, Token: vectorRefreshBody})
+		require.NoError(t, err)
+		requireRevoked(t, postRevoke(t, s, url.Values{"token": {forged}}, "test", "barfoo"))
+		requireRevoked(t, postRevoke(t, s, url.Values{"token": {"not-a-token"}}, "test", "barfoo"))
+		require.Empty(t, serverRevocations(t, s))
+	})
+
+	t.Run("wrong secret of the refresh token", func(t *testing.T) {
+		ctx := t.Context()
+		_, s := newLockTestServer(t)
+		resp := tokenResponse(t, passwordGrant(t, s))
+		id := refreshID(t, resp.RefreshToken)
+		guessed, err := internal.Marshal(&internal.RefreshToken{RefreshId: id, Token: "guessed"})
+		require.NoError(t, err)
+
+		requireRevoked(t, postRevoke(t, s, url.Values{"token": {guessed}}, "test", "barfoo"))
+		_, err = s.storage.GetRefresh(ctx, id)
+		require.NoError(t, err, "a token with a wrong secret revokes nothing")
+		require.Empty(t, serverRevocations(t, s))
