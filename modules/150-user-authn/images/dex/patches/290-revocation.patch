+// --- logout ---
+
+// failingRevocations cannot write revocations.
+type failingRevocations struct {
+	storage.Storage
+}
+
+func (failingRevocations) CreateRevocation(context.Context, storage.Revocation) error {
+	return errors.New("storage unavailable")
+}
+
+// revocationOrder records when revocations are written and sessions deleted.
+type revocationOrder struct {
+	storage.Storage
+
+	mu    sync.Mutex
+	calls []string
+}
+
+func (s *revocationOrder) record(call string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.calls = append(s.calls, call)
+}
+
+func (s *revocationOrder) CreateRevocation(ctx context.Context, r storage.Revocation) error {
+	s.record("CreateRevocation")
+	creator, ok := storage.AsRevocationCreator(s.Storage)
+	if !ok {
+		return errors.New("no revocations")
+	}
+	return creator.CreateRevocation(ctx, r)
+}
+
+func (s *revocationOrder) DeleteAuthSession(ctx context.Context, id string) error {
+	s.record("DeleteAuthSession")
+	return s.Storage.DeleteAuthSession(ctx, id)
+}
+
+// newLogoutTestSession stores a session of two clients, one of which keeps its
+// refresh token only while the session lives, and returns the logout request
+// and that client's refresh token ID.
+func newLogoutTestSession(t *testing.T, s *Server, logoutState *storage.LogoutState) (sessionID, boundRefreshID string) {
+	t.Helper()
+	ctx := t.Context()
+	const userID, connectorID = "test-user", "mock"
+	require.NoError(t, s.storage.CreateClient(ctx, storage.Client{ID: "b-bound", RefreshTokenLifetime: storage.RefreshTokenLifetimeSession}))
+	require.NoError(t, s.storage.CreateClient(ctx, storage.Client{ID: "a-standalone"}))
+	sessionID = storage.NewID()
+	require.NoError(t, s.storage.CreateAuthSession(ctx, storage.AuthSession{
+		ID: sessionID, Secret: testSessionSecret(sessionID),
+		UserID: userID, ConnectorID: connectorID,
+		ClientStates: map[string]*storage.ClientAuthState{
+			"b-bound":      {AuthenticatedAt: time.Now()},
+			"a-standalone": {AuthenticatedAt: time.Now()},
+		},
+		CreatedAt: time.Now(), LastActivity: time.Now(),
+		AbsoluteExpiry: time.Now().Add(time.Hour), IdleExpiry: time.Now().Add(time.Hour),
+		LogoutState: logoutState,
+	}))
+	boundRefreshID = newTestRefreshToken(t, s, userID, connectorID, "b-bound")
+	require.NoError(t, s.storage.CreateOfflineSessions(ctx, storage.OfflineSessions{
+		UserID: userID, ConnID: connectorID,
+		Refresh: map[string]*storage.RefreshTokenRef{"b-bound": {ID: boundRefreshID, ClientID: "b-bound"}},
+	}))
+	return sessionID, boundRefreshID
+}
