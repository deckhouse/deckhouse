+}
+
+func withoutCreatedAt(t *testing.T, revocations []storage.Revocation) []storage.Revocation {
+	t.Helper()
+	for i := range revocations {
+		require.False(t, revocations[i].CreatedAt.IsZero())
+		revocations[i].CreatedAt = time.Time{}
+	}
+	return revocations
+}
+
+func TestLogoutRecordsSessionRevocation(t *testing.T) {
+	for _, path := range []string{"/logout", "/logout/callback"} {
+		t.Run(path, func(t *testing.T) {
+			ctx := t.Context()
+			var order *revocationOrder
+			httpServer, s := newTestServerWithSessions(t, func(c *Config) {
+				order = &revocationOrder{Storage: c.Storage}
+				c.Storage = order
+			})
+			defer httpServer.Close()
+
+			var logoutState *storage.LogoutState
+			method := http.MethodPost
+			if path == "/logout/callback" {
+				// The upstream provider has logged out and sends the browser back.
+				logoutState = &storage.LogoutState{}
+				method = http.MethodGet
+			}
+			sessionID, boundRefreshID := newLogoutTestSession(t, s, logoutState)
+
+			req := httptest.NewRequest(method, path, nil)
+			req.AddCookie(testSessionCookie(sessionID))
+			rr := httptest.NewRecorder()
+			s.ServeHTTP(rr, req)
+			require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+
+			require.Equal(t, []storage.Revocation{sessionRevocation(t, sessionID)}, withoutCreatedAt(t, listRevocations(t, order.Storage)))
+			require.Equal(t, []string{"CreateRevocation", "DeleteAuthSession"}, order.calls, "recorded before the session goes")
+			_, err := s.storage.GetAuthSession(ctx, sessionID)
+			require.ErrorIs(t, err, storage.ErrNotFound)
+			_, err = s.storage.GetRefresh(ctx, boundRefreshID)
+			require.ErrorIs(t, err, storage.ErrNotFound)
+		})
+	}
+}
+
+func TestLogoutKeepsSessionWhenRevocationFails(t *testing.T) {
+	for _, path := range []string{"/logout", "/logout/callback"} {
+		t.Run(path, func(t *testing.T) {
+			ctx := t.Context()
+			httpServer, s := newTestServerWithSessions(t, func(c *Config) {
+				c.Storage = failingRevocations{Storage: c.Storage}
+			})
+			defer httpServer.Close()
+
+			var logoutState *storage.LogoutState
+			method := http.MethodPost
+			if path == "/logout/callback" {
+				logoutState = &storage.LogoutState{}
+				method = http.MethodGet
+			}
+			sessionID, boundRefreshID := newLogoutTestSession(t, s, logoutState)
+
+			req := httptest.NewRequest(method, path, nil)
+			req.AddCookie(testSessionCookie(sessionID))
+			rr := httptest.NewRecorder()
+			s.ServeHTTP(rr, req)
+			require.Equal(t, http.StatusServiceUnavailable, rr.Code, rr.Body.String())
+			require.Contains(t, rr.Body.String(), "Logout is temporarily unavailable. Please try again.")
+			require.False(t, slices.ContainsFunc(rr.Result().Cookies(), func(c *http.Cookie) bool { return c.MaxAge < 0 }),
+				"the cookie is kept")
+
+			_, err := s.storage.GetAuthSession(ctx, sessionID)
+			require.NoError(t, err, "the session is kept for a retry")
+			_, err = s.storage.GetRefresh(ctx, boundRefreshID)
+			require.NoError(t, err, "nothing of the session is revoked")
+		})
+	}
+}
