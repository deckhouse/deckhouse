diff --git a/server/revocation/revocation.go b/server/revocation/revocation.go
new file mode 100644
index 00000000..8eeff33f
--- /dev/null
+++ b/server/revocation/revocation.go
@@ -0,0 +1,157 @@
+// Package revocation decides whether the credentials dex issued to a (user,
+// connector) pair are still valid, and records the revocations dex decides
+// itself for the Deckhouse components that accept the tokens of dex without
+// asking it on every request.
+//
+// Every credential of a pair carries the generation the pair had at its login
+// (storage.UserIdentity.Generation): the authorization code, the refresh token,
+// the browser session, and the "d8_gen" claim of the ID and access tokens. The
+// user-authn controller raises the generation to revoke all of them at once. A
+// credential is valid only with the current generation: a lower one was
+// revoked, a higher one was issued to a record of the pair that was deleted and
+// created again. Nothing compares times.
+package revocation
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"maps"
+	"slices"
+	"time"
+
+	"github.com/coreos/go-oidc/v3/oidc"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/storage"
+)
+
+// ErrRevoked refuses a credential whose generation is not the current one of
+// its pair.
+var ErrRevoked = errors.New("credentials revoked")
+
+// Current returns the generation of the pair. A pair without a UserIdentity,
+// one that never revoked anything, is at generation 0, as is everything issued
+// before generations existed.
+func Current(ctx context.Context, s storage.Storage, userID, connectorID string) (uint64, error) {
+	ui, err := s.GetUserIdentity(ctx, userID, connectorID)
+	switch {
+	case errors.Is(err, storage.ErrNotFound):
+		return 0, nil
+	case err != nil:
+		return 0, fmt.Errorf("get user identity: %w", err)
+	}
+	return ui.Generation, nil
+}
+
+// Check returns ErrRevoked when generation is not the current generation of the
+// pair.
+func Check(ctx context.Context, s storage.Storage, userID, connectorID string, generation uint64) error {
+	current, err := Current(ctx, s, userID, connectorID)
+	if err != nil {
+		return err
+	}
+	if generation != current {
+		return ErrRevoked
+	}
+	return nil
+}
+
+// CheckToken checks an ID or access token of dex, verified by the caller: the
+// pair is in its "sub" claim and the generation in "d8_gen", absent for 0. A
+// token without a connector belongs to a client, not to a pair
+// (client_credentials), and is never revoked this way.
+func CheckToken(ctx context.Context, s storage.Storage, token *oidc.IDToken) error {
+	sub := new(internal.IDTokenSubject)
+	if err := internal.Unmarshal(token.Subject, sub); err != nil {
+		return fmt.Errorf("unmarshal subject: %w", err)
+	}
+	if sub.ConnId == "" {
+		return nil
+	}
+
+	var claims struct {
+		Generation uint64 `json:"d8_gen"`
+	}
+	if err := token.Claims(&claims); err != nil {
+		return fmt.Errorf("decode claims: %w", err)
+	}
+	return Check(ctx, s, sub.UserId, sub.ConnId, claims.Generation)
+}
+
+// Reasons and the source of the revocations dex records.
+const (
+	// ReasonSessionLogout: the user signed out of a browser session.
+	ReasonSessionLogout = "SessionLogout"
+	// ReasonTokenRevoked: the client revoked a refresh token (RFC 7009).
+	ReasonTokenRevoked = "TokenRevoked"
+
+	sourceDex = "dex"
+)
+
+// Recorder records the revocations dex decides: the end of a browser session
+// and of a refresh token. A storage that keeps no revocations (SQL, ent, etcd)
+// records nothing.
+type Recorder struct {
+	creator storage.RevocationCreator
+	now     func() time.Time
+}
+
+// NewRecorder returns the recorder of s.
+func NewRecorder(s storage.Storage, now func() time.Time) *Recorder {
+	creator, _ := storage.AsRevocationCreator(s)
+	return &Recorder{creator: creator, now: now}
+}
+
+// Enabled reports whether the storage keeps revocations.
+func (r *Recorder) Enabled() bool {
+	return r != nil && r.creator != nil
+}
+
+// SessionEnded records that the browser session ended: its "sid" and the
+// clients it reached.
+func (r *Recorder) SessionEnded(ctx context.Context, session storage.AuthSession) error {
+	return r.record(ctx, storage.Revocation{
+		Type:        storage.RevocationSession,
+		ConnectorID: session.ConnectorID,
+		UserID:      session.UserID,
+		SessionID:   session.ID,
+		Clients:     slices.Sorted(maps.Keys(session.ClientStates)),
+		Reason:      ReasonSessionLogout,
+	})
+}
+
+// GrantRevoked records that its client revoked the refresh token.
+func (r *Recorder) GrantRevoked(ctx context.Context, refresh storage.RefreshToken) error {
+	return r.record(ctx, storage.Revocation{
+		Type:        storage.RevocationGrant,
+		ConnectorID: refresh.ConnectorID,
+		UserID:      refresh.Claims.UserID,
+		GrantID:     refresh.ID,
+		ClientID:    refresh.ClientID,
+		Clients:     []string{refresh.ClientID},
+		Reason:      ReasonTokenRevoked,
+	})
+}
+
+// record creates rev. A revocation recorded before, by a repeated request, is
+// what was asked for.
+func (r *Recorder) record(ctx context.Context, rev storage.Revocation) error {
+	if !r.Enabled() {
+		return nil
+	}
+
+	subject, err := tokens.GenSubject(rev.UserID, rev.ConnectorID)
+	if err != nil {
+		return fmt.Errorf("marshal subject: %w", err)
+	}
+	rev.Subject = subject
+	rev.Source = sourceDex
+	rev.CreatedAt = r.now()
+
+	if err := r.creator.CreateRevocation(ctx, rev); err != nil && !errors.Is(err, storage.ErrAlreadyExists) {
+		return fmt.Errorf("create revocation: %w", err)
+	}
+	return nil
+}
