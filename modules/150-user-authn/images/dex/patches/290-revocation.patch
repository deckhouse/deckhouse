diff --git a/server/authflow/sessionlogin_revocation_test.go b/server/authflow/sessionlogin_revocation_test.go
new file mode 100644
index 00000000..c13e33dd
--- /dev/null
+++ b/server/authflow/sessionlogin_revocation_test.go
@@ -0,0 +1,73 @@
+package authflow
+
+import (
+	"bytes"
+	"encoding/json"
+	"log/slog"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/storage"
+)
+
+// TestSessionLoginOfRevokedPair checks that a browser session continues only at
+// the generation its pair has: a session of a pair revoked since its last login
+// there ends, and the user signs in again.
+func TestSessionLoginOfRevokedPair(t *testing.T) {
+	tests := []struct {
+		name              string
+		sessionGeneration uint64
+		wantLogin         bool
+	}{
+		{name: "current generation", sessionGeneration: 2, wantLogin: true},
+		{name: "revoked since", sessionGeneration: 1},
+		{name: "record of the pair created again", sessionGeneration: 3},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := t.Context()
+			s := newTestSessionServer(t)
+			s.SkipApproval = true
+			var logs bytes.Buffer
+			s.Logger = slog.New(slog.NewJSONHandler(&logs, nil))
+			authReq := setupSessionLoginFixture(t, s)
+			require.NoError(t, s.Storage.UpdateUserIdentity(ctx, "user-1", "mock", func(u storage.UserIdentity) (storage.UserIdentity, error) {
+				u.Generation = 2
+				return u, nil
+			}))
+			require.NoError(t, s.Storage.UpdateAuthSession(ctx, "test-nonce", func(old storage.AuthSession) (storage.AuthSession, error) {
+				old.Generation = tt.sessionGeneration
+				return old, nil
+			}))
+
+			w := httptest.NewRecorder()
+			ok := s.trySessionLogin(ctx, sessionCookieRequest("test-nonce"), w, &authReq)
+			require.Equal(t, tt.wantLogin, ok)
+
+			_, err := s.Storage.GetAuthSession(ctx, "test-nonce")
+			if tt.wantLogin {
+				require.NoError(t, err)
+				stored, err := s.Storage.GetAuthRequest(ctx, authReq.ID)
+				require.NoError(t, err)
+				require.Equal(t, uint64(2), stored.Generation, "the login carries the generation on")
+				return
+			}
+
+			require.ErrorIs(t, err, storage.ErrNotFound)
+			cookies := w.Result().Cookies()
+			require.Len(t, cookies, 1)
+			require.Equal(t, -1, cookies[0].MaxAge, "the cookie is cleared")
+
+			var line map[string]any
+			require.NoError(t, json.Unmarshal(bytes.TrimSpace(logs.Bytes()), &line), logs.String())
+			require.Equal(t, "session login refused: credentials revoked", line["msg"])
+			require.Equal(t, "WARN", line["level"])
+			require.Equal(t, "revoked", line["reason"])
+			require.Equal(t, "mock", line["connector_id"])
+			require.Equal(t, "client-1", line["client_id"])
+			require.Equal(t, "user-1", line["user_id"])
+		})
+	}
+}
