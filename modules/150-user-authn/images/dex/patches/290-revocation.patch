+
+	t.Run("access token", func(t *testing.T) {
+		_, s := newLockTestServer(t)
+		resp := tokenResponse(t, passwordGrant(t, s))
+
+		for _, form := range []url.Values{
+			{"token": {resp.AccessToken}},
+			{"token": {resp.IDToken}, "token_type_hint": {"refresh_token"}},
+		} {
+			requireErrorResponse(t, postRevoke(t, s, form, "test", "barfoo"), http.StatusBadRequest, oauth2.UnsupportedTokenType, "")
+		}
+		_, err := s.storage.GetRefresh(t.Context(), refreshID(t, resp.RefreshToken))
+		require.NoError(t, err)
+	})
+
+	// RFC 7009 §2.1: a token the hint does not fit is looked up as any type.
+	t.Run("refresh token with an access token hint", func(t *testing.T) {
+		_, s := newLockTestServer(t)
+		resp := tokenResponse(t, passwordGrant(t, s))
+
+		requireRevoked(t, postRevoke(t, s, url.Values{"token": {resp.RefreshToken}, "token_type_hint": {"access_token"}}, "test", "barfoo"))
+		_, err := s.storage.GetRefresh(t.Context(), refreshID(t, resp.RefreshToken))
+		require.ErrorIs(t, err, storage.ErrNotFound)
+	})
+
+	t.Run("client not authenticated", func(t *testing.T) {
+		_, s := newLockTestServer(t)
+		resp := tokenResponse(t, passwordGrant(t, s))
+
+		requireErrorResponse(t, postRevoke(t, s, url.Values{"token": {resp.RefreshToken}}, "test", "wrong"),
+			http.StatusUnauthorized, oauth2.InvalidClient, "")
+		requireErrorResponse(t, postRevoke(t, s, url.Values{"token": {resp.RefreshToken}}, "no-such-client", "barfoo"),
+			http.StatusUnauthorized, oauth2.InvalidClient, "")
+		_, err := s.storage.GetRefresh(t.Context(), refreshID(t, resp.RefreshToken))
+		require.NoError(t, err)
+	})
+
+	t.Run("malformed request", func(t *testing.T) {
+		_, s := newLockTestServer(t)
+		requireErrorResponse(t, postRevoke(t, s, url.Values{}, "test", "barfoo"), http.StatusBadRequest, oauth2.InvalidRequest, "")
+
+		rr := httptest.NewRecorder()
+		s.ServeHTTP(rr, httptest.NewRequest(http.MethodGet, "/token/revoke?token=x", nil))
+		requireErrorResponse(t, rr, http.StatusBadRequest, oauth2.InvalidRequest, "")
+	})
+
+	t.Run("revocation not recorded", func(t *testing.T) {
+		ctx := t.Context()
+		httpServer, s := newTestServer(t, func(c *Config) {
+			c.Storage = failingRevocations{Storage: c.Storage}
+			c.PasswordConnector = "test"
+		})
+		t.Cleanup(httpServer.Close)
+		mockConnectorDataTestStorage(t, s.storage)
+		resp := tokenResponse(t, passwordGrant(t, s))
+
+		requireErrorResponse(t, postRevoke(t, s, url.Values{"token": {resp.RefreshToken}}, "test", "barfoo"),
+			http.StatusServiceUnavailable, oauth2.TemporarilyUnavailable, "")
+		_, err := s.storage.GetRefresh(ctx, refreshID(t, resp.RefreshToken))
+		require.NoError(t, err, "nothing is deleted without the record")
+		tokenResponse(t, postToken(t, s, url.Values{"grant_type": {oauth2.GrantTypeRefreshToken}, "refresh_token": {resp.RefreshToken}}))
+	})
+
+	t.Run("rotated token within the reuse interval", func(t *testing.T) {
+		ctx := t.Context()
+		httpServer, s := newTestServer(t, func(c *Config) {
+			c.PasswordConnector = "test"
+			c.RefreshTokenPolicy = tokens.NewRefreshStrategy(true, 0, 0, time.Minute, time.Now)
+		})
+		t.Cleanup(httpServer.Close)
+		mockConnectorDataTestStorage(t, s.storage)
+		first := tokenResponse(t, passwordGrant(t, s))
+		// A token used within the reuse interval is served again, not rotated:
+		// make it old enough to rotate.
+		require.NoError(t, s.storage.UpdateRefreshToken(ctx, refreshID(t, first.RefreshToken), func(r storage.RefreshToken) (storage.RefreshToken, error) {
+			r.LastUsed = time.Now().Add(-2 * time.Minute)
+			return r, nil
+		}))
+		second := tokenResponse(t, postToken(t, s, url.Values{"grant_type": {oauth2.GrantTypeRefreshToken}, "refresh_token": {first.RefreshToken}}))
+		require.NotEqual(t, first.RefreshToken, second.RefreshToken)
+
+		// The previous token still works within the reuse interval, so it
+		// revokes the grant.
+		requireRevoked(t, postRevoke(t, s, url.Values{"token": {first.RefreshToken}}, "test", "barfoo"))
