-	return static, theme, robots, templates, err
+// cacheControl lets a browser keep an asset for long only when its URL names
+// the assets this dex serves: the build identifier the pages link it with. In a
+// rollout, a page of one release may load its stylesheet from a pod of the
+// other, and a browser keeps what it got under the URL it asked for. An answer
+// under another build identifier, or none, is not stored, so a pod never leaves
+// its assets in a browser under a URL of other ones.
+func cacheControl(h http.Handler, buildID string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", cacheNever)
+		if r.URL.Query().Get(buildIDQuery) == buildID {
+			w = &cacheForeverWriter{ResponseWriter: w}
+		}
+		h.ServeHTTP(w, r)
+	})
+}
+
+// cacheForeverWriter lets the asset it serves be kept for long when it is
+// served: an error, such as a file missing for a moment, is not kept.
+type cacheForeverWriter struct {
+	http.ResponseWriter
+	isWritten bool
+}
+
+func (w *cacheForeverWriter) WriteHeader(code int) {
+	if !w.isWritten {
+		w.isWritten = true
+		if code == http.StatusOK || code == http.StatusPartialContent || code == http.StatusNotModified {
+			w.Header().Set("Cache-Control", cacheForever)
+		}
+	}
+	w.ResponseWriter.WriteHeader(code)
+}
+
+func (w *cacheForeverWriter) Write(b []byte) (int, error) {
+	if !w.isWritten {
+		w.WriteHeader(http.StatusOK)
+	}
+	return w.ResponseWriter.Write(b)
+}
+
+// Unwrap lets http.ResponseController reach the underlying writer.
+func (w *cacheForeverWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriter
+}
+
+// assetsVersion identifies the content of the web assets: a hash of every file
+// that can be read. A version of the dex binary would not do: builds from a
+// source tree without VCS data all report the same one, and the assets may be
+// replaced without rebuilding dex.
+func assetsVersion(fsys fs.FS) string {
+	h := sha256.New()
+	// The walk never fails: whatever cannot be read is skipped, as it cannot be
+	// served either.
+	_ = fs.WalkDir(fsys, ".", func(p string, d fs.DirEntry, err error) error {
+		if err != nil || d.IsDir() {
+			return nil
+		}
+		// Stat follows symlinks, as files mounted from a ConfigMap are.
+		if info, err := fs.Stat(fsys, p); err != nil || !info.Mode().IsRegular() {
+			return nil
+		}
+		content, err := fs.ReadFile(fsys, p)
+		if err != nil {
+			return nil
+		}
+		fmt.Fprintf(h, "%s\x00%d\x00", p, len(content))
+		h.Write(content)
+		return nil
+	})
+	return hex.EncodeToString(h.Sum(nil)[:4])
 }
 
