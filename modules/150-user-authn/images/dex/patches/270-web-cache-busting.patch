index 00000000..3c3ecd31
--- /dev/null
+++ b/server/templates/templates_buildid_test.go
@@ -0,0 +1,130 @@
+package templates
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"testing/fstest"
+
+	"github.com/stretchr/testify/require"
+
+	dexweb "github.com/dexidp/dex/web"
+)
+
+func TestAssetsVersion(t *testing.T) {
+	assets := fstest.MapFS{
+		"static/main.css":        {Data: []byte("body {}")},
+		"themes/light/style.css": {Data: []byte("a {}")},
+		"templates/header.html":  {Data: []byte("<html>")},
+	}
+	version := assetsVersion(assets)
+	require.Len(t, version, 8)
+	require.Equal(t, version, assetsVersion(assets), "the same assets give the same version")
+
+	assets["static/main.css"] = &fstest.MapFile{Data: []byte("body { margin: 0 }")}
+	require.NotEqual(t, version, assetsVersion(assets), "a changed stylesheet gives a new version")
+
+	renamed := fstest.MapFS{
+		"static/other.css":       assets["static/main.css"],
+		"themes/light/style.css": assets["themes/light/style.css"],
+		"templates/header.html":  assets["templates/header.html"],
+	}
+	require.NotEqual(t, assetsVersion(assets), assetsVersion(renamed), "file names count")
+}
+
+// TestPagesCarryBuildIdentifier renders every page with the header that links
+// the stylesheets under the build identifier: a page whose data lacks
+// BuildIdentifier fails to render.
+func TestPagesCarryBuildIdentifier(t *testing.T) {
+	//nolint:dogsled // only the templates are needed here
+	_, _, _, tmpls, err := LoadWebConfig(Config{WebFS: dexweb.FS(), IssuerURL: "https://dex.example.com"})
+	require.NoError(t, err)
+	require.Equal(t, assetsVersion(dexweb.FS()), tmpls.buildID)
+	want := "static/main.css?cache=" + tmpls.buildID
+
+	pages := map[string]func(w http.ResponseWriter, r *http.Request) error{
+		"login": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.Login(r, w, []ConnectorInfo{{ID: "local", Name: "Email"}})
+		},
+		"password": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.Password(r, w, "/auth/local/login", "", "Email", false, "", nil)
+		},
+		"password change": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.PasswordChange(r, w, PasswordChange{Username: "jane@example.com", Reason: "forced"})
+		},
+		"approval": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.Approval(r, w, "req", "jane", "app", []string{"openid"})
+		},
+		"oob": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.OOB(r, w, "code")
+		},
+		"error": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.Err(r, w, http.StatusBadRequest, "bad request")
+		},
+		"device": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.Device(r, w, "/device/auth/verify_code", "", false)
+		},
+		"device success": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.DeviceSuccess(r, w, "app")
+		},
+		"totp verify": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.TOTPVerify(r, w, "/mfa/totp", "dex", "local", "", false)
+		},
+		"webauthn verify": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.WebAuthnVerify(r, w, "login", "webauthn")
+		},
+		"home": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.Home(r, w, HomeData{})
+		},
+		"logout": func(w http.ResponseWriter, r *http.Request) error {
+			return tmpls.Logout(r, w, "", true, false)
+		},
+	}
+	for name, render := range pages {
+		t.Run(name, func(t *testing.T) {
+			w := httptest.NewRecorder()
+			require.NoError(t, render(w, httptest.NewRequest(http.MethodGet, "/auth", nil)))
+			require.Contains(t, w.Body.String(), want)
+		})
+	}
+}
+
+// TestAssetsCacheControl checks that a browser keeps an asset for long only
+// under a URL with the build identifier of this dex: in a rollout, a page of the
+// other release links its own.
+func TestAssetsCacheControl(t *testing.T) {
+	static, theme, _, tmpls, err := LoadWebConfig(Config{WebFS: dexweb.FS(), IssuerURL: "https://dex.example.com"})
+	require.NoError(t, err)
+	current := "?cache=" + tmpls.buildID
+
+	tests := []struct {
+		name    string
+		handler http.Handler
+		target  string
+		status  int
+		isKept  bool
+	}{
+		{name: "stylesheet of this build", handler: static, target: "/main.css" + current, status: http.StatusOK, isKept: true},
+		{name: "theme of this build", handler: theme, target: "/styles.css" + current, status: http.StatusOK, isKept: true},
+		{name: "stylesheet of another build", handler: static, target: "/main.css?cache=0badc0de", status: http.StatusOK},
+		{name: "asset without a build", handler: theme, target: "/logo.png", status: http.StatusOK},
+		{name: "missing asset of this build", handler: static, target: "/missing.css" + current, status: http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := httptest.NewRecorder()
+			tc.handler.ServeHTTP(w, httptest.NewRequest(http.MethodGet, tc.target, nil))
+			require.Equal(t, tc.status, w.Code)
+			cacheControl := w.Header().Get("Cache-Control")
+			switch {
+			case tc.isKept:
+				require.Equal(t, cacheForever, cacheControl)
+			case tc.status == http.StatusOK:
+				require.Equal(t, cacheNever, cacheControl)
+			default:
+				// net/http drops Cache-Control from the errors it answers.
+				require.NotEqual(t, cacheForever, cacheControl)
+			}
+		})
+	}
+}
