+	rr = postPasswordLogin(s, "", localUserEmail, "wrong")
+	require.Equal(t, http.StatusTooManyRequests, rr.Code, "the second failure locks")
+	line = logs.line(t, "account locked due to too many failed attempts")
+	assert.Equal(t, "account_locked", line["reason"])
+	assert.Equal(t, localUserID, line["user_id"])
+	assert.Equal(t, "client", line["client_id"])
+	assert.EqualValues(t, 2, line["attempts"])
+
+	rr = postPasswordLogin(s, "", localUserEmail, "Curr3nt-password")
+	require.Equal(t, http.StatusTooManyRequests, rr.Code)
+	lines := 0
+	for _, l := range logs.lines(t) {
+		if l["msg"] == "login attempt for locked account" {
+			lines++
+			assert.Equal(t, "account_locked", l["reason"])
+			assert.Equal(t, "client", l["client_id"])
+			assert.Contains(t, l, "blocked_until")
+		}
+	}
+	assert.Equal(t, 2, lines, "the locking attempt and the next one")
+	logs.requireScheme(t)
+}
+
+func TestSignInLogPasswordChange(t *testing.T) {
+	var logs logRecorder
+	s := newLocalLoginHandler(t, nil, "Curr3nt-password", func(p *storage.Password) {
+		p.RequireResetHashOnNextSuccLogin = true
+	}, func(c *testFlowConfig) { c.Logger = logs.logger() })
+
+	target, cookie := loginToPasswordChange(t, s, "Curr3nt-password")
+	line := logs.line(t, "user was forced to change password due to password object requirement")
+	assert.Equal(t, "INFO", line["level"])
+	assert.Equal(t, localUserID, line["user_id"])
+	assert.NotContains(t, line, "reason", "a password change is not a refusal")
+
+	rr := serve(s, http.MethodPost, target, url.Values{"newPassword": {"N3w-password"}})
+	require.Equal(t, http.StatusUnauthorized, rr.Code)
+	line = logs.line(t, "password change refused: request not bound to the login")
+	assert.Equal(t, "WARN", line["level"])
+	assert.Equal(t, "invalid_credentials", line["reason"])
+	assert.Equal(t, "client", line["client_id"])
+
+	rr = serve(s, http.MethodPost, target, url.Values{"newPassword": {"N3w-password"}}, cookie)
+	require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+	line = logs.line(t, "password changed successfully")
+	assert.Equal(t, "INFO", line["level"])
+	assert.Equal(t, "local", line["connector_id"])
+	assert.Equal(t, localUserID, line["user_id"])
+	logs.requireScheme(t)
+}
