+package oidc
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector"
+)
+
+// TestHandleCallbackNotInAllowedGroups checks that a refused user comes back
+// as a typed error that names the user, so the server can log who was refused.
+func TestHandleCallbackNotInAllowedGroups(t *testing.T) {
+	tests := []struct {
+		name        string
+		groupsRegex string
+		wantGroups  []string
+	}{
+		{name: "groups as returned", wantGroups: []string{"developers", "qa"}},
+		{name: "groups after groupsFilter", groupsRegex: "^dev", wantGroups: []string{"developers"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			testServer, err := setupServer(map[string]interface{}{
+				"sub":                "subvalue",
+				"name":               "namevalue",
+				"preferred_username": "jdoe",
+				"email":              "jdoe@example.com",
+				"email_verified":     true,
