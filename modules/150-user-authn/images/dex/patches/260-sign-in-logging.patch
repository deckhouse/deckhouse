--- /dev/null
+++ b/server/tokens/refresh_lookup_test.go
@@ -0,0 +1,76 @@
+package tokens
+
+import (
+	"bytes"
+	"encoding/json"
+	"log/slog"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// TestLookupRefreshTokenLogLevels: a refused refresh token logs at the level of the
+// sign-in log scheme (Deckhouse): the normal end of its life is info, a token sent
+// by the wrong client or reused after rotation is a warning; neither is an error of
+// dex.
+func TestLookupRefreshTokenLogLevels(t *testing.T) {
+	now := time.Now()
+	other := "other-client"
+	tests := []struct {
+		name      string
+		strategy  *RefreshStrategy
+		createdAt time.Time
+		lastUsed  time.Time
+		clientID  *string
+		secret    string
+		wantErr   error
+		wantLevel string
+		wantMsg   string
+	}{
+		{
+			name:     "past the absolute lifetime",
+			strategy: NewRefreshStrategy(true, time.Hour, 0, 0, nil), createdAt: now.Add(-2 * time.Hour), lastUsed: now,
+			secret: "secret", wantErr: ErrRefreshTokenExpired, wantLevel: "INFO", wantMsg: "refresh token expired",
+		},
+		{
+			name:     "unused for too long",
+			strategy: NewRefreshStrategy(true, 0, time.Hour, 0, nil), createdAt: now.Add(-2 * time.Hour), lastUsed: now.Add(-2 * time.Hour),
+			secret: "secret", wantErr: ErrRefreshTokenExpired, wantLevel: "INFO", wantMsg: "refresh token expired due to inactivity",
+		},
+		{
+			name:     "sent by another client",
+			strategy: NewRefreshStrategy(true, 0, 0, 0, nil), createdAt: now, lastUsed: now, clientID: &other,
+			secret: "secret", wantErr: ErrRefreshTokenClaimedByOtherClient, wantLevel: "WARN", wantMsg: "trying to claim token for different client",
+		},
+		{
+			name:     "reused after rotation",
+			strategy: NewRefreshStrategy(true, 0, 0, 0, nil), createdAt: now, lastUsed: now,
+			secret: "rotated-away", wantErr: ErrRefreshTokenInvalid, wantLevel: "WARN", wantMsg: "refresh token claimed twice",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := t.Context()
+			store := memory.New(slog.New(slog.DiscardHandler))
+			require.NoError(t, store.CreateRefresh(ctx, storage.RefreshToken{
+				ID: "r1", Token: "secret", ClientID: "client-1", ConnectorID: "mock",
+				Claims: storage.Claims{UserID: "u1"}, CreatedAt: tt.createdAt, LastUsed: tt.lastUsed,
+			}))
+			var buf bytes.Buffer
+			logger := slog.New(slog.NewJSONHandler(&buf, nil))
+
+			_, err := LookupRefreshToken(ctx, store, tt.strategy, logger, tt.clientID, &internal.RefreshToken{RefreshId: "r1", Token: tt.secret})
+			require.ErrorIs(t, err, tt.wantErr)
+
+			var line map[string]any
+			require.NoError(t, json.Unmarshal(buf.Bytes(), &line))
+			require.Equal(t, tt.wantLevel, line["level"])
+			require.Equal(t, tt.wantMsg, line["msg"])
+		})
+	}
+}
