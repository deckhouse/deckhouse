diff --git a/connector/connector.go b/connector/connector.go
index a9f0fe3a..709c2946 100644
--- a/connector/connector.go
+++ b/connector/connector.go
@@ -14,12 +14,54 @@ import (
 type UserNotInRequiredGroupsError struct {
 	UserID string
 	Groups []string
+
+	// Username, PreferredUsername and Email name the refused user in the sign-in
+	// log (Deckhouse), with UserID.
+	Username          string
+	PreferredUsername string
+	Email             string
+	// UserGroups are the groups the provider returned for the user. Nil means
+	// the connector refused the user without reading them; FetchedGroups tells a
+	// user without groups apart.
+	UserGroups []string
 }
 
 func (e *UserNotInRequiredGroupsError) Error() string {
 	return fmt.Sprintf("user %q is not in any of the required groups %v", e.UserID, e.Groups)
 }
 
+// AsUserNotInRequiredGroups reports whether err's chain holds a
+// UserNotInRequiredGroupsError, with the fields the connector did not know when
+// it refused the user filled in from identity.
+func AsUserNotInRequiredGroups(err error, identity Identity) (*UserNotInRequiredGroupsError, bool) {
+	var e *UserNotInRequiredGroupsError
+	if !errors.As(err, &e) {
+		return nil, false
+	}
+	if e.UserID == "" {
+		e.UserID = identity.UserID
+	}
+	if e.Username == "" {
+		e.Username = identity.Username
+	}
+	if e.PreferredUsername == "" {
+		e.PreferredUsername = identity.PreferredUsername
+	}
+	if e.Email == "" {
+		e.Email = identity.Email
+	}
+	return e, true
+}
+
+// FetchedGroups returns groups as read from the provider: never nil, so that a
+// user without groups is told apart from a user whose groups were not read.
+func FetchedGroups(groups []string) []string {
+	if groups == nil {
+		return []string{}
+	}
+	return groups
+}
