+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/allowlist"
+	"github.com/dexidp/dex/storage"
+)
+
+// logged writes one line with attrs at level and returns it as JSON.
+func logged(t *testing.T, level slog.Level, attrs ...any) map[string]any {
+	t.Helper()
+	var buf bytes.Buffer
+	slog.New(slog.NewJSONHandler(&buf, nil)).Log(t.Context(), level, "line", attrs...)
+	var line map[string]any
+	require.NoError(t, json.Unmarshal(buf.Bytes(), &line), "one JSON line: %s", buf.String())
+	return line
+}
+
+func TestAttrs(t *testing.T) {
+	attrs := Attrs("ldap", "kubeconfig", User{
+		ID:       "uid=jane\n{\"level\":\"INFO\"}",
+		Username: "jane",
+		Email:    "jane@example.com",
+	})
+	require.Equal(t, []any{
+		"connector_id", "ldap",
+		"client_id", "kubeconfig",
+		"user_id", `uid=jane{"level":"INFO"}`,
+		"username", "jane",
+		"email", "jane@example.com",
+	}, attrs, "control characters are dropped, unknown attributes left out")
+
+	require.Equal(t, []any{"connector_id", "local", "client_id", ""}, Attrs("local", "", User{}),
+		"the connector and the client are always there")
+}
+
+func TestUsers(t *testing.T) {
+	claims := storage.Claims{UserID: "1", Username: "Jane", PreferredUsername: "jane", Email: "jane@example.com", Groups: []string{"g"}}
+	identity := connector.Identity{UserID: "1", Username: "Jane", PreferredUsername: "jane", Email: "jane@example.com"}
+	want := User{ID: "1", Username: "Jane", PreferredUsername: "jane", Email: "jane@example.com"}
+	require.Equal(t, want, ClaimsUser(claims))
+	require.Equal(t, want, IdentityUser(identity))
+
+	require.Equal(t, "Jane", IdentityUser(identity).Typed("typed").Username, "the identity's name wins")
+	require.Equal(t, User{ID: "1", Username: "typed"}, User{ID: "1"}.Typed("typed"))
+}
+
+func TestRefusedAndFailed(t *testing.T) {
+	line := logged(t, slog.LevelWarn, Refused(ReasonAccountLocked, "local", "app", User{Username: "jane"})...)
+	require.Equal(t, "account_locked", line["reason"])
+	require.Equal(t, "jane", line["username"])
+
+	line = logged(t, slog.LevelError, Failed(errors.New("storage down"), "local", "app", User{})...)
+	require.Equal(t, "storage down", line["err"])
+	require.NotContains(t, line, "reason", "a failure is not a refusal")
+	require.NotContains(t, line, "error")
+}
+
+func TestNotInGroups(t *testing.T) {
+	fetched := logged(t, slog.LevelWarn, NotInGroups(&connector.UserNotInRequiredGroupsError{
+		UserID: "1", Username: "Jane", PreferredUsername: "jane", Email: "jane@example.com",
+		UserGroups: connector.FetchedGroups(nil), Groups: []string{"admins"},
+	}, "oidc", "app")...)
+	require.Equal(t, "not_in_allowed_groups", fetched["reason"])
+	require.Equal(t, "oidc", fetched["connector_id"])
+	require.Equal(t, "app", fetched["client_id"])
+	require.Equal(t, "jane", fetched["preferred_username"])
+	require.Equal(t, "jane@example.com", fetched["email"])
+	require.Equal(t, []any{}, fetched["user_groups"], "read and empty is logged as [], not null")
+	require.EqualValues(t, 0, fetched["user_groups_count"])
+	require.Equal(t, []any{"admins"}, fetched["allowed_groups"])
+
+	unknown := logged(t, slog.LevelWarn, NotInGroups(&connector.UserNotInRequiredGroupsError{
+		PreferredUsername: "jane", Groups: []string{"org"},
+	}, "github", "app")...)
+	require.NotContains(t, unknown, "user_groups", "groups the connector did not read are not logged as none")
+	require.NotContains(t, unknown, "user_groups_count")
+	require.Equal(t, []any{"org"}, unknown["allowed_groups"])
+}
+
+func TestNotAllowed(t *testing.T) {
+	user := User{ID: "1", Email: "jane@example.com"}
+
+	byGroups := logged(t, slog.LevelWarn, NotAllowed(&allowlist.NotAllowedError{
+		Rule: allowlist.ClientGroups, ClientID: "app", ConnectorID: "ldap",
+		UserGroups: []string{"dev", "qa"}, AllowedGroups: []string{"admins"},
+	}, user)...)
+	require.Equal(t, "not_allowed", byGroups["reason"])
+	require.Equal(t, "client_allowed_groups", byGroups["rule"])
+	require.Equal(t, "ldap", byGroups["connector_id"])
+	require.Equal(t, "app", byGroups["client_id"])
+	require.Equal(t, "jane@example.com", byGroups["email"])
+	require.Equal(t, []any{"dev", "qa"}, byGroups["user_groups"])
+	require.EqualValues(t, 2, byGroups["user_groups_count"])
+	require.Equal(t, []any{"admins"}, byGroups["allowed_groups"])
+
+	byEmail := logged(t, slog.LevelWarn, NotAllowed(&allowlist.NotAllowedError{
+		Rule: allowlist.ClientEmails, ClientID: "app", ConnectorID: "ldap",
+	}, user)...)
+	require.Equal(t, "client_allowed_emails", byEmail["rule"])
+	require.NotContains(t, byEmail, "allowed_groups")
+	require.NotContains(t, byEmail, "user_groups", "an email list is not about groups")
+}
+
+func TestConnectorError(t *testing.T) {
+	tests := []struct {
+		name   string
+		err    error
+		level  string
+		reason any
+	}{
+		{
+			name:   "refused for the groups",
+			err:    fmt.Errorf("get groups: %w", &connector.UserNotInRequiredGroupsError{UserID: "1", Groups: []string{"admins"}}),
+			level:  "WARN",
+			reason: "not_in_allowed_groups",
+		},
+		{
+			name:  "provider failed",
+			err:   errors.New("connection refused"),
+			level: "ERROR",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			logger := slog.New(slog.NewJSONHandler(&buf, nil))
+			ConnectorError(t.Context(), logger, "failed to login user", tc.err, "crowd", "app", User{Username: "jane"}, "grant_type", "password")
+
+			var line map[string]any
+			require.NoError(t, json.Unmarshal(buf.Bytes(), &line))
+			require.Equal(t, tc.level, line["level"])
+			require.Equal(t, "failed to login user", line["msg"])
+			require.Equal(t, tc.reason, line["reason"])
+			require.Equal(t, "crowd", line["connector_id"])
+			require.Equal(t, "app", line["client_id"])
+			require.Equal(t, tc.err.Error(), line["err"])
+			require.Equal(t, "password", line["grant_type"])
+		})
+	}
+}
