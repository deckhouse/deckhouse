diff --git a/pkg/logsafe/logsafe.go b/pkg/logsafe/logsafe.go
new file mode 100644
index 00000000..3b4dae24
--- /dev/null
+++ b/pkg/logsafe/logsafe.go
@@ -0,0 +1,49 @@
+// Package logsafe prepares values that come from users or upstream identity
+// providers for structured logs: control characters are dropped and sizes are
+// bounded, so a hostile or misconfigured provider cannot forge log lines or
+// flood the log with a huge claim.
+package logsafe
+
+import (
+	"fmt"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+const (
+	// MaxValueLen is the maximum length of a logged value, in runes.
+	MaxValueLen = 256
+	// MaxValues is the maximum number of values logged from one list.
+	MaxValues = 50
+)
+
+// Value returns s without control characters, cut to MaxValueLen runes.
+func Value(s string) string {
+	clean := strings.Map(func(r rune) rune {
+		if unicode.IsControl(r) || r == utf8.RuneError {
+			return -1
+		}
+		return r
+	}, s)
+	if utf8.RuneCountInString(clean) <= MaxValueLen {
+		return clean
+	}
+	runes := []rune(clean)
+	return string(runes[:MaxValueLen]) + "…"
+}
+
+// Values returns a sanitized copy of values holding at most MaxValues
+// entries. When entries are dropped, the last element says how many.
+// A nil or empty input returns an empty, non-nil slice, so the log shows [].
+func Values(values []string) []string {
+	n := min(len(values), MaxValues)
+	out := make([]string, 0, n+1)
+	for _, v := range values[:n] {
+		out = append(out, Value(v))
+	}
+	if rest := len(values) - n; rest > 0 {
+		out = append(out, fmt.Sprintf("…(+%d more)", rest))
+	}
+	return out
+}
diff --git a/pkg/logsafe/logsafe_test.go b/pkg/logsafe/logsafe_test.go
new file mode 100644
index 00000000..9fc06824
--- /dev/null
+++ b/pkg/logsafe/logsafe_test.go
@@ -0,0 +1,66 @@
+package logsafe
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestValue(t *testing.T) {
+	long := strings.Repeat("日", MaxValueLen+10)
+
+	tests := []struct {
+		name string
+		in   string
+		want string
+	}{
+		{name: "plain", in: "user@example.com", want: "user@example.com"},
+		{name: "empty", in: "", want: ""},
+		{name: "newline injection", in: "admins\n{\"level\":\"INFO\"}", want: "admins{\"level\":\"INFO\"}"},
+		{name: "carriage return and tab", in: "a\rb\tc", want: "abc"},
+		{name: "ansi escape", in: "\x1b[31mred", want: "[31mred"},
+		{name: "invalid utf8", in: "ok\xffok", want: "okok"},
+		{name: "cut by runes", in: long, want: strings.Repeat("日", MaxValueLen) + "…"},
+		{name: "exactly max", in: strings.Repeat("a", MaxValueLen), want: strings.Repeat("a", MaxValueLen)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			require.Equal(t, tt.want, Value(tt.in))
+		})
+	}
+}
+
+func TestValues(t *testing.T) {
+	many := make([]string, MaxValues+7)
+	for i := range many {
+		many[i] = fmt.Sprintf("g%d", i)
+	}
+
+	tests := []struct {
+		name string
+		in   []string
+		want []string
+	}{
+		{name: "nil", in: nil, want: []string{}},
+		{name: "empty", in: []string{}, want: []string{}},
+		{name: "sanitized", in: []string{"a\nb", "c"}, want: []string{"ab", "c"}},
+		{name: "exactly max", in: many[:MaxValues], want: many[:MaxValues]},
+		{name: "capped", in: many, want: append(append([]string{}, many[:MaxValues]...), "…(+7 more)")},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := Values(tt.in)
+			require.NotNil(t, got)
+			require.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestValuesDoesNotAliasInput(t *testing.T) {
+	in := []string{"a", "b"}
+	out := Values(in)
+	out[0] = "changed"
+	require.Equal(t, "a", in[0])
+}
