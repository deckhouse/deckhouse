+func TestSignInLogPasswordForm(t *testing.T) {
+	var logs logRecorder
+	s := newLocalLoginHandler(t, nil, "Curr3nt-password", nil, func(c *testFlowConfig) {
+		c.Logger = logs.logger()
+		c.Lockout = &lockout.Guard{
+			Storage: c.Storage, Now: time.Now, Logger: c.Logger,
+			Policy: &lockout.Policy{MaxAttempts: 2, Duration: time.Hour},
+		}
+	})
+
+	rr := postPasswordLogin(s, "", localUserEmail, "wrong")
+	require.Equal(t, http.StatusUnauthorized, rr.Code)
+	line := logs.line(t, "failed login attempt: Invalid credentials.")
