@@ -0,0 +1,35 @@
+package connector
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAsUserNotInRequiredGroups(t *testing.T) {
+	refused := &UserNotInRequiredGroupsError{PreferredUsername: "jdoe", Groups: []string{"admins"}}
+	err := fmt.Errorf("get groups: %w", refused)
+
+	got, ok := AsUserNotInRequiredGroups(err, Identity{
+		UserID: "42", Username: "Jane Doe", PreferredUsername: "ignored", Email: "jdoe@example.com",
+	})
+	require.True(t, ok)
+	require.Equal(t, &UserNotInRequiredGroupsError{
+		UserID:            "42",
+		Username:          "Jane Doe",
+		PreferredUsername: "jdoe",
+		Email:             "jdoe@example.com",
+		Groups:            []string{"admins"},
+	}, got, "what the connector knew stays, the rest comes from the identity")
+	require.Nil(t, got.UserGroups, "groups the connector did not read stay unknown")
+
+	_, ok = AsUserNotInRequiredGroups(errors.New("upstream down"), Identity{UserID: "42"})
+	require.False(t, ok)
+}
+
+func TestFetchedGroups(t *testing.T) {
+	require.Equal(t, []string{}, FetchedGroups(nil), "read and empty is not unknown")
+	require.Equal(t, []string{"a"}, FetchedGroups([]string{"a"}))
+}
