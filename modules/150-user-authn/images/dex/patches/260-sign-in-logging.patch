+// TestHandlePOSTNotInAllowedGroups checks that a refused user comes back as a
+// typed error that names the user and the groups of the response, so the
+// server can log who was refused.
+func TestHandlePOSTNotInAllowedGroups(t *testing.T) {
+	tests := []struct {
+		name       string
+		groups     bool
+		wantGroups []string
+	}{
+		{name: "groups read from the response", groups: true, wantGroups: []string{"Admins", "Everyone"}},
+		{name: "groups not requested", groups: false, wantGroups: nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := Config{
+				CA:            "testdata/ca.crt",
+				UsernameAttr:  "Name",
+				EmailAttr:     "email",
+				GroupsAttr:    "groups",
+				RedirectURI:   "http://127.0.0.1:5556/dex/callback",
+				AllowedGroups: []string{"Nope"},
+				SSOURL:        "http://foo.bar/",
+			}
+			conn, err := c.openConnector(slog.New(slog.DiscardHandler))
+			require.NoError(t, err)
+			now, err := time.Parse(timeFormat, "2017-04-04T04:34:59.330Z")
+			require.NoError(t, err)
+			conn.now = func() time.Time { return now }
+			resp, err := os.ReadFile("testdata/good-resp.xml")
+			require.NoError(t, err)
+
+			_, err = conn.HandlePOST(connector.Scopes{Groups: tt.groups},
+				base64.StdEncoding.EncodeToString(resp), "6zmm5mguyebwvajyf2sdwwcw6m")
+
+			var groupsErr *connector.UserNotInRequiredGroupsError
+			require.True(t, errors.As(err, &groupsErr), "got %T: %v", err, err)
+			sort.Strings(groupsErr.UserGroups)
