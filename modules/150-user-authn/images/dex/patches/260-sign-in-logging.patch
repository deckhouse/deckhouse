@@ -0,0 +1,186 @@
+package server
+
+import (
+	"bytes"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"net/url"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/mfa"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/server/ratelimit"
+	"github.com/dexidp/dex/storage"
+)
+
+// signInLogs collects the JSON log lines of a test server.
+type signInLogs struct {
+	mu  sync.Mutex
+	buf bytes.Buffer
+}
+
+func (l *signInLogs) Write(p []byte) (int, error) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.buf.Write(p)
+}
+
+func (l *signInLogs) lines(t *testing.T) []map[string]any {
+	t.Helper()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	var lines []map[string]any
+	for _, raw := range bytes.Split(bytes.TrimSpace(l.buf.Bytes()), []byte("\n")) {
+		if len(raw) == 0 {
+			continue
+		}
+		var line map[string]any
+		require.NoError(t, json.Unmarshal(raw, &line), "%s", raw)
+		lines = append(lines, line)
+	}
+	return lines
+}
+
+// last returns the last line logged with msg.
+func (l *signInLogs) last(t *testing.T, msg string) map[string]any {
+	t.Helper()
+	lines := l.lines(t)
+	for i := len(lines) - 1; i >= 0; i-- {
+		if lines[i]["msg"] == msg {
+			return lines[i]
+		}
+	}
+	require.Failf(t, "line not logged", "%q in %v", msg, lines)
+	return nil
+}
+
+// newSignInLogServer is the lock test server (password connector "test",
+// client "test") logging JSON into the returned recorder.
+func newSignInLogServer(t *testing.T, update func(*Config)) (*Server, *signInLogs) {
+	t.Helper()
+	logs := &signInLogs{}
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.Logger = slog.New(slog.NewJSONHandler(logs, &slog.HandlerOptions{Level: slog.LevelDebug}))
+		c.PasswordConnector = "test"
+		c.Now = time.Now
+		if update != nil {
+			update(c)
+		}
+	})
+	t.Cleanup(httpServer.Close)
+	mockConnectorDataTestStorage(t, s.storage)
+	return s, logs
+}
+
+// requireRefusal checks a refusal line of the sign-in log scheme.
+func requireRefusal(t *testing.T, line map[string]any, reason, connectorID string) {
+	t.Helper()
+	assert.Equal(t, "WARN", line["level"], "%v", line)
+	assert.Equal(t, reason, line["reason"], "%v", line)
+	assert.Equal(t, connectorID, line["connector_id"], "%v", line)
+	assert.Equal(t, "test", line["client_id"], "%v", line)
+	assert.NotContains(t, line, "user")
+	assert.NotContains(t, line, "error")
+}
+
+func TestSignInLogTokenEndpoint(t *testing.T) {
+	s, logs := newSignInLogServer(t, nil)
+
+	rr := postToken(t, s, url.Values{
+		"grant_type": {oauth2.GrantTypePassword},
+		"scope":      {"openid email offline_access"},
+		"username":   {"test"},
+		"password":   {"wrong"},
+	})
+	require.Equal(t, http.StatusUnauthorized, rr.Code, rr.Body.String())
+	line := logs.last(t, "failed login attempt: Invalid credentials.")
+	requireRefusal(t, line, "invalid_credentials", "test")
+	assert.Equal(t, "test", line["username"])
+	assert.Equal(t, oauth2.GrantTypePassword, line["grant_type"])
+
+	rr = passwordGrant(t, s)
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	var issued struct {
+		RefreshToken string `json:"refresh_token"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &issued))
+
+	setBlockedUntil(t, s, "test", time.Now().Add(time.Hour))
+	requireAccountLocked(t, passwordGrant(t, s))
+	line = logs.last(t, "token request for locked account")
+	requireRefusal(t, line, "account_locked", "test")
+	assert.Equal(t, "test", line["username"])
+	assert.Contains(t, line, "blocked_until")
+
+	requireAccountLocked(t, postToken(t, s, url.Values{
+		"grant_type": {oauth2.GrantTypeRefreshToken}, "refresh_token": {issued.RefreshToken},
+	}))
+	line = logs.last(t, "refresh denied: account locked")
+	requireRefusal(t, line, "account_locked", "test")
+	assert.Equal(t, mockUserID, line["user_id"])
+	assert.Equal(t, "kilgore@kilgore.trout", line["email"])
+
+	setBlockedUntil(t, s, "mock", time.Now().Add(time.Hour))
+	requireAccountLocked(t, postToken(t, s, url.Values{
+		"grant_type":         {oauth2.GrantTypeTokenExchange},
+		"connector_id":       {"mock"},
+		"scope":              {"openid"},
+		"subject_token_type": {oauth2.TokenTypeID},
+		"subject_token":      {"foobar"},
+	}))
+	requireRefusal(t, logs.last(t, "token request for locked account"), "account_locked", "mock")
+}
+
+func TestSignInLogTOTP(t *testing.T) {
+	const authenticatorID = "totp"
+	s, logs := newSignInLogServer(t, func(c *Config) {
+		c.MFAProviders = map[string]mfa.Provider{authenticatorID: mfa.NewTOTPProvider("dex", nil)}
+		c.DefaultMFAChain = []string{authenticatorID}
+	})
+	ctx := t.Context()
+	req := storage.AuthRequest{
+		ID: "mfa-req", ClientID: "test", ConnectorID: "mock", RedirectURI: "foo://bar.com/",
+		ResponseTypes: []string{"code"}, Expiry: time.Now().Add(time.Hour), LoggedIn: true,
+		Claims:  storage.Claims{UserID: "u1", Username: "Jane", Email: "u1@example.com"},
+		HMACKey: []byte("0123456789abcdef0123456789abcdef"),
+	}
+	require.NoError(t, s.storage.CreateAuthRequest(ctx, req))
+	require.NoError(t, s.storage.CreateUserIdentity(ctx, storage.UserIdentity{
+		UserID: "u1", ConnectorID: "mock", Claims: req.Claims,
+		MFASecrets: map[string]*storage.MFASecret{authenticatorID: {
+			AuthenticatorID: authenticatorID, Type: "TOTP", Confirmed: true,
+			Secret: "otpauth://totp/dex:u1?issuer=dex&secret=JBSWY3DPEHPK3PXP",
+		}},
+	}))
+
+	target := internal.StepURL("/mfa/totp", req, internal.Authenticator(authenticatorID), url.Values{"authenticator": {authenticatorID}})
+	serveRequest(s, rateLimitedRequest(http.MethodPost, target, url.Values{"totp": {"000000"}}))
+
+	line := logs.last(t, "failed TOTP attempt: Invalid credentials.")
+	requireRefusal(t, line, "invalid_totp", "mock")
+	assert.Equal(t, "u1", line["user_id"])
+	assert.Equal(t, "Jane", line["username"])
+	assert.Equal(t, "u1@example.com", line["email"])
+	assert.Equal(t, authenticatorID, line["authenticator"])
+}
+
+func TestSignInLogRateLimit(t *testing.T) {
+	s, logs := newSignInLogServer(t, func(c *Config) {
+		c.RateLimit = &ratelimit.Config{RequestsPerMinute: 1, Burst: 1}
+	})
+
+	serveRequest(s, badClientTokenRequest(""))
+	require.Equal(t, http.StatusTooManyRequests, serveRequest(s, badClientTokenRequest("")).Code)
+
+	line := logs.last(t, "client address rate limited")
+	assert.Equal(t, "WARN", line["level"])
+	assert.Equal(t, "rate_limited", line["reason"])
+	assert.Equal(t, "/token", line["path"])
+}
diff --git a/server/signinlog/signinlog.go b/server/signinlog/signinlog.go
new file mode 100644
index 00000000..ab420c38
--- /dev/null
+++ b/server/signinlog/signinlog.go
@@ -0,0 +1,159 @@
+// Package signinlog owns the attributes and the levels of the sign-in log lines
+// of dex (Deckhouse). Every line about a sign-in, whatever the connector or the
+// flow (login form, connector callback, password change page, second factor,
+// password, refresh-token and token-exchange grants, lockout, allow-lists, rate
+// limit, upstream refresh), has the same attributes:
+//
+//   - connector_id and client_id;
+//   - user_id, username, preferred_username and email, each when known; the
+//     email as the provider gives it;
+//   - groups on a success; user_groups, user_groups_count and allowed_groups on
+//     a refusal for groups;
+//   - reason on every refusal, one of the Reason constants; rule with
+//     ReasonNotAllowed;
+//   - err when an error caused the line.
+//
+// A refusal caused by the user, the identity provider's answer included, is a
+// warning; a failure of dex or of the provider is an error; a success is info.
+// Values that come from users or identity providers go through pkg/logsafe. The
+// keys "user" and "error" are not used. Message texts stay those of upstream and
+// of the v2.44-based Deckhouse dex, which log searches rely on.
+package signinlog
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/pkg/logsafe"
+	"github.com/dexidp/dex/server/allowlist"
+	"github.com/dexidp/dex/storage"
+)
+
+// Reasons of a refused sign-in, the values of the "reason" attribute.
+const (
+	// ReasonInvalidCredentials: a wrong login or password, or a password change
+	// page opened without the sign-in that led to it.
+	ReasonInvalidCredentials = "invalid_credentials"
+	// ReasonInvalidTOTP: a wrong or reused code of the second factor.
+	ReasonInvalidTOTP = "invalid_totp"
+	// ReasonNotInAllowedGroups: the connector refused the user for the groups.
+	ReasonNotInAllowedGroups = "not_in_allowed_groups"
+	// ReasonNotAllowed: an allow-list of the client or the connector refused the
+	// user; the "rule" attribute names it.
+	ReasonNotAllowed = "not_allowed"
+	// ReasonAccountLocked: the (user, connector) pair is locked.
+	ReasonAccountLocked = "account_locked"
+	// ReasonRateLimited: the client address has used up its failed attempts.
+	ReasonRateLimited = "rate_limited"
+	// ReasonUpstreamRefused: the identity provider refused to refresh the user:
+	// the user is gone, the access was revoked or the credential refused.
+	ReasonUpstreamRefused = "upstream_refused"
+)
+
+// User is what is known about the user of a sign-in.
+type User struct {
+	ID                string
+	Username          string
+	PreferredUsername string
+	Email             string
+}
+
+// ClaimsUser is the user of claims.
+func ClaimsUser(c storage.Claims) User {
+	return User{ID: c.UserID, Username: c.Username, PreferredUsername: c.PreferredUsername, Email: c.Email}
+}
+
+// IdentityUser is the user of an identity a connector returned.
+func IdentityUser(i connector.Identity) User {
+	return User{ID: i.UserID, Username: i.Username, PreferredUsername: i.PreferredUsername, Email: i.Email}
+}
+
+// Typed is u with the name typed into a login form as its username when u has
+// none.
+func (u User) Typed(username string) User {
+	if u.Username == "" {
+		u.Username = username
+	}
+	return u
+}
+
+// Attrs returns the attributes that identify a sign-in: the connector, the
+// client, then whatever is known about the user.
+func Attrs(connectorID, clientID string, u User) []any {
+	attrs := []any{
+		"connector_id", logsafe.Value(connectorID),
+		"client_id", logsafe.Value(clientID),
+	}
+	for _, kv := range [...]struct{ key, value string }{
+		{"user_id", u.ID},
+		{"username", u.Username},
+		{"preferred_username", u.PreferredUsername},
+		{"email", u.Email},
+	} {
+		if kv.value != "" {
+			attrs = append(attrs, kv.key, logsafe.Value(kv.value))
+		}
+	}
+	return attrs
+}
+
+// Refused returns the attributes of a sign-in refused for reason.
+func Refused(reason, connectorID, clientID string, u User) []any {
+	return append(Attrs(connectorID, clientID, u), "reason", reason)
+}
+
+// Failed returns the attributes of a sign-in that err failed.
+func Failed(err error, connectorID, clientID string, u User) []any {
+	return append(Attrs(connectorID, clientID, u), "err", err)
+}
+
+// Groups returns the groups of a successful sign-in, for the "groups"
+// attribute.
+func Groups(groups []string) []string {
+	return logsafe.Values(groups)
+}
+
+// NotInGroups returns the attributes of a user a connector refused for the
+// groups: the reason, the user as the connector named him, the groups read from
+// the provider when the connector read them, and the groups it requires.
+func NotInGroups(e *connector.UserNotInRequiredGroupsError, connectorID, clientID string) []any {
+	attrs := Refused(ReasonNotInAllowedGroups, connectorID, clientID, User{
+		ID:                e.UserID,
+		Username:          e.Username,
+		PreferredUsername: e.PreferredUsername,
+		Email:             e.Email,
+	})
+	if e.UserGroups != nil {
+		attrs = append(attrs, "user_groups", logsafe.Values(e.UserGroups), "user_groups_count", len(e.UserGroups))
+	}
+	return append(attrs, "allowed_groups", logsafe.Values(e.Groups))
+}
+
+// NotAllowed returns the attributes of a user u an allow-list refused: the
+// reason, the rule, and for a group list the groups. Email lists are not
+// logged: they name other users.
+func NotAllowed(e *allowlist.NotAllowedError, u User) []any {
+	attrs := append(Refused(ReasonNotAllowed, e.ConnectorID, e.ClientID, u), "rule", string(e.Rule))
+	if e.AllowedGroups != nil {
+		attrs = append(attrs,
+			"user_groups", logsafe.Values(e.UserGroups),
+			"user_groups_count", len(e.UserGroups),
+			"allowed_groups", logsafe.Values(e.AllowedGroups),
+		)
+	}
+	return attrs
+}
+
+// ConnectorError logs err, which a connector returned for a sign-in of u: a
+// user the connector refused for the groups is a refusal and a warning,
+// anything else an error. extra goes at the end of the line.
+func ConnectorError(ctx context.Context, logger *slog.Logger, msg string, err error, connectorID, clientID string, u User, extra ...any) {
+	var groupsErr *connector.UserNotInRequiredGroupsError
+	if errors.As(err, &groupsErr) {
+		logger.WarnContext(ctx, msg, append(append(NotInGroups(groupsErr, connectorID, clientID), "err", err), extra...)...)
+		return
+	}
+	logger.ErrorContext(ctx, msg, append(Failed(err, connectorID, clientID, u), extra...)...)
+}
