@@ -0,0 +1,270 @@
+package authflow
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"log/slog"
+	"net/http"
+	"net/url"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/lockout"
+	"github.com/dexidp/dex/storage"
+)
+
+// logRecorder collects the JSON log lines of a test server.
+type logRecorder struct {
+	mu  sync.Mutex
+	buf bytes.Buffer
+}
+
+func (l *logRecorder) Write(p []byte) (int, error) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.buf.Write(p)
+}
+
+func (l *logRecorder) logger() *slog.Logger {
+	return slog.New(slog.NewJSONHandler(l, &slog.HandlerOptions{Level: slog.LevelDebug}))
+}
+
+// lines returns the lines logged so far.
+func (l *logRecorder) lines(t *testing.T) []map[string]any {
+	t.Helper()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	var lines []map[string]any
+	for _, raw := range bytes.Split(bytes.TrimSpace(l.buf.Bytes()), []byte("\n")) {
+		if len(raw) == 0 {
+			continue
+		}
+		var line map[string]any
+		require.NoError(t, json.Unmarshal(raw, &line), "%s", raw)
+		lines = append(lines, line)
+	}
+	return lines
+}
+
+// line returns the one line logged with msg.
+func (l *logRecorder) line(t *testing.T, msg string) map[string]any {
+	t.Helper()
+	var found []map[string]any
+	for _, line := range l.lines(t) {
+		if line["msg"] == msg {
+			found = append(found, line)
+		}
+	}
+	require.Len(t, found, 1, "lines %q in %v", msg, l.lines(t))
+	return found[0]
+}
+
+// requireScheme checks every line logged so far against the sign-in log scheme:
+// no "user" or "error" keys, and a reason on every warning.
+func (l *logRecorder) requireScheme(t *testing.T) {
+	t.Helper()
+	for _, line := range l.lines(t) {
+		assert.NotContains(t, line, "user", "line %v", line)
+		assert.NotContains(t, line, "error", "line %v", line)
+		if line["level"] == "WARN" {
+			assert.Contains(t, line, "reason", "line %v", line)
+		}
+	}
+}
+
+// fixedCallbackConnector answers every callback with its identity and error.
+type fixedCallbackConnector struct {
+	identity connector.Identity
+	err      error
+}
+
+func (c fixedCallbackConnector) LoginURL(_ connector.Scopes, callbackURL, state string) (string, []byte, error) {
+	return callbackURL + "?state=" + state, nil, nil
+}
+
+func (c fixedCallbackConnector) HandleCallback(connector.Scopes, []byte, *http.Request) (connector.Identity, error) {
+	return c.identity, c.err
+}
+
+func TestSignInLogCallback(t *testing.T) {
+	jane := connector.Identity{
+		UserID: "jane-id", Username: "Jane", PreferredUsername: "jane", Email: "jane@example.com",
+		EmailVerified: true, Groups: []string{"dev", "qa"},
+	}
+	tests := []struct {
+		name     string
+		conn     fixedCallbackConnector
+		client   storage.Client
+		blocked  bool
+		status   int
+		msg      string
+		level    string
+		reason   string
+		expected map[string]any
+	}{
+		{
+			name: "success",
+			conn: fixedCallbackConnector{identity: jane},
+			msg:  "login successful", level: "INFO", status: http.StatusSeeOther,
+			expected: map[string]any{
+				"user_id": "jane-id", "username": "Jane", "preferred_username": "jane", "email": "jane@example.com",
+				"groups": []any{"dev", "qa"},
+			},
+		},
+		{
+			name: "refused by the connector for the groups",
+			conn: fixedCallbackConnector{err: &connector.UserNotInRequiredGroupsError{
+				UserID: "jane-id", Email: "jane@example.com", UserGroups: []string{"dev"}, Groups: []string{"admins"},
+			}},
+			msg: "failed to authenticate", level: "WARN", reason: "not_in_allowed_groups", status: http.StatusForbidden,
+			expected: map[string]any{
+				"user_id": "jane-id", "email": "jane@example.com",
+				"user_groups": []any{"dev"}, "user_groups_count": float64(1), "allowed_groups": []any{"admins"},
+			},
+		},
+		{
+			name: "provider failed",
+			conn: fixedCallbackConnector{err: errors.New("provider unreachable")},
+			msg:  "failed to authenticate", level: "ERROR", status: http.StatusInternalServerError,
+			expected: map[string]any{"err": "provider unreachable"},
+		},
+		{
+			name:   "refused by an allow-list of the client",
+			conn:   fixedCallbackConnector{identity: jane},
+			client: storage.Client{AllowedGroups: []string{"admins"}},
+			msg:    "access denied", level: "WARN", reason: "not_allowed", status: http.StatusUnauthorized,
+			expected: map[string]any{
+				"rule": "client_allowed_groups", "user_id": "jane-id", "email": "jane@example.com",
+				"user_groups": []any{"dev", "qa"}, "allowed_groups": []any{"admins"},
+			},
+		},
+		{
+			name:    "locked",
+			conn:    fixedCallbackConnector{identity: jane},
+			blocked: true,
+			msg:     "login rejected for locked account", level: "WARN", reason: "account_locked", status: http.StatusTooManyRequests,
+			expected: map[string]any{"user_id": "jane-id", "email": "jane@example.com"},
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var logs logRecorder
+			httpServer, s := newTestHandler(t, func(c *testFlowConfig) { c.Logger = logs.logger() })
+			defer httpServer.Close()
+			ctx := t.Context()
+
+			client := tc.client
+			client.ID, client.RedirectURIs = "app", []string{"https://app.example/cb"}
+			require.NoError(t, s.Storage.CreateClient(ctx, client))
+			require.NoError(t, s.Storage.CreateConnector(ctx, storage.Connector{ID: "idp", Type: "fixed", Name: "IdP", ResourceVersion: "1"}))
+			s.Connectors.Set("idp", connectors.Connector{Type: "fixed", ResourceVersion: "1", Connector: tc.conn})
+			require.NoError(t, s.Storage.CreateAuthRequest(ctx, storage.AuthRequest{
+				ID: "req", ClientID: "app", ConnectorID: "idp", ResponseTypes: []string{"code"},
+				Scopes: []string{"openid", "groups"}, RedirectURI: "https://app.example/cb",
+				Expiry: time.Now().Add(time.Hour), HMACKey: []byte("0123456789abcdef0123456789abcdef"),
+			}))
+			if tc.blocked {
+				require.NoError(t, s.Storage.CreateUserIdentity(ctx, storage.UserIdentity{
+					UserID: "jane-id", ConnectorID: "idp", BlockedUntil: time.Now().Add(time.Hour), Consents: map[string][]string{},
+				}))
+			}
+
+			rr := serve(s, http.MethodGet, "/callback/idp?state=req", nil)
+			require.Equal(t, tc.status, rr.Code, rr.Body.String())
+
+			line := logs.line(t, tc.msg)
+			assert.Equal(t, tc.level, line["level"])
+			assert.Equal(t, "idp", line["connector_id"])
+			assert.Equal(t, "app", line["client_id"])
+			if tc.reason != "" {
+				assert.Equal(t, tc.reason, line["reason"])
+			} else {
+				assert.NotContains(t, line, "reason")
+			}
+			for k, v := range tc.expected {
+				assert.Equal(t, v, line[k], k)
+			}
+			for _, other := range logs.lines(t) {
+				assert.NotEqual(t, "failed to finalize login", other["msg"], "a refusal is not a failure: %v", other)
+			}
+			logs.requireScheme(t)
+		})
+	}
+}
