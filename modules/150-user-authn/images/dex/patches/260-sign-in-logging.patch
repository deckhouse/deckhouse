--- /dev/null
+++ b/server/grants/signinlog_test.go
@@ -0,0 +1,121 @@
+package grants
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/allowlist"
+	"github.com/dexidp/dex/server/signinlog"
+	"github.com/dexidp/dex/server/useridentity"
+	"github.com/dexidp/dex/storage"
+)
+
+// captureLog returns a logger that writes JSON and a function that returns the
+// lines written so far.
+func captureLog(t *testing.T) (*slog.Logger, func() []map[string]any) {
+	t.Helper()
+	var buf bytes.Buffer
+	logger := slog.New(slog.NewJSONHandler(&buf, nil))
+	return logger, func() []map[string]any {
+		raws := bytes.Split(bytes.TrimSpace(buf.Bytes()), []byte("\n"))
+		lines := make([]map[string]any, 0, len(raws))
+		for _, raw := range raws {
+			var line map[string]any
+			require.NoError(t, json.Unmarshal(raw, &line), "%s", raw)
+			lines = append(lines, line)
+		}
+		return lines
+	}
+}
+
+func TestIdentityErrorLog(t *testing.T) {
+	user := signinlog.User{ID: "1", Username: "jane"}
+
+	logger, lines := captureLog(t)
+	oerr := identityError(t.Context(), logger, &useridentity.BlockedError{Until: time.Now().Add(time.Hour)},
+		refreshLocked, "ldap", "kubeconfig", user)
+	require.Equal(t, http.StatusTooManyRequests, oerr.Status)
+	line := lines()[0]
+	require.Equal(t, "WARN", line["level"])
+	require.Equal(t, "refresh denied: account locked", line["msg"])
+	require.Equal(t, "account_locked", line["reason"])
+	require.Equal(t, "ldap", line["connector_id"])
+	require.Equal(t, "kubeconfig", line["client_id"])
+	require.Equal(t, "jane", line["username"])
+	require.Contains(t, line, "blocked_until")
+
+	logger, lines = captureLog(t)
+	oerr = identityError(t.Context(), logger, errors.New("storage down"), tokenRequestLocked, "ldap", "kubeconfig", user)
+	require.Equal(t, http.StatusInternalServerError, oerr.Status)
+	line = lines()[0]
+	require.Equal(t, "ERROR", line["level"])
+	require.Equal(t, "storage down", line["err"])
+	require.NotContains(t, line, "reason")
+
+	require.Nil(t, identityError(t.Context(), logger, nil, tokenRequestLocked, "ldap", "kubeconfig", user))
+}
+
+func TestAllowListErrorLog(t *testing.T) {
+	logger, lines := captureLog(t)
+	refusal := &allowlist.NotAllowedError{
+		Rule: allowlist.ConnectorGroups, ClientID: "app", ConnectorID: "ldap",
+		UserGroups: []string{"dev"}, AllowedGroups: []string{"admins"},
+	}
+	oerr := allowListError(t.Context(), logger, refusal, "password grant denied by access filter",
+		"ldap", "app", signinlog.User{ID: "1", Email: "jane@example.com"})
+	require.Equal(t, http.StatusUnauthorized, oerr.Status)
+	line := lines()[0]
+	require.Equal(t, "WARN", line["level"])
+	require.Equal(t, "password grant denied by access filter", line["msg"])
+	require.Equal(t, "not_allowed", line["reason"])
+	require.Equal(t, "connector_allowed_groups", line["rule"])
+	require.Equal(t, "jane@example.com", line["email"])
+	require.Equal(t, []any{"dev"}, line["user_groups"])
+	require.Equal(t, []any{"admins"}, line["allowed_groups"])
+
+	logger, lines = captureLog(t)
+	oerr = allowListError(t.Context(), logger, errors.New("storage down"), "password grant denied by access filter",
+		"ldap", "app", signinlog.User{ID: "1"})
+	require.Equal(t, http.StatusInternalServerError, oerr.Status)
+	require.Equal(t, "ERROR", lines()[0]["level"])
+}
+
+func TestUpstreamRefusalLog(t *testing.T) {
+	token := &storage.RefreshToken{
+		ClientID:    "kubeconfig",
+		ConnectorID: "gitlab",
+		Claims:      storage.Claims{UserID: "42", Username: "Jane", PreferredUsername: "jane", Email: "jane@example.com"},
+	}
+	logged := func(err error) map[string]any {
+		var buf bytes.Buffer
+		slog.New(slog.NewJSONHandler(&buf, nil)).Warn("refresh refused by the upstream provider", upstreamRefusal(err, token)...)
+		var line map[string]any
+		require.NoError(t, json.Unmarshal(buf.Bytes(), &line))
+		return line
+	}
+
+	gone := logged(fmt.Errorf("gitlab: %w", connector.ErrIdentityGone))
+	require.Equal(t, "upstream_refused", gone["reason"])
+	require.Equal(t, "gitlab", gone["connector_id"])
+	require.Equal(t, "kubeconfig", gone["client_id"])
+	require.Equal(t, "42", gone["user_id"])
+	require.Equal(t, "jane@example.com", gone["email"])
+	require.Contains(t, gone["err"], "identity no longer valid upstream")
+
+	groups := logged(&connector.UserNotInRequiredGroupsError{
+		PreferredUsername: "jane", UserGroups: []string{"dev"}, Groups: []string{"admins"},
+	})
+	require.Equal(t, "not_in_allowed_groups", groups["reason"])
+	require.Equal(t, "42", groups["user_id"], "what the connector did not name comes from the token")
+	require.Equal(t, []any{"dev"}, groups["user_groups"])
+	require.Equal(t, []any{"admins"}, groups["allowed_groups"])
+}
