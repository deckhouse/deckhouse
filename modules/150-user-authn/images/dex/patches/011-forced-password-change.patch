diff --git a/server/passwordchangehandler_test.go b/server/passwordchangehandler_test.go
new file mode 100644
index 00000000..7d81874a
--- /dev/null
+++ b/server/passwordchangehandler_test.go
@@ -0,0 +1,83 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+
+	"github.com/dexidp/dex/storage"
+)
+
+const passwordChangeEmail = "jane@example.com"
+
+func newPasswordChangeServer(t *testing.T, historyLimit uint64, stored storage.Password) *Server {
+	t.Helper()
+	policy, err := NewPasswordPolicy("local", WithComplexityLevel("None"), WithPasswordHistoryLimit(historyLimit))
+	require.NoError(t, err)
+	_, s := newTestServer(t, func(c *Config) { c.PasswordPolicy = policy })
+	require.NoError(t, s.storage.CreatePassword(t.Context(), stored))
+	return s
+}
+
+func postPasswordChange(t *testing.T, s *Server, currentPassword, newPassword string) *httptest.ResponseRecorder {
+	t.Helper()
+	form := url.Values{
+		"username":        {passwordChangeEmail},
+		"currentPassword": {currentPassword},
+		"newPassword":     {newPassword},
+	}
+	req := httptest.NewRequest(http.MethodPost, passwordChangeURI, strings.NewReader(form.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	rr := httptest.NewRecorder()
+	s.handlePasswordChange(rr, req)
+	return rr
+}
+
+func mustHash(t *testing.T, password string) []byte {
+	t.Helper()
+	hash, err := bcrypt.GenerateFromPassword([]byte(password), 10)
+	require.NoError(t, err)
+	return hash
+}
+
+// bcrypt reads 72 bytes, so a current password typed with anything appended still verifies, while the
+// typed strings differ. The change must still refuse the current password as the new one, or the user
+// keeps it and restarts its rotation.
+func TestHandlePasswordChangeRefusesCurrentPasswordPast72Bytes(t *testing.T) {
+	current := strings.Repeat("a", 72)
+	hash := mustHash(t, current)
+	s := newPasswordChangeServer(t, 5, storage.Password{Email: passwordChangeEmail, Username: "jane", UserID: "jane", Hash: hash})
+
+	rr := postPasswordChange(t, s, current+"tail", current)
+	require.NotEqual(t, http.StatusSeeOther, rr.Code, "the change must be refused")
+
+	stored, err := s.storage.GetPassword(t.Context(), passwordChangeEmail)
+	require.NoError(t, err)
+	require.Equal(t, hash, stored.Hash)
+	require.True(t, stored.HashUpdatedAt.IsZero(), "the password must not count as rotated")
+
+	rr = postPasswordChange(t, s, current, "another-password")
+	require.Equal(t, http.StatusSeeOther, rr.Code, "a different password is accepted")
+}
+
+// A history longer than the limit, after the limit was lowered, is trimmed to the limit in one change.
+func TestHandlePasswordChangeTrimsHistoryToLimit(t *testing.T) {
+	hash := mustHash(t, "current-password")
+	s := newPasswordChangeServer(t, 2, storage.Password{
+		Email: passwordChangeEmail, Username: "jane", UserID: "jane", Hash: hash,
+		PreviousHashes: [][]byte{[]byte("p1"), []byte("p2"), []byte("p3")},
+	})
+
+	rr := postPasswordChange(t, s, "current-password", "next-password")
+	require.Equal(t, http.StatusSeeOther, rr.Code)
+
+	stored, err := s.storage.GetPassword(t.Context(), passwordChangeEmail)
+	require.NoError(t, err)
+	require.Equal(t, [][]byte{[]byte("p3"), hash}, stored.PreviousHashes)
+	require.NoError(t, bcrypt.CompareHashAndPassword(stored.Hash, []byte("next-password")))
+}
