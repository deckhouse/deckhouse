+// newPasswordGrantRequest builds a password grant for client "test" through
+// the mock password connector "test", which accepts test/test.
+func newPasswordGrantRequest(t *testing.T, s *Server, password string) *http.Request {
+	t.Helper()
+	v := url.Values{}
+	v.Set("scope", "openid email")
+	v.Set("grant_type", "password")
+	v.Set("username", "test")
+	v.Set("password", password)
+	req := httptest.NewRequest(http.MethodPost, s.issuerURL.String()+"/token", strings.NewReader(v.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth("test", "barfoo")
+	return req
+}
