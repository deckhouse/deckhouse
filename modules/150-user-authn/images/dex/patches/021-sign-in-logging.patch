+	require.Equal(t, "test", entry["client_id"])
+	require.Equal(t, "test", entry["username"])
+	require.Equal(t, grantTypePassword, entry["grant_type"])
+	require.NotContains(t, entry, "user", "the username key is the same as on every other line")
