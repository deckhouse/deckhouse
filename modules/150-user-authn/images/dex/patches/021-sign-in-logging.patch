+++ b/server/loginlog.go
@@ -0,0 +1,75 @@
+package server
+
+import (
+	"context"
+	"errors"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/pkg/logsafe"
+)
+
+// Sign-in log lines share one set of attributes, whatever the connector or
+// the flow (login form, connector callback, password grant, token exchange,
+// refresh, TOTP):
+//
+//   - connector_id, client_id: always;
+//   - user_id, username, preferred_username, email: whatever is known;
+//   - groups on success, user_groups and allowed_groups on a group refusal;
+//   - reason on every refusal, one of the reason* constants;
+//   - err when an error caused the line.
+//
+// A refusal caused by the user (wrong password or code, not allowed, locked)
+// is logged as a warning; a failure of Dex or of the upstream provider as an
+// error.
+const (
+	reasonInvalidCredentials = "invalid_credentials"
+	reasonInvalidTOTP        = "invalid_totp"
+	reasonNotInAllowedGroups = "not_in_allowed_groups"
+	reasonNotAllowed         = "not_allowed"
+	reasonAccountLocked      = "account_locked"
+)
+
+// signInAttrs returns the attributes that identify a sign-in: the connector
+// and the client, then whatever is known about the user. username is the name
+// typed into a login form and is used when the identity has none.
+func signInAttrs(connectorID, clientID string, identity connector.Identity, username string) []any {
+	attrs := []any{
+		"connector_id", logsafe.Value(connectorID),
+		"client_id", logsafe.Value(clientID),
+	}
+	if identity.UserID != "" {
+		attrs = append(attrs, "user_id", logsafe.Value(identity.UserID))
+	}
+	if name := firstNonEmpty(identity.Username, username); name != "" {
+		attrs = append(attrs, "username", logsafe.Value(name))
+	}
+	if identity.PreferredUsername != "" {
+		attrs = append(attrs, "preferred_username", logsafe.Value(identity.PreferredUsername))
+	}
+	if identity.Email != "" {
+		attrs = append(attrs, "email", logsafe.Value(identity.Email))
+	}
+	return attrs
+}
+
+// logConnectorError logs an error a connector returned for a sign-in. A user
+// outside the connector's allowed groups is a refusal and is logged as a
+// warning with the user and the groups; any other error is logged as an error.
+func (s *Server) logConnectorError(ctx context.Context, msg string, err error, connectorID, clientID, username string, extra ...any) {
+	var groupsErr *connector.UserNotInRequiredGroupsError
+	if errors.As(err, &groupsErr) {
+		userAttrs := groupsErr.LogAttrs()
+		attrs := make([]any, 0, 8+len(userAttrs)+len(extra))
+		attrs = append(attrs,
+			"err", err,
+			"reason", reasonNotInAllowedGroups,
+			"connector_id", logsafe.Value(connectorID),
+			"client_id", logsafe.Value(clientID),
+		)
+		attrs = append(attrs, userAttrs...)
+		s.logger.WarnContext(ctx, msg, append(attrs, extra...)...)
+		return
+	}
+	attrs := append([]any{"err", err}, signInAttrs(connectorID, clientID, connector.Identity{}, username)...)
+	s.logger.ErrorContext(ctx, msg, append(attrs, extra...)...)
+}
