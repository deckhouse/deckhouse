new file mode 100644
index 00000000..9fc06824
--- /dev/null
+++ b/pkg/logsafe/logsafe_test.go
@@ -0,0 +1,66 @@
+package logsafe
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestValue(t *testing.T) {
+	long := strings.Repeat("日", MaxValueLen+10)
+
+	tests := []struct {
+		name string
+		in   string
+		want string
+	}{
+		{name: "plain", in: "user@example.com", want: "user@example.com"},
+		{name: "empty", in: "", want: ""},
+		{name: "newline injection", in: "admins\n{\"level\":\"INFO\"}", want: "admins{\"level\":\"INFO\"}"},
+		{name: "carriage return and tab", in: "a\rb\tc", want: "abc"},
+		{name: "ansi escape", in: "\x1b[31mred", want: "[31mred"},
+		{name: "invalid utf8", in: "ok\xffok", want: "okok"},
+		{name: "cut by runes", in: long, want: strings.Repeat("日", MaxValueLen) + "…"},
+		{name: "exactly max", in: strings.Repeat("a", MaxValueLen), want: strings.Repeat("a", MaxValueLen)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			require.Equal(t, tt.want, Value(tt.in))
+		})
+	}
+}
+
+func TestValues(t *testing.T) {
+	many := make([]string, MaxValues+7)
+	for i := range many {
+		many[i] = fmt.Sprintf("g%d", i)
+	}
+
+	tests := []struct {
+		name string
+		in   []string
+		want []string
+	}{
+		{name: "nil", in: nil, want: []string{}},
+		{name: "empty", in: []string{}, want: []string{}},
+		{name: "sanitized", in: []string{"a\nb", "c"}, want: []string{"ab", "c"}},
+		{name: "exactly max", in: many[:MaxValues], want: many[:MaxValues]},
+		{name: "capped", in: many, want: append(append([]string{}, many[:MaxValues]...), "…(+7 more)")},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := Values(tt.in)
+			require.NotNil(t, got)
+			require.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestValuesDoesNotAliasInput(t *testing.T) {
+	in := []string{"a", "b"}
+	out := Values(in)
+	out[0] = "changed"
+	require.Equal(t, "a", in[0])
+}
