+func TestApplyAccessFiltersNotAllowedDetails(t *testing.T) {
+	srv := &Server{storage: storage.WithStaticConnectors(memory.New(slog.New(slog.DiscardHandler)), []storage.Connector{{
+		ID: "corp", Type: "mock", Name: "Corp",
+		AllowedEmailDomains: []string{"corp.example"},
+		AllowedGroups:       []string{"staff"},
+	}})}
+
+	tests := []struct {
+		name          string
+		client        storage.Client
+		connectorID   string
+		claims        storage.Claims
+		wantRule      string
+		wantAllowed   []string
+		wantUserGroup []string
+	}{
+		{
+			name:          "client email list",
+			client:        storage.Client{ID: "app", AllowedEmails: []string{"x@corp.example"}},
+			connectorID:   "corp",
+			claims:        storage.Claims{UserID: "u1", Email: "ann@corp.example", Groups: []string{"staff"}},
+			wantRule:      notAllowedClientEmails,
+			wantUserGroup: []string{"staff"},
+		},
+		{
+			name:          "client group list",
+			client:        storage.Client{ID: "app", AllowedGroups: []string{"admins"}},
+			connectorID:   "corp",
+			claims:        storage.Claims{UserID: "u1", Email: "ann@corp.example", Groups: []string{"staff", "guests"}},
+			wantRule:      notAllowedClientGroups,
+			wantAllowed:   []string{"admins"},
+			wantUserGroup: []string{"staff", "guests"},
+		},
+		{
+			name:          "connector email domain",
+			client:        storage.Client{ID: "app"},
+			connectorID:   "corp",
+			claims:        storage.Claims{UserID: "u1", Email: "ann@other.example", Groups: []string{"staff"}},
+			wantRule:      notAllowedConnectorEmails,
+			wantUserGroup: []string{"staff"},
+		},
+		{
+			name:          "connector group list keeps the groups the client filter saw",
+			client:        storage.Client{ID: "app", AllowedGroups: []string{"guests", "contractors"}},
+			connectorID:   "corp",
+			claims:        storage.Claims{UserID: "u1", Email: "ann@corp.example", Groups: []string{"guests", "x"}},
+			wantRule:      notAllowedConnectorGroups,
+			wantAllowed:   []string{"staff"},
+			wantUserGroup: []string{"guests", "x"},
+		},
+		{
+			name:          "missing connector",
+			client:        storage.Client{ID: "app"},
+			connectorID:   "gone",
+			claims:        storage.Claims{UserID: "u1", Email: "ann@corp.example", Groups: []string{"staff"}},
+			wantRule:      notAllowedConnectorMissing,
+			wantUserGroup: []string{"staff"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			claims := tt.claims
+			err := srv.applyAccessFilters(t.Context(), tt.client, tt.connectorID, &claims)
+
+			var nae *NotAllowedError
+			require.ErrorAs(t, err, &nae)
+			require.Equal(t, tt.wantRule, nae.Rule)
+			require.Equal(t, "app", nae.ClientID)
+			require.Equal(t, tt.connectorID, nae.ConnectorID)
+			require.Equal(t, "u1", nae.UserID)
+			require.Equal(t, tt.claims.Email, nae.Email)
+			require.Equal(t, tt.wantUserGroup, nae.UserGroups)
+			require.Equal(t, tt.wantAllowed, nae.AllowedGroups)
+		})
+	}
+}
