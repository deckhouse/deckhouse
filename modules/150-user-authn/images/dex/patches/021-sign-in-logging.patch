+func TestPasswordGrantLogsInvalidCredentials(t *testing.T) {
+	s, logs := newPasswordGrantServer(t, nil)
+
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, newPasswordGrantRequest(t, s, "wrong"))
