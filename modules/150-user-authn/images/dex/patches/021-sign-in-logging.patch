index d812390f..969e4cff 100644
--- a/connector/connector.go
+++ b/connector/connector.go
@@ -3,9 +3,84 @@ package connector
 
 import (
 	"context"
+	"errors"
 	"net/http"
+
+	"github.com/dexidp/dex/pkg/logsafe"
 )
 
+// UserNotInRequiredGroupsError is returned by a connector when the upstream
+// provider authenticated the user but none of the user's groups is among the
+// groups the connector allows. The name and the UserID and Groups fields
+// follow the upstream type (dexidp/dex#4200); the other fields identify the
+// user in the server log.
+type UserNotInRequiredGroupsError struct {
+	UserID            string
+	Username          string
+	PreferredUsername string
+	Email             string
+	// UserGroups are the groups the provider returned for the user. nil means
+	// the connector refused the user without fetching them; use FetchedGroups
+	// to report groups that were fetched, even when there are none.
+	UserGroups []string
+	// Groups are the groups the connector allows.
+	Groups []string
+}
+
+// AsUserNotInRequiredGroups reports whether err's chain holds a
+// UserNotInRequiredGroupsError. Fields the connector did not know when it
+// refused the user are filled in from identity.
+func AsUserNotInRequiredGroups(err error, identity Identity) (*UserNotInRequiredGroupsError, bool) {
+	var e *UserNotInRequiredGroupsError
+	if !errors.As(err, &e) {
+		return nil, false
+	}
+	if e.UserID == "" {
+		e.UserID = identity.UserID
+	}
+	if e.Username == "" {
+		e.Username = identity.Username
+	}
+	if e.PreferredUsername == "" {
+		e.PreferredUsername = identity.PreferredUsername
+	}
+	if e.Email == "" {
+		e.Email = identity.Email
+	}
+	return e, true
+}
+
+func (e *UserNotInRequiredGroupsError) Error() string {
+	return "user not a member of allowed groups"
+}
+
+// LogAttrs returns key-value pairs for slog that identify the refused user.
+// Values come from the upstream provider and are sanitized and bounded.
+func (e *UserNotInRequiredGroupsError) LogAttrs() []any {
+	attrs := []any{
+		"user_id", logsafe.Value(e.UserID),
+		"username", logsafe.Value(e.Username),
+		"preferred_username", logsafe.Value(e.PreferredUsername),
+		"email", logsafe.Value(e.Email),
+	}
+	if e.UserGroups != nil {
+		attrs = append(attrs,
+			"user_groups", logsafe.Values(e.UserGroups),
+			"user_groups_count", len(e.UserGroups),
+		)
+	}
+	return append(attrs, "allowed_groups", logsafe.Values(e.Groups))
+}
+
+// FetchedGroups returns groups as fetched from the provider: never nil, so a
+// user without groups is told apart from a user whose groups were not fetched.
+func FetchedGroups(groups []string) []string {
+	if groups == nil {
+		return []string{}
+	}
+	return groups
+}
