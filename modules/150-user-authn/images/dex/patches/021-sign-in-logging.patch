diff --git a/pkg/logsafe/logsafe.go b/pkg/logsafe/logsafe.go
new file mode 100644
index 00000000..3b4dae24
--- /dev/null
+++ b/pkg/logsafe/logsafe.go
@@ -0,0 +1,49 @@
+// Package logsafe prepares values that come from users or upstream identity
+// providers for structured logs: control characters are dropped and sizes are
+// bounded, so a hostile or misconfigured provider cannot forge log lines or
+// flood the log with a huge claim.
+package logsafe
+
+import (
+	"fmt"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+const (
+	// MaxValueLen is the maximum length of a logged value, in runes.
+	MaxValueLen = 256
+	// MaxValues is the maximum number of values logged from one list.
+	MaxValues = 50
+)
+
+// Value returns s without control characters, cut to MaxValueLen runes.
+func Value(s string) string {
+	clean := strings.Map(func(r rune) rune {
+		if unicode.IsControl(r) || r == utf8.RuneError {
+			return -1
+		}
+		return r
+	}, s)
+	if utf8.RuneCountInString(clean) <= MaxValueLen {
+		return clean
+	}
+	runes := []rune(clean)
+	return string(runes[:MaxValueLen]) + "…"
+}
+
+// Values returns a sanitized copy of values holding at most MaxValues
+// entries. When entries are dropped, the last element says how many.
+// A nil or empty input returns an empty, non-nil slice, so the log shows [].
+func Values(values []string) []string {
+	n := min(len(values), MaxValues)
+	out := make([]string, 0, n+1)
+	for _, v := range values[:n] {
+		out = append(out, Value(v))
+	}
+	if rest := len(values) - n; rest > 0 {
+		out = append(out, fmt.Sprintf("…(+%d more)", rest))
+	}
+	return out
+}
