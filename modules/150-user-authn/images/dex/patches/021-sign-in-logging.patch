+// syncBuffer lets the server log from several goroutines into one buffer.
+type syncBuffer struct {
+	mu  sync.Mutex
+	buf bytes.Buffer
+}
+
+func (b *syncBuffer) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.Write(p)
+}
+
+// hasEntry reports whether a JSON log line has the given message.
+func (b *syncBuffer) hasEntry(t *testing.T, msg string) bool {
+	t.Helper()
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	sc := bufio.NewScanner(bytes.NewReader(b.buf.Bytes()))
+	for sc.Scan() {
+		var entry map[string]any
+		require.NoError(t, json.Unmarshal(sc.Bytes(), &entry), "log line: %s", sc.Text())
+		if entry["msg"] == msg {
+			return true
+		}
+	}
+	return false
+}
+
+// logEntry returns the first JSON log line with the given message.
+func (b *syncBuffer) logEntry(t *testing.T, msg string) map[string]any {
+	t.Helper()
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	sc := bufio.NewScanner(bytes.NewReader(b.buf.Bytes()))
+	for sc.Scan() {
+		var entry map[string]any
+		require.NoError(t, json.Unmarshal(sc.Bytes(), &entry), "log line: %s", sc.Text())
+		if entry["msg"] == msg {
+			return entry
+		}
+	}
+	t.Fatalf("no %q log line in:\n%s", msg, b.buf.String())
+	return nil
+}
+
+// refusingConnector is a callback connector whose provider authenticates the
+// user and then refuses them for group membership, as the OIDC connector does.
+type refusingConnector struct {
+	err error
+}
+
+func (c refusingConnector) LoginURL(_ connector.Scopes, callbackURL, state string) (string, error) {
+	return callbackURL + "?state=" + state, nil
+}
+
+func (c refusingConnector) HandleCallback(connector.Scopes, *http.Request) (connector.Identity, error) {
+	return connector.Identity{}, c.err
+}
+
+// newLoggingTestServer starts a test server whose log is captured as JSON and
+// stores an auth request for client "test" through connector "mock".
+func newLoggingTestServer(t *testing.T, client storage.Client) (*Server, *syncBuffer) {
+	t.Helper()
+	logs := &syncBuffer{}
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.Logger = slog.New(slog.NewJSONHandler(logs, &slog.HandlerOptions{Level: slog.LevelDebug}))
+		c.Now = time.Now
+	})
+	t.Cleanup(httpServer.Close)
+
+	ctx := t.Context()
+	client.ID = "test"
+	require.NoError(t, s.storage.CreateClient(ctx, client))
+	require.NoError(t, s.storage.CreateAuthRequest(ctx, storage.AuthRequest{
+		ID:            "req",
+		ClientID:      "test",
+		ConnectorID:   "mock",
+		RedirectURI:   "cb",
+		Expiry:        time.Now().Add(time.Minute),
+		ResponseTypes: []string{responseTypeCode},
+		Scopes:        []string{"openid", "groups"},
+	}))
+	return s, logs
+}
+
+func TestConnectorCallbackLogsUserNotInAllowedGroups(t *testing.T) {
+	s, logs := newLoggingTestServer(t, storage.Client{})
+
+	stored, err := s.storage.GetConnector(t.Context(), "mock")
+	require.NoError(t, err)
+	s.mu.Lock()
+	s.connectors["mock"] = Connector{
+		ResourceVersion: stored.ResourceVersion,
+		Connector: refusingConnector{err: &connector.UserNotInRequiredGroupsError{
+			UserID:            "8d1c-uuid",
+			Username:          "Jane Doe",
+			PreferredUsername: "jdoe",
+			Email:             "jdoe@example.com",
+			UserGroups:        []string{"developers", "qa\n"},
+			Groups:            []string{"admins"},
+		}},
+	}
+	s.mu.Unlock()
+
+	rr := httptest.NewRecorder()
+	s.handleConnectorCallback(rr, httptest.NewRequest(http.MethodGet, "/callback/mock?state=req", nil))
+
+	require.Equal(t, http.StatusInternalServerError, rr.Code, "the response is unchanged")
+	require.NotContains(t, rr.Body.String(), "jdoe", "the page does not name the user")
+	require.NotContains(t, rr.Body.String(), "admins", "the page does not list the groups")
+
+	entry := logs.logEntry(t, "failed to authenticate")
+	require.Equal(t, "WARN", entry["level"], "a refused user is not a Dex failure")
+	require.Equal(t, reasonNotInAllowedGroups, entry["reason"])
+	require.Equal(t, "user not a member of allowed groups", entry["err"])
+	require.Equal(t, "mock", entry["connector_id"])
+	require.Equal(t, "test", entry["client_id"])
+	require.Equal(t, "8d1c-uuid", entry["user_id"])
+	require.Equal(t, "Jane Doe", entry["username"])
+	require.Equal(t, "jdoe", entry["preferred_username"])
+	require.Equal(t, "jdoe@example.com", entry["email"])
+	require.Equal(t, []any{"developers", "qa"}, entry["user_groups"])
+	require.EqualValues(t, 2, entry["user_groups_count"])
+	require.Equal(t, []any{"admins"}, entry["allowed_groups"])
+}
