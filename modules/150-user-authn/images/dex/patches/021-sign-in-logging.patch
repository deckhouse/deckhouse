+package github
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/dexidp/dex/connector"
+)
+
+func TestGroupsForOrgsNotInRequiredOrgs(t *testing.T) {
+	// The membership check answers 404: the user is in none of the orgs.
+	s := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+	}))
+	defer s.Close()
+
+	c := githubConnector{
+		apiURL: s.URL,
+		orgs:   []Org{{Name: "org-1"}, {Name: "org-2", Teams: []string{"admins", "sre"}}},
+		logger: slog.New(slog.DiscardHandler),
+	}
+	_, err := c.groupsForOrgs(context.Background(), newClient(), "jdoe")
+
+	var groupsErr *connector.UserNotInRequiredGroupsError
+	if !errors.As(err, &groupsErr) {
+		t.Fatalf("want *connector.UserNotInRequiredGroupsError, got %T: %v", err, err)
+	}
+	expectEquals(t, err.Error(), "user not a member of allowed groups")
+	expectEquals(t, groupsErr.PreferredUsername, "jdoe")
+	if groupsErr.UserGroups != nil {
+		t.Errorf("the org membership check does not list the user's groups, want nil, got %v", groupsErr.UserGroups)
+	}
+	expectEquals(t, groupsErr.Groups, []string{"org-1", "org-2:admins", "org-2:sre"})
+
+	got, ok := connector.AsUserNotInRequiredGroups(err, connector.Identity{UserID: "42", Username: "Jane Doe", PreferredUsername: "ignored", Email: "jdoe@example.com"})
+	if !ok {
+		t.Fatal("AsUserNotInRequiredGroups: want ok")
+	}
+	expectEquals(t, got.UserID, "42")
+	expectEquals(t, got.Username, "Jane Doe")
+	expectEquals(t, got.PreferredUsername, "jdoe")
+	expectEquals(t, got.Email, "jdoe@example.com")
+}
