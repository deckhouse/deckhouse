@@ -0,0 +1,56 @@
+package connector
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"log/slog"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestUserNotInRequiredGroupsErrorLogAttrs(t *testing.T) {
+	err := &UserNotInRequiredGroupsError{
+		UserID:            "0f2c\n{\"level\":\"INFO\"}",
+		Username:          "Jane Doe",
+		PreferredUsername: "jdoe",
+		Email:             "jdoe@example.com",
+		UserGroups:        []string{"developers", "qa"},
+		Groups:            []string{"admins"},
+	}
+
+	var buf bytes.Buffer
+	logger := slog.New(slog.NewJSONHandler(&buf, nil))
+	logger.ErrorContext(context.Background(), "failed to authenticate", append([]any{"err", err}, err.LogAttrs()...)...)
+
+	var got map[string]any
+	require.NoError(t, json.Unmarshal(buf.Bytes(), &got), "one JSON line: %s", buf.String())
+	require.Equal(t, "user not a member of allowed groups", got["err"])
+	require.Equal(t, `0f2c{"level":"INFO"}`, got["user_id"], "control characters are dropped")
+	require.Equal(t, "Jane Doe", got["username"])
+	require.Equal(t, "jdoe", got["preferred_username"])
+	require.Equal(t, "jdoe@example.com", got["email"])
+	require.Equal(t, []any{"developers", "qa"}, got["user_groups"])
+	require.EqualValues(t, 2, got["user_groups_count"])
+	require.Equal(t, []any{"admins"}, got["allowed_groups"])
+}
+
+func TestUserNotInRequiredGroupsErrorGroupsKnownOrNot(t *testing.T) {
+	logged := func(err *UserNotInRequiredGroupsError) map[string]any {
+		var buf bytes.Buffer
+		slog.New(slog.NewJSONHandler(&buf, nil)).Error("x", err.LogAttrs()...)
+		var got map[string]any
+		require.NoError(t, json.Unmarshal(buf.Bytes(), &got))
+		return got
+	}
+
+	fetched := logged(&UserNotInRequiredGroupsError{UserID: "u", UserGroups: FetchedGroups(nil), Groups: []string{"admins"}})
+	require.Equal(t, []any{}, fetched["user_groups"], "fetched and empty is logged as [], not null")
+	require.EqualValues(t, 0, fetched["user_groups_count"])
+
+	unknown := logged(&UserNotInRequiredGroupsError{UserID: "u", Groups: []string{"admins"}})
+	require.NotContains(t, unknown, "user_groups", "groups the connector did not fetch are not logged as none")
+	require.NotContains(t, unknown, "user_groups_count")
+	require.Equal(t, []any{"admins"}, unknown["allowed_groups"])
+}
