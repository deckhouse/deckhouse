@@ -0,0 +1,71 @@
+package oidc
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector"
+)
+
+// TestHandleCallbackNotInAllowedGroups checks that a refused user comes back
+// as a typed error that names the user, so the server can log who was refused.
+func TestHandleCallbackNotInAllowedGroups(t *testing.T) {
+	tests := []struct {
+		name        string
+		groupsRegex string
+		wantGroups  []string
+	}{
+		{name: "groups as returned", wantGroups: []string{"developers", "qa"}},
+		{name: "groups after groupsFilter", groupsRegex: "^dev", wantGroups: []string{"developers"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			testServer, err := setupServer(map[string]interface{}{
+				"sub":                "subvalue",
+				"name":               "namevalue",
+				"preferred_username": "jdoe",
+				"email":              "jdoe@example.com",
+				"email_verified":     true,
+				"groups":             []string{"developers", "qa"},
+			}, true)
+			require.NoError(t, err)
+			defer testServer.Close()
+
+			basicAuth := true
+			config := Config{
+				Issuer:               testServer.URL,
+				ClientID:             "clientID",
+				ClientSecret:         "clientSecret",
+				Scopes:               []string{"email", "groups"},
+				RedirectURI:          fmt.Sprintf("%s/callback", testServer.URL),
+				InsecureEnableGroups: true,
+				BasicAuthUnsupported: &basicAuth,
+				AllowedGroups:        []string{"admins", "security"},
+			}
+			config.ClaimMutations.FilterGroupClaims.GroupsFilter = tt.groupsRegex
+			conn, err := newConnector(config)
+			require.NoError(t, err)
+
+			req, err := newRequestWithAuthCode(testServer.URL, "someCode")
+			require.NoError(t, err)
+
+			_, err = conn.HandleCallback(connector.Scopes{Groups: true}, req)
+			require.Error(t, err)
+			require.Equal(t, "user not a member of allowed groups", err.Error())
+
+			var groupsErr *connector.UserNotInRequiredGroupsError
+			require.True(t, errors.As(err, &groupsErr), "got %T: %v", err, err)
+			require.Equal(t, &connector.UserNotInRequiredGroupsError{
+				UserID:            "subvalue",
+				Username:          "namevalue",
+				PreferredUsername: "jdoe",
+				Email:             "jdoe@example.com",
+				UserGroups:        tt.wantGroups,
+				Groups:            []string{"admins", "security"},
+			}, groupsErr)
+		})
+	}
+}
