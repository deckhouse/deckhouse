+func TestNotAllowedErrorLogsNamesAndKnownEmptyGroups(t *testing.T) {
+	claims := storage.Claims{UserID: "sub-1", Username: "Jane Doe", PreferredUsername: "jdoe"}
+	err := applyClientAccessFilters(storage.Client{ID: "app", AllowedGroups: []string{"admins"}}, &claims)
+
+	var nae *NotAllowedError
