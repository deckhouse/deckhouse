+func TestGetCanceledWaiterDoesNotCancelOpen(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx := t.Context()
+		store := memory.New(slog.New(slog.DiscardHandler))
+		require.NoError(t, store.CreateConnector(ctx, storage.Connector{ID: "c1", ResourceVersion: "1"}))
+		release := make(chan struct{})
+		var calls atomic.Int32
+		cache := NewCache(store, func(c storage.Connector) (connector.Connector, error) {
+			calls.Add(1)
+			<-release
+			return stubConn{version: c.ResourceVersion}, nil
+		})
+		requestCtx, cancel := context.WithCancel(ctx)
+		canceled := make(chan error, 1)
+		go func() {
+			_, err := cache.Get(requestCtx, "c1")
+			canceled <- err
+		}()
+		synctest.Wait()
+		done := make(chan error, 1)
+		go func() {
+			_, err := cache.Get(ctx, "c1")
+			done <- err
+		}()
+		synctest.Wait()
+		cancel()
+		require.ErrorIs(t, <-canceled, context.Canceled)
+		close(release)
+		require.NoError(t, <-done)
+		require.EqualValues(t, 1, calls.Load())
+		_, err := cache.Get(ctx, "c1")
+		require.NoError(t, err)
+		require.EqualValues(t, 1, calls.Load())
+	})
+}
