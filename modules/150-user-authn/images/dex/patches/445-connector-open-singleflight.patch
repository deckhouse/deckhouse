+func TestGetDeduplicatesOpen(t *testing.T) {
+	for _, tt := range []struct {
+		name          string
+		cachedVersion string
+		fails         bool
+	}{
+		{name: "missing"},
+		{name: "changed", cachedVersion: "1"},
+		{name: "missing unavailable", fails: true},
+		{name: "changed unavailable", cachedVersion: "1", fails: true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				ctx := t.Context()
+				store := memory.New(slog.New(slog.DiscardHandler))
+				require.NoError(t, store.CreateConnector(ctx, storage.Connector{ID: "c1", ResourceVersion: "2"}))
+				release := make(chan struct{})
+				var calls atomic.Int32
+				var openErr error
+				if tt.fails {
+					openErr = errors.New("issuer unavailable")
+				}
+				cache := NewCache(store, func(c storage.Connector) (connector.Connector, error) {
+					calls.Add(1)
+					<-release
+					return stubConn{version: c.ResourceVersion}, openErr
+				})
+				if tt.cachedVersion != "" {
+					cache.Set("c1", Connector{ResourceVersion: tt.cachedVersion})
+				}
+
+				type result struct {
+					conn Connector
+					err  error
+				}
+				const requests = 16
+				results := make(chan result, requests)
+				for range requests {
+					go func() {
+						conn, err := cache.Get(ctx, "c1")
+						results <- result{conn: conn, err: err}
+					}()
+				}
+				synctest.Wait()
+				concurrentCalls := calls.Load()
+				close(release)
+				for range requests {
+					got := <-results
+					if tt.fails {
+						require.ErrorIs(t, got.err, ErrConnectorUnavailable)
+						continue
+					}
+					require.NoError(t, got.err)
+					require.Equal(t, "2", got.conn.ResourceVersion)
+				}
+				require.EqualValues(t, 1, concurrentCalls, "concurrent requests must share one open attempt")
+
+				// A failed attempt is retried by the next request; a successful one is cached.
+				openErr = nil
+				got, err := cache.Get(ctx, "c1")
+				require.NoError(t, err)
+				require.Equal(t, "2", got.ResourceVersion)
+				wantCalls := int32(1)
+				if tt.fails {
+					wantCalls = 2
+				}
+				require.Equal(t, wantCalls, calls.Load())
+			})
+		})
+	}
+}
