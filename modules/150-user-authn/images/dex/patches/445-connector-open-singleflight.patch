+func TestGetOpeningDoesNotBlockOtherConnectors(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx := t.Context()
+		store := memory.New(slog.New(slog.DiscardHandler))
+		for _, id := range []string{"slow", "fast"} {
+			require.NoError(t, store.CreateConnector(ctx, storage.Connector{ID: id, ResourceVersion: "1"}))
+		}
+		release := make(chan struct{})
+		cache := NewCache(store, func(c storage.Connector) (connector.Connector, error) {
+			if c.ID == "slow" {
+				<-release
+			}
+			return stubConn{version: c.ResourceVersion}, nil
+		})
+		done := make(chan error, 1)
+		go func() {
+			_, err := cache.Get(ctx, "slow")
+			done <- err
+		}()
+		synctest.Wait()
+		_, err := cache.Get(ctx, "fast")
+		close(release)
+		require.NoError(t, err)
+		require.NoError(t, <-done)
+	})
+}
+
+func TestGetChangedVersionWhileOpening(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx := t.Context()
+		store := memory.New(slog.New(slog.DiscardHandler))
+		require.NoError(t, store.CreateConnector(ctx, storage.Connector{ID: "c1", ResourceVersion: "1"}))
+		release := make(chan struct{})
+		cache := NewCache(store, func(c storage.Connector) (connector.Connector, error) {
+			if c.ResourceVersion == "1" {
+				<-release
+				return nil, errors.New("issuer unavailable")
+			}
+			return stubConn{version: c.ResourceVersion}, nil
+		})
+		done := make(chan error, 1)
+		go func() {
+			_, err := cache.Get(ctx, "c1")
+			done <- err
+		}()
+		synctest.Wait()
+		require.NoError(t, store.UpdateConnector(ctx, "c1", func(c storage.Connector) (storage.Connector, error) {
+			c.ResourceVersion = "2"
+			return c, nil
+		}))
+		got, err := cache.Get(ctx, "c1")
+		close(release)
+		require.NoError(t, err)
+		require.Equal(t, "2", got.ResourceVersion)
+		require.ErrorIs(t, <-done, ErrConnectorUnavailable)
+	})
+}
