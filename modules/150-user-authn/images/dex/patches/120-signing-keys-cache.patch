+++ b/server/signer/keys_cache_test.go
@@ -0,0 +1,121 @@
+package signer
+
+import (
+	"context"
+	"log/slog"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+// keyReads counts the reads of the signing keys.
+type keyReads struct {
+	storage.Storage
+
+	mu    sync.Mutex
+	reads int
+}
+
+func (s *keyReads) GetKeys(ctx context.Context) (storage.Keys, error) {
+	s.mu.Lock()
+	s.reads++
+	s.mu.Unlock()
+	return s.Storage.GetKeys(ctx)
+}
+
+func (s *keyReads) count() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.reads
+}
+
+// The local signer reads the signing keys once until their NextRotation,
+// however many tokens it signs, and again after it.
+func TestLocalSignerReadsKeysOnceUntilRotation(t *testing.T) {
+	logger := slog.New(slog.DiscardHandler)
+	now := time.Date(2026, 11, 13, 12, 0, 0, 0, time.UTC)
+	clock := func() time.Time { return now }
+	s := &keyReads{Storage: memory.New(logger)}
+
+	sig, err := (&LocalConfig{KeysRotationPeriod: "6h"}).Open(t.Context(), s, time.Hour, clock, logger)
+	require.NoError(t, err)
+	local := sig.(*localSigner)
+	require.NoError(t, local.rotator.rotate())
+
+	before := s.count()
+	for range 10 {
+		_, err := sig.Algorithm(t.Context())
+		require.NoError(t, err)
+		_, err = sig.Sign(t.Context(), []byte(`{"sub":"jane"}`))
+		require.NoError(t, err)
+		_, err = sig.ValidationKeys(t.Context())
+		require.NoError(t, err)
+	}
+	require.Equal(t, 1, s.count()-before, "one read for 30 asks")
+
+	keys, err := s.Storage.GetKeys(t.Context())
+	require.NoError(t, err)
+	now = keys.NextRotation
+	before = s.count()
+	_, err = sig.Sign(t.Context(), []byte(`{"sub":"jane"}`))
+	require.NoError(t, err)
+	_, err = sig.Sign(t.Context(), []byte(`{"sub":"jane"}`))
+	require.NoError(t, err)
+	require.Equal(t, 2, s.count()-before, "keys past their rotation are read every time until rotated")
+
+	require.NoError(t, local.rotator.rotate())
+	before = s.count()
+	for range 3 {
+		_, err = sig.Sign(t.Context(), []byte(`{"sub":"jane"}`))
+		require.NoError(t, err)
+	}
+	require.Equal(t, 1, s.count()-before, "the rotated keys are cached again")
+}
+
+// Keys replaced in the storage other than by rotation are served once the
+// rotator looks at them (refresh), not only at NextRotation.
+func TestLocalSignerKeyCacheRefresh(t *testing.T) {
+	logger := slog.New(slog.DiscardHandler)
+	now := time.Date(2026, 11, 13, 12, 0, 0, 0, time.UTC)
+	clock := func() time.Time { return now }
+	s := &keyReads{Storage: memory.New(logger)}
+
+	sig, err := (&LocalConfig{KeysRotationPeriod: "6h"}).Open(t.Context(), s, time.Hour, clock, logger)
+	require.NoError(t, err)
+	local := sig.(*localSigner)
+	require.NoError(t, local.rotator.rotate())
+	first, err := sig.ValidationKeys(t.Context())
+	require.NoError(t, err)
+
+	// Another replica replaced the keys: the object was deleted and created anew.
+	other := &keyRotator{s.Storage, local.rotator.strategy, func() time.Time { return now.Add(7 * time.Hour) }, logger}
+	require.NoError(t, other.rotate())
+
+	cached, err := sig.ValidationKeys(t.Context())
+	require.NoError(t, err)
+	require.Equal(t, first, cached, "served from the cache until refreshed")
+
+	local.keys.refresh(t.Context())
+	refreshed, err := sig.ValidationKeys(t.Context())
+	require.NoError(t, err)
+	require.NotEqual(t, first[0].KeyID, refreshed[0].KeyID, "the refresh serves the keys of the storage")
+}
+
+// A failed read is not cached: the next ask reads again.
+func TestLocalSignerKeyCacheMissing(t *testing.T) {
+	logger := slog.New(slog.DiscardHandler)
+	s := &keyReads{Storage: memory.New(logger)}
+	sig, err := (&LocalConfig{KeysRotationPeriod: "6h"}).Open(t.Context(), s, time.Hour, time.Now, logger)
+	require.NoError(t, err)
+
+	_, err = sig.Sign(t.Context(), []byte(`{}`))
+	require.Error(t, err)
+	_, err = sig.Sign(t.Context(), []byte(`{}`))
+	require.Error(t, err)
+	require.Equal(t, 2, s.count())
+}
