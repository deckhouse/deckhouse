@@ -0,0 +1,90 @@
+package server
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/signer"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/storage"
+)
+
+// signingKeyReads counts the reads of the signing keys.
+type signingKeyReads struct {
+	storage.Storage
+
+	mu    sync.Mutex
+	reads int
+}
+
+func (s *signingKeyReads) GetKeys(ctx context.Context) (storage.Keys, error) {
+	s.mu.Lock()
+	s.reads++
+	s.mu.Unlock()
+	return s.Storage.GetKeys(ctx)
+}
+
+func (s *signingKeyReads) count() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.reads
+}
+
+// A login and a refresh issue an ID token and an access token each, and the
+// local signer asks for the signing keys twice per token. With the keys cached
+// until their rotation (Deckhouse) neither reads them from the storage: the
+// Kubernetes storage made it four reads of the API server per token request.
+func TestTokenRequestsReadNoSigningKeys(t *testing.T) {
+	var keys *signingKeyReads
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.PasswordConnector = "test"
+		c.Now = time.Now
+		// Refreshes inside the reuse interval do not ask the connector, which the
+		// memory storage serves without a transaction inside another: the test
+		// counts what signing reads, which every refresh does.
+		c.RefreshTokenPolicy = tokens.NewRefreshStrategy(false, 0, 0, time.Hour, time.Now)
+		keys = &signingKeyReads{Storage: c.Storage}
+		sig, err := (&signer.LocalConfig{KeysRotationPeriod: "6h"}).Open(t.Context(), keys, time.Hour, time.Now, slog.New(slog.DiscardHandler))
+		require.NoError(t, err)
+		sig.Start(t.Context())
+		c.Signer = sig
+	})
+	defer httpServer.Close()
+	mockConnectorDataTestStorage(t, s.storage)
+
+	post := func(form url.Values) map[string]any {
+		t.Helper()
+		req := httptest.NewRequest(http.MethodPost, s.issuerURL.String()+"/token", bytes.NewBufferString(form.Encode()))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		req.SetBasicAuth("test", "barfoo")
+		rr := httptest.NewRecorder()
+		s.ServeHTTP(rr, req)
+		require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+		var resp map[string]any
+		require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &resp))
+		return resp
+	}
+
+	before := keys.count()
+	login := post(url.Values{"grant_type": {"password"}, "scope": {"openid email offline_access"}, "username": {"test"}, "password": {"test"}})
+	require.Zero(t, keys.count()-before, "a login reads no signing keys")
+
+	refreshToken, _ := login["refresh_token"].(string)
+	require.NotEmpty(t, refreshToken)
+	before = keys.count()
+	for range 3 {
+		resp := post(url.Values{"grant_type": {"refresh_token"}, "refresh_token": {refreshToken}})
+		refreshToken, _ = resp["refresh_token"].(string)
+	}
+	require.Zero(t, keys.count()-before, "a refresh reads no signing keys")
+}
