--- /dev/null
+++ b/server/signer/keys_cache.go
@@ -0,0 +1,65 @@
+package signer
+
+import (
+	"context"
+	"sync/atomic"
+	"time"
+
+	"github.com/dexidp/dex/storage"
+)
+
+// keyCache serves the signing keys of the local signer from memory until their
+// NextRotation (Deckhouse). Every token issued asks for them twice, for the
+// algorithm and for the signature, and without the cache each ask was a read
+// of the storage: four reads of the signing keys object from the Kubernetes
+// API for each refresh and each login. The server cached them the same way
+// before the signer took signing over from it (Dex v2.45).
+//
+// The keys of a storage change only by rotation, at NextRotation, which ends
+// the cache. The rotator of the signer refreshes the cache every time it looks
+// at the keys, every 30 seconds, so keys replaced otherwise (the object deleted
+// and created anew by another replica) are served within that time.
+type keyCache struct {
+	storage storage.Storage
+	now     func() time.Time
+
+	keys atomic.Pointer[storage.Keys]
+}
+
+func newKeyCache(s storage.Storage, now func() time.Time) *keyCache {
+	if now == nil {
+		now = time.Now
+	}
+	return &keyCache{storage: s, now: now}
+}
+
+// get returns the keys, from memory while they are before their NextRotation.
+func (c *keyCache) get(ctx context.Context) (storage.Keys, error) {
+	if keys := c.keys.Load(); keys != nil && c.now().Before(keys.NextRotation) {
+		return *keys, nil
+	}
+	keys, err := c.storage.GetKeys(ctx)
+	if err != nil {
+		return keys, err
+	}
+	c.keep(keys)
+	return keys, nil
+}
+
+// refresh reads the keys from the storage and keeps them. A failed read keeps
+// what the cache has: it still ends at NextRotation.
+func (c *keyCache) refresh(ctx context.Context) {
+	keys, err := c.storage.GetKeys(ctx)
+	if err != nil {
+		return
+	}
+	c.keep(keys)
+}
+
+func (c *keyCache) keep(keys storage.Keys) {
+	if !c.now().Before(keys.NextRotation) {
+		c.keys.Store(nil)
+		return
+	}
+	c.keys.Store(&keys)
+}
diff --git a/server/signer/keys_cache_test.go b/server/signer/keys_cache_test.go
