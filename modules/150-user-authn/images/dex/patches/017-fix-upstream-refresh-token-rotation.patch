+	require.NoError(t, s.storage.CreateOfflineSessions(ctx, storage.OfflineSessions{
+		UserID:        "1",
+		ConnID:        connID,
+		Refresh:       map[string]*storage.RefreshTokenRef{clientID: {ID: refreshID, ClientID: clientID}},
+		ConnectorData: upstream.mint(),
+	}))
