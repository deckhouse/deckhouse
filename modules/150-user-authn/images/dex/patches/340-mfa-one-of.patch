+// A choice of the second factor names a connector type Dex knows, and at least one authenticator of the chain
+// applies to it: a choice among none would let its users in without a factor (Deckhouse patch 340).
+func TestValidateMFAOneOfConnectorTypes(t *testing.T) {
+	authenticators := []MFAAuthenticator{
+		{ID: "totp", Type: "TOTP", ConnectorTypes: []string{"local", "ldap"}},
+		{ID: "webauthn", Type: "WebAuthn", ConnectorTypes: []string{"local"}},
+	}
+	for _, tc := range []struct {
+		name    string
+		oneOf   []string
+		chain   []string
+		wantErr string
+	}{
+		{name: "both apply", oneOf: []string{"local"}, chain: []string{"totp", "webauthn"}},
+		{name: "one applies", oneOf: []string{"ldap"}, chain: []string{"totp", "webauthn"}},
+		{name: "an unknown type", oneOf: []string{"crowd"}, chain: []string{"totp", "webauthn"}, wantErr: "unknown connector type"},
+		{name: "none applies", oneOf: []string{"atlassian-crowd"}, chain: []string{"totp", "webauthn"}, wantErr: "no authenticator"},
+		{name: "none in the chain", oneOf: []string{"ldap"}, chain: []string{"webauthn"}, wantErr: "no authenticator"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := Config{MFA: MFAConfig{Authenticators: authenticators, DefaultMFAChain: tc.chain, OneOfConnectorTypes: tc.oneOf}}
+			err := c.validateMFA()
+			if tc.wantErr != "" {
+				require.ErrorContains(t, err, tc.wantErr)
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
