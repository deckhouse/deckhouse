+// A factor page offers another method only to a user with more than one registered.
+func TestChoiceOtherMethodLink(t *testing.T) {
+	secret, _ := confirmedTOTP(t)
+	both := []string{"totp", "webauthn"}
+	for _, tc := range []struct {
+		name     string
+		choice   bool
+		identity storage.UserIdentity
+		pages    []string
+		want     bool
+	}{
+		{"both registered", true, storage.UserIdentity{MFASecrets: map[string]*storage.MFASecret{"totp": secret}, WebAuthnCredentials: aKey(time.Time{})}, both, true},
+		// The page of the key is closed to this user: registering one is refused.
+		{"only the code", true, storage.UserIdentity{MFASecrets: map[string]*storage.MFASecret{"totp": secret}}, []string{"totp"}, false},
+		{"both, without the choice", false, storage.UserIdentity{MFASecrets: map[string]*storage.MFASecret{"totp": secret}, WebAuthnCredentials: aKey(time.Time{})}, both, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newChoiceFixture(t, tc.choice, tc.identity)
+			for _, id := range tc.pages {
+				rr := f.serve(t, http.MethodGet, f.factorURL(id), nil)
+				require.Equal(t, http.StatusOK, rr.Code, id)
+				require.Equal(t, tc.want, strings.Contains(rr.Body.String(), `id="other-method"`), id)
+			}
+		})
+	}
+}
