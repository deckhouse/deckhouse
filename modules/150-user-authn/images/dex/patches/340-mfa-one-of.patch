+// The browser session records a choice as one entry, so a session of a login that passed one factor does not
+// satisfy a login that asks for both, and the other way round.
+func TestChoiceSessionChain(t *testing.T) {
+	choice := newChoiceFixture(t, true, storage.UserIdentity{})
+	both := newChoiceFixture(t, false, storage.UserIdentity{})
+
+	oneOf, err := choice.h.ChainForClient(t.Context(), "app", "mock")
+	require.NoError(t, err)
+	require.Equal(t, []string{"totp|webauthn"}, oneOf)
+	all, err := both.h.ChainForClient(t.Context(), "app", "mock")
+	require.NoError(t, err)
+	require.Equal(t, []string{"totp", "webauthn"}, all)
+
+	require.True(t, session.MFASatisfied(storage.AuthSession{MFAAuthenticators: oneOf}, oneOf))
+	require.False(t, session.MFASatisfied(storage.AuthSession{MFAAuthenticators: oneOf}, all))
+	require.False(t, session.MFASatisfied(storage.AuthSession{MFAAuthenticators: all}, oneOf))
+}
