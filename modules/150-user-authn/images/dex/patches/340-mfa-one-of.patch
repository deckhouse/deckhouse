+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/session"
+	"github.com/dexidp/dex/storage"
+)
+
+// The tests of a choice of the second factor (Deckhouse patch 340). The "mock" connector of the test handler has
+// the type "mockCallback", which the handler lets choose.
+
+const choiceType = "mockCallback"
+
+// staleSecretStorage serves a Get of the identity without its TOTP secrets, while Update still sees them: a
+// request that loaded the account before a parallel one confirmed a code.
+type staleSecretStorage struct {
+	storage.Storage
+}
+
+func (s staleSecretStorage) GetUserIdentity(ctx context.Context, userID, connectorID string) (storage.UserIdentity, error) {
+	u, err := s.Storage.GetUserIdentity(ctx, userID, connectorID)
+	if err != nil {
+		return u, err
+	}
+	u.MFASecrets = map[string]*storage.MFASecret{}
+	return u, nil
+}
+
+type choiceFixture struct {
+	h       *Handler
+	router  http.Handler
+	store   storage.Storage
+	authReq storage.AuthRequest
+	key     *WebAuthnProvider
+}
+
+// newChoiceFixture is a handler with a TOTP and a WebAuthn authenticator, the chain [totp, webauthn], and a
+// signed-in login of user-1 through the "mock" connector; choice turns the choice on for its type. identity is
+// the stored identity of the user, without the user and connector IDs.
+func newChoiceFixture(t *testing.T, choice bool, identity storage.UserIdentity) choiceFixture {
+	t.Helper()
+	key, err := NewWebAuthnProvider("Test", "", nil, "", "", "http://localhost", nil)
+	require.NoError(t, err)
+	h, router, store := newTestHandler(t,
+		map[string]Provider{"totp": NewTOTPProvider("test-issuer", nil), "webauthn": key},
+		[]string{"totp", "webauthn"},
+	)
+	if choice {
+		h.OneOfConnectorTypes = []string{choiceType}
+	}
+	authReq := storage.AuthRequest{
+		ID: "choice-req", ClientID: "app", Expiry: time.Now().Add(time.Hour),
+		HMACKey: randomHMACKey(t), LoggedIn: true,
+		Claims:              storage.Claims{UserID: "user-1", Email: "user@example.com"},
+		ConnectorID:         "mock",
+		WebAuthnSessionData: []byte(`{}`),
+	}
+	ctx := t.Context()
+	require.NoError(t, store.CreateAuthRequest(ctx, authReq))
+	require.NoError(t, store.CreateClient(ctx, storage.Client{ID: "app", Secret: "s"}))
+	identity.UserID, identity.ConnectorID, identity.Claims = "user-1", "mock", authReq.Claims
+	require.NoError(t, store.CreateUserIdentity(ctx, identity))
+	return choiceFixture{h: h, router: router, store: store, authReq: authReq, key: key}
+}
+
+func (f choiceFixture) serve(t *testing.T, method, target string, form url.Values) *httptest.ResponseRecorder {
+	t.Helper()
+	var req *http.Request
+	if form != nil {
+		req = httptest.NewRequest(method, target, strings.NewReader(form.Encode()))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	} else {
+		req = httptest.NewRequest(method, target, nil)
+	}
+	rr := httptest.NewRecorder()
+	f.router.ServeHTTP(rr, req)
+	return rr
+}
+
+func (f choiceFixture) entry(t *testing.T, choose bool) *httptest.ResponseRecorder {
+	t.Helper()
+	extra := url.Values{}
+	if choose {
+		extra.Set("choose", "1")
+	}
+	return f.serve(t, http.MethodGet, internal.StepURL("/mfa", f.authReq, internal.StepMFA, extra), nil)
+}
+
+func (f choiceFixture) factorURL(id string) string {
+	return f.h.buildRedirectURL(f.authReq, id)
+}
+
+func (f choiceFixture) identity(t *testing.T) storage.UserIdentity {
+	t.Helper()
+	ident, err := f.store.GetUserIdentity(t.Context(), "user-1", "mock")
+	require.NoError(t, err)
+	return ident
+}
+
+func (f choiceFixture) validated(t *testing.T) bool {
+	t.Helper()
+	got, err := f.store.GetAuthRequest(t.Context(), f.authReq.ID)
+	require.NoError(t, err)
+	return got.MFAValidated
+}
+
+func confirmedTOTP(t *testing.T) (*storage.MFASecret, string) {
+	t.Helper()
+	k, err := totp.Generate(totp.GenerateOpts{Issuer: "test-issuer", AccountName: "user@example.com"})
+	require.NoError(t, err)
+	return &storage.MFASecret{AuthenticatorID: "totp", Type: "TOTP", Secret: k.String(), Confirmed: true}, k.Secret()
+}
+
+func unconfirmedTOTP(t *testing.T) (*storage.MFASecret, string) {
+	t.Helper()
+	s, code := confirmedTOTP(t)
+	s.Confirmed = false
+	return s, code
+}
+
+func aKey(lastUsed time.Time) map[string][]storage.WebAuthnCredential {
+	return map[string][]storage.WebAuthnCredential{"webauthn": {{CredentialID: []byte("cred"), PublicKey: []byte("pk"), LastUsedAt: lastUsed}}}
+}
+
+// The entry: nothing registered offers both methods to register, one registered goes to it (asked to choose or
+// not), both registered go to the one used last and offer the other on request.
+func TestChoiceEntry(t *testing.T) {
+	secret, _ := confirmedTOTP(t)
+	recent := time.Now().Add(-time.Minute)
+
+	t.Run("nothing registered: the choice of a method to register", func(t *testing.T) {
+		f := newChoiceFixture(t, true, storage.UserIdentity{})
