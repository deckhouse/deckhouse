+// A user with one method registered cannot register the other through a signed address of it: the TOTP page
+// shows no secret, a code for an unconfirmed secret is refused, and the key registration answers 403. The login
+// is not validated.
+func TestChoiceRefusesTheRegistrationOfASecondMethod(t *testing.T) {
+	t.Run("TOTP page with a key registered", func(t *testing.T) {
+		f := newChoiceFixture(t, true, storage.UserIdentity{WebAuthnCredentials: aKey(time.Time{})})
+		rr := f.serve(t, http.MethodGet, f.factorURL("totp"), nil)
+		require.Equal(t, http.StatusForbidden, rr.Code)
+		require.NotContains(t, rr.Body.String(), "data:image/png")
+		require.Nil(t, f.identity(t).MFASecrets["totp"], "a secret was created")
+	})
+
+	t.Run("a code for an unconfirmed secret with a key registered", func(t *testing.T) {
+		pending, raw := unconfirmedTOTP(t)
+		f := newChoiceFixture(t, true, storage.UserIdentity{
+			MFASecrets: map[string]*storage.MFASecret{"totp": pending}, WebAuthnCredentials: aKey(time.Time{}),
+		})
+		code, err := totp.GenerateCode(raw, time.Now())
+		require.NoError(t, err)
+		rr := f.serve(t, http.MethodPost, f.factorURL("totp"), url.Values{"totp": {code}})
+		require.Equal(t, http.StatusForbidden, rr.Code)
+		require.False(t, f.identity(t).MFASecrets["totp"].Confirmed)
+		require.False(t, f.validated(t))
+	})
+
+	// The request loaded the identity before a key was stored: the check inside the update refuses.
+	t.Run("a code confirmed after a key was stored", func(t *testing.T) {
+		pending, raw := unconfirmedTOTP(t)
+		f := newChoiceFixture(t, true, storage.UserIdentity{
+			MFASecrets: map[string]*storage.MFASecret{"totp": pending}, WebAuthnCredentials: aKey(time.Time{}),
+		})
+		f.h.Storage = staleIdentityStorage{Storage: f.store}
+		code, err := totp.GenerateCode(raw, time.Now())
+		require.NoError(t, err)
+		rr := f.serve(t, http.MethodPost, f.factorURL("totp"), url.Values{"totp": {code}})
+		require.Equal(t, http.StatusForbidden, rr.Code)
+		require.False(t, f.identity(t).MFASecrets["totp"].Confirmed)
+		require.False(t, f.validated(t))
+	})
+
+	for _, step := range []string{"begin", "finish"} {
+		t.Run("key registration "+step+" with a confirmed code", func(t *testing.T) {
+			secret, _ := confirmedTOTP(t)
+			f := newChoiceFixture(t, true, storage.UserIdentity{MFASecrets: map[string]*storage.MFASecret{"totp": secret}})
+			ceremony := false
+			f.key.finishRegistration = func(webauthn.User, webauthn.SessionData, *http.Request) (*webauthn.Credential, error) {
+				ceremony = true
+				return &webauthn.Credential{ID: []byte("attacker")}, nil
+			}
+			rr := f.serve(t, http.MethodPost, strings.Replace(f.factorURL("webauthn"), "/mfa/webauthn?", "/mfa/webauthn/register/"+step+"?", 1), nil)
+			require.Equal(t, http.StatusForbidden, rr.Code)
+			require.False(t, ceremony, "the registration ran before the refusal")
+			require.Empty(t, f.identity(t).WebAuthnCredentials["webauthn"])
+			require.False(t, f.validated(t))
+		})
+	}
+
+	t.Run("key registration finish after a code was confirmed", func(t *testing.T) {
+		secret, _ := confirmedTOTP(t)
+		f := newChoiceFixture(t, true, storage.UserIdentity{MFASecrets: map[string]*storage.MFASecret{"totp": secret}})
+		f.h.Storage = staleSecretStorage{Storage: f.store}
+		f.key.finishRegistration = func(webauthn.User, webauthn.SessionData, *http.Request) (*webauthn.Credential, error) {
+			return &webauthn.Credential{ID: []byte("attacker")}, nil
+		}
+		rr := f.serve(t, http.MethodPost, strings.Replace(f.factorURL("webauthn"), "/mfa/webauthn?", "/mfa/webauthn/register/finish?", 1), nil)
+		require.Equal(t, http.StatusForbidden, rr.Code)
+		require.Empty(t, f.identity(t).WebAuthnCredentials["webauthn"])
+		require.False(t, f.validated(t))
+	})
+
+	t.Run("key page with a confirmed code", func(t *testing.T) {
+		secret, _ := confirmedTOTP(t)
+		f := newChoiceFixture(t, true, storage.UserIdentity{MFASecrets: map[string]*storage.MFASecret{"totp": secret}})
+		rr := f.serve(t, http.MethodGet, f.factorURL("webauthn"), nil)
+		require.Equal(t, http.StatusForbidden, rr.Code)
+	})
+
+	// Without the choice the chain asks for both: the second method is registered after the first is passed
+	// (see order.go).
+	t.Run("without the choice the key is registered after the code", func(t *testing.T) {
+		secret, _ := confirmedTOTP(t)
+		f := newChoiceFixture(t, false, storage.UserIdentity{MFASecrets: map[string]*storage.MFASecret{"totp": secret}})
+		require.Equal(t, http.StatusSeeOther, f.serve(t, http.MethodGet, f.factorURL("webauthn"), nil).Code)
+		next, err := f.h.CompleteStep(t.Context(), f.authReq, "totp")
+		require.NoError(t, err)
+		require.Equal(t, http.StatusOK, f.serve(t, http.MethodGet, next, nil).Code)
+	})
+}
