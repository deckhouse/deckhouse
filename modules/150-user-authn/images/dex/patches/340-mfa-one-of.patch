+// With the choice one factor of the chain completes the login, and a factor outside it completes nothing.
+func TestChoiceCompleteStep(t *testing.T) {
+	t.Run("one factor completes the login", func(t *testing.T) {
+		f := newChoiceFixture(t, true, storage.UserIdentity{})
+		next, err := f.h.CompleteStep(t.Context(), f.authReq, "totp")
+		require.NoError(t, err)
+		require.Contains(t, next, "/auth?")
+		require.True(t, f.validated(t))
+	})
+
+	t.Run("without the choice the code leads to the key", func(t *testing.T) {
+		f := newChoiceFixture(t, false, storage.UserIdentity{})
+		next, err := f.h.CompleteStep(t.Context(), f.authReq, "totp")
+		require.NoError(t, err)
+		require.Contains(t, next, "authenticator=webauthn")
+		require.False(t, f.validated(t))
+	})
+
+	for _, choice := range []bool{false, true} {
+		t.Run("a factor outside the chain", func(t *testing.T) {
+			f := newChoiceFixture(t, choice, storage.UserIdentity{})
+			_, err := f.h.CompleteStep(t.Context(), f.authReq, "other")
+			require.Error(t, err)
+			require.False(t, f.validated(t))
+		})
+	}
+}
