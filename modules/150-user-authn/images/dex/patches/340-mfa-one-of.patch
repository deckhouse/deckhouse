diff --git a/server/mfa/oneof.go b/server/mfa/oneof.go
new file mode 100644
index 00000000..cb469fc4
--- /dev/null
+++ b/server/mfa/oneof.go
@@ -0,0 +1,195 @@
+package mfa
+
+// A choice of the second factor (Deckhouse patch 340). For the connector types of OneOfConnectorTypes a login
+// passes one authenticator of its chain instead of every one: the user registers the method of their choice at
+// the first sign-in, Dex then asks for a registered method, the one used last first, and a user with several
+// registered methods can switch to another. A password alone adds a factor only to an account that has none, and
+// a login passes a factor of its chain:
+//
+//   - a method is registered only while the user has no other one of the connector, in the chain of the login or
+//     not: otherwise a password alone would add a factor of its own to an account protected by another one, also
+//     through a client that names a chain of its own. The check is repeated when the registration is written;
+//   - the choice offers the registered methods only, through addresses signed for the sign-in;
+//   - a factor completes the login only when it is in the chain of the login.
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"slices"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/templates"
+	"github.com/dexidp/dex/storage"
+)
+
+// oneOfSeparator joins the authenticators of a one-of chain into the single entry the browser session records
+// (see ChainForClient): one passed factor of the group satisfies it, and the entry never matches the chain of
+// a login that asks for every factor.
+const oneOfSeparator = "|"
+
+// errEnrollmentClosed is returned from an UpdateUserIdentity closure when the user registered another method of
+// a one-of chain after the request had loaded the identity.
+var errEnrollmentClosed = errors.New("another method of the second factor is registered")
+
+// enrollmentClosedMsg is what a user sees when a registration is refused: another method is registered.
+const enrollmentClosedMsg = "Another method of the second factor is registered for your account. Sign in with it."
+
+// resolvedChain is the chain of a login: the authenticators that apply to its connector, in the order of the
+// chain, and whether the user passes one of them instead of every one.
+type resolvedChain struct {
+	chain []string
+	oneOf bool
+	// factors are the authenticators that apply to the connector, of the chain or not, sorted.
+	factors []string
+}
+
+// choice reports whether the login lets the user pass one of several authenticators.
+func (c resolvedChain) choice() bool { return c.oneOf && len(c.chain) > 1 }
+
+// choiceChain resolves the chain of the login for the checks of a choice. Without a connector type that lets
+// choose there is nothing to check, and nothing is resolved: the factor endpoints behave as upstream.
+func (h *Handler) choiceChain(ctx context.Context, authReq storage.AuthRequest) (resolvedChain, error) {
+	if len(h.OneOfConnectorTypes) == 0 {
+		return resolvedChain{}, nil
+	}
+	return h.resolveChain(ctx, authReq.ClientID, authReq.ConnectorID)
+}
+
+func (h *Handler) resolveChain(ctx context.Context, clientID, connectorID string) (resolvedChain, error) {
+	chain, err := h.chainForClient(ctx, clientID, connectorID)
+	if err != nil {
+		return resolvedChain{}, err
+	}
+	if len(chain) == 0 {
+		return resolvedChain{chain: chain}, nil
+	}
+	connectorType, err := h.getConnectorType(ctx, connectorID)
+	if err != nil {
+		return resolvedChain{}, err
+	}
+	var factors []string
+	for id, provider := range h.MFAProviders {
+		if provider.EnabledForConnectorType(connectorType) {
+			factors = append(factors, id)
+		}
+	}
+	slices.Sort(factors)
+	return resolvedChain{chain: chain, oneOf: slices.Contains(h.OneOfConnectorTypes, connectorType), factors: factors}, nil
+}
+
+// registeredOf returns the authenticators of chain the user has registered (see hasFactor), the one used last
+// first; without a record of use they keep the order of the chain.
+func (h *Handler) registeredOf(identity storage.UserIdentity, chain []string) []string {
+	var ids []string
+	for _, id := range chain {
+		if h.hasFactor(identity, id) {
+			ids = append(ids, id)
+		}
+	}
+	sort.SliceStable(ids, func(i, j int) bool {
+		return h.lastUsed(identity, ids[i]).After(h.lastUsed(identity, ids[j]))
+	})
+	return ids
+}
+
+// lastUsed is the last time the user passed the authenticator: the time step of the last accepted TOTP code, or
+// the last sign-in with (or the registration of) a WebAuthn credential. Zero when unknown.
+func (h *Handler) lastUsed(identity storage.UserIdentity, authenticatorID string) time.Time {
+	var last time.Time
+	if secret := identity.MFASecrets[authenticatorID]; secret != nil && secret.LastUsedCounter > 0 {
+		last = time.Unix(secret.LastUsedCounter*totpPeriod, 0)
+	}
+	for _, c := range identity.WebAuthnCredentials[authenticatorID] {
+		for _, t := range []time.Time{c.CreatedAt, c.LastUsedAt} {
+			if t.After(last) {
+				last = t
+			}
+		}
+	}
+	return last
+}
+
+// enrollmentClosed reports whether the user may not register authenticatorID: the login lets the user choose,
+// and another authenticator of the connector is registered, of the chain of the login or not.
+func (h *Handler) enrollmentClosed(rc resolvedChain, identity storage.UserIdentity, authenticatorID string) bool {
+	if !rc.choice() {
+		return false
+	}
+	for _, id := range rc.factors {
+		if id != authenticatorID && h.hasFactor(identity, id) {
+			return true
+		}
+	}
+	return false
+}
+
+// chooseURL is the signed address of the choice of a method for the sign-in.
+func (h *Handler) chooseURL(authReq storage.AuthRequest) string {
+	return internal.StepURL(h.IssuerURL.AbsPath("/mfa"), authReq, internal.StepMFA, url.Values{"choose": {"1"}})
+}
+
+// otherMethodURL is the link a factor page offers to another registered method, empty unless the user has more
+// than one.
+func (h *Handler) otherMethodURL(ctx context.Context, mfa *mfaRequestContext) string {
+	rc, err := h.choiceChain(ctx, mfa.authReq)
+	if err != nil || !rc.choice() {
+		return ""
+	}
+	if len(h.registeredOf(mfa.identity, rc.chain)) < 2 {
+		return ""
+	}
+	return h.chooseURL(mfa.authReq)
+}
+
+// routeChoice sends a login that lets the user choose to a factor: to the choice of the method to register when
+// none is registered, to the choice of a registered one when asked to, and to the one used last otherwise.
+func (h *Handler) routeChoice(w http.ResponseWriter, r *http.Request, authReq storage.AuthRequest, chain []string) {
+	ctx := r.Context()
+	identity, err := h.Storage.GetUserIdentity(ctx, authReq.Claims.UserID, authReq.ConnectorID)
+	if err != nil && !errors.Is(err, storage.ErrNotFound) {
+		h.Logger.ErrorContext(ctx, "failed to get user identity", "err", err)
+		h.renderError(r, w, http.StatusInternalServerError, "Database error.")
+		return
+	}
+
+	registered := h.registeredOf(identity, chain)
+	switch {
+	case len(registered) == 0:
+		h.renderChoice(w, r, authReq, chain, true)
+	case r.FormValue("choose") != "" && len(registered) > 1:
+		h.renderChoice(w, r, authReq, registered, false)
+	default:
+		http.Redirect(w, r, h.buildRedirectURL(authReq, registered[0]), http.StatusSeeOther)
+	}
+}
+
+func (h *Handler) renderChoice(w http.ResponseWriter, r *http.Request, authReq storage.AuthRequest, ids []string, enroll bool) {
+	choices := make([]templates.MFAChoice, 0, len(ids))
+	for _, id := range ids {
+		choices = append(choices, templates.MFAChoice{Type: h.MFAProviders[id].Type(), URL: h.buildRedirectURL(authReq, id)})
+	}
+	if err := h.Templates.MFAChoose(r, w, choices, enroll); err != nil {
+		h.Logger.ErrorContext(r.Context(), "server template error", "err", err)
+	}
+}
+
+// sessionChain is the chain the browser session records and checks for a login: a choice is one entry, the
+// authenticators joined, so that a session of a login that passed one of them never satisfies a login that asks
+// for every one.
+func sessionChain(rc resolvedChain) []string {
+	if !rc.choice() {
+		return rc.chain
+	}
+	return []string{strings.Join(rc.chain, oneOfSeparator)}
+}
+
+// notInChainError is the refusal of a factor that is not in the chain of the login.
+func notInChainError(authenticatorID string, chain []string) error {
+	return fmt.Errorf("authenticator %q is not in the MFA chain %v of the login", authenticatorID, chain)
+}
