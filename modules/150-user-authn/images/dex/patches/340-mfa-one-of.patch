+// chainCovers reports whether an authenticator of the default chain applies to the connector type: an authenticator
+// without connector types applies to every one.
+func chainCovers(mfa MFAConfig, connectorType string) bool {
+	for _, authID := range mfa.DefaultMFAChain {
+		for _, auth := range mfa.Authenticators {
+			if auth.ID == authID && (len(auth.ConnectorTypes) == 0 || slices.Contains(auth.ConnectorTypes, connectorType)) {
+				return true
+			}
+		}
+	}
+	return false
+}
