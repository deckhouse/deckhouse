+// narrowLogin stores the client "narrow" with a chain of its own, [totp], and a signed-in login of the user through
+// it.
+func (f choiceFixture) narrowLogin(t *testing.T) storage.AuthRequest {
+	t.Helper()
+	ctx := t.Context()
+	require.NoError(t, f.store.CreateClient(ctx, storage.Client{ID: "narrow", Secret: "s", MFAChain: []string{"totp"}}))
+	authReq := f.authReq
+	authReq.ID, authReq.ClientID = "narrow-req", "narrow"
+	require.NoError(t, f.store.CreateAuthRequest(ctx, authReq))
+	return authReq
+}
+
+// A client may name a chain of its own. Through it a password alone registers no factor for a user who has one
+// outside that chain: with the choice the new factor would pass a login of the default chain by itself. The login
+// cannot pass the factor the user has, so the registration is refused, with the choice or without it.
+func TestChoiceRefusesAFactorThroughAClientOfItsOwnChain(t *testing.T) {
+	for _, choice := range []bool{true, false} {
+		t.Run("choice="+map[bool]string{false: "no", true: "yes"}[choice], func(t *testing.T) {
+			f := newChoiceFixture(t, choice, storage.UserIdentity{WebAuthnCredentials: aKey(time.Time{})})
+			narrow := f.narrowLogin(t)
+			rr := f.serve(t, http.MethodGet, f.h.buildRedirectURL(narrow, "totp"), nil)
+			require.Equal(t, http.StatusForbidden, rr.Code)
+			require.NotContains(t, rr.Body.String(), "data:image/png")
+			require.Nil(t, f.identity(t).MFASecrets["totp"], "a secret was created")
+
+			// A secret left unconfirmed is not confirmed through the client either, and its code does not pass the
+			// login of the default chain.
+			pending, raw := unconfirmedTOTP(t)
+			ident := f.identity(t)
+			ident.MFASecrets = map[string]*storage.MFASecret{"totp": pending}
+			require.NoError(t, f.store.UpdateUserIdentity(t.Context(), "user-1", "mock", func(storage.UserIdentity) (storage.UserIdentity, error) {
+				return ident, nil
+			}))
+			code, err := totp.GenerateCode(raw, time.Now())
+			require.NoError(t, err)
+			rr = f.serve(t, http.MethodPost, f.h.buildRedirectURL(narrow, "totp"), url.Values{"totp": {code}})
+			require.Equal(t, http.StatusForbidden, rr.Code)
+			require.False(t, f.identity(t).MFASecrets["totp"].Confirmed)
+
+			f.serve(t, http.MethodPost, f.factorURL("totp"), url.Values{"totp": {code}})
+			require.False(t, f.identity(t).MFASecrets["totp"].Confirmed)
+			require.False(t, f.validated(t))
+		})
+	}
+
+	// A key of an authenticator that no longer applies to the connector type is no factor of the connector: the
+	// user registers the code.
+	t.Run("a key of another connector type", func(t *testing.T) {
+		f := newChoiceFixture(t, true, storage.UserIdentity{WebAuthnCredentials: aKey(time.Time{})})
+		other, err := NewWebAuthnProvider("Test", "", nil, "", "", "http://localhost", []string{"ldap"})
+		require.NoError(t, err)
+		f.h.MFAProviders["webauthn"] = other
+		rr := f.serve(t, http.MethodGet, f.h.buildRedirectURL(f.narrowLogin(t), "totp"), nil)
+		require.Equal(t, http.StatusOK, rr.Code)
+		require.NotNil(t, f.identity(t).MFASecrets["totp"])
+	})
+}
