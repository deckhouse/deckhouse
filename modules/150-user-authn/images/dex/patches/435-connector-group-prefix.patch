+// TestApplyGroupPrefix shows that the lists of the client and of the connector compare the groups with the prefix,
+// that the groups come out with it, and that applying it to the groups of a refresh token changes nothing.
+func TestApplyGroupPrefix(t *testing.T) {
+	ctx := t.Context()
+	s := storage.WithStaticConnectors(memory.New(slog.New(slog.DiscardHandler)), []storage.Connector{
+		{ID: "corp", Type: "mock", Name: "Corp", GroupPrefix: "corp:", AllowedGroups: []string{"corp:staff", "corp:admins"}},
+		{ID: "system", Type: "mock", Name: "System", GroupPrefix: "system:"},
+	})
+
+	tests := []struct {
+		name           string
+		client         storage.Client
+		connectorID    string
+		groups         []string
+		expectedGroups []string
+		expectedRule   Rule
+		expectedUser   []string
+		expectedList   []string
+	}{
+		{
+			name:           "the connector list names the groups with the prefix",
+			connectorID:    "corp",
+			groups:         []string{"staff", "guests"},
+			expectedGroups: []string{"corp:staff"},
+		},
+		{
+			name:         "a connector list of the names without the prefix admits nothing",
+			connectorID:  "corp",
+			groups:       []string{"guests"},
+			expectedRule: ConnectorGroups,
+			expectedUser: []string{"corp:guests"},
+			expectedList: []string{"corp:staff", "corp:admins"},
+		},
+		{
+			name:           "the client list names the groups with the prefix",
+			client:         storage.Client{ID: "app", AllowedGroups: []string{"corp:admins"}},
+			connectorID:    "corp",
+			groups:         []string{"staff", "admins"},
+			expectedGroups: []string{"corp:admins"},
+		},
+		{
+			name:         "a client list of the names without the prefix admits nothing",
+			client:       storage.Client{ID: "app", AllowedGroups: []string{"admins"}},
+			connectorID:  "corp",
+			groups:       []string{"staff", "admins"},
+			expectedRule: ClientGroups,
+			expectedUser: []string{"corp:staff", "corp:admins"},
+			expectedList: []string{"admins"},
+		},
+		{
+			name:           "groups that carry the prefix already are the same after it",
+			connectorID:    "corp",
+			groups:         []string{"corp:staff", "admins"},
+			expectedGroups: []string{"corp:staff", "corp:admins"},
+		},
+		{
+			name:         "a prefix of a reserved name is refused",
+			connectorID:  "system",
+			groups:       []string{"masters"},
+			expectedRule: ReservedPrefix,
+		},
+	}
+	// The reserved prefixes are set once for the process, as at startup.
+	SetReservedPrefixes([]string{"system:"})
+	t.Cleanup(func() { SetReservedPrefixes(nil) })
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			claims := storage.Claims{UserID: "ann", Email: "ann@corp.example", Groups: append([]string(nil), tc.groups...)}
+
+			err := Apply(ctx, s, tc.client, tc.connectorID, &claims)
+			if tc.expectedRule == "" {
+				require.NoError(t, err)
+				require.Equal(t, tc.expectedGroups, claims.Groups)
+
+				// The groups of a refresh token come back through Apply.
+				again := storage.Claims{UserID: "ann", Email: "ann@corp.example", Groups: slices.Clone(claims.Groups)}
+				require.NoError(t, Apply(ctx, s, tc.client, tc.connectorID, &again))
+				require.Equal(t, claims.Groups, again.Groups)
+				return
+			}
+
+			var notAllowed *NotAllowedError
+			require.ErrorAs(t, err, &notAllowed)
+			require.Equal(t, tc.expectedRule, notAllowed.Rule)
+			require.Equal(t, tc.expectedUser, notAllowed.UserGroups)
+			require.Equal(t, tc.expectedList, notAllowed.AllowedGroups)
+			require.Equal(t, tc.groups, claims.Groups, "a refusal must leave the claims as they were")
+		})
+	}
+}
