+// TestUnmarshalConnectorGroupPrefix reads the prefix a connector puts in front of its groups; a config that
+// dropped it would let the groups of two connectors meet in one name.
+func TestUnmarshalConnectorGroupPrefix(t *testing.T) {
+	rawConfig := []byte(`
+connectors:
+- type: mockCallback
+  id: corp
+  name: Corp
+  groupPrefix: "corp:"
+- type: mockCallback
+  id: other
+  name: Other
+`)
+
+	var c Config
+	require.NoError(t, yaml.Unmarshal(rawConfig, &c))
+	require.Len(t, c.StaticConnectors, 2)
+
+	corp, err := ToStorageConnector(c.StaticConnectors[0])
+	require.NoError(t, err)
+	require.Equal(t, "corp:", corp.GroupPrefix)
+
+	other, err := ToStorageConnector(c.StaticConnectors[1])
+	require.NoError(t, err)
+	require.Empty(t, other.GroupPrefix)
+}
