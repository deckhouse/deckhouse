+// PrefixGroups returns groups with prefix in front of each, or groups as they
+// are for an empty prefix. A group that starts with the prefix keeps its name,
+// and an empty one is dropped, which would otherwise become the prefix alone.
+func PrefixGroups(prefix string, groups []string) []string {
+	if prefix == "" {
+		return groups
+	}
+	out := make([]string, 0, len(groups))
+	for _, g := range groups {
+		switch {
+		case g == "":
+		case strings.HasPrefix(g, prefix):
+			out = append(out, g)
+		default:
+			out = append(out, prefix+g)
+		}
+	}
+	return out
+}
