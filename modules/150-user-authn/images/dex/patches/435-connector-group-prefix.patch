+func TestPrefixGroups(t *testing.T) {
+	tests := []struct {
+		name     string
+		prefix   string
+		groups   []string
+		expected []string
+	}{
+		{name: "no prefix keeps the groups", groups: []string{"admins", "dev"}, expected: []string{"admins", "dev"}},
+		{name: "no prefix keeps nil", expected: nil},
+		{name: "prefix goes in front", prefix: "corp:", groups: []string{"admins", "dev"}, expected: []string{"corp:admins", "corp:dev"}},
+		{name: "a prefixed group keeps its name", prefix: "corp:", groups: []string{"corp:admins", "dev"}, expected: []string{"corp:admins", "corp:dev"}},
+		{name: "twice changes nothing", prefix: "corp:", groups: PrefixGroups("corp:", []string{"admins"}), expected: []string{"corp:admins"}},
+		{name: "an empty group is dropped", prefix: "corp:", groups: []string{"", "dev"}, expected: []string{"corp:dev"}},
+		{name: "no groups stay none", prefix: "corp:", expected: []string{}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			require.Equal(t, tc.expected, PrefixGroups(tc.prefix, tc.groups))
+		})
+	}
+}
