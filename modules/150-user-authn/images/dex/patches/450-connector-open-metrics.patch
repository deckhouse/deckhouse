+// Collect reports completed opening attempts for the current stored versions.
+// Untried versions and deleted connectors have no initialization result.
+func (c *Cache) Collect(ch chan<- prometheus.Metric) {
+	// Collect has no caller context. Concurrent scrapes share one bounded list.
+	result, err, _ := c.listing.Do("connectors", func() (any, error) {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		return c.storage.ListConnectors(ctx)
+	})
+	if err != nil {
+		ch <- prometheus.MustNewConstMetric(connectorCollectionDesc, prometheus.GaugeValue, 0)
+		return
+	}
+	configured := result.([]storage.Connector)
+	ch <- prometheus.MustNewConstMetric(connectorCollectionDesc, prometheus.GaugeValue, 1)
+	for _, conn := range configured {
+		c.mu.Lock()
+		cached, ok := c.conns[conn.ID]
+		failedVersion, failed := c.failed[conn.ID]
+		c.mu.Unlock()
+		opened := 0.0
+		switch {
+		case failed && failedVersion == conn.ResourceVersion:
+		case ok && cached.ResourceVersion == conn.ResourceVersion:
+			opened = 1
+		default:
+			continue
+		}
+		ch <- prometheus.MustNewConstMetric(connectorOpenDesc, prometheus.GaugeValue, opened, conn.ID, conn.Type)
+	}
 }
 
