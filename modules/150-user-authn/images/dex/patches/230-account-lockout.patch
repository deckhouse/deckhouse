diff --git a/server/server_lockout_test.go b/server/server_lockout_test.go
new file mode 100644
index 00000000..92f4ed60
--- /dev/null
+++ b/server/server_lockout_test.go
@@ -0,0 +1,331 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/lockout"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/storage"
+)
+
+const (
+	lockoutUserEmail = "user@example.com"
+	lockoutUserID    = "user-id"
+	lockoutPassword  = "Secret-" + "passw0rd"
+	lockoutAuthReq   = "lockout-req"
+)
+
+// newLocalLockoutServer serves the local connector, for the login form and the
+// password grant, with one local user and an auth request of the form. configure
+// adjusts the server config further.
+func newLocalLockoutServer(t *testing.T, policy *lockout.Policy, update func(*storage.Password), configure ...func(*Config)) *Server {
+	t.Helper()
+	ctx := t.Context()
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.PasswordConnector = "local"
+		c.Lockout = policy
+		for _, f := range configure {
+			f(c)
+		}
+	})
+	t.Cleanup(httpServer.Close)
+
+	require.NoError(t, s.storage.CreateClient(ctx, storage.Client{
+		ID: "test", Secret: "barfoo", RedirectURIs: []string{"https://client.example/cb"},
+	}))
+	localConn := storage.Connector{ID: "local", Type: connectors.LocalConnector, Name: "Email", ResourceVersion: "1"}
+	require.NoError(t, s.storage.CreateConnector(ctx, localConn))
+	_, err := s.connectors.Open(localConn)
+	require.NoError(t, err)
+
+	hash, err := bcrypt.GenerateFromPassword([]byte(lockoutPassword), bcrypt.DefaultCost)
+	require.NoError(t, err)
+	p := storage.Password{Email: lockoutUserEmail, Username: "user", UserID: lockoutUserID, Hash: hash, HashUpdatedAt: time.Now()}
+	if update != nil {
+		update(&p)
+	}
+	require.NoError(t, s.storage.CreatePassword(ctx, p))
+
+	require.NoError(t, s.storage.CreateAuthRequest(ctx, storage.AuthRequest{
+		ID: lockoutAuthReq, ClientID: "test", ConnectorID: "local",
+		ResponseTypes: []string{"code"}, Scopes: []string{"openid"}, RedirectURI: "https://client.example/cb",
+		Expiry: time.Now().Add(time.Hour), HMACKey: []byte("0123456789abcdef0123456789abcdef"),
+	}))
+	return s
+}
+
+func serveForm(s *Server, target string, form url.Values) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(http.MethodPost, target, strings.NewReader(form.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	return rr
+}
+
+func postLoginForm(s *Server, password string) *httptest.ResponseRecorder {
+	return serveForm(s, "/auth/local/login?state="+lockoutAuthReq, url.Values{"login": {lockoutUserEmail}, "password": {password}})
+}
+
+func localPasswordGrant(t *testing.T, s *Server, password string) *httptest.ResponseRecorder {
+	t.Helper()
+	return postToken(t, s, url.Values{
+		"grant_type": {oauth2.GrantTypePassword},
+		"scope":      {"openid email"},
+		"username":   {lockoutUserEmail},
+		"password":   {password},
+	})
+}
+
+func lockLocalUser(t *testing.T, s *Server, until time.Time) {
+	t.Helper()
+	require.NoError(t, s.storage.CreateUserIdentity(t.Context(), storage.UserIdentity{
+		UserID: lockoutUserID, ConnectorID: "local", BlockedUntil: until, Consents: map[string][]string{},
+	}))
+}
+
+func failedAttempts(t *testing.T, s *Server) uint64 {
+	t.Helper()
+	p, err := s.storage.GetPassword(t.Context(), lockoutUserEmail)
+	require.NoError(t, err)
+	return p.IncorrectPasswordLoginAttempts
+}
+
+// A locked user gets the same answer from the login form and the password grant
+// whatever the password, and the attempts are not counted.
+func TestLockedAccountRefusedBeforePassword(t *testing.T) {
+	s := newLocalLockoutServer(t, &lockout.Policy{MaxAttempts: 1, Duration: time.Hour}, nil)
+	lockLocalUser(t, s, time.Now().Add(time.Hour))
+
+	right, wrong := postLoginForm(s, lockoutPassword), postLoginForm(s, "wrong")
+	assert.Equal(t, http.StatusTooManyRequests, right.Code)
+	assert.Equal(t, right.Code, wrong.Code)
+	assert.Equal(t, right.Body.String(), wrong.Body.String())
+
+	requireAccountLocked(t, localPasswordGrant(t, s, lockoutPassword))
+	requireAccountLocked(t, localPasswordGrant(t, s, "wrong"))
+
+	assert.Zero(t, failedAttempts(t, s))
+}
+
+// The lock of an administrator gets its own answer, 403, whatever the password;
+// once an automatic lock outlasts it, the answer is the automatic lock's again.
+func TestAdministratorLockRefusal(t *testing.T) {
+	tests := []struct {
+		name         string
+		blockedUntil time.Duration
+		formStatus   int
+		formText     string
+		grantStatus  int
+		grantText    string
+	}{
+		{
+			name:         "locked by an administrator",
+			blockedUntil: time.Hour,
+			formStatus:   http.StatusForbidden,
+			formText:     "Account locked by an administrator. Contact your administrator.",
+			grantStatus:  http.StatusForbidden,
+			grantText:    "Account locked by an administrator",
+		},
+		{
+			name:         "an automatic lock outlasts the administrator's",
+			blockedUntil: 2 * time.Hour,
+			formStatus:   http.StatusTooManyRequests,
+			formText:     "Account temporarily locked",
+			grantStatus:  http.StatusTooManyRequests,
+			grantText:    "Account locked",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := newLocalLockoutServer(t, &lockout.Policy{MaxAttempts: 1, Duration: time.Hour}, nil)
+			admin := time.Now().Add(time.Hour).UTC()
+			require.NoError(t, s.storage.CreateUserIdentity(t.Context(), storage.UserIdentity{
+				UserID: lockoutUserID, ConnectorID: "local", Consents: map[string][]string{},
+				BlockedUntil: admin.Add(tt.blockedUntil - time.Hour), AdminLockedUntil: admin,
+			}))
+
+			for _, password := range []string{lockoutPassword, "wrong"} {
+				form := postLoginForm(s, password)
+				assert.Equal(t, tt.formStatus, form.Code)
+				assert.Contains(t, form.Body.String(), tt.formText)
+
+				grant := localPasswordGrant(t, s, password)
+				assert.Equal(t, tt.grantStatus, grant.Code)
+				var resp struct {
+					Error       string `json:"error"`
+					Description string `json:"error_description"`
+				}
+				require.NoError(t, json.Unmarshal(grant.Body.Bytes(), &resp))
+				assert.Equal(t, oauth2.AccessDenied, resp.Error)
+				assert.Equal(t, tt.grantText, resp.Description)
+			}
+			assert.Zero(t, failedAttempts(t, s))
+		})
+	}
+}
+
+func TestLoginFormLockout(t *testing.T) {
+	s := newLocalLockoutServer(t, &lockout.Policy{MaxAttempts: 2, Duration: time.Hour}, nil)
+
+	assert.Equal(t, http.StatusUnauthorized, postLoginForm(s, "wrong").Code, "the form again")
+	assert.Equal(t, uint64(1), failedAttempts(t, s))
+	assert.Equal(t, http.StatusTooManyRequests, postLoginForm(s, "wrong").Code, "the second failure locks")
+	assert.Equal(t, http.StatusTooManyRequests, postLoginForm(s, lockoutPassword).Code)
+
+	ui, err := s.storage.GetUserIdentity(t.Context(), lockoutUserID, "local")
+	require.NoError(t, err)
+	assert.WithinDuration(t, time.Now().Add(time.Hour), ui.BlockedUntil, time.Minute)
+}
+
+func TestPasswordGrantLockout(t *testing.T) {
+	s := newLocalLockoutServer(t, &lockout.Policy{MaxAttempts: 2, Duration: time.Hour}, nil)
+
+	rr := localPasswordGrant(t, s, "wrong")
+	assert.Equal(t, http.StatusUnauthorized, rr.Code, rr.Body.String())
+	requireAccountLocked(t, localPasswordGrant(t, s, "wrong"))
+	requireAccountLocked(t, localPasswordGrant(t, s, lockoutPassword))
+}
+
+// The password change page refuses a user locked after the login form sent him
+// there, and the page keeps his password.
+func TestPasswordChangePageLockout(t *testing.T) {
+	s := newLocalLockoutServer(t, &lockout.Policy{MaxAttempts: 1, Duration: time.Hour}, func(p *storage.Password) {
+		p.RequireResetHashOnNextSuccLogin = true
+	})
+
+	rr := postLoginForm(s, lockoutPassword)
+	require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+	changeURL := rr.Header().Get("Location")
+	require.Contains(t, changeURL, "/password/change?")
+	cookies := rr.Result().Cookies()
+	require.NotEmpty(t, cookies, "the login binds the page to the browser")
+
+	lockLocalUser(t, s, time.Now().Add(time.Hour))
+	req := httptest.NewRequest(http.MethodPost, changeURL, strings.NewReader(url.Values{"newPassword": {"N3w-passw0rd"}}.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	for _, c := range cookies {
+		req.AddCookie(c)
+	}
+	rr = httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	assert.Equal(t, http.StatusTooManyRequests, rr.Code, "a locked user changes nothing")
+
+	p, err := s.storage.GetPassword(t.Context(), lockoutUserEmail)
+	require.NoError(t, err)
+	require.NoError(t, bcrypt.CompareHashAndPassword(p.Hash, []byte(lockoutPassword)))
+	assert.True(t, p.RequireResetHashOnNextSuccLogin)
+}
+
+// A user locked only in the storage of the v2.44-based dex, who has no user
+// identity yet, is refused before his password is judged like any other locked
+// user: the transitional kubernetes storage (150) reads the old lock as his
+// identity.
+func TestOldPlaceLockRefusedBeforePassword(t *testing.T) {
+	var store *oldPlaceStorage
+	s := newLocalLockoutServer(t, &lockout.Policy{MaxAttempts: 1, Duration: time.Hour}, nil, func(c *Config) {
+		store = &oldPlaceStorage{Storage: c.Storage, old: map[oldPlacePair]storage.UserIdentity{
+			{userID: lockoutUserID, connectorID: "local"}: {UserID: lockoutUserID, ConnectorID: "local", BlockedUntil: time.Now().Add(time.Hour)},
+		}}
+		c.Storage = store
+	})
+
+	right, wrong := postLoginForm(s, lockoutPassword), postLoginForm(s, "wrong")
+	assert.Equal(t, http.StatusTooManyRequests, right.Code, right.Body.String())
+	assert.Equal(t, right.Code, wrong.Code)
+	assert.Equal(t, right.Body.String(), wrong.Body.String())
+
+	requireAccountLocked(t, localPasswordGrant(t, s, lockoutPassword))
+	requireAccountLocked(t, localPasswordGrant(t, s, "wrong"))
+
+	assert.Zero(t, failedAttempts(t, s), "a refused attempt is not counted")
+	_, err := store.Storage.GetUserIdentity(t.Context(), lockoutUserID, "local")
+	assert.ErrorIs(t, err, storage.ErrNotFound, "a refused login records nothing")
+}
+
+// lockOnCreate locks the identity a first login creates, as a lock set between
+// the check before the password and the end of the login would be found.
+type lockOnCreate struct {
+	storage.Storage
+	until time.Time
+}
+
+func (s lockOnCreate) CreateUserIdentity(ctx context.Context, u storage.UserIdentity) error {
+	u.BlockedUntil = s.until
+	return s.Storage.CreateUserIdentity(ctx, u)
+}
+
+// requireLockPage checks the answer of a browser login refused for a lock.
+func requireLockPage(t *testing.T, rr *httptest.ResponseRecorder) {
+	t.Helper()
+	require.Equal(t, http.StatusTooManyRequests, rr.Code, rr.Body.String())
+	require.Contains(t, rr.Body.String(), "Account temporarily locked")
+}
+
+// A lock that only finalizeLogin finds gets the page of the check before the
+// password, on every path of the browser flow that completes a login.
+func TestLockAtFinalizeLoginRendersLockPage(t *testing.T) {
+	ctx := t.Context()
+	lockFirstLogin := func(c *Config) { c.Storage = lockOnCreate{Storage: c.Storage, until: time.Now().Add(time.Hour)} }
+
+	t.Run("login form", func(t *testing.T) {
+		s := newLocalLockoutServer(t, nil, nil, lockFirstLogin)
+		requireLockPage(t, postLoginForm(s, lockoutPassword))
+	})
+
+	t.Run("password change page", func(t *testing.T) {
+		s := newLocalLockoutServer(t, nil, func(p *storage.Password) { p.RequireResetHashOnNextSuccLogin = true }, lockFirstLogin)
+		rr := postLoginForm(s, lockoutPassword)
+		require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+
+		req := httptest.NewRequest(http.MethodPost, rr.Header().Get("Location"), strings.NewReader(url.Values{"newPassword": {"N3w-passw0rd"}}.Encode()))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		for _, c := range rr.Result().Cookies() {
+			req.AddCookie(c)
+		}
+		rr = httptest.NewRecorder()
+		s.ServeHTTP(rr, req)
+		requireLockPage(t, rr)
+	})
+
+	t.Run("connector callback", func(t *testing.T) {
+		s := newLocalLockoutServer(t, nil, nil)
+		require.NoError(t, s.storage.CreateAuthRequest(ctx, storage.AuthRequest{
+			ID: "callback-req", ClientID: "test", ConnectorID: "mock",
+			ResponseTypes: []string{"code"}, Scopes: []string{"openid"}, RedirectURI: "https://client.example/cb",
+			Expiry: time.Now().Add(time.Hour),
+		}))
+		setBlockedUntil(t, s, "mock", time.Now().Add(time.Hour))
+
+		rr := httptest.NewRecorder()
+		s.ServeHTTP(rr, httptest.NewRequest(http.MethodGet, "/callback/mock?state=callback-req", nil))
+		requireLockPage(t, rr)
+	})
+
+	t.Run("SPNEGO", func(t *testing.T) {
+		s := newLocalLockoutServer(t, nil, nil)
+		local, err := s.connectors.Get(ctx, "local")
+		require.NoError(t, err)
+		s.connectors.Set("local", connectors.Connector{
+			Type: connectors.LocalConnector, ResourceVersion: local.ResourceVersion,
+			Connector: spnegoShortCircuit{Identity: connector.Identity{UserID: lockoutUserID, Email: lockoutUserEmail}},
+		})
+		lockLocalUser(t, s, time.Now().Add(time.Hour))
+
+		rr := httptest.NewRecorder()
+		s.ServeHTTP(rr, httptest.NewRequest(http.MethodGet, "/auth/local/login?state="+lockoutAuthReq, nil))
+		requireLockPage(t, rr)
