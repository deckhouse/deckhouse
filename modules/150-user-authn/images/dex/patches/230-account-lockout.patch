+	if errors.As(err, &blocked) {
+		return nil, identityError(ctx, g.logger, err, "connector_id", g.connectorID, "client_id", client.ID, "user", req.Username)
+	}
 	if err != nil {
 		g.logger.ErrorContext(ctx, "failed to login user", "err", err)
 		return nil, &oauth2.Error{Type: oauth2.InvalidRequest, Description: "Could not login user", Status: http.StatusBadRequest}
diff --git a/server/lockout/lockout.go b/server/lockout/lockout.go
new file mode 100644
index 00000000..c5d6ddec
--- /dev/null
+++ b/server/lockout/lockout.go
@@ -0,0 +1,297 @@
+// Package lockout guards every password check: the login form and the password
+// grant check a password through Guard.Login, for the local password database
+// and for external password connectors (LDAP, Atlassian Crowd) alike. The
+// password change page takes no password; it refuses a locked pair with
+// useridentity.CheckBlocked.
+//
+// Guard.Login refuses a locked (user, connector) pair before its password is
+// judged, so the answer does not depend on whether the password is right. It
+// counts consecutive failed attempts and, past the limit of the policy, locks the
+// pair for a while; a right password resets the count. The lock is
+// UserIdentity.BlockedUntil, the field an administrator lock sets too, and
+// useridentity.CheckBlocked is the one decision whether a pair is locked.
+//
+// Local users keep their count on the Password object, as the v2.44-based
+// Deckhouse dex did; users of external connectors keep it on their UserIdentity.
+package lockout
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/useridentity"
+	"github.com/dexidp/dex/storage"
+)
+
+// Policy is the automatic lockout after failed password attempts.
+type Policy struct {
+	// MaxAttempts is the number of consecutive failed attempts that locks the
+	// pair. Zero locks it at the first one, as in the v2.44-based Deckhouse dex.
+	MaxAttempts uint64
+	// Duration is how long the automatic lock lasts.
+	Duration time.Duration
+	// ConnectorTypes are the external password connectors whose users the policy
+	// covers too, such as "ldap" and "atlassian-crowd", in any case. Local users
+	// are always covered.
+	ConnectorTypes []string
+}
+
+// covers reports whether the policy locks users of a connector of type t.
+func (p *Policy) covers(t string) bool {
+	if p == nil {
+		return false
+	}
+	return t == connectors.LocalConnector || slices.ContainsFunc(p.ConnectorTypes, func(c string) bool {
+		return strings.EqualFold(c, t)
+	})
+}
+
+// reached reports whether attempts consecutive failures lock the pair.
+func (p *Policy) reached(attempts uint64) bool {
+	return p != nil && attempts >= p.MaxAttempts
+}
+
+// Guard checks passwords. A nil *Guard checks them with the connector alone.
+type Guard struct {
+	Storage storage.Storage
+	Now     func() time.Time
+	Logger  *slog.Logger
+	// Policy is the automatic lockout. Nil locks no one automatically; a lock
+	// already in force is refused all the same.
+	Policy *Policy
+}
+
+// Attempt is a password presented for a user of a password connector.
+type Attempt struct {
+	ConnectorID string
+	Connector   connectors.Connector
+	Scopes      connector.Scopes
+	Username    string
+	Password    string
+}
+
+// Login checks the password of a with its connector and returns what the
+// connector returns. A locked pair gets *useridentity.BlockedError: before its
+// password is judged for a local user; for a user of an external connector, who
+// is known only once the connector has looked him up, before the result is used.
+// A failed attempt that reaches the limit of the policy locks the pair and gets
+// *useridentity.BlockedError too.
+func (g *Guard) Login(ctx context.Context, a Attempt) (connector.Identity, bool, error) {
+	pw, ok := a.Connector.Connector.(connector.PasswordConnector)
+	if !ok {
+		return connector.Identity{}, false, fmt.Errorf("lockout: connector %q does not take passwords", a.ConnectorID)
+	}
+	if g == nil {
+		return pw.Login(ctx, a.Scopes, a.Username, a.Password)
+	}
+	if a.Connector.Type == connectors.LocalConnector {
+		return g.loginLocal(ctx, a, pw)
+	}
+	return g.loginExternal(ctx, a, pw)
+}
+
+func (g *Guard) loginLocal(ctx context.Context, a Attempt, pw connector.PasswordConnector) (connector.Identity, bool, error) {
+	now := g.Now()
+	stored, err := g.Storage.GetPassword(ctx, a.Username)
+	switch {
+	case errors.Is(err, storage.ErrNotFound):
+		// No such user: nothing to refuse or count.
+		return pw.Login(ctx, a.Scopes, a.Username, a.Password)
+	case err != nil:
+		return connector.Identity{}, false, fmt.Errorf("get password: %w", err)
+	}
+	if err := useridentity.CheckBlocked(ctx, g.Storage, stored.UserID, a.ConnectorID, now); err != nil {
+		return connector.Identity{}, false, err
+	}
+
+	identity, valid, err := pw.Login(ctx, a.Scopes, a.Username, a.Password)
+	switch {
+	case err != nil:
+		return identity, false, err
+	case valid:
+		if stored.IncorrectPasswordLoginAttempts > 0 {
+			g.updatePassword(ctx, a, "failed to reset the failed login attempts", resetAttempts)
+		}
+		return identity, true, nil
+	}
+
+	// The count is kept whether or not a policy locks anyone, as the user-authn
+	// controller shows it.
+	var attempts uint64
+	if !g.updatePassword(ctx, a, "failed to count a failed login attempt", func(p *storage.Password) {
+		p.IncorrectPasswordLoginAttempts++
+		attempts = p.IncorrectPasswordLoginAttempts
+	}) || !g.Policy.reached(attempts) {
+		return identity, false, nil
+	}
+
+	var until time.Time
+	err = g.updateIdentity(ctx, stored.UserID, a.ConnectorID, passwordClaims(stored), now, func(u *storage.UserIdentity) {
+		u.BlockedUntil = later(u.BlockedUntil, now.Add(g.Policy.Duration))
+		until = u.BlockedUntil
+	})
+	if err != nil {
+		// The count stays at the limit, so the next failure locks.
+		g.Logger.ErrorContext(ctx, "failed to lock account", "connector_id", a.ConnectorID, "user_id", stored.UserID, "err", err)
+		return identity, false, nil
+	}
+	g.logLocked(ctx, a.ConnectorID, stored.UserID, attempts, until)
+	g.updatePassword(ctx, a, "failed to reset the failed login attempts", resetAttempts)
+	return identity, false, &useridentity.BlockedError{Until: until}
+}
+
+func (g *Guard) loginExternal(ctx context.Context, a Attempt, pw connector.PasswordConnector) (connector.Identity, bool, error) {
+	now := g.Now()
+	identity, valid, err := pw.Login(ctx, a.Scopes, a.Username, a.Password)
+	if err != nil {
+		return identity, false, err
+	}
+	// The LDAP and Crowd connectors name the user of a wrong password too.
+	if identity.UserID == "" {
+		return identity, valid, nil
+	}
+	if err := useridentity.CheckBlocked(ctx, g.Storage, identity.UserID, a.ConnectorID, now); err != nil {
+		return connector.Identity{}, false, err
+	}
+
+	if valid {
+		err := g.Storage.UpdateUserIdentity(ctx, identity.UserID, a.ConnectorID, func(u storage.UserIdentity) (storage.UserIdentity, error) {
+			if u.IncorrectPasswordLoginAttempts == 0 {
+				return u, errUnchanged
+			}
+			u.IncorrectPasswordLoginAttempts = 0
+			return u, nil
+		})
+		if err != nil && !errors.Is(err, errUnchanged) && !errors.Is(err, storage.ErrNotFound) {
+			g.Logger.ErrorContext(ctx, "failed to reset the failed login attempts",
+				"connector_id", a.ConnectorID, "user_id", identity.UserID, "err", err)
+		}
+		return identity, true, nil
+	}
+	if !g.Policy.covers(a.Connector.Type) {
+		return identity, false, nil
+	}
+
+	var attempts uint64
+	var until time.Time
+	claims := storage.Claims{UserID: identity.UserID, Username: identity.Username, Email: identity.Email}
+	err = g.updateIdentity(ctx, identity.UserID, a.ConnectorID, claims, now, func(u *storage.UserIdentity) {
+		u.IncorrectPasswordLoginAttempts++
+		attempts, until = u.IncorrectPasswordLoginAttempts, time.Time{}
+		if g.Policy.reached(attempts) {
+			u.BlockedUntil = later(u.BlockedUntil, now.Add(g.Policy.Duration))
+			u.IncorrectPasswordLoginAttempts = 0
+			until = u.BlockedUntil
+		}
+	})
+	switch {
+	case err != nil:
+		g.Logger.ErrorContext(ctx, "failed to count a failed login attempt",
+			"connector_id", a.ConnectorID, "user_id", identity.UserID, "err", err)
+		return identity, false, nil
+	case until.IsZero():
+		return identity, false, nil
+	}
+	g.logLocked(ctx, a.ConnectorID, identity.UserID, attempts, until)
+	return identity, false, &useridentity.BlockedError{Until: until}
+}
+
+func (g *Guard) logLocked(ctx context.Context, connectorID, userID string, attempts uint64, until time.Time) {
+	g.Logger.WarnContext(ctx, "account locked due to too many failed attempts",
+		"connector_id", connectorID, "user_id", userID, "attempts", attempts, "blocked_until", until)
+}
+
+// errUnchanged aborts an update that has nothing to write.
+var errUnchanged = errors.New("lockout: unchanged")
+
+// passwordUpdateAttempts bounds the tries of an update of a Password object.
+// Parallel failed logins of one user conflict, and the kubernetes storage does
+// not retry a conflicting write of a Password as it does for a UserIdentity; an
+// attempt left uncounted would let parallel guesses pass the limit.
+const passwordUpdateAttempts = 5
+
+// updatePassword applies change to the Password of the local user of a and
+// reports whether it was stored. A failure is logged with msg and not returned:
+// the static passwords of the config file cannot be written, and their users
+// still log in, as upstream lets them.
+func (g *Guard) updatePassword(ctx context.Context, a Attempt, msg string, change func(*storage.Password)) bool {
+	update := func(p storage.Password) (storage.Password, error) {
+		change(&p)
+		return p, nil
+	}
+	err := g.Storage.UpdatePassword(ctx, a.Username, update)
+	for try := 1; err != nil && try < passwordUpdateAttempts; try++ {
+		if errors.Is(err, storage.ErrNotFound) {
+			return false // deleted meanwhile
+		}
+		select {
+		case <-ctx.Done():
+			return false
+		case <-time.After(time.Duration(try) * 5 * time.Millisecond):
+		}
+		err = g.Storage.UpdatePassword(ctx, a.Username, update)
+	}
+	if err != nil {
+		g.Logger.ErrorContext(ctx, msg, "connector_id", a.ConnectorID, "user", a.Username, "err", err)
+		return false
+	}
+	return true
+}
+
+func resetAttempts(p *storage.Password) { p.IncorrectPasswordLoginAttempts = 0 }
+
+// updateIdentity applies change to the identity of the pair, creating one with
+// claims when the pair has none: a lock or a count may come before any login.
+func (g *Guard) updateIdentity(ctx context.Context, userID, connectorID string, claims storage.Claims, now time.Time, change func(*storage.UserIdentity)) error {
+	update := func(u storage.UserIdentity) (storage.UserIdentity, error) {
+		change(&u)
+		return u, nil
+	}
+	err := g.Storage.UpdateUserIdentity(ctx, userID, connectorID, update)
+	if !errors.Is(err, storage.ErrNotFound) {
+		return err
+	}
+
+	u := storage.UserIdentity{
+		UserID:      userID,
+		ConnectorID: connectorID,
+		Claims:      claims,
+		Consents:    make(map[string][]string),
+		CreatedAt:   now,
+	}
+	change(&u)
+	err = g.Storage.CreateUserIdentity(ctx, u)
+	if errors.Is(err, storage.ErrAlreadyExists) {
+		// Created meanwhile, by a parallel login.
+		return g.Storage.UpdateUserIdentity(ctx, userID, connectorID, update)
+	}
+	return err
+}
+
+// passwordClaims are the claims a login of the local user p would have.
+func passwordClaims(p storage.Password) storage.Claims {
+	return storage.Claims{
+		UserID:            p.UserID,
+		Username:          p.Username,
+		PreferredUsername: p.PreferredUsername,
+		Email:             p.Email,
+		EmailVerified:     p.EmailVerified == nil || *p.EmailVerified,
+		Groups:            p.Groups,
+	}
+}
+
+// later never lets an automatic lock shorten a lock in force, an administrator
+// lock without an end included.
+func later(current, candidate time.Time) time.Time {
+	if current.After(candidate) {
+		return current
+	}
+	return candidate
+}
diff --git a/server/lockout/lockout_test.go b/server/lockout/lockout_test.go
new file mode 100644
index 00000000..ecc11730
--- /dev/null
+++ b/server/lockout/lockout_test.go
@@ -0,0 +1,413 @@
+package lockout
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/useridentity"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+const (
+	userEmail = "jane@example.com"
+	userID    = "jane-id"
+	rightPass = "right"
+)
+
+// stubConnector is a password connector with one user. Like the LDAP and Crowd
+// connectors, it names the user of a wrong password with the user ID and email.
+type stubConnector struct {
+	logins int
+}
+
+func (c *stubConnector) Login(_ context.Context, _ connector.Scopes, username, password string) (connector.Identity, bool, error) {
+	c.logins++
+	if username != "jane" {
+		return connector.Identity{}, false, nil
+	}
+	if password != rightPass {
+		return connector.Identity{UserID: userID, Email: userEmail}, false, nil
+	}
+	return connector.Identity{UserID: userID, Username: "jane", Email: userEmail}, true, nil
+}
+
+func (c *stubConnector) Prompt() string { return "" }
+
+type clock struct{ now time.Time }
+
+func (c *clock) Now() time.Time { return c.now }
+
+func newGuard(t *testing.T, s storage.Storage, policy *Policy) (*Guard, *clock) {
+	t.Helper()
+	c := &clock{now: time.Date(2026, 10, 14, 12, 0, 0, 0, time.UTC)}
+	return &Guard{Storage: s, Now: c.Now, Logger: slog.New(slog.DiscardHandler), Policy: policy}, c
+}
+
+func newLocalStorage(t *testing.T) storage.Storage {
+	t.Helper()
+	s := memory.New(slog.New(slog.DiscardHandler))
+	hash, err := bcrypt.GenerateFromPassword([]byte(rightPass), bcrypt.DefaultCost)
+	require.NoError(t, err)
+	require.NoError(t, s.CreatePassword(t.Context(), storage.Password{
+		Email: userEmail, Username: "jane", UserID: userID, Hash: hash,
+	}))
+	return s
+}
+
+func localAttempt(s storage.Storage, password string) Attempt {
+	return Attempt{
+		ConnectorID: "local",
+		Connector:   connectors.Connector{Type: connectors.LocalConnector, Connector: connectors.NewPasswordDB(s)},
+		Username:    userEmail,
+		Password:    password,
+	}
+}
+
+func externalAttempt(conn *stubConnector, connectorType, password string) Attempt {
+	return Attempt{
+		ConnectorID: "corp",
+		Connector:   connectors.Connector{Type: connectorType, Connector: conn},
+		Username:    "jane",
+		Password:    password,
+	}
+}
+
+func localAttempts(t *testing.T, s storage.Storage) uint64 {
+	t.Helper()
+	p, err := s.GetPassword(t.Context(), userEmail)
+	require.NoError(t, err)
+	return p.IncorrectPasswordLoginAttempts
+}
+
+func requireBlocked(t *testing.T, err error, until time.Time) {
+	t.Helper()
+	var blocked *useridentity.BlockedError
+	require.ErrorAs(t, err, &blocked)
+	require.True(t, until.Equal(blocked.Until), "blocked until %s, want %s", blocked.Until, until)
+}
+
+func TestLocalLockout(t *testing.T) {
+	ctx := t.Context()
+	s := newLocalStorage(t)
+	g, c := newGuard(t, s, &Policy{MaxAttempts: 3, Duration: time.Hour})
+
+	for attempt := uint64(1); attempt < 3; attempt++ {
+		_, ok, err := g.Login(ctx, localAttempt(s, "wrong"))
+		require.NoError(t, err)
+		require.False(t, ok)
+		require.Equal(t, attempt, localAttempts(t, s))
+	}
+	_, err := s.GetUserIdentity(ctx, userID, "local")
+	require.ErrorIs(t, err, storage.ErrNotFound, "counting writes no identity")
+
+	// The third failure locks and starts the count over.
+	_, ok, err := g.Login(ctx, localAttempt(s, "wrong"))
+	require.False(t, ok)
+	requireBlocked(t, err, c.now.Add(time.Hour))
+	assert.Zero(t, localAttempts(t, s))
+
+	ui, err := s.GetUserIdentity(ctx, userID, "local")
+	require.NoError(t, err)
+	assert.Equal(t, c.now.Add(time.Hour), ui.BlockedUntil)
+	assert.Equal(t, storage.Claims{UserID: userID, Username: "jane", Email: userEmail, EmailVerified: true}, ui.Claims)
+	assert.True(t, ui.LastLogin.IsZero(), "a lock is no login")
+
+	// Locked: the right password is refused and a wrong one is not counted.
+	for _, password := range []string{rightPass, "wrong"} {
+		_, ok, err := g.Login(ctx, localAttempt(s, password))
+		require.False(t, ok)
+		requireBlocked(t, err, c.now.Add(time.Hour))
+	}
+	assert.Zero(t, localAttempts(t, s))
+
+	// Once the lock ends, the right password logs in.
+	c.now = c.now.Add(time.Hour)
+	ident, ok, err := g.Login(ctx, localAttempt(s, rightPass))
+	require.NoError(t, err)
+	require.True(t, ok)
+	assert.Equal(t, userID, ident.UserID)
+}
+
+func TestLocalCountWithoutPolicy(t *testing.T) {
+	ctx := t.Context()
+	s := newLocalStorage(t)
+	g, _ := newGuard(t, s, nil)
+
+	for range 5 {
+		_, ok, err := g.Login(ctx, localAttempt(s, "wrong"))
+		require.NoError(t, err)
+		require.False(t, ok)
+	}
+	assert.Equal(t, uint64(5), localAttempts(t, s), "the count is kept for the user-authn controller")
+
+	_, ok, err := g.Login(ctx, localAttempt(s, rightPass))
+	require.NoError(t, err)
+	require.True(t, ok)
+	assert.Zero(t, localAttempts(t, s), "a right password resets the count")
+
+	_, err = s.GetUserIdentity(ctx, userID, "local")
+	require.ErrorIs(t, err, storage.ErrNotFound)
+}
+
+func TestLocalUnknownUser(t *testing.T) {
+	s := newLocalStorage(t)
+	g, _ := newGuard(t, s, &Policy{MaxAttempts: 1, Duration: time.Hour})
+
+	attempt := localAttempt(s, "wrong")
+	attempt.Username = "nobody@example.com"
+	_, ok, err := g.Login(t.Context(), attempt)
+	require.NoError(t, err)
+	require.False(t, ok)
+	assert.Zero(t, localAttempts(t, s))
+}
+
+// A locked user gets the same answer whatever the password, and the local
+// password is not even checked.
+func TestLockedBeforePassword(t *testing.T) {
+	ctx := t.Context()
+	until := time.Date(9999, 12, 31, 23, 59, 59, 0, time.UTC)
+	lock := func(t *testing.T, s storage.Storage, connectorID string) {
+		t.Helper()
+		require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{
+			UserID: userID, ConnectorID: connectorID, BlockedUntil: until, Consents: map[string][]string{},
+		}))
+	}
+
+	t.Run("local", func(t *testing.T) {
+		s := memory.New(slog.New(slog.DiscardHandler))
+		require.NoError(t, s.CreatePassword(ctx, storage.Password{Email: userEmail, UserID: userID, Hash: []byte("x")}))
+		lock(t, s, "local")
+		g, _ := newGuard(t, s, nil)
+		conn := &stubConnector{}
+		for _, password := range []string{rightPass, "wrong"} {
+			_, ok, err := g.Login(ctx, Attempt{
+				ConnectorID: "local",
+				Connector:   connectors.Connector{Type: connectors.LocalConnector, Connector: conn},
+				Username:    userEmail,
+				Password:    password,
+			})
+			require.False(t, ok)
+			requireBlocked(t, err, until)
+		}
+		assert.Zero(t, conn.logins, "the password is not checked")
+	})
+
+	t.Run("external", func(t *testing.T) {
+		s := memory.New(slog.New(slog.DiscardHandler))
+		lock(t, s, "corp")
+		g, _ := newGuard(t, s, &Policy{MaxAttempts: 1, Duration: time.Hour, ConnectorTypes: []string{"ldap"}})
+		conn := &stubConnector{}
+		for _, password := range []string{rightPass, "wrong"} {
+			ident, ok, err := g.Login(ctx, externalAttempt(conn, "ldap", password))
+			require.False(t, ok)
+			assert.Empty(t, ident.UserID)
+			requireBlocked(t, err, until)
+		}
+		ui, err := s.GetUserIdentity(ctx, userID, "corp")
+		require.NoError(t, err)
+		assert.Zero(t, ui.IncorrectPasswordLoginAttempts, "a refused attempt is not counted")
+	})
+}
+
+func TestExternalLockout(t *testing.T) {
+	ctx := t.Context()
+	s := memory.New(slog.New(slog.DiscardHandler))
+	g, c := newGuard(t, s, &Policy{MaxAttempts: 2, Duration: time.Hour, ConnectorTypes: []string{"LDAP", "atlassian-crowd"}})
+	conn := &stubConnector{}
+
+	// The first failure creates the identity of a user who never logged in.
+	_, ok, err := g.Login(ctx, externalAttempt(conn, "ldap", "wrong"))
+	require.NoError(t, err)
+	require.False(t, ok)
+	ui, err := s.GetUserIdentity(ctx, userID, "corp")
+	require.NoError(t, err)
+	assert.Equal(t, uint64(1), ui.IncorrectPasswordLoginAttempts)
+	assert.Equal(t, storage.Claims{UserID: userID, Email: userEmail}, ui.Claims)
+	assert.True(t, ui.BlockedUntil.IsZero())
+
+	// A right password resets the count.
+	_, ok, err = g.Login(ctx, externalAttempt(conn, "ldap", rightPass))
+	require.NoError(t, err)
+	require.True(t, ok)
+	ui, err = s.GetUserIdentity(ctx, userID, "corp")
+	require.NoError(t, err)
+	assert.Zero(t, ui.IncorrectPasswordLoginAttempts)
+
+	_, _, err = g.Login(ctx, externalAttempt(conn, "ldap", "wrong"))
+	require.NoError(t, err)
+	_, ok, err = g.Login(ctx, externalAttempt(conn, "ldap", "wrong"))
+	require.False(t, ok)
+	requireBlocked(t, err, c.now.Add(time.Hour))
+	ui, err = s.GetUserIdentity(ctx, userID, "corp")
+	require.NoError(t, err)
+	assert.Zero(t, ui.IncorrectPasswordLoginAttempts)
+	assert.Equal(t, c.now.Add(time.Hour), ui.BlockedUntil)
+}
+
+func TestExternalNotCovered(t *testing.T) {
+	ctx := t.Context()
+	s := memory.New(slog.New(slog.DiscardHandler))
+	g, _ := newGuard(t, s, &Policy{MaxAttempts: 1, Duration: time.Hour, ConnectorTypes: []string{"ldap"}})
+	conn := &stubConnector{}
+
+	_, ok, err := g.Login(ctx, externalAttempt(conn, "keystone", "wrong"))
+	require.NoError(t, err)
+	require.False(t, ok)
+	_, err = s.GetUserIdentity(ctx, userID, "corp")
+	require.ErrorIs(t, err, storage.ErrNotFound, "a connector the policy does not list is not counted")
+
+	// An unknown user is named by no one: nothing to count.
+	attempt := externalAttempt(conn, "ldap", "wrong")
+	attempt.Username = "nobody"
+	_, ok, err = g.Login(ctx, attempt)
+	require.NoError(t, err)
+	require.False(t, ok)
+	_, err = s.GetUserIdentity(ctx, userID, "corp")
+	require.ErrorIs(t, err, storage.ErrNotFound)
+}
+
+// lateLockStorage hides the lock from the check before the password, as if an
+// administrator locked the pair right after it.
+type lateLockStorage struct {
+	storage.Storage
+}
+
+func (s lateLockStorage) GetUserIdentity(ctx context.Context, userID, connectorID string) (storage.UserIdentity, error) {
+	ui, err := s.Storage.GetUserIdentity(ctx, userID, connectorID)
+	ui.BlockedUntil = time.Time{}
+	return ui, err
+}
+
+// An automatic lock never shortens a lock in force, an administrator lock
+// without an end included.
+func TestAutomaticLockNeverShortens(t *testing.T) {
+	ctx := t.Context()
+	forever := time.Date(9999, 12, 31, 23, 59, 59, 0, time.UTC)
+	newStorage := func(t *testing.T, connectorID string) storage.Storage {
+		s := newLocalStorage(t)
+		require.NoError(t, s.CreateUserIdentity(ctx, storage.UserIdentity{
+			UserID: userID, ConnectorID: connectorID, BlockedUntil: forever, Consents: map[string][]string{},
+		}))
+		return lateLockStorage{s}
+	}
+
+	t.Run("local", func(t *testing.T) {
+		s := newStorage(t, "local")
+		g, _ := newGuard(t, s, &Policy{MaxAttempts: 1, Duration: time.Hour})
+		_, _, err := g.Login(ctx, localAttempt(s, "wrong"))
+		requireBlocked(t, err, forever)
+	})
+
+	t.Run("external", func(t *testing.T) {
+		s := newStorage(t, "corp")
+		g, _ := newGuard(t, s, &Policy{MaxAttempts: 1, Duration: time.Hour, ConnectorTypes: []string{"ldap"}})
+		_, _, err := g.Login(ctx, externalAttempt(&stubConnector{}, "ldap", "wrong"))
+		requireBlocked(t, err, forever)
+	})
+}
+
+// conflictStorage fails the first updates of a Password, as parallel writes of
+// the kubernetes storage do, or every one, as the static passwords do.
+type conflictStorage struct {
+	storage.Storage
+	failures int
+}
+
+func (s *conflictStorage) UpdatePassword(ctx context.Context, email string, updater func(storage.Password) (storage.Password, error)) error {
+	if s.failures != 0 {
+		s.failures--
+		return errors.New("conflict")
+	}
+	return s.Storage.UpdatePassword(ctx, email, updater)
+}
+
+func TestLocalCountRetried(t *testing.T) {
+	ctx := t.Context()
+
+	s := &conflictStorage{Storage: newLocalStorage(t), failures: passwordUpdateAttempts - 1}
+	g, _ := newGuard(t, s, nil)
+	_, ok, err := g.Login(ctx, localAttempt(s, "wrong"))
+	require.NoError(t, err)
+	require.False(t, ok)
+	assert.Equal(t, uint64(1), localAttempts(t, s), "a conflicting write is retried")
+
+	// A Password that cannot be written still answers as a wrong password.
+	s.failures = -1
+	_, ok, err = g.Login(ctx, localAttempt(s, "wrong"))
+	require.NoError(t, err)
+	require.False(t, ok)
+	_, ok, err = g.Login(ctx, localAttempt(s, rightPass))
+	require.NoError(t, err)
+	require.True(t, ok)
+}
+
+func TestNilGuard(t *testing.T) {
+	var g *Guard
+	conn := &stubConnector{}
+	ident, ok, err := g.Login(t.Context(), externalAttempt(conn, "ldap", rightPass))
+	require.NoError(t, err)
+	require.True(t, ok)
+	assert.Equal(t, userID, ident.UserID)
+
+	_, _, err = g.Login(t.Context(), Attempt{Connector: connectors.Connector{Type: "oidc"}})
+	require.Error(t, err, "not a password connector")
+}
+
+// oldPlaceLock reads a pair that has no identity as locked until until, as the
+// transitional kubernetes storage reads a lock the v2.44-based dex kept outside
+// UserIdentity.
+type oldPlaceLock struct {
+	storage.Storage
+	until time.Time
+}
+
+func (s *oldPlaceLock) GetUserIdentity(ctx context.Context, userID, connectorID string) (storage.UserIdentity, error) {
+	u, err := s.Storage.GetUserIdentity(ctx, userID, connectorID)
+	if errors.Is(err, storage.ErrNotFound) {
+		return storage.UserIdentity{UserID: userID, ConnectorID: connectorID, BlockedUntil: s.until}, nil
+	}
+	return u, err
+}
+
+// A pair locked only in the old storage is refused before its password is
+// judged, whatever the password, and nothing is counted or recorded for it.
+func TestOldPlaceLockRefusedBeforePassword(t *testing.T) {
+	for _, password := range []string{rightPass, "wrong"} {
+		t.Run("local user, "+password+" password", func(t *testing.T) {
+			ctx := t.Context()
+			s := &oldPlaceLock{Storage: newLocalStorage(t)}
+			g, c := newGuard(t, s, &Policy{MaxAttempts: 1, Duration: time.Hour})
+			s.until = c.now.Add(time.Hour)
+
+			_, ok, err := g.Login(ctx, localAttempt(s, password))
+			require.False(t, ok)
+			requireBlocked(t, err, s.until)
+			assert.Zero(t, localAttempts(t, s))
+			_, err = s.Storage.GetUserIdentity(ctx, userID, "local")
+			assert.ErrorIs(t, err, storage.ErrNotFound)
+		})
+
+		t.Run("external user, "+password+" password", func(t *testing.T) {
+			ctx := t.Context()
+			s := &oldPlaceLock{Storage: memory.New(slog.New(slog.DiscardHandler))}
+			g, c := newGuard(t, s, &Policy{MaxAttempts: 1, Duration: time.Hour, ConnectorTypes: []string{"ldap"}})
+			s.until = c.now.Add(time.Hour)
+
+			_, ok, err := g.Login(ctx, externalAttempt(&stubConnector{}, "ldap", password))
+			require.False(t, ok)
+			requireBlocked(t, err, s.until)
+			_, err = s.Storage.GetUserIdentity(ctx, userID, "corp")
+			assert.ErrorIs(t, err, storage.ErrNotFound, "a refused attempt is not counted")
+		})
+	}
+}
