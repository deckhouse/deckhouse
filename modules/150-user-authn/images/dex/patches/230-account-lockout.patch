diff --git a/server/authflow/lockout.go b/server/authflow/lockout.go
new file mode 100644
index 00000000..05b74f54
--- /dev/null
+++ b/server/authflow/lockout.go
@@ -0,0 +1,45 @@
+package authflow
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/dexidp/dex/server/useridentity"
+)
+
+// refuseLocked answers a password check that err refuses for a locked account
+// and reports whether it did. The answer is the same whatever the password, as
+// in the v2.44-based Deckhouse dex.
+func (h *Handler) refuseLocked(w http.ResponseWriter, r *http.Request, err error, connectorID, username string) bool {
+	var blocked *useridentity.BlockedError
+	if !errors.As(err, &blocked) {
+		return false
+	}
+	h.Logger.WarnContext(r.Context(), "login rejected for locked account",
+		"connector_id", connectorID, "user", username, "blocked_until", blocked.Until)
+	return h.renderLocked(r, w, err)
+}
+
+// Pages of a login refused for a locked account.
+const (
+	errMsgLockedByAdministrator = "Account locked by an administrator. Contact your administrator."
+	errMsgTemporarilyLocked     = "Account temporarily locked"
+)
+
+// renderLocked renders the page of a login that err refuses for a locked account
+// and reports whether it did. Every lock refusal of the browser flow gets this
+// page, whether the check before the password or finalizeLogin, which logs its
+// refusal itself, found the lock: HTTP 403 for the lock of an administrator,
+// HTTP 429 for an automatic lock after failed password attempts.
+func (h *Handler) renderLocked(r *http.Request, w http.ResponseWriter, err error) bool {
+	var blocked *useridentity.BlockedError
+	if !errors.As(err, &blocked) {
+		return false
+	}
+	if blocked.ByAdministrator {
+		h.renderError(r, w, http.StatusForbidden, errMsgLockedByAdministrator)
+		return true
+	}
+	h.renderError(r, w, http.StatusTooManyRequests, errMsgTemporarilyLocked)
+	return true
+}
