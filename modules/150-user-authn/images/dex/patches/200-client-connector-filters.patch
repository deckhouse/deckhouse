+// allowListRefreshConnector stands in for "corp" at the refresh: it answers
+// with the user in groups and counts the refreshes.
+type allowListRefreshConnector struct {
+	groups    []string
+	refreshes *int
+}
+
+func (c allowListRefreshConnector) Refresh(_ context.Context, _ connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	*c.refreshes++
+	ident.Groups = append([]string(nil), c.groups...)
+	return ident, nil
+}
+
+// createAllowListRefresh stores the refresh token of the client "app" that a
+// login of jane@example.com through "corp" left, with the groups the client
+// admitted then, and returns it as the client presents it.
+func createAllowListRefresh(t *testing.T, s *Server) string {
+	t.Helper()
+	ctx := t.Context()
+	now := time.Now()
+	require.NoError(t, s.storage.CreateRefresh(ctx, storage.RefreshToken{
+		ID:          "refresh",
+		Token:       "token",
+		ClientID:    "app",
+		ConnectorID: "corp",
+		Scopes:      []string{"openid", "email", "groups", "offline_access"},
+		Claims: storage.Claims{
+			UserID:        allowListUserID,
+			Username:      "jane",
+			Email:         allowListEmail,
+			EmailVerified: true,
+			Groups:        []string{"developers"},
+		},
+		// A token without connector data makes the refresh read the offline
+		// session inside the token update, where the memory storage of v2.46.0
+		// deadlocks on its own lock; a first refresh of a new token has it.
+		ConnectorData: []byte(`{}`),
+		CreatedAt:     now,
+		LastUsed:      now,
+	}))
+	require.NoError(t, s.storage.CreateOfflineSessions(ctx, storage.OfflineSessions{
+		UserID:  allowListUserID,
+		ConnID:  "corp",
+		Refresh: map[string]*storage.RefreshTokenRef{"app": {ID: "refresh", ClientID: "app", CreatedAt: now, LastUsed: now}},
+	}))
+
+	raw, err := internal.Marshal(&internal.RefreshToken{RefreshId: "refresh", Token: "token"})
+	require.NoError(t, err)
+	return raw
+}
