+// TestUnmarshalAllowLists reads the allow-lists in the form the user-authn
+// templates render them: on a connector from DexProvider.spec.allowedIdentities
+// and on a client; a config that dropped them would let everyone in.
+func TestUnmarshalAllowLists(t *testing.T) {
+	rawConfig := []byte(`
+staticClients:
+- id: app
+  allowedEmails:
+  - jane@example.com
+  allowedGroups:
+  - admins
+connectors:
+- type: mockCallback
+  id: corp
+  name: Corp
+  allowedEmails:
+  - "boss@partner.example"
+  allowedEmailDomains:
+  - "corp.example"
+  allowedGroups:
+  - "staff"
+`)
+
+	var c Config
+	require.NoError(t, yaml.Unmarshal(rawConfig, &c))
+
+	require.Len(t, c.StaticClients, 1)
+	require.Equal(t, []string{"jane@example.com"}, c.StaticClients[0].AllowedEmails)
+	require.Equal(t, []string{"admins"}, c.StaticClients[0].AllowedGroups)
+
+	require.Len(t, c.StaticConnectors, 1)
+	conn, err := ToStorageConnector(c.StaticConnectors[0])
+	require.NoError(t, err)
+	require.Equal(t, []string{"boss@partner.example"}, conn.AllowedEmails)
+	require.Equal(t, []string{"corp.example"}, conn.AllowedEmailDomains)
+	require.Equal(t, []string{"staff"}, conn.AllowedGroups)
+}
