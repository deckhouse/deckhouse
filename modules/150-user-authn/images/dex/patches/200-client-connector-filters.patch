diff --git a/server/allowlist/allowlist.go b/server/allowlist/allowlist.go
new file mode 100644
index 00000000..9142a2fc
--- /dev/null
+++ b/server/allowlist/allowlist.go
@@ -0,0 +1,144 @@
+// Package allowlist applies the allow-lists of a client and of a connector to
+// the claims Dex is about to issue for a user. Deckhouse renders them from
+// DexClient and DexAuthenticator (allowedEmails, allowedGroups) and from
+// DexProvider (allowedIdentities); upstream has no equivalent.
+//
+// The interactive login (server/authflow) and the password, refresh-token and
+// token-exchange grants (server/grants) apply them. A login from a browser
+// session does not apply them yet.
+package allowlist
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/dexidp/dex/pkg/groups"
+	"github.com/dexidp/dex/storage"
+)
+
+// Rule names the allow-list that refused a user.
+type Rule string
+
+const (
+	// ClientEmails is Client.AllowedEmails.
+	ClientEmails Rule = "client_allowed_emails"
+	// ClientGroups is Client.AllowedGroups.
+	ClientGroups Rule = "client_allowed_groups"
+	// ConnectorEmails is Connector.AllowedEmails with AllowedEmailDomains.
+	ConnectorEmails Rule = "connector_allowed_emails"
+	// ConnectorGroups is Connector.AllowedGroups.
+	ConnectorGroups Rule = "connector_allowed_groups"
+	// ConnectorNotFound refuses a user of a connector that is gone from storage.
+	ConnectorNotFound Rule = "connector_not_found"
+)
+
+// NotAllowedError refuses a user that an allow-list does not admit.
+type NotAllowedError struct {
+	Rule        Rule
+	ClientID    string
+	ConnectorID string
+}
+
+func (e *NotAllowedError) Error() string {
+	return fmt.Sprintf("user not allowed by %s (client %q, connector %q)", e.Rule, e.ClientID, e.ConnectorID)
+}
+
+// Apply checks the claims of a user who signs in to client through the
+// connector connectorID against the allow-lists of the client, then of the
+// connector, and narrows claims.Groups to the groups both admit. A refused user
+// gets *NotAllowedError, and claims are left as they were.
+//
+// The connector is read from s, which serves the connectors of the config file
+// too. One missing from storage refuses the user: the login that got this far
+// had it, so it was removed meanwhile, not unrestricted.
+func Apply(ctx context.Context, s storage.Storage, client storage.Client, connectorID string, claims *storage.Claims) error {
+	refuse := func(rule Rule) error {
+		return &NotAllowedError{Rule: rule, ClientID: client.ID, ConnectorID: connectorID}
+	}
+
+	admitted, rule := admitByClient(client, claims.Email, claims.Groups)
+	if rule != "" {
+		return refuse(rule)
+	}
+
+	conn, err := s.GetConnector(ctx, connectorID)
+	switch {
+	case errors.Is(err, storage.ErrNotFound):
+		return refuse(ConnectorNotFound)
+	case err != nil:
+		return fmt.Errorf("get connector %q: %w", connectorID, err)
+	}
+
+	admitted, rule = admitByConnector(conn, claims.Email, admitted)
+	if rule != "" {
+		return refuse(rule)
+	}
+
+	claims.Groups = admitted
+	return nil
+}
+
+// admitByClient returns the groups of a user the client admits, or the rule
+// that refuses the user. Emails compare exactly.
+func admitByClient(c storage.Client, email string, userGroups []string) ([]string, Rule) {
+	if len(c.AllowedEmails) > 0 && (email == "" || !slices.Contains(c.AllowedEmails, email)) {
+		return nil, ClientEmails
+	}
+	if len(c.AllowedGroups) > 0 {
+		userGroups = groups.Filter(userGroups, c.AllowedGroups)
+		if len(userGroups) == 0 {
+			return nil, ClientGroups
+		}
+	}
+	return userGroups, ""
+}
+
+// admitByConnector returns the groups of a user the connector admits, or the
+// rule that refuses the user.
+func admitByConnector(c storage.Connector, email string, userGroups []string) ([]string, Rule) {
+	if (len(c.AllowedEmails) > 0 || len(c.AllowedEmailDomains) > 0) && !connectorEmailAllowed(c, email) {
+		return nil, ConnectorEmails
+	}
+	if len(c.AllowedGroups) > 0 {
+		userGroups = groups.Filter(userGroups, c.AllowedGroups)
+		if len(userGroups) == 0 {
+			return nil, ConnectorGroups
+		}
+	}
+	return userGroups, ""
+}
+
+// connectorEmailAllowed reports whether email is one of the connector's emails
+// or belongs to one of its domains: the part of the email after the last '@',
+// matched exactly, so a subdomain is another domain. Both compare
+// case-insensitively.
+func connectorEmailAllowed(c storage.Connector, email string) bool {
+	email = normalize(email)
+	if email == "" {
+		return false
+	}
+	for _, allowed := range c.AllowedEmails {
+		if normalize(allowed) == email {
+			return true
+		}
+	}
+
+	at := strings.LastIndex(email, "@")
+	if at < 0 || at == len(email)-1 {
+		return false
+	}
+	domain := email[at+1:]
+	for _, allowed := range c.AllowedEmailDomains {
+		if normalize(allowed) == domain {
+			return true
+		}
+	}
+	return false
+}
+
+func normalize(s string) string {
+	return strings.ToLower(strings.TrimSpace(s))
+}
diff --git a/server/allowlist/allowlist_test.go b/server/allowlist/allowlist_test.go
