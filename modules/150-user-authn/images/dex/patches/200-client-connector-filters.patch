+var allowListPasswordGrant = url.Values{
+	"grant_type": {oauth2.GrantTypePassword},
+	"scope":      {"openid email groups offline_access"},
+	"username":   {allowListEmail},
+	"password":   {allowListPassword},
+}
+
+// tokenGroups returns the groups claim of the token named field in a token
+// response.
+func tokenGroups(t *testing.T, rr *httptest.ResponseRecorder, field string) []string {
+	t.Helper()
+	var resp map[string]any
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &resp))
+	token, ok := resp[field].(string)
+	require.True(t, ok, "no %s in %s", field, rr.Body.String())
+
+	claimed, ok := decodeJWTClaims(t, token)["groups"].([]any)
+	require.True(t, ok, "no groups claim")
+	groups := make([]string, 0, len(claimed))
+	for _, g := range claimed {
+		groups = append(groups, fmt.Sprint(g))
+	}
+	return groups
+}
