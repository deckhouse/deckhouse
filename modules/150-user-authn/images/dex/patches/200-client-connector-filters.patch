+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/allowlist"
+	"github.com/dexidp/dex/storage"
+)
+
+func TestCheckAllowLists(t *testing.T) {
+	var logBuf bytes.Buffer
+	httpServer, server := newTestHandler(t, func(c *testFlowConfig) {
+		c.Logger = slog.New(slog.NewJSONHandler(&logBuf, &slog.HandlerOptions{Level: slog.LevelInfo}))
+	})
+	defer httpServer.Close()
+	ctx := t.Context()
+	require.NoError(t, server.Storage.CreateClient(ctx, storage.Client{ID: "app", AllowedGroups: []string{"staff"}}))
+
+	t.Run("groups are narrowed", func(t *testing.T) {
+		claims := storage.Claims{UserID: "user-1", Email: "user@example.com", Groups: []string{"staff", "x"}}
+		require.NoError(t, server.checkAllowLists(ctx, "app", "mock", &claims))
+		require.Equal(t, []string{"staff"}, claims.Groups)
+	})
+
+	t.Run("refusal is logged", func(t *testing.T) {
+		logBuf.Reset()
+		claims := storage.Claims{UserID: "user-1", Email: "user@example.com", Groups: []string{"x"}}
+		err := server.checkAllowLists(ctx, "app", "mock", &claims)
+
+		var notAllowed *allowlist.NotAllowedError
+		require.ErrorAs(t, err, &notAllowed)
+		var record map[string]any
+		require.NoError(t, json.Unmarshal(logBuf.Bytes(), &record))
+		require.Equal(t, "access denied", record["msg"])
+		require.Equal(t, "WARN", record["level"])
+		require.Equal(t, string(allowlist.ClientGroups), record["rule"])
+		require.Equal(t, "app", record["client_id"])
+		require.Equal(t, "mock", record["connector_id"])
+		require.Equal(t, "user-1", record["user_id"])
+	})
+
+	t.Run("missing client is an error, not a refusal", func(t *testing.T) {
+		claims := storage.Claims{UserID: "user-1", Email: "user@example.com"}
+		err := server.checkAllowLists(ctx, "gone", "mock", &claims)
+
+		require.ErrorIs(t, err, storage.ErrNotFound)
+		var notAllowed *allowlist.NotAllowedError
+		require.False(t, errors.As(err, &notAllowed))
+	})
+}
+
+func TestRenderNotAllowed(t *testing.T) {
+	httpServer, server := newTestHandler(t, nil)
+	defer httpServer.Close()
+
+	refusal := fmt.Errorf("finalize: %w", &allowlist.NotAllowedError{Rule: allowlist.ClientEmails, ClientID: "app", ConnectorID: "mock"})
+	rr := httptest.NewRecorder()
+	require.True(t, server.renderNotAllowed(httptest.NewRequest(http.MethodGet, "/", nil), rr, refusal))
+	require.Equal(t, http.StatusUnauthorized, rr.Code)
+	require.Contains(t, rr.Body.String(), ErrMsgAccessDenied)
+	require.NotContains(t, rr.Body.String(), string(allowlist.ClientEmails), "the page does not name the list")
+
+	rr = httptest.NewRecorder()
+	require.False(t, server.renderNotAllowed(httptest.NewRequest(http.MethodGet, "/", nil), rr, errors.New("storage down")))
+	require.Equal(t, 0, rr.Body.Len(), "other errors are left to the caller")
+}
