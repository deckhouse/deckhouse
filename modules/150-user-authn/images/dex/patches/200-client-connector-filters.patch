+// claims of the refresh token's user (see allowlist.Apply). A refused user
+// loses the client's refresh token, as a refused login gets none; msg is the
+// log line of the refusal.
+func (g *refresh) checkAllowLists(ctx context.Context, client storage.Client, refreshToken *storage.RefreshToken, claims *storage.Claims, msg string) *oauth2.Error {
+	err := allowlist.Apply(ctx, g.storage, client, refreshToken.ConnectorID, claims)
+	oerr := allowListError(ctx, g.logger, err, msg,
+		"connector_id", refreshToken.ConnectorID, "client_id", client.ID, "user_id", refreshToken.Claims.UserID)
