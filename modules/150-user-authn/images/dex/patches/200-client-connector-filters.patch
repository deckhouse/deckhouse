+func TestRefreshAllowLists(t *testing.T) {
+	tests := []struct {
+		name   string
+		limits allowListLimits
+		// upstreamGroups are the groups the connector answers the refresh with.
+		upstreamGroups []string
+		expectedGroups []string
+		// expectedRefreshes is 0 when the stored claims are refused, before the
+		// connector is asked.
+		expectedRefreshes int
+	}{
+		{
+			name:              "lists narrow the groups from the connector again",
+			limits:            allowListLimits{client: storage.Client{AllowedGroups: []string{"developers"}}},
+			upstreamGroups:    allowListGroups,
+			expectedGroups:    []string{"developers"},
+			expectedRefreshes: 1,
+		},
+		{
+			name:           "client email list refuses the stored claims",
+			limits:         allowListLimits{client: storage.Client{AllowedEmails: []string{"john@example.com"}}},
+			upstreamGroups: allowListGroups,
+		},
+		{
+			name:           "connector group list refuses the stored claims",
+			limits:         allowListLimits{corp: storage.Connector{AllowedGroups: []string{"admins"}}},
+			upstreamGroups: allowListGroups,
+		},
+		{
+			name:              "client group list refuses the groups from the connector",
+			limits:            allowListLimits{client: storage.Client{AllowedGroups: []string{"developers"}}},
+			upstreamGroups:    []string{"admins"},
+			expectedRefreshes: 1,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			s := newAllowListServer(t, tc.limits)
+			refreshToken := createAllowListRefresh(t, s)
+			corp, err := s.connectors.Get(ctx, "corp")
+			require.NoError(t, err)
+			var refreshes int
+			s.connectors.Set("corp", connectors.Connector{
+				ResourceVersion: corp.ResourceVersion,
+				Connector:       allowListRefreshConnector{groups: tc.upstreamGroups, refreshes: &refreshes},
+			})
+
+			rr := postAllowListToken(t, s, url.Values{
+				"grant_type":    {oauth2.GrantTypeRefreshToken},
+				"refresh_token": {refreshToken},
+			})
+
+			require.Equal(t, tc.expectedRefreshes, refreshes)
+			if tc.expectedGroups != nil {
+				require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+				require.Equal(t, tc.expectedGroups, tokenGroups(t, rr, "id_token"))
+				return
+			}
+			require.Equal(t, http.StatusUnauthorized, rr.Code)
+			require.JSONEq(t, accessDeniedRefusal, rr.Body.String())
+
+			// The refused user loses the refresh token, with its reference.
+			_, err = s.storage.GetRefresh(ctx, "refresh")
+			require.ErrorIs(t, err, storage.ErrNotFound)
+			offline, err := s.storage.GetOfflineSessions(ctx, allowListUserID, "corp")
+			require.NoError(t, err)
+			require.NotContains(t, offline.Refresh, "app")
+		})
+	}
+}
