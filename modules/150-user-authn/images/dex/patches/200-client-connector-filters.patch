new file mode 100644
index 00000000..baf7b016
--- /dev/null
+++ b/server/grants/allowlist.go
@@ -0,0 +1,29 @@
+package grants
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"net/http"
+
+	"github.com/dexidp/dex/server/allowlist"
+	"github.com/dexidp/dex/server/oauth2"
+)
+
+// allowListError maps the outcome of the allow-lists (allowlist.Apply) to the
+// token response, or returns nil when err is nil. A refused user gets
+// access_denied with HTTP 401, as from the v2.44-based Deckhouse dex. msg and
+// attrs make the log line of a refusal.
+func allowListError(ctx context.Context, logger *slog.Logger, err error, msg string, attrs ...any) *oauth2.Error {
+	var notAllowed *allowlist.NotAllowedError
+	switch {
+	case err == nil:
+		return nil
+	case errors.As(err, &notAllowed):
+		logger.WarnContext(ctx, msg, append(attrs, "rule", notAllowed.Rule)...)
+		return &oauth2.Error{Type: oauth2.AccessDenied, Description: "User is not allowed.", Status: http.StatusUnauthorized}
+	default:
+		logger.ErrorContext(ctx, "failed to apply the allow-lists", append(attrs, "err", err)...)
+		return &oauth2.Error{Type: oauth2.ServerError, Status: http.StatusInternalServerError}
+	}
+}
