+++ b/server/server_allowlist_test.go
@@ -0,0 +1,568 @@
+package server
+
+// Allow-lists of the client and the connector (Deckhouse, server/allowlist) on
+// every path that issues tokens for a user: the login form, SPNEGO, the
+// connector callback, and the password, refresh-token and token-exchange grants.
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/storage"
+)
+
+// The local user of the allow-list tests and the mock callback connector's one.
+const (
+	allowListEmail    = "jane@example.com"
+	allowListPassword = "secret"
+	allowListUserID   = "jane-id"
+	mockCallbackEmail = "kilgore@kilgore.trout"
+	mockCallbackUser  = "0-385-28089-0"
+)
+
+var (
+	allowListGroups     = []string{"admins", "developers"}
+	accessDeniedRefusal = `{"error":"access_denied","error_description":"User is not allowed."}`
+)
+
+// allowListLimits are the allow-lists of one test: of the client "app", of the
+// local connector and of the callback connector "corp".
+type allowListLimits struct {
+	client storage.Client
+	local  storage.Connector
+	corp   storage.Connector
+}
+
+// newAllowListServer serves the client "app" (secret "secret"), the local
+// connector with the user jane@example.com in the groups admins and
+// developers, and the callback connector "corp", each with its limits.
+func newAllowListServer(t *testing.T, limits allowListLimits, updateConfig ...func(*Config)) *Server {
+	t.Helper()
+	ctx := t.Context()
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.PasswordConnector = connectors.LocalConnector
+		c.Now = time.Now
+		for _, update := range updateConfig {
+			update(c)
+		}
+	})
+	t.Cleanup(httpServer.Close)
+
+	client := limits.client
+	client.ID, client.Secret, client.RedirectURIs = "app", "secret", []string{"cb"}
+	require.NoError(t, s.storage.CreateClient(ctx, client))
+
+	local := limits.local
+	local.ID, local.Type, local.Name, local.ResourceVersion = connectors.LocalConnector, connectors.LocalConnector, "Email", "1"
+	require.NoError(t, s.storage.CreateConnector(ctx, local))
+	corp := limits.corp
+	corp.ID, corp.Type, corp.Name, corp.ResourceVersion = "corp", "mockCallback", "Corp", "1"
+	require.NoError(t, s.storage.CreateConnector(ctx, corp))
+
+	hash, err := bcrypt.GenerateFromPassword([]byte(allowListPassword), bcrypt.DefaultCost)
+	require.NoError(t, err)
+	require.NoError(t, s.storage.CreatePassword(ctx, storage.Password{
+		Email:    allowListEmail,
+		Username: "jane",
+		UserID:   allowListUserID,
+		Groups:   allowListGroups,
+		Hash:     hash,
+	}))
+	return s
+}
+
+func createAllowListAuthRequest(t *testing.T, s *Server, connectorID string) {
+	t.Helper()
+	require.NoError(t, s.storage.CreateAuthRequest(t.Context(), storage.AuthRequest{
+		ID:            "req",
+		ClientID:      "app",
+		ConnectorID:   connectorID,
+		RedirectURI:   "cb",
+		Expiry:        time.Now().Add(time.Minute),
+		ResponseTypes: []string{oauth2.ResponseTypeCode},
+		Scopes:        []string{"openid", "email", "groups"},
+	}))
+}
+
+// allowListLogin is who signs in, and through which connector.
+type allowListLogin struct {
+	userID      string
+	email       string
+	connectorID string
+	// groups are the user's groups at the connector.
+	groups []string
+}
+
+var (
+	localLogin = allowListLogin{allowListUserID, allowListEmail, connectors.LocalConnector, allowListGroups}
+	corpLogin  = allowListLogin{mockCallbackUser, mockCallbackEmail, "corp", []string{"authors"}}
+)
+
+// requireLoginRefused checks the page of a refused login and that nothing was
+// recorded for it.
+func requireLoginRefused(t *testing.T, s *Server, rr *httptest.ResponseRecorder, login allowListLogin) {
+	t.Helper()
+	require.Equal(t, http.StatusUnauthorized, rr.Code, rr.Body.String())
+	require.Contains(t, rr.Body.String(), "Access denied. Please contact your administrator.")
+	require.NotContains(t, rr.Body.String(), login.email, "the page must not name the user")
+
+	authReq, err := s.storage.GetAuthRequest(t.Context(), "req")
+	require.NoError(t, err)
+	require.False(t, authReq.LoggedIn)
+	_, err = s.storage.GetUserIdentity(t.Context(), login.userID, login.connectorID)
+	require.ErrorIs(t, err, storage.ErrNotFound, "a refused login records nothing")
+}
+
+// requireLoginIssued checks a login that passed: the request carries the groups
+// the allow-lists admit, the user identity keeps the connector's.
+func requireLoginIssued(t *testing.T, s *Server, rr *httptest.ResponseRecorder, login allowListLogin, issued []string) {
+	t.Helper()
+	require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+
+	authReq, err := s.storage.GetAuthRequest(t.Context(), "req")
+	require.NoError(t, err)
+	require.True(t, authReq.LoggedIn)
+	require.Equal(t, issued, authReq.Claims.Groups)
