+// The success lines of a login and of a token exchange name the groups the
+// tokens carry, not all the groups the connector gave.
+func TestAllowListSuccessLogsIssuedGroups(t *testing.T) {
+	var logs bytes.Buffer
+	s := newAllowListServer(t, allowListLimits{client: storage.Client{AllowedGroups: []string{"authors", "editors"}}},
+		func(c *Config) {
+			c.Logger = slog.New(slog.NewJSONHandler(&logs, &slog.HandlerOptions{Level: slog.LevelInfo}))
+		})
+	corp, err := s.connectors.Get(t.Context(), "corp")
+	require.NoError(t, err)
+	s.connectors.Set("corp", connectors.Connector{
+		ResourceVersion: corp.ResourceVersion,
+		Connector: allowListIdentityConnector{connector.Identity{
+			UserID: mockCallbackUser, Email: mockCallbackEmail, EmailVerified: true, Groups: []string{"authors", "staff"},
+		}},
+	})
+
+	createAllowListAuthRequest(t, s, "corp")
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, httptest.NewRequest(http.MethodGet, "/callback/corp?state=req", nil))
+	require.Equal(t, http.StatusSeeOther, rr.Code, rr.Body.String())
+
+	rr = postAllowListToken(t, s, url.Values{
+		"grant_type":         {oauth2.GrantTypeTokenExchange},
+		"connector_id":       {"corp"},
+		"scope":              {"openid groups"},
+		"subject_token_type": {oauth2.TokenTypeID},
+		"subject_token":      {"subject"},
+	})
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+
+	logged := map[string][]any{}
+	for line := range strings.Lines(logs.String()) {
+		var record map[string]any
+		require.NoError(t, json.Unmarshal([]byte(line), &record))
+		if msg, _ := record["msg"].(string); strings.HasSuffix(msg, "successful") {
+			logged[msg], _ = record["groups"].([]any)
+		}
+	}
+	require.Equal(t, map[string][]any{
+		"login successful":          {"authors"},
+		"token exchange successful": {"authors"},
+	}, logged)
+}
