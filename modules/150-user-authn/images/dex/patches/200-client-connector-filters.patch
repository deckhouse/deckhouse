+package allowlist
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+func TestAdmitByClient(t *testing.T) {
+	tests := []struct {
+		name           string
+		client         storage.Client
+		email          string
+		groups         []string
+		expectedGroups []string
+		expectedRule   Rule
+	}{
+		{
+			name:           "no allow-lists keep the groups",
+			email:          "jane@example.com",
+			groups:         []string{"d8-users", "d8-users-test"},
+			expectedGroups: []string{"d8-users", "d8-users-test"},
+		},
+		{
+			name:           "listed email is admitted",
+			client:         storage.Client{AllowedEmails: []string{"jane@example.com"}},
+			email:          "jane@example.com",
+			groups:         []string{"d8-users"},
+			expectedGroups: []string{"d8-users"},
+		},
+		{
+			name:         "other email is refused",
+			client:       storage.Client{AllowedEmails: []string{"jane@example.com"}},
+			email:        "john@example.com",
+			expectedRule: ClientEmails,
+		},
+		{
+			name:         "email compares exactly",
+			client:       storage.Client{AllowedEmails: []string{"jane@example.com"}},
+			email:        "Jane@example.com",
+			expectedRule: ClientEmails,
+		},
+		{
+			name:         "user without an email is refused by an email list",
+			client:       storage.Client{AllowedEmails: []string{""}},
+			expectedRule: ClientEmails,
+		},
+		{
+			name:           "groups are narrowed to the intersection",
+			client:         storage.Client{AllowedGroups: []string{"d8-users"}},
+			email:          "jane@example.com",
+			groups:         []string{"d8-users", "d8-users-test"},
+			expectedGroups: []string{"d8-users"},
+		},
+		{
+			name:         "empty intersection is refused",
+			client:       storage.Client{AllowedGroups: []string{"d8-users-test"}},
+			email:        "jane@example.com",
+			groups:       []string{"d8-users"},
+			expectedRule: ClientGroups,
+		},
+		{
+			name:         "user without groups is refused by a group list",
+			client:       storage.Client{AllowedGroups: []string{"d8-users"}},
+			email:        "jane@example.com",
+			expectedRule: ClientGroups,
+		},
+		{
+			name:         "email is checked before groups",
+			client:       storage.Client{AllowedEmails: []string{"jane@example.com"}, AllowedGroups: []string{"d8-users"}},
+			email:        "john@example.com",
+			groups:       []string{"d8-users"},
+			expectedRule: ClientEmails,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			groups, rule := admitByClient(tc.client, tc.email, tc.groups)
+			require.Equal(t, tc.expectedRule, rule)
+			require.Equal(t, tc.expectedGroups, groups)
+		})
+	}
+}
+
+func TestAdmitByConnector(t *testing.T) {
+	tests := []struct {
+		name           string
+		conn           storage.Connector
+		email          string
+		groups         []string
+		expectedGroups []string
+		expectedRule   Rule
+	}{
+		{
+			name:           "no limits keep the groups",
+			email:          "jane@example.com",
+			groups:         []string{"a", "b"},
+			expectedGroups: []string{"a", "b"},
+		},
+		{
+			name:           "email compares case-insensitively",
+			conn:           storage.Connector{AllowedEmails: []string{" Jane@Example.com "}},
+			email:          "jane@example.com",
+			groups:         []string{"a"},
+			expectedGroups: []string{"a"},
+		},
+		{
+			name:         "email outside the list is refused",
+			conn:         storage.Connector{AllowedEmails: []string{"jane@example.com"}},
+			email:        "john@example.com",
+			expectedRule: ConnectorEmails,
+		},
+		{
+			name:           "domain compares case-insensitively",
+			conn:           storage.Connector{AllowedEmailDomains: []string{"Contractor.Example"}},
+			email:          "alice@contractor.example",
+			groups:         []string{"a"},
+			expectedGroups: []string{"a"},
+		},
+		{
+			name:         "subdomain is another domain",
+			conn:         storage.Connector{AllowedEmailDomains: []string{"example.com"}},
+			email:        "alice@corp.example.com",
+			expectedRule: ConnectorEmails,
+		},
+		{
+			name:         "domain is the part after the last at sign",
+			conn:         storage.Connector{AllowedEmailDomains: []string{"evil.example"}},
+			email:        `"x@evil.example"@corp.example`,
+			expectedRule: ConnectorEmails,
+		},
+		{
+			name:         "email ending with an at sign has no domain",
+			conn:         storage.Connector{AllowedEmailDomains: []string{""}},
+			email:        "alice@",
+			expectedRule: ConnectorEmails,
+		},
+		{
+			name: "either an email or a domain is enough",
+			conn: storage.Connector{
+				AllowedEmails:       []string{"boss@partner.example"},
+				AllowedEmailDomains: []string{"contractor.example"},
+			},
+			email: "boss@partner.example",
+		},
+		{
+			name:         "email without a domain is refused when only domains are listed",
+			conn:         storage.Connector{AllowedEmailDomains: []string{"contractor.example"}},
+			email:        "alice",
+			expectedRule: ConnectorEmails,
+		},
+		{
+			name:         "user without an email is refused by an email list",
+			conn:         storage.Connector{AllowedEmails: []string{" "}},
+			expectedRule: ConnectorEmails,
+		},
+		{
+			name:           "groups are narrowed to the intersection",
+			conn:           storage.Connector{AllowedGroups: []string{"contractors"}},
+			email:          "alice@contractor.example",
+			groups:         []string{"contractors", "other-team"},
+			expectedGroups: []string{"contractors"},
+		},
+		{
+			name:         "empty intersection is refused",
+			conn:         storage.Connector{AllowedGroups: []string{"contractors"}},
+			email:        "carol@contractor.example",
+			groups:       []string{"other-team"},
+			expectedRule: ConnectorGroups,
+		},
+		{
+			name:         "user without groups is refused by a group list",
+			conn:         storage.Connector{AllowedGroups: []string{"contractors"}},
+			email:        "carol@contractor.example",
+			expectedRule: ConnectorGroups,
+		},
+		{
+			name:         "email is checked before groups",
+			conn:         storage.Connector{AllowedEmailDomains: []string{"contractor.example"}, AllowedGroups: []string{"contractors"}},
+			email:        "bob@other.example",
+			groups:       []string{"contractors"},
+			expectedRule: ConnectorEmails,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			groups, rule := admitByConnector(tc.conn, tc.email, tc.groups)
+			require.Equal(t, tc.expectedRule, rule)
+			require.Equal(t, tc.expectedGroups, groups)
+		})
+	}
+}
+
+func TestApply(t *testing.T) {
+	ctx := t.Context()
+	s := storage.WithStaticConnectors(memory.New(slog.New(slog.DiscardHandler)), []storage.Connector{{
+		ID: "corp", Type: "mock", Name: "Corp",
+		AllowedEmailDomains: []string{"corp.example"},
+		AllowedGroups:       []string{"staff", "admins"},
+	}})
+	require.NoError(t, s.CreateConnector(ctx, storage.Connector{ID: "open", Type: "mock", Name: "Open"}))
+	client := storage.Client{ID: "app", AllowedGroups: []string{"staff", "guests"}}
+
+	tests := []struct {
+		name           string
+		client         storage.Client
+		connectorID    string
+		claims         storage.Claims
+		expectedGroups []string
+		expectedRule   Rule
+	}{
+		{
+			name:           "client and static connector narrow the groups in turn",
+			client:         client,
+			connectorID:    "corp",
+			claims:         storage.Claims{UserID: "ann", Email: "ann@corp.example", Groups: []string{"staff", "guests", "admins"}},
+			expectedGroups: []string{"staff"},
+		},
+		{
+			name:           "connector from storage without limits admits the user",
+			client:         client,
+			connectorID:    "open",
+			claims:         storage.Claims{UserID: "ann", Email: "ann@other.example", Groups: []string{"guests", "x"}},
+			expectedGroups: []string{"guests"},
+		},
+		{
+			name:         "client refuses before the connector is read",
+			client:       client,
+			connectorID:  "missing",
+			claims:       storage.Claims{UserID: "ann", Email: "ann@corp.example", Groups: []string{"x"}},
+			expectedRule: ClientGroups,
+		},
+		{
+			name:         "connector refuses what the client admits",
+			client:       client,
+			connectorID:  "corp",
+			claims:       storage.Claims{UserID: "ann", Email: "ann@other.example", Groups: []string{"staff"}},
+			expectedRule: ConnectorEmails,
+		},
+		{
+			name:         "connector groups apply to what the client left",
+			client:       client,
+			connectorID:  "corp",
+			claims:       storage.Claims{UserID: "ann", Email: "ann@corp.example", Groups: []string{"guests", "admins"}},
+			expectedRule: ConnectorGroups,
+		},
+		{
+			name:         "connector missing from storage refuses the user",
+			connectorID:  "missing",
+			claims:       storage.Claims{UserID: "ann", Email: "ann@corp.example"},
+			expectedRule: ConnectorNotFound,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			claims := tc.claims
+			claims.Groups = append([]string(nil), tc.claims.Groups...)
+
+			err := Apply(ctx, s, tc.client, tc.connectorID, &claims)
+			if tc.expectedRule == "" {
+				require.NoError(t, err)
+				require.Equal(t, tc.expectedGroups, claims.Groups)
+				return
+			}
+
+			var notAllowed *NotAllowedError
+			require.ErrorAs(t, err, &notAllowed)
+			require.Equal(t, &NotAllowedError{Rule: tc.expectedRule, ClientID: tc.client.ID, ConnectorID: tc.connectorID}, notAllowed)
+			require.Equal(t, tc.claims, claims, "a refusal must leave the claims as they were")
+		})
+	}
+}
+
+// failingConnectorStorage fails every connector read.
+type failingConnectorStorage struct {
+	storage.Storage
+}
+
+var errStorage = errors.New("storage unavailable")
+
+func (failingConnectorStorage) GetConnector(context.Context, string) (storage.Connector, error) {
+	return storage.Connector{}, errStorage
+}
+
+// TestApplyStorageError keeps a storage failure apart from a refusal: the user
+// is not refused for it, and the caller answers with a server error.
+func TestApplyStorageError(t *testing.T) {
+	s := failingConnectorStorage{memory.New(slog.New(slog.DiscardHandler))}
+	claims := storage.Claims{UserID: "ann", Email: "ann@corp.example", Groups: []string{"staff"}}
+
+	err := Apply(t.Context(), s, storage.Client{ID: "app"}, "corp", &claims)
+
+	require.ErrorIs(t, err, errStorage)
+	var notAllowed *NotAllowedError
+	require.False(t, errors.As(err, &notAllowed))
+	require.Equal(t, []string{"staff"}, claims.Groups)
+}
diff --git a/server/authflow/allowlist.go b/server/authflow/allowlist.go
new file mode 100644
index 00000000..9b80788a
--- /dev/null
+++ b/server/authflow/allowlist.go
@@ -0,0 +1,50 @@
+package authflow
+
+// allowlist.go applies the allow-lists of the client and the connector to a
+// login (Deckhouse; see server/allowlist).
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+
+	"github.com/dexidp/dex/server/allowlist"
+	"github.com/dexidp/dex/storage"
+)
+
+// checkAllowLists applies the allow-lists of the client clientID and of the
+// connector connectorID to the claims of a user signing in, and narrows
+// claims.Groups to the groups they admit (see allowlist.Apply). A refusal is
+// *allowlist.NotAllowedError, logged here; renderNotAllowed renders it.
+//
+// finalizeLogin calls it before anything is recorded for a login through a
+// connector. A login from a browser session (trySessionLoginWithSession) is to
+// call it the same way, with the claims of the stored user identity; it does
+// not yet.
+func (h *Handler) checkAllowLists(ctx context.Context, clientID, connectorID string, claims *storage.Claims) error {
+	client, err := h.Storage.GetClient(ctx, clientID)
+	if err != nil {
+		return fmt.Errorf("get client %q: %w", clientID, err)
+	}
+
+	err = allowlist.Apply(ctx, h.Storage, client, connectorID, claims)
+	var notAllowed *allowlist.NotAllowedError
+	if errors.As(err, &notAllowed) {
+		h.Logger.WarnContext(ctx, "access denied",
+			"connector_id", connectorID, "client_id", clientID, "user_id", claims.UserID, "rule", notAllowed.Rule)
+	}
+	return err
+}
+
+// renderNotAllowed renders the page of a login that an allow-list refused and
+// reports whether err is such a refusal. The page does not say which list
+// refused the user.
+func (h *Handler) renderNotAllowed(r *http.Request, w http.ResponseWriter, err error) bool {
+	var notAllowed *allowlist.NotAllowedError
+	if !errors.As(err, &notAllowed) {
+		return false
+	}
+	h.renderError(r, w, http.StatusUnauthorized, ErrMsgAccessDenied)
+	return true
+}
