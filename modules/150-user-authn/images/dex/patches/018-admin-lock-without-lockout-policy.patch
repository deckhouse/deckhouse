+func TestHandlePasswordLoginHonorsOfflineSessionAdminLockWithoutPasswordPolicy(t *testing.T) {
+	ctx := t.Context()
+	connID := "mockPw"
+	until := time.Now().Add(time.Hour)
+
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.SkipApprovalScreen = true
+		c.Now = time.Now
+	})
+	defer httpServer.Close()
+	require.Nil(t, s.passwordPolicy)
+
+	sc := storage.Connector{
+		ID:              connID,
+		Type:            "mockPassword",
+		Name:            "MockPassword",
+		ResourceVersion: "1",
+		Config:          []byte(`{"username": "foo", "password": "password"}`),
+	}
+	require.NoError(t, s.storage.CreateConnector(ctx, sc))
+	if _, err := s.OpenConnector(sc); err != nil {
+		t.Fatalf("open connector: %v", err)
+	}
+	require.NoError(t, s.storage.CreateAuthRequest(ctx, storage.AuthRequest{
+		ID:            "test",
+		ConnectorID:   connID,
+		RedirectURI:   "cb",
+		Expiry:        time.Now().Add(100 * time.Second),
+		ResponseTypes: []string{responseTypeCode},
+	}))
+	require.NoError(t, s.storage.CreateOfflineSessions(ctx, storage.OfflineSessions{
+		UserID:      "0-385-28089-0",
+		ConnID:      connID,
+		Email:       "foo@example.com",
+		Refresh:     map[string]*storage.RefreshTokenRef{},
+		LockedUntil: &until,
+	}))
+
+	rr := httptest.NewRecorder()
+	path := fmt.Sprintf("/auth/%s/login?state=test&back=&login=foo&password=password", connID)
+	s.handlePasswordLogin(rr, httptest.NewRequest("POST", path, nil))
+	require.Equal(t, http.StatusTooManyRequests, rr.Code)
+}
