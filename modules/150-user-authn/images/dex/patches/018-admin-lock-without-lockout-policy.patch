+func TestHandlePasswordLoginHonorsAdminLockWithoutPasswordPolicy(t *testing.T) {
+	ctx := t.Context()
+
+	hash, err := bcrypt.GenerateFromPassword([]byte("correct-password"), bcrypt.DefaultCost)
+	require.NoError(t, err)
+
+	future := time.Now().Add(time.Hour)
+	past := time.Now().Add(-time.Minute)
+
+	complexityOnly, err := NewPasswordPolicy("test-policy", WithComplexityLevel("low"))
+	require.NoError(t, err)
+
+	tests := []struct {
+		name           string
+		passwordPolicy *PasswordPolicy
+		lockedUntil    *time.Time
+		password       string
+		expectedCode   int
+	}{
+		{
+			name:         "administrator lock blocks login when passwordPolicy is unset",
+			lockedUntil:  &future,
+			password:     "correct-password",
+			expectedCode: http.StatusTooManyRequests,
+		},
+		{
+			name:           "administrator lock blocks login when passwordPolicy has no lockout",
+			passwordPolicy: complexityOnly,
+			lockedUntil:    &future,
+			password:       "correct-password",
+			expectedCode:   http.StatusTooManyRequests,
+		},
+		{
+			name:         "expired lock does not block login",
+			lockedUntil:  &past,
+			password:     "correct-password",
+			expectedCode: http.StatusSeeOther,
+		},
+		{
+			name:         "wrong password without lockout stays 401, not 429",
+			password:     "wrong-password",
+			expectedCode: http.StatusUnauthorized,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, s := newTestServer(t, func(c *Config) {
+				c.SkipApprovalScreen = false
+				c.Now = time.Now
+				c.PasswordPolicy = tc.passwordPolicy
+			})
+			defer httpServer.Close()
+			if tc.passwordPolicy == nil {
+				require.Nil(t, s.passwordPolicy)
+			}
+
+			sc := storage.Connector{
+				ID:              "local",
+				Type:            "local",
+				Name:            "Local",
+				ResourceVersion: "1",
+			}
+			require.NoError(t, s.storage.CreateConnector(ctx, sc))
+			if _, err := s.OpenConnector(sc); err != nil {
+				t.Fatalf("open connector: %v", err)
+			}
+			require.NoError(t, s.storage.CreateClient(ctx, storage.Client{
+				ID:           "client_1",
+				Secret:       "secret",
+				RedirectURIs: []string{"cb"},
+				Name:         "test",
+			}))
+			require.NoError(t, s.storage.CreateAuthRequest(ctx, storage.AuthRequest{
+				ID:                  "test",
+				ClientID:            "client_1",
+				ConnectorID:         "local",
+				RedirectURI:         "cb",
+				Expiry:              time.Now().Add(100 * time.Second),
+				ResponseTypes:       []string{responseTypeCode},
+				ForceApprovalPrompt: true,
+			}))
+			require.NoError(t, s.storage.CreatePassword(ctx, storage.Password{
+				Email:       "jane@example.com",
+				Username:    "jane",
+				UserID:      "jane-id",
+				Hash:        hash,
+				LockedUntil: tc.lockedUntil,
+			}))
