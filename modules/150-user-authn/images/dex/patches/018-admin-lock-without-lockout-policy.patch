+
+	require.NoError(t, s.storage.CreateClient(ctx, storage.Client{
+		ID:           "test",
+		Secret:       "barfoo",
+		RedirectURIs: []string{"foo://bar.com/"},
+		Name:         "dex client",
+	}))
+	require.NoError(t, s.storage.CreateConnector(ctx, storage.Connector{
+		ID:   "test",
+		Type: "mockCallback",
+		Name: "mockCallback",
+	}))
+	require.NoError(t, s.storage.CreateRefresh(ctx, storage.RefreshToken{
+		ID:          "test",
+		Token:       "bar",
+		Nonce:       "foo",
+		ClientID:    "test",
+		ConnectorID: "test",
+		Scopes:      []string{"openid", "email", "profile"},
+		CreatedAt:   now.UTC().Round(time.Millisecond),
+		LastUsed:    now.UTC().Round(time.Millisecond),
+		Claims: storage.Claims{
+			UserID:        "1",
+			Username:      "jane",
+			Email:         "jane@example.com",
+			EmailVerified: true,
+		},
+	}))
+	require.NoError(t, s.storage.CreateOfflineSessions(ctx, storage.OfflineSessions{
+		UserID:      "1",
+		ConnID:      "test",
+		Refresh:     map[string]*storage.RefreshTokenRef{"test": {ID: "test", ClientID: "test"}},
+		LockedUntil: &until,
+	}))
+
+	tokenData, err := internal.Marshal(&internal.RefreshToken{RefreshId: "test", Token: "bar"})
+	require.NoError(t, err)
+
+	u, err := url.Parse(s.issuerURL.String())
+	require.NoError(t, err)
+	u.Path = path.Join(u.Path, "/token")
+	form := url.Values{}
+	form.Set("grant_type", "refresh_token")
+	form.Set("refresh_token", tokenData)
+	req, err := http.NewRequest(http.MethodPost, u.String(), bytes.NewBufferString(form.Encode()))
+	require.NoError(t, err)
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth("test", "barfoo")
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	require.Equal(t, http.StatusTooManyRequests, rr.Code, rr.Body.String())
+	require.Contains(t, rr.Body.String(), "Account locked")
