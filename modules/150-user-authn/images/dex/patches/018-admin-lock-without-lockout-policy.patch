+// accountHasActiveLock reports whether an administrator lock is in force for
+// this account. Local users store LockedUntil on Password; LDAP/Crowd store
+// it on OfflineSessions. Missing objects are treated as unlocked.
+func (s *Server) accountHasActiveLock(ctx context.Context, userID, email, connID string) (bool, error) {
+	if email != "" {
+		p, err := s.storage.GetPassword(ctx, email)
+		if err != nil && !errors.Is(err, storage.ErrNotFound) {
+			return false, fmt.Errorf("get password: %w", err)
+		}
+		if err == nil && lockedUntilIsActive(p.LockedUntil) {
+			return true, nil
+		}
+	}
+	if userID != "" && connID != "" {
+		session, err := s.storage.GetOfflineSessions(ctx, userID, connID)
+		if err != nil && !errors.Is(err, storage.ErrNotFound) {
+			return false, fmt.Errorf("get offline sessions: %w", err)
+		}
+		if err == nil && lockedUntilIsActive(session.LockedUntil) {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, v := range values {
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+func (s *Server) rejectIfAccountLocked(ctx context.Context, w http.ResponseWriter, userID, email, connID, username string) bool {
+	locked, err := s.accountHasActiveLock(ctx, userID, email, connID)
+	if err != nil {
+		s.logger.ErrorContext(ctx, "failed to read lock state", "err", err, "connector_id", connID)
+		s.tokenErrHelper(w, errServerError, "", http.StatusInternalServerError)
+		return true
+	}
+	if !locked {
+		return false
+	}
+	s.logger.WarnContext(ctx, "token request for locked account",
+		"username", username,
+		"email", email,
+		"connector_id", connID,
+	)
+	s.tokenErrHelper(w, errAccessDenied, "Account locked", http.StatusTooManyRequests)
+	return true
+}
+
+// lockAfterFailedPasswordGrant records a failed ROPC attempt and writes HTTP
+// 429 when this attempt crosses the configured threshold. passwordDB.Login
+// already incremented Password.IncorrectPasswordLoginAttempts; non-local
+// connectors use OfflineSessions via recordOfflineSessionFailedAttempt.
+// Returns true when the handler must stop (response already written).
+func (s *Server) lockAfterFailedPasswordGrant(ctx context.Context, w http.ResponseWriter, localConnector bool, identity connector.Identity, username, connID string) bool {
+	if s.passwordPolicy == nil {
+		return false
+	}
+	if localConnector {
+		return s.lockLocalPasswordIfThresholdReached(ctx, w, username)
+	}
+	if identity.UserID == "" || !s.nonLocalLockoutEnabled(ctx, connID) {
+		return false
+	}
+	lockedNow, err := s.recordOfflineSessionFailedAttempt(ctx, identity, connID)
+	if err != nil {
+		s.logger.ErrorContext(ctx, "failed to record failed attempt in offline session", "err", err)
+		return false
+	}
+	if !lockedNow {
+		return false
+	}
+	s.logger.WarnContext(ctx, "account locked due to too many failed attempts",
+		"username", username,
+		"connector_id", connID,
+	)
+	s.tokenErrHelper(w, errAccessDenied, "Account locked", http.StatusTooManyRequests)
+	return true
+}
+
+func (s *Server) nonLocalLockoutEnabled(ctx context.Context, connID string) bool {
+	if s.passwordPolicy == nil {
+		return false
+	}
+	storageConn, err := s.storage.GetConnector(ctx, connID)
+	if err != nil {
+		s.logger.ErrorContext(ctx, "failed to load connector for lockout policy lookup",
+			"connector_id", connID, "err", err)
+		return false
+	}
+	return s.passwordPolicy.AppliesToConnectorType(storageConn.Type)
+}
+
+func (s *Server) lockLocalPasswordIfThresholdReached(ctx context.Context, w http.ResponseWriter, username string) bool {
+	p, err := s.storage.GetPassword(ctx, username)
+	if err != nil {
+		if !errors.Is(err, storage.ErrNotFound) {
+			s.logger.ErrorContext(ctx, "failed to get password for lockout", "err", err)
+		}
+		return false
+	}
+	if !s.passwordPolicy.IsMaxLoginAttemptsExeeded(p.IncorrectPasswordLoginAttempts) {
+		return false
+	}
+	until := time.Now().Add(s.passwordPolicy.LockDuration())
+	if err := s.storage.UpdatePassword(ctx, username, func(p storage.Password) (storage.Password, error) {
+		p.LockedUntil = &until
+		p.IncorrectPasswordLoginAttempts = 0
+		return p, nil
+	}); err != nil {
+		s.logger.ErrorContext(ctx, "failed to lock account", "username", username, "err", err)
+		return false
+	}
+	s.logger.WarnContext(ctx, "account locked due to too many failed attempts",
+		"username", username,
+		"attempts", p.IncorrectPasswordLoginAttempts,
+		"locked_until", until,
+	)
+	s.tokenErrHelper(w, errAccessDenied, "Account locked", http.StatusTooManyRequests)
+	return true
+}
+
+// resetFailedAttemptsAfterPasswordGrant clears OfflineSessions lockout
+// counters after a successful ROPC. Local counters are already reset inside
+// passwordDB.Login. Missing sessions are ignored (first successful grant).
+func (s *Server) resetFailedAttemptsAfterPasswordGrant(ctx context.Context, localConnector bool, identity connector.Identity, connID string) error {
+	if localConnector || identity.UserID == "" {
+		return nil
+	}
+	err := s.storage.UpdateOfflineSessions(ctx, identity.UserID, connID, func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+		if identity.Email != "" {
+			old.Email = identity.Email
+		}
+		old.IncorrectPasswordLoginAttempts = 0
+		// rejectIfAccountLocked already ran; an expired lock is stale.
+		old.LockedUntil = nil
+		return old, nil
+	})
+	if errors.Is(err, storage.ErrNotFound) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("reset offline session lockout: %w", err)
+	}
+	return nil
+}
