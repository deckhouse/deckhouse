+type lockoutPasswordConnector struct {
+	username string
+	password string
+	userID   string
+	email    string
+}
+
+var _ connector.PasswordConnector = lockoutPasswordConnector{}
+
+func (c lockoutPasswordConnector) Login(_ context.Context, _ connector.Scopes, username, password string) (connector.Identity, bool, error) {
+	if username != c.username {
+		return connector.Identity{}, false, nil
+	}
+	if password != c.password {
+		return connector.Identity{UserID: c.userID, Email: c.email}, false, nil
+	}
+	return connector.Identity{
+		UserID:        c.userID,
+		Username:      username,
+		Email:         c.email,
+		EmailVerified: true,
+	}, true, nil
+}
+
+func (c lockoutPasswordConnector) Prompt() string { return "" }
