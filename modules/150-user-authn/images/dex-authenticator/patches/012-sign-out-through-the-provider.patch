new file mode 100644
index 00000000..74e5c834
--- /dev/null
+++ b/deckhouse_sign_out_provider_logout_test.go
@@ -0,0 +1,88 @@
+package main
+
+import (
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const providerLogout = "https://dex.example.com/logout"
+
+func withProviderLogoutURL(providerLogoutURL string) OptionsModifier {
+	return func(opts *options.Options) {
+		opts.ProviderLogoutURL = providerLogoutURL
+	}
+}
+
+// TestSignOutThroughTheProvider checks that sign-out sends the browser to the logout endpoint of the
+// provider by client_id, back to the root of the host, whatever the sign-out redirect, after the refresh
+// token of the session is revoked.
+func TestSignOutThroughTheProvider(t *testing.T) {
+	tests := []struct {
+		name        string
+		session     *sessions.SessionState
+		wantRevoked bool
+	}{
+		{
+			name:        "session",
+			session:     &sessions.SessionState{Email: "jane.doe@example.com", IDToken: "id-token", RefreshToken: signOutRefresh},
+			wantRevoked: true,
+		},
+		{
+			// A global logout ended the session already: the session of the provider still goes.
+			name: "no session",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			endpoint := &revokeEndpoint{}
+			server := httptest.NewServer(endpoint.handler(answerOK))
+			t.Cleanup(server.Close)
+
+			rw := signOut(t, tt.session, "?rd="+url.QueryEscape("https://app.example.com/elsewhere"),
+				withRevocationURL(server.URL+"/token/revoke"),
+				withProviderLogoutURL(providerLogout+"?ui_locales=ru"),
+			)
+
+			assert.Equal(t, 302, rw.Code)
+			location, err := url.Parse(rw.Header().Get("Location"))
+			require.NoError(t, err)
+			assert.Equal(t, "https", location.Scheme)
+			assert.Equal(t, "dex.example.com", location.Host)
+			assert.Equal(t, "/logout", location.Path)
+			assert.Equal(t, url.Values{
+				"client_id":                {clientID},
+				"post_logout_redirect_uri": {"https://example.com/"},
+				"ui_locales":               {"ru"},
+			}, location.Query())
+			assert.NotContains(t, location.String(), "id-token", "no token in the address")
+			if tt.wantRevoked {
+				assertSignedOut(t, rw)
+				assert.Equal(t, 1, endpoint.calls())
+			} else {
+				assert.Zero(t, endpoint.calls())
+			}
+		})
+	}
+}
+
+func TestParseProviderLogoutURL(t *testing.T) {
+	u, err := parseProviderLogoutURL("")
+	require.NoError(t, err)
+	assert.Nil(t, u)
+
+	u, err = parseProviderLogoutURL(providerLogout)
+	require.NoError(t, err)
+	assert.Equal(t, providerLogout, u.String())
+
+	for _, raw := range []string{"http://dex.example.com/logout", "/logout", "https://", "https://dex example.com/"} {
+		_, err := parseProviderLogoutURL(raw)
+		assert.Error(t, err, raw)
+	}
+}
