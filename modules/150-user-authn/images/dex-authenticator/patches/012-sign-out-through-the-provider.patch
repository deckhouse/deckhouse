+// parseProviderLogoutURL parses --provider-logout-url, the RP-initiated logout endpoint of the
+// provider; nil when it is empty.
+func parseProviderLogoutURL(raw string) (*url.URL, error) {
+	if raw == "" {
+		return nil, nil
+	}
+	u, err := url.Parse(raw)
+	if err != nil {
+		return nil, fmt.Errorf("invalid provider-logout-url: %v", err)
+	}
+	if u.Scheme != "https" || u.Host == "" {
+		return nil, fmt.Errorf("invalid provider-logout-url %q: an absolute https URL is expected", raw)
+	}
+	return u, nil
+}
+
+// providerLogoutRedirect is where the browser goes after sign-out with --provider-logout-url (Deckhouse
+// patch 012): the RP-initiated logout endpoint of the provider, which ends the session of the provider
+// in this browser and with it the other applications signed in through it, and then returns to the
+// root of the host the user signed out on. The client is named by client_id, so no token goes into the
+// address, and the provider returns only to the addresses registered for the client. The sign-out
+// redirect (rd) does not change it.
+func (p *OAuthProxy) providerLogoutRedirect(req *http.Request) string {
+	u := *p.providerLogoutURL
+	q := u.Query()
+	q.Set("client_id", p.provider.Data().ClientID)
+	q.Set("post_logout_redirect_uri", "https://"+requestutil.GetRequestHost(req)+"/")
+	u.RawQuery = q.Encode()
+	return u.String()
+}
