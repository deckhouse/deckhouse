+// saveNewSession saves the session of a new sign-in under a new session ticket (Deckhouse patch 002).
+// With the ticket of the session cookie the browser still has, another replica that keeps the previous
+// session under that ticket in its own Redis would serve the previous session, not the new one, until
+// its next refresh.
+func (p *OAuthProxy) saveNewSession(rw http.ResponseWriter, req *http.Request, s *sessionsapi.SessionState) error {
+	return p.SaveSession(rw, requestWithoutCookie(req, p.CookieOptions.Name), s)
+}
+
+// requestWithoutCookie returns a copy of the request without the cookies of a name.
+func requestWithoutCookie(req *http.Request, name string) *http.Request {
+	if _, err := req.Cookie(name); err != nil {
+		return req
+	}
+
+	clone := req.Clone(req.Context())
+	clone.Header.Del("Cookie")
+	for _, c := range req.Cookies() {
+		if c.Name != name {
+			clone.AddCookie(c)
+		}
+	}
+	return clone
+}
+
+// sessionUnavailableRetryAfter is the Retry-After, in seconds, of the 503 answered while the session
+// of a request cannot be refreshed (Deckhouse patch 002).
+const sessionUnavailableRetryAfter = "10"
+
+// writeSessionUnavailable answers 503 to a request whose session cannot be refreshed now: the provider
+// is unreachable or answered a temporary error. The session and its cookie are kept, so the request
+// works again once the provider is back (Deckhouse patch 002).
+func writeSessionUnavailable(rw http.ResponseWriter) {
+	rw.Header().Set("Retry-After", sessionUnavailableRetryAfter)
+	http.Error(rw, http.StatusText(http.StatusServiceUnavailable), http.StatusServiceUnavailable)
+}
