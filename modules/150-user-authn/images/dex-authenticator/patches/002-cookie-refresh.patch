diff --git a/pkg/middleware/deckhouse_late_refresh.go b/pkg/middleware/deckhouse_late_refresh.go
new file mode 100644
index 00000000..092343c5
--- /dev/null
+++ b/pkg/middleware/deckhouse_late_refresh.go
@@ -0,0 +1,229 @@
+package middleware
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"maps"
+	"net/http"
+	"slices"
+	"time"
+
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/logger"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/providers"
+)
+
+// sessionRefreshAnswerTimeout is how long the answer of the provider to a refresh is waited for,
+// from its start (Deckhouse patch 002). A request waits for sessionRefreshTimeout and is then
+// answered as for a provider that does not answer; the refresh goes on apart from it, since a
+// provider that is slow, not down, completes it and rotates the refresh token. The answer is then
+// saved in the store instead of being lost with the request. The refresh holds the lock of the
+// session all that time, so no other request of the session presents the token being replaced.
+const sessionRefreshAnswerTimeout = time.Minute
+
+// errRefreshPending is the outcome of a refresh for the request that started it and was answered
+// before the provider was: the refresh goes on and owns the lock of the session.
+var errRefreshPending = fmt.Errorf("the provider has not answered yet: %w", context.DeadlineExceeded)
+
+// refreshAnswer is what the provider answered a refresh with: the session it refreshed, a copy of
+// the one of the request, and the outcome.
+type refreshAnswer struct {
+	session     *sessionsapi.SessionState
+	isRefreshed bool
+	err         error
+}
+
+// askProvider refreshes a copy of the session at the provider, apart from the request, and
+// returns the channel of its answer. The request takes the answer from the channel while it
+// waits. A request that stops waiting sends its clone to handover instead: the answer is then
+// saved in the store with that clone, and the lock of the session is released.
+func (s *storedSessionLoader) askProvider(req *http.Request, session *sessionsapi.SessionState) (<-chan refreshAnswer, chan<- *http.Request) {
+	answers := make(chan refreshAnswer)
+	handover := make(chan *http.Request, 1)
+	// The provider works on a copy: the request goes on with its session once it stops waiting.
+	refreshed := *session
+	refreshed.Groups = slices.Clone(session.Groups)
+	refreshed.AdditionalClaims = maps.Clone(session.AdditionalClaims)
+	replaced := session.RefreshToken
+	// The stub of a session restored from the cookie has no ID token: the store has no data for it.
+	wasStored := session.IDToken != ""
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(req.Context()), s.refreshAnswerTimeout())
+
+	go func() {
+		defer cancel()
+		// Nothing recovers a panic of this goroutine but itself: the store is called here too.
+		defer func() {
+			if r := recover(); r != nil {
+				logger.Errorf("panic while refreshing a session apart from its request: %v", r)
+			}
+		}()
+
+		answer := refreshAnswer{session: &refreshed}
+		answer.isRefreshed, answer.err = s.refreshAtProvider(ctx, &refreshed)
+		if errors.Is(answer.err, providers.ErrNotImplemented) {
+			// HACK:
+			// Providers that don't implement `RefreshSession` use the default
+			// implementation which returns `ErrNotImplemented`.
+			// Pretend it refreshed to reset the refresh timer so that `ValidateSession`
+			// isn't triggered every subsequent request and is only called once during
+			// this request.
+			answer.isRefreshed, answer.err = true, nil
+		}
+		if answer.err == nil && answer.isRefreshed {
+			markRefreshed(&refreshed, replaced)
+		}
+
+		select {
+		case answers <- answer:
+		case lateReq := <-handover:
+			s.saveLateRefresh(lateReq, answer, replaced, wasStored)
+		}
+	}()
+
+	return answers, handover
+}
+
+func (s *storedSessionLoader) refreshAnswerTimeout() time.Duration {
+	if s.answerTimeout == 0 {
+		return sessionRefreshAnswerTimeout
+	}
+
+	return s.answerTimeout
+}
+
+// refreshAtProvider calls the provider. It runs in a goroutine of its own, where a panic of the
+// provider code would end the process instead of the request, so a panic is an error here.
+func (s *storedSessionLoader) refreshAtProvider(ctx context.Context, session *sessionsapi.SessionState) (isRefreshed bool, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			isRefreshed, err = false, fmt.Errorf("panic while refreshing the session: %v", r)
+		}
+	}()
+
+	return s.sessionRefresher(ctx, session)
+}
+
+// markRefreshed resets the refresh timer of a session the provider refreshed (in case underlying
+// provider implementations forget) and records the refresh token the refresh replaced, with the time
+// of the answer: the store honours the record only for a short time after it.
+func markRefreshed(session *sessionsapi.SessionState, replaced string) {
+	session.CreatedAtNow()
+	if replaced == "" || session.RefreshToken == replaced {
+		return
+	}
+	hash := sha256.Sum256([]byte(replaced))
+	answeredAt := *session.CreatedAt
+	session.ReplacedRefreshTokenHash = hash[:]
+	session.ReplacedRefreshTokenAt = &answeredAt
+}
+
+// handOverRefresh leaves a refresh the provider has not answered within the deadline of the
+// request to go on: the lock of the session is extended to the time the answer is waited for, and
+// the goroutine of the refresh gets a clone of the request to save the answer with.
+func (s *storedSessionLoader) handOverRefresh(req *http.Request, session *sessionsapi.SessionState, handover chan<- *http.Request) {
+	ctx := context.WithoutCancel(req.Context())
+	if err := session.RefreshLock(ctx, s.refreshAnswerTimeout()); err != nil {
+		// The lock then expires before the refresh may end, and another request of the session
+		// may start a refresh of its own.
+		logger.Errorf("unable to extend the lock of a session whose refresh goes on: %v", err)
+	}
+	handover <- req.Clone(ctx)
+}
+
+// saveLateRefresh saves in the store the session the provider refreshed after the request was
+// answered, and releases the lock of the session. The browser still has the cookie with the
+// replaced refresh token: the saved session names that token, so the next request with the cookie
+// gets the saved tokens and a new cookie. A refresh that failed is left to the next request, which
+// has a browser to answer.
+//
+// A session that was in the store when the refresh started and is not there now was ended
+// meanwhile, by a sign-out for one: its answer is dropped, or the cookie the browser was told to
+// forget would open the session again. Nothing is revoked here: the store cannot tell a sign-out
+// from data it lost or cannot read, and a lost session restores from its cookie, whose refresh
+// token the provider still accepts. The sign-out revokes the token of the cookie itself (patch
+// 011).
+func (s *storedSessionLoader) saveLateRefresh(req *http.Request, answer refreshAnswer, replaced string, wasStored bool) {
+	ctx, cancel := context.WithTimeout(req.Context(), sessionRefreshLockMargin)
+	defer cancel()
+	defer func() {
+		// The release has its own deadline: a store that used up the one above still gives the
+		// lock back, or the session would wait for the lock to expire.
+		releaseCtx, cancelRelease := context.WithTimeout(context.WithoutCancel(ctx), sessionRefreshLockMargin)
+		defer cancelRelease()
+		if err := answer.session.ReleaseLock(releaseCtx); err != nil {
+			logger.Errorf("unable to release lock: %v", err)
+		}
+	}()
+
+	if answer.err != nil {
+		logger.Errorf("Unable to refresh session after its request was answered: %v", answer.err)
+		return
+	}
+	if !answer.isRefreshed {
+		return
+	}
+
+	s.unavailable.forget(replaced)
+	req = req.WithContext(ctx)
+	if wasStored && s.isEnded(req) {
+		logger.Printf("Dropped a refresh of a session that was ended while the provider answered - User: %s", answer.session.User)
+		return
+	}
+	if err := s.store.Save(discardResponse{}, req, answer.session); err != nil {
+		logger.Errorf("error saving a session refreshed after its request was answered: %v", err)
+		return
+	}
+	logger.Printf("Saved a session refreshed after its request was answered - User: %s", answer.session.User)
+}
+
+// isEnded reports whether the store no longer has the session of the request: it loads the stub
+// of the cookie instead, which has no ID token.
+func (s *storedSessionLoader) isEnded(req *http.Request) bool {
+	current, err := s.store.Load(req)
+	return err != nil || current == nil || current.IDToken == ""
+}
+
+// discardResponse is the response of a request that has been answered: saving a session writes
+// its cookie there, and that cookie has no one to go to.
+type discardResponse struct{}
+
+func (discardResponse) Header() http.Header         { return http.Header{} }
+func (discardResponse) Write(b []byte) (int, error) { return len(b), nil }
+func (discardResponse) WriteHeader(int)             {}
+
+// renewStaleCookie writes the cookie of a session again when the request came with a cookie that
+// is behind it: the store keeps the session of a refresh whose answer did not reach the browser.
+//
+// Writing the cookie saves the session, so it is done under the lock of the session and with the
+// session loaded under it: a refresh of another request may have replaced the tokens since this
+// request loaded them, and saving the older ones would put a replaced refresh token back. A
+// failure costs nothing: the session is served, and the next request tries again.
+func (s *storedSessionLoader) renewStaleCookie(rw http.ResponseWriter, req *http.Request, session *sessionsapi.SessionState) {
+	if !session.StaleCookie {
+		return
+	}
+	session.StaleCookie = false
+
+	ctx := context.WithoutCancel(req.Context())
+	if err := session.ObtainLock(ctx, sessionRefreshLockMargin); err != nil {
+		// A refresh holds the lock: its answer writes the cookie.
+		return
+	}
+	defer func() {
+		if err := session.ReleaseLock(ctx); err != nil {
+			logger.Errorf("unable to release lock: %v", err)
+		}
+	}()
+
+	fresh, err := s.store.Load(req)
+	if err != nil || fresh == nil || !fresh.StaleCookie {
+		return
+	}
+	fresh.Lock, fresh.StaleCookie = session.Lock, false
+	*session = *fresh
+	if err := s.store.Save(rw, req, session); err != nil {
+		logger.Errorf("error saving a session to write its cookie again: %v", err)
+	}
+}
diff --git a/pkg/middleware/deckhouse_late_refresh_test.go b/pkg/middleware/deckhouse_late_refresh_test.go
new file mode 100644
index 00000000..876d31ec
--- /dev/null
+++ b/pkg/middleware/deckhouse_late_refresh_test.go
@@ -0,0 +1,833 @@
+package middleware
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"maps"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	middlewareapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/middleware"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/persistence"
+	sessiontests "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/tests"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func hashOf(refreshToken string) []byte {
+	sum := sha256.Sum256([]byte(refreshToken))
+	return sum[:]
+}
+
+// expiredLoader returns the loader of a session that cannot be served without a refresh: the
+// provider no longer validates its ID token.
+func (s *lockedSessionStore) expiredLoader() *storedSessionLoader {
+	loader := s.loader()
+	loader.sessionValidator = func(context.Context, *sessionsapi.SessionState) bool { return false }
+	return loader
+}
+
+// stored returns the session the store holds now.
+func (s *lockedSessionStore) stored() sessionsapi.SessionState {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.session
+}
+
+// A refresh dex answers in time records the token it replaced, so that a cookie that still
+// carries it is known to be behind the session.
+func TestRefreshRecordsTheReplacedToken(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		store := newLockedSessionStore(time.Second)
+
+		scope := serveSession(t.Context(), store.loader())
+
+		require.NotNil(t, scope.Session)
+		assert.Equal(t, "rotated-refresh-token-1", scope.Session.RefreshToken)
+		assert.Equal(t, hashOf("refresh-token"), scope.Session.ReplacedRefreshTokenHash)
+		assert.Equal(t, hashOf("refresh-token"), store.stored().ReplacedRefreshTokenHash)
+		require.NotNil(t, store.stored().ReplacedRefreshTokenAt)
+		assert.Equal(t, time.Now(), *store.stored().ReplacedRefreshTokenAt, "with the time of the answer")
+		assert.True(t, store.lock.isFree())
+	})
+}
+
+// A provider that keeps the refresh token replaces nothing: the cookie is never behind.
+func TestRefreshWithoutRotationRecordsNoReplacedToken(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		store := newLockedSessionStore(time.Second)
+		loader := store.loader()
+		loader.sessionRefresher = func(context.Context, *sessionsapi.SessionState) (bool, error) { return true, nil }
+
+		scope := serveSession(t.Context(), loader)
+
+		require.NotNil(t, scope.Session)
+		assert.Equal(t, "refresh-token", scope.Session.RefreshToken)
+		assert.Empty(t, scope.Session.ReplacedRefreshTokenHash)
+		assert.Nil(t, scope.Session.ReplacedRefreshTokenAt)
+	})
+}
+
+// A refresh dex completes after the deadline of the request is not lost: the request is answered
+// as for a dex that does not answer, the refresh goes on under the lock of the session, and its
+// answer is saved in the store with the token it replaced. Until then the other requests of the
+// session wait for the lock and start no refresh of their own.
+func TestLateRefreshIsSaved(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		// dex answers 25 seconds after the request, past the 10 seconds a request waits for.
+		store := newLockedSessionStore(25 * time.Second)
+		loader := store.expiredLoader()
+		started := time.Now()
+
+		scope := serveSession(t.Context(), loader)
+
+		assert.Equal(t, sessionRefreshTimeout, time.Since(started), "the request waits for its own deadline only")
+		assert.True(t, scope.SessionUnavailable, "the request is answered as for a dex that does not answer")
+		assert.False(t, store.cleared)
+		assert.Equal(t, "refresh-token", store.stored().RefreshToken)
+		assert.False(t, store.lock.isFree(), "the refresh still holds the lock of the session")
+		assert.Empty(t, store.writers)
+
+		// A second request of the session, 15 seconds after the first one: the lock a request takes
+		// would have expired by now.
+		time.Sleep(5 * time.Second)
+		scope = serveSession(t.Context(), loader)
+		assert.True(t, scope.SessionUnavailable, "a request that cannot get the lock is answered the same way")
+		assert.EqualValues(t, 1, store.refreshes.Load(), "and starts no second refresh")
+
+		time.Sleep(10 * time.Second)
+		synctest.Wait()
+		assert.True(t, store.lock.isFree(), "the lock is released once the answer is saved")
+		saved := store.stored()
+		assert.Equal(t, "rotated-refresh-token-1", saved.RefreshToken)
+		assert.Equal(t, hashOf("refresh-token"), saved.ReplacedRefreshTokenHash)
+		assert.Equal(t, 5*time.Second, saved.Age(), "the session is as old as its tokens")
+		require.NotNil(t, saved.ReplacedRefreshTokenAt)
+		assert.Equal(t, *saved.CreatedAt, *saved.ReplacedRefreshTokenAt, "the record has the time of the answer")
+		require.Len(t, store.writers, 1)
+		assert.NotNil(t, store.writers[0])
+		_, isRecorder := store.writers[0].(*httptest.ResponseRecorder)
+		assert.False(t, isRecorder, "the response of the answered request is not written to")
+		assert.Empty(t, loader.unavailable.since, "a refresh dex answered ends the window of the session")
+
+		scope = serveSession(t.Context(), loader)
+		require.NotNil(t, scope.Session)
+		assert.False(t, scope.SessionUnavailable)
+		assert.Equal(t, "rotated-refresh-token-1", scope.Session.RefreshToken)
+		assert.EqualValues(t, 1, store.refreshes.Load(), "the saved session needs no refresh")
+	})
+}
+
+// A refresh dex refuses after the deadline of the request changes nothing: the next request of the
+// session asks dex again and ends the session with the browser there to get the answer.
+func TestLateRefreshFailureIsLeftToTheNextRequest(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		store := newLockedSessionStore(25 * time.Second)
+		store.refreshErr = retrieveError(http.StatusBadRequest, "invalid_grant")
+		loader := store.expiredLoader()
+
+		scope := serveSession(t.Context(), loader)
+		assert.True(t, scope.SessionUnavailable)
+
+		time.Sleep(15 * time.Second)
+		synctest.Wait()
+		assert.True(t, store.lock.isFree())
+		assert.False(t, store.cleared, "nothing ends the session behind the back of the browser")
+		assert.Equal(t, "refresh-token", store.stored().RefreshToken)
+		assert.Empty(t, store.writers)
