+		assert.NotNil(t, scope.Session)
+		assert.False(t, scope.SessionUnavailable)
+		assert.False(t, cleared)
+		assert.Empty(t, loader.unavailable.since)
+	})
+}
+
+// expiringLock is the lock of one session in the store, which every copy of the session the store
+// loads shares, with the expiry of the Redis lock: it is free again once the duration given to
+// Obtain has passed. Like the Redis client, it releases nothing on a context that is done.
+type expiringLock struct {
+	mu      sync.Mutex
+	holder  *expiringLockHandle
+	expires time.Time
+	// notHeld counts the releases of a lock that had expired or passed to another request.
+	notHeld int
+	// expiration is the duration of the last lock obtained.
+	expiration time.Duration
+}
+
+type expiringLockHandle struct {
+	lock *expiringLock
+}
+
+func (h *expiringLockHandle) Obtain(_ context.Context, expiration time.Duration) error {
+	l := h.lock
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.holder != nil && time.Now().Before(l.expires) {
+		return sessionsapi.ErrLockNotObtained
+	}
+	l.holder, l.expires, l.expiration = h, time.Now().Add(expiration), expiration
+	return nil
+}
+
+func (h *expiringLockHandle) Peek(context.Context) (bool, error) {
+	l := h.lock
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.holder != nil && time.Now().Before(l.expires), nil
+}
+
+func (h *expiringLockHandle) Refresh(_ context.Context, expiration time.Duration) error {
+	l := h.lock
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.holder != h || !time.Now().Before(l.expires) {
+		return sessionsapi.ErrNotLocked
+	}
+	l.expires, l.expiration = time.Now().Add(expiration), expiration
+	return nil
+}
+
+func (h *expiringLockHandle) Release(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	l := h.lock
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.holder != h || !time.Now().Before(l.expires) {
+		l.notHeld++
+		return sessionsapi.ErrNotLocked
+	}
+	l.holder = nil
+	return nil
+}
+
+// isFree reports whether no request holds the lock.
+func (l *expiringLock) isFree() bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.holder == nil || !time.Now().Before(l.expires)
+}
+
+// lockedSessionStore keeps one session behind an expiringLock and counts the refreshes of a dex that
+// takes refreshDelay to answer each of them.
+type lockedSessionStore struct {
+	lock *expiringLock
+
+	mu      sync.Mutex
+	session sessionsapi.SessionState
+	cleared bool
+
+	refreshDelay time.Duration
+	// refreshErr is what dex answers every refresh with, once refreshDelay has passed.
+	refreshErr error
+	refreshes  atomic.Int32
+	// writers are the response writers the session was saved with.
+	writers []http.ResponseWriter
+}
+
+func newLockedSessionStore(refreshDelay time.Duration) *lockedSessionStore {
+	createdAt := time.Now().Add(-time.Hour)
+	return &lockedSessionStore{
+		lock:         &expiringLock{},
+		session:      sessionsapi.SessionState{CreatedAt: &createdAt, RefreshToken: "refresh-token", IDToken: "id-token"},
+		refreshDelay: refreshDelay,
+	}
+}
+
+func (s *lockedSessionStore) loader() *storedSessionLoader {
+	return newStoredSessionLoader(&StoredSessionLoaderOptions{
+		SessionStore: &fakeSessionStore{
+			LoadFunc: func(*http.Request) (*sessionsapi.SessionState, error) {
+				s.mu.Lock()
+				defer s.mu.Unlock()
+				loaded := s.session
+				loaded.Lock = &expiringLockHandle{lock: s.lock}
+				return &loaded, nil
+			},
+			SaveFunc: func(rw http.ResponseWriter, _ *http.Request, ss *sessionsapi.SessionState) error {
+				s.mu.Lock()
+				defer s.mu.Unlock()
+				s.session = *ss
+				s.session.Lock = nil
+				s.writers = append(s.writers, rw)
+				return nil
+			},
+			ClearFunc: func(http.ResponseWriter, *http.Request) error {
+				s.mu.Lock()
+				defer s.mu.Unlock()
+				s.cleared = true
+				return nil
+			},
+		},
+		RefreshPeriod: time.Minute,
+		RefreshSession: func(ctx context.Context, ss *sessionsapi.SessionState) (bool, error) {
+			n := s.refreshes.Add(1)
+			select {
+			case <-ctx.Done():
+				return false, fmt.Errorf("failed to get token: %w", ctx.Err())
+			case <-time.After(s.refreshDelay):
+			}
+			if s.refreshErr != nil {
+				return false, fmt.Errorf("failed to get token: %w", s.refreshErr)
+			}
+			ss.RefreshToken = fmt.Sprintf("rotated-refresh-token-%d", n)
+			return true, nil
+		},
+		ValidateSession: func(context.Context, *sessionsapi.SessionState) bool { return true },
+	})
+}
+
+func serveSession(ctx context.Context, loader *storedSessionLoader) *middlewareapi.RequestScope {
+	scope := &middlewareapi.RequestScope{}
+	req := middlewareapi.AddRequestScope(httptest.NewRequestWithContext(ctx, http.MethodGet, "/", nil), scope)
+	loader.loadSession(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(httptest.NewRecorder(), req)
+	return scope
+}
+
+// One refresh of a session runs at a time, for as long as it runs: the lock of the session outlives
+// the refresh, and a request that waits for it gets the refreshed session or, once its own wait runs
+// out, the answer of a provider that does not answer, without a refresh of its own.
+func TestRefreshLockOutlivesTheRefresh(t *testing.T) {
+	tests := []struct {
+		name          string
+		refreshDelay  time.Duration
+		obtainTimeout time.Duration
+		requests      int
+		// laterUnavailable is how many requests after the first answer that the session cannot be
+		// refreshed now.
+		laterUnavailable int
+	}{
+		{
+			name:         "a refresh longer than the lock of upstream",
+			refreshDelay: 2500 * time.Millisecond,
+			requests:     3,
+		},
+		{
+			name:             "the wait for the lock runs out",
+			refreshDelay:     600 * time.Millisecond,
+			obtainTimeout:    200 * time.Millisecond,
+			requests:         3,
+			laterUnavailable: 2,
+		},
+		{
+			name:         "a healthy dex",
+			refreshDelay: 20 * time.Millisecond,
+			requests:     10,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			store := newLockedSessionStore(tc.refreshDelay)
+			loader := store.loader()
+			if tc.obtainTimeout > 0 {
+				loader.obtainTimeout = tc.obtainTimeout
+			}
+
+			scopes := make([]*middlewareapi.RequestScope, tc.requests)
+			var wg sync.WaitGroup
+			wg.Go(func() { scopes[0] = serveSession(t.Context(), loader) })
+			// The other requests of the session come once the first holds the lock.
+			require.Eventually(t, func() bool { return store.refreshes.Load() == 1 }, time.Second, time.Millisecond)
+			for i := 1; i < tc.requests; i++ {
+				wg.Go(func() { scopes[i] = serveSession(t.Context(), loader) })
+			}
+			wg.Wait()
+
+			assert.EqualValues(t, 1, store.refreshes.Load(), "one refresh through dex for the session")
+			assert.NotNil(t, scopes[0].Session, "the refreshing request gets the session")
+			assert.False(t, scopes[0].SessionUnavailable)
+			unavailable := 0
+			for i, scope := range scopes[1:] {
+				if scope.SessionUnavailable {
+					unavailable++
+					continue
+				}
+				assert.NotNil(t, scope.Session, "request %d gets the refreshed session", i+1)
+			}
+			assert.Equal(t, tc.laterUnavailable, unavailable)
+			assert.False(t, store.cleared, "the session is kept")
+			assert.Zero(t, store.lock.notHeld, "the lock is held until its refresh releases it")
+			assert.True(t, store.lock.isFree())
+			assert.Equal(t, "rotated-refresh-token-1", store.session.RefreshToken)
+		})
+	}
+}
+
+// The lock of a session lives longer than the refresh it guards, whatever the refresh timeout is.
+func TestRefreshLockLongerThanTheRefreshTimeout(t *testing.T) {
+	tests := []struct {
+		name           string
+		refreshTimeout time.Duration
+	}{
+		{name: "the default refresh timeout", refreshTimeout: sessionRefreshTimeout},
+		{name: "a longer refresh timeout", refreshTimeout: 3 * sessionRefreshTimeout},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			store := newLockedSessionStore(0)
+			loader := store.loader()
+			loader.refreshTimeout = tc.refreshTimeout
+
+			serveSession(t.Context(), loader)
+			assert.EqualValues(t, 1, store.refreshes.Load())
+			assert.Greater(t, store.lock.expiration, tc.refreshTimeout)
+		})
+	}
+}
+
+// The lock is released when the client that started the refresh has hung up: the other requests of
+// the session would otherwise wait for it to expire.
+func TestRefreshLockReleasedForAClientThatHungUp(t *testing.T) {
+	store := newLockedSessionStore(20 * time.Millisecond)
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+
+	scope := serveSession(ctx, store.loader())
+	assert.NotNil(t, scope.Session)
+	assert.EqualValues(t, 1, store.refreshes.Load())
+	assert.True(t, store.lock.isFree(), "the lock is released")
+}
+
+// A refresh the provider does not answer leaves a session that cannot be trusted without it. The stub
+// of a session restored from the cookie has no ID token: it is not given to the provider to verify,
+// which can only fail ("malformed jwt"). A stored session with an ID token is verified as before.
+func TestRefreshUnavailableValidatesOnlyAnIDToken(t *testing.T) {
+	tests := []struct {
+		name          string
+		idToken       string
+		wantValidated bool
+	}{
+		{name: "the stub of a cookie", wantValidated: false},
+		{name: "a stored session", idToken: "id-token", wantValidated: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			createdAt := time.Now().Add(-time.Hour)
+			var validated bool
+			loader := newStoredSessionLoader(&StoredSessionLoaderOptions{
+				SessionStore: &fakeSessionStore{
+					LoadFunc: func(*http.Request) (*sessionsapi.SessionState, error) {
+						return &sessionsapi.SessionState{CreatedAt: &createdAt, RefreshToken: "refresh-token", IDToken: tc.idToken, Lock: &testLock{}}, nil
+					},
+				},
+				RefreshPeriod: time.Minute,
+				RefreshSession: func(context.Context, *sessionsapi.SessionState) (bool, error) {
+					return false, fmt.Errorf("unable to redeem refresh token: %w", fmt.Errorf("failed to get token: %w", context.DeadlineExceeded))
+				},
+				ValidateSession: func(context.Context, *sessionsapi.SessionState) bool {
+					validated = true
+					return false
+				},
+			})
+
+			scope := serveSession(t.Context(), loader)
+			assert.True(t, scope.SessionUnavailable, "a provider that does not answer leaves the session unavailable")
+			assert.Equal(t, tc.wantValidated, validated)
+		})
+	}
+}
