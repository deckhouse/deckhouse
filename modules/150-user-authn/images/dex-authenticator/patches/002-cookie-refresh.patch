+// strictProvider is a provider that refuses a replaced refresh token: every refresh token it issued
+// is valid for exactly one refresh.
+type strictProvider struct {
+	delay time.Duration
+	// failure fails every refresh without an answer about the refresh token.
+	failure error
+
+	mu        sync.Mutex
+	valid     map[string]bool
+	issued    int
+	refusals  int
+	presented []string
+	revoked   []string
+}
+
+func newStrictProvider(refreshToken string) *strictProvider {
+	return &strictProvider{valid: map[string]bool{refreshToken: true}}
+}
+
+func (p *strictProvider) refresh(ctx context.Context, ss *sessionsapi.SessionState) (bool, error) {
+	select {
+	case <-ctx.Done():
+		return false, fmt.Errorf("failed to get token: %w", ctx.Err())
+	case <-time.After(p.delay):
+	}
+
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.presented = append(p.presented, ss.RefreshToken)
+	if p.failure != nil {
+		return false, fmt.Errorf("failed to get token: %w", p.failure)
+	}
+	if !p.valid[ss.RefreshToken] {
+		p.refusals++
+		return false, fmt.Errorf("failed to get token: %w", retrieveError(http.StatusBadRequest, "invalid_grant"))
+	}
+	delete(p.valid, ss.RefreshToken)
+	p.issued++
+	ss.RefreshToken = fmt.Sprintf("rotated-refresh-token-%d", p.issued)
+	ss.IDToken = fmt.Sprintf("id-token-%d", p.issued)
+	p.valid[ss.RefreshToken] = true
+
+	return true, nil
+}
+
+// revoke revokes a refresh token, and with it the grant: the grant has no other valid token.
+func (p *strictProvider) revoke(_ context.Context, refreshToken string) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.revoked = append(p.revoked, refreshToken)
+	delete(p.valid, refreshToken)
+}
+
+// validTokens returns the refresh tokens the provider would refresh now.
+func (p *strictProvider) validTokens() []string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return slices.Sorted(maps.Keys(p.valid))
+}
+
+func (p *strictProvider) revokedTokens() []string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return slices.Clone(p.revoked)
+}
+
+func (p *strictProvider) refused() int {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.refusals
+}
+
+// cookieBrowser is a browser with the ticket cookie of one session, behind the stored session
+// loader of a persistent store.
+type cookieBrowser struct {
+	loader  *storedSessionLoader
+	cookies []*http.Cookie
+}
+
+// serve sends one request of the browser and keeps the cookie its answer sets or clears.
+func (b *cookieBrowser) serve(t *testing.T) *middlewareapi.RequestScope {
+	t.Helper()
+
+	scope := &middlewareapi.RequestScope{}
+	req := middlewareapi.AddRequestScope(httptest.NewRequest(http.MethodGet, "http://example.com/", nil), scope)
+	for _, c := range b.cookies {
+		req.AddCookie(c)
+	}
+	rw := httptest.NewRecorder()
+	b.loader.loadSession(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(rw, req)
+	for _, c := range rw.Result().Cookies() {
+		if c.MaxAge < 0 || c.Value == "" {
+			b.cookies = nil
+			continue
+		}
+		b.cookies = []*http.Cookie{c}
+	}
+
+	return scope
+}
+
+// lockingStore is a persistent store of one session whose lock blocks as the lock of Redis does: the
+// lock of the mock store is always obtained.
+type lockingStore struct {
+	mu    sync.Mutex
+	store persistence.Store
+	lock  *expiringLock
+}
+
+func (s *lockingStore) Save(ctx context.Context, key string, value []byte, exp time.Duration) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.store.Save(ctx, key, value, exp)
+}
+
+func (s *lockingStore) Load(ctx context.Context, key string) ([]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.store.Load(ctx, key)
+}
+
+func (s *lockingStore) Clear(ctx context.Context, key string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.store.Clear(ctx, key)
+}
+
+func (s *lockingStore) Lock(string) sessionsapi.Lock {
+	return &expiringLockHandle{lock: s.lock}
+}
+
+func (s *lockingStore) VerifyConnection(ctx context.Context) error {
+	return s.store.VerifyConnection(ctx)
+}
+
+// signInWithStrictProvider signs a user in through the persistent store and returns the loader of
+// the store and the cookie of the sign-in.
+func signInWithStrictProvider(t *testing.T, provider *strictProvider, refreshPeriod time.Duration) (*storedSessionLoader, []*http.Cookie) {
+	t.Helper()
+
+	cookieOpts := &options.Cookie{Name: "_oauth2_proxy", Secret: strings.Repeat("s", 32), Expire: 24 * time.Hour}
+	manager := persistence.NewManager(&lockingStore{store: sessiontests.NewMockStore(), lock: &expiringLock{}}, cookieOpts)
+	loader := newStoredSessionLoader(&StoredSessionLoaderOptions{
+		SessionStore:    manager,
+		RefreshPeriod:   refreshPeriod,
+		RefreshSession:  provider.refresh,
+		ValidateSession: func(_ context.Context, ss *sessionsapi.SessionState) bool { return ss.IDToken != "" },
+	})
+
+	createdAt := time.Now()
+	signIn := httptest.NewRecorder()
+	require.NoError(t, manager.Save(signIn, httptest.NewRequest(http.MethodGet, "http://example.com/", nil), &sessionsapi.SessionState{
+		CreatedAt:    &createdAt,
+		Email:        "john.doe@example.com",
+		RefreshToken: "refresh-token",
+		IDToken:      "id-token",
+	}))
+	cookies := signIn.Result().Cookies()
+	require.Len(t, cookies, 1)
+
+	return loader, cookies
+}
+
+// Two copies of one cookie used in turn, once per refresh period each, with a provider that refuses
+// a replaced refresh token. Each copy is one refresh behind the session when it comes. The record
+// of the replaced token must not hand the tokens of the session to such a copy long after the
+// refresh: the copies would take the tokens from each other after every refresh and stay signed in
+// until the cookie expires. The first refresh of the copy that is behind is refused instead, and
+// the copy is signed out, as without the record.
+func TestCopiesOfACookieDoNotKeepEachOtherAlive(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		const refreshPeriod = 10 * time.Minute
+		provider := newStrictProvider("refresh-token")
+		loader, cookies := signInWithStrictProvider(t, provider, refreshPeriod)
+		owner := &cookieBrowser{loader: loader, cookies: cookies}
+		copied := &cookieBrowser{loader: loader, cookies: cookies}
+
+		signedIn := map[*cookieBrowser]int{}
+		for turn := range 10 {
+			time.Sleep(refreshPeriod + time.Second)
+			browser := owner
+			if turn%2 == 1 {
+				browser = copied
+			}
+			if scope := browser.serve(t); scope.Session != nil {
+				signedIn[browser]++
+			}
+		}
+
+		assert.Equal(t, 5, signedIn[owner], "the owner of the cookie stays signed in")
+		assert.Zero(t, signedIn[copied], "the copy is signed out at its first refresh")
+		assert.Empty(t, copied.cookies, "and its cookie is cleared")
+		assert.Equal(t, 1, provider.refused(), "the provider refused the replaced token once")
+	})
+}
+
+// The cases the record of the replaced token is for, with a provider that refuses a replaced
+// refresh token: a request of the browser that carries the cookie the refresh replaced and comes
+// shortly after the refresh gets the tokens of the session and a new cookie, and the session goes
+// on through its next refresh. A cookie that comes back later than replacedRefreshTokenLifetime is
+// not given the tokens: its next refresh is refused.
+func TestReplacedTokenIsHonouredShortlyAfterTheRefresh(t *testing.T) {
+	const refreshPeriod = 10 * time.Minute
+
+	tests := []struct {
+		name string
+		// refreshDelay is how long the provider takes to answer a refresh.
+		refreshDelay time.Duration
+		// comesBackAfter is when, after the answer of the provider, the browser comes back with
+		// the cookie the refresh replaced.
+		comesBackAfter time.Duration
+		isSignedOut    bool
+	}{
+		{
+			name:           "request sent before the answer of an in-time refresh",
+			refreshDelay:   time.Second,
+			comesBackAfter: time.Second,
+		},
+		{
+			name:           "browser back shortly after a late refresh",
+			refreshDelay:   25 * time.Second,
+			comesBackAfter: 5 * time.Second,
+		},
+		{
+			name:           "browser back at the end of the lifetime of the record",
+			refreshDelay:   25 * time.Second,
+			comesBackAfter: 2*time.Minute - time.Second,
+		},
+		{
+			name:           "browser back after the lifetime of the record",
+			refreshDelay:   25 * time.Second,
+			comesBackAfter: 2*time.Minute + time.Second,
+			isSignedOut:    true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				provider := newStrictProvider("refresh-token")
+				provider.delay = tt.refreshDelay
+				loader, cookies := signInWithStrictProvider(t, provider, refreshPeriod)
+				refreshing := &cookieBrowser{loader: loader, cookies: cookies}
+				behind := &cookieBrowser{loader: loader, cookies: cookies}
+
+				time.Sleep(refreshPeriod + time.Second)
+				started := time.Now()
+				refreshing.serve(t)
+				// Wait for the answer of the provider, whether the request waited for it or not.
+				time.Sleep(tt.refreshDelay - time.Since(started))
+				synctest.Wait()
+				time.Sleep(tt.comesBackAfter)
+
+				scope := behind.serve(t)
+				require.NotNil(t, scope.Session, "the session is served to the cookie that is behind it")
+				if !tt.isSignedOut {
+					assert.Equal(t, "rotated-refresh-token-1", scope.Session.RefreshToken, "the cookie gets the token of the refresh")
+					require.Len(t, behind.cookies, 1)
+					assert.NotEqual(t, cookies[0].Value, behind.cookies[0].Value, "and a new cookie")
+				}
+
+				// The next refresh of the session, through the cookie the browser has now.
+				provider.delay = time.Second
+				time.Sleep(refreshPeriod + time.Second)
+				scope = behind.serve(t)
+				if tt.isSignedOut {
+					assert.Nil(t, scope.Session, "the replaced token is refused and the session ends")
+					assert.Empty(t, behind.cookies)
+					assert.Equal(t, 1, provider.refused())
+					return
+				}
+				require.NotNil(t, scope.Session, "the session goes on")
+				assert.Equal(t, "rotated-refresh-token-2", scope.Session.RefreshToken)
+				assert.Zero(t, provider.refused())
+			})
+		})
+	}
+}
+
+// A sign-out while the provider answers a late refresh of the session waits for the lock the
+// refresh holds and gets no session from the loader: it revokes the refresh token of the cookie,
+// which patch 011 loads from the store without the lock, and clears the session in the store and the
+// cookie of the browser. The refresh then finds the session ended and drops its answer; it revokes
+// nothing itself. A copy of the cookie made before the sign-out restores no session once the
+// provider answers again. A late refresh of a session that was not ended is saved.
+func TestLateRefreshOfASignedOutSessionIsDropped(t *testing.T) {
+	const refreshPeriod = 10 * time.Minute
+
+	tests := []struct {
+		name         string
+		refreshDelay time.Duration
+		failure      error
+		isSignedOut  bool
+	}{
+		{
+			name:         "refresh the provider answers after the sign-out",
+			refreshDelay: 25 * time.Second,
+			isSignedOut:  true,
+		},
+		{
+			name:         "refresh that fails without a rotation",
+			refreshDelay: 25 * time.Second,
+			failure:      retrieveError(http.StatusServiceUnavailable, ""),
+			isSignedOut:  true,
+		},
+		{
+			name:         "refresh the provider does not answer",
+			refreshDelay: time.Hour,
+			isSignedOut:  true,
+		},
+		{
+			name:         "session that is not signed out",
+			refreshDelay: 25 * time.Second,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				provider := newStrictProvider("refresh-token")
+				provider.delay = tt.refreshDelay
+				provider.failure = tt.failure
+				loader, cookies := signInWithStrictProvider(t, provider, refreshPeriod)
+				// The ID token of the sign-in has expired: the session cannot be served without
+				// the refresh.
+				loader.sessionValidator = func(_ context.Context, ss *sessionsapi.SessionState) bool { return ss.IDToken != "id-token" }
+				browser := &cookieBrowser{loader: loader, cookies: cookies}
+				copied := &cookieBrowser{loader: loader, cookies: cookies}
+
+				time.Sleep(refreshPeriod + time.Second)
+				started := time.Now()
+				require.True(t, browser.serve(t).SessionUnavailable, "the provider has not answered within the deadline")
+
+				if tt.isSignedOut {
+					// The sign-out, as SignOut does it with patch 011: the loader waits for the
+					// lock and gives no session, the sign-out loads the session from the store
+					// without the lock and revokes the refresh token of the cookie, and the
+					// session is cleared in the store with the cookie of the browser.
+					scope := &middlewareapi.RequestScope{}
+					req := middlewareapi.AddRequestScope(httptest.NewRequest(http.MethodGet, "http://example.com/oauth2/sign_out", nil), scope)
+					for _, c := range browser.cookies {
+						req.AddCookie(c)
+					}
+					loader.loadSession(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(httptest.NewRecorder(), req)
+					require.True(t, scope.SessionUnavailable, "the sign-out cannot load the session")
+					require.Nil(t, scope.Session)
+					stored, err := loader.store.Load(req)
+					require.NoError(t, err)
+					provider.revoke(t.Context(), stored.RefreshToken)
+					require.NoError(t, loader.store.Clear(httptest.NewRecorder(), req))
+				}
+
+				time.Sleep(sessionRefreshAnswerTimeout - time.Since(started))
+				synctest.Wait()
+
+				if !tt.isSignedOut {
+					assert.Empty(t, provider.revokedTokens())
+					scope := browser.serve(t)
+					require.NotNil(t, scope.Session, "the session goes on")
+					assert.Equal(t, "rotated-refresh-token-1", scope.Session.RefreshToken)
+					return
+				}
+
+				assert.Equal(t, []string{"refresh-token"}, provider.revokedTokens(), "the late refresh revokes nothing")
+				assert.Empty(t, provider.validTokens(), "the grant ends at the provider")
+
+				// A copy of the cookie made before the sign-out does not restore the session once
+				// the provider answers again.
+				provider.failure, provider.delay = nil, time.Second
+				scope := copied.serve(t)
+				assert.Nil(t, scope.Session, "the copy of the cookie restores no session")
+				assert.Empty(t, copied.cookies)
+			})
+		})
+	}
+}
+
+// A store that loses the session while the provider answers its late refresh, as a Redis that
+// restarts does, has not ended it: the late refresh that fails revokes nothing, and the cookie the
+// browser kept restores the session through its stub once the provider answers again.
+func TestLateRefreshOfALostSessionKeepsTheGrant(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		const refreshPeriod = 10 * time.Minute
+
+		provider := newStrictProvider("refresh-token")
+		provider.delay = 25 * time.Second
+		provider.failure = retrieveError(http.StatusServiceUnavailable, "")
+		loader, cookies := signInWithStrictProvider(t, provider, refreshPeriod)
+		loader.sessionValidator = func(_ context.Context, ss *sessionsapi.SessionState) bool { return ss.IDToken != "id-token" }
+		browser := &cookieBrowser{loader: loader, cookies: cookies}
+
+		time.Sleep(refreshPeriod + time.Second)
+		started := time.Now()
+		require.True(t, browser.serve(t).SessionUnavailable, "the provider has not answered within the deadline")
+
+		// The store loses the data of the session; the browser keeps its cookie.
+		req := httptest.NewRequest(http.MethodGet, "http://example.com/", nil)
+		for _, c := range browser.cookies {
+			req.AddCookie(c)
+		}
+		require.NoError(t, loader.store.Clear(httptest.NewRecorder(), req))
+
+		time.Sleep(sessionRefreshAnswerTimeout - time.Since(started))
+		synctest.Wait()
+		assert.Empty(t, provider.revokedTokens(), "nothing is revoked")
+		assert.Equal(t, []string{"refresh-token"}, provider.validTokens())
+
+		provider.failure, provider.delay = nil, time.Second
+		scope := browser.serve(t)
+		require.NotNil(t, scope.Session, "the cookie restores the session")
+		assert.Equal(t, "rotated-refresh-token-1", scope.Session.RefreshToken)
+	})
+}
diff --git a/pkg/middleware/deckhouse_refresh_unavailable.go b/pkg/middleware/deckhouse_refresh_unavailable.go
new file mode 100644
index 00000000..d49197ee
--- /dev/null
+++ b/pkg/middleware/deckhouse_refresh_unavailable.go
@@ -0,0 +1,104 @@
+package middleware
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"net/http"
+	"net/url"
+	"sync"
+	"time"
+
+	"golang.org/x/oauth2"
+)
+
+// errRefreshUnavailable means that a session is due for a refresh that cannot be made now: the
+// provider is unreachable or answered a temporary error, or the lock of the session could not be taken
+// (Deckhouse patch 002). Nothing is known against the session, so the loader keeps it with its cookie,
+// which holds the only copy of the refresh token of a session restored from the cookie, and the request
+// is answered 503 instead of being sent to log in.
+var errRefreshUnavailable = errors.New("the session cannot be refreshed now")
+
+// isProviderUnavailable reports whether a refresh failed without an answer of the provider about the
+// refresh token: the request did not reach the provider or got no answer (connection, TLS, timeout), or
+// the provider answered 429 or a 5xx status. dex answers its internal errors with 500 and the OAuth 2.0
+// code invalid_request, so the status decides, not the code, except for a refusal: dex answers the
+// refresh of a locked account with 429 access_denied, and that is an answer about the user.
+func isProviderUnavailable(err error) bool {
+	if retrieveErr, ok := errors.AsType[*oauth2.RetrieveError](err); ok {
+		if retrieveErr.Response == nil || isFatalRefreshError(retrieveErr) {
+			return false
+		}
+		status := retrieveErr.Response.StatusCode
+		return status == http.StatusTooManyRequests || status >= http.StatusInternalServerError
+	}
+
+	_, isTransportErr := errors.AsType[*url.Error](err)
+	return isTransportErr || errors.Is(err, context.DeadlineExceeded) || errors.Is(err, context.Canceled)
+}
+
+const (
+	// unavailableRetention is how long a replica remembers the first failed refresh of a session that
+	// is not tried again: longer than any session lasts without a request.
+	unavailableRetention = 24 * time.Hour
+	// maxUnavailableSessions bounds the memory: a replica tracks at most this many failing sessions,
+	// and a session beyond them is kept as before the bound, answered 503 until dex answers.
+	maxUnavailableSessions = 100000
+)
+
+// unavailableSince remembers when the refresh of each session first failed because the provider did
+// not answer (Deckhouse patch 002), so that the session is not kept answering 503 for ever: the
+// provider may keep answering 5xx for a session it can never refresh. A session is known by the hash
+// of its refresh token, which only a successful refresh changes. The time lives in the memory of the
+// replica: the cookie cannot carry it, since ingress-nginx passes no Set-Cookie of a 503 auth answer
+// on, and the Redis of a pod is its own. Each replica thus ends a session one window after the first
+// failure it saw, and a restart of the pod starts its window again.
+type unavailableSince struct {
+	now func() time.Time
+
+	mu        sync.Mutex
+	since     map[[sha256.Size]byte]time.Time
+	lastSweep time.Time
+}
+
+func newUnavailableSince() *unavailableSince {
+	return &unavailableSince{now: time.Now, since: map[[sha256.Size]byte]time.Time{}}
+}
+
+// failed records a refresh of the session with refreshToken that the provider did not answer, and
+// reports whether the first such failure was longer than window ago.
+func (u *unavailableSince) failed(refreshToken string, window time.Duration) bool {
+	if refreshToken == "" {
+		return false
+	}
+	key := sha256.Sum256([]byte(refreshToken))
+	now := u.now()
+
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	if now.Sub(u.lastSweep) > time.Hour {
+		u.lastSweep = now
+		for k, first := range u.since {
+			if now.Sub(first) > unavailableRetention {
+				delete(u.since, k)
+			}
+		}
+	}
+	first, ok := u.since[key]
+	if !ok {
+		if len(u.since) < maxUnavailableSessions {
+			u.since[key] = now
+		}
+		return false
+	}
+	return now.Sub(first) > window
+}
+
+// forget drops the session with refreshToken: it was refreshed or ended.
+func (u *unavailableSince) forget(refreshToken string) {
+	key := sha256.Sum256([]byte(refreshToken))
+
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	delete(u.since, key)
+}
diff --git a/pkg/middleware/deckhouse_refresh_unavailable_test.go b/pkg/middleware/deckhouse_refresh_unavailable_test.go
new file mode 100644
index 00000000..d7dba17d
--- /dev/null
+++ b/pkg/middleware/deckhouse_refresh_unavailable_test.go
@@ -0,0 +1,689 @@
+package middleware
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	middlewareapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/middleware"
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+)
+
+// retrieveError returns the error the oauth2 package returns for an answer of the token endpoint.
+func retrieveError(status int, code string) error {
+	return &oauth2.RetrieveError{
+		Response:  &http.Response{StatusCode: status, Status: http.StatusText(status)},
+		ErrorCode: code,
+	}
+}
+
+// dexAnswer returns the error the oauth2 package returns for a refresh that dex answers with status
+// and body, so the error carries what the package parses from a real answer.
+func dexAnswer(t *testing.T, status int, body string) error {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(status)
+		_, _ = w.Write([]byte(body))
+	}))
+	t.Cleanup(srv.Close)
+	cfg := &oauth2.Config{ClientID: "dex-authenticator", ClientSecret: "secret", Endpoint: oauth2.Endpoint{TokenURL: srv.URL}}
+	_, err := cfg.TokenSource(t.Context(), &oauth2.Token{RefreshToken: "refresh-token"}).Token()
+	require.Error(t, err)
+	return err
+}
+
+// dexLockedBody is what dex answers to the refresh of a locked account (patch 210 of the Dex image).
+const dexLockedBody = `{"error":"access_denied","error_description":"Account locked"}`
+
+// providerError wraps an error the way the OIDC provider and the loader do on a refresh.
+func providerError(err error) error {
+	return fmt.Errorf("error refreshing tokens: %w",
+		fmt.Errorf("unable to redeem refresh token: %w", fmt.Errorf("failed to get token: %w", err)))
+}
+
+func TestIsProviderUnavailable(t *testing.T) {
+	refused := &url.Error{Op: "Post", URL: "https://dex.d8-user-authn/token", Err: &net.OpError{Op: "dial", Err: errors.New("connection refused")}}
+
+	tests := []struct {
+		name     string
+		err      error
+		expected bool
+	}{
+		{name: "no error", err: nil, expected: false},
+		{name: "connection refused", err: providerError(refused), expected: true},
+		{name: "timeout", err: providerError(context.DeadlineExceeded), expected: true},
+		{name: "503", err: providerError(retrieveError(http.StatusServiceUnavailable, "")), expected: true},
+		{name: "dex internal error", err: providerError(retrieveError(http.StatusInternalServerError, "invalid_request")), expected: true},
+		{name: "429", err: providerError(retrieveError(http.StatusTooManyRequests, "")), expected: true},
+		{name: "invalid grant", err: providerError(retrieveError(http.StatusBadRequest, "invalid_grant")), expected: false},
+		{name: "locked account", err: providerError(retrieveError(http.StatusTooManyRequests, "access_denied")), expected: false},
+		{name: "invalid request", err: providerError(retrieveError(http.StatusBadRequest, "invalid_request")), expected: false},
+		{name: "invalid client", err: providerError(retrieveError(http.StatusUnauthorized, "invalid_client")), expected: false},
+		{name: "answer without a response", err: providerError(&oauth2.RetrieveError{}), expected: false},
+		{name: "other error", err: providerError(errors.New("unable to save session")), expected: false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, isProviderUnavailable(tt.err))
+		})
+	}
+
+	t.Run("answers of dex", func(t *testing.T) {
+		locked := providerError(dexAnswer(t, http.StatusTooManyRequests, dexLockedBody))
+		assert.False(t, isProviderUnavailable(locked), "a locked account is an answer about the user")
+		assert.True(t, isFatalRefreshError(locked))
+		limited := providerError(dexAnswer(t, http.StatusTooManyRequests, "Too many requests\n"))
+		assert.True(t, isProviderUnavailable(limited), "the rate limit of dex is no answer about the token")
+		assert.False(t, isFatalRefreshError(limited))
+	})
+}
+
+// TestLoadSessionKeepsUnavailableSession checks the loader on a session due for a refresh: a refresh that
+// cannot be made now keeps the session and its cookie and marks the request, and a refresh token the
+// provider refuses still clears the session.
+func TestLoadSessionKeepsUnavailableSession(t *testing.T) {
+	tests := []struct {
+		name               string
+		lock               sessionsapi.Lock
+		refreshErr         error
+		expectsUnavailable bool
+		expectsCleared     bool
+	}{
+		{
+			name:               "provider unavailable",
+			lock:               &testLock{},
+			refreshErr:         retrieveError(http.StatusServiceUnavailable, ""),
+			expectsUnavailable: true,
+		},
+		{
+			name:               "lock unavailable",
+			lock:               &testLock{obtainError: errors.New("dial tcp 127.0.0.1:6379: connection refused")},
+			expectsUnavailable: true,
+		},
+		{
+			name:           "refresh token refused",
+			lock:           &testLock{},
+			refreshErr:     retrieveError(http.StatusBadRequest, "invalid_grant"),
+			expectsCleared: true,
+		},
+		{
+			name:           "account locked at dex",
+			lock:           &testLock{},
+			refreshErr:     dexAnswer(t, http.StatusTooManyRequests, dexLockedBody),
+			expectsCleared: true,
+		},
+		{
+			name:           "request refused",
+			lock:           &testLock{},
+			refreshErr:     retrieveError(http.StatusBadRequest, "invalid_request"),
+			expectsCleared: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			createdAt := time.Now().Add(-time.Hour)
+			cleared := false
+			store := &fakeSessionStore{
+				LoadFunc: func(*http.Request) (*sessionsapi.SessionState, error) {
+					return &sessionsapi.SessionState{CreatedAt: &createdAt, RefreshToken: "refresh-token", Lock: tt.lock}, nil
+				},
+				ClearFunc: func(http.ResponseWriter, *http.Request) error {
+					cleared = true
+					return nil
+				},
+			}
+			loader := NewStoredSessionLoader(&StoredSessionLoaderOptions{
+				SessionStore:  store,
+				RefreshPeriod: time.Minute,
+				RefreshSession: func(context.Context, *sessionsapi.SessionState) (bool, error) {
+					return false, fmt.Errorf("unable to redeem refresh token: %w", tt.refreshErr)
+				},
+				// The stub of a session restored from the cookie has no ID token to validate.
+				ValidateSession: func(context.Context, *sessionsapi.SessionState) bool { return false },
+			})
+
+			scope := &middlewareapi.RequestScope{}
+			req := middlewareapi.AddRequestScope(httptest.NewRequest(http.MethodGet, "/", nil), scope)
+			var nextCalled bool
+			loader(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
+				nextCalled = true
+			})).ServeHTTP(httptest.NewRecorder(), req)
+
+			require.True(t, nextCalled)
+			assert.Nil(t, scope.Session, "a session that is not refreshed is not served")
+			assert.Equal(t, tt.expectsUnavailable, scope.SessionUnavailable)
+			assert.Equal(t, tt.expectsCleared, cleared)
+		})
+	}
+}
+
+// TestUnavailableSince checks the memory of the first failed refresh of a session: the window counts
+// from the first failure, a refresh that succeeds or ends the session starts it again, and a session
+// without a refresh token is not tracked.
+func TestUnavailableSince(t *testing.T) {
+	const window = 10 * time.Minute
+	now := time.Now()
+	u := newUnavailableSince()
+	u.now = func() time.Time { return now }
+
+	assert.False(t, u.failed("refresh-token", window), "the first failure starts the window")
+	now = now.Add(window)
+	assert.False(t, u.failed("refresh-token", window), "within the window")
+	now = now.Add(time.Second)
+	assert.True(t, u.failed("refresh-token", window), "past the window from the first failure")
+	assert.True(t, u.failed("refresh-token", window), "and for the following failures")
+	assert.False(t, u.failed("other-refresh-token", window), "each session has a window of its own")
+
+	u.forget("refresh-token")
+	assert.False(t, u.failed("refresh-token", window), "a forgotten session starts again")
+
+	assert.False(t, u.failed("", window))
+	now = now.Add(2 * window)
+	assert.False(t, u.failed("", window), "a session without a refresh token is not tracked")
+}
+
+// TestUnavailableSinceBounds checks the bounds of the memory: a session not tried again for longer
+// than unavailableRetention is forgotten, and no more than maxUnavailableSessions are tracked.
+func TestUnavailableSinceBounds(t *testing.T) {
+	const window = 10 * time.Minute
+	now := time.Now()
+	u := newUnavailableSince()
+	u.now = func() time.Time { return now }
+
+	u.failed("idle", window)
+	now = now.Add(unavailableRetention + 2*time.Hour)
+	assert.False(t, u.failed("idle", window), "a session not tried again for a day starts again")
+
+	u = newUnavailableSince()
+	u.now = func() time.Time { return now }
+	for i := range maxUnavailableSessions {
+		u.failed(fmt.Sprintf("refresh-token-%d", i), window)
+	}
+	u.failed("one-too-many", window)
+	now = now.Add(2 * window)
+	assert.True(t, u.failed("refresh-token-0", window))
+	assert.False(t, u.failed("one-too-many", window), "a session beyond the bound is not tracked")
+	assert.Len(t, u.since, maxUnavailableSessions)
+}
+
+// TestLoadSessionEndsLongUnavailableSession checks the loader on a session whose refresh the provider
+// does not answer: it is kept, and the request answered 503, for one refresh period from the first
+// failure; past it the session is cleared and the request goes to sign in. A refresh that succeeds in
+// between starts the window again.
+func TestLoadSessionEndsLongUnavailableSession(t *testing.T) {
+	const refreshPeriod = 10 * time.Minute
+	now := time.Now()
+	createdAt := now.Add(-time.Hour)
+	var (
+		refreshErr error
+		cleared    bool
+	)
+	store := &fakeSessionStore{
+		LoadFunc: func(*http.Request) (*sessionsapi.SessionState, error) {
+			return &sessionsapi.SessionState{CreatedAt: &createdAt, RefreshToken: "refresh-token", Lock: &testLock{}}, nil
+		},
+		ClearFunc: func(http.ResponseWriter, *http.Request) error {
+			cleared = true
+			return nil
+		},
+		SaveFunc: func(http.ResponseWriter, *http.Request, *sessionsapi.SessionState) error { return nil },
+	}
+	loader := newStoredSessionLoader(&StoredSessionLoaderOptions{
+		SessionStore:  store,
+		RefreshPeriod: refreshPeriod,
+		RefreshSession: func(_ context.Context, ss *sessionsapi.SessionState) (bool, error) {
+			if refreshErr != nil {
+				return false, fmt.Errorf("unable to redeem refresh token: %w", refreshErr)
+			}
+			// A refresh replaces the refresh token; the store of the test keeps serving the old one.
+			ss.RefreshToken = "rotated-refresh-token"
+			return true, nil
+		},
+		ValidateSession: func(_ context.Context, ss *sessionsapi.SessionState) bool { return refreshErr == nil },
+	})
+	loader.unavailable.now = func() time.Time { return now }
+
+	serve := func() *middlewareapi.RequestScope {
+		cleared = false
+		scope := &middlewareapi.RequestScope{}
+		req := middlewareapi.AddRequestScope(httptest.NewRequest(http.MethodGet, "/", nil), scope)
+		loader.loadSession(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(httptest.NewRecorder(), req)
+		return scope
+	}
+
+	refreshErr = retrieveError(http.StatusServiceUnavailable, "temporarily_unavailable")
+	scope := serve()
+	assert.True(t, scope.SessionUnavailable, "the first failure keeps the session")
+	assert.False(t, cleared)
+
+	now = now.Add(refreshPeriod)
+	scope = serve()
+	assert.True(t, scope.SessionUnavailable, "the session is kept for one refresh period")
+	assert.False(t, cleared)
+
+	refreshErr = nil
+	scope = serve()
+	assert.NotNil(t, scope.Session, "the provider is back and refreshes the session")
+
+	refreshErr = retrieveError(http.StatusInternalServerError, "invalid_request")
+	now = now.Add(time.Second)
+	scope = serve()
+	assert.True(t, scope.SessionUnavailable, "the refresh in between started the window again")
+	assert.False(t, cleared)
+
+	now = now.Add(refreshPeriod + time.Second)
+	scope = serve()
+	assert.False(t, scope.SessionUnavailable, "past one refresh period the session is not kept")
+	assert.Nil(t, scope.Session)
+	assert.True(t, cleared, "and its cookie is cleared, so the request goes to sign in")
+
+	scope = serve()
+	assert.True(t, scope.SessionUnavailable, "the ended session is forgotten: a new cookie with it starts again")
+	assert.False(t, cleared)
+}
+
+// TestSessionRefreshTimeoutFitsTheIngress checks that a request that waits for the lock and then
+// refreshes is answered well before ingress-nginx gives the auth subrequest up after its default
+// 60 seconds.
+func TestSessionRefreshTimeoutFitsTheIngress(t *testing.T) {
+	const ingressAuthTimeout = 60 * time.Second
+	assert.Less(t, sessionRefreshObtainTimeout+sessionRefreshTimeout, ingressAuthTimeout/2)
+}
+
+// TestLoadSessionBoundsTheRefresh checks the deadline of a refresh against a dex that takes its time:
+// a dex that does not answer at all is unavailable once the deadline passes, while the ingress still
+// waits, and the window of the session starts; a client that gives up does not cancel a refresh that
+// dex answers.
+func TestLoadSessionBoundsTheRefresh(t *testing.T) {
+	const refreshTimeout = 100 * time.Millisecond
+
+	newDex := func(t *testing.T, delay time.Duration) string {
+		t.Helper()
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			select {
+			case <-r.Context().Done():
+				return
+			case <-time.After(delay):
+			}
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write([]byte(`{"access_token":"access-token","token_type":"bearer","refresh_token":"rotated-refresh-token","expires_in":600}`))
+		}))
+		t.Cleanup(srv.Close)
+		return srv.URL
+	}
+
+	newLoader := func(tokenURL string, saved *string, cleared *bool) *storedSessionLoader {
+		createdAt := time.Now().Add(-time.Hour)
+		cfg := &oauth2.Config{ClientID: "dex-authenticator", ClientSecret: "secret", Endpoint: oauth2.Endpoint{TokenURL: tokenURL}}
+		return newStoredSessionLoader(&StoredSessionLoaderOptions{
+			SessionStore: &fakeSessionStore{
+				LoadFunc: func(*http.Request) (*sessionsapi.SessionState, error) {
+					return &sessionsapi.SessionState{CreatedAt: &createdAt, RefreshToken: "refresh-token", Lock: &testLock{}}, nil
+				},
+				SaveFunc: func(_ http.ResponseWriter, _ *http.Request, ss *sessionsapi.SessionState) error {
+					*saved = ss.RefreshToken
+					return nil
+				},
+				ClearFunc: func(http.ResponseWriter, *http.Request) error {
+					*cleared = true
+					return nil
+				},
+			},
+			RefreshPeriod: time.Minute,
+			RefreshSession: func(ctx context.Context, ss *sessionsapi.SessionState) (bool, error) {
+				token, err := cfg.TokenSource(ctx, &oauth2.Token{RefreshToken: ss.RefreshToken}).Token()
+				if err != nil {
+					return false, fmt.Errorf("unable to redeem refresh token: %w", fmt.Errorf("failed to get token: %w", err))
+				}
+				ss.RefreshToken = token.RefreshToken
+				return true, nil
+			},
+			// Validation may fetch the keys of dex, under the same deadline.
+			ValidateSession: func(ctx context.Context, _ *sessionsapi.SessionState) bool { return ctx.Err() == nil },
+		})
+	}
+
+	serve := func(ctx context.Context, loader *storedSessionLoader) *middlewareapi.RequestScope {
+		scope := &middlewareapi.RequestScope{}
+		req := middlewareapi.AddRequestScope(httptest.NewRequestWithContext(ctx, http.MethodGet, "/", nil), scope)
+		loader.loadSession(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(httptest.NewRecorder(), req)
+		return scope
+	}
+
+	t.Run("dex does not answer", func(t *testing.T) {
+		var (
+			saved   string
+			cleared bool
+		)
+		loader := newLoader(newDex(t, 5*time.Second), &saved, &cleared)
+		loader.refreshTimeout = refreshTimeout
+		loader.answerTimeout = 2 * refreshTimeout
+
+		started := time.Now()
+		scope := serve(t.Context(), loader)
+		assert.Less(t, time.Since(started), 2*time.Second, "the refresh gives up at its own deadline")
+		assert.True(t, scope.SessionUnavailable, "a dex that does not answer is unavailable")
+		assert.False(t, cleared)
+		assert.Len(t, loader.unavailable.since, 1, "and the window of the session starts")
+	})
+
+	t.Run("client gives up", func(t *testing.T) {
+		var (
+			saved   string
+			cleared bool
+		)
+		// The default deadline of the loader, which dex answers well within.
+		loader := newLoader(newDex(t, 20*time.Millisecond), &saved, &cleared)
