+		store.refreshDelay = time.Second
+		scope = serveSession(t.Context(), loader)
+		assert.Nil(t, scope.Session)
+		assert.True(t, store.cleared, "the next request gets the refusal and ends the session")
+		assert.EqualValues(t, 2, store.refreshes.Load())
+	})
+}
