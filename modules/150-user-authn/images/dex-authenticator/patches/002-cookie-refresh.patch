diff --git a/pkg/sessions/persistence/deckhouse_refresh_token.go b/pkg/sessions/persistence/deckhouse_refresh_token.go
new file mode 100644
index 00000000..08a62968
--- /dev/null
+++ b/pkg/sessions/persistence/deckhouse_refresh_token.go
@@ -0,0 +1,91 @@
+package persistence
+
+import (
+	"bytes"
+	"crypto/hkdf"
+	"crypto/sha256"
+	"fmt"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/encryption"
+)
+
+const (
+	// refreshTokenKeyInfo separates the key of the refresh token from every other use of the
+	// cookie secret, the signature of the cookie first of all.
+	refreshTokenKeyInfo = "deckhouse dex-authenticator: refresh token in the ticket cookie"
+	refreshTokenKeySize = 32
+)
+
+// refreshTokenCipher returns the cipher of the refresh token in the ticket cookie (Deckhouse
+// patch 002): AES-256-GCM with a key derived from the cookie secret. The cookie reaches the
+// application behind the proxy with every request, and the application has no business with the
+// refresh token of its user. A proxy with another cookie secret cannot read the token.
+func refreshTokenCipher(cookieOpts *options.Cookie) (encryption.Cipher, error) {
+	secret, err := cookieOpts.GetSecret()
+	if err != nil {
+		return nil, fmt.Errorf("error getting cookie secret: %w", err)
+	}
+	key, err := hkdf.Key(sha256.New, encryption.SecretBytes(secret), nil, refreshTokenKeyInfo, refreshTokenKeySize)
+	if err != nil {
+		return nil, fmt.Errorf("failed to derive the key of the refresh token: %w", err)
+	}
+	gcm, err := encryption.NewGCMCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("failed to make the cipher of the refresh token: %w", err)
+	}
+
+	return encryption.NewBase64Cipher(gcm), nil
+}
+
+func encryptRefreshToken(refreshToken string, cookieOpts *options.Cookie) (string, error) {
+	c, err := refreshTokenCipher(cookieOpts)
+	if err != nil {
+		return "", err
+	}
+	encrypted, err := c.Encrypt([]byte(refreshToken))
+	if err != nil {
+		return "", fmt.Errorf("failed to encrypt the refresh token: %w", err)
+	}
+
+	return string(encrypted), nil
+}
+
+func decryptRefreshToken(encrypted string, cookieOpts *options.Cookie) (string, error) {
+	c, err := refreshTokenCipher(cookieOpts)
+	if err != nil {
+		return "", err
+	}
+	refreshToken, err := c.Decrypt([]byte(encrypted))
+	if err != nil {
+		return "", fmt.Errorf("failed to decrypt the refresh token: %w", err)
+	}
+
+	return string(refreshToken), nil
+}
+
+// replacedRefreshTokenLifetime is how long after the answer of a refresh a cookie with the token it
+// replaced still gets the tokens of the stored session (Deckhouse patch 002). The record is for the
+// requests the browser sent before the cookie of the refresh reached it, and for the first request
+// after a late refresh, whose answer is waited for up to a minute from the start of the refresh. Twice
+// that covers both. Past it the cookie keeps its own token, and a provider that refuses a replaced
+// refresh token ends the session at its next refresh: otherwise two copies of one cookie would take
+// the tokens from each other after every refresh and live until the cookie expires.
+const replacedRefreshTokenLifetime = 2 * time.Minute
+
+// replacesRefreshToken reports whether the refresh of a stored session replaced refreshToken with
+// the token the session holds now, less than replacedRefreshTokenLifetime ago.
+func replacesRefreshToken(state *sessions.SessionState, refreshToken string) bool {
+	if state.RefreshToken == "" || state.RefreshToken == refreshToken {
+		return false
+	}
+	// A record without its time was written before the time was kept, and is no newer than that.
+	if state.ReplacedRefreshTokenAt == nil || time.Since(*state.ReplacedRefreshTokenAt) > replacedRefreshTokenLifetime {
+		return false
+	}
+	hash := sha256.Sum256([]byte(refreshToken))
+
+	return bytes.Equal(state.ReplacedRefreshTokenHash, hash[:])
+}
diff --git a/pkg/sessions/persistence/deckhouse_refresh_token_test.go b/pkg/sessions/persistence/deckhouse_refresh_token_test.go
new file mode 100644
index 00000000..0016df28
--- /dev/null
+++ b/pkg/sessions/persistence/deckhouse_refresh_token_test.go
@@ -0,0 +1,338 @@
+package persistence
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/encryption"
+	sessiontests "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/tests"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const testRefreshToken = "refresh-token-of-the-session"
+
+func testCookieOptions(encrypts bool) *options.Cookie {
+	return &options.Cookie{
+		Name:                "_oauth2_proxy",
+		Secret:              strings.Repeat("s", 32),
+		Expire:              time.Hour,
+		EncryptRefreshToken: encrypts,
+	}
+}
+
+// saveSession saves a session through the manager and returns the request of a browser that got
+// the cookie of the answer.
+func saveSession(t *testing.T, manager *Manager, req *http.Request, session *sessionsapi.SessionState) *http.Request {
+	t.Helper()
+
+	rw := httptest.NewRecorder()
+	require.NoError(t, manager.Save(rw, req, session))
+	cookies := rw.Result().Cookies()
+	require.Len(t, cookies, 1)
+
+	next := httptest.NewRequest(http.MethodGet, "http://example.com/", nil)
+	next.AddCookie(cookies[0])
+
+	return next
+}
+
+// cookieContent returns the signed value of the ticket cookie of a request, as a browser, or an
+// application behind the proxy, reads it.
+func cookieContent(t *testing.T, req *http.Request, cookieOpts *options.Cookie) string {
+	t.Helper()
+
+	cookie, err := req.Cookie(cookieOpts.Name)
+	require.NoError(t, err)
+	value, _, ok := encryption.Validate(cookie, cookieOpts.Secret, cookieOpts.Expire)
+	require.True(t, ok)
+
+	return string(value)
+}
+
+func newSession() *sessionsapi.SessionState {
+	createdAt := time.Now()
+	return &sessionsapi.SessionState{
+		CreatedAt:    &createdAt,
+		Email:        "john.doe@example.com",
+		RefreshToken: testRefreshToken,
+	}
+}
+
+// TestCookieRefreshTokenEncryption checks the refresh token in the ticket cookie: with
+// --cookie-encrypt-refresh-token the cookie does not show it, without the flag the cookie is
+// written as before, and a proxy reads both forms whatever its flag is.
+func TestCookieRefreshTokenEncryption(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name           string
+		writerEncrypts bool
+		readerEncrypts bool
+	}{
+		{name: "plain cookie read by a proxy without the flag"},
+		{name: "plain cookie read by a proxy with the flag", readerEncrypts: true},
+		{name: "encrypted cookie read by a proxy with the flag", writerEncrypts: true, readerEncrypts: true},
+		{name: "encrypted cookie read by a proxy without the flag", writerEncrypts: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			store := sessiontests.NewMockStore()
+			writerOpts := testCookieOptions(tt.writerEncrypts)
+			writer := NewManager(store, writerOpts)
+			req := saveSession(t, writer, httptest.NewRequest(http.MethodGet, "http://example.com/", nil), newSession())
+
+			content := cookieContent(t, req, writerOpts)
+			encoded := base64.StdEncoding.EncodeToString([]byte(testRefreshToken))
+			if tt.writerEncrypts {
+				assert.NotContains(t, content, testRefreshToken, "the cookie does not show the refresh token")
+				assert.NotContains(t, content, encoded)
+			} else {
+				value := map[string]string{}
+				require.NoError(t, json.Unmarshal([]byte(content), &value))
+				assert.Equal(t, testRefreshToken, value["RefreshToken"], "the cookie is written as before")
+				assert.Len(t, value, 2)
+			}
+
+			reader := NewManager(store, testCookieOptions(tt.readerEncrypts))
+			loaded, err := reader.Load(req)
+			require.NoError(t, err)
+			assert.Equal(t, testRefreshToken, loaded.RefreshToken)
+			assert.Equal(t, "john.doe@example.com", loaded.Email)
+
+			// Without the session in the store the token of the cookie restores it.
+			require.NoError(t, reader.Clear(httptest.NewRecorder(), req))
+			stub, err := reader.Load(req)
+			require.NoError(t, err)
+			assert.Equal(t, testRefreshToken, stub.RefreshToken)
+			assert.Equal(t, stubSessionUser, stub.User)
+		})
+	}
+}
+
+// TestCookieRefreshTokenCiphertext checks the encrypted refresh token itself: two cookies of one
+// token differ, and a ciphertext that was changed, cut or made for another cookie secret is an
+// error, not a session without a refresh token.
+func TestCookieRefreshTokenCiphertext(t *testing.T) {
+	t.Parallel()
+
+	cookieOpts := testCookieOptions(true)
+	first, err := encryptRefreshToken(testRefreshToken, cookieOpts)
+	require.NoError(t, err)
+	second, err := encryptRefreshToken(testRefreshToken, cookieOpts)
+	require.NoError(t, err)
+	assert.NotEqual(t, first, second, "every cookie has a nonce of its own")
+
+	got, err := decryptRefreshToken(first, cookieOpts)
+	require.NoError(t, err)
+	assert.Equal(t, testRefreshToken, got)
+
+	otherSecret := testCookieOptions(true)
+	otherSecret.Secret = strings.Repeat("o", 32)
+
+	raw, err := base64.StdEncoding.DecodeString(first)
+	require.NoError(t, err)
+	changed := append([]byte{}, raw...)
+	changed[len(changed)-1] ^= 1
+
+	tests := []struct {
+		name       string
+		ciphertext string
+		cookieOpts *options.Cookie
+	}{
+		{name: "another cookie secret", ciphertext: first, cookieOpts: otherSecret},
+		{name: "changed ciphertext", ciphertext: base64.StdEncoding.EncodeToString(changed), cookieOpts: cookieOpts},
+		{name: "cut ciphertext", ciphertext: base64.StdEncoding.EncodeToString(raw[:8]), cookieOpts: cookieOpts},
+		{name: "not base64", ciphertext: "not base64!", cookieOpts: cookieOpts},
+		{name: "plain token in the encrypted field", ciphertext: base64.StdEncoding.EncodeToString([]byte(testRefreshToken)), cookieOpts: cookieOpts},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			got, err := decryptRefreshToken(tt.ciphertext, tt.cookieOpts)
+			require.Error(t, err)
+			assert.Empty(t, got)
+			assert.NotContains(t, err.Error(), testRefreshToken)
+		})
+	}
+}
+
+// TestDecodeTicketRefusesABrokenRefreshToken checks that a cookie whose encrypted refresh token
+// cannot be read is refused as a whole: the request is not served by the session of the ticket
+// with no refresh token.
+func TestDecodeTicketRefusesABrokenRefreshToken(t *testing.T) {
+	t.Parallel()
+
+	cookieOpts := testCookieOptions(true)
+	tckt, err := newTicket(cookieOpts)
+	require.NoError(t, err)
+
+	broken := base64.StdEncoding.EncodeToString([]byte("not a ciphertext"))
+	data, err := json.Marshal(cookieRefreshToken{Ticket: tckt.encodeTicket(), EncryptedRefreshToken: broken})
+	require.NoError(t, err)
+
+	decoded, refreshToken, err := decodeTicket(string(data), cookieOpts)
+	require.Error(t, err)
+	assert.Nil(t, decoded)
+	assert.Empty(t, refreshToken)
+}
+
+// TestLoadKeepsTheTokenThatReplacedTheCookieToken checks which refresh token a loaded session
+// gets. The cookie carries the latest one unless the session in the store says its refresh
+// replaced exactly the token of the cookie: then the answer with the new cookie did not reach the
+// browser, the token of the store is the valid one, and the cookie is to be written again. That
+// holds for replacedRefreshTokenLifetime after the refresh only.
+func TestLoadKeepsTheTokenThatReplacedTheCookieToken(t *testing.T) {
+	t.Parallel()
+
+	const rotatedToken = "rotated-refresh-token"
+	hashOf := func(token string) []byte {
+		sum := sha256.Sum256([]byte(token))
+		return sum[:]
+	}
+
+	tests := []struct {
+		name        string
+		storedToken string
+		replaced    []byte
+		// replacedAgo is how long ago the refresh replaced the token; nil is a record without
+		// its time.
+		replacedAgo   *time.Duration
+		expected      string
+		expectedStale bool
+		// expectedStored is the stored token the session carries apart when it goes on with the
+		// token of the cookie.
+		expectedStored string
+	}{
+		{
+			name:           "session of another replica that knows no replaced token",
+			storedToken:    "older-refresh-token",
+			expected:       testRefreshToken,
+			expectedStored: "older-refresh-token",
+		},
+		{
+			name:           "session whose refresh replaced another token",
+			storedToken:    "older-refresh-token",
+			replaced:       hashOf("oldest-refresh-token"),
+			replacedAgo:    new(time.Duration(0)),
+			expected:       testRefreshToken,
+			expectedStored: "older-refresh-token",
+		},
+		{
+			name:          "session whose refresh replaced the token of the cookie",
+			storedToken:   rotatedToken,
+			replaced:      hashOf(testRefreshToken),
+			replacedAgo:   new(time.Duration(0)),
+			expected:      rotatedToken,
+			expectedStale: true,
+		},
+		{
+			name:          "session whose refresh replaced the token of the cookie at the end of the lifetime",
+			storedToken:   rotatedToken,
+			replaced:      hashOf(testRefreshToken),
+			replacedAgo:   new(replacedRefreshTokenLifetime - time.Second),
+			expected:      rotatedToken,
+			expectedStale: true,
+		},
+		{
+			// Two copies of one cookie would otherwise take the tokens from each other after
+			// every refresh.
+			name:           "session whose refresh replaced the token of the cookie long ago",
+			storedToken:    rotatedToken,
+			replaced:       hashOf(testRefreshToken),
+			replacedAgo:    new(replacedRefreshTokenLifetime + time.Second),
+			expected:       testRefreshToken,
+			expectedStored: rotatedToken,
+		},
+		{
+			name:           "record without its time",
+			storedToken:    rotatedToken,
+			replaced:       hashOf(testRefreshToken),
+			expected:       testRefreshToken,
+			expectedStored: rotatedToken,
+		},
+		{
+			name:        "session with the token of the cookie",
+			storedToken: testRefreshToken,
+			replaced:    hashOf("older-refresh-token"),
+			replacedAgo: new(time.Duration(0)),
+			expected:    testRefreshToken,
+		},
+		{
+			// A provider that does not rotate the refresh token replaces nothing.
+			name:        "token that replaced itself",
+			storedToken: testRefreshToken,
+			replaced:    hashOf(testRefreshToken),
+			replacedAgo: new(time.Duration(0)),
+			expected:    testRefreshToken,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			for _, encrypts := range []bool{false, true} {
+				manager := NewManager(sessiontests.NewMockStore(), testCookieOptions(encrypts))
+				req := saveSession(t, manager, httptest.NewRequest(http.MethodGet, "http://example.com/", nil), newSession())
+
+				// The store gets another session under the ticket of the cookie, as a refresh
+				// whose answer the browser did not get leaves it.
+				stored := newSession()
+				stored.RefreshToken = tt.storedToken
+				stored.ReplacedRefreshTokenHash = tt.replaced
+				if tt.replacedAgo != nil {
+					stored.ReplacedRefreshTokenAt = new(time.Now().Add(-*tt.replacedAgo))
+				}
+				require.NoError(t, manager.Save(httptest.NewRecorder(), req, stored))
+
+				loaded, err := manager.Load(req)
+				require.NoError(t, err)
+				assert.Equal(t, tt.expected, loaded.RefreshToken)
+				assert.Equal(t, tt.expectedStale, loaded.StaleCookie)
+				assert.Equal(t, tt.expectedStored, loaded.StoredRefreshToken)
+				if !tt.expectedStale {
+					continue
+				}
+
+				// Saving the session writes the cookie again, and the new cookie is not stale.
+				next := saveSession(t, manager, req, loaded)
+				again, err := manager.Load(next)
+				require.NoError(t, err)
+				assert.Equal(t, tt.expected, again.RefreshToken)
+				assert.False(t, again.StaleCookie)
+			}
+		})
+	}
+}
