--- /dev/null
+++ b/deckhouse_cookie_refresh_test.go
@@ -0,0 +1,449 @@
+package main
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/alicebob/miniredis/v2"
+	"github.com/go-jose/go-jose/v4"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/cookies"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/encryption"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/util/ptr"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/validation"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const fakeDexIssuer = "https://dex.example.com/"
+
+// dexFailure is how the token endpoint of fakeDex answers a refresh instead of issuing tokens.
+type dexFailure struct {
+	status int
+	body   string
+}
+
+// fakeDex serves the token and keys endpoints of dex for the tests of patch 002. It can stop listening
+// and start again on the same address, so that a proxy pointed at it gets its connections refused.
+type fakeDex struct {
+	t    *testing.T
+	addr string
+	key  *rsa.PrivateKey
+
+	refreshes atomic.Int32
+
+	mu      sync.Mutex
+	server  *httptest.Server
+	email   string
+	failure *dexFailure
+	delay   time.Duration
+	issued  int
+	idTTL   time.Duration
+}
+
+func newFakeDex(t *testing.T) *fakeDex {
+	t.Helper()
+
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+
+	dex := &fakeDex{t: t, addr: listener.Addr().String(), key: key, email: "jane.doe@example.com", idTTL: time.Hour}
+	dex.serve(listener)
+	t.Cleanup(dex.stop)
+	return dex
+}
+
+func (d *fakeDex) serve(listener net.Listener) {
+	server := httptest.NewUnstartedServer(d)
+	server.Listener = listener
+	server.Start()
+
+	d.mu.Lock()
+	d.server = server
+	d.mu.Unlock()
+}
+
+// stop closes the listener: the connections of a proxy are refused until start.
+func (d *fakeDex) stop() {
+	d.mu.Lock()
+	server := d.server
+	d.server = nil
+	d.mu.Unlock()
+
+	if server != nil {
+		server.Close()
+	}
+}
+
+// start listens again on the address of the first start.
+func (d *fakeDex) start() {
+	listener, err := net.Listen("tcp", d.addr)
+	require.NoError(d.t, err)
+	d.serve(listener)
+}
+
+func (d *fakeDex) url(path string) string {
+	return "http://" + d.addr + path
+}
+
+// signInAs makes the token endpoint issue the tokens of another user.
+func (d *fakeDex) signInAs(email string) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.email = email
+}
+
+// fail makes the token endpoint answer every refresh with a failure; nil issues tokens again.
+func (d *fakeDex) fail(failure *dexFailure) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.failure = failure
+}
+
+// slowDown delays every answer to a refresh.
+func (d *fakeDex) slowDown(delay time.Duration) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.delay = delay
+}
+
+func (d *fakeDex) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	switch r.URL.Path {
+	case "/keys":
+		keys := jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: &d.key.PublicKey, KeyID: "key", Algorithm: "RS256", Use: "sig"}}}
+		w.Header().Set("Content-Type", "application/json")
+		assert.NoError(d.t, json.NewEncoder(w).Encode(keys))
+	case "/token":
+		d.token(w, r)
+	default:
+		http.NotFound(w, r)
+	}
+}
+
+func (d *fakeDex) token(w http.ResponseWriter, r *http.Request) {
+	if !assert.NoError(d.t, r.ParseForm()) {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	isRefresh := r.PostForm.Get("grant_type") == "refresh_token"
+	if isRefresh {
+		d.refreshes.Add(1)
+	}
+
+	d.mu.Lock()
+	delay, failure, email, idTTL := d.delay, d.failure, d.email, d.idTTL
+	d.issued++
+	issued := d.issued
+	d.mu.Unlock()
+
+	w.Header().Set("Content-Type", "application/json")
+	if isRefresh {
+		time.Sleep(delay)
+		if failure != nil {
+			w.WriteHeader(failure.status)
+			_, _ = w.Write([]byte(failure.body))
+			return
+		}
+	}
+
+	now := time.Now()
+	claims, err := json.Marshal(map[string]any{
+		"iss":            fakeDexIssuer,
+		"aud":            clientID,
+		"sub":            "sub-" + email,
+		"email":          email,
+		"email_verified": true,
+		"iat":            now.Unix(),
+		"exp":            now.Add(idTTL).Unix(),
+	})
+	require.NoError(d.t, err)
+	signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.RS256, Key: d.key},
+		(&jose.SignerOptions{}).WithHeader("kid", "key"))
+	require.NoError(d.t, err)
+	signed, err := signer.Sign(claims)
+	require.NoError(d.t, err)
+	idToken, err := signed.CompactSerialize()
+	require.NoError(d.t, err)
+
+	assert.NoError(d.t, json.NewEncoder(w).Encode(map[string]any{
+		"access_token":  fmt.Sprintf("access-token-%d", issued),
+		"token_type":    "bearer",
+		"expires_in":    int(idTTL.Seconds()),
+		"refresh_token": fmt.Sprintf("refresh-token-%d", issued),
+		"id_token":      idToken,
+	}))
+}
+
+// newDeckhouseReplica returns a replica of a dex-authenticator: an OIDC provider pointed at dex, the
+// --cookie-refresh period and a Redis of its own, as the Redis sidecar of a pod.
+func newDeckhouseReplica(t *testing.T, dex *fakeDex, cookieRefresh time.Duration) *OAuthProxy {
+	t.Helper()
+
+	redis := miniredis.RunT(t)
+	opts := baseTestOptions()
+	opts.Providers[0].Type = options.OIDCProvider
+	opts.Providers[0].LoginURL = fakeDexIssuer + "auth"
+	opts.Providers[0].RedeemURL = dex.url("/token")
+	opts.Providers[0].OIDCConfig.IssuerURL = fakeDexIssuer
+	opts.Providers[0].OIDCConfig.SkipDiscovery = ptr.To(true)
+	opts.Providers[0].OIDCConfig.JwksURL = dex.url("/keys")
+	opts.Cookie.Refresh = cookieRefresh
+	opts.Session.Type = options.RedisSessionStoreType
+	opts.Session.Redis.ConnectionURL = "redis://" + redis.Addr()
+	require.NoError(t, validation.Validate(opts))
+
+	proxy, err := NewOAuthProxy(opts, func(string) bool { return true })
+	require.NoError(t, err)
+	return proxy
+}
+
+// sessionCookie returns the session cookie a response sets, or nil.
+func sessionCookie(proxy *OAuthProxy, rw *httptest.ResponseRecorder) *http.Cookie {
+	for _, c := range rw.Result().Cookies() {
+		if c.Name == proxy.CookieOptions.Name {
+			return c
+		}
+	}
+	return nil
+}
+
+// signInThroughDex completes a sign-in through dex at the callback of a replica, with the cookies the
+// browser already has, and returns the session cookie it sets.
+func signInThroughDex(t *testing.T, proxy *OAuthProxy, browserCookies ...*http.Cookie) *http.Cookie {
+	t.Helper()
+
+	csrf, err := cookies.NewCSRF(proxy.CookieOptions, "")
+	require.NoError(t, err)
+	req := httptest.NewRequest(http.MethodGet,
+		"/oauth2/callback?code=code&state="+url.QueryEscape(encodeState(csrf.HashOAuthState(), "/", false)), nil)
+	csrfCookie, err := csrf.SetCookie(httptest.NewRecorder(), req)
+	require.NoError(t, err)
+	req.AddCookie(csrfCookie)
+	for _, c := range browserCookies {
+		req.AddCookie(c)
+	}
+
+	rw := httptest.NewRecorder()
+	proxy.ServeHTTP(rw, req)
+	require.Equal(t, http.StatusFound, rw.Code, rw.Body.String())
+	cookie := sessionCookie(proxy, rw)
+	require.NotNil(t, cookie)
+	require.NotEmpty(t, cookie.Value)
+	return cookie
+}
+
+// serveWithCookie serves a request to a replica with the session cookie of a browser.
+func serveWithCookie(proxy *OAuthProxy, path string, cookie *http.Cookie) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(http.MethodGet, path, nil)
+	req.AddCookie(cookie)
+	rw := httptest.NewRecorder()
+	proxy.ServeHTTP(rw, req)
+	return rw
+}
+
+// userInfoEmail returns the email of the session a replica serves for a cookie.
+func userInfoEmail(t *testing.T, proxy *OAuthProxy, cookie *http.Cookie) string {
+	t.Helper()
+
+	rw := serveWithCookie(proxy, "/oauth2/userinfo", cookie)
+	require.Equal(t, http.StatusOK, rw.Code, rw.Body.String())
+	var info struct {
+		Email string `json:"email"`
+	}
+	require.NoError(t, json.Unmarshal(rw.Body.Bytes(), &info))
+	return info.Email
+}
+
+// cookieTicket returns the session ticket a session cookie carries.
+func cookieTicket(t *testing.T, proxy *OAuthProxy, cookie *http.Cookie) string {
+	t.Helper()
+
+	secret, err := proxy.CookieOptions.GetSecret()
+	require.NoError(t, err)
+	value, _, ok := encryption.Validate(cookie, secret, proxy.CookieOptions.Expire)
+	require.True(t, ok)
+	var decoded struct {
+		Ticket string `json:"Ticket"`
+	}
+	require.NoError(t, json.Unmarshal(value, &decoded))
+	require.NotEmpty(t, decoded.Ticket)
+	return decoded.Ticket
+}
+
+func isSuccess(code int) bool {
+	return code >= http.StatusOK && code < http.StatusMultipleChoices
+}
+
+// expectRefreshUnavailable checks the answer of /auth while dex cannot refresh the session: 503 with
+// Retry-After instead of 401, and the cookie, the only copy of the refresh token, is neither cleared
+// nor replaced.
+func expectRefreshUnavailable(t *testing.T, replica *OAuthProxy, cookie *http.Cookie) {
+	t.Helper()
+
+	rw := serveWithCookie(replica, "/oauth2/auth", cookie)
+	assert.Equal(t, http.StatusServiceUnavailable, rw.Code)
+	assert.NotEmpty(t, rw.Header().Get("Retry-After"))
+	assert.Nil(t, sessionCookie(replica, rw), "the cookie is neither cleared nor replaced")
+}
+
+// expectRefreshRecovered checks that the same cookie works again once dex answers: the session is
+// refreshed and the new refresh token is written into the cookie.
+func expectRefreshRecovered(t *testing.T, replica *OAuthProxy, cookie *http.Cookie) {
+	t.Helper()
+
+	rw := serveWithCookie(replica, "/oauth2/auth", cookie)
+	assert.True(t, isSuccess(rw.Code), "dex is back, so the same cookie works: %d", rw.Code)
+	refreshed := sessionCookie(replica, rw)
+	require.NotNil(t, refreshed, "the refresh writes the new refresh token into the cookie")
+	assert.Equal(t, "jane.doe@example.com", userInfoEmail(t, replica, refreshed))
+}
+
+// TestRefreshUnavailableKeepsSession checks that a session restored from its cookie on a replica
+// without the session in its Redis (the stub of patch 002) survives a dex that cannot refresh it right
+// now, and works again once dex answers.
+func TestRefreshUnavailableKeepsSession(t *testing.T) {
+	tests := []struct {
+		name    string
+		failure *dexFailure // nil: dex refuses connections
+	}{
+		{name: "dex refuses connections"},
+		{name: "dex answers 503", failure: &dexFailure{status: http.StatusServiceUnavailable, body: "upstream connect error"}},
+		{name: "dex answers an internal error", failure: &dexFailure{status: http.StatusInternalServerError, body: `{"error":"invalid_request"}`}},
+		{name: "dex answers 429", failure: &dexFailure{status: http.StatusTooManyRequests, body: `{"error":"rate_limited"}`}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			dex := newFakeDex(t)
+			cookie := signInThroughDex(t, newDeckhouseReplica(t, dex, 10*time.Minute))
+			replica := newDeckhouseReplica(t, dex, 10*time.Minute)
+
+			if tt.failure == nil {
+				dex.stop()
+			} else {
+				dex.fail(tt.failure)
+			}
+			expectRefreshUnavailable(t, replica, cookie)
+
+			if tt.failure == nil {
+				dex.start()
+			} else {
+				dex.fail(nil)
+			}
+			expectRefreshRecovered(t, replica, cookie)
+		})
+	}
+}
+
+// TestRefreshUnavailableKeepsStoredSession checks the same for a session in the Redis of the replica
+// whose ID token expired: without dex the proxy cannot check it, so it answers 503 instead of ending it.
+func TestRefreshUnavailableKeepsStoredSession(t *testing.T) {
+	dex := newFakeDex(t)
+	dex.idTTL = time.Second
+	replica := newDeckhouseReplica(t, dex, time.Second)
+	cookie := signInThroughDex(t, replica)
+	// The age of a session is counted in whole seconds.
+	time.Sleep(2*time.Second + 100*time.Millisecond)
+
+	dex.fail(&dexFailure{status: http.StatusServiceUnavailable})
+	expectRefreshUnavailable(t, replica, cookie)
+
+	dex.fail(nil)
+	expectRefreshRecovered(t, replica, cookie)
+}
+
+// TestRefreshUnavailableOtherEndpoints checks the endpoints other than /auth while dex cannot refresh
+// the session: /oauth2/userinfo answers 503 as well, and sign-out still clears the cookie.
+func TestRefreshUnavailableOtherEndpoints(t *testing.T) {
+	dex := newFakeDex(t)
+	cookie := signInThroughDex(t, newDeckhouseReplica(t, dex, 10*time.Minute))
+	replica := newDeckhouseReplica(t, dex, 10*time.Minute)
+	dex.fail(&dexFailure{status: http.StatusBadGateway})
+
+	rw := serveWithCookie(replica, "/oauth2/userinfo", cookie)
+	assert.Equal(t, http.StatusServiceUnavailable, rw.Code)
+	assert.NotEmpty(t, rw.Header().Get("Retry-After"))
+	assert.Nil(t, sessionCookie(replica, rw))
+
+	rw = serveWithCookie(replica, "/oauth2/sign_out", cookie)
+	assert.Equal(t, http.StatusFound, rw.Code)
+	cleared := sessionCookie(replica, rw)
+	require.NotNil(t, cleared, "sign-out clears the cookie while dex is unavailable")
+	assert.Empty(t, cleared.Value)
+}
+
+// TestRefreshInvalidGrantClearsSession checks that a refresh token dex refuses still ends the session:
+// /auth answers 401 and the cookie is cleared.
+func TestRefreshInvalidGrantClearsSession(t *testing.T) {
+	dex := newFakeDex(t)
+	cookie := signInThroughDex(t, newDeckhouseReplica(t, dex, 10*time.Minute))
+	replica := newDeckhouseReplica(t, dex, 10*time.Minute)
+	dex.fail(&dexFailure{status: http.StatusBadRequest, body: `{"error":"invalid_grant","error_description":"Refresh token is invalid or has already been claimed by another client."}`})
+
+	rw := serveWithCookie(replica, "/oauth2/auth", cookie)
+	assert.Equal(t, http.StatusUnauthorized, rw.Code)
+	cleared := sessionCookie(replica, rw)
+	require.NotNil(t, cleared)
+	assert.Empty(t, cleared.Value, "the cookie of a refused refresh token is cleared")
+}
+
+// TestParallelRequestsRefreshOnce checks that parallel requests with one cookie to a replica without
+// the session in its Redis refresh the session through dex once: the stub of patch 002 refreshes
+// under the lock of its ticket, as a stored session does.
+func TestParallelRequestsRefreshOnce(t *testing.T) {
+	const requests = 10
+
+	dex := newFakeDex(t)
+	cookie := signInThroughDex(t, newDeckhouseReplica(t, dex, 10*time.Minute))
+	replica := newDeckhouseReplica(t, dex, 10*time.Minute)
+	dex.slowDown(200 * time.Millisecond)
+
+	codes := make([]int, requests)
+	var wg sync.WaitGroup
+	for i := range requests {
+		wg.Go(func() {
+			codes[i] = serveWithCookie(replica, "/oauth2/auth", cookie).Code
+		})
+	}
+	wg.Wait()
+
+	for i, code := range codes {
+		assert.True(t, isSuccess(code), "request %d: %d", i, code)
+	}
+	assert.EqualValues(t, 1, dex.refreshes.Load(), "one refresh through dex for one cookie")
+}
+
+// TestSignInIssuesNewTicket checks that a new sign-in issues a new session ticket even when the browser
+// still has a valid session cookie. With the ticket of that cookie, a replica that keeps the previous
+// session under it in its own Redis would serve the previous user until the next refresh.
+func TestSignInIssuesNewTicket(t *testing.T) {
+	dex := newFakeDex(t)
+	signInReplica := newDeckhouseReplica(t, dex, 10*time.Minute)
+	otherReplica := newDeckhouseReplica(t, dex, 10*time.Minute)
+
+	first := signInThroughDex(t, signInReplica)
+	require.Equal(t, "jane.doe@example.com", userInfoEmail(t, otherReplica, first),
+		"the other replica restores the session through dex and keeps it in its Redis")
+
+	dex.signInAs("john.doe@example.com")
+	second := signInThroughDex(t, signInReplica, first)
+
+	assert.NotEqual(t, cookieTicket(t, signInReplica, first), cookieTicket(t, signInReplica, second))
+	assert.Equal(t, "john.doe@example.com", userInfoEmail(t, otherReplica, second),
+		"the other replica serves the new sign-in, not the session it keeps for the previous cookie")
+	assert.Equal(t, "john.doe@example.com", userInfoEmail(t, signInReplica, second))
+	assert.False(t, strings.Contains(second.Value, "jane"))
+}
