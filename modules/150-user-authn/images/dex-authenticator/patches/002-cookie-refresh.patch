+// expectRefreshTokenOnlySession checks the session a persistent store returns for a ticket it holds
+// no data for. The ticket cookie carries the refresh token of the session, so the store returns a
+// stub session that holds that refresh token, a placeholder user and no tokens or email, and is
+// older than the refresh period. With a refresh period above zero the proxy refreshes the stub
+// instead of trusting it, which restores access after the store lost its data.
+func expectRefreshTokenOnlySession(s *sessionsapi.SessionState, refreshToken string, refreshPeriod time.Duration) {
+	Expect(s).ToNot(BeNil())
+	Expect(s.RefreshToken).To(Equal(refreshToken))
+	Expect(s.AccessToken).To(BeEmpty())
+	Expect(s.IDToken).To(BeEmpty())
+	Expect(s.Email).To(BeEmpty())
+	Expect(s.Age()).To(BeNumerically(">", refreshPeriod))
+}
