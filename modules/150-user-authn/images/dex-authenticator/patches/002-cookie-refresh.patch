new file mode 100644
index 00000000..959876ef
--- /dev/null
+++ b/pkg/middleware/deckhouse_refresh_unavailable.go
@@ -0,0 +1,35 @@
+package middleware
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/url"
+
+	"golang.org/x/oauth2"
+)
+
+// errRefreshUnavailable means that a session is due for a refresh that cannot be made now: the
+// provider is unreachable or answered a temporary error, or the lock of the session could not be taken
+// (Deckhouse patch 002). Nothing is known against the session, so the loader keeps it with its cookie,
+// which holds the only copy of the refresh token of a session restored from the cookie, and the request
+// is answered 503 instead of being sent to log in.
+var errRefreshUnavailable = errors.New("the session cannot be refreshed now")
+
+// isProviderUnavailable reports whether a refresh failed without an answer of the provider about the
+// refresh token: the request did not reach the provider or got no answer (connection, TLS, timeout), or
+// the provider answered 429 or a 5xx status. dex answers its internal errors with 500 and the OAuth 2.0
+// code invalid_request, so the status decides, not the code, except for a refusal: dex answers the
+// refresh of a locked account with 429 access_denied, and that is an answer about the user.
+func isProviderUnavailable(err error) bool {
+	if retrieveErr, ok := errors.AsType[*oauth2.RetrieveError](err); ok {
+		if retrieveErr.Response == nil || isFatalRefreshError(retrieveErr) {
+			return false
+		}
+		status := retrieveErr.Response.StatusCode
+		return status == http.StatusTooManyRequests || status >= http.StatusInternalServerError
+	}
+
+	_, isTransportErr := errors.AsType[*url.Error](err)
+	return isTransportErr || errors.Is(err, context.DeadlineExceeded) || errors.Is(err, context.Canceled)
+}
