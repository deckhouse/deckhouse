+// The whole way of a refresh dex completes late, through the ticket cookie and the persistent
+// store: the browser keeps the cookie with the replaced refresh token, and its next request gets
+// the tokens dex issued and a cookie with the new refresh token, without a second refresh.
+func TestLateRefreshReachesTheBrowser(t *testing.T) {
+	for _, encrypts := range []bool{false, true} {
+		synctest.Test(t, func(t *testing.T) {
+			cookieOpts := &options.Cookie{
+				Name:                "_oauth2_proxy",
+				Secret:              strings.Repeat("s", 32),
+				Expire:              24 * time.Hour,
+				EncryptRefreshToken: encrypts,
+			}
+			manager := persistence.NewManager(sessiontests.NewMockStore(), cookieOpts)
+
+			var refreshes atomic.Int32
+			loader := newStoredSessionLoader(&StoredSessionLoaderOptions{
+				SessionStore:  manager,
+				RefreshPeriod: time.Minute,
+				RefreshSession: func(ctx context.Context, ss *sessionsapi.SessionState) (bool, error) {
+					refreshes.Add(1)
+					select {
+					case <-ctx.Done():
+						return false, ctx.Err()
+					case <-time.After(25 * time.Second):
+					}
+					ss.RefreshToken, ss.IDToken = "rotated-refresh-token", "new-id-token"
+					return true, nil
+				},
+				// The ID token of the session has expired: the session needs the refresh.
+				ValidateSession: func(_ context.Context, ss *sessionsapi.SessionState) bool {
+					return ss.IDToken == "new-id-token"
+				},
+			})
+
+			// serve answers a request with the cookies and returns its scope and the cookies set.
+			serve := func(cookies []*http.Cookie) (*middlewareapi.RequestScope, []*http.Cookie) {
+				scope := &middlewareapi.RequestScope{}
+				req := middlewareapi.AddRequestScope(httptest.NewRequest(http.MethodGet, "http://example.com/", nil), scope)
+				for _, c := range cookies {
+					req.AddCookie(c)
+				}
+				rw := httptest.NewRecorder()
+				loader.loadSession(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(rw, req)
+				return scope, rw.Result().Cookies()
+			}
+
+			createdAt := time.Now().Add(-time.Hour)
+			signIn := httptest.NewRecorder()
+			require.NoError(t, manager.Save(signIn, httptest.NewRequest(http.MethodGet, "http://example.com/", nil), &sessionsapi.SessionState{
+				CreatedAt:    &createdAt,
+				Email:        "john.doe@example.com",
+				RefreshToken: "refresh-token",
+				IDToken:      "expired-id-token",
+			}))
+			oldCookies := signIn.Result().Cookies()
+			require.Len(t, oldCookies, 1)
+
+			scope, set := serve(oldCookies)
+			assert.True(t, scope.SessionUnavailable, "dex has not answered within the deadline of the request")
+			assert.Empty(t, set, "the cookie of the browser is neither replaced nor cleared")
+
+			time.Sleep(20 * time.Second)
+			synctest.Wait()
+
+			scope, set = serve(oldCookies)
+			require.NotNil(t, scope.Session)
+			assert.False(t, scope.SessionUnavailable)
+			assert.Equal(t, "rotated-refresh-token", scope.Session.RefreshToken, "the token dex issued wins over the replaced one of the cookie")
+			assert.Equal(t, "new-id-token", scope.Session.IDToken)
+			assert.Equal(t, "john.doe@example.com", scope.Session.Email)
+			require.Len(t, set, 1, "the browser gets a cookie with the new refresh token")
+
+			scope, set = serve(set)
+			require.NotNil(t, scope.Session)
+			assert.Equal(t, "rotated-refresh-token", scope.Session.RefreshToken)
+			assert.Empty(t, set, "the new cookie is not behind the session")
+			assert.EqualValues(t, 1, refreshes.Load(), "dex was asked once")
+		})
+	}
+}
