@@ -0,0 +1,170 @@
+package middleware
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+
+	middlewareapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/middleware"
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+)
+
+// retrieveError returns the error the oauth2 package returns for an answer of the token endpoint.
+func retrieveError(status int, code string) error {
+	return &oauth2.RetrieveError{
+		Response:  &http.Response{StatusCode: status, Status: http.StatusText(status)},
+		ErrorCode: code,
+	}
+}
+
+// dexAnswer returns the error the oauth2 package returns for a refresh that dex answers with status
+// and body, so the error carries what the package parses from a real answer.
+func dexAnswer(t *testing.T, status int, body string) error {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(status)
+		_, _ = w.Write([]byte(body))
+	}))
+	t.Cleanup(srv.Close)
+	cfg := &oauth2.Config{ClientID: "dex-authenticator", ClientSecret: "secret", Endpoint: oauth2.Endpoint{TokenURL: srv.URL}}
+	_, err := cfg.TokenSource(t.Context(), &oauth2.Token{RefreshToken: "refresh-token"}).Token()
+	require.Error(t, err)
+	return err
+}
+
+// dexLockedBody is what dex answers to the refresh of a locked account (patch 210 of the Dex image).
+const dexLockedBody = `{"error":"access_denied","error_description":"Account locked"}`
+
+// providerError wraps an error the way the OIDC provider and the loader do on a refresh.
+func providerError(err error) error {
+	return fmt.Errorf("error refreshing tokens: %w",
+		fmt.Errorf("unable to redeem refresh token: %w", fmt.Errorf("failed to get token: %w", err)))
+}
+
+func TestIsProviderUnavailable(t *testing.T) {
+	refused := &url.Error{Op: "Post", URL: "https://dex.d8-user-authn/token", Err: &net.OpError{Op: "dial", Err: errors.New("connection refused")}}
+
+	tests := []struct {
+		name     string
+		err      error
+		expected bool
+	}{
+		{name: "no error", err: nil, expected: false},
+		{name: "connection refused", err: providerError(refused), expected: true},
+		{name: "timeout", err: providerError(context.DeadlineExceeded), expected: true},
+		{name: "503", err: providerError(retrieveError(http.StatusServiceUnavailable, "")), expected: true},
+		{name: "dex internal error", err: providerError(retrieveError(http.StatusInternalServerError, "invalid_request")), expected: true},
+		{name: "429", err: providerError(retrieveError(http.StatusTooManyRequests, "")), expected: true},
+		{name: "invalid grant", err: providerError(retrieveError(http.StatusBadRequest, "invalid_grant")), expected: false},
+		{name: "locked account", err: providerError(retrieveError(http.StatusTooManyRequests, "access_denied")), expected: false},
+		{name: "invalid request", err: providerError(retrieveError(http.StatusBadRequest, "invalid_request")), expected: false},
+		{name: "invalid client", err: providerError(retrieveError(http.StatusUnauthorized, "invalid_client")), expected: false},
+		{name: "answer without a response", err: providerError(&oauth2.RetrieveError{}), expected: false},
+		{name: "other error", err: providerError(errors.New("unable to save session")), expected: false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, isProviderUnavailable(tt.err))
+		})
+	}
+
+	t.Run("answers of dex", func(t *testing.T) {
+		locked := providerError(dexAnswer(t, http.StatusTooManyRequests, dexLockedBody))
+		assert.False(t, isProviderUnavailable(locked), "a locked account is an answer about the user")
+		assert.True(t, isFatalRefreshError(locked))
+		limited := providerError(dexAnswer(t, http.StatusTooManyRequests, "Too many requests\n"))
+		assert.True(t, isProviderUnavailable(limited), "the rate limit of dex is no answer about the token")
+		assert.False(t, isFatalRefreshError(limited))
+	})
+}
+
+// TestLoadSessionKeepsUnavailableSession checks the loader on a session due for a refresh: a refresh that
+// cannot be made now keeps the session and its cookie and marks the request, and a refresh token the
+// provider refuses still clears the session.
+func TestLoadSessionKeepsUnavailableSession(t *testing.T) {
+	tests := []struct {
+		name               string
+		lock               sessionsapi.Lock
+		refreshErr         error
+		expectsUnavailable bool
+		expectsCleared     bool
+	}{
+		{
+			name:               "provider unavailable",
+			lock:               &testLock{},
+			refreshErr:         retrieveError(http.StatusServiceUnavailable, ""),
+			expectsUnavailable: true,
+		},
+		{
+			name:               "lock unavailable",
+			lock:               &testLock{obtainError: errors.New("dial tcp 127.0.0.1:6379: connection refused")},
+			expectsUnavailable: true,
+		},
+		{
+			name:           "refresh token refused",
+			lock:           &testLock{},
+			refreshErr:     retrieveError(http.StatusBadRequest, "invalid_grant"),
+			expectsCleared: true,
+		},
+		{
+			name:           "account locked at dex",
+			lock:           &testLock{},
+			refreshErr:     dexAnswer(t, http.StatusTooManyRequests, dexLockedBody),
+			expectsCleared: true,
+		},
+		{
+			name:           "request refused",
+			lock:           &testLock{},
+			refreshErr:     retrieveError(http.StatusBadRequest, "invalid_request"),
+			expectsCleared: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			createdAt := time.Now().Add(-time.Hour)
+			cleared := false
+			store := &fakeSessionStore{
+				LoadFunc: func(*http.Request) (*sessionsapi.SessionState, error) {
+					return &sessionsapi.SessionState{CreatedAt: &createdAt, RefreshToken: "refresh-token", Lock: tt.lock}, nil
+				},
+				ClearFunc: func(http.ResponseWriter, *http.Request) error {
+					cleared = true
+					return nil
+				},
+			}
+			loader := NewStoredSessionLoader(&StoredSessionLoaderOptions{
+				SessionStore:  store,
+				RefreshPeriod: time.Minute,
+				RefreshSession: func(context.Context, *sessionsapi.SessionState) (bool, error) {
+					return false, fmt.Errorf("unable to redeem refresh token: %w", tt.refreshErr)
+				},
+				// The stub of a session restored from the cookie has no ID token to validate.
+				ValidateSession: func(context.Context, *sessionsapi.SessionState) bool { return false },
+			})
+
+			scope := &middlewareapi.RequestScope{}
+			req := middlewareapi.AddRequestScope(httptest.NewRequest(http.MethodGet, "/", nil), scope)
+			var nextCalled bool
+			loader(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
+				nextCalled = true
+			})).ServeHTTP(httptest.NewRecorder(), req)
+
+			require.True(t, nextCalled)
+			assert.Nil(t, scope.Session, "a session that is not refreshed is not served")
+			assert.Equal(t, tt.expectsUnavailable, scope.SessionUnavailable)
+			assert.Equal(t, tt.expectsCleared, cleared)
+		})
+	}
+}
