+// A session whose cookie is behind it gets the cookie written again with the answer of the
+// request, and a session with the cookie it has is not saved.
+func TestStaleCookieIsWrittenAgain(t *testing.T) {
+	tests := []struct {
+		name string
+		// isStale is what the store says of the cookie when the request loads the session, and
+		// isFreshAfterLock makes it say otherwise once the request has the lock.
+		isStale          bool
+		isFreshAfterLock bool
+		lock             sessionsapi.Lock
+		saveErr          error
+		expectedSaves    int
+	}{
+		{name: "cookie behind the session", isStale: true, expectedSaves: 1},
+		{name: "cookie of the session", expectedSaves: 0},
+		{name: "store that cannot save", isStale: true, saveErr: errors.New("redis: connection refused"), expectedSaves: 1},
+		// A refresh of another request holds the lock: its answer writes the cookie.
+		{name: "session being refreshed", isStale: true, lock: &testLock{obtainError: sessionsapi.ErrLockNotObtained}, expectedSaves: 0},
+		// The session was refreshed between the load of the request and the lock: saving the
+		// tokens the request loaded would put the replaced refresh token back.
+		{name: "session refreshed meanwhile", isStale: true, isFreshAfterLock: true, expectedSaves: 0},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			createdAt := time.Now()
+			var writers []http.ResponseWriter
+			lock := tt.lock
+			if lock == nil {
+				lock = &testLock{}
+			}
+			loads := 0
+			loader := newStoredSessionLoader(&StoredSessionLoaderOptions{
+				SessionStore: &fakeSessionStore{
+					LoadFunc: func(*http.Request) (*sessionsapi.SessionState, error) {
+						loads++
+						return &sessionsapi.SessionState{
+							CreatedAt:    &createdAt,
+							RefreshToken: "rotated-refresh-token",
+							StaleCookie:  tt.isStale && (loads == 1 || !tt.isFreshAfterLock),
+							Lock:         lock,
+						}, nil
+					},
+					SaveFunc: func(rw http.ResponseWriter, _ *http.Request, _ *sessionsapi.SessionState) error {
+						writers = append(writers, rw)
+						return tt.saveErr
+					},
+				},
+				RefreshPeriod: time.Minute,
+				RefreshSession: func(context.Context, *sessionsapi.SessionState) (bool, error) {
+					t.Error("a fresh session is not refreshed")
+					return false, nil
+				},
+				ValidateSession: func(context.Context, *sessionsapi.SessionState) bool { return true },
+			})
+
+			scope := &middlewareapi.RequestScope{}
+			req := middlewareapi.AddRequestScope(httptest.NewRequest(http.MethodGet, "/", nil), scope)
+			rw := httptest.NewRecorder()
+			loader.loadSession(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(rw, req)
+
+			require.NotNil(t, scope.Session, "the session is served whatever the save does")
+			require.Len(t, writers, tt.expectedSaves)
+			if tt.expectedSaves > 0 {
+				assert.Same(t, rw, writers[0], "the cookie goes into the answer of the request")
+			}
+			if held, ok := lock.(*testLock); ok {
+				assert.False(t, held.locked, "the lock is released")
+			}
+		})
+	}
+}
