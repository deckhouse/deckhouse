@@ -0,0 +1,83 @@
+package revocation
+
+import (
+	"encoding/base64"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// testIDToken returns an unsigned JWT with the payload: the check reads the claims without verifying.
+func testIDToken(payload string) string {
+	return "eyJhbGciOiJSUzI1NiJ9." + base64.RawURLEncoding.EncodeToString([]byte(payload)) + ".signature"
+}
+
+func TestIDTokenClaims(t *testing.T) {
+	tests := []struct {
+		name       string
+		idToken    string
+		expected   claims
+		expectedOk bool
+	}{
+		{
+			name:       "all claims",
+			idToken:    testIDToken(`{"sub":"CgRqYW5lEgVsb2NhbA","sid":"fehzwdh5qy4oyqcn7qhkcgzbm","d8_gen":3,"email":"jane@example.com"}`),
+			expected:   claims{Subject: "CgRqYW5lEgVsb2NhbA", SessionID: "fehzwdh5qy4oyqcn7qhkcgzbm", Generation: 3},
+			expectedOk: true,
+		},
+		{
+			name:       "no generation is 0",
+			idToken:    testIDToken(`{"sub":"CgRqYW5lEgVsb2NhbA"}`),
+			expected:   claims{Subject: "CgRqYW5lEgVsb2NhbA"},
+			expectedOk: true,
+		},
+		{
+			name:       "largest generation",
+			idToken:    testIDToken(`{"sub":"s","d8_gen":18446744073709551615}`),
+			expected:   claims{Subject: "s", Generation: 18446744073709551615},
+			expectedOk: true,
+		},
+		{
+			name:       "generation that is not an unsigned integer is 0",
+			idToken:    testIDToken(`{"sub":"s","d8_gen":"3"}`),
+			expected:   claims{Subject: "s"},
+			expectedOk: true,
+		},
+		{
+			name:       "negative generation is 0",
+			idToken:    testIDToken(`{"sub":"s","d8_gen":-1}`),
+			expected:   claims{Subject: "s"},
+			expectedOk: true,
+		},
+		{
+			name:       "padded payload",
+			idToken:    "h." + base64.URLEncoding.EncodeToString([]byte(`{"sub":"s"}`)) + ".s",
+			expected:   claims{Subject: "s"},
+			expectedOk: true,
+		},
+		{
+			name:    "no id token",
+			idToken: "",
+		},
+		{
+			name:    "not a jwt",
+			idToken: "opaque",
+		},
+		{
+			name:    "payload not base64url",
+			idToken: "h.!!!.s",
+		},
+		{
+			name:    "payload not json",
+			idToken: "h." + base64.RawURLEncoding.EncodeToString([]byte("text")) + ".s",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, ok := idTokenClaims(tt.idToken)
+			assert.Equal(t, tt.expectedOk, ok)
+			assert.Equal(t, tt.expected, got)
+		})
+	}
+}
diff --git a/pkg/deckhouse/revocation/events.go b/pkg/deckhouse/revocation/events.go
new file mode 100644
index 00000000..5cf4b1b6
--- /dev/null
+++ b/pkg/deckhouse/revocation/events.go
@@ -0,0 +1,157 @@
+package revocation
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+)
+
+// protocolVersion is the version of the events of the feed the subscriber understands.
+const protocolVersion = 1
+
+// The types of a revocation event.
+const (
+	revocationTypePair    = "pair"
+	revocationTypeSession = "session"
+	revocationTypeGrant   = "grant"
+)
+
+// errNewerVersion marks an event of a newer protocol: the subscriber skips it.
+var errNewerVersion = errors.New("event of a newer protocol version")
+
+// The events of the feed. Every event carries the version of the protocol in "v"; unknown fields are
+// ignored.
+type (
+	snapshotEvent struct {
+		Part     int           `json:"part"`
+		Last     bool          `json:"last"`
+		Pairs    []pairRecord  `json:"pairs"`
+		Sessions []entryRecord `json:"sessions"`
+		Grants   []entryRecord `json:"grants"`
+	}
+
+	revocationEvent struct {
+		Type string `json:"type"`
+		pairRecord
+	}
+
+	pairRecord struct {
+		Key        string `json:"k"`
+		Generation uint64 `json:"g"`
+		Expiry     int64  `json:"exp"`
+	}
+
+	entryRecord struct {
+		Key    string `json:"k"`
+		Expiry int64  `json:"exp"`
+	}
+)
+
+// decodeEvent decodes the data of an event of the feed into v after checking its protocol version.
+func decodeEvent(data []byte, v any) error {
+	var header struct {
+		Version int `json:"v"`
+	}
+	if err := json.Unmarshal(data, &header); err != nil {
+		return fmt.Errorf("decoding the event: %w", err)
+	}
+	switch {
+	case header.Version > protocolVersion:
+		return fmt.Errorf("%w %d", errNewerVersion, header.Version)
+	case header.Version < protocolVersion:
+		return fmt.Errorf("unsupported protocol version %d", header.Version)
+	}
+
+	if err := json.Unmarshal(data, v); err != nil {
+		return fmt.Errorf("decoding the event: %w", err)
+	}
+	return nil
+}
+
+// startStream prepares the state for a new stream: a snapshot interrupted with the previous stream
+// is not continued.
+func (s *state) startStream() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.snapshotPart = -1
+}
+
+// applySnapshot merges a part of a snapshot. The state becomes complete with the last part.
+func (s *state) applySnapshot(event snapshotEvent, now time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	expected := max(s.snapshotPart, 0)
+	if event.Part != expected {
+		return fmt.Errorf("snapshot part %d, expected %d", event.Part, expected)
+	}
+
+	unix := now.Unix()
+	for _, record := range event.Pairs {
+		if record.Key != "" && record.Generation > 0 && record.Expiry >= unix {
+			s.mergePair(record.Key, record.Generation, record.Expiry)
+		}
+	}
+	for _, records := range []struct {
+		target  map[string]int64
+		records []entryRecord
+	}{
+		{target: s.sessions, records: event.Sessions},
+		{target: s.grants, records: event.Grants},
+	} {
+		for _, record := range records.records {
+			if record.Key != "" && record.Expiry >= unix {
+				mergeKey(records.target, record.Key, record.Expiry)
+			}
+		}
+	}
+
+	if !event.Last {
+		s.snapshotPart = event.Part + 1
+		return nil
+	}
+	s.snapshotPart = -1
+	s.hasSnapshot = true
+	s.syncedAt = now
+	return nil
+}
+
+// applyRevocation merges a revocation. A revocation of an unknown type is ignored.
+func (s *state) applyRevocation(event revocationEvent, now time.Time) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.touch(now)
+	if event.Key == "" || event.Expiry < now.Unix() {
+		return
+	}
+	switch event.Type {
+	case revocationTypePair:
+		if event.Generation > 0 {
+			s.mergePair(event.Key, event.Generation, event.Expiry)
+		}
+	case revocationTypeSession:
+		mergeKey(s.sessions, event.Key, event.Expiry)
+	case revocationTypeGrant:
+		mergeKey(s.grants, event.Key, event.Expiry)
+	}
+}
+
+// applyHeartbeat records an event that changes nothing: a heartbeat, or an event the subscriber does
+// not know.
+func (s *state) applyHeartbeat(now time.Time) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.touch(now)
+}
+
+// touch records an event outside a snapshot: the state is complete as of now. An event in the middle of
+// a snapshot leaves the state incomplete until its last part. The caller holds the lock.
+func (s *state) touch(now time.Time) {
+	if s.snapshotPart < 0 {
+		s.syncedAt = now
+	}
+}
diff --git a/pkg/deckhouse/revocation/events_test.go b/pkg/deckhouse/revocation/events_test.go
new file mode 100644
index 00000000..875ee73f
--- /dev/null
+++ b/pkg/deckhouse/revocation/events_test.go
@@ -0,0 +1,155 @@
+package revocation
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDecodeEvent(t *testing.T) {
+	tests := []struct {
+		name          string
+		data          string
+		expected      revocationEvent
+		expectedError string
+		isNewer       bool
+	}{
+		{
+			name:     "revocation of a pair",
+			data:     `{"v":1,"type":"pair","k":"key","g":3,"exp":1760620000,"at":1760610000}`,
+			expected: revocationEvent{Type: "pair", pairRecord: pairRecord{Key: "key", Generation: 3, Expiry: 1760620000}},
+		},
+		{
+			name:     "unknown fields are ignored",
+			data:     `{"v":1,"type":"grant","k":"key","exp":1760620000,"new":{"field":[1]}}`,
+			expected: revocationEvent{Type: "grant", pairRecord: pairRecord{Key: "key", Expiry: 1760620000}},
+		},
+		{
+			name:    "newer protocol",
+			data:    `{"v":2,"type":"pair","k":["changed"]}`,
+			isNewer: true,
+		},
+		{
+			name:          "no version",
+			data:          `{"type":"pair","k":"key","g":3,"exp":1760620000}`,
+			expectedError: "unsupported protocol version 0",
+		},
+		{
+			name:          "version not a number",
+			data:          `{"v":"1"}`,
+			expectedError: "decoding the event",
+		},
+		{
+			name:          "not json",
+			data:          `revoked`,
+			expectedError: "decoding the event",
+		},
+		{
+			name:          "negative generation",
+			data:          `{"v":1,"type":"pair","k":"key","g":-1,"exp":1760620000}`,
+			expectedError: "decoding the event",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var got revocationEvent
+			err := decodeEvent([]byte(tt.data), &got)
+			switch {
+			case tt.isNewer:
+				assert.ErrorIs(t, err, errNewerVersion)
+			case tt.expectedError != "":
+				assert.ErrorContains(t, err, tt.expectedError)
+			default:
+				require.NoError(t, err)
+				assert.Equal(t, tt.expected, got)
+			}
+		})
+	}
+}
+
+func TestMonotonicMerge(t *testing.T) {
+	exp := testNow.Unix() + 100
+
+	s := newState()
+	s.applyRevocation(revocationEvent{Type: "pair", pairRecord: pairRecord{Key: "pair", Generation: 3, Expiry: exp}}, testNow)
+	// An older revocation, from another replica or a reconnection, lowers nothing.
+	s.applyRevocation(revocationEvent{Type: "pair", pairRecord: pairRecord{Key: "pair", Generation: 2, Expiry: exp + 50}}, testNow)
+	require.NoError(t, s.applySnapshot(snapshotEvent{
+		Part:     0,
+		Last:     true,
+		Pairs:    []pairRecord{{Key: "pair", Generation: 1, Expiry: exp - 50}, {Key: "other-pair", Generation: 1, Expiry: exp}},
+		Sessions: []entryRecord{{Key: "session", Expiry: exp}},
+		Grants:   []entryRecord{{Key: "grant", Expiry: exp}},
+	}, testNow))
+	// A snapshot received twice changes nothing.
+	s.startStream()
+	require.NoError(t, s.applySnapshot(snapshotEvent{
+		Part:     0,
+		Last:     true,
+		Sessions: []entryRecord{{Key: "session", Expiry: exp - 10}},
+		Grants:   []entryRecord{{Key: "grant", Expiry: exp + 10}},
+	}, testNow))
+	s.applyRevocation(revocationEvent{Type: "session", pairRecord: pairRecord{Key: "session", Expiry: exp + 20}}, testNow)
+
+	assert.Equal(t, map[string]pairEntry{
+		"pair":       {gen: 3, exp: exp + 50},
+		"other-pair": {gen: 1, exp: exp},
+	}, s.pairs)
+	assert.Equal(t, map[string]int64{"session": exp + 20}, s.sessions)
+	assert.Equal(t, map[string]int64{"grant": exp + 10}, s.grants)
+}
+
+func TestApplyIgnoresUselessRecords(t *testing.T) {
+	exp := testNow.Unix() + 100
+
+	s := newState()
+	s.applyRevocation(revocationEvent{Type: "pair", pairRecord: pairRecord{Key: "", Generation: 1, Expiry: exp}}, testNow)
+	s.applyRevocation(revocationEvent{Type: "pair", pairRecord: pairRecord{Key: "zero", Generation: 0, Expiry: exp}}, testNow)
+	s.applyRevocation(revocationEvent{Type: "grant", pairRecord: pairRecord{Key: "expired", Expiry: testNow.Unix() - 1}}, testNow)
+	s.applyRevocation(revocationEvent{Type: "unknown", pairRecord: pairRecord{Key: "unknown", Expiry: exp}}, testNow)
+	require.NoError(t, s.applySnapshot(snapshotEvent{
+		Part:     0,
+		Last:     true,
+		Pairs:    []pairRecord{{Key: "zero", Expiry: exp}, {Key: "expired", Generation: 1, Expiry: testNow.Unix() - 1}},
+		Sessions: []entryRecord{{Key: "", Expiry: exp}},
+		Grants:   []entryRecord{{Key: "expired", Expiry: testNow.Unix() - 1}},
+	}, testNow))
+
+	assert.Empty(t, s.pairs)
+	assert.Empty(t, s.sessions)
+	assert.Empty(t, s.grants)
+}
+
+func TestApplySnapshotParts(t *testing.T) {
+	t.Run("parts in order", func(t *testing.T) {
+		s := newState()
+		require.NoError(t, s.applySnapshot(snapshotEvent{Part: 0}, testNow))
+		assert.True(t, s.inSnapshot())
+		require.NoError(t, s.applySnapshot(snapshotEvent{Part: 1}, testNow))
+		require.NoError(t, s.applySnapshot(snapshotEvent{Part: 2, Last: true}, testNow))
+		assert.False(t, s.inSnapshot())
+		assert.Equal(t, StatusFresh, s.status(testNow))
+	})
+
+	t.Run("snapshot not starting with part 0", func(t *testing.T) {
+		s := newState()
+		assert.ErrorContains(t, s.applySnapshot(snapshotEvent{Part: 1, Last: true}, testNow), "snapshot part 1, expected 0")
+		assert.Equal(t, StatusNoSnapshot, s.status(testNow))
+	})
+
+	t.Run("missing part", func(t *testing.T) {
+		s := newState()
+		require.NoError(t, s.applySnapshot(snapshotEvent{Part: 0}, testNow))
+		assert.ErrorContains(t, s.applySnapshot(snapshotEvent{Part: 2, Last: true}, testNow), "snapshot part 2, expected 1")
+	})
+
+	t.Run("snapshot interrupted by a new stream", func(t *testing.T) {
+		s := newState()
+		require.NoError(t, s.applySnapshot(snapshotEvent{Part: 0}, testNow))
+		s.startStream()
+		require.NoError(t, s.applySnapshot(snapshotEvent{Part: 0, Last: true}, testNow))
+		assert.Equal(t, StatusFresh, s.status(testNow))
+	})
+}
diff --git a/pkg/deckhouse/revocation/feed.go b/pkg/deckhouse/revocation/feed.go
new file mode 100644
index 00000000..1feb24e2
--- /dev/null
+++ b/pkg/deckhouse/revocation/feed.go
@@ -0,0 +1,391 @@
+// Package revocation subscribes the proxy to the revocation feed of the user-authn module of Deckhouse
+// and refuses the sessions the feed revokes (Deckhouse patch 010).
+//
+// The feed is a text/event-stream: a snapshot of the stored revocations, then the new revocations and a
+// heartbeat every 10 seconds. A revocation names a pair of a user and a connector with its generation,
+// a session of dex or a grant of dex by a key salted with the secret of the client, and an expiry time.
+// The subscriber keeps only the keys, the generations and the expiry times.
+package revocation
+
+import (
+	"context"
+	"crypto/tls"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"io"
+	"math/rand/v2"
+	"mime"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"time"
+
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/logger"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/util"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/version"
+)
+
+const (
+	// forcedRefreshAge is the age above which a session is refreshed through the provider while the
+	// feed is not fresh: the provider refuses the revoked refresh tokens.
+	forcedRefreshAge = 30 * time.Second
+	// forcedRefreshRate and forcedRefreshBurst limit the forced refreshes of the process. Above the
+	// limit the sessions are checked against the last state of the feed only. The feed goes stale for
+	// every DexAuthenticator at once, so dex and the apiserver get this rate times the number of
+	// their pods: it is kept low.
+	forcedRefreshRate  = 5
+	forcedRefreshBurst = 10
+
+	// minBackoff and maxBackoff bound the delay before a new connection, exponential with full jitter.
+	minBackoff = time.Second
+	maxBackoff = 30 * time.Second
+	// unauthorizedPause is the delay after the feed refused the credentials of the client.
+	unauthorizedPause = time.Minute
+	// maxRetryAfter bounds the delay a 429 of the feed asks for.
+	maxRetryAfter = 5 * time.Minute
+	// errorLogInterval limits the logs of connection errors.
+	errorLogInterval = time.Minute
+	// purgeInterval is how often the expired revocations are forgotten.
+	purgeInterval = time.Minute
+)
+
+// Options configure a Feed.
+type Options struct {
+	// URL is the address of the feed, https only: the client authenticates with its secret.
+	URL string
+	// CAFile is the CA the certificate of the feed is checked against. The system roots are used only
+	// without it.
+	CAFile string
+	// ClientID and ClientSecret are the credentials of the client in dex. The feed authenticates the
+	// client with them, and the secret salts the keys of the feed.
+	ClientID     string
+	ClientSecret string
+}
+
+// Feed is the subscription of the process to the revocation feed and the state it received. Run keeps
+// the subscription; the other methods are safe for concurrent use.
+type Feed struct {
+	url           string
+	authorization string
+	client        *http.Client
+	salt          []byte
+	state         *state
+	limiter       *limiter
+	now           func() time.Time
+
+	// The fields below belong to the goroutine of Run.
+	cursor       string
+	attempt      int
+	loggedStatus Status
+	errorLog     logThrottle
+	versionLog   logThrottle
+	nextPurge    time.Time
+}
+
+// New returns a Feed for the options. It does not connect: Run does.
+func New(opts Options) (*Feed, error) {
+	feedURL, err := url.Parse(opts.URL)
+	if err != nil {
+		return nil, fmt.Errorf("parsing the revocation feed url: %w", err)
+	}
+	if feedURL.Scheme != "https" || feedURL.Host == "" {
+		return nil, fmt.Errorf("the revocation feed url %q is not an absolute https url", opts.URL)
+	}
+
+	tlsConfig := &tls.Config{MinVersion: tls.VersionTLS12}
+	if opts.CAFile != "" {
+		pool, err := util.GetCertPool([]string{opts.CAFile}, false)
+		if err != nil {
+			return nil, fmt.Errorf("loading the CA of the revocation feed: %w", err)
+		}
+		tlsConfig.RootCAs = pool
+	}
+
+	transport := &http.Transport{
+		Proxy: http.ProxyFromEnvironment,
+		DialContext: (&net.Dialer{
+			Timeout:   10 * time.Second,
+			KeepAlive: 30 * time.Second,
+		}).DialContext,
+		TLSClientConfig:       tlsConfig,
+		TLSHandshakeTimeout:   10 * time.Second,
+		ResponseHeaderTimeout: 10 * time.Second,
+	}
+
+	return &Feed{
+		url:           feedURL.String(),
+		authorization: basicAuthorization(opts.ClientID, opts.ClientSecret),
+		client:        &http.Client{Transport: transport},
+		salt:          salt(opts.ClientSecret),
+		state:         newState(),
+		limiter:       newLimiter(forcedRefreshRate, forcedRefreshBurst),
+		now:           time.Now,
+	}, nil
+}
+
+// Status returns the status of the state of the feed.
+func (f *Feed) Status() Status {
+	return f.state.status(f.now())
+}
+
+// Revoked returns the reason the feed revoked the tokens of a session for, or an empty Reason. The
+// last state received counts whatever the status. A session without an ID token, such as the stub of a
+// session restored from the cookie, is checked by its grant only.
+func (f *Feed) Revoked(session *sessionsapi.SessionState) Reason {
+	c, ok := idTokenClaims(session.IDToken)
+	grant := ""
+	if session.RefreshToken != "" {
+		grant = refreshID(session.RefreshToken)
+	}
+	return f.state.revoked(f.salt, c, ok, grant)
+}
+
+// NeedsForcedRefresh reports whether a session has to be refreshed through the provider because the
+// feed is not fresh: the session has a refresh token and is older than forcedRefreshAge. The caller
+// asks AllowForcedRefresh before it refreshes.
+func (f *Feed) NeedsForcedRefresh(session *sessionsapi.SessionState) bool {
+	return session.RefreshToken != "" &&
+		session.Age() > forcedRefreshAge &&
+		f.state.status(f.now()) != StatusFresh
+}
+
+// AllowForcedRefresh takes a forced refresh from the limit of the process.
+func (f *Feed) AllowForcedRefresh() bool {
+	return f.limiter.allow(f.now())
+}
+
+// Run keeps the subscription to the feed until ctx is done.
+func (f *Feed) Run(ctx context.Context) {
+	for {
+		wait := f.subscribe(ctx)
+		f.maintain()
+		if !sleep(ctx, wait) {
+			return
+		}
+	}
+}
+
+// subscribe connects to the feed and reads it until the stream ends. It returns the delay before the
+// next connection.
+func (f *Feed) subscribe(ctx context.Context) time.Duration {
+	streamCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+
+	req, err := http.NewRequestWithContext(streamCtx, http.MethodGet, f.url, nil)
+	if err != nil {
+		f.logErrorf("building the request: %v", err)
+		return f.backoff()
+	}
+	req.Header.Set("Accept", "text/event-stream")
+	req.Header.Set("Cache-Control", "no-cache")
+	req.Header.Set("Authorization", f.authorization)
+	req.Header.Set("User-Agent", "oauth2-proxy/"+version.VERSION)
+	if f.cursor != "" {
+		req.Header.Set("Last-Event-ID", f.cursor)
+	}
+
+	resp, err := f.client.Do(req)
+	if err != nil {
+		if ctx.Err() != nil {
+			return 0
+		}
+		f.logErrorf("connecting: %v", err)
+		return f.backoff()
+	}
+	defer resp.Body.Close()
+
+	switch {
+	case resp.StatusCode == http.StatusOK && isEventStream(resp.Header.Get("Content-Type")):
+	case resp.StatusCode == http.StatusUnauthorized:
+		logger.Errorf("The revocation feed refused the credentials of the client (401), retrying in %s", unauthorizedPause)
+		f.attempt++
+		return unauthorizedPause
+	case resp.StatusCode == http.StatusTooManyRequests:
+		f.logErrorf("the feed limits the connections (429)")
+		wait := f.backoff()
+		if retryAfter, ok := parseRetryAfter(resp.Header.Get("Retry-After")); ok {
+			wait = retryAfter
+		}
+		return wait
+	default:
+		f.logErrorf("unexpected response %d %q", resp.StatusCode, resp.Header.Get("Content-Type"))
+		return f.backoff()
+	}
+
+	err = f.stream(streamCtx, cancel, resp.Body)
+	switch {
+	case ctx.Err() != nil:
+		return 0
+	case errors.Is(err, errProtocol):
+		// Start over from a snapshot: resuming would skip the event again.
+		f.cursor = ""
+		f.logErrorf("%v", err)
+	case errors.Is(err, context.Canceled):
+		f.logErrorf("no event for %s, reconnecting", freshFor)
+	case errors.Is(err, io.EOF):
+		f.logErrorf("the stream ended")
+	default:
+		f.logErrorf("reading the stream: %v", err)
+	}
+	return f.backoff()
+}
+
+// errProtocol marks an event the subscriber cannot apply.
+var errProtocol = errors.New("protocol error")
+
+// stream applies the events of a stream until it ends. A stream without an event for freshFor is
+// cancelled: the feed sends a heartbeat every 10 seconds.
+func (f *Feed) stream(ctx context.Context, cancel context.CancelFunc, body io.Reader) error {
+	f.state.startStream()
+	watchdog := time.AfterFunc(freshFor, cancel)
+	defer watchdog.Stop()
+
+	events := newSSEReader(body)
+	for {
+		event, err := events.next()
+		if err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			return err
+		}
+		watchdog.Reset(freshFor)
+
+		if err := f.apply(event); err != nil {
+			return fmt.Errorf("%w: %s event: %w", errProtocol, event.Name, err)
+		}
+		f.attempt = 0
+		f.maintain()
+	}
+}
+
+// apply applies an event to the state and advances the cursor. Unknown events count as a sign of life;
+// an event of a newer protocol is skipped.
+func (f *Feed) apply(event sseEvent) error {
+	now := f.now()
+
+	switch event.Name {
+	case "snapshot":
+		var snapshot snapshotEvent
+		if err := decodeEvent(event.Data, &snapshot); err != nil {
+			return f.skipNewer(err)
+		}
+		if err := f.state.applySnapshot(snapshot, now); err != nil {
+			return err
+		}
+	case "revocation":
+		var revocation revocationEvent
+		if err := decodeEvent(event.Data, &revocation); err != nil {
+			return f.skipNewer(err)
+		}
+		f.state.applyRevocation(revocation, now)
+	case "heartbeat":
+		if err := decodeEvent(event.Data, &struct{}{}); err != nil {
+			return f.skipNewer(err)
+		}
+		f.state.applyHeartbeat(now)
+	default:
+		f.state.applyHeartbeat(now)
+	}
+
+	// The cursor moves only past a complete state: resuming in the middle of a snapshot would lose
+	// its remaining parts.
+	if event.HasID && !f.state.inSnapshot() {
+		f.cursor = event.ID
+	}
+	return nil
+}
+
+// skipNewer returns nil for an event of a newer protocol, which the subscriber skips, and err otherwise.
+func (f *Feed) skipNewer(err error) error {
+	if !errors.Is(err, errNewerVersion) {
+		return err
+	}
+	if ok, suppressed := f.versionLog.allow(f.now(), errorLogInterval); ok {
+		logger.Printf("WARNING: Skipping an event of the revocation feed: %v (%d more skipped)", err, suppressed)
+	}
+	return nil
+}
+
+// maintain forgets the expired revocations once in purgeInterval and logs a change of the status.
+func (f *Feed) maintain() {
+	now := f.now()
+	if !now.Before(f.nextPurge) {
+		f.state.purge(now)
+		f.nextPurge = now.Add(purgeInterval)
+	}
+
+	status := f.state.status(now)
+	if status == f.loggedStatus {
+		return
+	}
+	f.loggedStatus = status
+	switch status {
+	case StatusFresh:
+		logger.Printf("The revocation feed is fresh")
+	case StatusStale:
+		logger.Printf("WARNING: The revocation feed is stale: sessions older than %s are refreshed through the provider", forcedRefreshAge)
+	}
+}
+
+// logErrorf logs an error of the subscription, once in errorLogInterval.
+func (f *Feed) logErrorf(format string, args ...any) {
+	if ok, suppressed := f.errorLog.allow(f.now(), errorLogInterval); ok {
+		logger.Printf("WARNING: Revocation feed: %s (%d more errors suppressed)", fmt.Sprintf(format, args...), suppressed)
+	}
+}
+
+// backoff returns the delay before the next connection, exponential from minBackoff to maxBackoff with
+// full jitter.
+func (f *Feed) backoff() time.Duration {
+	ceiling := maxBackoff
+	if f.attempt < 5 {
+		ceiling = min(maxBackoff, minBackoff<<f.attempt)
+	}
+	f.attempt++
+	return rand.N(ceiling) //nolint:gosec // G404: the jitter of a retry, not a secret
+}
+
+// basicAuthorization returns the HTTP Basic credentials of a client, URL-encoded as for the token
+// endpoint (RFC 6749, section 2.3.1).
+func basicAuthorization(clientID, clientSecret string) string {
+	credentials := url.QueryEscape(clientID) + ":" + url.QueryEscape(clientSecret)
+	return "Basic " + base64.StdEncoding.EncodeToString([]byte(credentials))
+}
+
+func isEventStream(contentType string) bool {
+	mediaType, _, err := mime.ParseMediaType(contentType)
+	return err == nil && mediaType == "text/event-stream"
+}
+
+// parseRetryAfter reads the delay of a Retry-After header in seconds, up to maxRetryAfter.
+func parseRetryAfter(value string) (time.Duration, bool) {
+	seconds, err := strconv.Atoi(value)
+	if err != nil || seconds < 0 {
+		return 0, false
+	}
+	if seconds > int(maxRetryAfter/time.Second) {
+		return maxRetryAfter, true
+	}
+	return time.Duration(seconds) * time.Second, true
+}
+
+// sleep waits for d or until ctx is done, and reports whether ctx is still alive.
+func sleep(ctx context.Context, d time.Duration) bool {
+	if ctx.Err() != nil {
+		return false
+	}
+
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+
+	select {
+	case <-ctx.Done():
+		return false
+	case <-timer.C:
+		return true
+	}
+}
