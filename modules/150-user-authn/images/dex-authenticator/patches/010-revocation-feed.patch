+func TestFeedResumesWithTheCursor(t *testing.T) {
+	captureLogs(t)
+	server := newFakeFeed(t, func(w http.ResponseWriter, _ *http.Request, n int) {
+		startStream(w)
+		switch n {
+		case 0:
+			writeEvent(w, "snapshot", "e.7", `{"v":1,"part":0,"last":true}`)
+			writeEvent(w, "heartbeat", "e.9", `{"v":1,"t":1}`)
+		case 1:
+			// A snapshot cut short leaves the cursor where it was.
+			writeEvent(w, "snapshot", "f.3", `{"v":1,"part":0,"last":false}`)
+		case 2:
+			writeEvent(w, "snapshot", "f.3", `{"v":1,"part":0,"last":false}`)
+			writeEvent(w, "snapshot", "f.3", `{"v":1,"part":1,"last":true}`)
+		}
+	})
+	feed := server.subscriber(t)
+
+	for range 4 {
+		feed.subscribe(context.Background())
+	}
+
+	require.Equal(t, 4, server.connections())
+	assert.Empty(t, server.header(0).Get("Last-Event-ID"))
+	assert.Equal(t, "e.9", server.header(1).Get("Last-Event-ID"))
+	assert.Equal(t, "e.9", server.header(2).Get("Last-Event-ID"))
+	assert.Equal(t, "f.3", server.header(3).Get("Last-Event-ID"))
+}
