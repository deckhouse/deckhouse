+// TestFeedSilentStream checks that a stream without an event for freshFor is dropped, and that the state
+// turns stale with it.
+func TestFeedSilentStream(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		output, _ := captureLogs(t)
+		feed, err := New(Options{URL: "https://revocation-feed.d8-user-authn/revocations", ClientSecret: vectorSecret})
+		require.NoError(t, err)
+
+		reader, writer := io.Pipe()
+		ctx, cancelCtx := context.WithCancel(context.Background())
+		defer cancelCtx()
+		cancel := func() {
+			cancelCtx()
+			writer.CloseWithError(context.Canceled)
+		}
+		go writeEvent(writer, "snapshot", "e.1", `{"v":1,"part":0,"last":true}`)
+
+		start := time.Now()
+		err = feed.stream(ctx, cancel, reader)
+		assert.ErrorIs(t, err, context.Canceled)
+		assert.Equal(t, freshFor, time.Since(start))
+		assert.Equal(t, StatusFresh, feed.Status())
+
+		time.Sleep(time.Second)
+		feed.maintain()
+		assert.Equal(t, StatusStale, feed.Status())
+		assert.Contains(t, output.String(), "The revocation feed is fresh")
+		assert.Contains(t, output.String(), "WARNING: The revocation feed is stale")
+	})
+}
