new file mode 100644
index 00000000..9bccbac6
--- /dev/null
+++ b/pkg/deckhouse/revocation/keys.go
@@ -0,0 +1,69 @@
+package revocation
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+)
+
+// saltMessage derives the salt of a client from its secret. The feed server derives the same salt.
+const saltMessage = "deckhouse.io/user-authn/revocation-feed/v1/salt"
+
+// keyLength is the length of a key before encoding: 128 bits, a collision only refuses a session.
+const keyLength = 16
+
+// maxRefreshIDLength bounds the ID of a grant in a refresh token; dex generates IDs of 25 characters.
+const maxRefreshIDLength = 1024
+
+// keyType names what a key of the feed stands for.
+type keyType string
+
+const (
+	// keyPair is the pair of a user and a connector, the "sub" claim of an ID token of dex.
+	keyPair keyType = "pair"
+	// keySession is a session of dex, the "sid" claim of an ID token.
+	keySession keyType = "sid"
+	// keyGrant is a grant of dex, the ID of a refresh token.
+	keyGrant keyType = "grant"
+)
+
+// salt returns the salt of a client: HMAC-SHA256(key = client secret, message = saltMessage). The feed
+// carries keys, not the values they stand for, and only the client and the server know its salt.
+func salt(clientSecret string) []byte {
+	mac := hmac.New(sha256.New, []byte(clientSecret))
+	mac.Write([]byte(saltMessage))
+	return mac.Sum(nil)
+}
+
+// key returns the key of a value in the feed: the first 128 bits of HMAC-SHA256(key = salt,
+// message = type || 0x00 || value), base64url without padding.
+func key(salt []byte, t keyType, value string) string {
+	mac := hmac.New(sha256.New, salt)
+	mac.Write([]byte(t))
+	mac.Write([]byte{0})
+	mac.Write([]byte(value))
+	return base64.RawURLEncoding.EncodeToString(mac.Sum(nil)[:keyLength])
+}
+
+// refreshID returns the ID of the grant of a refresh token of dex. The token is a protobuf message
+// encoded as base64url without padding, and its first field is the ID: 0x0A, the length as a uvarint,
+// the ID. Dex treats a token it cannot decode as a raw ID, and so does refreshID.
+func refreshID(refreshToken string) string {
+	raw, err := base64.RawURLEncoding.DecodeString(refreshToken)
+	if err != nil || len(raw) < 2 || raw[0] != 0x0A {
+		return refreshToken
+	}
+
+	length, n := binary.Uvarint(raw[1:])
+	if n <= 0 || length > maxRefreshIDLength {
+		return refreshToken
+	}
+
+	start := 1 + n
+	end := start + int(length)
+	if end > len(raw) {
+		return refreshToken
+	}
+	return string(raw[start:end])
+}
diff --git a/pkg/deckhouse/revocation/keys_test.go b/pkg/deckhouse/revocation/keys_test.go
new file mode 100644
index 00000000..6468ac97
--- /dev/null
+++ b/pkg/deckhouse/revocation/keys_test.go
@@ -0,0 +1,180 @@
+package revocation
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// IDs of the test vectors. Kept in constants so that secret scanners do not take the literals
+// for credentials.
+const (
+	vectorSessionID   = "fehzwdh5qy4oyqcn7qhkcgzbm"
+	vectorGrantID     = "3w4l2zgokgsohvjnqzjrv7lmz"
+	vectorRefreshBody = "pbtiicr6kqrwrlqv3vn6h3pdr"
+)
+
+// The vectors of appendix A of the contract of the revocation feed: the feed server computes the same
+// keys from the same secret.
+const vectorSecret = "s3cr3t"
+
+// testSubject encodes the "sub" claim of dex: the protobuf message IDTokenSubject{user_id = 1,
+// conn_id = 2}, base64url without padding.
+func testSubject(userID, connectorID string) string {
+	var message []byte
+	for _, field := range []struct {
+		tag   byte
+		value string
+	}{{0x0A, userID}, {0x12, connectorID}} {
+		message = append(message, field.tag)
+		message = binary.AppendUvarint(message, uint64(len(field.value)))
+		message = append(message, field.value...)
+	}
+	return base64.RawURLEncoding.EncodeToString(message)
+}
+
+// testRefreshToken encodes a refresh token of dex: RefreshToken{refresh_id = 1, token = 2}.
+func testRefreshToken(id, token string) string {
+	var message []byte
+	message = append(message, 0x0A)
+	message = binary.AppendUvarint(message, uint64(len(id)))
+	message = append(message, id...)
+	message = append(message, 0x12)
+	message = binary.AppendUvarint(message, uint64(len(token)))
+	message = append(message, token...)
+	return base64.RawURLEncoding.EncodeToString(message)
+}
+
+func TestVectors(t *testing.T) {
+	vectorSalt := salt(vectorSecret)
+
+	tests := []struct {
+		name     string
+		got      string
+		expected string
+	}{
+		{
+			name:     "sub of a local user",
+			got:      testSubject("jane", "local"),
+			expected: "CgRqYW5lEgVsb2NhbA",
+		},
+		{
+			name:     "sub of an ldap user",
+			got:      testSubject("cn=jdoe,ou=people,dc=example,dc=org", "ldap"),
+			expected: "CiNjbj1qZG9lLG91PXBlb3BsZSxkYz1leGFtcGxlLGRjPW9yZxIEbGRhcA",
+		},
+		{
+			name:     "salt",
+			got:      hex.EncodeToString(vectorSalt),
+			expected: "81dac58c605535cd1c2c5bfd371e03b58a946289ab806a32d2ee3397ec693e62",
+		},
+		{
+			name:     "key of a pair",
+			got:      key(vectorSalt, keyPair, "CgRqYW5lEgVsb2NhbA"),
+			expected: "BtOeixcwfXZ3z6kDWHNMTw",
+		},
+		{
+			name:     "key of a session",
+			got:      key(vectorSalt, keySession, vectorSessionID),
+			expected: "0-SQllhFkuuG1ttZoMxAiA",
+		},
+		{
+			name:     "key of a grant",
+			got:      key(vectorSalt, keyGrant, vectorGrantID),
+			expected: "jVFqq8vBRSjPWcgLzpRzaA",
+		},
+		{
+			name:     "refresh token",
+			got:      testRefreshToken(vectorGrantID, vectorRefreshBody),
+			expected: "ChkzdzRsMnpnb2tnc29odmpucXpqcnY3bG16EhlwYnRpaWNyNmtxcndybHF2M3ZuNmgzcGRy",
+		},
+		{
+			name:     "refresh id of the refresh token",
+			got:      refreshID("ChkzdzRsMnpnb2tnc29odmpucXpqcnY3bG16EhlwYnRpaWNyNmtxcndybHF2M3ZuNmgzcGRy"),
+			expected: vectorGrantID,
+		},
+		{
+			// The feed server compares the hash of the secret; the vector pins the secret of the rows above.
+			name:     "sha-256 of the secret",
+			got:      hex.EncodeToString(func() []byte { sum := sha256.Sum256([]byte(vectorSecret)); return sum[:] }()),
+			expected: "4e738ca5563c06cfd0018299933d58db1dd8bf97f6973dc99bf6cdc64b5550bd",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, tt.got)
+		})
+	}
+}
+
+func TestRefreshID(t *testing.T) {
+	tests := []struct {
+		name     string
+		token    string
+		expected string
+	}{
+		{
+			name:     "token of dex",
+			token:    testRefreshToken("grant-id", "secret"),
+			expected: "grant-id",
+		},
+		{
+			name:     "raw id of an older dex",
+			token:    vectorGrantID,
+			expected: vectorGrantID,
+		},
+		{
+			name:     "not base64url",
+			token:    "not a token!",
+			expected: "not a token!",
+		},
+		{
+			name:     "another first field",
+			token:    base64.RawURLEncoding.EncodeToString([]byte{0x12, 0x01, 'x'}),
+			expected: base64.RawURLEncoding.EncodeToString([]byte{0x12, 0x01, 'x'}),
+		},
+		{
+			name:     "length beyond the token",
+			token:    base64.RawURLEncoding.EncodeToString([]byte{0x0A, 0x05, 'a', 'b'}),
+			expected: base64.RawURLEncoding.EncodeToString([]byte{0x0A, 0x05, 'a', 'b'}),
+		},
+		{
+			name:     "broken length",
+			token:    base64.RawURLEncoding.EncodeToString([]byte{0x0A, 0xFF}),
+			expected: base64.RawURLEncoding.EncodeToString([]byte{0x0A, 0xFF}),
+		},
+		{
+			name:     "empty id",
+			token:    base64.RawURLEncoding.EncodeToString([]byte{0x0A, 0x00}),
+			expected: "",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, refreshID(tt.token))
+		})
+	}
+}
+
+func TestKeyDependsOnTypeAndSalt(t *testing.T) {
+	vectorSalt := salt(vectorSecret)
+
+	assert.NotEqual(t, key(vectorSalt, keyPair, "value"), key(vectorSalt, keyGrant, "value"))
+	assert.NotEqual(t, key(vectorSalt, keyPair, "value"), key(salt("another secret"), keyPair, "value"))
+	assert.Len(t, key(vectorSalt, keySession, "value"), 22)
+}
+
+func TestBasicAuthorization(t *testing.T) {
+	// The client ID and the secret are URL-encoded before base64, as dex expects (RFC 6749, 2.3.1).
+	header := basicAuthorization("app:ns", "a b+c")
+	raw, err := base64.StdEncoding.DecodeString(header[len("Basic "):])
+
+	assert.NoError(t, err)
+	assert.Equal(t, "app%3Ans:a+b%2Bc", string(raw))
+}
diff --git a/pkg/deckhouse/revocation/limiter.go b/pkg/deckhouse/revocation/limiter.go
new file mode 100644
index 00000000..8e887f50
--- /dev/null
+++ b/pkg/deckhouse/revocation/limiter.go
@@ -0,0 +1,56 @@
+package revocation
+
+import (
+	"sync"
+	"time"
+)
+
+// limiter is a token bucket: rate tokens a second, at most burst at once.
+type limiter struct {
+	mu     sync.Mutex
+	rate   float64
+	burst  float64
+	tokens float64
+	last   time.Time
+}
+
+func newLimiter(rate, burst int) *limiter {
+	return &limiter{rate: float64(rate), burst: float64(burst), tokens: float64(burst)}
+}
+
+// allow takes a token at now and reports whether there was one.
+func (l *limiter) allow(now time.Time) bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	if !l.last.IsZero() && now.After(l.last) {
+		l.tokens = min(l.burst, l.tokens+now.Sub(l.last).Seconds()*l.rate)
+	}
+	if now.After(l.last) {
+		l.last = now
+	}
+	if l.tokens < 1 {
+		return false
+	}
+	l.tokens--
+	return true
+}
+
+// logThrottle lets a kind of log line through once in an interval and counts the lines it holds back.
+type logThrottle struct {
+	last       time.Time
+	suppressed int
+}
+
+// allow reports whether a line may be logged at now, and how many lines were held back since the last
+// one logged.
+func (t *logThrottle) allow(now time.Time, interval time.Duration) (ok bool, suppressed int) {
+	if !t.last.IsZero() && now.Sub(t.last) < interval {
+		t.suppressed++
+		return false, 0
+	}
+	suppressed = t.suppressed
+	t.last = now
+	t.suppressed = 0
+	return true, suppressed
+}
diff --git a/pkg/deckhouse/revocation/sse.go b/pkg/deckhouse/revocation/sse.go
new file mode 100644
index 00000000..fd2c681a
--- /dev/null
+++ b/pkg/deckhouse/revocation/sse.go
@@ -0,0 +1,126 @@
+package revocation
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+	"io"
+)
+
+// maxLineSize bounds a line of the stream, and the data of an event: a snapshot part of the feed holds
+// at most 512 records, far below it.
+const maxLineSize = 1 << 20
+
+var errEventTooLarge = errors.New("event data exceeds the size limit")
+
+// sseEvent is an event of a text/event-stream (the server-sent events of the HTML standard).
+type sseEvent struct {
+	// Name is the "event" field, "message" when the event has none.
+	Name string
+	// ID is the "id" field, if the event has one (HasID).
+	ID    string
+	HasID bool
+	// Data is the "data" fields of the event joined with newlines.
+	Data []byte
+}
+
+// sseReader reads the events of a text/event-stream. It ignores comments and the "retry" field: the
+// subscriber reconnects on its own schedule.
+type sseReader struct {
+	scanner *bufio.Scanner
+}
+
+func newSSEReader(r io.Reader) *sseReader {
+	scanner := bufio.NewScanner(r)
+	scanner.Buffer(make([]byte, 0, 4096), maxLineSize)
+	scanner.Split(scanSSELines)
+	return &sseReader{scanner: scanner}
+}
+
+// next returns the next event of the stream. It returns io.EOF when the stream ends; an event the
+// stream ends in the middle of is dropped, as the standard says.
+func (r *sseReader) next() (sseEvent, error) {
+	var (
+		event   sseEvent
+		data    bytes.Buffer
+		hasData bool
+	)
+
+	for r.scanner.Scan() {
+		line := r.scanner.Bytes()
+		if len(line) == 0 {
+			// An empty line dispatches the event; one without data is dropped.
+			if !hasData {
+				event = sseEvent{}
+				continue
+			}
+			if event.Name == "" {
+				event.Name = "message"
+			}
+			event.Data = bytes.Clone(data.Bytes())
+			return event, nil
+		}
+		if line[0] == ':' {
+			continue
+		}
+
+		field, value, found := bytes.Cut(line, []byte(":"))
+		if found {
+			value = bytes.TrimPrefix(value, []byte(" "))
+		}
+
+		switch string(field) {
+		case "event":
+			event.Name = string(value)
+		case "data":
+			if data.Len()+len(value)+1 > maxLineSize {
+				return sseEvent{}, errEventTooLarge
+			}
+			if hasData {
+				data.WriteByte('\n')
+			}
+			data.Write(value)
+			hasData = true
+		case "id":
+			// The standard ignores an ID with a NULL character.
+			if bytes.IndexByte(value, 0) < 0 {
+				event.ID = string(value)
+				event.HasID = true
+			}
+		}
+	}
+
+	if err := r.scanner.Err(); err != nil {
+		return sseEvent{}, err
+	}
+	return sseEvent{}, io.EOF
+}
+
+// scanSSELines splits a stream into lines ended by CRLF, LF or CR.
+func scanSSELines(data []byte, atEOF bool) (advance int, token []byte, err error) {
+	if atEOF && len(data) == 0 {
+		return 0, nil, nil
+	}
+
+	if i := bytes.IndexAny(data, "\r\n"); i >= 0 {
+		if data[i] == '\n' {
+			return i + 1, data[:i], nil
+		}
+		// A CR may be followed by the LF of the same line end.
+		if i+1 < len(data) {
+			if data[i+1] == '\n' {
+				return i + 2, data[:i], nil
+			}
+			return i + 1, data[:i], nil
+		}
+		if atEOF {
+			return i + 1, data[:i], nil
+		}
+		return 0, nil, nil
+	}
+
+	if atEOF {
+		return len(data), data, nil
+	}
+	return 0, nil, nil
+}
diff --git a/pkg/deckhouse/revocation/sse_test.go b/pkg/deckhouse/revocation/sse_test.go
new file mode 100644
index 00000000..60273b0f
--- /dev/null
+++ b/pkg/deckhouse/revocation/sse_test.go
@@ -0,0 +1,127 @@
+package revocation
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// readEvents reads the events of a stream until it ends.
+func readEvents(t *testing.T, stream io.Reader) ([]sseEvent, error) {
+	t.Helper()
+
+	reader := newSSEReader(stream)
+	events := []sseEvent{}
+	for {
+		event, err := reader.next()
+		if err != nil {
+			return events, err
+		}
+		events = append(events, event)
+	}
+}
+
+func TestSSEReader(t *testing.T) {
+	tests := []struct {
+		name     string
+		stream   string
+		expected []sseEvent
+	}{
+		{
+			name: "events of the feed",
+			stream: "retry: 5000\n\n" +
+				"event: snapshot\nid: e.7\ndata: {\"v\":1,\"part\":0,\"last\":true}\n\n" +
+				": comment\n" +
+				"event: heartbeat\nid: e.7\ndata: {\"v\":1,\"t\":1760610010}\n\n",
+			expected: []sseEvent{
+				{Name: "snapshot", ID: "e.7", HasID: true, Data: []byte(`{"v":1,"part":0,"last":true}`)},
+				{Name: "heartbeat", ID: "e.7", HasID: true, Data: []byte(`{"v":1,"t":1760610010}`)},
+			},
+		},
+		{
+			name:   "crlf and cr line ends",
+			stream: "event: a\r\ndata: 1\r\n\r\nevent: b\rdata: 2\r\r",
+			expected: []sseEvent{
+				{Name: "a", Data: []byte("1")},
+				{Name: "b", Data: []byte("2")},
+			},
+		},
+		{
+			name:     "data lines are joined, one leading space is dropped",
+			stream:   "data:first\ndata:  second\ndata\n\n",
+			expected: []sseEvent{{Name: "message", Data: []byte("first\n second\n")}},
+		},
+		{
+			name:     "an event without data is dropped",
+			stream:   "event: empty\nid: 1\n\nevent: full\ndata: x\n\n",
+			expected: []sseEvent{{Name: "full", Data: []byte("x")}},
+		},
+		{
+			name:     "an id with a null character is ignored",
+			stream:   "id: a\x00b\ndata: x\n\n",
+			expected: []sseEvent{{Name: "message", Data: []byte("x")}},
+		},
+		{
+			name:     "unknown fields are ignored",
+			stream:   "retry: 1\nfoo: bar\ndata: x\n\n",
+			expected: []sseEvent{{Name: "message", Data: []byte("x")}},
+		},
+		{
+			name:     "an event the stream ends in is dropped",
+			stream:   "data: whole\n\nevent: snapshot\ndata: half",
+			expected: []sseEvent{{Name: "message", Data: []byte("whole")}},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			events, err := readEvents(t, strings.NewReader(tt.stream))
+			assert.ErrorIs(t, err, io.EOF)
+			assert.Equal(t, tt.expected, events)
+		})
+	}
+}
+
+func TestSSEReaderLimits(t *testing.T) {
+	t.Run("line too long", func(t *testing.T) {
+		stream := "data: " + strings.Repeat("x", maxLineSize) + "\n\n"
+		_, err := readEvents(t, strings.NewReader(stream))
+		assert.ErrorIs(t, err, bufio.ErrTooLong)
+	})
+
+	t.Run("event too large", func(t *testing.T) {
+		line := "data: " + strings.Repeat("x", maxLineSize/4) + "\n"
+		_, err := readEvents(t, strings.NewReader(strings.Repeat(line, 5)+"\n"))
+		assert.ErrorIs(t, err, errEventTooLarge)
+	})
+
+	t.Run("line at the limit", func(t *testing.T) {
+		stream := "data:" + strings.Repeat("x", maxLineSize-6) + "\n\n"
+		events, err := readEvents(t, strings.NewReader(stream))
+		assert.ErrorIs(t, err, io.EOF)
+		require.Len(t, events, 1)
+		assert.Len(t, events[0].Data, maxLineSize-6)
+	})
+}
+
+func TestSSEReaderReadError(t *testing.T) {
+	failure := errors.New("connection reset")
+	stream := io.MultiReader(strings.NewReader("data: x\n\ndata: y"), &failingReader{err: failure})
+
+	events, err := readEvents(t, stream)
+	assert.ErrorIs(t, err, failure)
+	assert.Len(t, events, 1)
+}
+
+type failingReader struct {
+	err error
+}
+
+func (r *failingReader) Read([]byte) (int, error) {
+	return 0, r.err
+}
diff --git a/pkg/deckhouse/revocation/state.go b/pkg/deckhouse/revocation/state.go
new file mode 100644
index 00000000..aa65587d
--- /dev/null
+++ b/pkg/deckhouse/revocation/state.go
@@ -0,0 +1,161 @@
+package revocation
+
+import (
+	"sync"
+	"time"
+)
+
+// freshFor is how long the state stays fresh after the last event of the feed. The feed sends a
+// heartbeat every 10 seconds.
+const freshFor = 30 * time.Second
+
+// Status tells how far the state of the feed can be trusted.
+type Status int
+
+const (
+	// StatusNoSnapshot means that no whole snapshot has been received yet.
+	StatusNoSnapshot Status = iota
+	// StatusFresh means that a whole snapshot has been received and the last event is recent.
+	StatusFresh
+	// StatusStale means that the feed has been silent for longer than freshFor, or a new snapshot
+	// has not been received in whole yet.
+	StatusStale
+)
+
+func (s Status) String() string {
+	switch s {
+	case StatusFresh:
+		return "fresh"
+	case StatusStale:
+		return "stale"
+	default:
+		return "no snapshot"
+	}
+}
+
+// Reason tells why a session is revoked; an empty Reason means it is not.
+type Reason string
+
+const (
+	// ReasonPair means that the credentials of the user were revoked after the session got its tokens.
+	ReasonPair Reason = "pair"
+	// ReasonSession means that the session of dex the tokens were issued under was ended.
+	ReasonSession Reason = "session"
+	// ReasonGrant means that the grant of the refresh token of the session was revoked.
+	ReasonGrant Reason = "grant"
+)
+
+// pairEntry is the latest known revocation of a pair: the tokens of a generation below gen are revoked.
+type pairEntry struct {
+	gen uint64
+	exp int64
+}
+
+// state holds the revocations the feed has sent: keys, generations and expiry times, no tokens and no
+// names. Every update is a monotonic merge, so the order of the events, the replicas of the feed and
+// a snapshot received twice do not matter.
+type state struct {
+	mu       sync.RWMutex
+	pairs    map[string]pairEntry
+	sessions map[string]int64
+	grants   map[string]int64
+
+	// hasSnapshot is set once a whole snapshot has been received.
+	hasSnapshot bool
+	// snapshotPart is the next part of the snapshot being received, -1 when none is.
+	snapshotPart int
+	// syncedAt is the time of the last event that left the state complete: the last part of a
+	// snapshot, or an event outside a snapshot.
+	syncedAt time.Time
+}
+
+func newState() *state {
+	return &state{
+		pairs:        map[string]pairEntry{},
+		sessions:     map[string]int64{},
+		grants:       map[string]int64{},
+		snapshotPart: -1,
+	}
+}
+
+// status returns the status of the state at now.
+func (s *state) status(now time.Time) Status {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	switch {
+	case !s.hasSnapshot:
+		return StatusNoSnapshot
+	case now.Sub(s.syncedAt) > freshFor:
+		return StatusStale
+	default:
+		return StatusFresh
+	}
+}
+
+// revoked returns the reason the tokens of a session are revoked for, or an empty Reason. Claims are
+// the claims of its ID token, if it has one (ok); grant is the ID of the grant of its refresh token,
+// if it has one.
+func (s *state) revoked(salt []byte, c claims, ok bool, grant string) Reason {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	if ok && c.Subject != "" {
+		if entry, found := s.pairs[key(salt, keyPair, c.Subject)]; found && entry.gen > c.Generation {
+			return ReasonPair
+		}
+	}
+	if ok && c.SessionID != "" {
+		if _, found := s.sessions[key(salt, keySession, c.SessionID)]; found {
+			return ReasonSession
+		}
+	}
+	if grant != "" {
+		if _, found := s.grants[key(salt, keyGrant, grant)]; found {
+			return ReasonGrant
+		}
+	}
+	return ""
+}
+
+// mergePair records a revocation of a pair: the generation and the expiry time only grow.
+func (s *state) mergePair(k string, gen uint64, exp int64) {
+	entry := s.pairs[k]
+	entry.gen = max(entry.gen, gen)
+	entry.exp = max(entry.exp, exp)
+	s.pairs[k] = entry
+}
+
+// mergeKey records a revocation of a session or a grant: the expiry time only grows.
+func mergeKey(m map[string]int64, k string, exp int64) {
+	m[k] = max(m[k], exp)
+}
+
+// purge forgets the revocations that expired before now: the feed forgets them too, and no token
+// they revoke is valid any longer.
+func (s *state) purge(now time.Time) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	unix := now.Unix()
+	for k, entry := range s.pairs {
+		if entry.exp < unix {
+			delete(s.pairs, k)
+		}
+	}
+	for _, m := range []map[string]int64{s.sessions, s.grants} {
+		for k, exp := range m {
+			if exp < unix {
+				delete(m, k)
+			}
+		}
+	}
+}
+
+// inSnapshot reports whether a snapshot is being received.
+func (s *state) inSnapshot() bool {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	return s.snapshotPart >= 0
+}
diff --git a/pkg/deckhouse/revocation/state_test.go b/pkg/deckhouse/revocation/state_test.go
new file mode 100644
index 00000000..9149504b
--- /dev/null
+++ b/pkg/deckhouse/revocation/state_test.go
@@ -0,0 +1,150 @@
+package revocation
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+var testNow = time.Unix(1760610000, 0)
+
+func TestStateStatus(t *testing.T) {
+	s := newState()
+	assert.Equal(t, StatusNoSnapshot, s.status(testNow))
+
+	// Events before the first whole snapshot do not make the state fresh.
+	s.applyHeartbeat(testNow)
+	require.NoError(t, s.applySnapshot(snapshotEvent{Part: 0}, testNow))
+	assert.Equal(t, StatusNoSnapshot, s.status(testNow))
+
+	require.NoError(t, s.applySnapshot(snapshotEvent{Part: 1, Last: true}, testNow))
+	assert.Equal(t, StatusFresh, s.status(testNow))
+	assert.Equal(t, StatusFresh, s.status(testNow.Add(freshFor)))
+	assert.Equal(t, StatusStale, s.status(testNow.Add(freshFor+time.Second)))
+
+	// Any event outside a snapshot keeps the state fresh.
+	later := testNow.Add(time.Minute)
+	s.applyHeartbeat(later)
+	assert.Equal(t, StatusFresh, s.status(later))
+	s.applyRevocation(revocationEvent{Type: "unknown"}, later.Add(20*time.Second))
+	assert.Equal(t, StatusFresh, s.status(later.Add(45*time.Second)))
+
+	// A new snapshot on a new stream leaves the state stale until its last part once freshFor passes.
+	s.startStream()
+	resnapshot := later.Add(2 * time.Minute)
+	require.NoError(t, s.applySnapshot(snapshotEvent{Part: 0}, resnapshot))
+	s.applyHeartbeat(resnapshot)
+	assert.Equal(t, StatusStale, s.status(resnapshot))
+	require.NoError(t, s.applySnapshot(snapshotEvent{Part: 1, Last: true}, resnapshot))
+	assert.Equal(t, StatusFresh, s.status(resnapshot))
+}
+
+func TestStateRevoked(t *testing.T) {
+	testSalt := salt(vectorSecret)
+	s := newState()
+	exp := testNow.Add(time.Hour).Unix()
+	s.mergePair(key(testSalt, keyPair, "revoked-pair"), 3, exp)
+	mergeKey(s.sessions, key(testSalt, keySession, "ended-session"), exp)
+	mergeKey(s.grants, key(testSalt, keyGrant, "revoked-grant"), exp)
+
+	tests := []struct {
+		name     string
+		claims   claims
+		ok       bool
+		grant    string
+		expected Reason
+	}{
+		{
+			name:     "older generation",
+			claims:   claims{Subject: "revoked-pair", Generation: 2},
+			ok:       true,
+			expected: ReasonPair,
+		},
+		{
+			name:     "no generation",
+			claims:   claims{Subject: "revoked-pair"},
+			ok:       true,
+			expected: ReasonPair,
+		},
+		{
+			name:   "same generation",
+			claims: claims{Subject: "revoked-pair", Generation: 3},
+			ok:     true,
+		},
+		{
+			name:   "newer generation",
+			claims: claims{Subject: "revoked-pair", Generation: 4},
+			ok:     true,
+		},
+		{
+			name:   "another pair",
+			claims: claims{Subject: "another-pair"},
+			ok:     true,
+		},
+		{
+			name:     "ended session",
+			claims:   claims{Subject: "another-pair", SessionID: "ended-session"},
+			ok:       true,
+			expected: ReasonSession,
+		},
+		{
+			name:   "another session",
+			claims: claims{Subject: "another-pair", SessionID: "another-session"},
+			ok:     true,
+		},
+		{
+			name:     "revoked grant",
+			claims:   claims{Subject: "another-pair"},
+			ok:       true,
+			grant:    "revoked-grant",
+			expected: ReasonGrant,
+		},
+		{
+			name:     "no id token, revoked grant",
+			grant:    "revoked-grant",
+			expected: ReasonGrant,
+		},
+		{
+			name:  "no id token, another grant",
+			grant: "another-grant",
+		},
+		{
+			name:   "claims of an unreadable token are not used",
+			claims: claims{Subject: "revoked-pair"},
+		},
+		{
+			name: "nothing to check",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, s.revoked(testSalt, tt.claims, tt.ok, tt.grant))
+		})
+	}
+}
+
+func TestStateRevokedUsesTheSaltOfTheClient(t *testing.T) {
+	s := newState()
+	s.mergePair(key(salt("another client"), keyPair, "pair"), 3, testNow.Add(time.Hour).Unix())
+
+	assert.Empty(t, s.revoked(salt(vectorSecret), claims{Subject: "pair"}, true, ""))
+}
+
+func TestStatePurge(t *testing.T) {
+	s := newState()
+	s.mergePair("expired-pair", 1, testNow.Unix()-1)
+	s.mergePair("pair", 1, testNow.Unix())
+	mergeKey(s.sessions, "expired-session", testNow.Unix()-1)
+	mergeKey(s.sessions, "session", testNow.Unix()+1)
+	mergeKey(s.grants, "expired-grant", testNow.Unix()-1)
+	mergeKey(s.grants, "grant", testNow.Unix()+1)
+
+	s.purge(testNow)
+
+	assert.Equal(t, map[string]pairEntry{"pair": {gen: 1, exp: testNow.Unix()}}, s.pairs)
+	assert.Equal(t, map[string]int64{"session": testNow.Unix() + 1}, s.sessions)
+	assert.Equal(t, map[string]int64{"grant": testNow.Unix() + 1}, s.grants)
+}
diff --git a/pkg/middleware/deckhouse_revocation.go b/pkg/middleware/deckhouse_revocation.go
new file mode 100644
index 00000000..fdd94af5
--- /dev/null
+++ b/pkg/middleware/deckhouse_revocation.go
@@ -0,0 +1,47 @@
+package middleware
+
+import (
+	"errors"
+
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/deckhouse/revocation"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/logger"
+)
+
+// RevocationGuard refuses the sessions the revocation feed of Deckhouse revoked (Deckhouse patch 010).
+// *revocation.Feed implements it.
+type RevocationGuard interface {
+	// Revoked returns the reason the tokens of a session are revoked for, or an empty Reason.
+	Revoked(session *sessionsapi.SessionState) revocation.Reason
+	// NeedsForcedRefresh reports whether a session has to be refreshed through the provider because
+	// the feed is not fresh.
+	NeedsForcedRefresh(session *sessionsapi.SessionState) bool
+	// AllowForcedRefresh takes a forced refresh from the limit of the process.
+	AllowForcedRefresh() bool
+}
+
+// errSessionRevoked means that the revocation feed revoked the session. The session is removed like a
+// session that failed to load, but the revocation is logged where it is found, not as an error.
+var errSessionRevoked = errors.New("the session was revoked")
+
+// checkRevoked returns errSessionRevoked if the revocation feed revoked the session.
+func (s *storedSessionLoader) checkRevoked(session *sessionsapi.SessionState) error {
+	if s.revocation == nil {
+		return nil
+	}
+	reason := s.revocation.Revoked(session)
+	if reason == "" {
+		return nil
+	}
+	logger.Printf("Session revoked (reason: %s), removing session", reason)
+	return errSessionRevoked
+}
+
+// needsForcedRefresh reports whether the session has to be refreshed through the provider while the
+// revocation feed is not fresh, within the limit of forced refreshes. Above the limit the session is
+// checked against the last state of the feed only.
+func (s *storedSessionLoader) needsForcedRefresh(session *sessionsapi.SessionState) bool {
+	return s.revocation != nil &&
+		s.revocation.NeedsForcedRefresh(session) &&
+		s.revocation.AllowForcedRefresh()
+}
diff --git a/pkg/middleware/deckhouse_revocation_test.go b/pkg/middleware/deckhouse_revocation_test.go
new file mode 100644
index 00000000..375f80a4
--- /dev/null
+++ b/pkg/middleware/deckhouse_revocation_test.go
@@ -0,0 +1,246 @@
+package middleware
+
+import (
+	"bytes"
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	middlewareapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/middleware"
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/deckhouse/revocation"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/logger"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// fakeRevocationGuard revokes the sessions with the listed ID tokens or refresh tokens.
+type fakeRevocationGuard struct {
+	revokedTokens map[string]revocation.Reason
+	stale         bool
+	allow         bool
+
+	allowCalls int
+}
+
+func (g *fakeRevocationGuard) Revoked(session *sessionsapi.SessionState) revocation.Reason {
+	if reason, ok := g.revokedTokens[session.IDToken]; ok && session.IDToken != "" {
+		return reason
+	}
+	return g.revokedTokens[session.RefreshToken]
+}
+
+func (g *fakeRevocationGuard) NeedsForcedRefresh(session *sessionsapi.SessionState) bool {
+	return g.stale && session.RefreshToken != "" && session.Age() > 30*time.Second
+}
+
+func (g *fakeRevocationGuard) AllowForcedRefresh() bool {
+	g.allowCalls++
+	return g.allow
+}
+
+// revocationTest runs the stored session loader with a guard on a session in the store.
+type revocationTest struct {
+	guard         *fakeRevocationGuard
+	session       *sessionsapi.SessionState
+	refreshPeriod time.Duration
+	// refreshedIDToken is the ID token a refresh brings.
+	refreshedIDToken string
+
+	refreshCalls int
+	clearCalls   int
+	saveCalls    int
+}
+
+func (rt *revocationTest) run(t *testing.T) (session *sessionsapi.SessionState, output, errOutput string) {
+	t.Helper()
+
+	var outputBuffer, errBuffer bytes.Buffer
+	logger.SetOutput(&outputBuffer)
+	logger.SetErrOutput(&errBuffer)
+	t.Cleanup(func() {
+		logger.SetOutput(os.Stdout)
+		logger.SetErrOutput(os.Stderr)
+	})
+
+	store := &fakeSessionStore{
+		LoadFunc: func(*http.Request) (*sessionsapi.SessionState, error) {
+			loaded := *rt.session
+			return &loaded, nil
+		},
+		SaveFunc: func(http.ResponseWriter, *http.Request, *sessionsapi.SessionState) error {
+			rt.saveCalls++
+			return nil
+		},
+		ClearFunc: func(http.ResponseWriter, *http.Request) error {
+			rt.clearCalls++
+			return nil
+		},
+	}
+	opts := &StoredSessionLoaderOptions{
+		SessionStore:  store,
+		RefreshPeriod: rt.refreshPeriod,
+		RefreshSession: func(_ context.Context, s *sessionsapi.SessionState) (bool, error) {
+			rt.refreshCalls++
+			s.IDToken = rt.refreshedIDToken
+			return true, nil
+		},
+		ValidateSession: func(context.Context, *sessionsapi.SessionState) bool { return true },
+		Revocation:      rt.guard,
+	}
+
+	req := httptest.NewRequest(http.MethodGet, "/oauth2/auth", nil)
+	req.AddCookie(&http.Cookie{Name: "_oauth2_proxy", Value: "ticket"})
+	req = middlewareapi.AddRequestScope(req, &middlewareapi.RequestScope{})
+	NewStoredSessionLoader(opts)(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
+		session = middlewareapi.GetRequestScope(r).Session
+	})).ServeHTTP(httptest.NewRecorder(), req)
+
+	return session, outputBuffer.String(), errBuffer.String()
+}
+
+func sessionCreated(age time.Duration, idToken, refreshToken string) *sessionsapi.SessionState {
+	created := time.Now().Add(-age)
+	return &sessionsapi.SessionState{
+		CreatedAt:    &created,
+		Email:        "jane@example.com",
+		IDToken:      idToken,
+		RefreshToken: refreshToken,
+	}
+}
+
+func TestStoredSessionLoaderRevocation(t *testing.T) {
+	t.Run("revoked session is removed without a refresh", func(t *testing.T) {
+		rt := &revocationTest{
+			guard:         &fakeRevocationGuard{revokedTokens: map[string]revocation.Reason{"old-id-token": revocation.ReasonPair}},
+			session:       sessionCreated(time.Hour, "old-id-token", "refresh-token"),
+			refreshPeriod: 10 * time.Minute,
+		}
+
+		session, output, errOutput := rt.run(t)
+
+		assert.Nil(t, session)
+		assert.Equal(t, 1, rt.clearCalls)
+		assert.Zero(t, rt.refreshCalls, "a revoked session never reaches the provider")
+		assert.Contains(t, output, "Session revoked (reason: pair), removing session")
+		assert.Empty(t, errOutput, "a revocation is not an error")
+		for _, secret := range []string{"old-id-token", "refresh-token", "jane@example.com"} {
+			assert.NotContains(t, output, secret)
+		}
+	})
+
+	t.Run("stub of a session restored from the cookie is checked by its grant", func(t *testing.T) {
+		stubCreated := time.Date(1992, time.September, 30, 0, 0, 0, 0, time.UTC)
+		rt := &revocationTest{
+			guard: &fakeRevocationGuard{revokedTokens: map[string]revocation.Reason{"revoked-refresh-token": revocation.ReasonGrant}},
+			session: &sessionsapi.SessionState{
+				CreatedAt:    &stubCreated,
+				User:         "Does not found in Redis",
+				RefreshToken: "revoked-refresh-token",
+			},
+			refreshPeriod: 10 * time.Minute,
+		}
+
+		session, output, _ := rt.run(t)
+
+		assert.Nil(t, session)
+		assert.Equal(t, 1, rt.clearCalls)
+		assert.Zero(t, rt.refreshCalls)
+		assert.Contains(t, output, "Session revoked (reason: grant)")
+	})
+
+	t.Run("tokens a refresh brings are checked", func(t *testing.T) {
+		rt := &revocationTest{
+			guard:            &fakeRevocationGuard{revokedTokens: map[string]revocation.Reason{"new-id-token": revocation.ReasonSession}},
+			session:          sessionCreated(time.Hour, "old-id-token", "refresh-token"),
+			refreshPeriod:    10 * time.Minute,
+			refreshedIDToken: "new-id-token",
+		}
+
+		session, output, errOutput := rt.run(t)
+
+		assert.Nil(t, session)
+		assert.Equal(t, 1, rt.refreshCalls)
+		assert.Equal(t, 1, rt.clearCalls)
+		assert.Contains(t, output, "Session revoked (reason: session)")
+		assert.Empty(t, errOutput)
+	})
+
+	t.Run("session not revoked", func(t *testing.T) {
+		rt := &revocationTest{
+			guard:         &fakeRevocationGuard{revokedTokens: map[string]revocation.Reason{"other-id-token": revocation.ReasonPair}},
+			session:       sessionCreated(time.Minute, "id-token", "refresh-token"),
+			refreshPeriod: 10 * time.Minute,
+		}
+
+		session, _, _ := rt.run(t)
+
+		require.NotNil(t, session)
+		assert.Equal(t, "id-token", session.IDToken)
+		assert.Zero(t, rt.clearCalls)
+		assert.Zero(t, rt.refreshCalls)
+	})
+}
+
+func TestStoredSessionLoaderForcedRefresh(t *testing.T) {
+	tests := []struct {
+		name                 string
+		guard                *fakeRevocationGuard
+		age                  time.Duration
+		expectedRefreshCalls int
+		expectedAllowCalls   int
+	}{
+		{
+			name:                 "stale feed, older session",
+			guard:                &fakeRevocationGuard{stale: true, allow: true},
+			age:                  time.Minute,
+			expectedRefreshCalls: 1,
+			expectedAllowCalls:   1,
+		},
+		{
+			name:               "stale feed, limit reached",
+			guard:              &fakeRevocationGuard{stale: true},
+			age:                time.Minute,
+			expectedAllowCalls: 1,
+		},
+		{
+			name:  "stale feed, young session",
+			guard: &fakeRevocationGuard{stale: true, allow: true},
+			age:   10 * time.Second,
+		},
+		{
+			name:  "fresh feed",
+			guard: &fakeRevocationGuard{allow: true},
+			age:   time.Minute,
+		},
+		{
+			name:                 "refresh period passed",
+			guard:                &fakeRevocationGuard{stale: true, allow: true},
+			age:                  time.Hour,
+			expectedRefreshCalls: 1,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rt := &revocationTest{
+				guard:            tt.guard,
+				session:          sessionCreated(tt.age, "id-token", "refresh-token"),
+				refreshPeriod:    10 * time.Minute,
+				refreshedIDToken: "new-id-token",
+			}
+
+			session, _, errOutput := rt.run(t)
+
+			require.NotNil(t, session)
+			assert.Equal(t, tt.expectedRefreshCalls, rt.refreshCalls)
+			assert.Equal(t, tt.expectedRefreshCalls, rt.saveCalls)
+			assert.Equal(t, tt.expectedAllowCalls, tt.guard.allowCalls, "the limit is asked once, before the lock")
+			assert.Zero(t, rt.clearCalls)
+			assert.Empty(t, errOutput)
+		})
+	}
+}
