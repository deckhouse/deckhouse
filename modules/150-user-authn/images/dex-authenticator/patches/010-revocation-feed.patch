+func TestFeedBackoff(t *testing.T) {
+	feed := &Feed{}
+	for attempt, ceiling := range []time.Duration{time.Second, 2 * time.Second, 4 * time.Second, 8 * time.Second, 16 * time.Second, 30 * time.Second, 30 * time.Second} {
+		for range 20 {
+			feed.attempt = attempt
+			wait := feed.backoff()
+			assert.GreaterOrEqual(t, wait, time.Duration(0))
+			assert.Less(t, wait, ceiling, "attempt %d", attempt)
+		}
