new file mode 100644
index 00000000..c1e449dd
--- /dev/null
+++ b/pkg/deckhouse/revocation/claims.go
@@ -0,0 +1,51 @@
+package revocation
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"strconv"
+	"strings"
+)
+
+// claims are the claims of an ID token of dex that the check needs.
+type claims struct {
+	// Subject is the pair of the user and the connector ("sub").
+	Subject string
+	// SessionID is the session of dex the token was issued under ("sid"), empty without sessions.
+	SessionID string
+	// Generation is the generation of the pair the token was issued for ("d8_gen"); dex leaves out a
+	// generation of 0, and the tokens issued before the generations were introduced carry none.
+	Generation uint64
+}
+
+// idTokenClaims reads the claims of an ID token without verifying it: the proxy verified the token when
+// it got it from dex, and the session store keeps it intact. ok is false when the token is not a JWT
+// with a JSON payload.
+func idTokenClaims(idToken string) (c claims, ok bool) {
+	parts := strings.Split(idToken, ".")
+	if len(parts) != 3 {
+		return claims{}, false
+	}
+
+	payload, err := base64.RawURLEncoding.DecodeString(strings.TrimRight(parts[1], "="))
+	if err != nil {
+		return claims{}, false
+	}
+
+	var raw struct {
+		Subject    string          `json:"sub"`
+		SessionID  string          `json:"sid"`
+		Generation json.RawMessage `json:"d8_gen"`
+	}
+	if err := json.Unmarshal(payload, &raw); err != nil {
+		return claims{}, false
+	}
+
+	c = claims{Subject: raw.Subject, SessionID: raw.SessionID}
+	if len(raw.Generation) > 0 {
+		// A generation that is not an unsigned integer is read as 0: any revocation of the pair is
+		// newer than it, so the session is refused rather than trusted.
+		c.Generation, _ = strconv.ParseUint(string(raw.Generation), 10, 64)
+	}
+	return c, true
+}
