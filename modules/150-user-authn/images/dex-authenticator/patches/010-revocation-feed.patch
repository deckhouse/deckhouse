+func TestFeedSubscribe(t *testing.T) {
+	captureLogs(t)
+	exp := time.Now().Add(time.Hour).Unix()
+	server := newFakeFeed(t, func(w http.ResponseWriter, _ *http.Request, _ int) {
+		startStream(w)
+		writeEvent(w, "snapshot", "e.7", fmt.Sprintf(`{"v":1,"part":0,"last":false,"retention":4200,"pairs":[{"k":%q,"g":3,"exp":%d}],"sessions":[],"grants":[]}`,
+			testKey(keyPair, testSubjectJane), exp))
+		writeEvent(w, "snapshot", "e.7", fmt.Sprintf(`{"v":1,"part":1,"last":true,"retention":4200,"pairs":[],"sessions":[{"k":%q,"exp":%d}],"grants":[]}`,
+			testKey(keySession, "ended-session"), exp))
+		writeEvent(w, "revocation", "e.8", fmt.Sprintf(`{"v":1,"type":"grant","k":%q,"exp":%d,"at":%d}`,
+			testKey(keyGrant, "revoked-grant"), exp, time.Now().Unix()))
+		writeEvent(w, "heartbeat", "e.8", fmt.Sprintf(`{"v":1,"t":%d}`, time.Now().Unix()))
+	})
+	feed := server.subscriber(t)
+
+	wait := feed.subscribe(context.Background())
+
+	assert.Less(t, wait, minBackoff, "a stream that delivered events is followed by the shortest backoff")
+	header := server.header(0)
+	assert.Equal(t, "text/event-stream", header.Get("Accept"))
+	assert.Equal(t, basicAuthorization(testClientID, vectorSecret), header.Get("Authorization"))
+	assert.Empty(t, header.Get("Last-Event-ID"))
+
+	assert.Equal(t, StatusFresh, feed.Status())
+	assert.Equal(t, "e.8", feed.cursor)
+	assert.Equal(t, ReasonPair, feed.Revoked(testSession(2, "session", "grant")))
+	assert.Empty(t, feed.Revoked(testSession(3, "session", "grant")))
+	assert.Equal(t, ReasonSession, feed.Revoked(testSession(3, "ended-session", "grant")))
+	assert.Equal(t, ReasonGrant, feed.Revoked(testSession(3, "session", "revoked-grant")))
+	// The stub of a session restored from the cookie has a refresh token only.
+	assert.Equal(t, ReasonGrant, feed.Revoked(&sessionsapi.SessionState{RefreshToken: testRefreshToken("revoked-grant", "secret")}))
+	assert.Empty(t, feed.Revoked(&sessionsapi.SessionState{RefreshToken: testRefreshToken("grant", "secret")}))
+}
