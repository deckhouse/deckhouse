+func TestFeedConnectionErrors(t *testing.T) {
+
+	tests := []struct {
+		name          string
+		handle        func(w http.ResponseWriter, r *http.Request, n int)
+		untrustedCA   bool
+		expectedWait  time.Duration
+		maxWait       time.Duration
+		expectedError string
+		expectedLog   string
+	}{
+		{
+			name: "unauthorized",
+			handle: func(w http.ResponseWriter, _ *http.Request, _ int) {
+				w.Header().Set("WWW-Authenticate", `Basic realm="user-authn-revocations"`)
+				w.WriteHeader(http.StatusUnauthorized)
+			},
+			expectedWait:  unauthorizedPause,
+			expectedError: "The revocation feed refused the credentials of the client (401)",
+		},
+		{
+			name: "too many requests",
+			handle: func(w http.ResponseWriter, _ *http.Request, _ int) {
+				w.Header().Set("Retry-After", "7")
+				w.WriteHeader(http.StatusTooManyRequests)
+			},
+			expectedWait: 7 * time.Second,
+			expectedLog:  "the feed limits the connections (429)",
+		},
+		{
+			name: "too many requests without retry-after",
+			handle: func(w http.ResponseWriter, _ *http.Request, _ int) {
+				w.WriteHeader(http.StatusTooManyRequests)
+			},
+			maxWait:     minBackoff,
+			expectedLog: "the feed limits the connections (429)",
+		},
+		{
+			name: "not an event stream",
+			handle: func(w http.ResponseWriter, _ *http.Request, _ int) {
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(http.StatusOK)
+			},
+			maxWait:     minBackoff,
+			expectedLog: `unexpected response 200 "application/json"`,
+		},
+		{
+			name: "server error",
+			handle: func(w http.ResponseWriter, _ *http.Request, _ int) {
+				w.WriteHeader(http.StatusServiceUnavailable)
+			},
+			maxWait:     minBackoff,
+			expectedLog: "unexpected response 503",
+		},
+		{
+			name:        "certificate of another ca",
+			handle:      func(http.ResponseWriter, *http.Request, int) {},
+			untrustedCA: true,
+			maxWait:     minBackoff,
+			expectedLog: "certificate signed by unknown authority",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			output, errOutput := captureLogs(t)
+			server := newFakeFeed(t, tt.handle)
+			if tt.untrustedCA {
+				server.caFile = otherCAFile(t)
+			}
+			feed := server.subscriber(t)
+
+			wait := feed.subscribe(context.Background())
+
+			if tt.expectedWait != 0 {
+				assert.Equal(t, tt.expectedWait, wait)
+			} else {
+				assert.Less(t, wait, tt.maxWait)
+			}
+			assert.Contains(t, errOutput.String(), tt.expectedError)
+			assert.Contains(t, output.String(), tt.expectedLog)
+			assert.NotContains(t, output.String()+errOutput.String(), vectorSecret)
+			assert.Equal(t, StatusNoSnapshot, feed.Status())
+		})
+	}
+}
