@@ -0,0 +1,186 @@
+package main
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/pem"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/alicebob/miniredis/v2"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/deckhouse/revocation"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// feedKey computes a key of the revocation feed for the client secret of the tests, independently of
+// the revocation package.
+func feedKey(keyType, value string) string {
+	saltMAC := hmac.New(sha256.New, []byte(clientSecret))
+	saltMAC.Write([]byte("deckhouse.io/user-authn/revocation-feed/v1/salt"))
+	mac := hmac.New(sha256.New, saltMAC.Sum(nil))
+	mac.Write([]byte(keyType + "\x00" + value))
+	return base64.RawURLEncoding.EncodeToString(mac.Sum(nil)[:16])
+}
+
+// dexRefreshToken encodes a refresh token of dex for a grant: RefreshToken{refresh_id, token}.
+func dexRefreshToken(grant string) string {
+	message := append([]byte{0x0A, byte(len(grant))}, grant...)
+	message = append(message, 0x12, 0x05)
+	message = append(message, "token"...)
+	return base64.RawURLEncoding.EncodeToString(message)
+}
+
+// unsignedIDToken returns an ID token of jane at a generation; the check does not verify it.
+func unsignedIDToken(generation uint64) string {
+	payload := fmt.Sprintf(`{"sub":"CgRqYW5lEgVsb2NhbA","email":"jane.doe@example.com","d8_gen":%d}`, generation)
+	return "eyJhbGciOiJSUzI1NiJ9." + base64.RawURLEncoding.EncodeToString([]byte(payload)) + ".signature"
+}
+
+// withRevocationFeed points the proxy at an in-process revocation feed that revoked the generations of
+// jane below 2 and the grant "revoked-grant".
+func withRevocationFeed(t *testing.T) OptionsModifier {
+	t.Helper()
+
+	exp := time.Now().Add(time.Hour).Unix()
+	snapshot := fmt.Sprintf(`{"v":1,"part":0,"last":true,"pairs":[{"k":%q,"g":2,"exp":%d}],"grants":[{"k":%q,"exp":%d}]}`,
+		feedKey("pair", "CgRqYW5lEgVsb2NhbA"), exp, feedKey("grant", "revoked-grant"), exp)
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		fmt.Fprintf(w, "retry: 5000\n\nevent: snapshot\nid: e.1\ndata: %s\n\n", snapshot)
+		w.(http.Flusher).Flush()
+		<-r.Context().Done()
+	}))
+	t.Cleanup(server.Close)
+
+	caFile := filepath.Join(t.TempDir(), "ca.crt")
+	ca := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw})
+	require.NoError(t, os.WriteFile(caFile, ca, 0o600))
+
+	return func(opts *options.Options) {
+		opts.RevocationFeedURL = server.URL + "/revocations"
+		opts.RevocationFeedCAFile = caFile
+	}
+}
+
+// runRevocationFeed runs the subscription of the proxy until the test ends and waits for its snapshot.
+func runRevocationFeed(t *testing.T, proxy *OAuthProxy) {
+	t.Helper()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		proxy.revocationFeed.Run(ctx)
+	}()
+	t.Cleanup(func() {
+		cancel()
+		<-done
+	})
+
+	require.Eventually(t, func() bool { return proxy.revocationFeed.Status() == revocation.StatusFresh },
+		10*time.Second, 10*time.Millisecond)
+}
+
+// TestAuthOnlyRefusesRevokedSessions checks that /auth answers 401, as without a session, to a session
+// the revocation feed revoked, and clears its cookie.
+func TestAuthOnlyRefusesRevokedSessions(t *testing.T) {
+	tests := []struct {
+		name          string
+		session       *sessions.SessionState
+		dropFromRedis bool
+		expectedCode  int
+	}{
+		{
+			name:         "generation the feed revoked",
+			session:      &sessions.SessionState{IDToken: unsignedIDToken(1), RefreshToken: dexRefreshToken("grant")},
+			expectedCode: http.StatusUnauthorized,
+		},
+		{
+			name:         "generation after the revocation",
+			session:      &sessions.SessionState{IDToken: unsignedIDToken(2), RefreshToken: dexRefreshToken("grant")},
+			expectedCode: http.StatusOK,
+		},
+		{
+			name:         "grant the feed revoked",
+			session:      &sessions.SessionState{IDToken: unsignedIDToken(2), RefreshToken: dexRefreshToken("revoked-grant")},
+			expectedCode: http.StatusUnauthorized,
+		},
+		{
+			// The stub of patch 002 is refused by its grant before a refresh through dex.
+			name:          "session restored from the cookie with a revoked grant",
+			session:       &sessions.SessionState{IDToken: unsignedIDToken(2), RefreshToken: dexRefreshToken("revoked-grant")},
+			dropFromRedis: true,
+			expectedCode:  http.StatusUnauthorized,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			redis := miniredis.RunT(t)
+			test, err := NewAuthOnlyEndpointTest("", withDeckhouseSessionOptions(t, redis.Addr()), withRevocationFeed(t))
+			require.NoError(t, err)
+			runRevocationFeed(t, test.proxy)
+			output, errOutput := captureJSONLogs(t)
+
+			created := time.Now()
+			tt.session.Email = "jane.doe@example.com"
+			tt.session.CreatedAt = &created
+			require.NoError(t, test.SaveSession(tt.session))
+			if tt.dropFromRedis {
+				redis.FlushAll()
+			}
+
+			test.rw = httptest.NewRecorder()
+			test.req.RemoteAddr = "192.0.2.1:41000"
+			test.proxy.ServeHTTP(test.rw, test.req)
+
+			assert.Equal(t, tt.expectedCode, test.rw.Code)
+			if tt.expectedCode != http.StatusUnauthorized {
+				return
+			}
+			assert.Equal(t, "Denied", test.rw.Header().Get("X-Auth-Request-Result"))
+			require.Len(t, test.rw.Result().Cookies(), 1)
+			assert.Empty(t, test.rw.Result().Cookies()[0].Value, "the cookie of the revoked session is cleared")
+			assert.Empty(t, errOutput.String(), "a revocation is not an error")
+			assert.Contains(t, output.String(), "Session revoked (reason: ")
+			for _, secret := range []string{tt.session.IDToken, tt.session.RefreshToken, "jane.doe@example.com"} {
+				assert.NotContains(t, output.String(), secret)
+			}
+		})
+	}
+}
+
+func TestRevocationFeedOptions(t *testing.T) {
+	t.Run("disabled without a url", func(t *testing.T) {
+		test, err := NewProcessCookieTestWithDefaults()
+		require.NoError(t, err)
+		assert.Nil(t, test.proxy.revocationFeed)
+	})
+
+	t.Run("https only", func(t *testing.T) {
+		_, err := NewProcessCookieTestWithOptionsModifiers(func(opts *options.Options) {
+			opts.RevocationFeedURL = "http://revocation-feed.d8-user-authn/revocations"
+		})
+		assert.ErrorContains(t, err, "could not build the revocation feed")
+	})
+
+	t.Run("flags", func(t *testing.T) {
+		opts, err := loadConfiguration("", "", nil, []string{
+			"--revocation-feed-url=https://revocation-feed.d8-user-authn/revocations",
+			"--revocation-feed-ca-file=/opt/dex-authenticator/revocation-feed-ca/ca.crt",
+		})
+		require.NoError(t, err)
+		assert.Equal(t, "https://revocation-feed.d8-user-authn/revocations", opts.RevocationFeedURL)
+		assert.Equal(t, "/opt/dex-authenticator/revocation-feed-ca/ca.crt", opts.RevocationFeedCAFile)
+	})
+}
