+		writeEvent(w, "revocation", "e.8", fmt.Sprintf(`{"v":2,"type":"grant","k":%q,"exp":%d}`, testKey(keyGrant, "v2-grant"), exp))
+		writeEvent(w, "unknown", "e.9", `{"v":1}`)
+		writeEvent(w, "revocation", "e.10", fmt.Sprintf(`{"v":1,"type":"grant","k":%q,"exp":%d}`, testKey(keyGrant, "v1-grant"), exp))
