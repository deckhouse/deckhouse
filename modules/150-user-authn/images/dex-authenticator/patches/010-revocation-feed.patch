+// fakeFeed is an in-process feed server over TLS. handle serves the n-th connection, from 0.
+type fakeFeed struct {
+	server *httptest.Server
+	caFile string
+
+	mu      sync.Mutex
+	headers []http.Header
+}
+
+func newFakeFeed(t *testing.T, handle func(w http.ResponseWriter, r *http.Request, n int)) *fakeFeed {
+	t.Helper()
+
+	f := &fakeFeed{}
+	f.server = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		f.mu.Lock()
+		n := len(f.headers)
+		f.headers = append(f.headers, r.Header.Clone())
+		f.mu.Unlock()
+		handle(w, r, n)
+	}))
+	t.Cleanup(f.server.Close)
+
+	f.caFile = filepath.Join(t.TempDir(), "ca.crt")
+	ca := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: f.server.Certificate().Raw})
+	require.NoError(t, os.WriteFile(f.caFile, ca, 0o600))
+	return f
+}
+
+// header returns the headers of the n-th connection.
+func (f *fakeFeed) header(n int) http.Header {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+
+	return f.headers[n]
+}
+
+func (f *fakeFeed) connections() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+
+	return len(f.headers)
+}
+
+func (f *fakeFeed) subscriber(t *testing.T) *Feed {
+	t.Helper()
+
+	feed, err := New(Options{
+		URL:          f.server.URL + "/revocations",
+		CAFile:       f.caFile,
+		ClientID:     testClientID,
+		ClientSecret: vectorSecret,
+	})
+	require.NoError(t, err)
+	return feed
+}
+
+// startStream answers a subscription the way the feed does.
+func startStream(w http.ResponseWriter) {
+	w.Header().Set("Content-Type", "text/event-stream")
+	w.Header().Set("Cache-Control", "no-store")
+	w.WriteHeader(http.StatusOK)
+	fmt.Fprint(w, "retry: 5000\n\n")
+}
+
+func writeEvent(w io.Writer, name, id, data string) {
+	fmt.Fprintf(w, "event: %s\nid: %s\ndata: %s\n\n", name, id, data)
+	if flusher, ok := w.(http.Flusher); ok {
+		flusher.Flush()
+	}
+}
+
+// testKey returns the key of a value for the client of the tests.
+func testKey(t keyType, value string) string {
+	return key(salt(vectorSecret), t, value)
+}
+
+// testSession returns a session with an ID token of jane at a generation and a refresh token of a grant.
+func testSession(generation uint64, sessionID, grant string) *sessionsapi.SessionState {
+	payload := fmt.Sprintf(`{"sub":%q,"sid":%q,"d8_gen":%d}`, testSubjectJane, sessionID, generation)
+	created := time.Now()
+	return &sessionsapi.SessionState{
+		CreatedAt:    &created,
+		IDToken:      testIDToken(payload),
+		RefreshToken: testRefreshToken(grant, "secret"),
+	}
+}
+
+// captureLogs sends the logs of the test to buffers.
+func captureLogs(t *testing.T) (output, errOutput *bytes.Buffer) {
+	t.Helper()
+
+	output, errOutput = &bytes.Buffer{}, &bytes.Buffer{}
+	logger.SetOutput(output)
+	logger.SetErrOutput(errOutput)
+	t.Cleanup(func() {
+		logger.SetOutput(os.Stdout)
+		logger.SetErrOutput(os.Stderr)
+	})
+	return output, errOutput
+}
