+func TestFeedNeedsForcedRefresh(t *testing.T) {
+	feed, err := New(Options{URL: "https://revocation-feed.d8-user-authn/revocations"})
+	require.NoError(t, err)
+	now := time.Now()
+	feed.now = func() time.Time { return now }
+
+	session := func(age time.Duration, refreshToken string) *sessionsapi.SessionState {
+		created := now.Add(-age)
+		return &sessionsapi.SessionState{CreatedAt: &created, RefreshToken: refreshToken, Clock: func() time.Time { return now }}
+	}
+
+	// No snapshot yet.
+	assert.True(t, feed.NeedsForcedRefresh(session(time.Minute, "token")))
+	assert.False(t, feed.NeedsForcedRefresh(session(10*time.Second, "token")))
+	assert.False(t, feed.NeedsForcedRefresh(session(time.Minute, "")))
+
+	require.NoError(t, feed.state.applySnapshot(snapshotEvent{Part: 0, Last: true}, now))
+	assert.False(t, feed.NeedsForcedRefresh(session(time.Minute, "token")))
+
+	now = now.Add(freshFor + time.Second)
+	assert.True(t, feed.NeedsForcedRefresh(session(time.Minute, "token")))
+}
