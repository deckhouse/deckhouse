+// flow is gone (Deckhouse patch 014). A browser navigation is redirected to the
+// sign-in page with where it was going (rd, validated) and the restart mark; a
+// script gets 401 instead of a cross-origin redirect it cannot follow (see patch 005).
+func (p *OAuthProxy) restartLogin(rw http.ResponseWriter, req *http.Request, appRedirect string) {
+	if !isNavigation(req) {
+		p.errorJSON(rw, http.StatusUnauthorized)
+		return
