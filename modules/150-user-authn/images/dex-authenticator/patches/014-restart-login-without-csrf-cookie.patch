+package main
+
+import (
+	"bytes"
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	middlewareapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/middleware"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/cookies"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/logger"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/validation"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/providers"
+)
+
+// countingProvider redeems every code for a valid session of jane@example.com and counts the
+// redemptions, so a test can tell whether the callback trusted the code.
+type countingProvider struct {
+	*providers.ProviderData
+	redeemed int
+}
+
+func (p *countingProvider) Redeem(_ context.Context, _, _, _ string) (*sessionsapi.SessionState, error) {
+	p.redeemed++
+	return &sessionsapi.SessionState{Email: "jane@example.com", User: "jane", AccessToken: "access"}, nil
+}
+
+func (p *countingProvider) ValidateSession(_ context.Context, _ *sessionsapi.SessionState) bool {
+	return true
+}
+
+// newCountingProxy builds a proxy with one CSRF cookie per sign-in flow, as DexAuthenticator runs
+// it, whose provider is a countingProvider; restart is --restart-login-without-csrf-cookie.
+func newCountingProxy(t *testing.T, restart bool) (*OAuthProxy, *countingProvider) {
+	t.Helper()
+	proxy := newCallbackProxyWith(t, nil, true)
+	proxy.restartLoginWithoutCSRFCookie = restart
+	provider := &countingProvider{ProviderData: &providers.ProviderData{
+		LoginURL: &url.URL{Scheme: "https", Host: "dex.example.com", Path: "/auth"},
+	}}
+	proxy.provider = provider
+	return proxy, provider
+}
+
+// callbackWithoutCSRFCookie is the callback of a flow that was going to appRedirect, whose CSRF
+// cookie the browser does not have: it has expired, or the callback is forged. The state carries
+// the restart mark when restarted is set.
+func callbackWithoutCSRFCookie(t *testing.T, proxy *OAuthProxy, appRedirect string, headers map[string]string, restarted bool) *http.Request {
+	t.Helper()
+	csrf, err := cookies.NewCSRF(proxy.CookieOptions, "")
+	require.NoError(t, err)
+	nonce := csrf.HashOAuthState()
+	if restarted {
+		nonce = restartedStateMark + nonce
+	}
+	req := httptest.NewRequest(http.MethodGet,
+		"/oauth2/callback?code=foreign_code&state="+url.QueryEscape(encodeState(nonce, appRedirect, false)), nil)
+	req = middlewareapi.AddRequestScope(req, &middlewareapi.RequestScope{})
+	for k, v := range headers {
+		req.Header.Set(k, v)
+	}
+	return req
+}
+
+var navigationHeaders = map[string]string{"Sec-Fetch-Mode": "navigate"}
+
+// requireLoginExpiredPage checks the page of an expired sign-in: 403, no redirect, and the sign-in
+// button of the error page going back to rd.
+func requireLoginExpiredPage(t *testing.T, rw *httptest.ResponseRecorder, rd string) {
+	t.Helper()
+	assert.Equal(t, http.StatusForbidden, rw.Code, rw.Body.String())
+	assert.Empty(t, rw.Header().Get("Location"))
+	assert.Contains(t, rw.Body.String(), "Login Failed: The sign-in has expired.")
+	assert.Contains(t, rw.Body.String(), `<input type="hidden" name="rd" value="`+rd+`">`)
+}
+
+// TestCallbackWithoutCSRFCookieAsksToSignInAgain: without --restart-login-without-csrf-cookie a
+// sign-in page left open longer than the CSRF cookie lives comes back to the page of an expired
+// sign-in, whose button signs in again to where the flow was going (Deckhouse patch 014).
+func TestCallbackWithoutCSRFCookieAsksToSignInAgain(t *testing.T) {
+	t.Run("the cookie is gone", func(t *testing.T) {
+		proxy, _ := newCountingProxy(t, false)
+		rw := httptest.NewRecorder()
+
+		proxy.OAuthCallback(rw, callbackWithoutCSRFCookie(t, proxy, "/app/page", navigationHeaders, false))
+
+		requireLoginExpiredPage(t, rw, "/app/page")
+	})
+
+	t.Run("the cookie has expired", func(t *testing.T) {
+		proxy, _ := newCountingProxy(t, false)
+		req := callbackRequestOfFlow(t, proxy, "/app/page", navigationHeaders, false)
+		// The browser still sends the cookie, but it is older than --cookie-csrf-expire.
+		proxy.CookieOptions.CSRFExpire = time.Nanosecond
+		time.Sleep(time.Millisecond)
+		rw := httptest.NewRecorder()
+
+		proxy.OAuthCallback(rw, req)
+
+		requireLoginExpiredPage(t, rw, "/app/page")
+	})
+
+	t.Run("an open redirect falls back to the root", func(t *testing.T) {
+		proxy, _ := newCountingProxy(t, false)
+		rw := httptest.NewRecorder()
+
+		proxy.OAuthCallback(rw, callbackWithoutCSRFCookie(t, proxy, "https://evil.example.com/", navigationHeaders, false))
+
+		requireLoginExpiredPage(t, rw, "/")
+	})
+}
+
+// TestCallbackWithoutCSRFCookieRestartsTheLogin: with --restart-login-without-csrf-cookie (the
+// browser sessions of dex are on) the callback starts the login again instead, so a live session of
+// the provider signs the user in without a password.
+func TestCallbackWithoutCSRFCookieRestartsTheLogin(t *testing.T) {
+	t.Run("the cookie is gone", func(t *testing.T) {
+		proxy, _ := newCountingProxy(t, true)
+		rw := httptest.NewRecorder()
+
+		proxy.OAuthCallback(rw, callbackWithoutCSRFCookie(t, proxy, "/app/page", navigationHeaders, false))
+
+		assert.Equal(t, http.StatusFound, rw.Code, rw.Body.String())
+		assert.Equal(t, "/oauth2/sign_in?rd=%2Fapp%2Fpage&login_restarted=1", rw.Header().Get("Location"))
+	})
+
+	t.Run("the cookie has expired", func(t *testing.T) {
+		proxy, _ := newCountingProxy(t, true)
+		req := callbackRequestOfFlow(t, proxy, "/app/page", navigationHeaders, false)
+		proxy.CookieOptions.CSRFExpire = time.Nanosecond
+		time.Sleep(time.Millisecond)
+		rw := httptest.NewRecorder()
+
+		proxy.OAuthCallback(rw, req)
+
+		assert.Equal(t, http.StatusFound, rw.Code, rw.Body.String())
+		assert.Equal(t, "/oauth2/sign_in?rd=%2Fapp%2Fpage&login_restarted=1", rw.Header().Get("Location"))
+	})
+
+	t.Run("an open redirect falls back to the root", func(t *testing.T) {
+		proxy, _ := newCountingProxy(t, true)
+		rw := httptest.NewRecorder()
+
+		proxy.OAuthCallback(rw, callbackWithoutCSRFCookie(t, proxy, "https://evil.example.com/", navigationHeaders, false))
+
+		assert.Equal(t, http.StatusFound, rw.Code)
+		assert.Equal(t, "/oauth2/sign_in?rd=%2F&login_restarted=1", rw.Header().Get("Location"))
+	})
+
+	// The callback of a restarted flow that again finds no CSRF cookie gets the page, not one more
+	// restart, so a browser that does not keep the cookie does not go round in a loop.
+	t.Run("once in a row", func(t *testing.T) {
+		proxy, _ := newCountingProxy(t, true)
+		rw := httptest.NewRecorder()
+
+		proxy.OAuthCallback(rw, callbackWithoutCSRFCookie(t, proxy, "/app/page", navigationHeaders, true))
+
+		requireLoginExpiredPage(t, rw, "/app/page")
+	})
+}
+
+// TestCallbackWithoutCSRFCookieAnswersScripts401: a script gets 401 with no page in both modes, as
+// on the sign-in page (patch 005).
+func TestCallbackWithoutCSRFCookieAnswersScripts401(t *testing.T) {
+	for _, restart := range []bool{false, true} {
+		for _, h := range []map[string]string{
+			{"Sec-Fetch-Mode": "cors"},
+			{"X-Requested-With": "XMLHttpRequest"},
+		} {
+			proxy, _ := newCountingProxy(t, restart)
+			rw := httptest.NewRecorder()
+
+			proxy.OAuthCallback(rw, callbackWithoutCSRFCookie(t, proxy, "/app/page", h, false))
+
+			assert.Equal(t, http.StatusUnauthorized, rw.Code, "restart=%v %v", restart, h)
+			assert.Equal(t, applicationJSON, rw.Header().Get("Content-Type"))
+			assert.Equal(t, "{}", rw.Body.String())
+			assert.Empty(t, rw.Header().Get("Location"))
+		}
+	}
+}
+
+// TestForeignCodeWithoutCSRFCookieIsNeverRedeemed: a callback without its CSRF cookie never redeems
+// its code and never sets a session, whatever the mode, the kind of request and the state, so a
+// code slipped into another browser (login CSRF) does not become a session of that browser.
+func TestForeignCodeWithoutCSRFCookieIsNeverRedeemed(t *testing.T) {
+	for _, restart := range []bool{false, true} {
+		for _, headers := range []map[string]string{navigationHeaders, {"Sec-Fetch-Mode": "cors"}, {}} {
+			for _, marked := range []bool{false, true} {
+				proxy, provider := newCountingProxy(t, restart)
+				rw := httptest.NewRecorder()
+
+				proxy.OAuthCallback(rw, callbackWithoutCSRFCookie(t, proxy, "/app/page", headers, marked))
+
+				assert.Zero(t, provider.redeemed, "restart=%v headers=%v marked=%v", restart, headers, marked)
+				for _, c := range rw.Result().Cookies() {
+					assert.NotEqual(t, proxy.CookieOptions.Name, c.Name, "a session cookie was set")
+				}
+				assert.Contains(t, []int{http.StatusFound, http.StatusForbidden, http.StatusUnauthorized}, rw.Code)
+			}
+		}
+	}
+}
+
+// TestRestartStartsANewFlow: the restart starts the sign-in from scratch: the new flow has a state,
+// a CSRF cookie and a PKCE challenge of its own, and the state of the lost flow does not match it.
+func TestRestartStartsANewFlow(t *testing.T) {
+	proxy, _ := newCountingProxy(t, true)
+	proxy.provider.Data().CodeChallengeMethod = "S256"
+	lost := callbackWithoutCSRFCookie(t, proxy, "/app/page", navigationHeaders, false)
+	restart := httptest.NewRecorder()
+	proxy.OAuthCallback(restart, lost)
+	require.Equal(t, http.StatusFound, restart.Code)
+
+	start := httptest.NewRecorder()
+	startReq := httptest.NewRequest(http.MethodGet, strings.Replace(restart.Header().Get("Location"), signInPath, oauthStartPath, 1), nil)
+	proxy.OAuthStart(start, middlewareapi.AddRequestScope(startReq, &middlewareapi.RequestScope{}))
+	require.Equal(t, http.StatusFound, start.Code, start.Body.String())
+
+	loginURL, err := url.Parse(start.Header().Get("Location"))
+	require.NoError(t, err)
+	newNonce, rd, err := decodeState(loginURL.Query().Get("state"), false)
+	require.NoError(t, err)
+	lostNonce, _, err := decodeState(lost.URL.Query().Get("state"), false)
+	require.NoError(t, err)
+	assert.Equal(t, "/app/page", rd)
+	assert.NotEqual(t, lostNonce, newNonce)
+	assert.NotEmpty(t, loginURL.Query().Get("code_challenge"))
+	var csrfCookies int
+	for _, c := range start.Result().Cookies() {
+		if strings.HasSuffix(c.Name, "_csrf") && c.MaxAge >= 0 {
+			csrfCookies++
+		}
+	}
+	assert.Equal(t, 1, csrfCookies)
+}
+
+// TestCallbackWithoutCSRFCookieLogs: the page and the restart both write the auth log line that
+// the D8_DEX_AUTHENTICATOR_LOGIN_FAILED security event is built from, with the client address.
+func TestCallbackWithoutCSRFCookieLogs(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		restart    bool
+		headers    map[string]string
+		restarting bool
+	}{
+		{"page", false, navigationHeaders, false},
+		{"restart", true, navigationHeaders, true},
+		{"script", true, map[string]string{"Sec-Fetch-Mode": "cors"}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var out bytes.Buffer
+			logger.SetOutput(&out)
+			t.Cleanup(func() { logger.SetOutput(os.Stdout) })
+
+			proxy, _ := newCountingProxy(t, tc.restart)
+			req := callbackWithoutCSRFCookie(t, proxy, "/app/page", tc.headers, false)
+			req.RemoteAddr = "192.0.2.10:4711"
+			proxy.OAuthCallback(httptest.NewRecorder(), req)
+
+			assert.Contains(t, out.String(), "Invalid authentication via OAuth2: unable to obtain CSRF cookie: ")
+			assert.Contains(t, out.String(), "192.0.2.10")
+			assert.Equal(t, tc.restarting, strings.Contains(out.String(), "restarting the login"))
+		})
+	}
+}
+
+// TestRestartedFlowSignsIn: the sign-in that a restart redirects to puts the mark into the state,
+// and the callback of that flow strips it before it finds the CSRF cookie and checks the state, so
+// the restarted flow signs the user in.
+func TestRestartedFlowSignsIn(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		target   string
+		wantMark bool
+	}{
+		{"restarted", "/oauth2/start?rd=%2Fapp%2Fpage&login_restarted=1", true},
+		{"not restarted", "/oauth2/start?rd=%2Fapp%2Fpage", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			proxy, provider := newCountingProxy(t, true)
+			start := httptest.NewRecorder()
+			proxy.OAuthStart(start, middlewareapi.AddRequestScope(httptest.NewRequest(http.MethodGet, tc.target, nil), &middlewareapi.RequestScope{}))
+			require.Equal(t, http.StatusFound, start.Code, start.Body.String())
+
+			loginURL, err := url.Parse(start.Header().Get("Location"))
+			require.NoError(t, err)
+			state := loginURL.Query().Get("state")
+			assert.Equal(t, tc.wantMark, strings.HasPrefix(state, restartedStateMark), state)
+
+			callback := httptest.NewRequest(http.MethodGet, "/oauth2/callback?code=callback_code&state="+url.QueryEscape(state), nil)
+			callback = middlewareapi.AddRequestScope(callback, &middlewareapi.RequestScope{})
+			callback.Header.Set("Sec-Fetch-Mode", "navigate")
+			for _, c := range start.Result().Cookies() {
+				if strings.HasSuffix(c.Name, "_csrf") && c.MaxAge >= 0 {
+					callback.AddCookie(c)
+				}
+			}
+			rw := httptest.NewRecorder()
+
+			proxy.OAuthCallback(rw, callback)
+
+			assert.Equal(t, http.StatusFound, rw.Code, rw.Body.String())
+			assert.Equal(t, "/app/page", rw.Header().Get("Location"))
+			assert.Equal(t, 1, provider.redeemed)
+		})
+	}
+}
+
+// TestRestartLoginWithoutCSRFCookieFlag: the mode comes from --restart-login-without-csrf-cookie,
+// off by default.
+func TestRestartLoginWithoutCSRFCookieFlag(t *testing.T) {
+	for _, tc := range []struct {
+		args []string
+		want bool
+	}{
+		{nil, false},
+		{[]string{"--restart-login-without-csrf-cookie"}, true},
+		{[]string{"--restart-login-without-csrf-cookie=false"}, false},
+	} {
+		flagSet := options.NewFlagSet()
+		require.NoError(t, flagSet.Parse(tc.args))
+		opts := options.NewOptions()
+		require.NoError(t, options.Load("", flagSet, opts))
+		assert.Equal(t, tc.want, opts.RestartLoginWithoutCSRFCookie, "%v", tc.args)
+
+		testOpts := baseTestOptions()
+		testOpts.RestartLoginWithoutCSRFCookie = opts.RestartLoginWithoutCSRFCookie
+		require.NoError(t, validation.Validate(testOpts))
+		proxy, err := NewOAuthProxy(testOpts, func(string) bool { return true })
+		require.NoError(t, err)
+		assert.Equal(t, tc.want, proxy.restartLoginWithoutCSRFCookie, "%v", tc.args)
+	}
+}
