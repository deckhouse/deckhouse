@@ -0,0 +1,81 @@
+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/validation"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestAuthSubrequestLogsTheOriginalHost checks the log of the proxy behind ingress-nginx (patch
+// 016): the host of the auth subrequest is the one nginx names in X-Original-URL, and the
+// X-Forwarded-Host the browser sent with the request never gets into a log line.
+func TestAuthSubrequestLogsTheOriginalHost(t *testing.T) {
+	opts := baseTestOptions()
+	opts.ReverseProxy = true
+	require.NoError(t, validation.Validate(opts))
+	proxy, err := NewOAuthProxy(opts, func(string) bool { return true })
+	require.NoError(t, err)
+
+	tests := []struct {
+		name         string
+		path         string
+		headers      map[string]string
+		expectedHost string
+	}{
+		{
+			name: "auth subrequest with a forged X-Forwarded-Host",
+			path: opts.ProxyPrefix + "/auth",
+			headers: map[string]string{
+				"X-Original-URL":   "https://app.example.com/page",
+				"X-Forwarded-Host": "forged.example.com",
+			},
+			expectedHost: "app.example.com",
+		},
+		{
+			name: "auth subrequest without a plain host in X-Original-URL",
+			path: opts.ProxyPrefix + "/auth",
+			headers: map[string]string{
+				"X-Original-URL":   "https://app.example.com:443@forged.example.com/",
+				"X-Forwarded-Host": "forged.example.com",
+			},
+			expectedHost: "authenticator.d8-app.svc",
+		},
+		{
+			name: "sign-in page on the route of the application",
+			path: opts.ProxyPrefix + "/sign_in",
+			headers: map[string]string{
+				"X-Forwarded-Proto": "https",
+				"X-Forwarded-Host":  "app.example.com",
+				"X-Original-URL":    "https://forged.example.com/",
+			},
+			expectedHost: "app.example.com",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			output, _ := captureJSONLogs(t)
+
+			req := httptest.NewRequest(http.MethodGet, "http://authenticator.d8-app.svc"+tt.path, nil)
+			for name, value := range tt.headers {
+				req.Header.Set(name, value)
+			}
+			proxy.ServeHTTP(httptest.NewRecorder(), req)
+
+			hosts := []any{}
+			for _, line := range jsonLogLines(t, output.String()) {
+				if host, ok := line["host"]; ok {
+					hosts = append(hosts, host)
+				}
+			}
+			require.NotEmpty(t, hosts, "the request is logged")
+			for _, host := range hosts {
+				assert.Equal(t, tt.expectedHost, host)
+			}
+		})
+	}
+}
