+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	middlewareapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/middleware"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/validation"
+)
+
+// TestErrorPageTakesTheLanguageOfTheRequest: the error pages of the proxy are rendered in the
+// language the browser asks for (Deckhouse patch 015).
+func TestErrorPageTakesTheLanguageOfTheRequest(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "error.html"), []byte(`{{define "error.html"}}{{.Lang}}{{end}}`), 0o600))
+	opts := baseTestOptions()
+	opts.Templates.Path = dir
+	require.NoError(t, validation.Validate(opts))
+	proxy, err := NewOAuthProxy(opts, func(string) bool { return true })
+	require.NoError(t, err)
+
+	for header, want := range map[string]string{"ru-RU,ru;q=0.9,en;q=0.8": "ru", "en-US": "en", "": "en"} {
+		t.Run(header, func(t *testing.T) {
+			req := httptest.NewRequest(http.MethodGet, "/oauth2/callback", nil)
+			req.Header.Set("Accept-Language", header)
+			req = middlewareapi.AddRequestScope(req, &middlewareapi.RequestScope{})
+			rw := httptest.NewRecorder()
+
+			proxy.ErrorPage(rw, req, http.StatusForbidden, "test")
+
+			assert.Equal(t, want, rw.Body.String())
+		})
+	}
+}
