diff --git a/pkg/app/pagewriter/deckhouse_language.go b/pkg/app/pagewriter/deckhouse_language.go
new file mode 100644
index 00000000..9aa1b175
--- /dev/null
+++ b/pkg/app/pagewriter/deckhouse_language.go
@@ -0,0 +1,73 @@
+package pagewriter
+
+import (
+	"strconv"
+	"strings"
+)
+
+// The languages of the Deckhouse templates of the pages (Deckhouse patch 015).
+const (
+	languageEnglish = "en"
+	languageRussian = "ru"
+)
+
+// maxAcceptLanguageEntries bounds the work spent on one Accept-Language header.
+const maxAcceptLanguageEntries = 32
+
+// PreferredLanguage returns the language of the pages for an Accept-Language
+// header (RFC 9110, section 12.5.4): "ru" when Russian has the highest weight of
+// the languages the templates have, "en" otherwise. A language range matches by
+// its primary subtag, so "ru-RU" is Russian; "*" stands for English, and a range
+// with q=0 or a weight that does not parse is skipped. Of equal weights the first
+// wins, as browsers list the languages in the order of preference.
+func PreferredLanguage(acceptLanguage string) string {
+	best, bestWeight := languageEnglish, 0.0
+	for i, entry := range strings.Split(acceptLanguage, ",") {
+		if i == maxAcceptLanguageEntries {
+			break
+		}
+		tag, params, _ := strings.Cut(entry, ";")
+		primary, _, _ := strings.Cut(strings.TrimSpace(tag), "-")
+		var lang string
+		switch strings.ToLower(primary) {
+		case languageRussian:
+			lang = languageRussian
+		case languageEnglish, "*":
+			lang = languageEnglish
+		default:
+			continue
+		}
+		weight, ok := languageWeight(params)
+		if !ok || weight <= bestWeight {
+			continue
+		}
+		best, bestWeight = lang, weight
+	}
+	return best
+}
+
+// languageWeight parses the q parameter of a language range; without one the
+// weight is 1.
+func languageWeight(params string) (float64, bool) {
+	for _, param := range strings.Split(params, ";") {
+		name, value, found := strings.Cut(strings.TrimSpace(param), "=")
+		if !found || !strings.EqualFold(strings.TrimSpace(name), "q") {
+			continue
+		}
+		weight, err := strconv.ParseFloat(strings.TrimSpace(value), 64)
+		// The negated range check also refuses NaN.
+		if err != nil || !(weight >= 0 && weight <= 1) {
+			return 0, false
+		}
+		return weight, true
+	}
+	return 1, true
+}
+
+// languageOrDefault is lang, or English when it is not set.
+func languageOrDefault(lang string) string {
+	if lang == "" {
+		return languageEnglish
+	}
+	return lang
+}
diff --git a/pkg/app/pagewriter/deckhouse_pages_test.go b/pkg/app/pagewriter/deckhouse_pages_test.go
new file mode 100644
index 00000000..cfaac6f8
