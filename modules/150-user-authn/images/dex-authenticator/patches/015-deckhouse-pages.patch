+++ b/pkg/app/pagewriter/deckhouse_pages_test.go
@@ -0,0 +1,121 @@
+package pagewriter
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	middlewareapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/middleware"
+)
+
+func TestPreferredLanguage(t *testing.T) {
+	tests := []struct {
+		name   string
+		header string
+		want   string
+	}{
+		{"no header", "", "en"},
+		{"Russian", "ru", "ru"},
+		{"Russian with a region", "ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7", "ru"},
+		{"English first", "en-US,en;q=0.9,ru;q=0.8", "en"},
+		{"Russian weighs more", "en;q=0.5, ru;q=0.8", "ru"},
+		{"equal weights keep the order", "en, ru", "en"},
+		{"the primary subtag is case-insensitive", "RU-ru", "ru"},
+		{"an unsupported language is skipped", "de-DE,de;q=0.9,ru;q=0.5", "ru"},
+		{"only unsupported languages", "de, fr;q=0.9", "en"},
+		{"a wildcard is English", "*;q=0.9, ru;q=0.5", "en"},
+		{"q=0 refuses a language", "ru;q=0, en;q=0.1", "en"},
+		{"a weight that does not parse is skipped", "ru;q=high, en;q=0.1", "en"},
+		{"NaN is skipped", "ru;q=NaN", "en"},
+		{"a weight above 1 is skipped", "ru;q=2", "en"},
+		{"spaces around the parameter", "en;q=0.1 , ru ; q = 0.9", "ru"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, PreferredLanguage(tc.header))
+		})
+	}
+}
+
+// TestPreferredLanguageBoundsTheHeader: entries past the limit are not read.
+func TestPreferredLanguageBoundsTheHeader(t *testing.T) {
+	header := ""
+	for range maxAcceptLanguageEntries {
+		header += "de,"
+	}
+	assert.Equal(t, "en", PreferredLanguage(header+"ru"))
+}
+
+// newDeckhousePagesWriter is a writer whose templates show the data the Deckhouse templates use.
+func newDeckhousePagesWriter(t *testing.T, customLogo string) Writer {
+	t.Helper()
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "error.html"),
+		[]byte(`{{define "error.html"}}{{.Lang}}|{{.LogoData}}|{{if HasPrefix .Message "Login Failed"}}login{{else}}other{{end}}{{end}}`), 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "sign_in.html"),
+		[]byte(`{{define "sign_in.html"}}{{.Lang}}|{{.LogoData}}{{end}}`), 0o600))
+	logo := filepath.Join(dir, "logo.svg")
+	require.NoError(t, os.WriteFile(logo, []byte(`<svg id="logo"></svg>`), 0o600))
+	if customLogo == "" {
+		customLogo = logo
+	}
+	writer, err := NewWriter(Opts{TemplatesPath: dir, ProxyPrefix: "/oauth2", CustomLogo: customLogo})
+	require.NoError(t, err)
+	return writer
+}
+
+// TestErrorPageCarriesLanguageAndLogo: the error page gets the language of the request and the
+// logo of the sign-in page (Deckhouse patch 015).
+func TestErrorPageCarriesLanguageAndLogo(t *testing.T) {
+	tests := []struct {
+		name       string
+		lang       string
+		customLogo string
+		messages   []interface{}
+		want       string
+	}{
+		{"Russian", "ru", "", []interface{}{"Login Failed: Unable to find a valid CSRF token. Please try again."}, `ru|<svg id="logo"></svg>|login`},
+		{"no language is English", "", "", nil, `en|<svg id="logo"></svg>|other`},
+		{"the logo is disabled", "en", "-", nil, `en||other`},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			rw := httptest.NewRecorder()
+			newDeckhousePagesWriter(t, tc.customLogo).WriteErrorPage(rw, ErrorPageOpts{
+				Status:   http.StatusForbidden,
+				Lang:     tc.lang,
+				Messages: tc.messages,
+			})
+			assert.Equal(t, tc.want, rw.Body.String())
+		})
+	}
+}
+
+// TestProxyErrorPageLanguage: the error page of an upstream failure takes the language of the
+// request too.
+func TestProxyErrorPageLanguage(t *testing.T) {
+	req := httptest.NewRequest(http.MethodGet, "/", nil)
+	req.Header.Set("Accept-Language", "ru-RU")
+	req = middlewareapi.AddRequestScope(req, &middlewareapi.RequestScope{})
+	rw := httptest.NewRecorder()
+
+	newDeckhousePagesWriter(t, "-").ProxyErrorHandler(rw, req, assert.AnError)
+
+	assert.Equal(t, "ru||other", rw.Body.String())
+}
+
+// TestSignInPageLanguage: the sign-in page gets the language of the request.
+func TestSignInPageLanguage(t *testing.T) {
+	req := httptest.NewRequest(http.MethodGet, "/oauth2/sign_in", nil)
+	req.Header.Set("Accept-Language", "ru")
+	rw := httptest.NewRecorder()
+
+	newDeckhousePagesWriter(t, "").WriteSignInPage(rw, req, "/", http.StatusOK)
+
+	assert.Equal(t, `ru|<svg id="logo"></svg>`, rw.Body.String())
+}
