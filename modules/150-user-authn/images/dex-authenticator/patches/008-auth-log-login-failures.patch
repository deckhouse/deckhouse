diff --git a/pkg/middleware/refresh_failure_log.go b/pkg/middleware/refresh_failure_log.go
new file mode 100644
index 00000000..811d0414
--- /dev/null
+++ b/pkg/middleware/refresh_failure_log.go
@@ -0,0 +1,64 @@
+package middleware
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"strconv"
+	"sync"
+	"time"
+
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+)
+
+// refreshFailureLogMaxEntries bounds the memory of refreshFailureLog. When
+// the map is full after the expired entries are dropped, it starts over: a
+// session then gets one more line, which is cheaper than unbounded growth.
+const refreshFailureLogMaxEntries = 10000
+
+// refreshFailureLog throttles the auth log line of a failed session refresh.
+// A failed preemptive refresh keeps the session without saving it, so every
+// following request of that session retries the refresh until the ID token
+// expires. Without the throttle each of those requests, static files and XHR
+// included, would write one more auth line and produce one more security event.
+type refreshFailureLog struct {
+	mu   sync.Mutex
+	seen map[string]time.Time
+}
+
+var refreshFailures = &refreshFailureLog{seen: map[string]time.Time{}}
+
+// shouldLog reports whether a failed refresh of the session is to be written
+// to the auth log at now: once per session per period. A session is keyed by
+// its user, its creation time and a hash of its refresh token, so a session
+// that refreshed successfully in between counts as a new one, and the sessions
+// restored from a cookie without the session store (Deckhouse patch 002, all
+// with the same placeholder user and creation time) are told apart.
+func (l *refreshFailureLog) shouldLog(session *sessionsapi.SessionState, period time.Duration, now time.Time) bool {
+	key := session.Email + "|" + session.User + "|"
+	if session.CreatedAt != nil {
+		key += strconv.FormatInt(session.CreatedAt.UnixNano(), 10)
+	}
+	if session.RefreshToken != "" {
+		sum := sha256.Sum256([]byte(session.RefreshToken))
+		key += "|" + hex.EncodeToString(sum[:8])
+	}
+
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	if last, ok := l.seen[key]; ok && now.Sub(last) < period {
+		return false
+	}
+	if len(l.seen) >= refreshFailureLogMaxEntries {
+		for k, t := range l.seen {
+			if now.Sub(t) >= period {
+				delete(l.seen, k)
+			}
+		}
+		if len(l.seen) >= refreshFailureLogMaxEntries {
+			l.seen = map[string]time.Time{}
+		}
+	}
+	l.seen[key] = now
+	return true
+}
diff --git a/pkg/middleware/refresh_failure_log_test.go b/pkg/middleware/refresh_failure_log_test.go
new file mode 100644
index 00000000..6685a46c
--- /dev/null
+++ b/pkg/middleware/refresh_failure_log_test.go
@@ -0,0 +1,71 @@
+package middleware
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+)
+
+func TestRefreshFailureLogOncePerPeriod(t *testing.T) {
+	l := &refreshFailureLog{seen: map[string]time.Time{}}
+	created := time.Unix(1000, 0)
+	s := &sessionsapi.SessionState{Email: "jane@example.com", User: "jane", CreatedAt: &created}
+	now := time.Unix(2000, 0)
+	period := 5 * time.Minute
+
+	if !l.shouldLog(s, period, now) {
+		t.Fatal("the first failure of a session must be logged")
+	}
+	if l.shouldLog(s, period, now.Add(time.Second)) {
+		t.Fatal("a repeated failure within the period must not be logged")
+	}
+	if !l.shouldLog(s, period, now.Add(period)) {
+		t.Fatal("a failure after the period must be logged again")
+	}
+
+	refreshed := created.Add(time.Hour)
+	other := &sessionsapi.SessionState{Email: "jane@example.com", User: "jane", CreatedAt: &refreshed}
+	if !l.shouldLog(other, period, now.Add(period+time.Second)) {
+		t.Fatal("a session refreshed in between is a new session")
+	}
+}
+
+func TestRefreshFailureLogBounded(t *testing.T) {
+	l := &refreshFailureLog{seen: map[string]time.Time{}}
+	now := time.Unix(2000, 0)
+	for i := 0; i < refreshFailureLogMaxEntries+10; i++ {
+		created := time.Unix(int64(i), 0)
+		l.shouldLog(&sessionsapi.SessionState{Email: "u", CreatedAt: &created}, time.Hour, now)
+	}
+	if len(l.seen) > refreshFailureLogMaxEntries {
+		t.Fatalf("the map holds %d entries, more than %d", len(l.seen), refreshFailureLogMaxEntries)
+	}
+}
+
+// The sessions restored from a cookie without the session store (Deckhouse
+// patch 002) share the placeholder user and creation time; their refresh
+// tokens tell them apart, so each gets its own auth log line.
+func TestRefreshFailureLogKeepsRestoredSessionsApart(t *testing.T) {
+	l := &refreshFailureLog{seen: map[string]time.Time{}}
+	created := time.Date(1992, time.September, 30, 0, 0, 0, 0, time.UTC)
+	stub := func(refreshToken string) *sessionsapi.SessionState {
+		return &sessionsapi.SessionState{User: "Does not found in Redis", CreatedAt: &created, RefreshToken: refreshToken}
+	}
+	now := time.Unix(2000, 0)
+	if !l.shouldLog(stub("first-refresh-token"), time.Hour, now) {
+		t.Fatal("the failure of the first restored session must be logged")
+	}
+	if !l.shouldLog(stub("second-refresh-token"), time.Hour, now) {
+		t.Fatal("the failure of another restored session must be logged too")
+	}
+	if l.shouldLog(stub("first-refresh-token"), time.Hour, now.Add(time.Minute)) {
+		t.Fatal("a repeated failure of the same session within the period must not be logged")
+	}
+	for k := range l.seen {
+		if strings.Contains(k, "refresh-token") {
+			t.Fatalf("the key %q holds the refresh token itself", k)
+		}
+	}
+}
