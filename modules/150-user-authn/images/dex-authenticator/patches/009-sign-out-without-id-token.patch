+// replaceIDTokenPlaceholder puts the ID token of the session into the sign-out redirect. Without a
+// session or without an ID token in it the placeholder must not reach the provider: dex answers 400
+// to a raw "{id_token}" in id_token_hint, and to post_logout_redirect_uri without a hint. A user signs
+// out without a session after a global logout ended it, so the redirect then goes straight to the
+// post_logout_redirect_uri of the target when it is an allowed redirect, and to / otherwise.
+func (p *OAuthProxy) replaceIDTokenPlaceholder(rw http.ResponseWriter, req *http.Request, redirect string) string {
+	session, err := p.getAuthenticatedSession(rw, req)
+	if err == nil && session != nil && session.IDToken != "" {
+		return strings.ReplaceAll(redirect, idTokenPlaceholder, session.IDToken)
+	}
+
+	fallback := "/"
+	if target, parseErr := url.Parse(redirect); parseErr == nil {
+		postLogout := target.Query().Get("post_logout_redirect_uri")
+		if postLogout != "" && p.redirectValidator.IsValidRedirect(postLogout) {
+			fallback = postLogout
+		}
+	}
+	logger.Printf("No ID token for the sign-out redirect, redirecting to %q instead of the provider", fallback)
+
+	return fallback
+}
