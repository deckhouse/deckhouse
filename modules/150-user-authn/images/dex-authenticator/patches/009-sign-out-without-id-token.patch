+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestSignOutWithoutIDToken checks the sign-out redirect to the logout of the provider when there is
+// no ID token to put into it: the raw placeholder must never reach dex, which answers 400 to it.
+func TestSignOutWithoutIDToken(t *testing.T) {
+	const (
+		dexLogout = "https://dex.example.com/logout?id_token_hint={id_token}&post_logout_redirect_uri="
+		appURL    = "https://app.example.com/"
+	)
+
+	tests := []struct {
+		name             string
+		session          *sessions.SessionState
+		target           string
+		byHeader         bool
+		expectedLocation string
+	}{
+		{
+			name:             "session with an id token",
+			session:          &sessions.SessionState{Email: "jane.doe@example.com", IDToken: "header.payload.signature"},
+			target:           dexLogout + url.QueryEscape(appURL),
+			expectedLocation: "https://dex.example.com/logout?id_token_hint=header.payload.signature&post_logout_redirect_uri=" + url.QueryEscape(appURL),
+		},
+		{
+			name:             "session with an id token, target in the header",
+			session:          &sessions.SessionState{Email: "jane.doe@example.com", IDToken: "header.payload.signature"},
+			target:           dexLogout + url.QueryEscape(appURL),
+			byHeader:         true,
+			expectedLocation: "https://dex.example.com/logout?id_token_hint=header.payload.signature&post_logout_redirect_uri=" + url.QueryEscape(appURL),
+		},
+		{
+			name:             "no session",
+			target:           dexLogout + url.QueryEscape(appURL),
+			expectedLocation: appURL,
+		},
+		{
+			name:             "no session, target in the header",
+			target:           dexLogout + url.QueryEscape(appURL),
+			byHeader:         true,
+			expectedLocation: appURL,
+		},
+		{
+			name:             "session without an id token",
+			session:          &sessions.SessionState{Email: "jane.doe@example.com", AccessToken: "access_token"},
+			target:           dexLogout + url.QueryEscape(appURL),
+			expectedLocation: appURL,
+		},
+		{
+			name:             "no session, post logout address not allowed",
+			target:           dexLogout + url.QueryEscape("https://evil.example.org/"),
+			expectedLocation: "/",
+		},
+		{
+			name:             "no session, no post logout address",
+			target:           "https://dex.example.com/logout?id_token_hint={id_token}",
+			expectedLocation: "/",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			test, err := NewProcessCookieTestWithOptionsModifiers(func(opts *options.Options) {
+				opts.WhitelistDomains = []string{"dex.example.com", "app.example.com"}
+			})
+			require.NoError(t, err)
+			if tt.byHeader {
+				test.req = httptest.NewRequest(http.MethodGet, "/oauth2/sign_out", nil)
+				test.req.Header.Set("X-Auth-Request-Redirect", tt.target)
+			} else {
+				test.req = httptest.NewRequest(http.MethodGet, "/oauth2/sign_out?rd="+url.QueryEscape(tt.target), nil)
+			}
+			if tt.session != nil {
+				created := time.Now()
+				tt.session.CreatedAt = &created
+				require.NoError(t, test.SaveSession(tt.session))
+			}
+			_, errOutput := captureJSONLogs(t)
+
+			test.rw = httptest.NewRecorder()
+			test.proxy.ServeHTTP(test.rw, test.req)
+
+			assert.Equal(t, http.StatusFound, test.rw.Code)
+			assert.Equal(t, tt.expectedLocation, test.rw.Header().Get("Location"))
+			assert.NotContains(t, test.rw.Header().Get("Location"), idTokenPlaceholder)
+			assert.NotContains(t, test.rw.Header().Get("Location"), url.QueryEscape(idTokenPlaceholder))
+			assert.Empty(t, errOutput.String(), "a sign-out without a session is not an error")
+		})
+	}
+}
