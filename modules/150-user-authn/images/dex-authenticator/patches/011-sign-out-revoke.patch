+// TestSignOutRevocationTrustsTheProviderCA checks that the revocation goes over the TLS of the
+// provider: --provider-ca-file is trusted, the system roots are not.
+func TestSignOutRevocationTrustsTheProviderCA(t *testing.T) {
+	transport := requests.DefaultTransport.(*http.Transport)
+	tlsConfig := transport.TLSClientConfig
+	t.Cleanup(func() { transport.TLSClientConfig = tlsConfig })
+
+	endpoint := &revokeEndpoint{}
+	server := httptest.NewTLSServer(endpoint.handler(answerOK))
+	t.Cleanup(server.Close)
+	caFile := filepath.Join(t.TempDir(), "ca.crt")
+	require.NoError(t, os.WriteFile(caFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}), 0o600))
+
+	t.Run("provider ca", func(t *testing.T) {
+		rw := signOut(t,
+			&sessions.SessionState{Email: "jane.doe@example.com", RefreshToken: signOutRefresh},
+			"",
+			withRevocationURL(server.URL+"/token/revoke"),
+			func(opts *options.Options) { opts.Providers[0].CAFiles = []string{caFile} },
+		)
+
+		assertSignedOut(t, rw)
+		assert.Equal(t, 1, endpoint.calls())
+	})
+
+	t.Run("another ca", func(t *testing.T) {
+		transport.TLSClientConfig = tlsConfig
+		transport.CloseIdleConnections()
+		output, _ := captureLogs(t)
+
+		rw := signOut(t,
+			&sessions.SessionState{Email: "jane.doe@example.com", RefreshToken: signOutRefresh},
+			"",
+			withRevocationURL(server.URL+"/token/revoke"),
+		)
+
+		assertSignedOut(t, rw)
+		assert.Equal(t, 1, endpoint.calls(), "the server never gets the token")
+		assert.Contains(t, output.String(), "certificate signed by unknown authority")
+	})
+}
+
+// TestSignOutWithoutTheSessionOfTheLoader checks a sign-out the stored session loader gave no
+// session, as when a late refresh of the session holds its lock (patch 002): the sign-out loads the
+// session from the store and revokes the refresh token of the cookie, so the grant ends whatever
+// the late refresh does with its answer. A store that has lost the session gives the stub of the
+// cookie, which carries the same token.
+func TestSignOutWithoutTheSessionOfTheLoader(t *testing.T) {
+	for _, isLost := range []bool{false, true} {
+		name := "session in the store"
+		if isLost {
+			name = "session the store has lost"
+		}
+		t.Run(name, func(t *testing.T) {
+			dex := newFakeDex(t)
+			replica := newDeckhouseReplica(t, dex, time.Hour)
+			replica.provider.Data().ClientID = clientID
+			replica.provider.Data().ClientSecret = clientSecret
+			provider := &strictRevocation{valid: map[string]bool{"refresh-token-1": true}}
+			server := httptest.NewServer(http.HandlerFunc(provider.handler))
+			t.Cleanup(server.Close)
+			replica.revocationURL = server.URL + "/token/revoke"
+
+			// The sign-in issues refresh-token-1, which the cookie carries.
+			cookie := signInThroughDex(t, replica)
+			req := httptest.NewRequest(http.MethodGet, "/oauth2/sign_out", nil)
+			req.AddCookie(cookie)
+			if isLost {
+				require.NoError(t, replica.sessionStore.Clear(httptest.NewRecorder(), req))
+				req = httptest.NewRequest(http.MethodGet, "/oauth2/sign_out", nil)
+				req.AddCookie(cookie)
+			}
+			req = middlewareapi.AddRequestScope(req, &middlewareapi.RequestScope{SessionUnavailable: true})
+
+			replica.revokeRefreshToken(req)
+
+			valid, revoked := provider.state()
+			assert.Equal(t, []string{"refresh-token-1"}, revoked)
+			assert.Empty(t, valid, "the grant ends at the provider")
+		})
+	}
+}
+
+// TestSignOutWithoutACookieRevokesNothing checks that a sign-out without a session and without a
+// cookie to load one from makes no revocation.
+func TestSignOutWithoutACookieRevokesNothing(t *testing.T) {
+	endpoint := &revokeEndpoint{}
+	server := httptest.NewServer(endpoint.handler(answerOK))
+	t.Cleanup(server.Close)
+
+	dex := newFakeDex(t)
+	replica := newDeckhouseReplica(t, dex, time.Hour)
+	replica.revocationURL = server.URL + "/token/revoke"
+	req := middlewareapi.AddRequestScope(httptest.NewRequest(http.MethodGet, "/oauth2/sign_out", nil), &middlewareapi.RequestScope{})
+
+	replica.revokeRefreshToken(req)
+
+	assert.Zero(t, endpoint.calls())
+}
+
+// strictRevocation is the refresh tokens of a provider that refuses a replaced refresh token: each
+// grant has one valid token, and revoking it ends the grant. Its handler is the token revocation
+// endpoint.
+type strictRevocation struct {
+	mu      sync.Mutex
+	valid   map[string]bool
+	revoked []string
+}
+
+func (s *strictRevocation) handler(w http.ResponseWriter, r *http.Request) {
+	if err := r.ParseForm(); err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	s.mu.Lock()
+	token := r.PostForm.Get("token")
+	s.revoked = append(s.revoked, token)
+	delete(s.valid, token)
+	s.mu.Unlock()
+	answerOK(w, r)
+}
+
+func (s *strictRevocation) state() (valid, revoked []string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return slices.Sorted(maps.Keys(s.valid)), slices.Clone(s.revoked)
+}
+
+// TestSignOutRevokesTheStoredToken checks the sign-out of a browser whose cookie is one refresh
+// behind the session in the store (patch 002): it missed the answer of that refresh, or a copy of
+// the cookie made the refresh and holds the new token. Past the lifetime of the record of the
+// replaced token the session goes on with the token of the cookie, which the refresh replaced, and
+// the sign-out revokes the stored token as well, so the grant that goes on with it ends. Within the
+// lifetime the session has the stored token, and the sign-out revokes it once.
+func TestSignOutRevokesTheStoredToken(t *testing.T) {
+	tests := []struct {
+		name            string
+		refreshedAgo    time.Duration
+		storedToken     string
+		expectedRevoked []string
+	}{
+		{
+			name:            "cookie behind the store, past the lifetime of the record",
+			refreshedAgo:    3 * time.Minute,
+			storedToken:     "refresh-token-2",
+			expectedRevoked: []string{"refresh-token-1", "refresh-token-2"},
+		},
+		{
+			name:            "cookie behind the store, within the lifetime of the record",
+			refreshedAgo:    time.Minute,
+			storedToken:     "refresh-token-2",
+			expectedRevoked: []string{"refresh-token-2"},
+		},
+		{
+			name:            "cookie with the token of the store",
+			refreshedAgo:    3 * time.Minute,
+			storedToken:     "refresh-token-1",
+			expectedRevoked: []string{"refresh-token-1"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			dex := newFakeDex(t)
+			// No refresh during the test: the tokens are what the test puts into the store.
+			replica := newDeckhouseReplica(t, dex, time.Hour)
+			replica.provider.Data().ClientID = clientID
+			replica.provider.Data().ClientSecret = clientSecret
+			provider := &strictRevocation{valid: map[string]bool{tt.storedToken: true}}
+			server := httptest.NewServer(http.HandlerFunc(provider.handler))
+			t.Cleanup(server.Close)
+			replica.revocationURL = server.URL + "/token/revoke"
+
+			// The sign-in issues refresh-token-1, which the browser keeps.
+			cookie := signInThroughDex(t, replica)
+
+			// A refresh made through the same ticket leaves the store with the session of
+			// storedToken, a refresh that replaced refresh-token-1 refreshedAgo, and writes the
+			// cookie of a copy.
+			req := httptest.NewRequest(http.MethodGet, "/", nil)
+			req.AddCookie(cookie)
+			stored, err := replica.sessionStore.Load(req)
+			require.NoError(t, err)
+			refreshedAt := time.Now().Add(-tt.refreshedAgo)
+			replaced := sha256.Sum256([]byte("refresh-token-1"))
+			stored.CreatedAt = &refreshedAt
+			stored.RefreshToken = tt.storedToken
+			stored.ReplacedRefreshTokenHash = replaced[:]
+			stored.ReplacedRefreshTokenAt = &refreshedAt
+			require.NoError(t, replica.sessionStore.Save(httptest.NewRecorder(), req, stored))
+
+			rw := serveWithCookie(replica, "/oauth2/sign_out", cookie)
+
+			// Within the lifetime the loader writes the cookie of the stored session again
+			// before the sign-out clears it; the browser keeps the last one.
+			assert.Equal(t, http.StatusFound, rw.Code)
+			set := rw.Result().Cookies()
+			require.NotEmpty(t, set)
+			assert.Empty(t, set[len(set)-1].Value, "the session cookie is cleared")
+			valid, revoked := provider.state()
+			assert.Equal(t, tt.expectedRevoked, revoked)
+			assert.Empty(t, valid, "the grant ends at the provider")
+		})
+	}
+}
