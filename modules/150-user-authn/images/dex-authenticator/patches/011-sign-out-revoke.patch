+// revocationTimeout bounds the call to the token revocation endpoint on sign-out.
+const revocationTimeout = 3 * time.Second
+
+// revokeRefreshToken revokes the refresh token of the session, and the one in the store when the cookie
+// carries another, at the token revocation endpoint of the provider (RFC 7009, --revocation-url) before
+// the session is cleared: a copy of the session cookie carries the refresh token and would restore the
+// session with it. A failure is logged as a warning and the sign-out goes on, the session is cleared
+// anyway.
+//
+// A sign-out the stored session loader gave no session, as when a late refresh of the session holds
+// its lock (patch 002), loads it from the store without the lock: the session of the store, or the
+// stub of the cookie, carries the refresh token of the cookie. The late refresh revokes nothing, so
+// the sign-out ends the grant here, whatever that refresh does with its answer.
+func (p *OAuthProxy) revokeRefreshToken(req *http.Request) {
+	if p.revocationURL == "" {
+		return
+	}
+	scope := middlewareapi.GetRequestScope(req)
+	if scope == nil {
+		return
+	}
+	session := scope.Session
+	if session == nil {
+		loaded, err := p.sessionStore.Load(req)
+		if err != nil || loaded == nil {
+			return
+		}
+		session = loaded
+	}
+
+	// The revocation outlives a browser that goes away after the sign-out request.
+	ctx := context.WithoutCancel(req.Context())
+	if session.RefreshToken != "" {
+		revokeToken(ctx, p.revocationURL, p.provider.Data(), session.RefreshToken)
+	}
+	// A cookie that came back long after a refresh it missed keeps the token that refresh replaced,
+	// and the grant goes on with the token in the store (patch 002), which a copy of the cookie may
+	// carry: the sign-out ends that grant too.
+	if session.StoredRefreshToken != "" && session.StoredRefreshToken != session.RefreshToken {
+		revokeToken(ctx, p.revocationURL, p.provider.Data(), session.StoredRefreshToken)
+	}
+}
+
+// revokeToken revokes a refresh token at the token revocation endpoint of the provider. A failure is
+// logged as a warning.
+func revokeToken(ctx context.Context, revocationURL string, providerData *providers.ProviderData, refreshToken string) {
+	clientSecret, err := providerData.GetClientSecret()
+	if err != nil {
+		logger.Printf("WARNING: Could not revoke the refresh token of the session: %v", err)
+		return
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, revocationTimeout)
+	defer cancel()
+
+	// The client credentials are URL-encoded as for the token endpoint (RFC 6749, section 2.3.1).
+	credentials := url.QueryEscape(providerData.ClientID) + ":" + url.QueryEscape(clientSecret)
+	form := url.Values{
+		"token":           {refreshToken},
+		"token_type_hint": {"refresh_token"},
+	}
+	result := requests.New(revocationURL).
+		WithContext(ctx).
+		WithMethod(http.MethodPost).
+		WithBody(strings.NewReader(form.Encode())).
+		SetHeader("Content-Type", "application/x-www-form-urlencoded").
+		SetHeader("Authorization", "Basic "+base64.StdEncoding.EncodeToString([]byte(credentials))).
+		Do()
+	if err := result.Error(); err != nil {
+		logger.Printf("WARNING: Could not revoke the refresh token of the session: %v", err)
+		return
+	}
+	if result.StatusCode() != http.StatusOK {
+		// The OAuth 2.0 error code of the answer, if it has one; its description may quote the request.
+		var oauthError struct {
+			Error string `json:"error"`
+		}
+		code := ""
+		if json.Unmarshal(result.Body(), &oauthError) == nil {
+			code = oauthError.Error
+		}
+		logger.Printf("WARNING: Could not revoke the refresh token of the session: the provider answered %d %q", result.StatusCode(), code)
+	}
+}
