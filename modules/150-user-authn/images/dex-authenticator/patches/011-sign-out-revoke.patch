+// revocationTimeout bounds the call to the token revocation endpoint on sign-out.
+const revocationTimeout = 3 * time.Second
+
+// revokeRefreshToken revokes the refresh token of the session at the token revocation endpoint of the
+// provider (RFC 7009, --revocation-url) before the session is cleared: a copy of the session cookie
+// carries the refresh token and would restore the session with it. A failure is logged as a warning and
+// the sign-out goes on, the session is cleared anyway.
+func (p *OAuthProxy) revokeRefreshToken(req *http.Request) {
+	if p.revocationURL == "" {
+		return
+	}
+	scope := middlewareapi.GetRequestScope(req)
+	if scope == nil || scope.Session == nil || scope.Session.RefreshToken == "" {
+		return
+	}
+
+	providerData := p.provider.Data()
+	clientSecret, err := providerData.GetClientSecret()
+	if err != nil {
+		logger.Printf("WARNING: Could not revoke the refresh token of the session: %v", err)
+		return
+	}
+
+	// The revocation outlives a browser that goes away after the sign-out request.
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(req.Context()), revocationTimeout)
+	defer cancel()
+
+	// The client credentials are URL-encoded as for the token endpoint (RFC 6749, section 2.3.1).
+	credentials := url.QueryEscape(providerData.ClientID) + ":" + url.QueryEscape(clientSecret)
+	form := url.Values{
+		"token":           {scope.Session.RefreshToken},
+		"token_type_hint": {"refresh_token"},
+	}
+	result := requests.New(p.revocationURL).
+		WithContext(ctx).
+		WithMethod(http.MethodPost).
+		WithBody(strings.NewReader(form.Encode())).
+		SetHeader("Content-Type", "application/x-www-form-urlencoded").
+		SetHeader("Authorization", "Basic "+base64.StdEncoding.EncodeToString([]byte(credentials))).
+		Do()
+	if err := result.Error(); err != nil {
+		logger.Printf("WARNING: Could not revoke the refresh token of the session: %v", err)
+		return
+	}
+	if result.StatusCode() != http.StatusOK {
+		// The OAuth 2.0 error code of the answer, if it has one; its description may quote the request.
+		var oauthError struct {
+			Error string `json:"error"`
+		}
+		code := ""
+		if json.Unmarshal(result.Body(), &oauthError) == nil {
+			code = oauthError.Error
+		}
+		logger.Printf("WARNING: Could not revoke the refresh token of the session: the provider answered %d %q", result.StatusCode(), code)
+	}
+}
