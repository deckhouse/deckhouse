+// isNavigation reports whether the browser navigates to the URL: the user followed a link,
+// submitted a form or was redirected there. Fetch Metadata says it directly. Without it (an older
+// browser or a client that is not a browser) only the AJAX markers of the request rule a navigation
+// out.
+func isNavigation(req *http.Request) bool {
+	switch req.Header.Get("Sec-Fetch-Mode") {
+	case "navigate", "nested-navigate":
+		return true
+	case "":
+		return !isAjax(req) && req.Header.Get("X-Requested-With") != "XMLHttpRequest"
+	default:
+		return false
+	}
+}
