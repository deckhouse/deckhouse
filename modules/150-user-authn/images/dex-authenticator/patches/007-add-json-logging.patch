+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/cookies"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/logger"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/validation"
+	"github.com/onsi/ginkgo/v2"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// captureJSONLogs switches the global logger to the JSON format of patch 007 and returns the
+// buffers of the info and error streams.
+func captureJSONLogs(t *testing.T) (*bytes.Buffer, *bytes.Buffer) {
+	t.Helper()
+
+	var output, errOutput bytes.Buffer
+	logger.SetOutput(&output)
+	logger.SetErrOutput(&errOutput)
+	logger.SetJSONFormat(true)
+	t.Cleanup(func() {
+		logger.SetJSONFormat(false)
+		logger.SetOutput(ginkgo.GinkgoWriter)
+		logger.SetErrOutput(ginkgo.GinkgoWriter)
+	})
+
+	return &output, &errOutput
+}
+
+// jsonLogLines decodes the log lines and fails when one of them is not a JSON object.
+func jsonLogLines(t *testing.T, logs string) []map[string]any {
+	t.Helper()
+
+	lines := []map[string]any{}
+	for _, line := range strings.Split(strings.TrimSuffix(logs, "\n"), "\n") {
+		if line == "" {
+			continue
+		}
+		entry := map[string]any{}
+		require.NoError(t, json.Unmarshal([]byte(line), &entry), "every line must be a JSON object: %q", line)
+		lines = append(lines, entry)
+	}
+
+	return lines
+}
+
+func authLogMessages(lines []map[string]any) []string {
+	messages := []string{}
+	for _, line := range lines {
+		if line["level"] == "auth" {
+			messages = append(messages, line["msg"].(string))
+		}
+	}
+
+	return messages
+}
+
+// TestOAuthCallbackCSRFFailureJSONLogs checks GHSA-hhqp-vx7f-5c6m with the JSON logs of the
+// dex-authenticator: a failed CSRF check of the callback logs the names of the cookies, never their
+// values. The session cookie of the dex-authenticator carries the refresh token of the user.
+func TestOAuthCallbackCSRFFailureJSONLogs(t *testing.T) {
+	opts := baseTestOptions()
+	require.NoError(t, validation.Validate(opts))
+	proxy, err := NewOAuthProxy(opts, func(string) bool { return true })
+	require.NoError(t, err)
+
+	csrf, err := cookies.NewCSRF(proxy.CookieOptions, "synthetic-pkce-verifier")
+	require.NoError(t, err)
+	output, errOutput := captureJSONLogs(t)
+
+	query := url.Values{
+		"code":  {"synthetic-callback-code"},
+		"state": {encodeState(csrf.HashOAuthState(), "/", false)},
+	}
+	req := httptest.NewRequest(http.MethodGet, "/oauth2/callback?"+query.Encode(), nil)
+	sessionCookie := &http.Cookie{Name: proxy.CookieOptions.Name, Value: "synthetic-refresh-token-credential"}
+	req.AddCookie(sessionCookie)
+	rw := httptest.NewRecorder()
+	proxy.ServeHTTP(rw, req)
+
+	assert.Equal(t, http.StatusForbidden, rw.Code)
+	logs := output.String() + errOutput.String()
+	assert.NotContains(t, logs, sessionCookie.Value)
+	assert.Contains(t, authLogMessages(jsonLogLines(t, output.String())),
+		"Cookies were found in OAuth callback, but none was a CSRF cookie.")
+	jsonLogLines(t, errOutput.String())
+}
+
+// TestSignOutJSONLog checks the "User signed out" auth event of patch 007: it names the user of the
+// session the request carried.
+func TestSignOutJSONLog(t *testing.T) {
+	test, err := NewProcessCookieTestWithDefaults()
+	require.NoError(t, err)
+	test.req = httptest.NewRequest(http.MethodGet, test.opts.ProxyPrefix+"/sign_out", nil)
+
+	created := time.Now()
+	require.NoError(t, test.SaveSession(&sessions.SessionState{
+		Email:       "jane.doe@example.com",
+		AccessToken: "access_token",
+		CreatedAt:   &created,
+	}))
+	output, _ := captureJSONLogs(t)
+
+	test.rw = httptest.NewRecorder()
+	test.proxy.ServeHTTP(test.rw, test.req)
+
+	assert.Equal(t, http.StatusFound, test.rw.Code)
+	lines := jsonLogLines(t, output.String())
+	signedOut := []map[string]any{}
+	for _, line := range lines {
+		if line["level"] == "auth" && line["msg"] == "User signed out" {
+			signedOut = append(signedOut, line)
+		}
+	}
+	require.Len(t, signedOut, 1)
+	assert.Equal(t, "jane.doe@example.com", signedOut[0]["user"])
+}
