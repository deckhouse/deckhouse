@@ -0,0 +1,109 @@
+package logger
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	middlewareapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/middleware"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func newJSONLogger(out, errOut *bytes.Buffer) *Logger {
+	l := New(0)
+	l.writer = out
+	l.errWriter = errOut
+	l.SetJSONFormat(true)
+	return l
+}
+
+func decodeLines(t *testing.T, buf *bytes.Buffer) []map[string]any {
+	t.Helper()
+	lines := []map[string]any{}
+	for _, line := range strings.Split(strings.TrimSuffix(buf.String(), "\n"), "\n") {
+		if line == "" {
+			continue
+		}
+		entry := map[string]any{}
+		require.NoError(t, json.Unmarshal([]byte(line), &entry), "every line must be a JSON object: %q", line)
+		lines = append(lines, entry)
+	}
+	return lines
+}
+
+func scopedRequest(t *testing.T, target string) *http.Request {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodGet, target, nil)
+	req.Header.Set("User-Agent", "agent \"quoted\"\nnext line")
+	return middlewareapi.AddRequestScope(req, &middlewareapi.RequestScope{RequestID: "request-id"})
+}
+
+func TestJSONFormatStandardLog(t *testing.T) {
+	var out, errOut bytes.Buffer
+	l := newJSONLogger(&out, &errOut)
+
+	l.Output(DEFAULT, 1, "plain \"message\"\nwith a newline")
+	l.Output(ERROR, 1, "failure")
+
+	info := decodeLines(t, &out)
+	require.Len(t, info, 1)
+	assert.Equal(t, "info", info[0]["level"])
+	assert.Equal(t, "plain \"message\"\nwith a newline", info[0]["msg"])
+	assert.NotContains(t, info[0], "file", "no file is logged without Lshortfile or Llongfile")
+
+	errors := decodeLines(t, &errOut)
+	require.Len(t, errors, 1)
+	assert.Equal(t, "error", errors[0]["level"])
+	assert.Equal(t, "failure", errors[0]["msg"])
+}
+
+func TestJSONFormatAuthLog(t *testing.T) {
+	var out, errOut bytes.Buffer
+	l := newJSONLogger(&out, &errOut)
+
+	l.PrintAuthf("jane@example.com", scopedRequest(t, "http://app.example.com/oauth2/sign_out"), AuthSuccess, "User signed out %d", 1)
+
+	lines := decodeLines(t, &out)
+	require.Len(t, lines, 1)
+	assert.Equal(t, "auth", lines[0]["level"])
+	assert.Equal(t, "jane@example.com", lines[0]["user"])
+	assert.Equal(t, string(AuthSuccess), lines[0]["status"])
+	assert.Equal(t, "User signed out 1", lines[0]["msg"])
+	assert.Equal(t, "request-id", lines[0]["request_id"])
+	assert.Equal(t, "app.example.com", lines[0]["host"])
+	assert.Equal(t, "agent \"quoted\"\nnext line", lines[0]["user_agent"])
+	assert.Empty(t, errOut.String())
+}
+
+func TestJSONFormatRequestLog(t *testing.T) {
+	var out, errOut bytes.Buffer
+	l := newJSONLogger(&out, &errOut)
+	req := scopedRequest(t, "http://app.example.com/oauth2/auth?rd=%2F")
+
+	l.PrintReq("jane", "-", req, url.URL{Path: "/oauth2/auth", RawQuery: "rd=%2F"}, time.Now(), http.StatusUnauthorized, 13)
+
+	lines := decodeLines(t, &out)
+	require.Len(t, lines, 1)
+	assert.Equal(t, "request", lines[0]["level"])
+	assert.Equal(t, "/oauth2/auth?rd=%2F", lines[0]["uri"])
+	assert.InDelta(t, http.StatusUnauthorized, lines[0]["status"], 0)
+	assert.InDelta(t, 13, lines[0]["response_size"], 0)
+	assert.Equal(t, "jane", lines[0]["user"])
+}
+
+func TestTextFormatIsTheDefault(t *testing.T) {
+	var out bytes.Buffer
+	l := New(0)
+	l.writer = &out
+
+	l.Output(DEFAULT, 1, "message")
+
+	assert.True(t, strings.HasSuffix(out.String(), "] message\n"), "unexpected log line: %q", out.String())
+	assert.False(t, json.Valid(bytes.TrimSpace(out.Bytes())))
+}
