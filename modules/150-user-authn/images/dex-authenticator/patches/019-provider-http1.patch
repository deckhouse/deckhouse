+package providers
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sync"
+	"testing"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/requests"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestOIDCProviderTalksHTTP1ToTheProvider checks that the code exchange and the refresh go over
+// the transport of the provider: a TLS server that offers HTTP/2 and that only that transport
+// trusts gets them over HTTP/1.1.
+func TestOIDCProviderTalksHTTP1ToTheProvider(t *testing.T) {
+	// Not parallel: the test sets the TLS of the transport of the process.
+	idToken, err := newSignedTestIDToken(defaultIDToken)
+	require.NoError(t, err)
+	body, err := json.Marshal(redeemTokenResponse{
+		AccessToken:  accessToken,
+		ExpiresIn:    10,
+		TokenType:    "Bearer",
+		RefreshToken: refreshToken,
+		IDToken:      idToken,
+	})
+	require.NoError(t, err)
+
+	var (
+		mu     sync.Mutex
+		protos []string
+	)
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		protos = append(protos, r.Proto)
+		mu.Unlock()
+		rw.Header().Add("content-type", "application/json")
+		_, _ = rw.Write(body)
+	}))
+	server.EnableHTTP2 = true
+	server.StartTLS()
+	t.Cleanup(server.Close)
+
+	pool := x509.NewCertPool()
+	pool.AddCert(server.Certificate())
+	tlsBefore := requests.ProviderTransport.TLSClientConfig
+	requests.ProviderTransport.TLSClientConfig = &tls.Config{RootCAs: pool, MinVersion: tls.VersionTLS12}
+	t.Cleanup(func() {
+		requests.ProviderTransport.CloseIdleConnections()
+		requests.ProviderTransport.TLSClientConfig = tlsBefore
+	})
+
+	serverURL, err := url.Parse(server.URL)
+	require.NoError(t, err)
+	provider := newOIDCProvider(serverURL, false)
+
+	_, err = provider.Redeem(context.Background(), provider.RedeemURL.String(), "code1234", "")
+	require.NoError(t, err)
+
+	refreshed, err := provider.RefreshSession(context.Background(), &sessions.SessionState{
+		AccessToken:  "changeit",
+		IDToken:      idToken,
+		RefreshToken: refreshToken,
+		Email:        "janedoe@example.com",
+		User:         "11223344",
+	})
+	require.NoError(t, err)
+	assert.True(t, refreshed)
+
+	mu.Lock()
+	defer mu.Unlock()
+	assert.Equal(t, []string{"HTTP/1.1", "HTTP/1.1"}, protos)
+}
