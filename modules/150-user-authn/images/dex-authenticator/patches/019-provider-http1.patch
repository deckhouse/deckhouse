+package validation
+
+import (
+	"encoding/pem"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/requests"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestConfigureProviderTransportSetsBothTransports checks that the TLS of the provider reaches the
+// transport of the OIDC provider as well as the default one.
+func TestConfigureProviderTransportSetsBothTransports(t *testing.T) {
+	// Not parallel: the test sets the TLS of the transports of the process.
+	defaultTransport, ok := requests.DefaultTransport.(*http.Transport)
+	require.True(t, ok)
+	defaultBefore := defaultTransport.TLSClientConfig
+	providerBefore := requests.ProviderTransport.TLSClientConfig
+	t.Cleanup(func() {
+		defaultTransport.TLSClientConfig = defaultBefore
+		requests.ProviderTransport.TLSClientConfig = providerBefore
+	})
+
+	server := httptest.NewTLSServer(http.HandlerFunc(func(rw http.ResponseWriter, _ *http.Request) {
+		rw.WriteHeader(http.StatusNoContent)
+	}))
+	t.Cleanup(server.Close)
+	caFile := filepath.Join(t.TempDir(), "ca.crt")
+	require.NoError(t, os.WriteFile(caFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}), 0o600))
+
+	t.Run("provider ca", func(t *testing.T) {
+		o := options.NewOptions()
+		o.Providers[0].CAFiles = []string{caFile}
+
+		require.Empty(t, configureProviderTransport(o, nil))
+
+		require.NotNil(t, requests.ProviderTransport.TLSClientConfig)
+		require.NotNil(t, defaultTransport.TLSClientConfig)
+		assert.NotSame(t, defaultTransport.TLSClientConfig, requests.ProviderTransport.TLSClientConfig)
+		assert.Empty(t, requests.ProviderTransport.TLSClientConfig.NextProtos, "HTTP/2 must not be offered")
+
+		resp, err := requests.ProviderHTTPClient.Get(server.URL)
+		require.NoError(t, err)
+		require.NoError(t, resp.Body.Close())
+		assert.Equal(t, "HTTP/1.1", resp.Proto)
+		requests.ProviderTransport.CloseIdleConnections()
+	})
+
+	t.Run("insecure skip verify", func(t *testing.T) {
+		o := options.NewOptions()
+		o.SSLInsecureSkipVerify = true
+
+		require.Empty(t, configureProviderTransport(o, nil))
+
+		assert.True(t, requests.ProviderTransport.TLSClientConfig.InsecureSkipVerify)
+		assert.True(t, defaultTransport.TLSClientConfig.InsecureSkipVerify)
+	})
+
+	t.Run("a CA file that does not load changes nothing", func(t *testing.T) {
+		defaultTransport.TLSClientConfig = nil
+		requests.ProviderTransport.TLSClientConfig = nil
+		o := options.NewOptions()
+		o.Providers[0].CAFiles = []string{filepath.Join(t.TempDir(), "missing.crt")}
+
+		msgs := configureProviderTransport(o, nil)
+
+		require.Len(t, msgs, 1)
+		assert.Contains(t, msgs[0], "unable to load provider CA file(s)")
+		assert.Nil(t, defaultTransport.TLSClientConfig)
+		assert.Nil(t, requests.ProviderTransport.TLSClientConfig)
+	})
+}
