+// loginRestartedParam marks the sign-in that restarts a flow whose code the
+// provider refused (Deckhouse patch 013). The sign-in copies it into the CSRF
+// cookie of the new flow, which the callback reads; a refusal in a flow that
+// carries it is an error, so the restart happens at most once per flow.
+const loginRestartedParam = "login_restarted"
+
+// isCodeRefused reports whether the provider refused the authorization code at the token endpoint
+// with invalid_grant (RFC 6749 §5.2). Dex answers this when the browser session the code was minted
+// in has ended between the code being issued and redeemed: the code is spent though it never bought
+// a token, and the login has to start again. A provider that is unreachable or answers a 5xx is a
+// different error and is not this (see OIDCProvider.Redeem, which keeps the oauth2 error underneath).
+func isCodeRefused(err error) bool {
+	retrieveErr, ok := errors.AsType[*oauth2.RetrieveError](err)
+	return ok && retrieveErr.ErrorCode == "invalid_grant"
+}
