+)
+
+// stubRedeemProvider is a provider whose code redemption fails with a fixed error, so the callback
+// can be driven past redeemCode without a token endpoint.
+type stubRedeemProvider struct {
+	*providers.ProviderData
+	redeemErr error
+}
+
+func (p *stubRedeemProvider) Redeem(_ context.Context, _, _, _ string) (*sessionsapi.SessionState, error) {
+	return nil, p.redeemErr
+}
+
+// invalidGrant is the error OIDCProvider.Redeem returns when the token endpoint refuses the code.
+func invalidGrant() error {
+	return fmt.Errorf("token exchange failed: %w", &oauth2.RetrieveError{
+		Response:  &http.Response{StatusCode: http.StatusBadRequest},
+		ErrorCode: "invalid_grant",
+	})
+}
+
+func TestIsCodeRefused(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{"invalid_grant wrapped", invalidGrant(), true},
+		{"invalid_grant bare", &oauth2.RetrieveError{ErrorCode: "invalid_grant"}, true},
+		{"a provider 5xx", fmt.Errorf("token exchange failed: %w", &oauth2.RetrieveError{
+			Response: &http.Response{StatusCode: http.StatusInternalServerError}, ErrorCode: "invalid_request"}), false},
+		{"a locked account", &oauth2.RetrieveError{ErrorCode: "access_denied"}, false},
+		{"a transport error", fmt.Errorf("token exchange failed: %w", context.DeadlineExceeded), false},
+		{"no error", nil, false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, isCodeRefused(tc.err))
+		})
+	}
+}
+
+// newCallbackProxy builds a proxy whose code redemption fails with redeemErr.
+func newCallbackProxy(t *testing.T, redeemErr error) *OAuthProxy {
+	t.Helper()
+	return newCallbackProxyWith(t, redeemErr, false)
+}
+
+// newCallbackProxyWith is newCallbackProxy with one CSRF cookie per sign-in flow when perRequest is
+// set, as DexAuthenticator runs it.
+func newCallbackProxyWith(t *testing.T, redeemErr error, perRequest bool) *OAuthProxy {
+	t.Helper()
+	opts := baseTestOptions()
+	opts.Cookie.CSRFPerRequest = perRequest
+	require.NoError(t, validation.Validate(opts))
+	proxy, err := NewOAuthProxy(opts, func(string) bool { return true })
+	require.NoError(t, err)
+	proxy.provider = &stubRedeemProvider{ProviderData: &providers.ProviderData{}, redeemErr: redeemErr}
+	return proxy
+}
+
+// callbackRequest is a valid OAuth2 callback (a code, matching state and CSRF cookie) that was going
+// to appRedirect, with the given headers.
+func callbackRequest(t *testing.T, proxy *OAuthProxy, appRedirect string, headers map[string]string) *http.Request {
+	t.Helper()
+	return callbackRequestOfFlow(t, proxy, appRedirect, headers, false)
+}
+
+// callbackRequestOfFlow is callbackRequest of a flow that restarts a refused one when restarted is
+// set.
+func callbackRequestOfFlow(t *testing.T, proxy *OAuthProxy, appRedirect string, headers map[string]string, restarted bool) *http.Request {
+	t.Helper()
+	csrf, err := cookies.NewCSRF(proxy.CookieOptions, "")
+	require.NoError(t, err)
+	if restarted {
+		csrf.MarkRestarted()
+	}
+	req := httptest.NewRequest(http.MethodGet,
+		"/oauth2/callback?code=callback_code&state="+encodeState(csrf.HashOAuthState(), appRedirect, false), nil)
+	req = middlewareapi.AddRequestScope(req, &middlewareapi.RequestScope{})
+	for k, v := range headers {
+		req.Header.Set(k, v)
+	}
+	csrfCookie, err := csrf.SetCookie(httptest.NewRecorder(), req)
+	require.NoError(t, err)
+	req.AddCookie(csrfCookie)
+	return req
+}
+
+// TestOAuthCallbackRestartsLoginAfterSessionEnded: a tab that finishes its login after the user
+// signed out gets the login started again, not an error page. A browser navigation is redirected to
+// the sign-in page keeping where it was going; a script gets 401 instead of a cross-origin redirect
+// it cannot follow (Deckhouse patch 013, patch 005).
+func TestOAuthCallbackRestartsLoginAfterSessionEnded(t *testing.T) {
+	t.Run("a navigation restarts the login", func(t *testing.T) {
+		proxy := newCallbackProxy(t, invalidGrant())
+		req := callbackRequest(t, proxy, "/app/page", map[string]string{"Sec-Fetch-Mode": "navigate"})
+		rw := httptest.NewRecorder()
+
+		proxy.OAuthCallback(rw, req)
+
+		assert.Equal(t, http.StatusFound, rw.Code, rw.Body.String())
+		assert.Equal(t, "/oauth2/sign_in?rd=%2Fapp%2Fpage&login_restarted=1", rw.Header().Get("Location"))
+	})
+
+	t.Run("a script gets 401, not a redirect", func(t *testing.T) {
+		for _, h := range []map[string]string{
+			{"Sec-Fetch-Mode": "cors"},
+			{"X-Requested-With": "XMLHttpRequest"},
+		} {
+			proxy := newCallbackProxy(t, invalidGrant())
+			req := callbackRequest(t, proxy, "/app/page", h)
+			rw := httptest.NewRecorder()
+
+			proxy.OAuthCallback(rw, req)
+
+			assert.Equal(t, http.StatusUnauthorized, rw.Code)
+			assert.Equal(t, applicationJSON, rw.Header().Get("Content-Type"))
+			assert.Equal(t, "{}", rw.Body.String())
+			assert.Empty(t, rw.Header().Get("Location"))
+		}
+	})
+
+	t.Run("an open redirect falls back to the root", func(t *testing.T) {
+		proxy := newCallbackProxy(t, invalidGrant())
+		req := callbackRequest(t, proxy, "https://evil.example.com/", map[string]string{"Sec-Fetch-Mode": "navigate"})
+		rw := httptest.NewRecorder()
+
+		proxy.OAuthCallback(rw, req)
+
+		assert.Equal(t, http.StatusFound, rw.Code)
+		assert.Equal(t, "/oauth2/sign_in?rd=%2F&login_restarted=1", rw.Header().Get("Location"))
+	})
+}
+
+// TestOAuthCallbackKeepsServerErrorForOtherRedeemFailures: a redemption that failed for another
+// reason (the provider is down or answered a 5xx) stays a 500, not a restart.
+func TestOAuthCallbackKeepsServerErrorForOtherRedeemFailures(t *testing.T) {
+	proxy := newCallbackProxy(t, fmt.Errorf("token exchange failed: %w", &oauth2.RetrieveError{
+		Response:  &http.Response{StatusCode: http.StatusBadGateway},
+		ErrorCode: "",
+	}))
+	req := callbackRequest(t, proxy, "/app/page", map[string]string{"Sec-Fetch-Mode": "navigate"})
+	rw := httptest.NewRecorder()
+
+	proxy.OAuthCallback(rw, req)
+
+	assert.Equal(t, http.StatusInternalServerError, rw.Code)
+	assert.Empty(t, rw.Header().Get("Location"))
+}
+
+// TestOAuthCallbackLogsRefusedCode: a refused code and any other failed redemption write the auth
+// log line the security event of a failed login is built from (patch 008-auth-log-login-failures),
+// with the client address.
+func TestOAuthCallbackLogsRefusedCode(t *testing.T) {
+	for name, redeemErr := range map[string]error{
+		"invalid_grant": invalidGrant(),
+		"a provider 5xx": fmt.Errorf("token exchange failed: %w", &oauth2.RetrieveError{
+			Response: &http.Response{StatusCode: http.StatusBadGateway}}),
+	} {
+		t.Run(name, func(t *testing.T) {
+			var out bytes.Buffer
+			logger.SetOutput(&out)
+			t.Cleanup(func() { logger.SetOutput(os.Stdout) })
+
+			proxy := newCallbackProxy(t, redeemErr)
+			req := callbackRequest(t, proxy, "/app/page", map[string]string{"Sec-Fetch-Mode": "navigate"})
+			req.RemoteAddr = "192.0.2.10:4711"
+			proxy.OAuthCallback(httptest.NewRecorder(), req)
+
+			assert.Contains(t, out.String(), "Invalid authentication via OAuth2: unable to redeem the code")
+			assert.Contains(t, out.String(), "192.0.2.10")
+		})
+	}
+}
+
+// TestOAuthCallbackRestartsTheLoginOncePerFlow: a code refused in a flow that restarts a refused
+// one is an error, not another restart, so a refusal that repeats does not loop. Parallel sign-ins
+// that shared one CSRF cookie made every code fail, and the restarts went round in a loop.
+func TestOAuthCallbackRestartsTheLoginOncePerFlow(t *testing.T) {
+	proxy := newCallbackProxyWith(t, invalidGrant(), true)
+
+	first := httptest.NewRecorder()
+	proxy.OAuthCallback(first, callbackRequestOfFlow(t, proxy, "/app/page", map[string]string{"Sec-Fetch-Mode": "navigate"}, false))
+	assert.Equal(t, http.StatusFound, first.Code)
+	assert.Equal(t, "/oauth2/sign_in?rd=%2Fapp%2Fpage&login_restarted=1", first.Header().Get("Location"))
+
+	second := httptest.NewRecorder()
+	proxy.OAuthCallback(second, callbackRequestOfFlow(t, proxy, "/app/page", map[string]string{"Sec-Fetch-Mode": "navigate"}, true))
+	assert.Equal(t, http.StatusInternalServerError, second.Code)
+	assert.Empty(t, second.Header().Get("Location"))
+}
+
+// TestOAuthCallbackClearsTheCookieOfTheRefusedFlow: with one CSRF cookie per flow, the restart
+// expires the cookie of the refused flow instead of leaving it until it expires on its own.
+func TestOAuthCallbackClearsTheCookieOfTheRefusedFlow(t *testing.T) {
+	proxy := newCallbackProxyWith(t, invalidGrant(), true)
+	req := callbackRequestOfFlow(t, proxy, "/app/page", map[string]string{"Sec-Fetch-Mode": "navigate"}, false)
+	var flowCookie string
+	for _, c := range req.Cookies() {
+		if strings.HasSuffix(c.Name, "_csrf") {
+			flowCookie = c.Name
+		}
+	}
+	require.NotEmpty(t, flowCookie)
+	assert.NotEqual(t, proxy.CookieOptions.Name+"_csrf", flowCookie, "the cookie of a flow carries part of its state in its name")
+
+	rw := httptest.NewRecorder()
+	proxy.OAuthCallback(rw, req)
+
+	assert.Equal(t, http.StatusFound, rw.Code)
+	cleared := false
+	for _, c := range rw.Result().Cookies() {
+		if c.Name == flowCookie && c.MaxAge < 0 {
+			cleared = true
+		}
+	}
+	assert.True(t, cleared, "the CSRF cookie of the refused flow must be cleared")
+}
+
+// TestOAuthStartCarriesTheRestartIntoTheFlow: the sign-in that the restart redirects to marks the
+// CSRF cookie of the new flow, and only that one.
+func TestOAuthStartCarriesTheRestartIntoTheFlow(t *testing.T) {
+	for _, tc := range []struct {
+		target    string
+		restarted bool
+	}{
+		{"/oauth2/start?rd=%2Fapp%2Fpage&login_restarted=1", true},
+		{"/oauth2/start?rd=%2Fapp%2Fpage", false},
+	} {
+		t.Run(tc.target, func(t *testing.T) {
+			proxy := newCallbackProxyWith(t, nil, true)
+			proxy.provider = &stubRedeemProvider{ProviderData: &providers.ProviderData{LoginURL: &url.URL{Scheme: "https", Host: "dex.example.com", Path: "/auth"}}}
+			rw := httptest.NewRecorder()
+			proxy.OAuthStart(rw, middlewareapi.AddRequestScope(httptest.NewRequest(http.MethodGet, tc.target, nil), &middlewareapi.RequestScope{}))
+			require.Equal(t, http.StatusFound, rw.Code, rw.Body.String())
+
+			var csrfCookie *http.Cookie
+			for _, c := range rw.Result().Cookies() {
+				if strings.HasSuffix(c.Name, "_csrf") && c.MaxAge >= 0 {
+					csrfCookie = c
+				}
+			}
+			require.NotNil(t, csrfCookie)
+			req := httptest.NewRequest(http.MethodGet, "/oauth2/callback", nil)
+			req.AddCookie(csrfCookie)
+			csrf, err := cookies.LoadCSRFCookie(req, csrfCookie.Name, proxy.CookieOptions)
+			require.NoError(t, err)
+			assert.Equal(t, tc.restarted, csrf.Restarted())
+		})
+	}
+}
