+// Package redispeers keeps the sessions in the Redis of every replica of the proxy (Deckhouse patch
+// 019).
+//
+// Every replica has a Redis of its own, without a disk, and none of them is a master for long. A
+// replica writes each session to its own Redis and to the Redis of its neighbours, and reads it
+// from its own Redis, then from a neighbour, then from the memory of the process. A Redis that
+// starts empty is filled from a neighbour by the replication of Redis and then detached. While no
+// Redis takes a session, the memory store keeps it. The memory also keeps every
+// removal the Redis of the replica did not take, and gives both to that Redis once it takes them.
+//
+// The store is a cache, as the memory store is: the cookie of patch 002 carries the refresh token,
+// so a session no Redis has is restored through the provider on its next request. A record a Redis
+// has missed costs one refresh and never a sign-in.
+package redispeers
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"slices"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/logger"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/memory"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/persistence"
+	"github.com/redis/go-redis/v9"
+)
+
+const (
+	// failuresToLeave is how many requests in a row a Redis has to fail before the store stops
+	// asking it. Each of them is bounded by the timeout of a request.
+	failuresToLeave = 5
+
+	// failingToLeave is how long a Redis has to fail every request before the store stops asking
+	// it, besides failuresToLeave failures: under load a Redis that stalls for a moment fails many
+	// requests in a row within that moment. The probe asks every Redis every second, so a Redis
+	// that is down is left within a few seconds even without requests.
+	failingToLeave = 2 * time.Second
+
+	// answersToForgive is how many answers in a row clear the failures a Redis has collected: one
+	// quick answer between stalls does not keep a Redis that fails most requests in use.
+	answersToForgive = 3
+
+	// probesToReturn is how many probes in a row a Redis that was left has to answer before the
+	// store sends it requests again: a Redis that comes back for a moment between stalls is not
+	// taken back only to be left again.
+	probesToReturn = 3
+
+	// probeInterval is how often the store looks for its neighbours and asks every Redis for its
+	// state. A Redis that was left is taken back by the probe.
+	probeInterval = time.Second
+
+	resolveTimeout = time.Second
+
+	// ownName is the address of the Redis of a replica that has no neighbours.
+	ownName = "own"
+)
+
+// errSeeding is the answer of the readiness check until the Redis of the replica has been filled,
+// or the time for that has run out.
+var errSeeding = errors.New("the redis of the replica is being filled from a neighbour")
+
+type config struct {
+	// self is the address of the Redis of the replica among those resolve returns.
+	self string
+	own  node
+	dial func(addr string) node
+	// resolve returns the addresses of the Redis of every replica, this one included.
+	resolve func(ctx context.Context) ([]string, error)
+	memory  *memory.Store
+
+	timeout       time.Duration
+	seedTimeout   time.Duration
+	probeInterval time.Duration
+	// failingToLeave: see the constant; zero leaves a Redis after failuresToLeave failures.
+	failingToLeave time.Duration
+}
+
+type endpoint struct {
+	addr string
+	node node
+
+	mu       sync.Mutex
+	failures int
+	// failingSince is the time of the first of the failures in a row.
+	failingSince time.Time
+	// answers is how many requests in a row the Redis has answered since its last failure, and
+	// probeAnswers how many probes.
+	answers      int
+	probeAnswers int
+	// isUp: the store sends requests to the Redis. The Redis of the replica is up once it is filled
+	// and holds what the memory kept for it.
+	isUp bool
+	// isSeeded: the Redis answers and is filled, so it can hold the locks. Every replica judges a
+	// Redis by the same two facts, its own one included, so that they name the same home.
+	isSeeded bool
+	runID    string
+}
+
+func (e *endpoint) usable() bool {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+
+	return e.isUp
+}
+
+func (e *endpoint) seeded() bool {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+
+	return e.isSeeded
+}
+
+func (e *endpoint) id() string {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+
+	return e.runID
+}
+
+// succeeded counts an answer: answersToForgive of them in a row clear the failures.
+func (e *endpoint) succeeded() {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+
+	e.answers++
+	if e.answers >= answersToForgive {
+		e.failures = 0
+	}
+}
+
+// probeAnswered counts a probe the Redis has answered and reports whether it has answered
+// probesToReturn probes in a row, so that a Redis that was left can be taken back.
+func (e *endpoint) probeAnswered() bool {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+
+	e.probeAnswers++
+
+	return e.probeAnswers >= probesToReturn
+}
+
+// failed counts a failed request and reports whether the Redis has just been left: it has failed
+// failuresToLeave requests in a row, for at least failingFor.
+func (e *endpoint) failed(now time.Time, failingFor time.Duration) bool {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+
+	e.answers, e.probeAnswers = 0, 0
+	if e.failures == 0 {
+		e.failingSince = now
+	}
+	e.failures++
+	if e.failures < failuresToLeave || now.Sub(e.failingSince) < failingFor || (!e.isUp && !e.isSeeded) {
+		return false
+	}
+	e.isUp, e.isSeeded = false, false
+
+	return true
+}
+
+// set records what a probe has found and reports whether the Redis went up or down. A Redis that
+// is taken back starts without failures. For a Redis in use the probe is one answer, as a request
+// is: a probe between failed requests does not clear them, or a Redis that fails most requests but
+// answers the probe would never be left.
+func (e *endpoint) set(isUp, isSeeded bool, runID string) bool {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+
+	hasChanged := e.isUp != isUp
+	switch {
+	case isUp && !e.isUp:
+		e.failures, e.answers = 0, 0
+	case isUp:
+		e.answers++
+		if e.answers >= answersToForgive {
+			e.failures = 0
+		}
+	}
+	e.isUp, e.isSeeded, e.runID = isUp, isSeeded, runID
+
+	return hasChanged
+}
+
+type Store struct {
+	cfg     config
+	own     *endpoint
+	memory  *memory.Store
+	metrics *metrics
+
+	// peers are the Redis of the neighbours, ordered by address. The slice is replaced, never
+	// changed, so a reader may keep the one it took.
+	mu    sync.RWMutex
+	peers []*endpoint
+
+	// journal orders the writes of the requests (shared) against the moving of what the memory
+	// has kept to the Redis of the replica (exclusive), so that neither overwrites a newer one.
+	journal sync.RWMutex
+
+	// mode and home are what the metrics and the log last said.
+	stateMu sync.Mutex
+	mode    string
+	home    string
+
+	// ready is closed once the Redis of the replica has been filled or given up on.
+	ready chan struct{}
+	stop  context.CancelFunc
+	done  chan struct{}
+
+	// discoverMu orders the lookups of the neighbours of the probes and of a filling, which runs
+	// apart from the probes; it guards isResolveFailing.
+	discoverMu       sync.Mutex
+	isResolveFailing bool
+	// isRecovering: the Redis of the replica is being brought back into use apart from the probes
+	// (see recoverOwnApart), which go on probing the neighbours meanwhile.
+	isRecovering atomic.Bool
+	recoveries   sync.WaitGroup
+	// hasResolved: the neighbours have been looked up once at least, so an empty list means that the
+	// replica is alone.
+	hasResolved atomic.Bool
+}
+
+var _ persistence.Store = (*Store)(nil)
+
+// NewStore creates the store of a replica: it connects to the Redis of --redis-connection-url and
+// finds the Redis of its neighbours through opts.RedisPeers.
+func NewStore(opts *options.SessionOptions) (*Store, error) {
+	peers := opts.RedisPeers
+	if peers.Timeout <= 0 || peers.SeedTimeout <= 0 {
+		return nil, errors.New("redis-peers-timeout and redis-peers-seed-timeout must be above zero")
+	}
+	redisOpts, err := redis.ParseURL(opts.Redis.ConnectionURL)
+	if err != nil {
+		return nil, fmt.Errorf("unable to parse redis url: %w", err)
+	}
+	if opts.Redis.Password != "" {
+		redisOpts.Password = opts.Redis.Password
+	}
+	if opts.Redis.Username != "" {
+		redisOpts.Username = opts.Redis.Username
+	}
+
+	cfg := config{
+		own:            newRedisNode(redisOpts, redisOpts.Addr, peers.Timeout),
+		dial:           func(addr string) node { return newRedisNode(redisOpts, addr, peers.Timeout) },
+		resolve:        func(context.Context) ([]string, error) { return nil, nil },
+		timeout:        peers.Timeout,
+		seedTimeout:    peers.SeedTimeout,
+		probeInterval:  probeInterval,
+		failingToLeave: failingToLeave,
+	}
+
+	if peers.DNSName != "" {
+		self, err := netip.ParseAddr(peers.SelfAddress)
+		if err != nil {
+			return nil, fmt.Errorf("redis-peers-self-address must be the IP address of the replica: %w", err)
+		}
+		// The Redis of every replica listens on the port the Redis of this one does.
+		_, port, err := net.SplitHostPort(redisOpts.Addr)
+		if err != nil {
+			return nil, fmt.Errorf("the address of redis: %w", err)
+		}
+		cfg.self = net.JoinHostPort(self.String(), port)
+		cfg.resolve = func(ctx context.Context) ([]string, error) {
+			hosts, err := net.DefaultResolver.LookupHost(ctx, peers.DNSName)
+			if err != nil {
+				return nil, fmt.Errorf("error looking up %q: %w", peers.DNSName, err)
+			}
+			addrs := make([]string, 0, len(hosts))
+			for _, host := range hosts {
+				addrs = append(addrs, net.JoinHostPort(host, port))
+			}
+
+			return addrs, nil
+		}
+	}
+
+	cfg.memory, err = memory.NewStore(opts.Memory)
+	if err != nil {
+		return nil, err
+	}
+
+	return newStore(cfg), nil
+}
+
+// newStore starts the loop of the store: it fills the Redis of the replica and then probes every
+// Redis until Close.
+func newStore(cfg config) *Store {
+	ownAddr := cfg.self
+	if ownAddr == "" {
+		ownAddr = ownName
+	}
+
+	// The loop lives as long as the store, not as long as a request.
+	ctx, stop := context.WithCancel(context.Background())
+	s := &Store{
+		cfg:     cfg,
+		own:     &endpoint{addr: ownAddr, node: cfg.own},
+		memory:  cfg.memory,
+		metrics: newMetrics(),
+		ready:   make(chan struct{}),
+		stop:    stop,
+		done:    make(chan struct{}),
+	}
+
+	go s.run(ctx)
+
+	return s
+}
+
+func (s *Store) Close() error {
+	s.stop()
+	<-s.done
+	s.recoveries.Wait()
+
+	peers := s.peerSnapshot()
+	errs := make([]error, 0, len(peers)+1)
+	errs = append(errs, s.own.node.Close())
+	for _, peer := range peers {
+		errs = append(errs, peer.node.Close())
+	}
+
+	return errors.Join(errs...)
+}
+
+func (s *Store) run(ctx context.Context) {
+	defer close(s.done)
+
+	s.start(ctx)
+	close(s.ready)
+
+	ticker := time.NewTicker(s.cfg.probeInterval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			s.probe(ctx)
+		}
+	}
+}
+
+// Save writes the session to the Redis of the replica first and then to the Redis of every
+// neighbour. The order matters to a neighbour that is being filled: a write it refuses has reached
+// the Redis it copies before the refusal, so the copy brings it (see copyFrom).
+//
+// The memory keeps the session only when no Redis took it. With a neighbour that has it, the
+// Redis of the replica is left with its older copy, which costs one refresh; a copy in the memory
+// would outlive a removal the neighbour makes later.
+//
+// The journal is held for the write to the Redis of the replica and for what the memory keeps of
+// it, not for the writes to the neighbours: a move of the memory waits for the requests, and a
+// neighbour that answers slowly would hold it, and every request behind it, for its timeouts.
+func (s *Store) Save(ctx context.Context, key string, value []byte, ttl time.Duration) error {
+	set := func(n node) error { return n.Set(ctx, key, value, ttl) }
+
+	isAtOwn, err := s.journalOwn(ctx, key, set, nil)
+	if err != nil {
+		return err
+	}
+	isAtPeer := s.writePeers(ctx, opSave, set)
+
+	target := stepOwn
+	if !isAtOwn {
+		target = stepPeer
+		if !isAtPeer {
+			target = stepMemory
+			err = s.keep(ctx, key, value, ttl)
+		}
+	}
+	if err != nil {
+		return err
+	}
+	s.metrics.saves.WithLabelValues(target).Inc()
+
+	return nil
+}
+
+// journalOwn sends a write of a key to the Redis of the replica and, in one step for a move of the
+// memory, settles what the memory holds under the key: nothing once Redis has taken the write, as
+// what the memory kept is older, and otherwise the removal mark, when the write is a removal. It
+// reports whether Redis took the write.
+func (s *Store) journalOwn(ctx context.Context, key string, write func(node) error, mark func() error) (bool, error) {
+	s.journal.RLock()
+	defer s.journal.RUnlock()
+
+	if s.writeOwn(ctx, write) {
+		return true, s.memory.Clear(ctx, key)
+	}
+	if mark != nil {
+		return false, mark()
+	}
+
+	return false, nil
+}
+
+// keep leaves in the memory a session no Redis took.
+func (s *Store) keep(ctx context.Context, key string, value []byte, ttl time.Duration) error {
+	s.journal.RLock()
+	defer s.journal.RUnlock()
+
+	return s.memory.Save(ctx, key, value, ttl)
+}
+
+// Load looks for the session in the Redis of the replica, then in the Redis of each neighbour, then
+// in the memory of the process, which holds only what no Redis took.
+//
+// The session is missing (errNotFound) only when a filled Redis has answered that it does not have
+// it and no filled Redis failed the request: the cookie then restores the session through the
+// provider. Otherwise the session may well be in a Redis that did not answer, and Load returns
+// persistence.ErrStoreUnavailable: the request is answered 503, and the provider is not
+// asked to refresh every session of a replica whose Redis stall at once.
+func (s *Store) Load(ctx context.Context, key string) ([]byte, error) {
+	// A removal the Redis of the replica has not taken yet: the session is gone whatever Redis says.
+	kept, isKept := s.memory.Peek(key)
+	if isKept && len(kept) == 0 {
+		s.metrics.loads.WithLabelValues(stepCookie).Inc()
+		return nil, errNotFound
+	}
+
+	// isAnswered: a filled Redis has answered that it does not have the session. A neighbour that is
+	// being filled has not got everything yet, so its answer does not count. The Redis of the
+	// replica is in use only once it is filled. hasFailed: a filled Redis has failed the request, and
+	// it may be the one that has the session: one Redis took the writes while the other stalled,
+	// then the other came back and the first one stalls.
+	isAnswered, hasFailed := false, false
+	if s.own.usable() {
+		value, err := s.own.node.Get(ctx, key)
+		s.observe(ctx, s.own, err)
+		switch {
+		case err == nil:
+			s.metrics.loads.WithLabelValues(stepOwn).Inc()
+			return value, nil
+		case errors.Is(err, errNotFound):
+			isAnswered = true
+		default:
+			hasFailed = true
+		}
+	}
+
+	for _, peer := range s.peerSnapshot() {
+		if !peer.usable() {
+			continue
+		}
+		value, err := peer.node.Get(ctx, key)
+		s.observe(ctx, peer, err)
+		switch {
+		case err == nil:
+			s.metrics.loads.WithLabelValues(stepPeer).Inc()
+			return value, nil
+		case !peer.seeded():
+		case errors.Is(err, errNotFound):
+			isAnswered = true
+		default:
+			hasFailed = true
+		}
+	}
+
+	if isKept {
+		// Load, unlike Peek, counts as a use: under the size limit the memory drops what was
+		// not used for the longest time.
+		if value, err := s.memory.Load(ctx, key); err == nil {
+			s.metrics.loads.WithLabelValues(stepMemory).Inc()
+			return value, nil
+		}
+	}
+
+	if !isAnswered || hasFailed {
+		s.metrics.loads.WithLabelValues(stepUnavailable).Inc()
+		return nil, fmt.Errorf("%w: a filled redis did not answer", persistence.ErrStoreUnavailable)
+	}
+	s.metrics.loads.WithLabelValues(stepCookie).Inc()
+
+	return nil, errNotFound
+}
+
+// Clear removes the session from every Redis that answers. A removal the Redis of the replica does
+// not take is kept in the memory as an empty value until it does (see moveMemory), so a session
+// removed while Redis was away does not come back with it.
+func (s *Store) Clear(ctx context.Context, key string) error {
+	del := func(n node) error { return n.Del(ctx, key) }
+
+	_, err := s.journalOwn(ctx, key, del, func() error { return s.memory.Save(ctx, key, nil, 0) })
+	s.writePeers(ctx, opClear, del)
+
+	return err
+}
+
+// writeOwn sends a write to the Redis of the replica and reports whether Redis took it.
+func (s *Store) writeOwn(ctx context.Context, write func(node) error) bool {
+	if !s.own.usable() {
+		return false
+	}
+	err := write(s.own.node)
+	s.observe(ctx, s.own, err)
+
+	return err == nil
+}
+
+// apply writes a session to a Redis, or removes it when value is empty.
+func apply(ctx context.Context, n node, key string, value []byte, ttl time.Duration) error {
+	if len(value) == 0 {
+		return n.Del(ctx, key)
+	}
+
+	return n.Set(ctx, key, value, ttl)
+}
+
+// writePeers sends a write to the Redis of every neighbour at once and reports whether any took
+// it. A neighbour that fails does not fail the request: the session it missed costs one refresh.
+func (s *Store) writePeers(ctx context.Context, operation string, write func(node) error) bool {
+	var (
+		wg      sync.WaitGroup
+		isTaken atomic.Bool
+	)
+
+	for _, peer := range s.peerSnapshot() {
+		if !peer.usable() {
+			continue
+		}
+		wg.Go(func() {
+			err := write(peer.node)
+			s.observe(ctx, peer, err)
+			s.metrics.peerWrites.WithLabelValues(operation, writeResult(err)).Inc()
+			if err == nil {
+				isTaken.Store(true)
+			}
+		})
+	}
+	wg.Wait()
+
+	return isTaken.Load()
+}
+
+func writeResult(err error) string {
+	switch {
+	case err == nil:
+		return resultOK
+	case errors.Is(err, errReadOnly):
+		return resultReadOnly
+	case errors.Is(err, context.DeadlineExceeded), errors.Is(err, os.ErrDeadlineExceeded):
+		return resultTimeout
+	default:
+		return resultError
+	}
+}
+
+// Lock returns the refresh lock of a session. It is taken in every Redis lockNodes returns at that
+// moment.
+func (s *Store) Lock(key string) sessions.Lock {
+	return &lock{store: s, key: key}
+}
+
+// VerifyConnection is the readiness check of the proxy. It does not depend on Redis: without one
+// the replica works on the memory of the process. The one exception is the start, when the replica
+// is not ready until its empty Redis has been filled from a neighbour.
+func (s *Store) VerifyConnection(context.Context) error {
+	select {
+	case <-s.ready:
+		return nil
+	default:
+		return errSeeding
+	}
+}
+
+// observe counts the result of a request to a Redis: after failuresToLeave failures in a row the
+// store stops asking it.
+func (s *Store) observe(ctx context.Context, ep *endpoint, err error) {
+	// A Redis that loads the copy of a neighbour refuses the request, which is an answer too.
+	isAnswer := err == nil || errors.Is(err, errNotFound) || errors.Is(err, errReadOnly) || redis.HasErrorPrefix(err, "LOADING")
+	switch {
+	case isAnswer:
+		ep.succeeded()
+	case ctx.Err() != nil:
+		// The request was given up, which says nothing about Redis.
+	case ep.failed(time.Now(), s.cfg.failingToLeave):
+		logger.Errorf("redis-peers: the redis at %s does not answer and is left until it does: %v", ep.addr, err)
+		s.updateMode()
+	}
+}
+
+func (s *Store) peerSnapshot() []*endpoint {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	return s.peers
+}
+
+// lockHome returns the Redis a refresh lock is taken in first: the one with the lowest address among
+// those that answer and are filled. The metrics name it. Nil: no Redis.
+func (s *Store) lockHome() *endpoint {
+	var home *endpoint
+	if s.own.seeded() {
+		home = s.own
+	}
+	for _, peer := range s.peerSnapshot() {
+		if peer.seeded() && (home == nil || peer.addr < home.addr) {
+			home = peer
+		}
+	}
+
+	return home
+}
+
+// lockNodes returns every Redis that answers and is filled, by address, the own one included: a
+// refresh lock is taken in all of them (see lock). isAlone: there are none, and the replica has no
+// neighbours, so the memory of the process holds its locks.
+func (s *Store) lockNodes() ([]*endpoint, bool) {
+	peers := s.peerSnapshot()
+	nodes := make([]*endpoint, 0, len(peers)+1)
+	if s.own.seeded() {
+		nodes = append(nodes, s.own)
+	}
+	for _, peer := range peers {
+		if peer.seeded() {
+			nodes = append(nodes, peer)
+		}
+	}
+	slices.SortFunc(nodes, func(a, b *endpoint) int { return strings.Compare(a.addr, b.addr) })
+
+	return nodes, len(peers) == 0 && s.hasResolved.Load()
+}
+
+func (s *Store) updateMode() {
+	s.stateMu.Lock()
+	defer s.stateMu.Unlock()
+
+	peers := s.peerSnapshot()
+
+	seeded, seeding := 0, 0
+	for _, peer := range peers {
+		switch {
+		case peer.seeded():
+			seeded++
+		case peer.usable():
+			seeding++
+		}
+	}
+
+	mode := modeMemory
+	switch {
+	case s.own.usable():
+		mode = modeRedis
+	case seeded+seeding > 0:
+		mode = modePeer
+	}
+
+	home := homeMemory
+	if ep := s.lockHome(); ep != nil {
+		home = ep.addr
+	}
+
+	s.metrics.peers.WithLabelValues("seeded").Set(float64(seeded))
+	s.metrics.peers.WithLabelValues("seeding").Set(float64(seeding))
+	s.metrics.peers.WithLabelValues("down").Set(float64(len(peers) - seeded - seeding))
+
+	if mode != s.mode {
+		for _, m := range []string{modeRedis, modePeer, modeMemory} {
+			value := 0.0
+			if m == mode {
+				value = 1
+			}
+			s.metrics.mode.WithLabelValues(m).Set(value)
+		}
+		// The first call names the mode the store starts in; it is not a switch.
+		if s.mode != "" {
+			s.metrics.modeSwitches.WithLabelValues(mode).Inc()
+			logger.Printf("redis-peers: the session store works on %s now, was on %s", mode, s.mode)
+		}
+		s.mode = mode
+	}
+
+	if home != s.home {
+		s.metrics.lockHome.Reset()
+		s.metrics.lockHome.WithLabelValues(home).Set(1)
+		if s.home != "" {
+			logger.Printf("redis-peers: the refresh locks live in %s now, were in %s", home, s.home)
+		}
+		s.home = home
+	}
+}
+
+// probe looks for the neighbours and asks every Redis for its state. It takes back a Redis that
+// answers again, and notices a Redis of the replica that has restarted between two requests.
+func (s *Store) probe(ctx context.Context) {
+	s.discover(ctx)
+
+	for _, peer := range s.peerSnapshot() {
+		state, err := peer.node.State(ctx)
+		if err != nil {
+			s.observe(ctx, peer, err)
+			continue
+		}
+		// A Redis that was left comes back after probesToReturn answers in a row.
+		if !peer.usable() && !peer.probeAnswered() {
+			continue
+		}
+		if peer.set(true, state.isSeeded && !state.isReplica, state.runID) {
+			logger.Printf("redis-peers: the redis at %s answers again", peer.addr)
+		}
+	}
+
+	if s.isRecovering.Load() {
+		// The Redis of the replica is being brought back apart from the probes.
+		s.updateMode()
+		return
+	}
+
+	state, err := s.own.node.State(ctx)
+	isRestarted := err == nil && (state.runID != s.own.id() || !state.isSeeded || state.isReplica)
+	switch {
+	case err != nil:
+		s.observe(ctx, s.own, err)
+	case !s.own.usable():
+		if s.own.probeAnswered() {
+			s.recoverOwnApart(ctx, state)
+		}
+	case isRestarted:
+		logger.Printf("redis-peers: the redis of the replica has restarted and is empty")
+		s.own.set(false, false, "")
+		// The filling takes a while: the metrics say what the replica works on meanwhile.
+		s.updateMode()
+		s.recoverOwnApart(ctx, state)
+	default:
+		// A write the Redis has refused once is in the memory.
+		s.moveMemory(ctx)
+	}
+
+	s.updateMode()
+}
+
+// recoverOwnApart brings the Redis of the replica back into use in a goroutine of its own: a filling
+// takes up to the seed timeout, and the probes go on meanwhile, so that a neighbour that stalls is
+// noticed, and one that answers again is taken back. One recovery runs at a time.
+func (s *Store) recoverOwnApart(ctx context.Context, state nodeState) {
+	if !s.isRecovering.CompareAndSwap(false, true) {
+		return
+	}
+	s.recoveries.Go(func() {
+		defer s.isRecovering.Store(false)
+		defer s.updateMode()
+
+		s.recoverOwn(ctx, state)
+	})
+}
+
+// discover brings the list of neighbours up to date and reports whether it did. A lookup that
+// fails keeps the list.
+func (s *Store) discover(ctx context.Context) bool {
+	s.discoverMu.Lock()
+	defer s.discoverMu.Unlock()
+
+	ctx, cancel := context.WithTimeout(ctx, resolveTimeout)
+	defer cancel()
+
+	addrs, err := s.cfg.resolve(ctx)
+	if err != nil {
+		if !s.isResolveFailing {
+			logger.Errorf("redis-peers: cannot look up the neighbours, the known ones are kept: %v", err)
+		}
+		s.isResolveFailing = true
+
+		return false
+	}
+	s.isResolveFailing = false
+
+	known := map[string]*endpoint{}
+	for _, peer := range s.peerSnapshot() {
+		known[peer.addr] = peer
+	}
+
+	addrs = slices.Compact(slices.Sorted(slices.Values(addrs)))
+	next := make([]*endpoint, 0, len(addrs))
+	for _, addr := range addrs {
+		if addr == s.cfg.self {
+			continue
+		}
+		peer, ok := known[addr]
+		if !ok {
+			// A new neighbour gets the writes at once: it may be filling its Redis right now.
+			peer = &endpoint{addr: addr, node: s.cfg.dial(addr), isUp: true}
+			logger.Printf("redis-peers: a neighbour appeared: %s", addr)
+		}
+		delete(known, addr)
+		next = append(next, peer)
+	}
+
+	s.mu.Lock()
+	s.peers = next
+	s.mu.Unlock()
+	s.hasResolved.Store(true)
+
+	for addr, gone := range known {
+		logger.Printf("redis-peers: a neighbour is gone: %s", addr)
+		if err := gone.node.Close(); err != nil {
+			logger.Errorf("redis-peers: closing the connection to %s: %v", addr, err)
+		}
+	}
+
+	return true
+}
+
+// sleep waits for d and reports whether it did: false means ctx is done.
+func sleep(ctx context.Context, d time.Duration) bool {
+	select {
+	case <-ctx.Done():
+		return false
+	case <-time.After(d):
+		return true
+	}
+}
