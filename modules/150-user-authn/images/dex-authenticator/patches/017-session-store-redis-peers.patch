+// A store that is closed in the middle of a copy records no outcome of the filling: the copy
+// neither failed nor ran out of time.
+func TestStore_SeedIsCancelledByClose(t *testing.T) {
+	t.Parallel()
+	fakes := newFakeNet()
+	seedNeighbour(t, fakes, addrA, "ticket")
+	b := fakes.add(addrB)
+	fakes.mu.Lock()
+	b.pollsToCopy = 1 << 30
+	fakes.mu.Unlock()
+
+	store := startTestStore(t, fakes, addrB, 30*time.Second)
+	eventually(t, func() bool { isReplica, _ := b.role(); return isReplica }, "the copy has started")
