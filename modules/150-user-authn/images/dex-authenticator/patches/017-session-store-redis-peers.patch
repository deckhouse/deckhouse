+func TestStore_Register(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+	registry := prometheus.NewRegistry()
+
+	store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1 << 20})
+	require.NoError(t, store.Register(registry))
+
+	require.NoError(t, store.Save(ctx, "ticket-0", []byte("session"), time.Minute))
+	require.NoError(t, store.Save(ctx, "ticket-1", []byte("session"), time.Hour))
+	_, err := store.Load(ctx, "ticket-0")
+	require.NoError(t, err)
+	_, err = store.Load(ctx, "ticket-9")
+	require.Error(t, err)
+	clock.Advance(time.Minute)
+	// A scrape reads the collectors in any order: the gauges drop the expired session during
+	// it, so the counter of evictions may show that only in the next scrape. Drop it first.
+	store.usage()
+
+	expected := fmt.Sprintf(`
+# HELP oauth2_proxy_session_store_memory_bytes Bytes the sessions in the memory session store take: keys, values and an estimate of the overhead per session.
+# TYPE oauth2_proxy_session_store_memory_bytes gauge
+oauth2_proxy_session_store_memory_bytes %d
+# HELP oauth2_proxy_session_store_memory_entries Number of sessions in the memory session store.
+# TYPE oauth2_proxy_session_store_memory_entries gauge
+oauth2_proxy_session_store_memory_entries 1
+# HELP oauth2_proxy_session_store_memory_evictions_total Sessions dropped from the memory session store: over the limit in bytes (size) or past their TTL (expired).
+# TYPE oauth2_proxy_session_store_memory_evictions_total counter
+oauth2_proxy_session_store_memory_evictions_total{reason="expired"} 1
+# HELP oauth2_proxy_session_store_memory_loads_total Loads from the memory session store by result: hit or miss.
+# TYPE oauth2_proxy_session_store_memory_loads_total counter
+oauth2_proxy_session_store_memory_loads_total{result="hit"} 1
+oauth2_proxy_session_store_memory_loads_total{result="miss"} 1
+`, recordSize("ticket-1", []byte("session")))
+	require.NoError(t, testutil.GatherAndCompare(registry, strings.NewReader(expected)))
+
+	t.Run("a second store on the same registry is not an error", func(t *testing.T) {
+		second, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1 << 20})
+		require.NoError(t, second.Register(registry))
+	})
+}
+
+// TestStore_StubSession checks that a session the store has dropped is restored from its cookie as
+// the stub of patch 002.
+func TestStore_StubSession(t *testing.T) {
+	t.Parallel()
+
+	store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1 << 20, TTL: 11 * time.Minute})
+	manager := persistence.NewManager(store, &options.Cookie{
+		Name:     "_oauth2_proxy",
+		Path:     "/",
+		Expire:   168 * time.Hour,
+		Refresh:  10 * time.Minute,
+		Secure:   true,
+		HTTPOnly: true,
+		Secret:   "dh-test-secret-0123456789abcdef0",
+	})
+
+	saveRW := httptest.NewRecorder()
+	require.NoError(t, manager.Save(saveRW, httptest.NewRequest(http.MethodGet, "https://app.example.com/", nil), &sessionsapi.SessionState{
+		User:         "jane",
+		Email:        "jane.doe@example.com",
+		RefreshToken: "refresh-token",
+	}))
+
+	load := func() *sessionsapi.SessionState {
+		req := httptest.NewRequest(http.MethodGet, "https://app.example.com/", nil)
+		for _, cookie := range saveRW.Result().Cookies() {
+			req.AddCookie(cookie)
+		}
+		session, err := manager.Load(req)
+		require.NoError(t, err)
+
+		return session
+	}
+
+	assert.Equal(t, "jane", load().User)
+
+	clock.Advance(11 * time.Minute)
+	stub := load()
+	assert.Equal(t, "Does not found in Redis", stub.User)
+	assert.Equal(t, "refresh-token", stub.RefreshToken)
+	assert.Empty(t, stub.Email)
+	assert.Greater(t, stub.Age(), 10*time.Minute, "the stub is older than any refresh period")
+}
+
+func TestStore_Items(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+	store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1 << 20})
+	require.NoError(t, store.Save(ctx, "expiring", []byte("a"), time.Hour))
+	require.NoError(t, store.Save(ctx, "lasting", []byte("b"), 0))
+	require.NoError(t, store.Save(ctx, "expired", []byte("c"), time.Minute))
+	clock.Advance(10 * time.Minute)
+
+	items := store.Items()
+
+	assert.ElementsMatch(t, []Item{
+		{Key: "expiring", Value: []byte("a"), TTL: 50 * time.Minute},
+		{Key: "lasting", Value: []byte("b")},
+	}, items, "the records with the time they have left, the expired one left out")
+
+	// The values are copies: changing one does not change the store.
+	for i := range items {
+		items[i].Value[0] = 'x'
+	}
+	value, err := store.Load(ctx, "expiring")
+	require.NoError(t, err)
+	assert.Equal(t, "a", string(value))
+	checkInvariants(t, store)
+}
+
+func TestStore_Peek(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+	store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1 << 20})
+	require.NoError(t, store.Save(ctx, "ticket", []byte("session"), time.Hour))
+
+	_, ok := store.Peek("other")
+	assert.False(t, ok, "a key the store does not hold")
+
+	value, ok := store.Peek("ticket")
+	require.True(t, ok)
+	assert.Equal(t, "session", string(value))
+	value[0] = 'x'
+	value, _ = store.Peek("ticket")
+	assert.Equal(t, "session", string(value), "the value is a copy")
+
+	clock.Advance(2 * time.Hour)
+	_, ok = store.Peek("ticket")
+	assert.False(t, ok, "an expired record is not returned")
+	checkInvariants(t, store)
+}
diff --git a/pkg/sessions/redispeers/fake_test.go b/pkg/sessions/redispeers/fake_test.go
new file mode 100644
index 00000000..8ef94521
--- /dev/null
+++ b/pkg/sessions/redispeers/fake_test.go
@@ -0,0 +1,595 @@
+package redispeers
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/memory"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/client_golang/prometheus/testutil"
+	dto "github.com/prometheus/client_model/go"
+	"github.com/stretchr/testify/require"
+)
+
+// errDown is the answer of a fake Redis that is down.
+var errDown = errors.New("connection refused")
+
+// fakeNet is the Redis of every replica of a test, by address. It copies what the tests need of
+// the replication of Redis: a replica drops its data for a copy of its master, refuses writes
+// unless it is writable, and gets the writes of its master in their order.
+type fakeNet struct {
+	mu    sync.Mutex
+	nodes map[string]*fakeNode
+	runs  int
+	// resolveErr fails the lookup of the neighbours of a store under test.
+	resolveErr error
+	// memoryBytes is the limit of the memory of a store under test; zero is one megabyte.
+	memoryBytes int64
+}
+
+func newFakeNet() *fakeNet {
+	return &fakeNet{nodes: map[string]*fakeNode{}}
+}
+
+// add starts an empty Redis at addr.
+func (n *fakeNet) add(addr string) *fakeNode {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+
+	n.runs++
+	node := &fakeNode{net: n, addr: addr, data: map[string]fakeValue{}, runID: fmt.Sprintf("run-%d", n.runs)}
+	n.nodes[addr] = node
+
+	return node
+}
+
+type fakeValue struct {
+	value []byte
+	// expiresAt is zero for a key without an expiry.
+	expiresAt time.Time
+	// owner is the lock that holds a lock key.
+	owner *fakeLock
+}
+
+type fakeWrite struct {
+	key   string
+	value *fakeValue // nil: a delete
+}
+
+// fakeNode is a fake Redis. Its fields are guarded by the mutex of its fakeNet.
+type fakeNode struct {
+	net  *fakeNet
+	addr string
+
+	data  map[string]fakeValue
+	runID string
+
+	isDown bool
+	// copyErrs is how many questions about its state the Redis does not answer while it copies,
+	// as a Redis that loads the copy does not. writeErrs is how many writes it fails next, and
+	// promoteErrs how many times it refuses to be detached from its master.
+	copyErrs    int
+	writeErrs   int
+	promoteErrs int
+
+	master     *fakeNode
+	isLinkUp   bool
+	isWritable bool
+	// offset is what a master has sent and what a replica has applied.
+	offset int64
+	// pollsToCopy is how many times a replica is asked for its state before its copy is over.
+	pollsToCopy int
+	pollsLeft   int
+	// isStreamHeld: the writes of the master wait in stream instead of being applied, as on a slow
+	// link.
+	isStreamHeld bool
+	stream       []fakeWrite
+
+	// onWritable runs, outside the mutex, when the replica is told to take writes, and onSet
+	// before every Set.
+	onWritable func()
+	onSet      func()
+
+	commands []string
+}
+
+var _ node = (*fakeNode)(nil)
+
+func (f *fakeNode) checkWrite() error {
+	switch {
+	case f.isDown:
+		return errDown
+	case f.master != nil && !f.isWritable:
+		return errReadOnly
+	case f.writeErrs > 0:
+		f.writeErrs--
+		return errDown
+	}
+
+	return nil
+}
+
+func (f *fakeNode) Get(_ context.Context, key string) ([]byte, error) {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	if f.isDown {
+		return nil, errDown
+	}
+
+	stored, ok := f.data[key]
+	if !ok || (!stored.expiresAt.IsZero() && !stored.expiresAt.After(time.Now())) {
+		return nil, errNotFound
+	}
+
+	return stored.value, nil
+}
+
+func (f *fakeNode) Set(_ context.Context, key string, value []byte, ttl time.Duration) error {
+	f.net.mu.Lock()
+	hook := f.onSet
+	f.net.mu.Unlock()
+	if hook != nil {
+		hook()
+	}
+
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	if err := f.checkWrite(); err != nil {
+		return err
+	}
+
+	stored := fakeValue{value: value}
+	if ttl > 0 {
+		stored.expiresAt = time.Now().Add(ttl)
+	}
+	f.write(fakeWrite{key: key, value: &stored})
+
+	return nil
+}
+
+func (f *fakeNode) Del(_ context.Context, key string) error {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	if err := f.checkWrite(); err != nil {
+		return err
+	}
+	f.write(fakeWrite{key: key})
+
+	return nil
+}
+
+// write applies a write and, on a master, sends it to its replicas. The caller holds the mutex.
+func (f *fakeNode) write(w fakeWrite) {
+	f.apply(w)
+	if f.master != nil {
+		return
+	}
+
+	f.offset++
+	for _, replica := range f.net.nodes {
+		if replica.master != f || !replica.isLinkUp {
+			continue
+		}
+		replica.stream = append(replica.stream, w)
+		if !replica.isStreamHeld {
+			replica.drain()
+		}
+	}
+}
+
+func (f *fakeNode) apply(w fakeWrite) {
+	if w.value == nil {
+		delete(f.data, w.key)
+		return
+	}
+	f.data[w.key] = *w.value
+}
+
+// drain applies the writes of the master that have arrived. The caller holds the mutex.
+func (f *fakeNode) drain() {
+	for _, w := range f.stream {
+		f.apply(w)
+		f.offset++
+	}
+	f.stream = nil
+}
+
+// releaseStream lets the held writes of the master through.
+func (f *fakeNode) releaseStream() {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	f.isStreamHeld = false
+	f.drain()
+}
+
+func (f *fakeNode) Lock(key string) sessions.Lock {
+	return &fakeLock{node: f, key: key + ".lock"}
+}
+
+func (f *fakeNode) State(context.Context) (nodeState, error) {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	if f.isDown {
+		return nodeState{}, errDown
+	}
+	if f.master != nil && !f.isLinkUp && f.copyErrs > 0 {
+		f.copyErrs--
+		return nodeState{}, errDown
+	}
+
+	if f.master != nil && !f.isLinkUp {
+		f.pollsLeft--
+		if f.pollsLeft <= 0 && !f.master.isDown {
+			// The full copy: the data of the master replace those of the replica.
+			f.data = map[string]fakeValue{}
+			for key, stored := range f.master.data {
+				f.data[key] = stored
+			}
+			f.offset = f.master.offset
+			f.isLinkUp = true
+		}
+	}
+
+	// The mark a copy has brought from its master is not the mark of the copy.
+	isSeeded := string(f.data[seededKey].value) == f.runID
+
+	return nodeState{
+		runID:     f.runID,
+		isReplica: f.master != nil,
+		isLinkUp:  f.isLinkUp,
+		isSyncing: f.master != nil && !f.isLinkUp,
+		offset:    f.offset,
+		isSeeded:  isSeeded,
+	}, nil
+}
+
+func (f *fakeNode) ReplicaOf(_ context.Context, host, port string) error {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	if f.isDown {
+		return errDown
+	}
+	master, ok := f.net.nodes[net.JoinHostPort(host, port)]
+	if !ok {
+		return fmt.Errorf("no redis at %s:%s", host, port)
+	}
+
+	f.commands = append(f.commands, "REPLICAOF "+master.addr)
+	// Redis does nothing when it is told to copy the master it copies already.
+	if f.master != master {
+		f.master, f.isLinkUp, f.pollsLeft, f.stream = master, false, f.pollsToCopy, nil
+	}
+
+	return nil
+}
+
+func (f *fakeNode) SetReplicaWritable(_ context.Context, isWritable bool) error {
+	f.net.mu.Lock()
+	hook := f.onWritable
+	f.net.mu.Unlock()
+
+	if isWritable && hook != nil {
+		hook()
+	}
+
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	if f.isDown {
+		return errDown
+	}
+	f.commands = append(f.commands, fmt.Sprintf("WRITABLE %t", isWritable))
+	f.isWritable = isWritable
+
+	return nil
+}
+
+func (f *fakeNode) Promote(context.Context) error {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	if f.isDown {
+		return errDown
+	}
+	if f.promoteErrs > 0 {
+		f.promoteErrs--
+		return errDown
+	}
+	f.commands = append(f.commands, "REPLICAOF NO ONE")
+	// What the master had sent and the replica had not applied is lost with the link.
+	f.master, f.isLinkUp, f.stream = nil, false, nil
+
+	return nil
+}
+
+func (f *fakeNode) MarkSeeded(_ context.Context, runID string) error {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	if err := f.checkWrite(); err != nil {
+		return err
+	}
+	f.commands = append(f.commands, "MARK")
+	f.write(fakeWrite{key: seededKey, value: &fakeValue{value: []byte(runID)}})
+
+	return nil
+}
+
+func (f *fakeNode) DropLocks(context.Context) error {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	// A replica that takes no writes refuses the removal, as Redis does.
+	if err := f.checkWrite(); err != nil {
+		return err
+	}
+	f.commands = append(f.commands, "DROP LOCKS")
+	for key := range f.data {
+		if strings.HasSuffix(key, ".lock") {
+			delete(f.data, key)
+		}
+	}
+
+	return nil
+}
+
+func (f *fakeNode) Close() error {
+	return nil
+}
+
+// setDown stops or starts the Redis without touching its data: a network that does not let the
+// requests through.
+func (f *fakeNode) setDown(isDown bool) {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	f.isDown = isDown
+}
+
+// restart is a restart of the Redis: it comes back empty, a master, under a new run ID.
+func (f *fakeNode) restart() {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	f.net.runs++
+	f.data = map[string]fakeValue{}
+	f.runID = fmt.Sprintf("run-%d", f.net.runs)
+	f.master, f.isLinkUp, f.isWritable, f.stream, f.offset = nil, false, false, nil, 0
+	f.isDown = false
+}
+
+// has reports whether the Redis holds key, and its value.
+func (f *fakeNode) has(key string) (string, bool) {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	stored, ok := f.data[key]
+
+	return string(stored.value), ok
+}
+
+// put stores a key in the Redis behind the back of every store.
+// seeded reports whether the Redis carries its own mark.
+func (f *fakeNode) seeded() bool {
+	state, err := f.State(context.Background())
+
+	return err == nil && state.isSeeded
+}
+
+func (f *fakeNode) put(key, value string) {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	f.data[key] = fakeValue{value: []byte(value)}
+}
+
+func (f *fakeNode) role() (isReplica, isWritable bool) {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	return f.master != nil, f.isWritable
+}
+
+func (f *fakeNode) sent() []string {
+	f.net.mu.Lock()
+	defer f.net.mu.Unlock()
+
+	return append([]string{}, f.commands...)
+}
+
+// fakeLock is a lock in a fake Redis.
+type fakeLock struct {
+	node *fakeNode
+	key  string
+}
+
+func (l *fakeLock) holder() (fakeValue, bool) {
+	stored, ok := l.node.data[l.key]
+	if !ok || !stored.expiresAt.After(time.Now()) {
+		return fakeValue{}, false
+	}
+
+	return stored, true
+}
+
+func (l *fakeLock) Obtain(_ context.Context, expiration time.Duration) error {
+	l.node.net.mu.Lock()
+	defer l.node.net.mu.Unlock()
+
+	if err := l.node.checkWrite(); err != nil {
+		return err
+	}
+	if _, isHeld := l.holder(); isHeld {
+		return sessions.ErrLockNotObtained
+	}
+	l.node.write(fakeWrite{key: l.key, value: &fakeValue{expiresAt: time.Now().Add(expiration), owner: l}})
+
+	return nil
+}
+
+func (l *fakeLock) Peek(context.Context) (bool, error) {
+	l.node.net.mu.Lock()
+	defer l.node.net.mu.Unlock()
+
+	if l.node.isDown {
+		return false, errDown
+	}
+	_, isHeld := l.holder()
+
+	return isHeld, nil
+}
+
+func (l *fakeLock) Refresh(_ context.Context, expiration time.Duration) error {
+	l.node.net.mu.Lock()
+	defer l.node.net.mu.Unlock()
+
+	if err := l.node.checkWrite(); err != nil {
+		return err
+	}
+	if held, isHeld := l.holder(); !isHeld || held.owner != l {
+		return sessions.ErrNotLocked
+	}
+	l.node.write(fakeWrite{key: l.key, value: &fakeValue{expiresAt: time.Now().Add(expiration), owner: l}})
+
+	return nil
+}
+
+func (l *fakeLock) Release(context.Context) error {
+	l.node.net.mu.Lock()
+	defer l.node.net.mu.Unlock()
+
+	if err := l.node.checkWrite(); err != nil {
+		return err
+	}
+	if held, isHeld := l.holder(); !isHeld || held.owner != l {
+		return sessions.ErrNotLocked
+	}
+	l.node.write(fakeWrite{key: l.key})
+
+	return nil
+}
+
+// testProbeInterval is the probe interval of a store under test.
+const testProbeInterval = 20 * time.Millisecond
+
+// newTestStore starts the store of the replica at self over the Redis of net. The store sees the
+// replicas of visible; none: every Redis of net. It waits until the store is ready.
+func newTestStore(t *testing.T, fakes *fakeNet, self string, visible ...string) *Store {
+	t.Helper()
+
+	store := startTestStore(t, fakes, self, time.Second, visible...)
+	require.Eventually(t, func() bool { return store.VerifyConnection(t.Context()) == nil }, 5*time.Second, time.Millisecond)
+
+	return store
+}
+
+// startTestStore starts a store and does not wait for it to be ready.
+func startTestStore(t *testing.T, fakes *fakeNet, self string, seedTimeout time.Duration, visible ...string) *Store {
+	t.Helper()
+
+	fakes.mu.Lock()
+	own := fakes.nodes[self]
+	memoryBytes := fakes.memoryBytes
+	fakes.mu.Unlock()
+	if memoryBytes == 0 {
+		memoryBytes = 1 << 20
+	}
+	mem, err := memory.NewStore(options.MemoryStoreOptions{MaxBytes: memoryBytes})
+	require.NoError(t, err)
+
+	require.NotNil(t, own, "no redis at %s", self)
+
+	store := newStore(config{
+		self: self,
+		own:  own,
+		dial: func(addr string) node {
+			fakes.mu.Lock()
+			defer fakes.mu.Unlock()
+
+			return fakes.nodes[addr]
+		},
+		resolve: func(context.Context) ([]string, error) {
+			fakes.mu.Lock()
+			defer fakes.mu.Unlock()
+
+			if fakes.resolveErr != nil {
+				return nil, fakes.resolveErr
+			}
+			if len(visible) > 0 {
+				return visible, nil
+			}
+
+			addrs := make([]string, 0, len(fakes.nodes))
+			for addr := range fakes.nodes {
+				addrs = append(addrs, addr)
+			}
+
+			return addrs, nil
+		},
+		memory:        mem,
+		timeout:       time.Millisecond,
+		seedTimeout:   seedTimeout,
+		probeInterval: testProbeInterval,
+	})
+	t.Cleanup(func() { require.NoError(t, store.Close()) })
+
+	return store
+}
+
+// The helpers below read the metrics of a store.
+
+func loads(s *Store, step string) float64 {
+	return testutil.ToFloat64(s.metrics.loads.WithLabelValues(step))
+}
+
+func peerWrites(s *Store, operation, result string) float64 {
+	return testutil.ToFloat64(s.metrics.peerWrites.WithLabelValues(operation, result))
+}
+
+func seeds(t *testing.T, s *Store, outcome string) uint64 {
+	t.Helper()
+
+	observer, err := s.metrics.seedDuration.GetMetricWithLabelValues(outcome)
+	require.NoError(t, err)
+	histogram, ok := observer.(prometheus.Histogram)
+	require.True(t, ok)
+
+	return histogramCount(t, histogram)
+}
+
+func mode(s *Store) string {
+	s.stateMu.Lock()
+	defer s.stateMu.Unlock()
+
+	return s.mode
+}
+
+func home(s *Store) string {
+	s.stateMu.Lock()
+	defer s.stateMu.Unlock()
+
+	return s.home
+}
+
+func histogramCount(t *testing.T, histogram prometheus.Histogram) uint64 {
+	t.Helper()
+
+	var metric dto.Metric
+	require.NoError(t, histogram.Write(&metric))
+
+	return metric.GetHistogram().GetSampleCount()
+}
diff --git a/pkg/sessions/redispeers/integration_test.go b/pkg/sessions/redispeers/integration_test.go
new file mode 100644
index 00000000..398b0152
--- /dev/null
+++ b/pkg/sessions/redispeers/integration_test.go
@@ -0,0 +1,356 @@
+//go:build integration
+
+package redispeers
+
+import (
+	"context"
+	"crypto/rand"
+	"fmt"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/memory"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// The tests of this file run against two real Redis that reach each other by the addresses of
+// REDIS_PEERS_TEST_ADDRS ("host:port,host:port") with the password of REDIS_PEERS_TEST_PASSWORD:
+//
+//	go test -tags=integration -run Integration ./pkg/sessions/redispeers/
+//
+// Both Redis are started as the Redis of a replica is: without a disk, with requirepass and
+// masterauth, --repl-diskless-sync-delay 0 and --repl-diskless-load swapdb. The tests empty both.
+
+const integrationTimeout = options.DefaultRedisPeersTimeout
+
+// sessionBytes is the size of a session of the tests.
+const sessionBytes = 2400
+
+// randomSessions returns the values of n sessions that do not compress, as encrypted sessions do
+// not: a copy of them takes Redis as long to load as that of real ones, so the tests meet a Redis
+// that is loading. Values of one repeated byte load in no time.
+func randomSessions(t *testing.T, n int) func(i int) []byte {
+	t.Helper()
+
+	buf := make([]byte, 1<<20)
+	_, err := rand.Read(buf)
+	require.NoError(t, err)
+
+	return func(i int) []byte {
+		offset := (i * 7919) % (len(buf) - sessionBytes)
+		return buf[offset : offset+sessionBytes]
+	}
+}
+
+// fill writes n sessions to the Redis under prefix.
+func fill(t *testing.T, r *realRedis, prefix string, n int, value func(int) []byte) {
+	t.Helper()
+
+	const batch = 2000
+	for start := 0; start < n; start += batch {
+		pipe := r.raw.Pipeline()
+		for i := start; i < min(start+batch, n); i++ {
+			pipe.Set(t.Context(), fmt.Sprintf("%s-%d", prefix, i), value(i), time.Hour)
+		}
+		_, err := pipe.Exec(t.Context())
+		require.NoError(t, err)
+	}
+}
+
+type realRedis struct {
+	addr string
+	raw  *redis.Client
+	opts *redis.Options
+}
+
+// realPair returns the two Redis, emptied and detached from each other.
+func realPair(t *testing.T) (*realRedis, *realRedis) {
+	t.Helper()
+
+	addrs := strings.Split(os.Getenv("REDIS_PEERS_TEST_ADDRS"), ",")
+	if len(addrs) != 2 {
+		t.Skip("REDIS_PEERS_TEST_ADDRS does not name two redis")
+	}
+
+	pair := make([]*realRedis, 0, len(addrs))
+	for _, addr := range addrs {
+		opts := &redis.Options{Addr: addr, Password: os.Getenv("REDIS_PEERS_TEST_PASSWORD")}
+		raw := redis.NewClient(opts)
+		t.Cleanup(func() { require.NoError(t, raw.Close()) })
+
+		require.NoError(t, raw.Do(t.Context(), "REPLICAOF", "NO", "ONE").Err())
+		require.NoError(t, raw.ConfigSet(t.Context(), "replica-read-only", "yes").Err())
+		require.NoError(t, raw.FlushAll(t.Context()).Err())
+		pair = append(pair, &realRedis{addr: addr, raw: raw, opts: opts})
+	}
+
+	return pair[0], pair[1]
+}
+
+// startRealStore starts the store of the replica whose Redis is own, with other as its neighbour.
+func startRealStore(t *testing.T, own, other *realRedis) *Store {
+	t.Helper()
+
+	mem, err := memory.NewStore(options.MemoryStoreOptions{MaxBytes: 64 << 20})
+	require.NoError(t, err)
+
+	store := newStore(config{
+		self:          own.addr,
+		own:           newRedisNode(own.opts, own.addr, integrationTimeout),
+		dial:          func(addr string) node { return newRedisNode(own.opts, addr, integrationTimeout) },
+		resolve:       func(context.Context) ([]string, error) { return []string{own.addr, other.addr}, nil },
+		memory:        mem,
+		timeout:       integrationTimeout,
+		seedTimeout:   30 * time.Second,
+		probeInterval: 200 * time.Millisecond,
+	})
+	t.Cleanup(func() { require.NoError(t, store.Close()) })
+
+	return store
+}
+
+func waitReady(t *testing.T, store *Store) time.Duration {
+	t.Helper()
+
+	started := time.Now()
+	require.Eventually(t, func() bool { return store.VerifyConnection(t.Context()) == nil }, time.Minute, 5*time.Millisecond)
+
+	return time.Since(started)
+}
+
+func role(t *testing.T, r *realRedis) string {
+	t.Helper()
+
+	info, err := r.raw.Info(t.Context(), "replication").Result()
+	require.NoError(t, err)
+	for _, line := range strings.Split(info, "\r\n") {
+		if value, ok := strings.CutPrefix(line, "role:"); ok {
+			return value
+		}
+	}
+
+	return ""
+}
+
+func TestIntegration_Seed(t *testing.T) {
+	a, b := realPair(t)
+
+	// About 100 MB: the copy takes long enough to be asked about while Redis loads it.
+	const sessionsAtA = 40000
+	value := randomSessions(t, sessionsAtA)
+	fill(t, a, "ticket", sessionsAtA, value)
+
+	storeA := startRealStore(t, a, b)
+	waitReady(t, storeA)
+	held := storeA.Lock("ticket-0")
+	require.NoError(t, held.Obtain(t.Context(), time.Minute))
+
+	storeB := startRealStore(t, b, a)
+	took := waitReady(t, storeB)
+	t.Logf("the replica was ready %s after its start; %d sessions of %d bytes copied", took, sessionsAtA, sessionBytes)
+
+	assert.EqualValues(t, 1, seeds(t, storeB, seedCopied))
+	assert.Zero(t, seeds(t, storeB, seedError)+seeds(t, storeB, seedTimeout), "a redis that loads the copy is waited for, not given up on")
+	assert.Equal(t, "master", role(t, b), "the redis of B is detached")
+	assert.Equal(t, "master", role(t, a))
+
+	readOnly, err := b.raw.ConfigGet(t.Context(), "replica-read-only").Result()
+	require.NoError(t, err)
+	assert.Equal(t, "yes", readOnly["replica-read-only"])
+
+	// The sessions and the mark, without the lock of A.
+	size, err := b.raw.DBSize(t.Context()).Result()
+	require.NoError(t, err)
+	assert.EqualValues(t, sessionsAtA+1, size)
+	ttl, err := b.raw.TTL(t.Context(), "ticket-1").Result()
+	require.NoError(t, err)
+	assert.InDelta(t, time.Hour, ttl, float64(time.Minute), "a copied session keeps its expiry")
+
+	got, err := storeB.Load(t.Context(), "ticket-42")
+	require.NoError(t, err)
+	assert.Equal(t, value(42), got)
+	assert.InDelta(t, 1, loads(storeB, stepOwn), 0)
+
+	// The lock of A is still held, and B sees it there: A is the home of the locks for both.
+	require.Eventually(t, func() bool { return home(storeA) == home(storeB) }, 5*time.Second, 10*time.Millisecond)
+	t.Logf("the home of the locks: %s", home(storeB))
+	if home(storeB) == a.addr {
+		require.ErrorIs(t, storeB.Lock("ticket-0").Obtain(t.Context(), time.Minute), sessions.ErrLockNotObtained)
+	}
+	require.NoError(t, held.Release(t.Context()))
+
+	// From now on a save of either replica reaches both redis.
+	require.NoError(t, storeB.Save(t.Context(), "from-b", []byte("session"), time.Hour))
+	require.NoError(t, storeA.Save(t.Context(), "from-a", []byte("session"), time.Hour))
+	for _, r := range []*realRedis{a, b} {
+		for _, key := range []string{"from-a", "from-b"} {
+			require.NoError(t, r.raw.Get(t.Context(), key).Err(), "%s at %s", key, r.addr)
+		}
+	}
+}
+
+// Every session A saves while B is being filled is in the Redis of B once B is ready.
+func TestIntegration_SeedKeepsTheWritesOfTheNeighbour(t *testing.T) {
+	a, b := realPair(t)
+
+	const sessionsAtA = 40000
+	fill(t, a, "old", sessionsAtA, randomSessions(t, sessionsAtA))
+	value := randomSessions(t, 1)(0)
+
+	storeA := startRealStore(t, a, b)
+	waitReady(t, storeA)
+
+	var (
+		wg    sync.WaitGroup
+		saved atomic.Int64
+		stop  = make(chan struct{})
+	)
+	wg.Go(func() {
+		for i := 0; ; i++ {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			if err := storeA.Save(context.Background(), fmt.Sprintf("new-%d", i), value, time.Hour); err != nil {
+				t.Errorf("save %d: %v", i, err)
+				return
+			}
+			saved.Store(int64(i) + 1)
+		}
+	})
+
+	// A has seen its neighbour before B starts to fill.
+	require.Eventually(t, func() bool { return len(storeA.peerSnapshot()) == 1 }, 5*time.Second, 5*time.Millisecond)
+	before := saved.Load()
+
+	storeB := startRealStore(t, b, a)
+	took := waitReady(t, storeB)
+	during := saved.Load() - before
+
+	// A few more saves after B is ready, then stop.
+	time.Sleep(200 * time.Millisecond)
+	close(stop)
+	wg.Wait()
+
+	total := saved.Load()
+	t.Logf("B was ready after %s; A saved %d sessions while B was being filled, %d in all", took, during, total)
+	t.Logf("writes of A to the redis of B: ok %.0f, readonly %.0f, timeout %.0f, error %.0f",
+		peerWrites(storeA, opSave, resultOK), peerWrites(storeA, opSave, resultReadOnly),
+		peerWrites(storeA, opSave, resultTimeout), peerWrites(storeA, opSave, resultError))
+
+	require.EqualValues(t, 1, seeds(t, storeB, seedCopied))
+	require.Zero(t, seeds(t, storeB, seedError)+seeds(t, storeB, seedTimeout))
+	require.Positive(t, during, "the test saved nothing while B was being filled")
+
+	missing := 0
+	for i := range total {
+		exists, err := b.raw.Exists(t.Context(), fmt.Sprintf("new-%d", i)).Result()
+		require.NoError(t, err)
+		if exists == 0 {
+			missing++
+		}
+	}
+	assert.Zero(t, missing, "sessions A saved that the redis of B does not have")
+}
+
+func TestIntegration_SeedOfTwoEmptyReplicas(t *testing.T) {
+	a, b := realPair(t)
+
+	storeA, storeB := startRealStore(t, a, b), startRealStore(t, b, a)
+	tookA, tookB := waitReady(t, storeA), waitReady(t, storeB)
+	t.Logf("ready after %s and %s", tookA, tookB)
+
+	assert.Less(t, tookA+tookB, 5*time.Second)
+	for _, r := range []*realRedis{a, b} {
+		assert.Equal(t, "master", role(t, r))
+		require.NoError(t, r.raw.Get(t.Context(), seededKey).Err(), "the mark at %s", r.addr)
+	}
+}
+
+// A Redis that lost its data while the proxy lives is filled again; the replica keeps answering
+// from the Redis of its neighbour meanwhile.
+func TestIntegration_OwnRedisLosesItsData(t *testing.T) {
+	a, b := realPair(t)
+
+	storeA, storeB := startRealStore(t, a, b), startRealStore(t, b, a)
+	waitReady(t, storeA)
+	waitReady(t, storeB)
+	for i := range 100 {
+		require.NoError(t, storeA.Save(t.Context(), fmt.Sprintf("ticket-%d", i), []byte("session"), time.Hour))
+	}
+
+	require.NoError(t, b.raw.FlushAll(t.Context()).Err())
+
+	for i := range 100 {
+		_, err := storeB.Load(t.Context(), fmt.Sprintf("ticket-%d", i))
+		require.NoError(t, err, "ticket-%d is found whatever the redis of B is doing", i)
+	}
+	require.Eventually(t, func() bool { return seeds(t, storeB, seedCopied) == 1 }, 30*time.Second, 10*time.Millisecond)
+	require.Eventually(t, func() bool { return mode(storeB) == modeRedis }, 5*time.Second, 10*time.Millisecond)
+
+	size, err := b.raw.DBSize(t.Context()).Result()
+	require.NoError(t, err)
+	assert.EqualValues(t, 101, size, "the sessions and the mark")
+	assert.Zero(t, loads(storeB, stepCookie))
+}
+
+func TestIntegration_State(t *testing.T) {
+	a, b := realPair(t)
+	nodeA := newRedisNode(a.opts, a.addr, integrationTimeout)
+	nodeB := newRedisNode(b.opts, b.addr, integrationTimeout)
+	t.Cleanup(func() {
+		require.NoError(t, nodeA.Close())
+		require.NoError(t, nodeB.Close())
+	})
+
+	state, err := nodeA.State(t.Context())
+	require.NoError(t, err)
+	assert.NotEmpty(t, state.runID)
+	assert.False(t, state.isReplica)
+	assert.False(t, state.isSeeded)
+
+	require.NoError(t, nodeA.MarkSeeded(t.Context(), state.runID))
+	state, err = nodeA.State(t.Context())
+	require.NoError(t, err)
+	assert.True(t, state.isSeeded)
+	host, port, _ := strings.Cut(a.addr, ":")
+	require.NoError(t, nodeB.ReplicaOf(t.Context(), host, port))
+	require.Eventually(t, func() bool {
+		state, err := nodeB.State(t.Context())
+		return err == nil && state.isReplica && state.isLinkUp && !state.isSyncing
+	}, 30*time.Second, 10*time.Millisecond)
+	state, err = nodeB.State(t.Context())
+	require.NoError(t, err)
+	assert.False(t, state.isSeeded, "the mark the copy has brought is that of its master")
+
+	require.ErrorIs(t, nodeB.Set(t.Context(), "ticket", []byte("session"), time.Hour), errReadOnly)
+	require.ErrorIs(t, nodeB.Del(t.Context(), "ticket"), errReadOnly)
+
+	require.NoError(t, nodeB.SetReplicaWritable(t.Context(), true))
+	require.NoError(t, nodeB.Set(t.Context(), "ticket", []byte("session"), time.Hour))
+	offsetBefore, err := nodeB.State(t.Context())
+	require.NoError(t, err)
+
+	// A write the replica takes itself does not move the offset it compares with its master.
+	require.NoError(t, nodeB.Set(t.Context(), "ticket-2", []byte("session"), time.Hour))
+	offsetAfter, err := nodeB.State(t.Context())
+	require.NoError(t, err)
+	assert.Equal(t, offsetBefore.offset, offsetAfter.offset)
+
+	require.NoError(t, nodeB.Promote(t.Context()))
+	state, err = nodeB.State(t.Context())
+	require.NoError(t, err)
+	assert.False(t, state.isReplica)
+
+	_, err = nodeB.Get(t.Context(), "ticket")
+	require.NoError(t, err, "a detached redis keeps what it had")
+}
diff --git a/pkg/sessions/redispeers/lock.go b/pkg/sessions/redispeers/lock.go
new file mode 100644
index 00000000..539847ec
--- /dev/null
+++ b/pkg/sessions/redispeers/lock.go
@@ -0,0 +1,168 @@
+package redispeers
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/logger"
+)
+
+// errNoLockHome is the answer of Obtain when no Redis can hold the lock and the replica has
+// neighbours: the memory of the process would let a neighbour refresh the same session at once.
+var errNoLockHome = errors.New("no redis answers to hold the refresh lock")
+
+// lock is the refresh lock of a session. It is taken in every Redis that answers and is filled, in
+// the order of their addresses, and refreshed and released where it was taken. A lock belongs to one
+// request, as the lock of the Redis store does, so it is not safe for use by several goroutines.
+//
+// One Redis would do while every replica sees the same ones. A Redis that stalls is left by each
+// replica on its own, after its own requests have failed, so for a while the replicas see different
+// Redis: with the lock in the lowest of them only, each one took it in another Redis, and both
+// refreshed the same refresh token, which dex refuses the second time. Taken in all of them, the
+// locks of two replicas meet in every Redis both of them see. They miss each other only when each
+// replica has left the Redis the other one still uses and nothing else, a network split between the
+// pods.
+//
+// A Redis that fails the lock fails the request, which is answered 503: the memory of the process
+// stands in only for a replica without neighbours.
+type lock struct {
+	store *Store
+	key   string
+
+	held []sessions.Lock
+}
+
+var _ sessions.Lock = (*lock)(nil)
+
+func stepOf(s *Store, ep *endpoint) string {
+	switch ep {
+	case nil:
+		return stepMemory
+	case s.own:
+		return stepOwn
+	default:
+		return stepPeer
+	}
+}
+
+// Obtain takes the lock in every Redis that answers and is filled. A lock that one of them holds is
+// ErrLockNotObtained; any other failure is returned as is, and the request is answered 503. Either
+// way the locks taken so far are released.
+func (l *lock) Obtain(ctx context.Context, expiration time.Duration) error {
+	nodes, isAlone := l.store.lockNodes()
+	if len(nodes) == 0 {
+		if !isAlone {
+			l.store.metrics.locks.WithLabelValues(homeMemory, lockError).Inc()
+			return errNoLockHome
+		}
+		inner := l.store.memory.Lock(l.key)
+		if err := inner.Obtain(ctx, expiration); err != nil {
+			l.count(nil, err)
+			return err
+		}
+		l.count(nil, nil)
+		l.held = []sessions.Lock{inner}
+
+		return nil
+	}
+
+	held := make([]sessions.Lock, 0, len(nodes))
+	for _, ep := range nodes {
+		inner := ep.node.Lock(l.key)
+		err := inner.Obtain(ctx, expiration)
+		l.count(ep, err)
+		if err != nil {
+			if !errors.Is(err, sessions.ErrLockNotObtained) {
+				l.store.observe(ctx, ep, err)
+			}
+			l.releaseAll(ctx, held)
+			return err
+		}
+		held = append(held, inner)
+	}
+	l.held = held
+
+	return nil
+}
+
+func (l *lock) count(ep *endpoint, err error) {
+	result := lockObtained
+	switch {
+	case errors.Is(err, sessions.ErrLockNotObtained):
+		result = lockBusy
+	case err != nil:
+		result = lockError
+	}
+	l.store.metrics.locks.WithLabelValues(stepOf(l.store, ep), result).Inc()
+}
+
+// releaseAll gives back the locks a failed Obtain took. A client that has gone away still releases
+// them, or the session would wait for them to expire.
+func (l *lock) releaseAll(ctx context.Context, held []sessions.Lock) {
+	ctx = context.WithoutCancel(ctx)
+	for _, h := range held {
+		// The lock expires anyway, and the request fails with the reason it could not be taken.
+		if err := h.Release(ctx); err != nil {
+			logger.Errorf("redis-peers: releasing a refresh lock that was taken in part: %v", err)
+		}
+	}
+}
+
+// Peek reports whether the lock is taken: the one this request holds or, before that, the one in
+// any Redis that answers and is filled.
+func (l *lock) Peek(ctx context.Context) (bool, error) {
+	if len(l.held) > 0 {
+		return l.held[0].Peek(ctx)
+	}
+
+	nodes, _ := l.store.lockNodes()
+	if len(nodes) == 0 {
+		return l.store.memory.Lock(l.key).Peek(ctx)
+	}
+	var errs []error
+	for _, ep := range nodes {
+		isHeld, err := ep.node.Lock(l.key).Peek(ctx)
+		if err != nil {
+			l.store.observe(ctx, ep, err)
+			errs = append(errs, err)
+			continue
+		}
+		if isHeld {
+			return true, nil
+		}
+	}
+
+	return false, errors.Join(errs...)
+}
+
+// Refresh extends the lock in every Redis it was taken in.
+func (l *lock) Refresh(ctx context.Context, expiration time.Duration) error {
+	if len(l.held) == 0 {
+		return sessions.ErrNotLocked
+	}
+
+	errs := make([]error, 0, len(l.held))
+	for _, h := range l.held {
+		errs = append(errs, h.Refresh(ctx, expiration))
+	}
+
+	return errors.Join(errs...)
+}
+
+// Release gives the lock back in every Redis it was taken in.
+func (l *lock) Release(ctx context.Context) error {
+	if len(l.held) == 0 {
+		return sessions.ErrNotLocked
+	}
+	held := l.held
+	l.held = nil
+
+	errs := make([]error, 0, len(held))
+	for _, h := range held {
+		errs = append(errs, h.Release(ctx))
+	}
+
+	return errors.Join(errs...)
+}
diff --git a/pkg/sessions/redispeers/lock_test.go b/pkg/sessions/redispeers/lock_test.go
new file mode 100644
index 00000000..31f3dee7
--- /dev/null
+++ b/pkg/sessions/redispeers/lock_test.go
@@ -0,0 +1,204 @@
+package redispeers
+
+import (
+	"testing"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/prometheus/client_golang/prometheus/testutil"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func locks(s *Store, home, result string) float64 {
+	return testutil.ToFloat64(s.metrics.locks.WithLabelValues(home, result))
+}
+
+// twoReplicas starts two replicas that have seen each other.
+func twoReplicas(t *testing.T) (*fakeNet, *Store, *Store) {
+	t.Helper()
+
+	fakes := newFakeNet()
+	fakes.add(addrA)
+	fakes.add(addrB)
+	storeA := newTestStore(t, fakes, addrA)
+	storeB := newTestStore(t, fakes, addrB)
+	eventually(t, func() bool { return home(storeA) == addrA && home(storeB) == addrA }, "both name the same home")
+
+	return fakes, storeA, storeB
+}
+
+func TestLock(t *testing.T) {
+	t.Parallel()
+
+	t.Run("one refresh for both replicas", func(t *testing.T) {
+		t.Parallel()
+		_, storeA, storeB := twoReplicas(t)
+		lockA, lockB := storeA.Lock("ticket"), storeB.Lock("ticket")
+
+		isHeld, err := lockB.Peek(t.Context())
+		require.NoError(t, err)
+		assert.False(t, isHeld)
+
+		require.NoError(t, lockB.Obtain(t.Context(), time.Minute))
+		assert.InDelta(t, 1, locks(storeB, stepPeer, lockObtained), 0, "B takes the lock in the redis of A")
+
+		require.ErrorIs(t, lockA.Obtain(t.Context(), time.Minute), sessions.ErrLockNotObtained)
+		assert.InDelta(t, 1, locks(storeA, stepOwn, lockBusy), 0)
+		isHeld, err = lockA.Peek(t.Context())
+		require.NoError(t, err)
+		assert.True(t, isHeld, "A sees the lock of B")
+
+		require.NoError(t, lockB.Refresh(t.Context(), time.Minute))
+		require.NoError(t, lockB.Release(t.Context()))
+		require.NoError(t, lockA.Obtain(t.Context(), time.Minute))
+		assert.InDelta(t, 1, locks(storeA, stepOwn, lockObtained), 0)
+	})
+
+	t.Run("a lock that is not held", func(t *testing.T) {
+		t.Parallel()
+		_, storeA, _ := twoReplicas(t)
+		lock := storeA.Lock("ticket")
+
+		require.ErrorIs(t, lock.Refresh(t.Context(), time.Minute), sessions.ErrNotLocked)
+		require.ErrorIs(t, lock.Release(t.Context()), sessions.ErrNotLocked)
+
+		require.NoError(t, lock.Obtain(t.Context(), time.Minute))
+		require.NoError(t, lock.Release(t.Context()))
+		require.ErrorIs(t, lock.Release(t.Context()), sessions.ErrNotLocked)
+	})
+
+	t.Run("the redis of the replica holds the locks as soon as it carries the mark", func(t *testing.T) {
+		t.Parallel()
+		_, storeA, _ := twoReplicas(t)
+		// Without the loop of the store, which would put the redis back into use.
+		require.NoError(t, storeA.Close())
+
+		// The requests do not read it yet, as while the memory gives it what it has kept.
+		storeA.own.set(false, true, storeA.own.id())
+		assert.Same(t, storeA.own, storeA.lockHome(), "the neighbour names it by its mark too")
+
+		storeA.own.set(false, false, storeA.own.id())
+		assert.NotSame(t, storeA.own, storeA.lockHome())
+	})
+
+	t.Run("a lock is released where it was taken after the home has moved", func(t *testing.T) {
+		t.Parallel()
+		fakes, storeA, storeB := twoReplicas(t)
+		lock := storeB.Lock("ticket")
+		require.NoError(t, lock.Obtain(t.Context(), time.Minute))
+
+		// The redis of A is gone for B: the home of B moves to its own redis.
+		fakes.mu.Lock()
+		a := fakes.nodes[addrA]
+		fakes.mu.Unlock()
+		a.setDown(true)
+		eventually(t, func() bool { return home(storeB) == addrB }, "the home of B has moved")
+		a.setDown(false)
+
+		require.NoError(t, lock.Release(t.Context()), "the lock is released in the redis of A")
+		isHeld, err := storeA.own.node.Lock("ticket").Peek(t.Context())
+		require.NoError(t, err)
+		assert.False(t, isHeld)
+	})
+
+	t.Run("a filled redis that does not answer fails the lock instead of the memory", func(t *testing.T) {
+		t.Parallel()
+		fakes, _, storeB := twoReplicas(t)
+		fakes.mu.Lock()
+		a := fakes.nodes[addrA]
+		fakes.mu.Unlock()
+		a.setDown(true)
+
+		lock := storeB.Lock("ticket")
+		err := lock.Obtain(t.Context(), time.Minute)
+		require.Error(t, err)
+		require.NotErrorIs(t, err, sessions.ErrLockNotObtained, "the request is answered 503, not made to wait")
+		assert.InDelta(t, 1, locks(storeB, stepPeer, lockError), 0)
+		assert.Zero(t, locks(storeB, stepMemory, lockObtained), "the memory of one replica is no lock for two")
+		require.ErrorIs(t, lock.Release(t.Context()), sessions.ErrNotLocked)
+	})
+
+	t.Run("neighbours without a filled redis leave no place for the lock", func(t *testing.T) {
+		t.Parallel()
+		_, storeA, storeB := twoReplicas(t)
+		require.NoError(t, storeA.Close())
+		require.NoError(t, storeB.Close())
+		storeB.own.set(false, false, "")
+		storeB.peerSnapshot()[0].set(false, false, "")
+
+		require.ErrorIs(t, storeB.Lock("ticket").Obtain(t.Context(), time.Minute), errNoLockHome)
+		assert.InDelta(t, 1, locks(storeB, homeMemory, lockError), 0)
+	})
+
+	t.Run("replicas that see different redis do not both take the lock", func(t *testing.T) {
+		t.Parallel()
+		_, storeA, storeB := twoReplicas(t)
+		// Without the loops of the stores, which would put the redis back into use.
+		require.NoError(t, storeA.Close())
+		require.NoError(t, storeB.Close())
+		// A has left its own redis after a stall that B did not see: the lowest filled redis is
+		// the redis of B for A and the redis of A for B.
+		storeA.own.set(false, false, storeA.own.id())
+		require.Equal(t, addrB, storeA.lockHome().addr)
+		require.Equal(t, addrA, storeB.lockHome().addr)
+
+		lockA, lockB := storeA.Lock("ticket"), storeB.Lock("ticket")
+		require.NoError(t, lockA.Obtain(t.Context(), time.Minute))
+		require.ErrorIs(t, lockB.Obtain(t.Context(), time.Minute), sessions.ErrLockNotObtained,
+			"B meets the lock of A in the redis of B")
+
+		require.NoError(t, lockA.Release(t.Context()))
+		require.NoError(t, lockB.Obtain(t.Context(), time.Minute))
+		require.ErrorIs(t, lockA.Obtain(t.Context(), time.Minute), sessions.ErrLockNotObtained,
+			"A meets the lock of B in the redis of B")
+	})
+
+	t.Run("a lock taken in part is given back", func(t *testing.T) {
+		t.Parallel()
+		_, storeA, storeB := twoReplicas(t)
+		// Someone holds the lock in the redis of B only.
+		other := storeB.own.node.Lock("ticket")
+		require.NoError(t, other.Obtain(t.Context(), time.Minute))
+
+		require.ErrorIs(t, storeA.Lock("ticket").Obtain(t.Context(), time.Minute), sessions.ErrLockNotObtained)
+		isHeld, err := storeA.own.node.Lock("ticket").Peek(t.Context())
+		require.NoError(t, err)
+		assert.False(t, isHeld, "the lock taken in the redis of A is released")
+	})
+
+	t.Run("without a redis the memory holds the locks", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		a := fakes.add(addrA)
+		store := newTestStore(t, fakes, addrA)
+		a.setDown(true)
+		eventually(t, func() bool { return home(store) == homeMemory }, "no redis is left")
+
+		first, second := store.Lock("ticket"), store.Lock("ticket")
+		isHeld, err := first.Peek(t.Context())
+		require.NoError(t, err)
+		assert.False(t, isHeld)
+
+		require.NoError(t, first.Obtain(t.Context(), time.Minute))
+		require.ErrorIs(t, second.Obtain(t.Context(), time.Minute), sessions.ErrLockNotObtained)
+		assert.InDelta(t, 1, locks(store, stepMemory, lockObtained), 0)
+		assert.InDelta(t, 1, locks(store, stepMemory, lockBusy), 0)
+
+		isHeld, err = second.Peek(t.Context())
+		require.NoError(t, err)
+		assert.True(t, isHeld)
+		require.NoError(t, first.Release(t.Context()))
+	})
+
+	t.Run("a neighbour that is being filled does not hold the locks", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		fakes.add(addrA) // the lower address, but without the mark
+		fakes.add(addrB)
+		store := newTestStore(t, fakes, addrB)
+		eventually(t, func() bool { return len(store.peerSnapshot()) == 1 }, "the neighbour is seen")
+
+		assert.Equal(t, store.own, store.lockHome())
+	})
+}
diff --git a/pkg/sessions/redispeers/metrics.go b/pkg/sessions/redispeers/metrics.go
new file mode 100644
index 00000000..5adae8ac
--- /dev/null
+++ b/pkg/sessions/redispeers/metrics.go
@@ -0,0 +1,113 @@
+package redispeers
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+const (
+	stepOwn    = "own"
+	stepPeer   = "peer"
+	stepMemory = "memory"
+	stepCookie = "cookie"
+	// stepUnavailable: no filled Redis answered, and the request is answered 503.
+	stepUnavailable = "unavailable"
+
+	modeRedis  = "redis"
+	modePeer   = "peer"
+	modeMemory = "memory"
+
+	opSave  = "save"
+	opClear = "clear"
+
+	resultOK       = "ok"
+	resultReadOnly = "readonly"
+	resultTimeout  = "timeout"
+	resultError    = "error"
+
+	seedCopied  = "copied"
+	seedEmpty   = "empty"
+	seedKept    = "kept"
+	seedTimeout = "timeout"
+	seedError   = "error"
+
+	lockObtained = "obtained"
+	lockBusy     = "busy"
+	lockError    = "error"
+
+	homeMemory = "memory"
+)
+
+type metrics struct {
+	loads        *prometheus.CounterVec
+	saves        *prometheus.CounterVec
+	peerWrites   *prometheus.CounterVec
+	moved        prometheus.Counter
+	seedDuration *prometheus.HistogramVec
+	mode         *prometheus.GaugeVec
+	modeSwitches *prometheus.CounterVec
+	lockHome     *prometheus.GaugeVec
+	locks        *prometheus.CounterVec
+	peers        *prometheus.GaugeVec
+}
+
+func newMetrics() *metrics {
+	const prefix = "oauth2_proxy_session_store_redis_peers_"
+	counter := func(name, help string, labels ...string) *prometheus.CounterVec {
+		return prometheus.NewCounterVec(prometheus.CounterOpts{Name: prefix + name, Help: help}, labels)
+	}
+	gauge := func(name, help string, labels ...string) *prometheus.GaugeVec {
+		return prometheus.NewGaugeVec(prometheus.GaugeOpts{Name: prefix + name, Help: help}, labels)
+	}
+
+	return &metrics{
+		loads: counter("loads_total",
+			"Loads of a session by where it was found: the Redis of the replica (own), the Redis of a neighbour (peer), the memory of the process (memory) or nowhere, so that its cookie restores it (cookie).", "step"),
+		saves: counter("saves_total",
+			"Saves of a session by where the replica kept it: its Redis (own) or, while that does not take it, the memory of the process (memory).", "target"),
+		peerWrites: counter("peer_writes_total",
+			"Writes of a session to the Redis of a neighbour by operation (save, clear) and result: ok, readonly (the neighbour is being filled), timeout or error.", "operation", "result"),
+		moved: prometheus.NewCounter(prometheus.CounterOpts{
+			Name: prefix + "moved_total",
+			Help: "Writes moved from the memory of the process to the Redis of the replica once it took them.",
+		}),
+		seedDuration: prometheus.NewHistogramVec(prometheus.HistogramOpts{
+			Name:    prefix + "seed_duration_seconds",
+			Help:    "How long the filling of the Redis of the replica took, by outcome: copied from a neighbour, empty (no neighbour had a filled Redis), kept (it was filled already), timeout or error.",
+			Buckets: []float64{0.05, 0.1, 0.25, 0.5, 1, 2, 5, 10, 15, 30},
+		}, []string{"outcome"}),
+		mode: gauge("mode",
+			"1 for what the replica works on now: its Redis (redis), the Redis of a neighbour (peer) or the memory of the process (memory).", "mode"),
+		modeSwitches: counter("mode_switches_total", "Switches of the replica to a mode: redis, peer or memory.", "to"),
+		// The address is that of a replica or "memory": a handful of values, none of a user.
+		lockHome: gauge("lock_home",
+			"1 for the Redis that holds the refresh locks of the sessions now, by its address; the address \"memory\" is the memory of the process, while no Redis answers.", "address"),
+		locks: counter("locks_total",
+			"Attempts to take the refresh lock of a session by where it lives (own, peer, memory) and result: obtained, busy or error.", "home", "result"),
+		peers: gauge("peers",
+			"Neighbours of the replica by the state of their Redis: seeded (answers and is filled), seeding (answers, is not filled yet) or down.", "state"),
+	}
+}
+
+func (m *metrics) collectors() []prometheus.Collector {
+	return []prometheus.Collector{
+		m.loads, m.saves, m.peerWrites, m.moved, m.seedDuration,
+		m.mode, m.modeSwitches, m.lockHome, m.locks, m.peers,
+	}
+}
+
+// Register exports the metrics of the store, those of its memory included, through registerer. A
+// process has one store; the metrics of a second one registered on the same registerer are not
+// exported.
+func (s *Store) Register(registerer prometheus.Registerer) error {
+	for _, collector := range s.metrics.collectors() {
+		err := registerer.Register(collector)
+		if _, isRegistered := errors.AsType[prometheus.AlreadyRegisteredError](err); err != nil && !isRegistered {
+			return fmt.Errorf("could not register the metrics of the redis-peers session store: %w", err)
+		}
+	}
+
+	return s.memory.Register(registerer)
+}
diff --git a/pkg/sessions/redispeers/node.go b/pkg/sessions/redispeers/node.go
new file mode 100644
index 00000000..8a261648
--- /dev/null
+++ b/pkg/sessions/redispeers/node.go
@@ -0,0 +1,233 @@
+package redispeers
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	redisstore "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/redis"
+	"github.com/redis/go-redis/v9"
+)
+
+// seededKey marks a Redis that holds what the replicas have saved: it was filled from a neighbour,
+// or it started when no neighbour had anything to give. Its value is the run ID of the Redis that
+// was marked: a Redis that has restarted does not have the key, and the key a copy has brought
+// from a neighbour is not the mark of the copy.
+const seededKey = "deckhouse.redis-peers.seeded"
+
+var (
+	// errNotFound is returned for a key no Redis and no memory holds. persistence.Manager turns
+	// any load error into the stub session of patch 002.
+	errNotFound = errors.New("session does not exist")
+
+	// errReadOnly is the refusal of a Redis that is a read-only replica: it is being filled from a
+	// neighbour.
+	errReadOnly = errors.New("redis is a read-only replica")
+)
+
+type nodeState struct {
+	// runID changes when Redis restarts.
+	runID string
+	// isReplica: the Redis copies a neighbour, so it is being filled.
+	isReplica bool
+	// isLinkUp and isSyncing describe the copy of a replica: the full copy is over once the link
+	// is up and no sync is in progress. A Redis that still loads the copy is syncing.
+	isLinkUp  bool
+	isSyncing bool
+	// offset is how far the stream of writes has got: of a master, what it has sent; of a replica,
+	// what it has applied.
+	offset   int64
+	isSeeded bool
+}
+
+type node interface {
+	Get(ctx context.Context, key string) ([]byte, error)
+	// Set stores value under key for ttl; zero or less: no expiry. A read-only replica answers
+	// errReadOnly.
+	Set(ctx context.Context, key string, value []byte, ttl time.Duration) error
+	// Del removes key. A read-only replica answers errReadOnly.
+	Del(ctx context.Context, key string) error
+	Lock(key string) sessions.Lock
+
+	State(ctx context.Context) (nodeState, error)
+
+	// ReplicaOf makes the Redis drop its data and copy the Redis at host and port.
+	ReplicaOf(ctx context.Context, host, port string) error
+	// SetReplicaWritable lets a replica take writes of its own besides those it copies.
+	SetReplicaWritable(ctx context.Context, isWritable bool) error
+	// Promote stops the copying: the Redis keeps what it has and takes writes.
+	Promote(ctx context.Context) error
+	// MarkSeeded marks the Redis, whose run ID is runID, as filled.
+	MarkSeeded(ctx context.Context, runID string) error
+	DropLocks(ctx context.Context) error
+
+	Close() error
+}
+
+type redisNode struct {
+	client *redis.Client
+}
+
+var _ node = (*redisNode)(nil)
+
+// newRedisNode connects to the Redis at addr with the options of the Redis of the replica itself:
+// the Redis of every replica has the same password and database.
+func newRedisNode(base *redis.Options, addr string, timeout time.Duration) *redisNode {
+	opts := *base
+	opts.Addr = addr
+	opts.DialTimeout = timeout
+	opts.ReadTimeout = timeout
+	opts.WriteTimeout = timeout
+	opts.ContextTimeoutEnabled = true
+	// A Redis that does not answer is left for its neighbours and the memory at once: the store
+	// probes it again every second, so retries here would only hold the request.
+	opts.MaxRetries = -1
+	opts.DialerRetries = 1
+
+	client := redis.NewClient(&opts)
+	client.AddHook(timeoutHook(timeout))
+
+	return &redisNode{client: client}
+}
+
+// timeoutHook bounds every command and pipeline of a client, the wait for a connection included.
+// The lock of a session goes through the same client: it may live in the Redis of a neighbour, and
+// a neighbour that does not answer must not hold the request.
+type timeoutHook time.Duration
+
+func (timeoutHook) DialHook(next redis.DialHook) redis.DialHook { return next }
+
+func (h timeoutHook) ProcessHook(next redis.ProcessHook) redis.ProcessHook {
+	return func(ctx context.Context, cmd redis.Cmder) error {
+		ctx, cancel := context.WithTimeout(ctx, time.Duration(h))
+		defer cancel()
+
+		return next(ctx, cmd)
+	}
+}
+
+func (h timeoutHook) ProcessPipelineHook(next redis.ProcessPipelineHook) redis.ProcessPipelineHook {
+	return func(ctx context.Context, cmds []redis.Cmder) error {
+		ctx, cancel := context.WithTimeout(ctx, time.Duration(h))
+		defer cancel()
+
+		return next(ctx, cmds)
+	}
+}
+
+func (n *redisNode) Get(ctx context.Context, key string) ([]byte, error) {
+	raw, err := n.client.Get(ctx, key).Bytes()
+	if errors.Is(err, redis.Nil) {
+		return nil, errNotFound
+	}
+	if err != nil {
+		return nil, fmt.Errorf("error loading the session from redis: %w", err)
+	}
+
+	return raw, nil
+}
+
+func (n *redisNode) Set(ctx context.Context, key string, value []byte, ttl time.Duration) error {
+	return writeError(n.client.Set(ctx, key, value, max(ttl, 0)).Err())
+}
+
+func (n *redisNode) Del(ctx context.Context, key string) error {
+	return writeError(n.client.Del(ctx, key).Err())
+}
+
+func writeError(err error) error {
+	if err != nil && redis.HasErrorPrefix(err, "READONLY") {
+		return fmt.Errorf("%w: %w", errReadOnly, err)
+	}
+
+	return err
+}
+
+func (n *redisNode) Lock(key string) sessions.Lock {
+	return redisstore.NewLock(n.client, key)
+}
+
+func (n *redisNode) State(ctx context.Context) (nodeState, error) {
+	pipe := n.client.Pipeline()
+	info := pipe.InfoMap(ctx, "server", "replication")
+	mark := pipe.Get(ctx, seededKey)
+	// A Redis that loads the copy of a neighbour answers INFO and refuses the rest: it is syncing.
+	_, err := pipe.Exec(ctx)
+	isLoading := err != nil && info.Err() == nil && redis.HasErrorPrefix(err, "LOADING")
+	if err != nil && !isLoading && !errors.Is(err, redis.Nil) {
+		return nodeState{}, fmt.Errorf("error asking redis for its state: %w", err)
+	}
+
+	state := parseState(info.Val()["Server"], info.Val()["Replication"])
+	state.isSyncing = state.isSyncing || isLoading
+	state.isSeeded = state.runID != "" && mark.Val() == state.runID
+
+	return state, nil
+}
+
+func parseState(server, replication map[string]string) nodeState {
+	state := nodeState{
+		runID:     server["run_id"],
+		isReplica: replication["role"] == "slave",
+		isLinkUp:  replication["master_link_status"] == "up",
+		isSyncing: replication["master_sync_in_progress"] == "1",
+	}
+
+	offsetField := "master_repl_offset"
+	if state.isReplica {
+		offsetField = "slave_repl_offset"
+	}
+	// A field that is missing or not a number leaves the offset at zero.
+	if offset, err := strconv.ParseInt(replication[offsetField], 10, 64); err == nil {
+		state.offset = offset
+	}
+
+	return state
+}
+
+func (n *redisNode) ReplicaOf(ctx context.Context, host, port string) error {
+	return n.client.Do(ctx, "REPLICAOF", host, port).Err()
+}
+
+func (n *redisNode) SetReplicaWritable(ctx context.Context, isWritable bool) error {
+	readOnly := "yes"
+	if isWritable {
+		readOnly = "no"
+	}
+
+	return n.client.ConfigSet(ctx, "replica-read-only", readOnly).Err()
+}
+
+func (n *redisNode) Promote(ctx context.Context) error {
+	return n.client.Do(ctx, "REPLICAOF", "NO", "ONE").Err()
+}
+
+func (n *redisNode) MarkSeeded(ctx context.Context, runID string) error {
+	return n.client.Set(ctx, seededKey, runID, 0).Err()
+}
+
+func (n *redisNode) DropLocks(ctx context.Context) error {
+	var keys []string
+	iter := n.client.Scan(ctx, 0, "*."+redisstore.LockSuffix, 1000).Iterator()
+	for iter.Next(ctx) {
+		keys = append(keys, iter.Val())
+	}
+	if err := iter.Err(); err != nil {
+		return fmt.Errorf("error looking for the locks in redis: %w", err)
+	}
+	if len(keys) == 0 {
+		return nil
+	}
+	if err := n.client.Del(ctx, keys...).Err(); err != nil {
+		return fmt.Errorf("error removing the locks from redis: %w", err)
+	}
+
+	return nil
+}
+
+func (n *redisNode) Close() error {
+	return n.client.Close()
+}
diff --git a/pkg/sessions/redispeers/node_test.go b/pkg/sessions/redispeers/node_test.go
new file mode 100644
index 00000000..cede25b6
--- /dev/null
+++ b/pkg/sessions/redispeers/node_test.go
@@ -0,0 +1,229 @@
+package redispeers
+
+import (
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/alicebob/miniredis/v2"
+	"github.com/alicebob/miniredis/v2/server"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// The sections below are what Redis 7.4 answers to INFO, cut to the fields around those the store
+// reads.
+const (
+	infoServer = "# Server\r\nredis_version:7.4.7\r\nredis_mode:standalone\r\nrun_id:5b0c7c1f9c7d2a4e3f6b8a9d0c1e2f3a4b5c6d7e\r\ntcp_port:6379\r\n"
+
+	infoMaster = "# Replication\r\nrole:master\r\nconnected_slaves:1\r\n" +
+		"slave0:ip=10.0.0.2,port=6379,state=online,offset=53779132,lag=0\r\n" +
+		"master_replid:b469cf5e42a4504dc7681a1e4d636dd10fcd6c5b\r\nmaster_repl_offset:53779132\r\nsecond_repl_offset:-1\r\n"
+
+	infoReplicaCopying = "# Replication\r\nrole:slave\r\nmaster_host:10.0.0.1\r\nmaster_port:6379\r\n" +
+		"master_link_status:down\r\nmaster_last_io_seconds_ago:-1\r\nmaster_sync_in_progress:1\r\n" +
+		"slave_read_repl_offset:0\r\nslave_repl_offset:0\r\nmaster_repl_offset:0\r\n"
+
+	infoReplicaCopied = "# Replication\r\nrole:slave\r\nmaster_host:10.0.0.1\r\nmaster_port:6379\r\n" +
+		"master_link_status:up\r\nmaster_last_io_seconds_ago:0\r\nmaster_sync_in_progress:0\r\n" +
+		"slave_read_repl_offset:53779132\r\nslave_repl_offset:53779118\r\nslave_read_only:1\r\n" +
+		"master_replid:b469cf5e42a4504dc7681a1e4d636dd10fcd6c5b\r\nmaster_repl_offset:53779132\r\n"
+)
+
+// newMiniNode connects a node to a Redis in the memory of the test.
+func newMiniNode(t *testing.T) (*redisNode, *miniredis.Miniredis) {
+	t.Helper()
+
+	mini := miniredis.RunT(t)
+	redisNode := newRedisNode(&redis.Options{}, mini.Addr(), time.Second)
+	t.Cleanup(func() { require.NoError(t, redisNode.Close()) })
+
+	return redisNode, mini
+}
+
+func TestRedisNode_State(t *testing.T) {
+	t.Parallel()
+
+	const (
+		runID   = "5b0c7c1f9c7d2a4e3f6b8a9d0c1e2f3a4b5c6d7e"
+		loading = "LOADING Redis is loading the dataset in memory"
+	)
+
+	tests := []struct {
+		name        string
+		replication string
+		markError   string
+		hasMark     bool
+		otherMark   bool
+		expected    nodeState
+	}{
+		{
+			name:        "a master with the mark",
+			replication: infoMaster,
+			hasMark:     true,
+			expected:    nodeState{runID: runID, offset: 53779132, isSeeded: true},
+		},
+		{
+			name:        "the mark of another redis, which a copy has brought, does not count",
+			replication: infoMaster,
+			otherMark:   true,
+			expected:    nodeState{runID: runID, offset: 53779132},
+		},
+		{
+			name:        "a replica in the middle of its copy",
+			replication: infoReplicaCopying,
+			expected:    nodeState{runID: runID, isReplica: true, isSyncing: true},
+		},
+		{
+			name:        "a replica that has its copy: the offset is what it has applied",
+			replication: infoReplicaCopied,
+			expected:    nodeState{runID: runID, isReplica: true, isLinkUp: true, offset: 53779118},
+		},
+		{
+			name:        "a replica that loads its copy answers INFO alone: it is still syncing",
+			replication: infoReplicaCopied,
+			markError:   loading,
+			expected:    nodeState{runID: runID, isReplica: true, isLinkUp: true, isSyncing: true, offset: 53779118},
+		},
+		{
+			name:        "an answer without the fields",
+			replication: "# Replication\r\n",
+			expected:    nodeState{runID: runID},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			redisNode, mini := newMiniNode(t)
+			if tt.otherMark {
+				require.NoError(t, redisNode.MarkSeeded(t.Context(), "the run id of the master"))
+			}
+			if tt.hasMark {
+				require.NoError(t, redisNode.MarkSeeded(t.Context(), runID))
+			}
+			mini.Server().SetPreHook(func(peer *server.Peer, cmd string, _ ...string) bool {
+				switch {
+				case strings.EqualFold(cmd, "INFO"):
+					peer.WriteBulk(infoServer + "\r\n" + tt.replication)
+				case strings.EqualFold(cmd, "GET") && tt.markError != "":
+					peer.WriteError(tt.markError)
+				default:
+					return false
+				}
+
+				return true
+			})
+
+			state, err := redisNode.State(t.Context())
+			require.NoError(t, err)
+			assert.Equal(t, tt.expected, state)
+		})
+	}
+
+	t.Run("a redis that refuses INFO too", func(t *testing.T) {
+		t.Parallel()
+		redisNode, mini := newMiniNode(t)
+		mini.SetError(loading)
+
+		_, err := redisNode.State(t.Context())
+		require.Error(t, err)
+	})
+}
+
+func TestRedisNode(t *testing.T) {
+	t.Parallel()
+
+	t.Run("a session is stored with its expiry and removed", func(t *testing.T) {
+		t.Parallel()
+		redisNode, mini := newMiniNode(t)
+
+		_, err := redisNode.Get(t.Context(), "ticket")
+		require.ErrorIs(t, err, errNotFound)
+
+		require.NoError(t, redisNode.Set(t.Context(), "ticket", []byte("session"), time.Hour))
+		value, err := redisNode.Get(t.Context(), "ticket")
+		require.NoError(t, err)
+		assert.Equal(t, "session", string(value))
+		assert.Equal(t, time.Hour, mini.TTL("ticket"))
+
+		require.NoError(t, redisNode.Set(t.Context(), "forever", []byte("session"), 0))
+		assert.Zero(t, mini.TTL("forever"))
+
+		require.NoError(t, redisNode.Del(t.Context(), "forever"))
+		mini.FastForward(time.Hour)
+		for _, key := range []string{"ticket", "forever"} {
+			_, err = redisNode.Get(t.Context(), key)
+			require.ErrorIs(t, err, errNotFound)
+		}
+	})
+
+	t.Run("a redis that does not answer", func(t *testing.T) {
+		t.Parallel()
+		redisNode, mini := newMiniNode(t)
+		mini.Close()
+
+		_, err := redisNode.Get(t.Context(), "ticket")
+		require.Error(t, err)
+		require.NotErrorIs(t, err, errNotFound)
+		require.Error(t, redisNode.Set(t.Context(), "ticket", []byte("session"), time.Hour))
+	})
+
+	t.Run("a redis that takes the request and keeps silent is given up on in time", func(t *testing.T) {
+		t.Parallel()
+		listener, err := net.Listen("tcp", "127.0.0.1:0")
+		require.NoError(t, err)
+		t.Cleanup(func() { require.NoError(t, listener.Close()) })
+
+		silent := newRedisNode(&redis.Options{}, listener.Addr().String(), 50*time.Millisecond)
+		t.Cleanup(func() { require.NoError(t, silent.Close()) })
+
+		started := time.Now()
+		err = silent.Set(t.Context(), "ticket", []byte("session"), time.Hour)
+		require.Error(t, err)
+		assert.Less(t, time.Since(started), time.Second)
+		assert.Equal(t, resultTimeout, writeResult(err))
+
+		require.Error(t, silent.Lock("ticket").Obtain(t.Context(), time.Minute), "the lock goes through the same client")
+		assert.Less(t, time.Since(started), time.Second)
+	})
+
+	t.Run("the refusal of a read-only replica has a name", func(t *testing.T) {
+		t.Parallel()
+		redisNode, mini := newMiniNode(t)
+		mini.SetError("READONLY You can't write against a read only replica.")
+
+		require.ErrorIs(t, redisNode.Set(t.Context(), "ticket", []byte("session"), time.Hour), errReadOnly)
+		require.ErrorIs(t, redisNode.Del(t.Context(), "ticket"), errReadOnly)
+	})
+
+	t.Run("the mark", func(t *testing.T) {
+		t.Parallel()
+		redisNode, mini := newMiniNode(t)
+
+		require.NoError(t, redisNode.MarkSeeded(t.Context(), "run"))
+		mini.CheckGet(t, seededKey, "run")
+		assert.Zero(t, mini.TTL(seededKey), "the mark does not expire")
+	})
+
+	t.Run("the locks are dropped and the sessions stay", func(t *testing.T) {
+		t.Parallel()
+		redisNode, mini := newMiniNode(t)
+
+		for _, key := range []string{"ticket-1", "ticket-2"} {
+			require.NoError(t, redisNode.Set(t.Context(), key, []byte("session"), time.Hour))
+		}
+		held := redisNode.Lock("ticket-1")
+		require.NoError(t, held.Obtain(t.Context(), time.Minute))
+		require.NoError(t, redisNode.Lock("ticket-2").Obtain(t.Context(), time.Minute))
+
+		require.NoError(t, redisNode.DropLocks(t.Context()))
+
+		assert.ElementsMatch(t, []string{"ticket-1", "ticket-2"}, mini.Keys())
+		require.ErrorIs(t, held.Release(t.Context()), sessions.ErrNotLocked, "the holder finds its lock gone")
+		require.NoError(t, redisNode.Lock("ticket-1").Obtain(t.Context(), time.Minute))
+	})
+}
