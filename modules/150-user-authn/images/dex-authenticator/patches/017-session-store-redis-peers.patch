+func TestStore_Concurrent(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+	value := []byte(strings.Repeat("s", 2000))
+	store, err := NewStore(options.MemoryStoreOptions{MaxBytes: 64 * recordSize("ticket-000", value), TTL: 50 * time.Millisecond})
+	require.NoError(t, err)
+
+	const (
+		workers    = 16
+		iterations = 2000
+		keys       = 200
+	)
+
+	var wg sync.WaitGroup
+	for w := range workers {
+		wg.Go(func() {
+			for i := range iterations {
+				key := fmt.Sprintf("ticket-%03d", (w*31+i)%keys)
+				switch i % 5 {
+				case 0, 1:
+					if err := store.Save(ctx, key, value, time.Second); err != nil {
+						t.Errorf("save: %v", err)
+						return
+					}
+				case 2, 3:
+					got, err := store.Load(ctx, key)
+					if err == nil && len(got) != len(value) {
+						t.Errorf("load returned %d bytes, want %d", len(got), len(value))
+						return
+					}
+				default:
+					if err := store.Clear(ctx, key); err != nil {
+						t.Errorf("clear: %v", err)
+						return
+					}
+				}
+				if i%100 == 0 {
+					store.usage()
+				}
+			}
+		})
+	}
+	wg.Wait()
+
+	checkInvariants(t, store)
+}
