+// A Redis of the replica that restarts while the proxy lives is filled from the neighbour again;
+// meanwhile the replica works through the Redis of the neighbour.
+func TestStore_OwnRedisRestarts(t *testing.T) {
+	t.Parallel()
+
+	fakes := newFakeNet()
+	a, b := fakes.add(addrA), fakes.add(addrB)
+	storeA := startTestStore(t, fakes, addrA, time.Minute)
+	eventually(t, func() bool { return storeA.VerifyConnection(t.Context()) == nil }, "the replica is ready")
+	newTestStore(t, fakes, addrB)
+	eventually(t, func() bool { return len(storeA.peerSnapshot()) == 1 && storeA.peerSnapshot()[0].seeded() }, "the neighbour is seen as filled")
+	require.NoError(t, storeA.Save(t.Context(), "ticket", []byte("session"), time.Hour))
+
+	// The copy takes a while, so the test sees the replica work without its redis.
+	fakes.mu.Lock()
+	a.pollsToCopy = 1 << 30
+	fakes.mu.Unlock()
+	a.restart()
+	eventually(t, func() bool { return mode(storeA) == modePeer }, "the replica works through the neighbour")
+
+	value, err := storeA.Load(t.Context(), "ticket")
+	require.NoError(t, err)
+	assert.Equal(t, "session", string(value))
+	assert.InDelta(t, 1, loads(storeA, stepPeer), 0)
+	assert.Equal(t, addrB, home(storeA), "the locks live in the redis of the neighbour")
+
+	require.NoError(t, storeA.Save(t.Context(), "during", []byte("session"), time.Hour))
+	_, ok := b.has("during")
+	assert.True(t, ok)
+
+	fakes.mu.Lock()
+	a.pollsLeft = 0
+	fakes.mu.Unlock()
+	eventually(t, func() bool { return mode(storeA) == modeRedis }, "the redis is filled and in use")
+
+	for _, key := range []string{"ticket", "during"} {
+		_, ok := a.has(key)
+		assert.True(t, ok, "the redis of the replica has %q again", key)
+	}
+	assert.EqualValues(t, 1, seeds(t, storeA, seedCopied))
+	assert.Empty(t, storeA.memory.Items())
+	assert.Equal(t, addrA, home(storeA))
+}
