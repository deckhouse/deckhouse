--- a/pkg/apis/options/sessions.go
+++ b/pkg/apis/options/sessions.go
@@ -1,10 +1,15 @@
 package options
 
+import "time"
+
 // SessionOptions contains configuration options for the SessionStore providers.
 type SessionOptions struct {
 	Type   string             `flag:"session-store-type" cfg:"session_store_type"`
 	Cookie CookieStoreOptions `cfg:",squash"`
 	Redis  RedisStoreOptions  `cfg:",squash"`
+	Memory MemoryStoreOptions `cfg:",squash"`
+	// RedisPeers configures the store of the "redis-peers" type together with Redis and Memory.
+	RedisPeers RedisPeersStoreOptions `cfg:",squash"`
 }
 
 // CookieSessionStoreType is used to indicate the CookieSessionStore should be
@@ -15,6 +20,10 @@ var CookieSessionStoreType = "cookie"
 // used for storing sessions.
 var RedisSessionStoreType = "redis"
 
+// RedisPeersSessionStoreType is used to indicate the session store over the Redis of every replica
+// of the proxy should be used for storing sessions (Deckhouse patch 017).
+var RedisPeersSessionStoreType = "redis-peers"
+
 // CookieStoreOptions contains configuration options for the CookieSessionStore.
 type CookieStoreOptions struct {
 	Minimal bool `flag:"session-cookie-minimal" cfg:"session_cookie_minimal"`
@@ -36,11 +45,58 @@ type RedisStoreOptions struct {
 	IdleTimeout            int      `flag:"redis-connection-idle-timeout" cfg:"redis_connection_idle_timeout"`
 }
 
+// MemoryStoreOptions contains configuration options for the memory of the process that the
+// redis-peers session store keeps a session in while no Redis takes it (Deckhouse patch 017).
+type MemoryStoreOptions struct {
+	// MaxBytes is the limit of the store: past it the sessions used least recently are dropped.
+	MaxBytes int64 `flag:"session-store-memory-max-bytes" cfg:"session_store_memory_max_bytes"`
+	// TTL caps how long a session stays in the store; zero keeps it for --cookie-expire.
+	TTL time.Duration `flag:"session-store-memory-ttl" cfg:"session_store_memory_ttl"`
+}
+
+// RedisPeersStoreOptions contains configuration options for the session store over the Redis of
+// every replica of the proxy (Deckhouse patch 017). The Redis of the replica itself is the one of
+// --redis-connection-url, the Redis of every neighbour listens on the same port, and the memory
+// of the process takes over while no Redis answers.
+type RedisPeersStoreOptions struct {
+	// DNSName resolves to the addresses of every replica, as a headless Service does. Empty: the
+	// replica has no neighbours.
+	DNSName string `flag:"redis-peers-dns-name" cfg:"redis_peers_dns_name"`
+	// SelfAddress is the address of this replica among those DNSName resolves to.
+	SelfAddress string `flag:"redis-peers-self-address" cfg:"redis_peers_self_address"`
+	// SeedTimeout is how long the replica waits at most for its empty Redis to be filled from a
+	// neighbour before it is ready.
+	SeedTimeout time.Duration `flag:"redis-peers-seed-timeout" cfg:"redis_peers_seed_timeout"`
+	// Timeout is the limit of one request to a Redis.
+	Timeout time.Duration `flag:"redis-peers-timeout" cfg:"redis_peers_timeout"`
+}
+
+// The defaults of RedisPeersStoreOptions.
+const (
+	DefaultRedisPeersSeedTimeout = 15 * time.Second
+	// DefaultRedisPeersTimeout is far above the time Redis takes to answer, a fraction of a
+	// millisecond: it is the time a Redis may stall before a request goes on to the next one. The
+	// Redis of a pod shares the CPU of its node, and a node near its limit delays a process by
+	// hundreds of milliseconds now and then; with 200 milliseconds every Redis of a loaded node
+	// timed out at once.
+	DefaultRedisPeersTimeout = 500 * time.Millisecond
+)
+
+// DefaultMemoryStoreMaxBytes is the default limit of the session store in the memory of the process.
+const DefaultMemoryStoreMaxBytes int64 = 64 << 20
+
 func sessionOptionsDefaults() SessionOptions {
 	return SessionOptions{
 		Type: CookieSessionStoreType,
 		Cookie: CookieStoreOptions{
 			Minimal: false,
 		},
+		Memory: MemoryStoreOptions{
+			MaxBytes: DefaultMemoryStoreMaxBytes,
+		},
+		RedisPeers: RedisPeersStoreOptions{
+			SeedTimeout: DefaultRedisPeersSeedTimeout,
+			Timeout:     DefaultRedisPeersTimeout,
+		},
 	}
 }
