+func TestStore_EvictionByBytes(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+	value := []byte(strings.Repeat("s", 1000))
+	// Every key below has the same length, so every record has the same size.
+	size := recordSize("ticket-0", value)
+
+	exists := func(t *testing.T, store *Store, key string) bool {
+		t.Helper()
+
+		store.mu.Lock()
+		defer store.mu.Unlock()
+		_, ok := store.records[key]
+
+		return ok
+	}
+
+	t.Run("the least recently saved record goes first", func(t *testing.T) {
+		t.Parallel()
+		store, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 3 * size})
+
+		for i := range 4 {
+			require.NoError(t, store.Save(ctx, fmt.Sprintf("ticket-%d", i), value, time.Hour))
+		}
+
+		assert.False(t, exists(t, store, "ticket-0"))
+		for i := 1; i < 4; i++ {
+			assert.True(t, exists(t, store, fmt.Sprintf("ticket-%d", i)), "ticket-%d", i)
+		}
+		assert.InDelta(t, 1, testutil.ToFloat64(store.metrics.evictions.WithLabelValues(evictionSize)), 0)
+		checkInvariants(t, store)
+	})
+
+	t.Run("a load makes a record recent", func(t *testing.T) {
+		t.Parallel()
+		store, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 3 * size})
+
+		for i := range 3 {
+			require.NoError(t, store.Save(ctx, fmt.Sprintf("ticket-%d", i), value, time.Hour))
+		}
+		_, err := store.Load(ctx, "ticket-0")
+		require.NoError(t, err)
+		require.NoError(t, store.Save(ctx, "ticket-3", value, time.Hour))
+
+		assert.True(t, exists(t, store, "ticket-0"))
+		assert.False(t, exists(t, store, "ticket-1"))
+		assert.True(t, exists(t, store, "ticket-2"))
+		assert.True(t, exists(t, store, "ticket-3"))
+		checkInvariants(t, store)
+	})
+
+	t.Run("saving a record again makes it recent", func(t *testing.T) {
+		t.Parallel()
+		store, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 3 * size})
+
+		for i := range 3 {
+			require.NoError(t, store.Save(ctx, fmt.Sprintf("ticket-%d", i), value, time.Hour))
+		}
+		require.NoError(t, store.Save(ctx, "ticket-0", value, time.Hour))
+		require.NoError(t, store.Save(ctx, "ticket-3", value, time.Hour))
+
+		assert.True(t, exists(t, store, "ticket-0"))
+		assert.False(t, exists(t, store, "ticket-1"))
+		checkInvariants(t, store)
+	})
+
+	t.Run("a large record evicts as many as it needs", func(t *testing.T) {
+		t.Parallel()
+		store, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 4 * size})
+
+		for i := range 4 {
+			require.NoError(t, store.Save(ctx, fmt.Sprintf("ticket-%d", i), value, time.Hour))
+		}
+		large := []byte(strings.Repeat("s", int(2*size)))
+		require.NoError(t, store.Save(ctx, "ticket-L", large, time.Hour))
+
+		assert.False(t, exists(t, store, "ticket-0"))
+		assert.False(t, exists(t, store, "ticket-1"))
+		assert.False(t, exists(t, store, "ticket-2"))
+		assert.True(t, exists(t, store, "ticket-3"))
+		assert.True(t, exists(t, store, "ticket-L"))
+		checkInvariants(t, store)
+	})
+
+	t.Run("a record above the limit is refused and evicts nothing", func(t *testing.T) {
+		t.Parallel()
+		store, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 2 * size})
+
+		require.NoError(t, store.Save(ctx, "ticket-0", value, time.Hour))
+		tooLarge := []byte(strings.Repeat("s", int(2*size)))
+		require.ErrorContains(t, store.Save(ctx, "ticket-L", tooLarge, time.Hour), "does not fit")
+
+		assert.True(t, exists(t, store, "ticket-0"))
+		assert.False(t, exists(t, store, "ticket-L"))
+		checkInvariants(t, store)
+	})
+
+	t.Run("expired records go before the live ones", func(t *testing.T) {
+		t.Parallel()
+		store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 3 * size})
+
+		require.NoError(t, store.Save(ctx, "ticket-0", value, time.Hour))
+		require.NoError(t, store.Save(ctx, "ticket-1", value, time.Minute))
+		require.NoError(t, store.Save(ctx, "ticket-2", value, time.Minute))
+		clock.Advance(time.Minute)
+		require.NoError(t, store.Save(ctx, "ticket-3", value, time.Hour))
+
+		// ticket-0 is the least recently used, but the two expired records made room.
+		assert.True(t, exists(t, store, "ticket-0"))
+		assert.True(t, exists(t, store, "ticket-3"))
+		assert.InDelta(t, 0, testutil.ToFloat64(store.metrics.evictions.WithLabelValues(evictionSize)), 0)
+		assert.InDelta(t, 2, testutil.ToFloat64(store.metrics.evictions.WithLabelValues(evictionExpired)), 0)
+		checkInvariants(t, store)
+	})
+
+	t.Run("the store never grows above its limit", func(t *testing.T) {
+		t.Parallel()
+		store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 10 * size, TTL: 10 * time.Minute})
+
+		for i := range 1000 {
+			val := []byte(strings.Repeat("s", 100+(i*37)%2000))
+			require.NoError(t, store.Save(ctx, fmt.Sprintf("ticket-%d", i%150), val, time.Hour))
+			if i%7 == 0 {
+				_, _ = store.Load(ctx, fmt.Sprintf("ticket-%d", (i*3)%150))
+			}
+			if i%50 == 0 {
+				clock.Advance(time.Minute)
+			}
+
+			_, used := store.usage()
+			require.LessOrEqual(t, used, 10*size)
+		}
+		checkInvariants(t, store)
+	})
+}
