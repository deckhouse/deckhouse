+// Two replicas that start together with empty Redis do not wait for each other.
+func TestStore_SeedOfTwoEmptyReplicas(t *testing.T) {
+	t.Parallel()
+
+	fakes := newFakeNet()
+	a, b := fakes.add(addrA), fakes.add(addrB)
+
+	started := time.Now()
+	storeA := startTestStore(t, fakes, addrA, 30*time.Second)
+	storeB := startTestStore(t, fakes, addrB, 30*time.Second)
+	eventually(t, func() bool {
+		return storeA.VerifyConnection(t.Context()) == nil && storeB.VerifyConnection(t.Context()) == nil
+	}, "both replicas are ready")
+
+	assert.Less(t, time.Since(started), 5*time.Second, "far sooner than the time a filling may take")
+	assertInUse(t, a)
+	assertInUse(t, b)
+	for _, store := range []*Store{storeA, storeB} {
+		// One of the two may find the other already marked and copy its empty redis.
+		assert.EqualValues(t, 1, seeds(t, store, seedEmpty)+seeds(t, store, seedCopied))
+		assert.Zero(t, seeds(t, store, seedTimeout)+seeds(t, store, seedError))
+	}
+
+	// They agree on the home of the locks once they have seen each other.
+	eventually(t, func() bool { return home(storeA) == addrA && home(storeB) == addrA }, "both name the same home")
+}
