+// A Redis that was left is taken back only after it has answered probesToReturn probes in a row.
+func TestStore_RedisReturnsAfterProbesInARow(t *testing.T) {
+	t.Parallel()
+	fakes := newFakeNet()
+	fakes.add(addrA)
+	b := fakes.add(addrB)
+	storeA := newTestStore(t, fakes, addrA)
+	newTestStore(t, fakes, addrB)
+	eventually(t, func() bool { return storeA.peerSnapshot()[0].seeded() }, "the neighbour is filled")
+	b.setDown(true)
+	eventually(t, func() bool { return !storeA.peerSnapshot()[0].usable() }, "the neighbour is left")
+	// The loop of the store would probe on its own; the test probes by hand.
+	require.NoError(t, storeA.Close())
+	peer := storeA.peerSnapshot()[0]
+
+	b.setDown(false)
+	for range probesToReturn - 1 {
+		storeA.probe(t.Context())
+	}
+	b.setDown(true)
+	storeA.probe(t.Context())
+	b.setDown(false)
+	storeA.probe(t.Context())
+	assert.False(t, peer.usable(), "a stall starts the count again")
+
+	for range probesToReturn - 1 {
+		storeA.probe(t.Context())
+	}
+	assert.True(t, peer.usable(), "the neighbour is back after probes in a row")
+	assert.True(t, peer.seeded())
+}
