+func TestStore_TTL(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name       string
+		storeTTL   time.Duration
+		recordTTL  time.Duration
+		advance    time.Duration
+		expectLive bool
+	}{
+		{name: "record is kept before its ttl", recordTTL: 10 * time.Minute, advance: 10*time.Minute - time.Second, expectLive: true},
+		{name: "record is gone at its ttl", recordTTL: 10 * time.Minute, advance: 10 * time.Minute},
+		{name: "record is gone after its ttl", recordTTL: 10 * time.Minute, advance: time.Hour},
+		{name: "store ttl caps a longer record ttl", storeTTL: 11 * time.Minute, recordTTL: 168 * time.Hour, advance: 11 * time.Minute},
+		{name: "store ttl keeps a record below the cap", storeTTL: 11 * time.Minute, recordTTL: 168 * time.Hour, advance: 11*time.Minute - time.Second, expectLive: true},
+		{name: "store ttl does not extend a shorter record ttl", storeTTL: 11 * time.Minute, recordTTL: time.Minute, advance: time.Minute},
+		{name: "store ttl applies to a record without ttl", storeTTL: 11 * time.Minute, recordTTL: 0, advance: 11 * time.Minute},
+		{name: "record without any ttl does not expire", recordTTL: 0, advance: 10000 * time.Hour, expectLive: true},
+	}
+
+	ctx := context.Background()
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1 << 20, TTL: tt.storeTTL})
+
+			require.NoError(t, store.Save(ctx, "ticket", []byte("session"), tt.recordTTL))
+			clock.Advance(tt.advance)
+
+			got, err := store.Load(ctx, "ticket")
+			if tt.expectLive {
+				require.NoError(t, err)
+				assert.Equal(t, []byte("session"), got)
+			} else {
+				require.ErrorIs(t, err, errNotFound)
+			}
+
+			records, size := store.usage()
+			if tt.expectLive {
+				assert.Equal(t, 1, records)
+			} else {
+				assert.Zero(t, records)
+				assert.Zero(t, size)
+			}
+			checkInvariants(t, store)
+		})
+	}
+
+	t.Run("saving again starts the ttl again", func(t *testing.T) {
+		t.Parallel()
+		store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1 << 20})
+
+		require.NoError(t, store.Save(ctx, "ticket", []byte("session"), 10*time.Minute))
+		clock.Advance(9 * time.Minute)
+		require.NoError(t, store.Save(ctx, "ticket", []byte("refreshed"), 10*time.Minute))
+		clock.Advance(9 * time.Minute)
+
+		got, err := store.Load(ctx, "ticket")
+		require.NoError(t, err)
+		assert.Equal(t, []byte("refreshed"), got)
+		checkInvariants(t, store)
+	})
+
+	t.Run("a load does not extend the ttl", func(t *testing.T) {
+		t.Parallel()
+		store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1 << 20})
+
+		require.NoError(t, store.Save(ctx, "ticket", []byte("session"), 10*time.Minute))
+		clock.Advance(9 * time.Minute)
+		_, err := store.Load(ctx, "ticket")
+		require.NoError(t, err)
+		clock.Advance(time.Minute)
+
+		_, err = store.Load(ctx, "ticket")
+		require.ErrorIs(t, err, errNotFound)
+	})
+
+	t.Run("expired records are dropped without being loaded and counted", func(t *testing.T) {
+		t.Parallel()
+		store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1 << 20})
+
+		for i := range 100 {
+			ttl := time.Duration(i%10+1) * time.Minute
+			require.NoError(t, store.Save(ctx, fmt.Sprintf("ticket-%d", i), []byte("session"), ttl))
+		}
+		clock.Advance(5 * time.Minute)
+
+		records, _ := store.usage()
+		assert.Equal(t, 50, records)
+		assert.InDelta(t, 50, testutil.ToFloat64(store.metrics.evictions.WithLabelValues(evictionExpired)), 0)
+		assert.InDelta(t, 0, testutil.ToFloat64(store.metrics.evictions.WithLabelValues(evictionSize)), 0)
+		checkInvariants(t, store)
+	})
+}
