+	require.NoError(t, store.Save(t.Context(), "ticket", []byte("new"), time.Hour))
+	require.NoError(t, store.moveItem(t.Context(), memory.Item{Key: "ticket", Value: []byte("old"), TTL: time.Hour}))
+
+	value, _ := a.has("ticket")
+	assert.Equal(t, "new", value)
+
+	// And a request has removed a session the memory held when it was read.
+	require.NoError(t, store.Clear(t.Context(), "ticket"))
+	require.NoError(t, store.moveItem(t.Context(), memory.Item{Key: "ticket", Value: []byte("old"), TTL: time.Hour}))
+
+	_, ok := a.has("ticket")
+	assert.False(t, ok, "the removed session is not brought back")
+
+	// A move waits for the request that is writing.
+	a.setDown(true)
+	for range failuresToLeave {
+		require.NoError(t, store.Save(t.Context(), "kept", []byte("session"), time.Hour))
+	}
+	a.setDown(false)
+	store.journal.RLock()
+	moved := make(chan error, 1)
+	go func() {
+		moved <- store.moveItem(context.Background(), memory.Item{Key: "kept", Value: []byte("session"), TTL: time.Hour})
+	}()
+	select {
+	case <-moved:
+		t.Fatal("the move did not wait for the request")
+	case <-time.After(50 * time.Millisecond):
+	}
+	store.journal.RUnlock()
+	require.NoError(t, <-moved)
