+// A Redis that stalls for a moment under load is not left: the store leaves it only after it has
+// failed every request for failingToLeave.
+func TestEndpoint_Failed(t *testing.T) {
+	t.Parallel()
+
+	start := time.Date(2026, time.November, 23, 0, 0, 0, 0, time.UTC)
+	tests := []struct {
+		name     string
+		failures int
+		spread   time.Duration
+		isLeft   bool
+	}{
+		{name: "a burst of failures within a moment", failures: 100, spread: 500 * time.Millisecond, isLeft: false},
+		{name: "fewer failures than needed over a long time", failures: failuresToLeave - 1, spread: time.Minute, isLeft: false},
+		{name: "failures for the whole time", failures: failuresToLeave, spread: failingToLeave, isLeft: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			ep := &endpoint{isUp: true, isSeeded: true}
+
+			isLeft := false
+			for i := range tt.failures {
+				at := start
+				if tt.failures > 1 {
+					at = start.Add(tt.spread * time.Duration(i) / time.Duration(tt.failures-1))
+				}
+				isLeft = ep.failed(at, failingToLeave) || isLeft
+			}
+			assert.Equal(t, tt.isLeft, isLeft)
+			assert.Equal(t, !tt.isLeft, ep.usable())
+		})
+	}
+
+	t.Run("answers in a row start the count again", func(t *testing.T) {
+		t.Parallel()
+		ep := &endpoint{isUp: true, isSeeded: true}
+		for range failuresToLeave {
+			ep.failed(start, failingToLeave)
+		}
+		for range answersToForgive {
+			ep.succeeded()
+		}
+		assert.False(t, ep.failed(start.Add(failingToLeave), failingToLeave), "the failures before the answers do not count")
+	})
+
+	t.Run("an answer between failures does not", func(t *testing.T) {
+		t.Parallel()
+		ep := &endpoint{isUp: true, isSeeded: true}
+		isLeft := false
+		for i := range failuresToLeave {
+			ep.succeeded()
+			isLeft = ep.failed(start.Add(failingToLeave*time.Duration(i)/time.Duration(failuresToLeave-1)), failingToLeave) || isLeft
+		}
+		assert.True(t, isLeft, "a redis that fails most requests is left")
+	})
+
+	t.Run("a probe between failures does not clear them", func(t *testing.T) {
+		t.Parallel()
+		// A neighbour in use fails a request every 25 ms and answers the probe every second.
+		ep := &endpoint{isUp: true, isSeeded: true}
+		isLeft := false
+		for at := time.Duration(0); at < 10*time.Second && !isLeft; at += 25 * time.Millisecond {
+			if at%time.Second == 0 {
+				ep.set(true, true, "run")
+			}
+			isLeft = ep.failed(start.Add(at), failingToLeave)
+		}
+		assert.True(t, isLeft, "a redis that fails the requests and answers the probe is left")
+		assert.False(t, ep.usable())
+	})
+
+	t.Run("probes in a row clear the failures", func(t *testing.T) {
+		t.Parallel()
+		ep := &endpoint{isUp: true, isSeeded: true}
+		for range failuresToLeave {
+			ep.failed(start, failingToLeave)
+		}
+		for range answersToForgive {
+			ep.set(true, true, "run")
+		}
+		assert.False(t, ep.failed(start.Add(failingToLeave), failingToLeave), "the failures before the probes do not count")
+	})
+
+	t.Run("a redis taken back starts without failures", func(t *testing.T) {
+		t.Parallel()
+		ep := &endpoint{isUp: true, isSeeded: true}
+		for i := range failuresToLeave {
+			ep.failed(start.Add(failingToLeave*time.Duration(i)/time.Duration(failuresToLeave-1)), failingToLeave)
+		}
+		require.False(t, ep.usable())
+
+		assert.True(t, ep.set(true, true, "run"))
+		assert.False(t, ep.failed(start.Add(time.Hour), failingToLeave))
+		assert.True(t, ep.usable())
+	})
+}
