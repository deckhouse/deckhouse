+package memory
+
+import (
+	"testing"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/logger"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/persistence"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/tests"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+func TestMemorySuite(t *testing.T) {
+	logger.SetOutput(GinkgoWriter)
+	logger.SetErrOutput(GinkgoWriter)
+
+	RegisterFailHandler(Fail)
+	RunSpecs(t, "Memory SessionStore")
+}
+
+// The memory store passes the tests every session store passes, with the ticket cookie of patch 002.
+var _ = Describe("Memory SessionStore Tests", func() {
+	var clock *fakeClock
+
+	tests.RunSessionStoreTests(
+		func(opts *options.SessionOptions, cookieOpts *options.Cookie) (sessionsapi.SessionStore, error) {
+			opts.Memory.MaxBytes = 1 << 20
+
+			store, err := NewStore(opts.Memory)
+			if err != nil {
+				return nil, err
+			}
+			clock = newFakeClock()
+			store.now = clock.Now
+
+			return persistence.NewManager(store, cookieOpts), nil
+		},
+		func(d time.Duration) error {
+			clock.Advance(d)
+			return nil
+		},
+	)
+})
diff --git a/pkg/sessions/memory/metrics.go b/pkg/sessions/memory/metrics.go
new file mode 100644
index 00000000..b0352d0c
--- /dev/null
+++ b/pkg/sessions/memory/metrics.go
@@ -0,0 +1,81 @@
+package memory
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+const (
+	evictionSize    = "size"
+	evictionExpired = "expired"
+
+	loadHit  = "hit"
+	loadMiss = "miss"
+)
+
+// metrics are the metrics of a Store. None of them has a label with the data of a user.
+type metrics struct {
+	entries   *prometheus.Desc
+	bytes     *prometheus.Desc
+	evictions *prometheus.CounterVec
+	loads     *prometheus.CounterVec
+}
+
+func newMetrics() *metrics {
+	return &metrics{
+		entries: prometheus.NewDesc(
+			"oauth2_proxy_session_store_memory_entries",
+			"Number of sessions in the memory session store.",
+			nil, nil,
+		),
+		bytes: prometheus.NewDesc(
+			"oauth2_proxy_session_store_memory_bytes",
+			"Bytes the sessions in the memory session store take: keys, values and an estimate of the overhead per session.",
+			nil, nil,
+		),
+		evictions: prometheus.NewCounterVec(
+			prometheus.CounterOpts{
+				Name: "oauth2_proxy_session_store_memory_evictions_total",
+				Help: "Sessions dropped from the memory session store: over the limit in bytes (size) or past their TTL (expired).",
+			},
+			[]string{"reason"},
+		),
+		loads: prometheus.NewCounterVec(
+			prometheus.CounterOpts{
+				Name: "oauth2_proxy_session_store_memory_loads_total",
+				Help: "Loads from the memory session store by result: hit or miss.",
+			},
+			[]string{"result"},
+		),
+	}
+}
+
+// Register exports the metrics of the store through registerer. A process has one memory store;
+// the metrics of a second one registered on the same registerer are not exported.
+func (s *Store) Register(registerer prometheus.Registerer) error {
+	for _, collector := range []prometheus.Collector{s, s.metrics.evictions, s.metrics.loads} {
+		err := registerer.Register(collector)
+		if _, isRegistered := errors.AsType[prometheus.AlreadyRegisteredError](err); err != nil && !isRegistered {
+			return fmt.Errorf("could not register the metrics of the memory session store: %w", err)
+		}
+	}
+
+	return nil
+}
+
+// Describe implements prometheus.Collector for the gauges that are read from the store.
+func (s *Store) Describe(ch chan<- *prometheus.Desc) {
+	ch <- s.metrics.entries
+	ch <- s.metrics.bytes
+}
+
+// Collect implements prometheus.Collector. It drops the expired sessions first, so the gauges are
+// exact at the time of the scrape even without requests.
+func (s *Store) Collect(ch chan<- prometheus.Metric) {
+	records, size := s.usage()
+
+	ch <- prometheus.MustNewConstMetric(s.metrics.entries, prometheus.GaugeValue, float64(records))
+	ch <- prometheus.MustNewConstMetric(s.metrics.bytes, prometheus.GaugeValue, float64(size))
+}
diff --git a/pkg/sessions/memory/store.go b/pkg/sessions/memory/store.go
new file mode 100644
index 00000000..0b62dd65
--- /dev/null
+++ b/pkg/sessions/memory/store.go
@@ -0,0 +1,301 @@
+// Package memory keeps the sessions in the memory of the process (Deckhouse patch 017): the
+// session store over the Redis of every replica falls back to it while no Redis takes a session.
+//
+// The store is a cache: the cookie of patch 002 carries the refresh token, so a session the store
+// has dropped is restored through the provider on its next request. Dropping a record therefore
+// costs one refresh and never a sign-in.
+package memory
+
+import (
+	"bytes"
+	"container/heap"
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+)
+
+const (
+	// recordOverhead is what a record takes besides its key and value: the record itself, its
+	// place in the map, in the list of recent use and in the heap of expiry times. An estimate,
+	// so that the limit of the store is close to the memory it really takes.
+	recordOverhead = 256
+
+	// lockPurgeThreshold and lockPurgeInterval bound the locks that were never released: past
+	// the threshold the expired ones are dropped, at most once per interval.
+	lockPurgeThreshold = 1024
+	lockPurgeInterval  = time.Minute
+)
+
+// errNotFound is returned for a key the store does not hold. persistence.Manager turns any load
+// error into the stub session of patch 002.
+var errNotFound = errors.New("session does not exist")
+
+// Store is a persistence.Store in the memory of the process. A record lives until its TTL ends,
+// and the records used least recently are dropped once the store is over its limit in bytes.
+type Store struct {
+	maxBytes int64
+	maxTTL   time.Duration
+	now      func() time.Time
+	metrics  *metrics
+
+	mu      sync.Mutex
+	records map[string]*record
+	newest  *record // the most recently used record
+	oldest  *record // the least recently used record
+	expiry  expiryHeap
+	bytes   int64
+
+	locksMu       sync.Mutex
+	locks         map[string]lockHold
+	lastLockPurge time.Time
+}
+
+type record struct {
+	key       string
+	value     []byte
+	expiresAt time.Time // zero: the record does not expire
+	heapIndex int       // -1: not in the heap
+
+	// The neighbours in the list of recent use: newer is used after this record, older before.
+	newer, older *record
+}
+
+func (r *record) size() int64 {
+	return int64(len(r.key)) + int64(len(r.value)) + recordOverhead
+}
+
+// NewStore creates a Store that holds at most opts.MaxBytes bytes of records. With opts.TTL above
+// zero no record lives longer than that, whatever TTL it is saved with.
+func NewStore(opts options.MemoryStoreOptions) (*Store, error) {
+	if opts.MaxBytes <= 0 {
+		return nil, fmt.Errorf("the limit of the memory session store must be above zero, got %d bytes", opts.MaxBytes)
+	}
+	if opts.TTL < 0 {
+		return nil, fmt.Errorf("the TTL of the memory session store must not be negative, got %s", opts.TTL)
+	}
+
+	return &Store{
+		maxBytes: opts.MaxBytes,
+		maxTTL:   opts.TTL,
+		now:      time.Now,
+		metrics:  newMetrics(),
+		records:  map[string]*record{},
+		locks:    map[string]lockHold{},
+	}, nil
+}
+
+// Save keeps a copy of value under key for ttl; zero or less means no expiry of its own.
+func (s *Store) Save(_ context.Context, key string, value []byte, ttl time.Duration) error {
+	if s.maxTTL > 0 && (ttl <= 0 || ttl > s.maxTTL) {
+		ttl = s.maxTTL
+	}
+
+	rec := &record{key: key, value: bytes.Clone(value), heapIndex: -1}
+	if rec.size() > s.maxBytes {
+		return fmt.Errorf("a session of %d bytes does not fit the memory session store of %d bytes", rec.size(), s.maxBytes)
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	now := s.now()
+	if ttl > 0 {
+		rec.expiresAt = now.Add(ttl)
+	}
+
+	s.dropExpired(now)
+	if old, ok := s.records[key]; ok {
+		s.remove(old)
+	}
+
+	s.records[key] = rec
+	s.pushNewest(rec)
+	if !rec.expiresAt.IsZero() {
+		heap.Push(&s.expiry, rec)
+	}
+	s.bytes += rec.size()
+
+	// The new record is the newest and fits the limit alone, so the loop ends before it.
+	for s.bytes > s.maxBytes && s.oldest != rec {
+		s.remove(s.oldest)
+		s.metrics.evictions.WithLabelValues(evictionSize).Inc()
+	}
+
+	return nil
+}
+
+// Load returns a copy of the value under key and marks the record as just used.
+func (s *Store) Load(_ context.Context, key string) ([]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.dropExpired(s.now())
+
+	rec, ok := s.records[key]
+	if !ok {
+		s.metrics.loads.WithLabelValues(loadMiss).Inc()
+		return nil, errNotFound
+	}
+
+	s.unlink(rec)
+	s.pushNewest(rec)
+	s.metrics.loads.WithLabelValues(loadHit).Inc()
+
+	return bytes.Clone(rec.value), nil
+}
+
+// Clear drops the record under key.
+func (s *Store) Clear(_ context.Context, key string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if rec, ok := s.records[key]; ok {
+		s.remove(rec)
+	}
+
+	return nil
+}
+
+// Item is a record of a Store with the time it has left to live; zero: it does not expire.
+type Item struct {
+	Key   string
+	Value []byte
+	TTL   time.Duration
+}
+
+// Items returns copies of the records of the store, the expired ones left out. The store over
+// the Redis of every replica moves them to Redis once it answers again (Deckhouse patch 017).
+func (s *Store) Items() []Item {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	now := s.now()
+	s.dropExpired(now)
+
+	items := make([]Item, 0, len(s.records))
+	for _, rec := range s.records {
+		item := Item{Key: rec.key, Value: bytes.Clone(rec.value)}
+		if !rec.expiresAt.IsZero() {
+			item.TTL = rec.expiresAt.Sub(now)
+		}
+		items = append(items, item)
+	}
+
+	return items
+}
+
+// Peek returns the value under key without counting a load or a use: the redis-peers store looks
+// here on every request for a write its Redis has not taken yet (Deckhouse patch 017).
+func (s *Store) Peek(key string) ([]byte, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.dropExpired(s.now())
+	rec, ok := s.records[key]
+	if !ok {
+		return nil, false
+	}
+
+	return bytes.Clone(rec.value), true
+}
+
+// VerifyConnection always succeeds: the store is part of the process.
+func (s *Store) VerifyConnection(context.Context) error {
+	return nil
+}
+
+// usage returns the number of records and the bytes they take, without the expired ones.
+func (s *Store) usage() (records int, size int64) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.dropExpired(s.now())
+
+	return len(s.records), s.bytes
+}
+
+// dropExpired removes the records whose TTL has ended. Each record is popped once, so the cost is
+// spread over the calls that save and load. The caller holds s.mu.
+func (s *Store) dropExpired(now time.Time) {
+	for len(s.expiry) > 0 && !s.expiry[0].expiresAt.After(now) {
+		s.remove(s.expiry[0])
+		s.metrics.evictions.WithLabelValues(evictionExpired).Inc()
+	}
+}
+
+// pushNewest puts rec, which is not in the list of recent use, at its newest end. The caller holds
+// s.mu.
+func (s *Store) pushNewest(rec *record) {
+	rec.newer = nil
+	rec.older = s.newest
+	if s.newest != nil {
+		s.newest.newer = rec
+	}
+	s.newest = rec
+	if s.oldest == nil {
+		s.oldest = rec
+	}
+}
+
+// unlink takes rec out of the list of recent use. The caller holds s.mu.
+func (s *Store) unlink(rec *record) {
+	if rec.newer != nil {
+		rec.newer.older = rec.older
+	} else {
+		s.newest = rec.older
+	}
+	if rec.older != nil {
+		rec.older.newer = rec.newer
+	} else {
+		s.oldest = rec.newer
+	}
+	rec.newer, rec.older = nil, nil
+}
+
+// remove drops rec from the map, the list and the heap. The caller holds s.mu.
+func (s *Store) remove(rec *record) {
+	delete(s.records, rec.key)
+	s.unlink(rec)
+	if rec.heapIndex >= 0 {
+		heap.Remove(&s.expiry, rec.heapIndex)
+	}
+	s.bytes -= rec.size()
+}
+
+// expiryHeap orders the records that expire by their expiry time, the earliest first.
+type expiryHeap []*record
+
+func (h expiryHeap) Len() int           { return len(h) }
+func (h expiryHeap) Less(i, j int) bool { return h[i].expiresAt.Before(h[j].expiresAt) }
+
+func (h expiryHeap) Swap(i, j int) {
+	h[i], h[j] = h[j], h[i]
+	h[i].heapIndex = i
+	h[j].heapIndex = j
+}
+
+// Push implements heap.Interface. Only Save pushes, and only records.
+func (h *expiryHeap) Push(x any) {
+	rec, ok := x.(*record)
+	if !ok {
+		return
+	}
+	rec.heapIndex = len(*h)
+	*h = append(*h, rec)
+}
+
+// Pop implements heap.Interface.
+func (h *expiryHeap) Pop() any {
+	old := *h
+	last := len(old) - 1
+	rec := old[last]
+	old[last] = nil
+	rec.heapIndex = -1
+	*h = old[:last]
+
+	return rec
+}
