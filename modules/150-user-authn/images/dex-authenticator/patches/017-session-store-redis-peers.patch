+// The Redis of the replica is filled apart from the probes, which keep watching the neighbours.
+func TestStore_ProbesGoOnWhileTheRedisIsFilled(t *testing.T) {
+	t.Parallel()
+	fakes := newFakeNet()
+	a := fakes.add(addrA)
+	fakes.add(addrB)
+	c := fakes.add(addrC)
+	storeA := startTestStore(t, fakes, addrA, time.Minute)
+	eventually(t, func() bool { return storeA.VerifyConnection(t.Context()) == nil }, "the replica is ready")
+	newTestStore(t, fakes, addrB)
+	newTestStore(t, fakes, addrC)
+	eventually(t, func() bool {
+		peers := storeA.peerSnapshot()
+		return len(peers) == 2 && peers[0].seeded() && peers[1].seeded()
+	}, "the neighbours are seen as filled")
+
+	// The copy takes the whole minute of the filling.
+	fakes.mu.Lock()
+	a.pollsToCopy = 1 << 30
+	fakes.mu.Unlock()
+	a.restart()
+	eventually(t, func() bool { return storeA.isRecovering.Load() }, "the redis of the replica is being filled")
+
+	c.setDown(true)
+	eventually(t, func() bool { return !storeA.peerSnapshot()[1].usable() }, "a neighbour that stalls is left meanwhile")
+	assert.True(t, storeA.isRecovering.Load())
+}
