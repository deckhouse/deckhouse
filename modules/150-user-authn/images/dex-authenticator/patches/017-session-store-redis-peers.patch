+
+// seedNeighbour starts a Redis that is filled and in use: it carries the mark and the sessions.
+func seedNeighbour(t *testing.T, fakes *fakeNet, addr string, sessions ...string) *fakeNode {
+	t.Helper()
+
+	redis := fakes.add(addr)
+	state, err := redis.State(t.Context())
+	require.NoError(t, err)
+	redis.put(seededKey, state.runID)
+	for _, key := range sessions {
+		require.NoError(t, redis.Set(t.Context(), key, []byte("session of "+key), time.Hour))
+	}
+
+	return redis
+}
+
+// assertInUse checks what every filling ends with: a master that refuses nothing and has the mark.
+func assertInUse(t *testing.T, redis *fakeNode) {
+	t.Helper()
+
+	isReplica, isWritable := redis.role()
+	assert.False(t, isReplica, "the redis at %s is detached from the neighbour", redis.addr)
+	assert.False(t, isWritable, "the read-only setting of a replica is restored")
+	assert.True(t, redis.seeded(), "the redis at %s carries its mark", redis.addr)
+}
