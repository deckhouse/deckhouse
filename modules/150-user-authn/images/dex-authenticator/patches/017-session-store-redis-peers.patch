@@ -0,0 +1,39 @@
+package sessions_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/persistence"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/redispeers"
+	"github.com/stretchr/testify/require"
+)
+
+// The session store type redis-peers keeps the sessions over the Redis of every replica, behind
+// the ticket cookie of the persistent stores.
+func TestNewSessionStore_RedisPeers(t *testing.T) {
+	opts := &options.SessionOptions{
+		Type: options.RedisPeersSessionStoreType,
+		// Nothing listens there: the store is created all the same and waits for its Redis.
+		Redis:  options.RedisStoreOptions{ConnectionURL: "redis://127.0.0.1:1/"},
+		Memory: options.MemoryStoreOptions{MaxBytes: 1 << 20},
+		RedisPeers: options.RedisPeersStoreOptions{
+			SeedTimeout: time.Minute,
+			Timeout:     50 * time.Millisecond,
+		},
+	}
+
+	store, err := sessions.NewSessionStore(opts, &options.Cookie{})
+	require.NoError(t, err)
+
+	manager, ok := store.(*persistence.Manager)
+	require.True(t, ok, "got %T", store)
+	peers, ok := manager.Store.(*redispeers.Store)
+	require.True(t, ok, "got %T", manager.Store)
+	t.Cleanup(func() { require.NoError(t, peers.Close()) })
+
+	require.Error(t, store.VerifyConnection(context.Background()), "not ready until its Redis is in use or given up on")
+}
diff --git a/pkg/sessions/memory/lock.go b/pkg/sessions/memory/lock.go
new file mode 100644
index 00000000..4db866cc
--- /dev/null
+++ b/pkg/sessions/memory/lock.go
@@ -0,0 +1,115 @@
+package memory
+
+import (
+	"context"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+)
+
+// lockHold is a lock that is taken: who holds it and until when.
+type lockHold struct {
+	owner     *lock
+	expiresAt time.Time
+}
+
+// lock is the sessions.Lock of one key of a Store. It works within the process only: the requests
+// of one session that reach this replica refresh the session once, as with the Redis of a pod.
+type lock struct {
+	store *Store
+	key   string
+}
+
+var _ sessions.Lock = (*lock)(nil)
+
+// Lock returns the lock of key. Nothing is taken until Obtain.
+func (s *Store) Lock(key string) sessions.Lock {
+	return &lock{store: s, key: key}
+}
+
+// Obtain takes the lock for expiration, or returns sessions.ErrLockNotObtained while another
+// holder has it.
+func (l *lock) Obtain(_ context.Context, expiration time.Duration) error {
+	s := l.store
+	now := s.now()
+
+	s.locksMu.Lock()
+	defer s.locksMu.Unlock()
+
+	if hold, ok := s.locks[l.key]; ok && hold.expiresAt.After(now) {
+		return sessions.ErrLockNotObtained
+	}
+
+	s.purgeLocks(now)
+	s.locks[l.key] = lockHold{owner: l, expiresAt: now.Add(expiration)}
+
+	return nil
+}
+
+// Peek reports whether anyone holds the lock now.
+func (l *lock) Peek(context.Context) (bool, error) {
+	s := l.store
+	now := s.now()
+
+	s.locksMu.Lock()
+	defer s.locksMu.Unlock()
+
+	hold, ok := s.locks[l.key]
+
+	return ok && hold.expiresAt.After(now), nil
+}
+
+// Refresh extends the lock this holder has, or returns sessions.ErrNotLocked.
+func (l *lock) Refresh(_ context.Context, expiration time.Duration) error {
+	s := l.store
+	now := s.now()
+
+	s.locksMu.Lock()
+	defer s.locksMu.Unlock()
+
+	hold, ok := s.locks[l.key]
+	if !ok || hold.owner != l || !hold.expiresAt.After(now) {
+		return sessions.ErrNotLocked
+	}
+
+	s.locks[l.key] = lockHold{owner: l, expiresAt: now.Add(expiration)}
+
+	return nil
+}
+
+// Release gives the lock up. A lock that has expired, or that another holder took after that, is
+// not this holder's any more: sessions.ErrNotLocked.
+func (l *lock) Release(context.Context) error {
+	s := l.store
+	now := s.now()
+
+	s.locksMu.Lock()
+	defer s.locksMu.Unlock()
+
+	hold, ok := s.locks[l.key]
+	if !ok || hold.owner != l {
+		return sessions.ErrNotLocked
+	}
+
+	delete(s.locks, l.key)
+	if !hold.expiresAt.After(now) {
+		return sessions.ErrNotLocked
+	}
+
+	return nil
+}
+
+// purgeLocks drops the expired locks nobody released, so that they do not pile up. The caller
+// holds s.locksMu.
+func (s *Store) purgeLocks(now time.Time) {
+	if len(s.locks) < lockPurgeThreshold || now.Sub(s.lastLockPurge) < lockPurgeInterval {
+		return
+	}
+
+	s.lastLockPurge = now
+	for key, hold := range s.locks {
+		if !hold.expiresAt.After(now) {
+			delete(s.locks, key)
+		}
+	}
+}
diff --git a/pkg/sessions/memory/lock_test.go b/pkg/sessions/memory/lock_test.go
new file mode 100644
index 00000000..2cc2b274
--- /dev/null
+++ b/pkg/sessions/memory/lock_test.go
@@ -0,0 +1,221 @@
+package memory
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLock(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+
+	t.Run("a free lock is obtained", func(t *testing.T) {
+		t.Parallel()
+		store, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+		lock := store.Lock("ticket")
+
+		held, err := lock.Peek(ctx)
+		require.NoError(t, err)
+		assert.False(t, held)
+
+		require.NoError(t, lock.Obtain(ctx, time.Second))
+
+		held, err = lock.Peek(ctx)
+		require.NoError(t, err)
+		assert.True(t, held)
+	})
+
+	t.Run("a held lock is not obtained by another holder", func(t *testing.T) {
+		t.Parallel()
+		store, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+		first, second := store.Lock("ticket"), store.Lock("ticket")
+
+		require.NoError(t, first.Obtain(ctx, time.Second))
+		require.ErrorIs(t, second.Obtain(ctx, time.Second), sessions.ErrLockNotObtained)
+
+		held, err := second.Peek(ctx)
+		require.NoError(t, err)
+		assert.True(t, held)
+	})
+
+	t.Run("the locks of two keys do not meet", func(t *testing.T) {
+		t.Parallel()
+		store, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+
+		require.NoError(t, store.Lock("ticket-a").Obtain(ctx, time.Second))
+		require.NoError(t, store.Lock("ticket-b").Obtain(ctx, time.Second))
+	})
+
+	t.Run("a released lock is obtained again", func(t *testing.T) {
+		t.Parallel()
+		store, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+		first, second := store.Lock("ticket"), store.Lock("ticket")
+
+		require.NoError(t, first.Obtain(ctx, time.Second))
+		require.NoError(t, first.Release(ctx))
+		require.NoError(t, second.Obtain(ctx, time.Second))
+	})
+
+	t.Run("an expired lock is obtained by another holder", func(t *testing.T) {
+		t.Parallel()
+		store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+		first, second := store.Lock("ticket"), store.Lock("ticket")
+
+		require.NoError(t, first.Obtain(ctx, time.Second))
+		clock.Advance(time.Second)
+
+		held, err := second.Peek(ctx)
+		require.NoError(t, err)
+		assert.False(t, held)
+		require.NoError(t, second.Obtain(ctx, time.Second))
+
+		// The first holder lost the lock: it can neither refresh nor release the lock of the second.
+		require.ErrorIs(t, first.Refresh(ctx, time.Second), sessions.ErrNotLocked)
+		require.ErrorIs(t, first.Release(ctx), sessions.ErrNotLocked)
+		require.ErrorIs(t, store.Lock("ticket").Obtain(ctx, time.Second), sessions.ErrLockNotObtained)
+	})
+
+	t.Run("a lock lives for as long as it is asked for", func(t *testing.T) {
+		t.Parallel()
+
+		// Patch 002 asks for the lock of a session for the refresh timeout and 5 seconds more: 15
+		// seconds, where upstream asks for 2.
+		for _, expiration := range []time.Duration{2 * time.Second, 15 * time.Second, 35 * time.Second, time.Hour} {
+			store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+			first, second := store.Lock("ticket"), store.Lock("ticket")
+
+			require.NoError(t, first.Obtain(ctx, expiration))
+			clock.Advance(expiration - time.Nanosecond)
+
+			held, err := second.Peek(ctx)
+			require.NoError(t, err)
+			assert.True(t, held, "a lock of %s is held until its last moment", expiration)
+			require.ErrorIs(t, second.Obtain(ctx, time.Second), sessions.ErrLockNotObtained)
+
+			clock.Advance(time.Nanosecond)
+			require.NoError(t, second.Obtain(ctx, time.Second), "a lock of %s is free once it has passed", expiration)
+		}
+	})
+
+	t.Run("a held lock is released on a context that is done", func(t *testing.T) {
+		t.Parallel()
+		store, _ := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+		first, second := store.Lock("ticket"), store.Lock("ticket")
+
+		require.NoError(t, first.Obtain(ctx, time.Minute))
+
+		done, cancel := context.WithCancel(ctx)
+		cancel()
+		require.NoError(t, first.Release(done))
+		require.NoError(t, second.Obtain(ctx, time.Minute))
+	})
+
+	t.Run("a refresh extends the lock of its holder", func(t *testing.T) {
+		t.Parallel()
+		store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+		first, second := store.Lock("ticket"), store.Lock("ticket")
+
+		require.NoError(t, first.Obtain(ctx, time.Second))
+		clock.Advance(900 * time.Millisecond)
+		require.NoError(t, first.Refresh(ctx, time.Second))
+		clock.Advance(900 * time.Millisecond)
+
+		require.ErrorIs(t, second.Obtain(ctx, time.Second), sessions.ErrLockNotObtained)
+	})
+
+	t.Run("a refresh of a lock that is not held is refused", func(t *testing.T) {
+		t.Parallel()
+		store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+		lock := store.Lock("ticket")
+
+		require.ErrorIs(t, lock.Refresh(ctx, time.Second), sessions.ErrNotLocked)
+
+		require.NoError(t, lock.Obtain(ctx, time.Second))
+		clock.Advance(time.Second)
+		require.ErrorIs(t, lock.Refresh(ctx, time.Second), sessions.ErrNotLocked)
+	})
+
+	t.Run("a release of a lock that is not held is refused", func(t *testing.T) {
+		t.Parallel()
+		store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+		lock := store.Lock("ticket")
+
+		require.ErrorIs(t, lock.Release(ctx), sessions.ErrNotLocked)
+
+		require.NoError(t, lock.Obtain(ctx, time.Second))
+		require.NoError(t, lock.Release(ctx))
+		require.ErrorIs(t, lock.Release(ctx), sessions.ErrNotLocked)
+
+		require.NoError(t, lock.Obtain(ctx, time.Second))
+		clock.Advance(time.Second)
+		require.ErrorIs(t, lock.Release(ctx), sessions.ErrNotLocked)
+	})
+
+	t.Run("expired locks nobody released are purged", func(t *testing.T) {
+		t.Parallel()
+		store, clock := newTestStore(t, options.MemoryStoreOptions{MaxBytes: 1024})
+
+		for i := range lockPurgeThreshold + 10 {
+			require.NoError(t, store.Lock(fmt.Sprintf("ticket-%d", i)).Obtain(ctx, time.Second))
+		}
+		clock.Advance(lockPurgeInterval)
+		require.NoError(t, store.Lock("ticket").Obtain(ctx, time.Second))
+
+		store.locksMu.Lock()
+		defer store.locksMu.Unlock()
+		assert.Len(t, store.locks, 1)
+	})
+}
+
+func TestLock_Concurrent(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+	store, err := NewStore(options.MemoryStoreOptions{MaxBytes: 1024})
+	require.NoError(t, err)
+
+	const (
+		workers    = 32
+		iterations = 500
+	)
+
+	var (
+		wg       sync.WaitGroup
+		inside   atomic.Int32
+		obtained atomic.Int64
+	)
+	for range workers {
+		wg.Go(func() {
+			lock := store.Lock("ticket")
+			for range iterations {
+				if err := lock.Obtain(ctx, time.Minute); err != nil {
+					continue
+				}
+				if n := inside.Add(1); n != 1 {
+					t.Errorf("%d holders are inside the lock", n)
+				}
+				obtained.Add(1)
+				inside.Add(-1)
+				if err := lock.Release(ctx); err != nil {
+					t.Errorf("release: %v", err)
+				}
+			}
+		})
+	}
+	wg.Wait()
+
+	assert.Positive(t, obtained.Load())
+	held, err := store.Lock("ticket").Peek(ctx)
+	require.NoError(t, err)
+	assert.False(t, held)
+}
