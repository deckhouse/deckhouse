+// A Redis that has copied its neighbour and cannot be detached keeps the copy and carries its own
+// mark: it is a replica to be filled again, never a master that looks empty. With the source gone
+// it ends up a master with what it has copied.
+func TestStore_SeedThatCannotDetach(t *testing.T) {
+	t.Parallel()
+	fakes := newFakeNet()
+	a := seedNeighbour(t, fakes, addrA, "ticket")
+	b := fakes.add(addrB)
+	fakes.mu.Lock()
+	b.promoteErrs = 1 << 30
+	fakes.mu.Unlock()
+
+	store := startTestStore(t, fakes, addrB, 200*time.Millisecond)
+	eventually(t, func() bool { return b.seeded() }, "the copy carries the mark of its own redis")
+	isReplica, _ := b.role()
+	assert.True(t, isReplica, "and is still a replica")
+	assert.NotEqual(t, modeRedis, mode(store), "a redis that is not detached is not in use")
+	assert.Contains(t, b.sent(), "MARK")
+	assert.NotContains(t, b.sent(), "REPLICAOF NO ONE")
+
+	a.setDown(true)
+	fakes.mu.Lock()
+	b.promoteErrs = 0
+	fakes.mu.Unlock()
+
+	eventually(t, func() bool { return mode(store) == modeRedis }, "the redis of the replica is in use")
+	assertInUse(t, b)
+	value, err := store.Load(t.Context(), "ticket")
+	require.NoError(t, err, "the copy survived the loss of its source")
+	assert.Equal(t, "session of ticket", string(value))
+}
