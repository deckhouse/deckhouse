+// A write of the neighbour that the filling Redis refuses must not be lost between the end of the
+// copy and the detaching.
+func TestStore_SeedKeepsTheWritesOfTheNeighbour(t *testing.T) {
+	t.Parallel()
+
+	fakes := newFakeNet()
+	a := seedNeighbour(t, fakes, addrA, "old")
+	b := fakes.add(addrB)
+	storeA := newTestStore(t, fakes, addrA)
+
+	// The copy is over and the redis of B is about to be allowed writes: the test steps in here.
+	atWritable, proceed := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	fakes.mu.Lock()
+	b.onWritable = func() {
+		once.Do(func() {
+			close(atWritable)
+			<-proceed
+		})
+	}
+	// The link is slow: what A sends from now on does not reach B until the test lets it.
+	b.isStreamHeld = true
+	fakes.mu.Unlock()
+
+	storeB := startTestStore(t, fakes, addrB, 30*time.Second)
+	<-atWritable
+
+	// The proxy of A saves a session: its own redis takes it, the redis of B refuses it.
+	require.NoError(t, storeA.Save(t.Context(), "refreshed", []byte("new"), time.Hour))
+	assert.InDelta(t, 1, peerWrites(storeA, opSave, resultReadOnly), 0)
+	_, ok := a.has("refreshed")
+	require.True(t, ok)
+	_, ok = b.has("refreshed")
+	require.False(t, ok, "the write is still on its way to B")
+
+	close(proceed)
+
+	// B does not detach while the write is on its way.
+	time.Sleep(4 * seedPollInterval)
+	require.ErrorIs(t, storeB.VerifyConnection(t.Context()), errSeeding)
+	isReplica, isWritable := b.role()
+	assert.True(t, isReplica, "B still copies A")
+	assert.True(t, isWritable, "and already takes the writes sent to it")
+
+	// A write made now is taken by B directly.
+	require.NoError(t, storeA.Save(t.Context(), "direct", []byte("new"), time.Hour))
+	assert.InDelta(t, 1, peerWrites(storeA, opSave, resultOK), 0)
+
+	b.releaseStream()
+	eventually(t, func() bool { return storeB.VerifyConnection(t.Context()) == nil }, "B is ready once it has caught up")
+
+	assertInUse(t, b)
+	for _, key := range []string{"old", "refreshed", "direct"} {
+		_, err := storeB.Load(t.Context(), key)
+		require.NoError(t, err, "B has %q", key)
+	}
+	assert.InDelta(t, 3, loads(storeB, stepOwn), 0, "all three in its own redis")
+}
