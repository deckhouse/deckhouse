+// validateRedisPeersSessionStore refuses the redis-peers session store without a Redis password
+// (Deckhouse patch 017). The Redis of a replica listens on the address of the pod for its
+// neighbours: without requirepass whoever reaches the port reads every session, flushes them or
+// makes that Redis a replica of a Redis of its own. The store is not tested for a connection: its
+// replica starts and keeps the sessions in memory while its Redis is not up yet.
+func validateRedisPeersSessionStore(opts options.RedisStoreOptions) []string {
+	if opts.Password != "" {
+		return []string{}
+	}
+
+	// The store takes the password of the url when --redis-password is empty, as it is parsed here.
+	redisOpts, err := goredis.ParseURL(opts.ConnectionURL)
+	if err != nil {
+		return []string{fmt.Sprintf("unable to parse the redis url of the redis-peers session store: %v", err)}
+	}
+	if redisOpts.Password == "" {
+		return []string{"the redis-peers session store requires a redis password: " +
+			"set --redis-password or put it in --redis-connection-url"}
+	}
+
+	return []string{}
+}
