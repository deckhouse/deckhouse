+// A neighbour that answers but is being filled itself is waited for, not copied half-filled.
+func TestStore_SeedWaitsForANeighbourThatIsBeingFilled(t *testing.T) {
+	t.Parallel()
+
+	t.Run("the neighbour finishes in time", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		seedNeighbour(t, fakes, addrA, "ticket")
+		b := fakes.add(addrB)
+		c := fakes.add(addrC)
+
+		// B copies A and has not been detached yet; C sees only B.
+		require.NoError(t, b.ReplicaOf(t.Context(), "10.0.0.1", "6379"))
+		_, err := b.State(t.Context())
+		require.NoError(t, err)
+
+		store := startTestStore(t, fakes, addrC, 30*time.Second, addrB, addrC)
+		time.Sleep(2 * seedWaitInterval)
+		require.ErrorIs(t, store.VerifyConnection(t.Context()), errSeeding, "C waits for B")
+		assert.Empty(t, c.sent(), "C has not started to copy a redis that is being filled")
+
+		// The proxy of B ends its filling: it detaches its redis and marks it.
+		require.NoError(t, b.Promote(t.Context()))
+		state, err := b.State(t.Context())
+		require.NoError(t, err)
+		require.NoError(t, b.MarkSeeded(t.Context(), state.runID))
+		eventually(t, func() bool { return store.VerifyConnection(t.Context()) == nil }, "C is ready")
+
+		assert.EqualValues(t, 1, seeds(t, store, seedCopied))
+		assert.Equal(t, "REPLICAOF "+addrB, c.sent()[0])
+		_, ok := c.has("ticket")
+		assert.True(t, ok)
+		assertInUse(t, c)
+	})
+
+	t.Run("the neighbour does not finish", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		seedNeighbour(t, fakes, addrA, "ticket")
+		b := fakes.add(addrB)
+		c := fakes.add(addrC)
+		require.NoError(t, b.ReplicaOf(t.Context(), "10.0.0.1", "6379"))
+
+		store := startTestStore(t, fakes, addrC, 2*seedWaitInterval, addrB, addrC)
+		eventually(t, func() bool { return store.VerifyConnection(t.Context()) == nil }, "C is ready once the time is out")
+
+		assert.EqualValues(t, 1, seeds(t, store, seedTimeout))
+		assert.Equal(t, []string{"WRITABLE true", "DROP LOCKS", "MARK", "REPLICAOF NO ONE", "WRITABLE false"}, c.sent(), "C never copied B")
+		assertInUse(t, c)
+	})
+
+	t.Run("a neighbour that has not started to fill is not waited for", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		fakes.add(addrA) // answers, empty, without the mark: its proxy has not decided yet
+		b := fakes.add(addrB)
+
+		started := time.Now()
+		store := startTestStore(t, fakes, addrB, 30*time.Second)
+		eventually(t, func() bool { return store.VerifyConnection(t.Context()) == nil }, "B is ready")
+
+		assert.Less(t, time.Since(started), 5*time.Second)
+		assert.EqualValues(t, 1, seeds(t, store, seedEmpty))
+		assertInUse(t, b)
+	})
+}
