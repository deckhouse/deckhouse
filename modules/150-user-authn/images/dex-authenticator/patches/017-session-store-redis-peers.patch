+// A move of the memory to the Redis of the replica waits for the requests only while they write
+// to that Redis: a neighbour that takes its time with a write does not hold the move.
+func TestStore_SaveDoesNotHoldTheJournalForTheNeighbours(t *testing.T) {
+	t.Parallel()
+	fakes := newFakeNet()
+	a := fakes.add(addrA)
+	fakes.add(addrB)
+	store := newTestStore(t, fakes, addrB)
+	eventually(t, func() bool { return len(store.peerSnapshot()) == 1 }, "the neighbour is known")
+
+	entered, release := make(chan struct{}), make(chan struct{})
+	fakes.mu.Lock()
+	a.onSet = func() {
+		close(entered)
+		<-release
+	}
+	fakes.mu.Unlock()
+
+	saved := make(chan error, 1)
+	go func() {
+		saved <- store.Save(context.WithoutCancel(t.Context()), "ticket", []byte("session"), time.Hour)
+	}()
+
+	<-entered
+	isFree := store.journal.TryLock()
+	if isFree {
+		store.journal.Unlock()
+	}
+	close(release)
+	require.NoError(t, <-saved)
+	assert.True(t, isFree, "the journal is free while the neighbour is written")
+}
