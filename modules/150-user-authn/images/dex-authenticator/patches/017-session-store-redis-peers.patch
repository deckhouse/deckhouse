+func TestValidateRedisSessionStore_RedisPeersModuleFlags(t *testing.T) {
+	args := []string{
+		"--session-store-type=redis-peers",
+		"--redis-connection-url=redis://127.0.0.1:6379/",
+		"--redis-peers-dns-name=shared-da-redis.d8-user-authn",
+		"--redis-peers-self-address=10.0.0.1",
+	}
+
+	tests := []struct {
+		name         string
+		password     string
+		expectedMsgs []string
+	}{
+		{
+			name:         "with the password",
+			password:     "dh-test-secret-Peers1",
+			expectedMsgs: []string{},
+		},
+		{
+			name:     "with an empty password",
+			password: "",
+			expectedMsgs: []string{"the redis-peers session store requires a redis password: " +
+				"set --redis-password or put it in --redis-connection-url"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv("OAUTH2_PROXY_REDIS_PASSWORD", tt.password)
+
+			flagSet := options.NewLegacyFlagSet()
+			require.NoError(t, flagSet.Parse(args))
+			legacy := options.NewLegacyOptions()
+			require.NoError(t, options.Load("", flagSet, legacy))
+			opts, err := legacy.ToOptions()
+			require.NoError(t, err)
+
+			assert.Equal(t, tt.expectedMsgs, validateRedisSessionStore(opts))
+		})
+	}
+}
