new file mode 100644
index 00000000..c1cbb499
--- /dev/null
+++ b/pkg/sessions/redispeers/seed.go
@@ -0,0 +1,309 @@
+package redispeers
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/logger"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/memory"
+)
+
+const (
+	// seedPollInterval is how often the store asks the Redis it fills how far the copy has got.
+	seedPollInterval = 50 * time.Millisecond
+
+	// seedWaitInterval is how often the store looks again for a Redis that does not answer yet, or
+	// for a neighbour that is still being filled itself.
+	seedWaitInterval = 250 * time.Millisecond
+
+	// detachTimeout bounds the end of a filling, which runs even when the filling ran out of time.
+	detachTimeout = 2 * time.Second
+)
+
+// start brings the Redis of the replica into use before the replica is ready. The Redis may start
+// after the proxy, so the store waits for it, for the time a filling may take at most.
+func (s *Store) start(ctx context.Context) {
+	defer s.updateMode()
+
+	ctx, cancel := context.WithTimeout(ctx, s.cfg.seedTimeout)
+	defer cancel()
+
+	for {
+		s.discover(ctx)
+
+		state, err := s.own.node.State(ctx)
+		if err == nil && s.recoverOwn(ctx, state) {
+			if state.isSeeded && !state.isReplica {
+				// The proxy alone has restarted: its Redis has kept the sessions.
+				s.metrics.seedDuration.WithLabelValues(seedKept).Observe(0)
+			}
+
+			return
+		}
+
+		if !sleep(ctx, seedWaitInterval) {
+			logger.Errorf("redis-peers: the redis of the replica is not in use after %s: the replica starts without it", s.cfg.seedTimeout)
+			return
+		}
+	}
+}
+
+// recoverOwn brings the Redis of the replica, which answers again, back into use: it fills it if it
+// is empty, moves to it what the memory has kept, and only then lets the requests read it. It
+// reports whether the Redis is in use.
+func (s *Store) recoverOwn(ctx context.Context, state nodeState) bool {
+	// A Redis without the mark has restarted; one that is a replica was left in the middle of a
+	// filling.
+	if !state.isSeeded || state.isReplica {
+		if err := s.seed(ctx, state.runID); err != nil {
+			logger.Errorf("redis-peers: the redis of the replica is not in use yet: %v", err)
+			return false
+		}
+	}
+
+	// The neighbours see the mark from now on, so the Redis holds the locks from now on too.
+	s.own.set(false, true, state.runID)
+	if !s.moveMemory(ctx) {
+		return false
+	}
+	s.own.set(true, true, state.runID)
+
+	// The requests wrote to the memory until this moment: move what came during the first pass.
+	// What stays is moved by the next probe.
+	s.moveMemory(ctx)
+
+	return true
+}
+
+// seed fills the empty Redis of the replica from a neighbour and leaves it a master that takes
+// writes and carries the mark. Without a neighbour to copy, the Redis starts empty. A copy that
+// fails leaves the Redis without the mark and out of use: it is not a source for the others, and
+// the next attempt copies again, from another neighbour if this one is gone.
+func (s *Store) seed(ctx context.Context, runID string) error {
+	started := time.Now()
+	observe := func(outcome string) {
+		s.metrics.seedDuration.WithLabelValues(outcome).Observe(time.Since(started).Seconds())
+	}
+
+	seedCtx, cancel := context.WithTimeout(ctx, s.cfg.seedTimeout)
+	defer cancel()
+
+	outcome := seedEmpty
+	source, err := s.seedSource(seedCtx)
+	switch {
+	case errors.Is(ctx.Err(), context.Canceled):
+		// The store is closing: the Redis is left as it is.
+		return ctx.Err()
+	case err != nil:
+		// The neighbours did not answer or did not finish their filling in time: nobody has
+		// anything to give.
+		outcome = seedTimeout
+		logger.Errorf("redis-peers: the redis of the replica starts empty: %v", err)
+	case source != nil:
+		if err := s.copyFrom(seedCtx, source); err != nil {
+			if errors.Is(ctx.Err(), context.Canceled) {
+				// The store is closing in the middle of the copy: that is no outcome of a filling.
+				return ctx.Err()
+			}
+			outcome = seedError
+			if errors.Is(err, context.DeadlineExceeded) {
+				outcome = seedTimeout
+			}
+			observe(outcome)
+
+			return err
+		}
+		outcome = seedCopied
+	}
+
+	// The waiting may have run out of time, so the end of a filling has a time of its own.
+	detachCtx, cancelDetach := context.WithTimeout(context.WithoutCancel(ctx), detachTimeout)
+	defer cancelDetach()
+
+	if err := s.detach(detachCtx, runID); err != nil {
+		observe(seedError)
+		return err
+	}
+
+	observe(outcome)
+	logger.Printf("redis-peers: the redis of the replica is in use after %s: %s", time.Since(started).Round(time.Millisecond), outcome)
+
+	return nil
+}
+
+// seedSource returns the neighbour to copy: one whose Redis is filled and is not copying itself.
+// Nil: no neighbour has anything to give, the Redis starts empty.
+//
+// Two replicas that start together with empty Redis do not wait for each other: both answer and
+// neither carries the mark, so each starts empty at once. A neighbour that is being filled itself
+// is waited for: it will carry the mark in a moment, and then it has everything. So is a neighbour
+// that does not answer, and a lookup of the neighbours that fails: either may hide the one Redis
+// that has the sessions, and a Redis marked empty by mistake is copied by the next replica.
+func (s *Store) seedSource(ctx context.Context) (*endpoint, error) {
+	for {
+		isWaiting := !s.discover(ctx)
+		for _, peer := range s.peerSnapshot() {
+			state, err := peer.node.State(ctx)
+			switch {
+			case err != nil:
+				isWaiting = true
+			case state.isSeeded && !state.isReplica:
+				return peer, nil
+			case state.isReplica:
+				isWaiting = true
+			}
+		}
+
+		if !isWaiting {
+			return nil, nil
+		}
+		if !sleep(ctx, seedWaitInterval) {
+			return nil, fmt.Errorf("waiting for the neighbours: %w", ctx.Err())
+		}
+	}
+}
+
+// copyFrom makes the Redis of the replica a copy of the Redis of source by the replication of
+// Redis.
+//
+// While the Redis is a read-only replica it refuses the writes the neighbours send it, but it gets
+// them all the same: a neighbour writes to its own Redis first, which is the one copied here. The
+// gap is between the end of the copy and the detaching: a write refused just before the detaching
+// could still be on its way in the stream. So the Redis is first allowed to take writes while it
+// still copies, and is detached only after it has applied all the source had sent by then. A write
+// refused before that moment is in the stream up to that offset; a write after it is taken directly.
+//
+// A neighbour sends a write to every Redis at once, so one refused here may reach the source a
+// moment later, when the source is the Redis of a third replica. It does so within the time of one
+// request, which is how long the store waits before it asks the source how much it has sent.
+func (s *Store) copyFrom(ctx context.Context, source *endpoint) error {
+	host, port, err := net.SplitHostPort(source.addr)
+	if err != nil {
+		return fmt.Errorf("the address of the neighbour: %w", err)
+	}
+
+	own := s.own.node
+	if err := own.ReplicaOf(ctx, host, port); err != nil {
+		return fmt.Errorf("starting the copy of %s: %w", source.addr, err)
+	}
+
+	isCopied := func(state nodeState) bool { return state.isReplica && state.isLinkUp && !state.isSyncing }
+	if err := s.pollOwn(ctx, source, isCopied); err != nil {
+		return fmt.Errorf("copying %s: %w", source.addr, err)
+	}
+
+	if err := own.SetReplicaWritable(ctx, true); err != nil {
+		return fmt.Errorf("letting the copy take writes: %w", err)
+	}
+
+	if !sleep(ctx, s.cfg.timeout) {
+		return fmt.Errorf("waiting for the last writes to reach %s: %w", source.addr, ctx.Err())
+	}
+
+	sent, err := source.node.State(ctx)
+	if err != nil {
+		return fmt.Errorf("asking %s how much it has sent: %w", source.addr, err)
+	}
+
+	hasCaughtUp := func(state nodeState) bool { return isCopied(state) && state.offset >= sent.offset }
+	if err := s.pollOwn(ctx, source, hasCaughtUp); err != nil {
+		return fmt.Errorf("catching up with %s: %w", source.addr, err)
+	}
+
+	return nil
+}
+
+// pollOwn asks the Redis of the replica for its state until isDone says so. A source that stops
+// answering will not finish the copy, so it is not waited for until the time runs out.
+func (s *Store) pollOwn(ctx context.Context, source *endpoint, isDone func(nodeState) bool) error {
+	failures := 0
+	for {
+		state, err := s.own.node.State(ctx)
+		if err != nil {
+			return err
+		}
+		if isDone(state) {
+			return nil
+		}
+
+		if _, err := source.node.State(ctx); err == nil {
+			failures = 0
+		} else if failures++; failures >= failuresToLeave {
+			return fmt.Errorf("the neighbour does not answer: %w", err)
+		}
+
+		if !sleep(ctx, seedPollInterval) {
+			return ctx.Err()
+		}
+	}
+}
+
+// detach makes the Redis of the replica a master with the mark. A Redis that was not a replica
+// gets the mark and is otherwise not changed by it.
+//
+// The mark is set while the Redis is still a replica that takes writes, before it is detached. In
+// the other order a step that fails after the detaching leaves a master with a full copy and no
+// mark: it looks empty, and a neighbour that starts then, with the source gone, marks itself as
+// the one that starts empty and is copied later instead of this copy. A marked Redis that is
+// still a replica is not in use and is filled again.
+func (s *Store) detach(ctx context.Context, runID string) error {
+	own := s.own.node
+	// A replica left by an attempt that failed refuses writes.
+	if err := own.SetReplicaWritable(ctx, true); err != nil {
+		return fmt.Errorf("letting the redis take the mark: %w", err)
+	}
+	// A copy brings the refresh locks of the neighbour along. They are released there, not here, so
+	// here they would hold their sessions until they expire. They go before the mark: with the mark
+	// a neighbour may take a lock here. The mark the copy has brought is that of the neighbour.
+	if err := own.DropLocks(ctx); err != nil {
+		logger.Errorf("redis-peers: the locks copied from the neighbour were not removed and expire by themselves: %v", err)
+	}
+	if err := own.MarkSeeded(ctx, runID); err != nil {
+		return fmt.Errorf("marking the redis as filled: %w", err)
+	}
+	if err := own.Promote(ctx); err != nil {
+		return fmt.Errorf("detaching the redis from the neighbour: %w", err)
+	}
+	if err := own.SetReplicaWritable(ctx, false); err != nil {
+		return fmt.Errorf("restoring the read-only setting of a replica: %w", err)
+	}
+
+	return nil
+}
+
+// moveMemory gives what the memory has kept to the Redis of the replica: the sessions no Redis took
+// and the removals this one did not take. It reports whether Redis took them all. Each one is
+// moved with the requests held off, so a request never writes between the two halves of a move;
+// what a request has written again since the memory was read stays for the next pass.
+func (s *Store) moveMemory(ctx context.Context) bool {
+	for _, item := range s.memory.Items() {
+		if err := s.moveItem(ctx, item); err != nil {
+			s.observe(ctx, s.own, err)
+			logger.Errorf("redis-peers: the memory still holds what the redis of the replica did not take: %v", err)
+
+			return false
+		}
+	}
+
+	return true
+}
+
+func (s *Store) moveItem(ctx context.Context, item memory.Item) error {
+	s.journal.Lock()
+	defer s.journal.Unlock()
+
+	if kept, ok := s.memory.Peek(item.Key); !ok || !bytes.Equal(kept, item.Value) {
+		return nil
+	}
+	// The memory holds it until Redis has it, so a request finds it in one of them.
+	if err := apply(ctx, s.own.node, item.Key, item.Value, item.TTL); err != nil {
+		return err
+	}
+	s.metrics.moved.Inc()
+
+	return s.memory.Clear(ctx, item.Key)
+}
