+func newTestStore(t *testing.T, opts options.MemoryStoreOptions) (*Store, *fakeClock) {
+	t.Helper()
+
+	store, err := NewStore(opts)
+	require.NoError(t, err)
+
+	clock := newFakeClock()
+	store.now = clock.Now
+
+	return store, clock
+}
+
+// recordSize is what a record with this key and value counts against the limit of the store.
+func recordSize(key string, value []byte) int64 {
+	return int64(len(key)) + int64(len(value)) + recordOverhead
+}
+
+// checkInvariants compares the bookkeeping of the store with its records.
+func checkInvariants(t *testing.T, s *Store) {
+	t.Helper()
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	var size int64
+	expiring := 0
+	for key, rec := range s.records {
+		assert.Equal(t, key, rec.key)
+		size += rec.size()
+		if !rec.expiresAt.IsZero() {
+			expiring++
+			require.GreaterOrEqual(t, rec.heapIndex, 0)
+			require.Less(t, rec.heapIndex, len(s.expiry))
+			assert.Same(t, rec, s.expiry[rec.heapIndex])
+		} else {
+			assert.Equal(t, -1, rec.heapIndex)
+		}
+	}
+	assert.Equal(t, size, s.bytes, "bytes of the store")
+	assert.LessOrEqual(t, s.bytes, s.maxBytes, "limit of the store")
+	assert.Len(t, s.expiry, expiring, "heap of expiry times")
+
+	listed := 0
+	var newer *record
+	for rec := s.newest; rec != nil; rec = rec.older {
+		listed++
+		assert.Same(t, newer, rec.newer)
+		assert.Same(t, rec, s.records[rec.key])
+		newer = rec
+	}
+	assert.Same(t, newer, s.oldest)
+	assert.Equal(t, len(s.records), listed, "list of recent use")
+}
