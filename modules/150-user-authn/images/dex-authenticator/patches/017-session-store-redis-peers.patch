+// A lookup of the neighbours that fails says nothing about them: the replica waits for it until
+// the time of a filling is out, and only then starts empty.
+func TestStore_SeedWaitsForTheLookup(t *testing.T) {
+	t.Parallel()
+	fakes := newFakeNet()
+	seedNeighbour(t, fakes, addrA, "ticket")
+	b := fakes.add(addrB)
+	fakes.mu.Lock()
+	fakes.resolveErr = errors.New("lookup: no such host")
