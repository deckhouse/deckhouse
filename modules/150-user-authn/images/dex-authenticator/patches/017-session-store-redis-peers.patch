+func TestStore_Seed(t *testing.T) {
+	t.Parallel()
+
+	t.Run("an empty redis is filled from the neighbour before the replica is ready", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		a := seedNeighbour(t, fakes, addrA, "ticket-1", "ticket-2")
+		b := fakes.add(addrB)
+		fakes.mu.Lock()
+		b.pollsToCopy = 3
+		fakes.mu.Unlock()
+
+		store := newTestStore(t, fakes, addrB)
+
+		for _, key := range []string{"ticket-1", "ticket-2"} {
+			value, err := store.Load(t.Context(), key)
+			require.NoError(t, err)
+			assert.Equal(t, "session of "+key, string(value))
+		}
+		assert.InDelta(t, 2, loads(store, stepOwn), 0, "the sessions are in the redis of the replica")
+		assert.EqualValues(t, 1, seeds(t, store, seedCopied))
+		assertInUse(t, b)
+		assert.Equal(t, []string{"REPLICAOF " + addrA, "WRITABLE true", "WRITABLE true", "DROP LOCKS", "MARK", "REPLICAOF NO ONE", "WRITABLE false"}, b.sent(),
+			"the copied locks go before the mark lets a neighbour take a lock here, and the mark before the redis is detached")
+		assert.Empty(t, a.sent(), "the neighbour is only read")
+	})
+
+	t.Run("a redis that kept its data is not filled", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		seedNeighbour(t, fakes, addrA, "ticket-a")
+		b := seedNeighbour(t, fakes, addrB, "ticket-b")
+
+		store := newTestStore(t, fakes, addrB)
+
+		assert.EqualValues(t, 1, seeds(t, store, seedKept))
+		assert.Empty(t, b.sent(), "the redis is left as it is")
+		_, ok := b.has("ticket-b")
+		assert.True(t, ok)
+	})
+
+	t.Run("the locks of the neighbour are not copied", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		a := seedNeighbour(t, fakes, addrA, "ticket")
+		held := a.Lock("ticket")
+		require.NoError(t, held.Obtain(t.Context(), time.Minute))
+		b := fakes.add(addrB)
+
+		store := newTestStore(t, fakes, addrB)
+
+		_, ok := b.has("ticket")
+		require.True(t, ok)
+		_, ok = b.has("ticket.lock")
+		assert.False(t, ok, "the copy of the lock is removed")
+		isHeld, err := store.own.node.Lock("ticket").Peek(t.Context())
+		require.NoError(t, err)
+		assert.False(t, isHeld)
+
+		isHeld, err = held.Peek(t.Context())
+		require.NoError(t, err)
+		assert.True(t, isHeld, "the lock itself is still held in the redis of the neighbour")
+	})
+
+	t.Run("a filling that runs out of time leaves the redis out of use until it is over", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		seedNeighbour(t, fakes, addrA, "ticket")
+		b := fakes.add(addrB)
+		fakes.mu.Lock()
+		b.pollsToCopy = 1 << 30
+		fakes.mu.Unlock()
+
+		store := startTestStore(t, fakes, addrB, 200*time.Millisecond)
+		require.ErrorIs(t, store.VerifyConnection(t.Context()), errSeeding)
+		eventually(t, func() bool { return store.VerifyConnection(t.Context()) == nil }, "the replica is ready once the time is out")
+
+		assert.Positive(t, seeds(t, store, seedTimeout))
+		assert.False(t, b.seeded(), "a half-copied redis is not a source for the others: the mark it has copied is not its own")
+		assert.Equal(t, modePeer, mode(store))
+
+		// The session it has not copied yet is found at the neighbour.
+		value, err := store.Load(t.Context(), "ticket")
+		require.NoError(t, err)
+		assert.Equal(t, "session of ticket", string(value))
+		assert.InDelta(t, 1, loads(store, stepPeer), 0)
+
+		fakes.mu.Lock()
+		b.pollsLeft = 0
+		fakes.mu.Unlock()
+		eventually(t, func() bool { return mode(store) == modeRedis }, "the copy is over and the redis is in use")
+		assert.EqualValues(t, 1, seeds(t, store, seedCopied))
+		assertInUse(t, b)
+		_, ok := b.has("ticket")
+		assert.True(t, ok)
+	})
+
+	t.Run("a neighbour that goes away in the middle of the copy is not waited for: another one is copied", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		a := seedNeighbour(t, fakes, addrA, "ticket")
+		b := fakes.add(addrB)
+		seedNeighbour(t, fakes, addrC, "ticket")
+		fakes.mu.Lock()
+		b.pollsToCopy = 1 << 30
+		fakes.mu.Unlock()
+
+		started := time.Now()
+		store := startTestStore(t, fakes, addrB, 30*time.Second)
+		eventually(t, func() bool { isReplica, _ := b.role(); return isReplica }, "the copy of the first neighbour has started")
+		fakes.mu.Lock()
+		b.pollsToCopy = 1
+		fakes.mu.Unlock()
+		a.setDown(true)
+
+		eventually(t, func() bool { return store.VerifyConnection(t.Context()) == nil }, "the replica is ready")
+		assert.Less(t, time.Since(started), 5*time.Second, "far sooner than the time a filling may take")
+		assert.EqualValues(t, 1, seeds(t, store, seedError))
+		assert.EqualValues(t, 1, seeds(t, store, seedCopied))
+		assert.Equal(t, []string{"REPLICAOF " + addrA, "REPLICAOF " + addrC}, b.sent()[:2])
+		assertInUse(t, b)
+		_, ok := b.has("ticket")
+		assert.True(t, ok)
+	})
+
+	t.Run("a neighbour that does not answer is waited for, not taken for an empty one", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		a := seedNeighbour(t, fakes, addrA, "ticket")
+		b := fakes.add(addrB)
+		a.setDown(true)
+
+		store := startTestStore(t, fakes, addrB, 30*time.Second)
+		time.Sleep(2 * seedWaitInterval)
+		require.ErrorIs(t, store.VerifyConnection(t.Context()), errSeeding)
+		assert.Empty(t, b.sent(), "the redis is not marked empty while a neighbour may have the sessions")
+
+		a.setDown(false)
+		eventually(t, func() bool { return store.VerifyConnection(t.Context()) == nil }, "the replica is ready")
+		assert.EqualValues(t, 1, seeds(t, store, seedCopied))
+		assert.Zero(t, seeds(t, store, seedEmpty))
+		_, ok := b.has("ticket")
+		assert.True(t, ok)
+	})
+
+	t.Run("a redis that does not answer while it loads the copy is asked again", func(t *testing.T) {
+		t.Parallel()
+		fakes := newFakeNet()
+		seedNeighbour(t, fakes, addrA, "ticket")
+		b := fakes.add(addrB)
+		fakes.mu.Lock()
+		b.pollsToCopy, b.copyErrs = 3, 1
+		fakes.mu.Unlock()
+
+		store := newTestStore(t, fakes, addrB)
+
+		assert.EqualValues(t, 1, seeds(t, store, seedError))
+		assert.EqualValues(t, 1, seeds(t, store, seedCopied))
+		assert.Equal(t, []string{"REPLICAOF " + addrA, "REPLICAOF " + addrA, "WRITABLE true", "WRITABLE true", "DROP LOCKS", "MARK", "REPLICAOF NO ONE", "WRITABLE false"}, b.sent(),
+			"the redis is not detached before the copy is over and the last writes have come")
+		_, err := store.Load(t.Context(), "ticket")
+		require.NoError(t, err)
+		assert.InDelta(t, 1, loads(store, stepOwn), 0)
+	})
+}
