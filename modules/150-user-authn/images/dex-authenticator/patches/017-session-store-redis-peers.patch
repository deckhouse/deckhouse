@@ -0,0 +1,62 @@
+package options
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// The flags of the redis-peers session store reach the options of the session store.
+func TestRedisPeersStoreOptions(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name     string
+		args     []string
+		expected RedisPeersStoreOptions
+	}{
+		{
+			name: "the defaults",
+			args: []string{"--session-store-type=redis-peers"},
+			expected: RedisPeersStoreOptions{
+				SeedTimeout: DefaultRedisPeersSeedTimeout,
+				Timeout:     DefaultRedisPeersTimeout,
+			},
+		},
+		{
+			name: "every flag",
+			args: []string{
+				"--session-store-type=redis-peers",
+				"--redis-peers-dns-name=shared-da-redis.d8-user-authn.svc.cluster.local",
+				"--redis-peers-self-address=10.0.0.1",
+				"--redis-peers-seed-timeout=20s",
+				"--redis-peers-timeout=300ms",
+			},
+			expected: RedisPeersStoreOptions{
+				DNSName:     "shared-da-redis.d8-user-authn.svc.cluster.local",
+				SelfAddress: "10.0.0.1",
+				SeedTimeout: 20 * time.Second,
+				Timeout:     300 * time.Millisecond,
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			flagSet := NewLegacyFlagSet()
+			require.NoError(t, flagSet.Parse(tt.args))
+
+			legacy := NewLegacyOptions()
+			require.NoError(t, Load("", flagSet, legacy))
+			opts, err := legacy.ToOptions()
+			require.NoError(t, err)
+
+			assert.Equal(t, RedisPeersSessionStoreType, opts.Session.Type)
+			assert.Equal(t, tt.expected, opts.Session.RedisPeers)
+		})
+	}
+}
diff --git a/pkg/middleware/deckhouse_memory_store_refresh_test.go b/pkg/middleware/deckhouse_memory_store_refresh_test.go
new file mode 100644
index 00000000..a2d56195
--- /dev/null
+++ b/pkg/middleware/deckhouse_memory_store_refresh_test.go
@@ -0,0 +1,263 @@
+package middleware
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	middlewareapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/middleware"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/options"
+	sessionsapi "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/memory"
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/sessions/persistence"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// The tests of this file repeat the lock tests of patch 002 with the memory store of patch 017 and
+// its lock in place of a fake: the cookie, the ticket and the persistence.Manager are the real ones.
+
+const (
+	memoryStoreTestUser = "user@example.com"
+	// memoryStoreTestSecret is a cookie secret of 32 bytes.
+	memoryStoreTestSecret = "dh-test-secret-0123456789abcdef0"
+)
+
+// lockWatch is a persistence.Store that remembers the key of the last lock asked for and counts the
+// releases its lock refused: a holder whose lock had expired or passed to another request.
+type lockWatch struct {
+	persistence.Store
+
+	mu      sync.Mutex
+	key     string
+	notHeld int
+}
+
+func (w *lockWatch) Lock(key string) sessionsapi.Lock {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.key = key
+
+	return &watchedLock{Lock: w.Store.Lock(key), watch: w}
+}
+
+// isFree reports whether nobody holds the lock of the session.
+func (w *lockWatch) isFree(t *testing.T) bool {
+	t.Helper()
+
+	w.mu.Lock()
+	key := w.key
+	w.mu.Unlock()
+	require.NotEmpty(t, key, "no request asked for the lock of the session")
+
+	held, err := w.Store.Lock(key).Peek(context.Background())
+	require.NoError(t, err)
+
+	return !held
+}
+
+func (w *lockWatch) releasesNotHeld() int {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+
+	return w.notHeld
+}
+
+type watchedLock struct {
+	sessionsapi.Lock
+	watch *lockWatch
+}
+
+func (l *watchedLock) Release(ctx context.Context) error {
+	err := l.Lock.Release(ctx)
+	if err != nil {
+		l.watch.mu.Lock()
+		l.watch.notHeld++
+		l.watch.mu.Unlock()
+	}
+
+	return err
+}
+
+// memoryStoreSession is one session of a browser behind the memory store and a dex that takes
+// refreshDelay to answer a refresh.
+type memoryStoreSession struct {
+	watch   *lockWatch
+	loader  *storedSessionLoader
+	cookies []*http.Cookie
+
+	refreshes atomic.Int32
+}
+
+// newMemoryStoreSession signs a user in an hour ago, so the session is due for a refresh. With
+// dropped the store no longer has the session, as after an eviction or a restart of the pod, and
+// the cookie alone restores it.
+func newMemoryStoreSession(t *testing.T, refreshDelay time.Duration, dropped bool) *memoryStoreSession {
+	t.Helper()
+
+	cookieOpts := &options.Cookie{Name: "_oauth2_proxy", Secret: memoryStoreTestSecret, Expire: 24 * time.Hour}
+	newStore := func() persistence.Store {
+		store, err := memory.NewStore(options.MemoryStoreOptions{MaxBytes: 1 << 20})
+		require.NoError(t, err)
+
+		return store
+	}
+
+	s := &memoryStoreSession{watch: &lockWatch{Store: newStore()}}
+
+	createdAt := time.Now().Add(-time.Hour)
+	signIn := httptest.NewRecorder()
+	require.NoError(t, persistence.NewManager(s.watch, cookieOpts).Save(
+		signIn,
+		httptest.NewRequest(http.MethodGet, "https://app.example.com/", nil),
+		&sessionsapi.SessionState{CreatedAt: &createdAt, User: memoryStoreTestUser, RefreshToken: "refresh-token", IDToken: "id-token"},
+	))
+	s.cookies = signIn.Result().Cookies()
+	require.NotEmpty(t, s.cookies)
+
+	if dropped {
+		s.watch = &lockWatch{Store: newStore()}
+	}
+
+	s.loader = newStoredSessionLoader(&StoredSessionLoaderOptions{
+		SessionStore:  persistence.NewManager(s.watch, cookieOpts),
+		RefreshPeriod: time.Minute,
+		RefreshSession: func(ctx context.Context, ss *sessionsapi.SessionState) (bool, error) {
+			n := s.refreshes.Add(1)
+			select {
+			case <-ctx.Done():
+				return false, fmt.Errorf("failed to get token: %w", ctx.Err())
+			case <-time.After(refreshDelay):
+			}
+			ss.User = memoryStoreTestUser
+			ss.IDToken = "id-token"
+			ss.RefreshToken = fmt.Sprintf("rotated-refresh-token-%d", n)
+
+			return true, nil
+		},
+		ValidateSession: func(context.Context, *sessionsapi.SessionState) bool { return true },
+	})
+
+	return s
+}
+
+// serve sends one request of the browser through the loader.
+func (s *memoryStoreSession) serve(ctx context.Context) *middlewareapi.RequestScope {
+	scope := &middlewareapi.RequestScope{}
+	req := httptest.NewRequestWithContext(ctx, http.MethodGet, "https://app.example.com/", nil)
+	for _, cookie := range s.cookies {
+		req.AddCookie(cookie)
+	}
+	req = middlewareapi.AddRequestScope(req, scope)
+	s.loader.loadSession(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {})).ServeHTTP(httptest.NewRecorder(), req)
+
+	return scope
+}
+
+// One refresh of a session runs at a time with the lock of the memory store, as with the lock of
+// Redis: the lock outlives the refresh, and the requests that wait for it get the refreshed session.
+// A session the store has dropped is restored from its cookie once, however many requests bring it.
+func TestMemoryStoreLockOutlivesTheRefresh(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name          string
+		refreshDelay  time.Duration
+		obtainTimeout time.Duration
+		dropped       bool
+		requests      int
+		// laterUnavailable is how many requests after the first answer that the session cannot be
+		// refreshed now.
+		laterUnavailable int
+	}{
+		{
+			name:         "a refresh longer than the lock of upstream",
+			refreshDelay: 2500 * time.Millisecond,
+			requests:     3,
+		},
+		{
+			name:         "a session the store has dropped",
+			refreshDelay: 300 * time.Millisecond,
+			dropped:      true,
+			requests:     10,
+		},
+		{
+			name:             "the wait for the lock runs out",
+			refreshDelay:     600 * time.Millisecond,
+			obtainTimeout:    200 * time.Millisecond,
+			requests:         3,
+			laterUnavailable: 2,
+		},
+		{
+			name:         "a healthy dex",
+			refreshDelay: 20 * time.Millisecond,
+			requests:     10,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			session := newMemoryStoreSession(t, tt.refreshDelay, tt.dropped)
+			if tt.obtainTimeout > 0 {
+				session.loader.obtainTimeout = tt.obtainTimeout
+			}
+
+			scopes := make([]*middlewareapi.RequestScope, tt.requests)
+			var wg sync.WaitGroup
+			wg.Go(func() { scopes[0] = session.serve(t.Context()) })
+			// The other requests of the session come once the first holds the lock.
+			require.Eventually(t, func() bool { return session.refreshes.Load() == 1 }, time.Second, time.Millisecond)
+			for i := 1; i < tt.requests; i++ {
+				wg.Go(func() { scopes[i] = session.serve(t.Context()) })
+			}
+			wg.Wait()
+
+			assert.EqualValues(t, 1, session.refreshes.Load(), "one refresh through dex for the session")
+			require.NotNil(t, scopes[0].Session, "the refreshing request gets the session")
+			assert.False(t, scopes[0].SessionUnavailable)
+			assert.Equal(t, "rotated-refresh-token-1", scopes[0].Session.RefreshToken)
+
+			unavailable := 0
+			for i, scope := range scopes[1:] {
+				if scope.SessionUnavailable {
+					unavailable++
+					continue
+				}
+				if assert.NotNil(t, scope.Session, "request %d gets the refreshed session", i+1) {
+					assert.Equal(t, memoryStoreTestUser, scope.Session.User, "request %d gets the user, not the stub", i+1)
+				}
+			}
+			assert.Equal(t, tt.laterUnavailable, unavailable)
+			assert.Zero(t, session.watch.releasesNotHeld(), "the lock is held until its refresh releases it")
+			assert.True(t, session.watch.isFree(t))
+
+			// The next request finds the refreshed session in the store and does not refresh it.
+			next := session.serve(t.Context())
+			require.NotNil(t, next.Session)
+			assert.Equal(t, memoryStoreTestUser, next.Session.User)
+			assert.EqualValues(t, 1, session.refreshes.Load())
+		})
+	}
+}
+
+// The lock of the memory store is released when the client that started the refresh has hung up.
+func TestMemoryStoreLockReleasedForAClientThatHungUp(t *testing.T) {
+	t.Parallel()
+
+	session := newMemoryStoreSession(t, 20*time.Millisecond, false)
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+
+	scope := session.serve(ctx)
+	assert.NotNil(t, scope.Session)
+	assert.EqualValues(t, 1, session.refreshes.Load())
+	assert.Zero(t, session.watch.releasesNotHeld())
+	assert.True(t, session.watch.isFree(t), "the lock is released")
+}
diff --git a/pkg/sessions/deckhouse_redis_peers_test.go b/pkg/sessions/deckhouse_redis_peers_test.go
