+// clientScopeOptions returns the options of a client of a table of clients: valid, with a Redis
+// nobody listens on and a provider CA file that does not exist.
+func clientScopeOptions() *options.Options {
+	o := options.NewOptions()
+	o.Cookie.Secret = "dh-test-secret-0123456789abcdef0"
+	o.EmailDomains = []string{"*"}
+	o.Providers[0].ID = "dex"
+	o.Providers[0].ClientID = "dex-authenticator-app"
+	o.Providers[0].ClientSecret = "dh-test-secret-0123456789abcdef"
+	o.Providers[0].CAFiles = []string{"/does/not/exist/ca.crt"}
+	o.Session.Type = options.RedisSessionStoreType
+	o.Session.Redis.ConnectionURL = "redis://127.0.0.1:1"
+
+	return o
+}
+
+// TestValidateClient checks that the validation of a client of a table of clients leaves the
+// state of the process alone: it runs while the process serves the other clients.
+func TestValidateClient(t *testing.T) {
+	// Not parallel: the test watches the transport of the process.
+	transport, ok := requests.DefaultTransport.(*http.Transport)
+	require.True(t, ok)
+	tlsBefore := transport.TLSClientConfig
+
+	t.Run("a valid client passes without Redis and without the provider CA", func(t *testing.T) {
+		start := time.Now()
+
+		require.NoError(t, ValidateClient(clientScopeOptions()))
+
+		assert.Less(t, time.Since(start), redisConnectionTestInterval, "the connection to Redis must not be tried")
+		assert.Same(t, tlsBefore, transport.TLSClientConfig, "the transport of the process must not change")
+	})
+
+	t.Run("the options of the client are checked", func(t *testing.T) {
+		tests := []struct {
+			name      string
+			modify    func(*options.Options)
+			expectErr string
+		}{
+			{name: "no client id", modify: func(o *options.Options) { o.Providers[0].ClientID = "" }, expectErr: "client-id"},
+			{name: "no client secret", modify: func(o *options.Options) { o.Providers[0].ClientSecret = "" }, expectErr: "client-secret"},
+			{name: "no cookie secret", modify: func(o *options.Options) { o.Cookie.Secret = "" }, expectErr: "cookie-secret"},
+			{name: "cookie secret of a wrong length", modify: func(o *options.Options) { o.Cookie.Secret = "dh-test-secret-012" }, expectErr: "cookie_secret"},
+			{name: "no email validation", modify: func(o *options.Options) { o.EmailDomains = nil }, expectErr: "email validation"},
+			{name: "bad redirect url", modify: func(o *options.Options) { o.RawRedirectURL = "://" }, expectErr: "redirect-url"},
+		}
+
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				o := clientScopeOptions()
+				tt.modify(o)
+
+				require.ErrorContains(t, ValidateClient(o), tt.expectErr)
+				assert.Same(t, tlsBefore, transport.TLSClientConfig)
+			})
+		}
+	})
+
+	t.Run("the redirect url and the client address parser are set, as the proxy needs them", func(t *testing.T) {
+		o := clientScopeOptions()
+		o.RawRedirectURL = "/dex-authenticator/callback"
+		o.ReverseProxy = true
+
+		require.NoError(t, ValidateClient(o))
+
+		require.NotNil(t, o.GetRedirectURL())
+		assert.Equal(t, "/dex-authenticator/callback", o.GetRedirectURL().Path)
+		assert.NotNil(t, o.GetRealClientIPParser())
+	})
+}
+
+// TestValidateProcess checks that the options of a process that serves a table of clients are
+// valid without a client, and that what belongs to the process is still checked.
+func TestValidateProcess(t *testing.T) {
+	// Not parallel: ValidateProcess sets the logger of the process.
+	t.Run("options without a client pass", func(t *testing.T) {
+		o := options.NewOptions()
+		o.Session.Type = options.RedisPeersSessionStoreType
+		o.Session.Redis.ConnectionURL = "redis://127.0.0.1:1/"
+		o.Session.Redis.Password = "dh-test-secret-0123456789abcdef"
