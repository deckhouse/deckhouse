+package oidc
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestRemoteKeySet(t *testing.T) {
+	// Not parallel: the test turns the sharing of the process on and off.
+	ctx := context.Background()
+
+	t.Run("without sharing every call gets a key set of its own", func(t *testing.T) {
+		first := remoteKeySet(ctx, "https://dex.example.com/keys")
+		second := remoteKeySet(ctx, "https://dex.example.com/keys")
+
+		assert.NotSame(t, first, second)
+	})
+
+	t.Run("with sharing a url has one key set", func(t *testing.T) {
+		ShareRemoteKeySets()
+		t.Cleanup(func() {
+			sharedKeySets.mu.Lock()
+			defer sharedKeySets.mu.Unlock()
+			sharedKeySets.enabled = false
+			sharedKeySets.byURL = nil
+		})
+
+		first := remoteKeySet(ctx, "https://dex.example.com/keys")
+		second := remoteKeySet(ctx, "https://dex.example.com/keys")
+		other := remoteKeySet(ctx, "https://other.example.com/keys")
+
+		assert.Same(t, first, second)
+		assert.NotSame(t, first, other)
+	})
+}
