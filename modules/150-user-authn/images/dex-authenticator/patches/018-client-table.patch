+// stubBuilder builds the handlers of a table under test and counts the builds.
+type stubBuilder struct {
+	mu     sync.Mutex
+	builds map[string]int
+	fail   map[string]bool
+}
+
+func newStubBuilder() *stubBuilder {
+	return &stubBuilder{builds: map[string]int{}, fail: map[string]bool{}}
+}
+
+// build returns a handler that answers with the name of the client and the number of its build.
+func (b *stubBuilder) build(spec clientSpec) (http.Handler, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	if b.fail[spec.Name] {
+		return nil, errors.New("the client cannot be built")
+	}
+	b.builds[spec.Name]++
+	body := fmt.Sprintf("%s#%d", spec.Name, b.builds[spec.Name])
+
+	return http.HandlerFunc(func(rw http.ResponseWriter, _ *http.Request) {
+		_, _ = rw.Write([]byte(body))
+	}), nil
+}
+
+func (b *stubBuilder) count(name string) int {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	return b.builds[name]
+}
+
+func (b *stubBuilder) setFail(name string, fail bool) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	b.fail[name] = fail
+}
+
+func newTestTableProxy(t *testing.T, build func(clientSpec) (http.Handler, error)) *clientTableProxy {
+	t.Helper()
+
+	path := filepath.Join(t.TempDir(), "clients.json")
+
+	return newClientTableProxy(path, "/dex-authenticator", build, newTestMetrics(t))
+}
+
+func writeTable(t *testing.T, p *clientTableProxy, specs ...clientSpec) {
+	t.Helper()
+
+	// A rename puts the whole file in place at once, as the kubelet does with a Secret.
+	tmp := p.path + ".tmp"
+	require.NoError(t, os.WriteFile(tmp, encodeTable(t, specs...), 0o600))
+	require.NoError(t, os.Rename(tmp, p.path))
+}
+
+// get asks the dispatcher for a browser path on host and returns the status and the body.
+func get(t *testing.T, d *dispatcher, host string) (int, string) {
+	t.Helper()
+
+	req := httptest.NewRequest(http.MethodGet, "http://"+host+"/dex-authenticator/sign_in", nil)
+	rw := httptest.NewRecorder()
+	d.ServeHTTP(rw, req)
+
+	return rw.Code, rw.Body.String()
+}
+
+// reloadCount returns how many reloads of the table ended with result.
+func reloadCount(t *testing.T, p *clientTableProxy, result string) uint64 {
+	t.Helper()
+
+	histogram, ok := p.metrics.reloads.WithLabelValues(result).(prometheus.Histogram)
+	require.True(t, ok)
+	var metric dto.Metric
+	require.NoError(t, histogram.Write(&metric))
+
+	return metric.GetHistogram().GetSampleCount()
+}
