+		require.NoError(t, ValidateProcess(o))
+	})
+
+	t.Run("the provider CA is checked", func(t *testing.T) {
+		o := options.NewOptions()
+		o.Providers[0].CAFiles = []string{"/does/not/exist/ca.crt"}
+
+		require.ErrorContains(t, ValidateProcess(o), "unable to load provider CA file")
+	})
+
+	t.Run("the client address header is checked", func(t *testing.T) {
+		o := options.NewOptions()
+		o.ReverseProxy = true
+		o.RealClientIPHeader = "X-No-Such-Header"
+
+		require.ErrorContains(t, ValidateProcess(o), "real_client_ip_header")
+	})
+}
