+			expectClient: "b", expectForwardedHost: "shared.example.com",
+		},
+		{
+			name: "shared host through the service without a cluster domain",
+			path: authPath, host: "b-dex-authenticator.ns-b.svc", originalURL: []string{"https://shared.example.com/"},
+			expectClient: "b", expectForwardedHost: "shared.example.com",
+		},
+		{
+			name: "shared host through the service without svc and a domain",
+			path: authPath, host: "B-Dex-Authenticator.NS-B:443", originalURL: []string{"https://shared.example.com/"},
+			expectClient: "b", expectForwardedHost: "shared.example.com",
+		},
+		{
+			name: "shared host through the service of the client that is chosen by it, under another cluster domain",
+			path: authPath, host: "a-dex-authenticator.ns-a.svc.other.local", originalURL: []string{"https://shared.example.com/"},
+			expectClient: "a", expectForwardedHost: "shared.example.com",
+		},
+		{
+			name: "another name of the service of one client and the host of another",
+			path: authPath, host: "a-dex-authenticator.ns-a.svc.other.local", originalURL: []string{"https://b.example.com/"},
+		},
+		{
+			name: "another name of the service does not choose the client of a route",
+			path: signInPath, host: "b-dex-authenticator.ns-b.svc.other.local", forwardedHost: []string{"shared.example.com"}, forwardedProto: "https",
+		},
+		{
