+		// Of two records that claim the same thing the first keeps it, and the other clients
+		// of the table are not touched.
+		{
+			name:            "host used twice",
+			table:           `{"clients":[` + record() + `,` + record(`"name":"app"`, `"name":"second"`, testCookieSecretA, testCookieSecretC) + `,` + other + `]}`,
+			expectedClients: []string{"ns/app", "ns/other"},
+			expectedRefused: map[string]string{"ns/second": `the host "app.example.com" belongs to the client "ns/app"`},
+		},
+		{
+			name:            "host used twice in another case",
+			table:           `{"clients":[` + record() + `,` + record(`"name":"app"`, `"name":"second"`, "app.example.com", "APP.example.com", testCookieSecretA, testCookieSecretC) + `]}`,
+			expectedClients: []string{"ns/app"},
+			expectedRefused: map[string]string{"ns/second": `belongs to the client "ns/app"`},
+		},
+		{
+			name:            "cookie secret used twice",
+			table:           `{"clients":[` + record() + `,` + record(`"name":"app"`, `"name":"second"`, "app.example.com", "second.example.com") + `]}`,
+			expectedClients: []string{"ns/app"},
+			expectedRefused: map[string]string{"ns/second": `is the cookie secret of the client "ns/app"`},
+		},
+		{
+			name:            "host named twice by one client",
+			table:           `{"clients":[` + record(`["app.example.com"]`, `["app.example.com","APP.example.com"]`) + `]}`,
