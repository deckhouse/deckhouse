+func TestClientTableProxy_reload(t *testing.T) {
+	t.Parallel()
+
+	t.Run("a missing file leaves the table empty and a file that appears is loaded", func(t *testing.T) {
+		t.Parallel()
+		builder := newStubBuilder()
