+// get asks the dispatcher for a browser path on host and returns the status and the body.
+func get(t *testing.T, d *dispatcher, host string) (int, string) {
+	t.Helper()
+
+	req := httptest.NewRequest(http.MethodGet, "http://"+host+"/dex-authenticator/sign_in", nil)
+	rw := httptest.NewRecorder()
+	d.ServeHTTP(rw, req)
+
+	return rw.Code, rw.Body.String()
+}
