+// The names of the Services of the clients of newServiceTestDispatcher, as ingress-nginx writes
+// them into Host: the host of auth-url, and the value of the upstream-vhost annotation.
+const (
+	serviceOfA = "a-dex-authenticator.ns-a.svc.cluster.local"
+	serviceOfB = "b-dex-authenticator.ns-b.svc.cluster.local"
+)
+
+// newServiceTestDispatcher returns a dispatcher with two clients that have applications on one
+// host, shared.example.com, and a client of a record without the names of a Service:
+//   - a is chosen by a.example.com and shared.example.com, and by serviceOfA;
+//   - b is chosen by b.example.com and by serviceOfB, and shares shared.example.com;
+//   - w is chosen by w.example.com only.
+func newServiceTestDispatcher(t *testing.T) (*dispatcher, *requestRecorder) {
+	t.Helper()
+
+	recorder := &requestRecorder{}
+	table := newClientTable()
+	for _, client := range []*tableClient{
+		{name: "a", hosts: []string{"a.example.com", "shared.example.com"}, recordServices: []string{serviceOfA}, services: []string{serviceOfA}, applications: []string{"a.example.com", "shared.example.com"}},
+		{name: "b", hosts: []string{"b.example.com"}, recordServices: []string{serviceOfB}, services: []string{serviceOfB}, applications: []string{"b.example.com", "shared.example.com"}},
+		{name: "w", hosts: []string{"w.example.com"}, applications: []string{"w.example.com"}},
+	} {
+		client.handler = recorder.handler(client.name)
+		table.byName[client.name] = client
+		for _, host := range client.hosts {
+			table.byHost[host] = client
+		}
+		for _, service := range client.services {
+			table.byService[service] = client
+			object, _ := serviceObject(service)
+			table.byObject[object] = client
+		}
+	}
+
+	d := newDispatcher("/dex-authenticator", newTestMetrics(t))
+	d.table.Store(table)
+
+	return d, recorder
+}
