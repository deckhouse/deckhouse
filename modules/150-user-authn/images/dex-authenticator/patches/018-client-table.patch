+func TestClientBuilder_build(t *testing.T) {
+	// Not parallel: the builder parses flags into a flag set, as the only reloading goroutine does.
+	builder := newTestClientBuilder(t)
+
+	buildProxy := func(t *testing.T, spec clientSpec) *OAuthProxy {
+		t.Helper()
+
+		handler, err := builder.build(spec)
+		require.NoError(t, err)
+		proxy, ok := handler.(*OAuthProxy)
+		require.True(t, ok)
+
+		return proxy
+	}
+
+	t.Run("a client takes its settings from its record and the rest from the process", func(t *testing.T) {
+		spec := testSpec("app", "app.example.com", "app2.example.com")
+		spec.CookieExpire = "24h"
+		spec.AllowAccessToKubernetes = true
+		spec.SendAuthorizationHeader = true
+
+		proxy := buildProxy(t, spec)
+
+		assert.Equal(t, "dex-authenticator-app", proxy.provider.Data().ClientID)
+		assert.Equal(t, testClientSecret, proxy.provider.Data().ClientSecret)
+		assert.Equal(t, testProcessScope+" federated:id audience:server:client_id:kubernetes", proxy.provider.Data().Scope)
+		assert.Equal(t, "_oauth2_proxy", proxy.CookieOptions.Name)
+		assert.Equal(t, spec.CookieSecret, proxy.CookieOptions.Secret)
+		assert.Equal(t, 24*time.Hour, proxy.CookieOptions.Expire)
+		assert.Equal(t, []string{"app.example.com", "app2.example.com"}, proxy.whitelistDomains)
+		assert.Equal(t, "/dex-authenticator", proxy.ProxyPrefix)
+		assert.Equal(t, "https://dex.example.com/auth", proxy.provider.Data().LoginURL.String())
+		assert.Nil(t, proxy.revocationFeed, "a client of a table has no revocation feed of its own")
+		assert.Nil(t, proxy.server, "a client of a table has no servers of its own")
+	})
+
+	t.Run("a client without optional fields keeps the defaults of the process", func(t *testing.T) {
+		proxy := buildProxy(t, testSpec("app", "app.example.com"))
+
+		assert.Equal(t, "_oauth2_proxy", proxy.CookieOptions.Name)
+		assert.Equal(t, 168*time.Hour, proxy.CookieOptions.Expire)
+		assert.Equal(t, []string{"app.example.com"}, proxy.whitelistDomains)
+		assert.Equal(t, testProcessScope, proxy.provider.Data().Scope)
+	})
+
+	t.Run("clients share the session store and the pages", func(t *testing.T) {
+		first := buildProxy(t, testSpec("first", "first.example.com"))
+		second := buildProxy(t, testSpec("second", "second.example.com"))
+
+		assert.Same(t, first.pageWriter, second.pageWriter)
+		assert.Same(t, first.upstreamProxy, second.upstreamProxy)
+		assert.NotSame(t, first.sessionStore, second.sessionStore, "each client has its own cookie options")
+		assert.NotNil(t, builder.shared.pageWriter)
+	})
+
+	t.Run("a record that cannot make a client is an error, not the end of the process", func(t *testing.T) {
+		tests := []struct {
+			name      string
+			modify    func(*clientSpec)
+			expectErr string
+		}{
+			{name: "cookie expire that is not a duration", modify: func(s *clientSpec) { s.CookieExpire = "soon" }, expectErr: "could not parse the flags"},
+			{name: "cookie secret of a wrong length", modify: func(s *clientSpec) { s.CookieSecret = "dh-test-secret-012" }, expectErr: "cookie_secret"},
+		}
+
+		for _, tt := range tests {
+			t.Run(tt.name, func(t *testing.T) {
+				spec := testSpec("app", "app.example.com")
+				tt.modify(&spec)
+
+				handler, err := builder.build(spec)
+
+				require.ErrorContains(t, err, tt.expectErr)
+				assert.Nil(t, handler)
+			})
+		}
+	})
+}
