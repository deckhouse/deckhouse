+// sharedKeySets holds one remote key set per JWKS URL for the whole process once
+// ShareRemoteKeySets is called (Deckhouse patch 018).
+var sharedKeySets struct {
+	mu      sync.Mutex
+	enabled bool
+	byURL   map[string]oidc.KeySet
+}
+
+// ShareRemoteKeySets makes the verifiers built from now on share one remote key set per JWKS URL.
+// A process that serves a table of clients of one provider then fetches and caches the keys of
+// the provider once, not once per client (Deckhouse patch 018).
+func ShareRemoteKeySets() {
+	sharedKeySets.mu.Lock()
+	defer sharedKeySets.mu.Unlock()
+
+	sharedKeySets.enabled = true
+	if sharedKeySets.byURL == nil {
+		sharedKeySets.byURL = map[string]oidc.KeySet{}
+	}
+}
+
+// remoteKeySet returns the remote key set of jwksURL: the shared one after ShareRemoteKeySets, a
+// new one otherwise.
+func remoteKeySet(ctx context.Context, jwksURL string) oidc.KeySet {
+	sharedKeySets.mu.Lock()
+	defer sharedKeySets.mu.Unlock()
+
+	if !sharedKeySets.enabled {
+		return oidc.NewRemoteKeySet(ctx, jwksURL)
+	}
+
+	keySet, ok := sharedKeySets.byURL[jwksURL]
+	if !ok {
+		// The key set outlives the caller, so it must not carry the cancellation of ctx.
+		keySet = oidc.NewRemoteKeySet(context.WithoutCancel(ctx), jwksURL)
+		sharedKeySets.byURL[jwksURL] = keySet
+	}
+
+	return keySet
+}
