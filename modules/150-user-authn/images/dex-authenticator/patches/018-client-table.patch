+// TestClientTableProxy_watch checks that the table follows its file without a call from outside.
+// The poll is off in these tests, so only the file events can bring the new table in.
+func TestClientTableProxy_watch(t *testing.T) {
+	t.Parallel()
+
+	waitFor := func(t *testing.T, p *clientTableProxy, host, expect string) {
+		t.Helper()
+
+		require.Eventually(t, func() bool {
+			_, body := get(t, p.dispatcher, host)
+			return body == expect
+		}, 10*time.Second, 20*time.Millisecond, "%s must be served as %s", host, expect)
+	}
+
+	t.Run("a file replaced by a rename", func(t *testing.T) {
+		t.Parallel()
+		builder := newStubBuilder()
+		p := newTestTableProxy(t, builder.build)
+		p.pollInterval = time.Hour
+
+		writeTable(t, p, testSpec("a", "a.example.com"))
+		p.reload()
+
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			p.watch(ctx)
+		}()
+		t.Cleanup(func() {
+			cancel()
+			<-done
+		})
+
+		// The watch is set at the start of the loop; a change made before that is not seen
+		// until the poll, which is off here.
+		time.Sleep(200 * time.Millisecond)
+		writeTable(t, p, testSpec("a", "a.example.com"), testSpec("b", "b.example.com"))
+
+		waitFor(t, p, "b.example.com", "b#1")
+		_, body := get(t, p.dispatcher, "a.example.com")
+		assert.Equal(t, "a#1", body)
+	})
+
+	t.Run("a secret volume updated by the kubelet", func(t *testing.T) {
+		t.Parallel()
+		builder := newStubBuilder()
+
+		// The layout of a Secret volume: the file is a symlink into ..data, and ..data is a
+		// symlink to the directory of the current version, replaced by a rename.
+		dir := t.TempDir()
+		writeVersion := func(version string, specs ...clientSpec) {
+			versionDir := filepath.Join(dir, version)
+			require.NoError(t, os.Mkdir(versionDir, 0o700))
+			require.NoError(t, os.WriteFile(filepath.Join(versionDir, "clients.json"), encodeTable(t, specs...), 0o600))
+			require.NoError(t, os.Symlink(version, filepath.Join(dir, "..data_tmp")))
+			require.NoError(t, os.Rename(filepath.Join(dir, "..data_tmp"), filepath.Join(dir, "..data")))
+		}
+		writeVersion("..v1", testSpec("a", "a.example.com"))
+		require.NoError(t, os.Symlink(filepath.Join("..data", "clients.json"), filepath.Join(dir, "clients.json")))
+
+		p := newClientTableProxy(filepath.Join(dir, "clients.json"), "/dex-authenticator", builder.build, newTestMetrics(t))
+		p.pollInterval = time.Hour
+		p.reload()
+		_, body := get(t, p.dispatcher, "a.example.com")
+		require.Equal(t, "a#1", body)
+
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			p.watch(ctx)
+		}()
+		t.Cleanup(func() {
+			cancel()
+			<-done
+		})
+
+		time.Sleep(200 * time.Millisecond)
+		writeVersion("..v2", testSpec("a", "a.example.com"), testSpec("b", "b.example.com"))
+		require.NoError(t, os.RemoveAll(filepath.Join(dir, "..v1")))
+
+		waitFor(t, p, "b.example.com", "b#1")
+	})
+
+	t.Run("a file that appears after the start is found by the poll", func(t *testing.T) {
+		t.Parallel()
+		builder := newStubBuilder()
+		p := newTestTableProxy(t, builder.build)
+		p.pollInterval = 50 * time.Millisecond
+		p.reload()
+
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			p.watch(ctx)
+		}()
+		t.Cleanup(func() {
+			cancel()
+			<-done
+		})
+
+		writeTable(t, p, testSpec("a", "a.example.com"))
+
+		waitFor(t, p, "a.example.com", "a#1")
+	})
+}
