+			path: signInPath, host: serviceOfB, originalURL: []string{"https://a.example.com/"}, forwardedHost: []string{"shared.example.com"}, forwardedProto: "https",
+			expectClient: "b", expectForwardedHost: "shared.example.com",
+		},
+		{
+			name: "auth path on a route with the name of the service ignores a forged x-original-url",
+			path: authPath, host: serviceOfB, originalURL: []string{"https://a.example.com/"}, forwardedHost: []string{"shared.example.com"}, forwardedProto: "https",
+			expectClient: "b", expectForwardedHost: "shared.example.com",
