+// TestClientTable_isolation runs real clients behind the dispatcher and checks that the session
+// of one client is not a session for another, whatever the request forges.
+func TestClientTable_isolation(t *testing.T) {
+	builder := newTestClientBuilder(t)
+	p := newTestTableProxy(t, builder.build)
+
+	specA := testSpec("a", "a.example.com")
+	specA.CookieSecret = testCookieSecretA
+	specB := testSpec("b", "b.example.com")
+	specB.CookieSecret = testCookieSecretB
+	writeTable(t, p, specA, specB)
+	p.reload()
+
+	// signIn saves a session at the client of host and returns its cookies.
+	signIn := func(t *testing.T, host, user string) []*http.Cookie {
+		t.Helper()
+
+		proxy, ok := p.dispatcher.table.Load().byHost[host].handler.(*OAuthProxy)
+		require.True(t, ok)
+
+		created := time.Now()
+		req := httptest.NewRequest(http.MethodGet, "https://"+host+"/", nil)
+		rw := httptest.NewRecorder()
+		require.NoError(t, proxy.sessionStore.Save(rw, req, &sessions.SessionState{
+			User:         user,
+			Email:        user + "@example.com",
+			AccessToken:  "access-token",
+			RefreshToken: "refresh-token-of-" + user,
+			CreatedAt:    &created,
+		}))
+
+		return rw.Result().Cookies()
+	}
+
+	cookiesA := signIn(t, "a.example.com", "alice")
+	cookiesB := signIn(t, "b.example.com", "bob")
+	require.NotEmpty(t, cookiesA)
+	require.Equal(t, cookiesA[0].Name, cookiesB[0].Name, "the clients use the same cookie name, as the authenticators do")
+
+	// serviceHost is the Host of the auth subrequest of ingress-nginx.
+	const serviceHost = "app-dex-authenticator.d8-app.svc.cluster.local"
+
+	type request struct {
+		path          string
+		host          string
+		originalURL   string
+		forwardedHost string
+		cookies       []*http.Cookie
+	}
+	do := func(t *testing.T, r request) *httptest.ResponseRecorder {
+		t.Helper()
+
+		req := httptest.NewRequest(http.MethodGet, "http://placeholder.test"+r.path, nil)
+		req.Host = r.host
+		if r.originalURL != "" {
+			req.Header.Set("X-Original-URL", r.originalURL)
+		}
+		if r.forwardedHost != "" {
+			req.Header.Set("X-Forwarded-Host", r.forwardedHost)
+		}
+		for _, cookie := range r.cookies {
+			req.AddCookie(cookie)
+		}
+		rw := httptest.NewRecorder()
+		p.dispatcher.ServeHTTP(rw, req)
+
+		return rw
+	}
+
+	const authPath = "/dex-authenticator/auth"
+
+	accepted := []struct {
+		name       string
+		request    request
+		expectUser string
+	}{
+		{
+			name:       "session of a on the auth subrequest of a",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://a.example.com/page", cookies: cookiesA},
+			expectUser: "alice@example.com",
+		},
+		{
+			name:       "session of b on the auth subrequest of b",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", cookies: cookiesB},
+			expectUser: "bob@example.com",
+		},
+		{
+			name:       "session of a on the userinfo of a",
+			request:    request{path: "/dex-authenticator/userinfo", host: "a.example.com", cookies: cookiesA},
+			expectUser: "alice@example.com",
+		},
+	}
+	for _, tt := range accepted {
+		t.Run(tt.name, func(t *testing.T) {
+			rw := do(t, tt.request)
+
+			require.Equal(t, http.StatusOK, rw.Code)
+			if tt.request.path == authPath {
+				assert.Equal(t, tt.expectUser, rw.Header().Get("X-Auth-Request-Email"))
+			} else {
+				assert.Contains(t, rw.Body.String(), tt.expectUser)
+			}
+		})
+	}
+
+	refused := []struct {
+		name       string
+		request    request
+		expectCode int
+	}{
+		{
+			name:       "session of a on the auth subrequest of b",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a on the auth subrequest of b with a forged host",
+			request:    request{path: authPath, host: "a.example.com", originalURL: "https://b.example.com/page", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a on the auth subrequest of b with a forged x-forwarded-host",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", forwardedHost: "a.example.com", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a on the userinfo of b with a forged x-original-url",
+			request:    request{path: "/dex-authenticator/userinfo", host: "b.example.com", originalURL: "https://a.example.com/", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a on the userinfo of b with a forged x-forwarded-host",
+			request:    request{path: "/dex-authenticator/userinfo", host: "b.example.com", forwardedHost: "a.example.com", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			// nginx would serve b.example.com for this Host; a URL parser would answer a.example.com.
+			name:       "session of a with an x-original-url that hides the host of a behind userinfo",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://b.example.com:443@a.example.com/", cookies: cookiesA},
+			expectCode: http.StatusForbidden,
+		},
+		{
+			// Without X-Original-URL the check is chosen by its Host header, never by X-Forwarded-Host.
+			name:       "session of a on an auth check with the host of b and a forged x-forwarded-host",
+			request:    request{path: authPath, host: "b.example.com", forwardedHost: "a.example.com", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a on a host no client has",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://c.example.com/", cookies: cookiesA},
+			expectCode: http.StatusForbidden,
+		},
+		{
+			name:       "no session on the auth subrequest of a",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://a.example.com/page"},
+			expectCode: http.StatusUnauthorized,
+		},
+	}
+	for _, tt := range refused {
+		t.Run(tt.name, func(t *testing.T) {
+			rw := do(t, tt.request)
+
+			assert.Equal(t, tt.expectCode, rw.Code)
+			assert.Empty(t, rw.Header().Get("X-Auth-Request-Email"))
+			assert.Empty(t, rw.Header().Get("X-Auth-Request-User"))
+			assert.Empty(t, rw.Header().Get("Authorization"))
+			assert.NotContains(t, rw.Body.String(), "alice")
+			for _, cookie := range rw.Result().Cookies() {
+				assert.Empty(t, cookie.Value, "a refused request must not be given a session cookie")
+			}
+		})
+	}
+
+	t.Run("the sessions survive the refused requests", func(t *testing.T) {
+		rw := do(t, request{path: authPath, host: serviceHost, originalURL: "https://a.example.com/page", cookies: cookiesA})
+		require.Equal(t, http.StatusOK, rw.Code)
+		assert.Equal(t, "alice@example.com", rw.Header().Get("X-Auth-Request-Email"))
+
+		rw = do(t, request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", cookies: cookiesB})
+		require.Equal(t, http.StatusOK, rw.Code)
+		assert.Equal(t, "bob@example.com", rw.Header().Get("X-Auth-Request-Email"))
+	})
+
+	t.Run("a client that changes its cookie secret refuses the sessions it gave before", func(t *testing.T) {
+		specA.CookieSecret = testCookieSecretC
+		writeTable(t, p, specA, specB)
+		p.reload()
+
+		rw := do(t, request{path: authPath, host: serviceHost, originalURL: "https://a.example.com/page", cookies: cookiesA})
+		assert.Equal(t, http.StatusUnauthorized, rw.Code)
+
+		rw = do(t, request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", cookies: cookiesB})
+		assert.Equal(t, http.StatusOK, rw.Code, "the other client is not touched")
+	})
+
+	t.Run("two clients are never served with one cookie secret", func(t *testing.T) {
+		// With one cookie secret the cookie of b would pass the signature check of a. The record
+		// of a comes first and takes the secret; the record of b is refused, and the record b had
+		// is not served either, as its secret is now that of a.
+		specA.CookieSecret = testCookieSecretB
+		writeTable(t, p, specA, specB)
+		p.reload()
+
+		assert.Equal(t, statusIDs(specB), p.status.Load().Failed)
+		rw := do(t, request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", cookies: cookiesB})
+		assert.Equal(t, http.StatusForbidden, rw.Code, "b is not served")
+		// What the cookie of b gets from a, which has its secret now, is the matter of
+		// TestClientTable_storeScope.
+	})
+}
