+// FuzzDispatcherRoute checks on arbitrary Host, X-Original-URL and X-Forwarded-Host that a client
+// is chosen only by a plain host name that is exactly one of its hosts.
+func FuzzDispatcherRoute(f *testing.F) {
+	f.Add("/dex-authenticator/auth", "svc.local", "https://a.example.com/", "b.example.com")
+	f.Add("/dex-authenticator/auth", "a.example.com", "https://b.example.com:443@a.example.com/", "")
+	f.Add("/dex-authenticator/sign_in", "a.example.com:443@b.example.com", "https://a.example.com/", "a.example.com")
+	f.Add("/dex-authenticator/auth/", "B.example.com.", "", "")
+
+	recorder := &requestRecorder{}
+	table := newClientTable()
+	for name, host := range map[string]string{"a": "a.example.com", "b": "b.example.com"} {
+		client := &tableClient{name: name, hosts: []string{host}, handler: recorder.handler(name)}
+		table.byName[name] = client
+		table.byHost[host] = client
+	}
+	metrics, err := newClientTableMetrics(prometheus.NewRegistry())
+	if err != nil {
+		f.Fatal(err)
+	}
+	d := newDispatcher("/dex-authenticator", metrics)
+	d.table.Store(table)
+
+	f.Fuzz(func(t *testing.T, path, host, originalURL, forwardedHost string) {
+		req := httptest.NewRequest(http.MethodGet, "http://placeholder.test/", nil)
+		req.URL.Path = path
+		req.URL.RawPath = ""
+		req.Host = host
+		req.Header.Set("X-Original-URL", originalURL)
+		req.Header.Set("X-Forwarded-Host", forwardedHost)
+
+		client, forwardedHost := d.route(req)
+		if client == nil {
+			return
+		}
+
+		// The key header of this path, cut to its authority the plainest way.
+		source := host
+		if req.URL.EscapedPath() == "/dex-authenticator/auth" {
+			source = strings.TrimPrefix(strings.TrimPrefix(originalURL, "https://"), "http://")
+			source, _, _ = strings.Cut(source, "/")
+		}
+
+		// The authority that chose the client is a host of that client, with at most a port and
+		// a trailing dot around it.
+		name, port, _ := strings.Cut(strings.ToLower(source), ":")
+		if strings.TrimSuffix(name, ".") != client.hosts[0] {
+			t.Fatalf("authority %q chose the client of %q", source, client.hosts[0])
+		}
+		if strings.Trim(port, "0123456789") != "" {
+			t.Fatalf("authority %q has a port that is not a number", source)
+		}
+
+		// The client is given its own host, with that port or without a port.
+		if forwardedHost != client.hosts[0] && forwardedHost != client.hosts[0]+":"+port {
+			t.Fatalf("the client of %q is given the host %q", client.hosts[0], forwardedHost)
+		}
+	})
+}
