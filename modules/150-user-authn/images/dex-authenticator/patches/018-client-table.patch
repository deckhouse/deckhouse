+// stubBuilder builds the handlers of a table under test and counts the builds.
+type stubBuilder struct {
+	mu     sync.Mutex
+	builds map[string]int
+	fail   map[string]bool
+}
+
+func newStubBuilder() *stubBuilder {
+	return &stubBuilder{builds: map[string]int{}, fail: map[string]bool{}}
+}
+
+// build returns a handler that answers with the name of the client and the number of its build.
+func (b *stubBuilder) build(spec clientSpec) (http.Handler, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	if b.fail[spec.Name] {
+		return nil, errors.New("the client cannot be built")
+	}
+	b.builds[spec.Name]++
+	body := fmt.Sprintf("%s#%d", spec.Name, b.builds[spec.Name])
+
+	return http.HandlerFunc(func(rw http.ResponseWriter, _ *http.Request) {
+		_, _ = rw.Write([]byte(body))
+	}), nil
+}
+
+func (b *stubBuilder) count(name string) int {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	return b.builds[name]
+}
+
+func (b *stubBuilder) setFail(name string, fail bool) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	b.fail[name] = fail
+}
