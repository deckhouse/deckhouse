+				assert.NotContains(t, rw.Body.String(), "example.com", "the answer must not repeat the request")
+				return
+			}
+
+			require.Len(t, reached, 1, "exactly one handler of a client must run")
+			assert.Equal(t, tt.expectClient, reached[0].client)
+			assert.Equal(t, http.StatusOK, rw.Code)
+			assert.Equal(t, []string{tt.expectForwardedHost}, reached[0].forwardedHosts,
+				"the client must see only the host of the application")
+		})
+	}
+}
