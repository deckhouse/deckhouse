+// testSpec returns a client with a cookie secret of its own, derived from its name.
+func testSpec(name string, hosts ...string) clientSpec {
+	// 32 bytes: the prefix of the test secrets and the name, padded with a letter no name ends with.
+	suffix := strings.ReplaceAll(name, "-", "")
+	cookieSecret := "dh-test-secret-" + suffix + strings.Repeat("x", 17-len(suffix))
+
+	return clientSpec{
+		Name:         name,
+		Namespace:    testNamespace,
+		Hosts:        hosts,
+		ClientID:     "dex-authenticator-" + name,
+		ClientSecret: testClientSecret,
+		CookieSecret: cookieSecret,
+	}
+}
