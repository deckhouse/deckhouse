+func TestCheckClientTableOptions(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name      string
+		modify    func(*options.Options)
+		expectErr string
+	}{
+		{name: "no feed", modify: func(*options.Options) {}},
+		{name: "no refresh period", modify: func(o *options.Options) { o.Cookie.Refresh = 0 }, expectErr: "--cookie-refresh above zero"},
+		{name: "provider discovery", modify: func(o *options.Options) { o.Providers[0].OIDCConfig.SkipDiscovery = ptr.To(false) }, expectErr: "--skip-oidc-discovery"},
+		{name: "feed turned off", modify: func(o *options.Options) {
+			o.RevocationFeedURL = "https://revocation-feed.d8-user-authn/revocations"
+			o.RevocationFeedDisable = true
+		}},
+		{name: "feed left on", modify: func(o *options.Options) {
+			o.RevocationFeedURL = "https://revocation-feed.d8-user-authn/revocations"
+		}, expectErr: "--revocation-feed-token-file"},
+		{name: "feed of the process", modify: func(o *options.Options) {
+			o.RevocationFeedURL = "https://revocation-feed.d8-user-authn/revocations"
+			o.RevocationFeedTokenFile = "/var/run/secrets/revocation-feed/token"
+		}},
+		{name: "emails file", modify: func(o *options.Options) { o.AuthenticatedEmailsFile = "/emails" }, expectErr: "not supported"},
+		{name: "htpasswd file", modify: func(o *options.Options) { o.HtpasswdFile = "/htpasswd" }, expectErr: "not supported"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			opts := options.NewOptions()
+			opts.Cookie.Refresh = 10 * time.Minute
+			opts.Providers[0].OIDCConfig.SkipDiscovery = ptr.To(true)
+			tt.modify(opts)
+
+			err := checkClientTableOptions(opts)
+			if tt.expectErr != "" {
+				require.ErrorContains(t, err, tt.expectErr)
+				return
+			}
+			require.NoError(t, err)
+		})
+	}
+}
