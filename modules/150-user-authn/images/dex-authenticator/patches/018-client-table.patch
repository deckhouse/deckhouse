+// TestDispatcher_ServeHTTP_byService checks the choice of a client by the name of its Service in
+// the Host header: two clients serve applications on one host, each the requests that came
+// through its own Service, and the name of a Service never opens a host the client does not have.
+func TestDispatcher_ServeHTTP_byService(t *testing.T) {
+	t.Parallel()
+
+	const (
+		authPath   = "/dex-authenticator/auth"
+		signInPath = "/dex-authenticator/sign_in"
+	)
+
+	tests := []struct {
+		name string
+		path string
+		host string
+		// originalURL and forwardedHost are the values of the headers; nil leaves the header out.
+		originalURL    []string
+		forwardedHost  []string
+		forwardedProto string
+
+		// expectClient is the only client whose handler may run; empty expects no handler: 403 on
+		// the auth path and 404 elsewhere.
+		expectClient        string
+		expectForwardedHost string
+	}{
+		// One host, two clients: each serves what came through its Service.
+		{
+			name: "auth subrequest through the service of the client that shares the host",
+			path: authPath, host: serviceOfB, originalURL: []string{"https://shared.example.com/page"},
+			expectClient: "b", expectForwardedHost: "shared.example.com",
+		},
+		{
+			name: "auth subrequest through the service of the client that is chosen by the host",
+			path: authPath, host: serviceOfA, originalURL: []string{"https://shared.example.com/page"},
+			expectClient: "a", expectForwardedHost: "shared.example.com",
+		},
+		{
+			name: "route with the name of the service in host is chosen by the service",
+			path: signInPath, host: serviceOfB, forwardedHost: []string{"shared.example.com"}, forwardedProto: "https",
+			expectClient: "b", expectForwardedHost: "shared.example.com",
+		},
+		{
+			name: "callback on the route with the name of the service in host",
+			path: "/dex-authenticator/callback?code=x", host: serviceOfB, forwardedHost: []string{"shared.example.com"}, forwardedProto: "https",
+			expectClient: "b", expectForwardedHost: "shared.example.com",
+		},
+		{
+			name: "route with the name of the service of the other client in host",
+			path: signInPath, host: serviceOfA, forwardedHost: []string{"shared.example.com"}, forwardedProto: "https",
+			expectClient: "a", expectForwardedHost: "shared.example.com",
+		},
+		{
+			name: "route without the name of a service is chosen by the host",
+			path: signInPath, host: "shared.example.com", forwardedProto: "https",
+			expectClient: "a", expectForwardedHost: "shared.example.com",
+		},
+
+		// A Host that has the form of the name of the Service of a DexAuthenticator but is none
+		// of the table: the object is gone, or auth-url is written wrong. The client that is
+		// chosen by the host must not answer for it, on a host two clients have or on any other.
+		{
+			name: "host that is not shared through the service of an object the table does not have",
+			path: authPath, host: "other-dex-authenticator.ns.svc.cluster.local", originalURL: []string{"https://a.example.com/"},
+		},
+		{
+			name: "host that is not shared through the service of an object the table does not have, in upper case with a port",
+			path: authPath, host: "Other-Dex-Authenticator.NS.svc.cluster.local:443", originalURL: []string{"https://a.example.com/"},
+		},
+		// Another DNS name of the Service of a client names the same Service in an auth
+		// subrequest: auth-url may have any of them.
+		{
+			name: "shared host through the service under another cluster domain",
