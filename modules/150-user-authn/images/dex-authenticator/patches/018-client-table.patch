+func TestClientSpec_args(t *testing.T) {
+	t.Parallel()
+
+	const scope = "groups email openid profile offline_access"
+
+	tests := []struct {
+		name     string
+		spec     clientSpec
+		expected []string
+	}{
+		{
+			name: "required fields only",
+			spec: clientSpec{Name: "app", Namespace: "ns", Hosts: []string{"app.example.com"}, ClientID: "id", ClientSecret: "secret", CookieSecret: "cookie"},
+			expected: []string{
+				"--client-id=id", "--client-secret=secret", "--cookie-secret=cookie", "--set-authorization-header=false",
+				"--whitelist-domain=app.example.com",
+			},
+		},
+		{
+			name: "every field",
+			spec: clientSpec{
+				Name: "app", Namespace: "ns", Hosts: []string{"app.example.com", "app2.example.com"}, ClientID: "id", ClientSecret: "secret", CookieSecret: "cookie",
+				CookieExpire: "24h", AllowAccessToKubernetes: true, SendAuthorizationHeader: true, ProviderLogout: true,
+			},
+			expected: []string{
+				"--client-id=id", "--client-secret=secret", "--cookie-secret=cookie", "--set-authorization-header=true",
+				"--cookie-expire=24h", "--scope=" + scope + " federated:id audience:server:client_id:kubernetes",
+				"--whitelist-domain=app.example.com", "--whitelist-domain=app2.example.com",
+			},
+		},
+		{
+			// A redirect is allowed to a shared host; the names of the Service are no flag.
+			name: "shared hosts",
+			spec: clientSpec{
+				Name: "app", Namespace: "ns", Hosts: []string{"app.example.com"}, SharedHosts: []string{"shared.example.com"},
+				Services: []string{"app-dex-authenticator.ns.svc.cluster.local"}, ClientID: "id", ClientSecret: "secret", CookieSecret: "cookie",
+			},
+			expected: []string{
+				"--client-id=id", "--client-secret=secret", "--cookie-secret=cookie", "--set-authorization-header=false",
+				"--whitelist-domain=app.example.com", "--whitelist-domain=shared.example.com",
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			assert.Equal(t, tt.expected, tt.spec.args(scope))
+		})
+	}
+}
