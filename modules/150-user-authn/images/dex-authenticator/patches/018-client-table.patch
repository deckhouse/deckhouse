+		// A record without the names of a Service is chosen by its hosts, as before.
+		{
+			name: "record without a service is chosen by the host header",
+			path: signInPath, host: "w.example.com", forwardedProto: "https",
+			expectClient: "w", expectForwardedHost: "w.example.com",
+		},
+		{
+			name: "record without a service is chosen by x-original-url of an auth subrequest",
+			path: authPath, host: "w-dex-authenticator.ns-w.svc.cluster.local", originalURL: []string{"https://w.example.com/"},
+			expectClient: "w", expectForwardedHost: "w.example.com",
+		},
+		{
+			name: "record without a service is not chosen by x-forwarded-host",
+			path: signInPath, host: "w-dex-authenticator.ns-w.svc.cluster.local", forwardedHost: []string{"w.example.com"}, forwardedProto: "https",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			d, recorder := newServiceTestDispatcher(t)
+
+			req := httptest.NewRequest(http.MethodGet, "http://placeholder.test"+tt.path, nil)
+			req.Host = tt.host
+			for _, value := range tt.originalURL {
+				req.Header.Add("X-Original-URL", value)
+			}
+			for _, value := range tt.forwardedHost {
+				req.Header.Add("X-Forwarded-Host", value)
+			}
+			if tt.forwardedProto != "" {
+				req.Header.Set("X-Forwarded-Proto", tt.forwardedProto)
+			}
+			rw := httptest.NewRecorder()
+
+			d.ServeHTTP(rw, req)
