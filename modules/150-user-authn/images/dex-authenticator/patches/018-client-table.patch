+func TestParseClientTable(t *testing.T) {
+	t.Parallel()
+
+	record := func(replacements ...string) string {
+		valid := `{"name":"app","namespace":"ns","hosts":["app.example.com"],"clientID":"id","clientSecret":"` + testClientSecret + `","cookieSecret":"` + testCookieSecretA + `"}`
+		return strings.NewReplacer(replacements...).Replace(valid)
+	}
+	other := record(`"name":"app"`, `"name":"other"`, "app.example.com", "other.example.com", testCookieSecretA, testCookieSecretB)
+
+	tests := []struct {
+		name  string
+		table string
+		// expectedErr refuses the whole file; expectedRefused are the clients whose record is
+		// refused alone, with a part of the reason.
+		expectedErr     string
+		expectedClients []string
+		expectedRefused map[string]string
+	}{
+		{name: "one client", table: `{"generation":7,"clients":[` + record() + `]}`, expectedClients: []string{"ns/app"}},
+		{name: "no clients", table: `{"clients":[]}`},
+		{name: "empty object", table: `{}`, expectedErr: "the list of clients is missing"},
+		{
+			name: "every field",
+			table: `{"generation":1,"clients":[{"name":"app","namespace":"ns","hosts":["app.example.com","app2.example.com"],"clientID":"id",
+				"clientSecret":"` + testClientSecret + `","cookieSecret":"` + testCookieSecretA + `","cookieExpire":"24h",
+				"allowAccessToKubernetes":true,"sendAuthorizationHeader":true,"providerLogout":true}]}`,
+			expectedClients: []string{"ns/app"},
+		},
+		{name: "empty file", table: ``, expectedErr: "could not decode"},
+		{name: "not json", table: `clients: []`, expectedErr: "could not decode"},
+		{name: "unknown field", table: `{"clients":[{"name":"app","host":"app.example.com"}]}`, expectedErr: "unknown field"},
+		{name: "flags of the process are no field of a client", table: `{"clients":[` + record(`"name":"app"`, `"name":"app","extraArgs":["--cookie-refresh=1m"]`) + `]}`, expectedErr: "unknown field"},
+
+		{name: "no name", table: `{"clients":[` + record(`"name":"app",`, ``) + `,` + other + `]}`, expectedClients: []string{"ns/other"}, expectedRefused: map[string]string{"ns/": "name and namespace are required"}},
+		{name: "no namespace", table: `{"clients":[` + record(`"namespace":"ns",`, ``) + `]}`, expectedRefused: map[string]string{"/app": "name and namespace are required"}},
+		{name: "slash in the name", table: `{"clients":[` + record(`"name":"app"`, `"name":"a/pp"`) + `]}`, expectedRefused: map[string]string{"ns/a/pp": "must not contain a slash"}},
+		{name: "no client id", table: `{"clients":[` + record(`"clientID":"id",`, ``) + `]}`, expectedRefused: map[string]string{"ns/app": "are required"}},
+		{name: "no client secret", table: `{"clients":[` + record(`"clientSecret":"`+testClientSecret+`",`, ``) + `]}`, expectedRefused: map[string]string{"ns/app": "are required"}},
+		{name: "no cookie secret", table: `{"clients":[` + record(`,"cookieSecret":"`+testCookieSecretA+`"`, ``) + `]}`, expectedRefused: map[string]string{"ns/app": "are required"}},
+		{name: "no hosts", table: `{"clients":[` + record(`["app.example.com"]`, `[]`) + `]}`, expectedRefused: map[string]string{"ns/app": "at least one host"}},
+		{name: "host with a port", table: `{"clients":[` + record("app.example.com", "app.example.com:443") + `]}`, expectedRefused: map[string]string{"ns/app": "not a DNS name"}},
+		{name: "host with a scheme", table: `{"clients":[` + record("app.example.com", "https://app.example.com") + `]}`, expectedRefused: map[string]string{"ns/app": "not a DNS name"}},
+		{name: "host with a trailing dot", table: `{"clients":[` + record("app.example.com", "app.example.com.") + `]}`, expectedRefused: map[string]string{"ns/app": "not a DNS name"}},
+		{name: "wildcard host", table: `{"clients":[` + record("app.example.com", "*.example.com") + `]}`, expectedRefused: map[string]string{"ns/app": "not a DNS name"}},
+		{name: "empty host", table: `{"clients":[` + record("app.example.com", "") + `]}`, expectedRefused: map[string]string{"ns/app": "not a DNS name"}},
+		{name: "bad cookie expire", table: `{"clients":[` + record(`"clientID"`, `"cookieExpire":"week","clientID"`) + `]}`, expectedRefused: map[string]string{"ns/app": "cookieExpire is not a duration"}},
