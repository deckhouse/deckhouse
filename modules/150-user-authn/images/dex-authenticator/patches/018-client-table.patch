+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// newSharedStore returns a store for several scopes, with real locks.
+func newSharedStore(t *testing.T) persistence.Store {
+	t.Helper()
+
+	store, err := memory.NewStore(options.MemoryStoreOptions{MaxBytes: 1 << 20})
+	require.NoError(t, err)
+
+	return store
+}
+
+func TestScopedStore(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+
+	t.Run("a scope finds what it saved", func(t *testing.T) {
+		t.Parallel()
+		scope := persistence.NewScopedStore(newSharedStore(t), "ns/app")
+
+		require.NoError(t, scope.Save(ctx, "ticket", []byte("session"), time.Hour))
+
+		got, err := scope.Load(ctx, "ticket")
+		require.NoError(t, err)
+		assert.Equal(t, []byte("session"), got)
+	})
+
+	t.Run("a scope does not find, replace or clear the record of another scope", func(t *testing.T) {
+		t.Parallel()
+		store := newSharedStore(t)
+		first, second := persistence.NewScopedStore(store, "ns/first"), persistence.NewScopedStore(store, "ns/second")
+
+		require.NoError(t, first.Save(ctx, "ticket", []byte("session of the first"), time.Hour))
+
+		_, err := second.Load(ctx, "ticket")
+		require.Error(t, err)
+
+		require.NoError(t, second.Save(ctx, "ticket", []byte("session of the second"), time.Hour))
+		require.NoError(t, second.Clear(ctx, "ticket"))
+
+		got, err := first.Load(ctx, "ticket")
+		require.NoError(t, err)
+		assert.Equal(t, []byte("session of the first"), got)
+	})
+
+	t.Run("a scope does not see the records saved without a scope", func(t *testing.T) {
+		t.Parallel()
+		store := newSharedStore(t)
+
+		require.NoError(t, store.Save(ctx, "ticket", []byte("session"), time.Hour))
+
+		_, err := persistence.NewScopedStore(store, "ns/app").Load(ctx, "ticket")
+		require.Error(t, err)
+	})
+
+	t.Run("no two scopes make the same key", func(t *testing.T) {
+		t.Parallel()
+
+		// Without the length of the scope each pair below would meet in one key.
+		pairs := []struct {
+			name                 string
+			firstScope, firstKey string
+			otherScope, otherKey string
+		}{
+			{name: "a colon moves from the key to the scope", firstScope: "a", firstKey: "b:ticket", otherScope: "a:b", otherKey: "ticket"},
+			{name: "the scope is a prefix of another", firstScope: "app", firstKey: "1:ticket", otherScope: "app:1", otherKey: "ticket"},
+			{name: "the scope looks like a length", firstScope: "1:a", firstKey: "ticket", otherScope: "a", otherKey: "ticket"},
+			{name: "the empty scope", firstScope: "", firstKey: "1:a:ticket", otherScope: "a", otherKey: "ticket"},
+		}
+
+		for _, tt := range pairs {
+			t.Run(tt.name, func(t *testing.T) {
+				t.Parallel()
+				store := newSharedStore(t)
+
+				require.NoError(t, persistence.NewScopedStore(store, tt.firstScope).Save(ctx, tt.firstKey, []byte("session"), time.Hour))
+
+				_, err := persistence.NewScopedStore(store, tt.otherScope).Load(ctx, tt.otherKey)
+				require.Error(t, err)
+			})
+		}
+	})
+
+	t.Run("the lock of a ticket belongs to its scope", func(t *testing.T) {
+		t.Parallel()
+		store := newSharedStore(t)
+		first, second := persistence.NewScopedStore(store, "ns/first"), persistence.NewScopedStore(store, "ns/second")
+
+		require.NoError(t, first.Lock("ticket").Obtain(ctx, time.Minute))
+
+		// The same ticket of another scope is free, and of the same scope is taken.
+		require.NoError(t, second.Lock("ticket").Obtain(ctx, time.Minute))
+		require.ErrorIs(t, first.Lock("ticket").Obtain(ctx, time.Minute), sessions.ErrLockNotObtained)
+	})
+
+	t.Run("the connection of the store is verified", func(t *testing.T) {
+		t.Parallel()
+
+		require.NoError(t, persistence.NewScopedStore(newSharedStore(t), "ns/app").VerifyConnection(ctx))
+	})
+}
