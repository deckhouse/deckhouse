+// TestClientTableProxy_reloadInFlight checks that a request that has reached the handler of a
+// client finishes there while the table is replaced under it.
+func TestClientTableProxy_reloadInFlight(t *testing.T) {
+	t.Parallel()
+
+	var builds atomic.Int32
+	entered := make(chan struct{})
+	release := make(chan struct{})
+
+	p := newTestTableProxy(t, func(clientSpec) (http.Handler, error) {
+		build := builds.Add(1)
+
+		return http.HandlerFunc(func(rw http.ResponseWriter, _ *http.Request) {
+			if build == 1 {
+				close(entered)
+				<-release
+			}
+			_, _ = fmt.Fprintf(rw, "build %d", build)
+		}), nil
+	})
+
+	spec := testSpec("a", "a.example.com")
+	writeTable(t, p, spec)
+	p.reload()
+
+	slow := make(chan string, 1)
+	go func() {
+		_, body := get(t, p.dispatcher, "a.example.com")
+		slow <- body
+	}()
+	<-entered
+
+	spec.CookieExpire = "1h"
+	writeTable(t, p, spec)
+	p.reload()
+
+	_, body := get(t, p.dispatcher, "a.example.com")
+	assert.Equal(t, "build 2", body, "a request after the reload gets the new client")
+
+	close(release)
+	assert.Equal(t, "build 1", <-slow, "the request in flight finishes on the client it started with")
+}
