+func newTestClientBuilder(t *testing.T) *clientBuilder {
+	t.Helper()
+
+	store, err := memory.NewStore(options.MemoryStoreOptions{MaxBytes: 1 << 20})
+	require.NoError(t, err)
+
+	// The flag set main passes on: the flags that are not options.
+	flagSet := pflag.NewFlagSet("oauth2-proxy", pflag.ContinueOnError)
+	flagSet.ParseErrorsAllowlist.UnknownFlags = true
+	flagSet.String("config", "", "")
+	flagSet.String("alpha-config", "", "")
+	flagSet.Bool("convert-config-to-alpha", false, "")
+	flagSet.Bool("version", false, "")
+	flagSet.Bool("config-test", false, "")
+
+	return &clientBuilder{
+		flagSet: flagSet,
+		args:    testProcessArgs(),
+		scope:   testProcessScope,
+		shared:  &sharedResources{sessionStore: store},
+	}
+}
