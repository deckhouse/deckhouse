+// TestClientTable_isolation runs real clients behind the dispatcher and checks that the session
+// of one client is not a session for another, whatever the request forges.
+func TestClientTable_isolation(t *testing.T) {
+	builder := newTestClientBuilder(t)
+	p := newTestTableProxy(t, builder.build)
+
+	specA := testSpec("a", "a.example.com")
+	specA.CookieSecret = testCookieSecretA
+	specB := testSpec("b", "b.example.com")
+	specB.CookieSecret = testCookieSecretB
+	writeTable(t, p, specA, specB)
+	p.reload()
+
+	// signIn saves a session at the client of host and returns its cookies.
+	signIn := func(t *testing.T, host, user string) []*http.Cookie {
+		t.Helper()
+
+		proxy, ok := p.dispatcher.table.Load().byHost[host].handler.(*OAuthProxy)
+		require.True(t, ok)
+
+		created := time.Now()
+		req := httptest.NewRequest(http.MethodGet, "https://"+host+"/", nil)
+		rw := httptest.NewRecorder()
+		require.NoError(t, proxy.sessionStore.Save(rw, req, &sessions.SessionState{
+			User:         user,
+			Email:        user + "@example.com",
+			AccessToken:  "access-token",
+			RefreshToken: "refresh-token-of-" + user,
+			CreatedAt:    &created,
+		}))
+
+		return rw.Result().Cookies()
+	}
+
+	cookiesA := signIn(t, "a.example.com", "alice")
+	cookiesB := signIn(t, "b.example.com", "bob")
+	require.NotEmpty(t, cookiesA)
+	require.Equal(t, cookiesA[0].Name, cookiesB[0].Name, "the clients use the same cookie name, as the authenticators do")
+
+	// serviceHost is the Host of the auth subrequest of ingress-nginx.
+	const serviceHost = "app-dex-authenticator.d8-app.svc.cluster.local"
+
+	type request struct {
+		path          string
+		host          string
+		originalURL   string
+		forwardedHost string
+		cookies       []*http.Cookie
+	}
+	do := func(t *testing.T, r request) *httptest.ResponseRecorder {
+		t.Helper()
+
+		req := httptest.NewRequest(http.MethodGet, "http://placeholder.test"+r.path, nil)
+		req.Host = r.host
+		if r.originalURL != "" {
+			req.Header.Set("X-Original-URL", r.originalURL)
+		}
+		if r.forwardedHost != "" {
+			req.Header.Set("X-Forwarded-Host", r.forwardedHost)
+		}
+		for _, cookie := range r.cookies {
+			req.AddCookie(cookie)
+		}
+		rw := httptest.NewRecorder()
+		p.dispatcher.ServeHTTP(rw, req)
+
+		return rw
+	}
+
+	const authPath = "/dex-authenticator/auth"
+
+	accepted := []struct {
+		name       string
+		request    request
+		expectUser string
+	}{
+		{
+			name:       "session of a on the auth subrequest of a",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://a.example.com/page", cookies: cookiesA},
+			expectUser: "alice@example.com",
+		},
+		{
+			name:       "session of b on the auth subrequest of b",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", cookies: cookiesB},
+			expectUser: "bob@example.com",
+		},
+		{
+			name:       "session of a on the userinfo of a",
+			request:    request{path: "/dex-authenticator/userinfo", host: "a.example.com", cookies: cookiesA},
+			expectUser: "alice@example.com",
+		},
+	}
+	for _, tt := range accepted {
+		t.Run(tt.name, func(t *testing.T) {
+			rw := do(t, tt.request)
+
+			require.Equal(t, http.StatusOK, rw.Code)
+			if tt.request.path == authPath {
+				assert.Equal(t, tt.expectUser, rw.Header().Get("X-Auth-Request-Email"))
+			} else {
+				assert.Contains(t, rw.Body.String(), tt.expectUser)
+			}
+		})
+	}
+
+	refused := []struct {
+		name       string
+		request    request
+		expectCode int
+	}{
+		{
+			name:       "session of a on the auth subrequest of b",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a on the auth subrequest of b with a forged host",
+			request:    request{path: authPath, host: "a.example.com", originalURL: "https://b.example.com/page", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a on the auth subrequest of b with a forged x-forwarded-host",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", forwardedHost: "a.example.com", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a on the userinfo of b with a forged x-original-url",
+			request:    request{path: "/dex-authenticator/userinfo", host: "b.example.com", originalURL: "https://a.example.com/", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a on the userinfo of b with a forged x-forwarded-host",
+			request:    request{path: "/dex-authenticator/userinfo", host: "b.example.com", forwardedHost: "a.example.com", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			// nginx would serve b.example.com for this Host; a URL parser would answer a.example.com.
+			name:       "session of a with an x-original-url that hides the host of a behind userinfo",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://b.example.com:443@a.example.com/", cookies: cookiesA},
+			expectCode: http.StatusForbidden,
+		},
+		{
+			// Without X-Original-URL the check is chosen by its Host header, never by X-Forwarded-Host.
+			name:       "session of a on an auth check with the host of b and a forged x-forwarded-host",
+			request:    request{path: authPath, host: "b.example.com", forwardedHost: "a.example.com", cookies: cookiesA},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a on a host no client has",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://c.example.com/", cookies: cookiesA},
+			expectCode: http.StatusForbidden,
+		},
+		{
+			name:       "no session on the auth subrequest of a",
+			request:    request{path: authPath, host: serviceHost, originalURL: "https://a.example.com/page"},
+			expectCode: http.StatusUnauthorized,
+		},
+	}
+	for _, tt := range refused {
+		t.Run(tt.name, func(t *testing.T) {
+			rw := do(t, tt.request)
+
+			assert.Equal(t, tt.expectCode, rw.Code)
+			assert.Empty(t, rw.Header().Get("X-Auth-Request-Email"))
+			assert.Empty(t, rw.Header().Get("X-Auth-Request-User"))
+			assert.Empty(t, rw.Header().Get("Authorization"))
+			assert.NotContains(t, rw.Body.String(), "alice")
+			for _, cookie := range rw.Result().Cookies() {
+				assert.Empty(t, cookie.Value, "a refused request must not be given a session cookie")
+			}
+		})
+	}
+
+	t.Run("the sessions survive the refused requests", func(t *testing.T) {
+		rw := do(t, request{path: authPath, host: serviceHost, originalURL: "https://a.example.com/page", cookies: cookiesA})
+		require.Equal(t, http.StatusOK, rw.Code)
+		assert.Equal(t, "alice@example.com", rw.Header().Get("X-Auth-Request-Email"))
+
+		rw = do(t, request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", cookies: cookiesB})
+		require.Equal(t, http.StatusOK, rw.Code)
+		assert.Equal(t, "bob@example.com", rw.Header().Get("X-Auth-Request-Email"))
+	})
+
+	t.Run("a client that changes its cookie secret refuses the sessions it gave before", func(t *testing.T) {
+		specA.CookieSecret = testCookieSecretC
+		writeTable(t, p, specA, specB)
+		p.reload()
+
+		rw := do(t, request{path: authPath, host: serviceHost, originalURL: "https://a.example.com/page", cookies: cookiesA})
+		assert.Equal(t, http.StatusUnauthorized, rw.Code)
+
+		rw = do(t, request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", cookies: cookiesB})
+		assert.Equal(t, http.StatusOK, rw.Code, "the other client is not touched")
+	})
+
+	t.Run("two clients are never served with one cookie secret", func(t *testing.T) {
+		// With one cookie secret the cookie of b would pass the signature check of a. The record
+		// of a comes first and takes the secret; the record of b is refused, and the record b had
+		// is not served either, as its secret is now that of a.
+		specA.CookieSecret = testCookieSecretB
+		writeTable(t, p, specA, specB)
+		p.reload()
+
+		assert.Equal(t, []string{"ns/b"}, p.status.Load().Failed)
+		rw := do(t, request{path: authPath, host: serviceHost, originalURL: "https://b.example.com/page", cookies: cookiesB})
+		assert.Equal(t, http.StatusForbidden, rw.Code, "b is not served")
+		// What the cookie of b gets from a, which has its secret now, is the matter of
+		// TestClientTable_storeScope.
+	})
+}
+
+// TestClientTable_storeScope checks the second boundary between the clients, under the cookie
+// secret: each client keeps its sessions under its own name in the store they share. Two clients
+// that got one cookie name and one cookie secret by mistake still do not take the sessions of
+// each other. The table refuses such clients, so they are built here past it.
+func TestClientTable_storeScope(t *testing.T) {
+	redeemURL, refreshes := newRefusingProvider(t)
+
+	builder := newTestClientBuilder(t)
+	// With a refresh period the stub of a session the store does not have is refreshed through
+	// the provider instead of being trusted (patch 002), as in every DexAuthenticator.
+	builder.args = append(builder.args, "--redeem-url="+redeemURL, "--cookie-refresh=10m")
+
+	specA := testSpec("a", "a.example.com")
+	specB := testSpec("b", "b.example.com")
+	specA.CookieSecret, specB.CookieSecret = testCookieSecretA, testCookieSecretA
+
+	handlerA, err := builder.build(specA)
+	require.NoError(t, err)
+	handlerB, err := builder.build(specB)
+	require.NoError(t, err)
+	proxyA, ok := handlerA.(*OAuthProxy)
+	require.True(t, ok)
+
+	created := time.Now()
+	saveReq := httptest.NewRequest(http.MethodGet, "https://a.example.com/", nil)
+	saveRW := httptest.NewRecorder()
+	require.NoError(t, proxyA.sessionStore.Save(saveRW, saveReq, &sessions.SessionState{
+		User:         "alice",
+		Email:        "alice@example.com",
+		AccessToken:  "access-token",
+		RefreshToken: "refresh-token-of-alice",
+		CreatedAt:    &created,
+	}))
+	cookies := saveRW.Result().Cookies()
+	require.NotEmpty(t, cookies)
+
+	auth := func(handler http.Handler, host string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest(http.MethodGet, "http://"+host+"/dex-authenticator/auth", nil)
+		for _, cookie := range cookies {
+			req.AddCookie(cookie)
+		}
+		rw := httptest.NewRecorder()
+		handler.ServeHTTP(rw, req)
+
+		return rw
+	}
+
+	t.Run("the client that saved the session finds it", func(t *testing.T) {
+		rw := auth(handlerA, "a.example.com")
+
+		require.Equal(t, http.StatusOK, rw.Code)
+		assert.Equal(t, "alice@example.com", rw.Header().Get("X-Auth-Request-Email"))
+		assert.Zero(t, refreshes.Load(), "a session found in the store is not refreshed")
+	})
+
+	t.Run("another client with the same cookie secret does not find it", func(t *testing.T) {
+		rw := auth(handlerB, "b.example.com")
+
+		// The cookie passes the signature check of b, but b has no record under its name: it gets
+		// the stub of patch 002, tries the refresh token at the provider, and the provider refuses
+		// a token of another client.
+		assert.Equal(t, http.StatusUnauthorized, rw.Code)
+		assert.Empty(t, rw.Header().Get("X-Auth-Request-Email"))
+		assert.Empty(t, rw.Header().Get("X-Auth-Request-User"))
+		assert.NotContains(t, rw.Body.String(), "alice")
+		assert.Positive(t, refreshes.Load(), "b must ask the provider instead of trusting the store")
+	})
+
+	t.Run("the session of the first client is still there", func(t *testing.T) {
+		rw := auth(handlerA, "a.example.com")
+
+		require.Equal(t, http.StatusOK, rw.Code)
+		assert.Equal(t, "alice@example.com", rw.Header().Get("X-Auth-Request-Email"))
+	})
+
+	t.Run("the refused client left nothing in the store", func(t *testing.T) {
+		store, ok := builder.shared.sessionStore.(*memory.Store)
+		require.True(t, ok)
+		registry := prometheus.NewRegistry()
+		require.NoError(t, store.Register(registry))
+
+		// One record: the session of a. The refused refresh of b saved nothing.
+		families, err := registry.Gather()
+		require.NoError(t, err)
+		entries := -1.0
+		for _, family := range families {
+			if family.GetName() == "oauth2_proxy_session_store_memory_entries" {
+				entries = family.GetMetric()[0].GetGauge().GetValue()
+			}
+		}
+		assert.InDelta(t, 1, entries, 0)
+	})
+}
+
+// TestClientTable_startLog checks that a table of clients is logged in one line per client and one
+// line per load, not in the lines every OAuthProxy writes about itself.
+func TestClientTable_startLog(t *testing.T) {
+	// Not parallel: the test takes the output of the logger of the process.
+	var output bytes.Buffer
+	logger.SetOutput(&output)
+	logger.SetErrOutput(&output)
+	t.Cleanup(func() {
+		logger.SetOutput(os.Stdout)
+		logger.SetErrOutput(os.Stderr)
+	})
+
+	builder := newTestClientBuilder(t)
+	p := newTestTableProxy(t, builder.build)
+	writeTable(t, p, testSpec("a", "a.example.com", "a2.example.com"), testSpec("b", "b.example.com"), testSpec("c", "c.example.com"))
+	p.reload()
+
+	lines := strings.Split(strings.TrimSpace(output.String()), "\n")
+	count := func(part string) int {
+		n := 0
+		for _, line := range lines {
+			if strings.Contains(line, part) {
+				n++
+			}
+		}
+		return n
+	}
+
+	assert.Equal(t, 3, count("of the client table is built"), "one line per client")
+	assert.Equal(t, 1, count(`Client "ns/a" of the client table is built: client ID dex-authenticator-a, hosts a.example.com,a2.example.com`))
+	assert.Equal(t, 1, count("Client table of generation 0 loaded"))
+	assert.Zero(t, count("OAuthProxy configured"))
+	assert.Zero(t, count("Cookie settings"))
+	assert.LessOrEqual(t, count("mapping path"), 1, "the upstreams are built once for the table")
+	assert.LessOrEqual(t, count("--trusted-proxy-ip"), 1, "the warning of the process is logged once")
+	assert.LessOrEqual(t, len(lines), 6, "three clients, the load, the upstreams and the warning")
+	assert.NotContains(t, output.String(), "dh-test-secret", "the log must not carry a secret")
+}
+
+// TestClientTable_logNamesTheClient checks that the log lines of a request served by a client of
+// a table name the DexAuthenticator object of that client, and that the lines of a process with
+// one client have no such fields.
+func TestClientTable_logNamesTheClient(t *testing.T) {
+	builder := newTestClientBuilder(t)
+	handler, err := builder.build(testSpec("app", "app.example.com"))
+	require.NoError(t, err)
+
+	single, err := NewOAuthProxy(func() *options.Options {
+		opts := baseTestOptions()
+		require.NoError(t, validation.Validate(opts))
+		return opts
+	}(), func(string) bool { return true })
+	require.NoError(t, err)
+
+	tests := []struct {
+		name              string
+		handler           http.Handler
+		path              string
+		expectedName      any
+		expectedNamespace any
+	}{
+		{name: "client of a table", handler: handler, path: "/dex-authenticator/auth", expectedName: "app", expectedNamespace: testNamespace},
+		{name: "the only client of a process", handler: single, path: "/oauth2/auth"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			output, _ := captureJSONLogs(t)
+
+			req := httptest.NewRequest(http.MethodGet, "http://app.example.com"+tt.path, nil)
+			tt.handler.ServeHTTP(httptest.NewRecorder(), req)
+
+			lines := []map[string]any{}
+			for _, line := range jsonLogLines(t, output.String()) {
+				if line["level"] == "request" || line["level"] == "auth" {
+					lines = append(lines, line)
+				}
+			}
+			require.NotEmpty(t, lines)
+			for _, line := range lines {
+				assert.Equal(t, tt.expectedName, line["authenticator"])
+				assert.Equal(t, tt.expectedNamespace, line["authenticator_namespace"])
+			}
+		})
+	}
+}
+
+// TestClientTable_revocationFeed checks that the clients of a table read one feed of the process,
+// each with the salt of its own secret, and subscribe to nothing themselves.
+func TestClientTable_revocationFeed(t *testing.T) {
+	builder := newTestClientBuilder(t)
+	feed, err := revocation.New(revocation.Options{URL: "https://revocation-feed.d8-user-authn/revocations", TokenFile: "/token"})
+	require.NoError(t, err)
+	builder.shared.revocationFeed = feed
+
+	for _, name := range []string{"first", "second"} {
+		handler, err := builder.build(testSpec(name, name+".example.com"))
+		require.NoError(t, err)
+		proxy, ok := handler.(*OAuthProxy)
+		require.True(t, ok)
+		assert.Nil(t, proxy.revocationFeed, "a client starts no subscription of its own")
+	}
+
+	// A process without the feed gives its clients none.
+	builder.shared.revocationFeed = nil
+	handler, err := builder.build(testSpec("third", "third.example.com"))
+	require.NoError(t, err)
+	proxy, ok := handler.(*OAuthProxy)
+	require.True(t, ok)
+	assert.Nil(t, proxy.revocationFeed)
+}
diff --git a/deckhouse_dispatcher.go b/deckhouse_dispatcher.go
new file mode 100644
index 00000000..04ffdb6a
--- /dev/null
+++ b/deckhouse_dispatcher.go
@@ -0,0 +1,141 @@
+package main
+
+import (
+	"net/http"
+	"slices"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	requestutil "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/requests/util"
+)
+
+// tableClient is one client of the table: an OAuthProxy with its own provider client, cookie
+// secret and settings, reachable by its hosts.
+type tableClient struct {
+	name        string
+	fingerprint [fingerprintSize]byte
+	// cookieSecret is the hash of the cookie secret of the client, as the proxy reads it.
+	cookieSecret [fingerprintSize]byte
+	// record are the hosts of the record the handler was built from, and hosts are those of them
+	// the client is served on: a client kept on the record it had gives up the hosts the clients
+	// of a newer table have taken, and gets them back once they are free.
+	record  []string
+	hosts   []string
+	handler http.Handler
+}
+
+// on returns the client served on hosts: the client itself when it is served on them already,
+// and a copy otherwise, as a client in a table is never changed.
+func (c *tableClient) on(hosts []string) *tableClient {
+	if slices.Equal(c.hosts, hosts) {
+		return c
+	}
+	served := *c
+	served.hosts = hosts
+
+	return &served
+}
+
+// clientTable is an immutable snapshot of the clients a process serves. A reload builds a new
+// snapshot and swaps it in; a request that has taken its client from the old one finishes there.
+type clientTable struct {
+	byHost map[string]*tableClient
+	byName map[string]*tableClient
+}
+
+func newClientTable() *clientTable {
+	return &clientTable{
+		byHost: map[string]*tableClient{},
+		byName: map[string]*tableClient{},
+	}
+}
+
+// dispatcher is the handler of a process that serves a table of clients (Deckhouse patch 018). It
+// chooses the client of each request by the host of the request and hands the request to the
+// OAuthProxy of that client. A host no client has is answered 403 on the auth path, which
+// ingress-nginx passes to the browser as it is while it turns a 404 of the auth subrequest into
+// its own 500, and 404 on any other path.
+//
+// The key of the choice is the security boundary between the clients: a request that reaches the
+// handler of another client is checked with the cookie secret of that client, so its answer to
+// "is this user signed in" would be given for the wrong application. The key therefore comes from
+// one place per kind of request and is parsed strictly (patch 016):
+//   - the auth subrequest of ingress-nginx (the exact path <proxy prefix>/auth with X-Original-URL
+//     and without X-Forwarded-Proto) carries the Host of the Service of the authenticator, so its
+//     key is the authority of X-Original-URL, which nginx builds from the Host header it has
+//     chosen the server by. A header that names no plain host is no key;
+//   - every other request comes through the route of the application, or is the check of an
+//     ingress controller that sends the Host of the application, so its key is the Host header.
+//
+// X-Forwarded-Host is never read: ingress-nginx passes the one the browser sent on in the auth
+// subrequest. It is overwritten with the host the client was chosen by before the handler of the
+// client runs, so that the client sees no other host in the request. The host is written the way
+// the table names it, in lower case and without a trailing dot, with the port only when it is not
+// the default one of the scheme: the client builds its redirect URI from it, and the provider
+// compares that with the registered one as a string.
+type dispatcher struct {
+	table    atomic.Pointer[clientTable]
+	authPath string
+	metrics  *clientTableMetrics
+}
+
+func newDispatcher(proxyPrefix string, metrics *clientTableMetrics) *dispatcher {
+	d := &dispatcher{
+		authPath: proxyPrefix + authOnlyPath,
+		metrics:  metrics,
+	}
+	d.table.Store(newClientTable())
+
+	return d
+}
+
+func (d *dispatcher) ServeHTTP(rw http.ResponseWriter, req *http.Request) {
+	start := time.Now()
+
+	client, forwardedHost := d.route(req)
+	if client == nil {
+		status := http.StatusNotFound
+		if req.URL.EscapedPath() == d.authPath {
+			status = http.StatusForbidden
+		}
+		http.Error(rw, "no application is served on this host", status)
+		d.metrics.unknown.Observe(time.Since(start).Seconds())
+		return
+	}
+
+	req.Header.Set(requestutil.XForwardedHost, forwardedHost)
+	client.handler.ServeHTTP(rw, req)
+	d.metrics.hit.Observe(time.Since(start).Seconds())
+}
+
+// route returns the client of the request and the host it was chosen by, as the client is to see
+// it in X-Forwarded-Host, or nil when the request names no client of the table.
+func (d *dispatcher) route(req *http.Request) (*tableClient, string) {
+	// The scheme only tells whether the port is the default one. On the route of an application
+	// the ingress controller sets X-Forwarded-Proto.
+	scheme := strings.ToLower(req.Header.Get(requestutil.XForwardedProto))
+	authority := req.Host
+	// The router of a client matches the auth path the same way: exactly, by the escaped path.
+	isSubrequest := req.URL.EscapedPath() == d.authPath && scheme == "" &&
+		len(req.Header.Values(requestutil.OriginalURLHeader)) > 0
+	if isSubrequest {
+		var ok bool
+		scheme, authority, ok = requestutil.OriginalAuthority(req.Header)
+		if !ok {
+			return nil, ""
+		}
+	}
+
+	host, port, ok := requestutil.ServerName(authority)
+	if !ok {
+		return nil, ""
+	}
+
+	client := d.table.Load().byHost[host]
+	if client == nil {
+		return nil, ""
+	}
+
+	return client, requestutil.ForwardedHost(scheme, host, port)
+}
diff --git a/deckhouse_dispatcher_test.go b/deckhouse_dispatcher_test.go
new file mode 100644
index 00000000..41a586ac
--- /dev/null
+++ b/deckhouse_dispatcher_test.go
@@ -0,0 +1,477 @@
+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// reachedRequest is what the handler of a client saw of a request.
+type reachedRequest struct {
+	client         string
+	host           string
+	forwardedHosts []string
+}
+
+// requestRecorder collects the requests that reached the handlers of the clients.
+type requestRecorder struct {
+	mu      sync.Mutex
+	reached []reachedRequest
+}
+
+// handler returns the handler of the client name: it records the request and answers 200 with
+// the name of the client.
+func (r *requestRecorder) handler(name string) http.Handler {
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		r.mu.Lock()
+		r.reached = append(r.reached, reachedRequest{
+			client:         name,
+			host:           req.Host,
+			forwardedHosts: req.Header.Values("X-Forwarded-Host"),
+		})
+		r.mu.Unlock()
+
+		rw.Header().Set("X-Test-Client", name)
+		rw.WriteHeader(http.StatusOK)
+	})
+}
+
+func (r *requestRecorder) requests() []reachedRequest {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	return append([]reachedRequest{}, r.reached...)
+}
+
+func newTestMetrics(t *testing.T) *clientTableMetrics {
+	t.Helper()
+
+	metrics, err := newClientTableMetrics(prometheus.NewRegistry())
+	require.NoError(t, err)
+
+	return metrics
+}
+
+// newTestDispatcher returns a dispatcher with the clients a (a.example.com, a2.example.com),
+// b (b.example.com) and w (w.example.com), whose handlers record what reaches them.
+func newTestDispatcher(t *testing.T) (*dispatcher, *requestRecorder) {
+	t.Helper()
+
+	recorder := &requestRecorder{}
+	table := newClientTable()
+	for name, hosts := range map[string][]string{
+		"a": {"a.example.com", "a2.example.com"},
+		"b": {"b.example.com"},
+		"w": {"w.example.com"},
+	} {
+		client := &tableClient{name: name, hosts: hosts, handler: recorder.handler(name)}
+		table.byName[name] = client
+		for _, host := range hosts {
+			table.byHost[host] = client
+		}
+	}
+
+	d := newDispatcher("/dex-authenticator", newTestMetrics(t))
+	d.table.Store(table)
+
+	return d, recorder
+}
+
+// TestDispatcher_ServeHTTP checks the security boundary between the clients of a table: a request
+// reaches the handler of the client its real host names and no other, whatever Host,
+// X-Forwarded-Host and X-Original-URL the sender forges.
+func TestDispatcher_ServeHTTP(t *testing.T) {
+	t.Parallel()
+
+	// serviceHost is the Host of the auth subrequest of ingress-nginx: the Service in auth-url.
+	const serviceHost = "app-dex-authenticator.d8-app.svc.cluster.local"
+
+	tests := []struct {
+		name string
+		path string
+		host string
+		// originalURL and forwardedHost are the values of the headers; nil leaves the header out.
+		originalURL   []string
+		forwardedHost []string
+		// forwardedProto is the X-Forwarded-Proto the ingress controller sets on a browser path.
+		forwardedProto string
+
+		// expectClient is the only client whose handler may run; empty expects 404 and no handler.
+		expectClient        string
+		expectForwardedHost string
+	}{
+		// Browser paths: the route of the application sets Host.
+		{name: "host header chooses the client of a sign-in", path: "/dex-authenticator/sign_in", host: "a.example.com", expectClient: "a", expectForwardedHost: "a.example.com"},
+		{name: "host header chooses the client of a start", path: "/dex-authenticator/start", host: "b.example.com", expectClient: "b", expectForwardedHost: "b.example.com"},
+		{name: "host header chooses the client of a callback", path: "/dex-authenticator/callback", host: "b.example.com", expectClient: "b", expectForwardedHost: "b.example.com"},
+		{name: "host header chooses the client of a sign-out", path: "/dex-authenticator/sign_out", host: "a.example.com", expectClient: "a", expectForwardedHost: "a.example.com"},
+		{name: "host header chooses the client of a static file", path: "/dex-authenticator/static/main.css", host: "w.example.com", expectClient: "w", expectForwardedHost: "w.example.com"},
+		{name: "host header chooses the client of a path outside the prefix", path: "/", host: "a.example.com", expectClient: "a", expectForwardedHost: "a.example.com"},
+		{name: "second host of a client", path: "/dex-authenticator/sign_in", host: "a2.example.com", expectClient: "a", expectForwardedHost: "a2.example.com"},
+		{name: "host with a port keeps the port for the client", path: "/dex-authenticator/sign_in", host: "a.example.com:8443", expectClient: "a", expectForwardedHost: "a.example.com:8443"},
+		{name: "host with the https port and no scheme keeps the port", path: "/dex-authenticator/sign_in", host: "a.example.com:443", expectClient: "a", expectForwardedHost: "a.example.com:443"},
+		{name: "host with the https port over https loses the port", path: "/dex-authenticator/sign_in", host: "a.example.com:443", forwardedProto: "https", expectClient: "a", expectForwardedHost: "a.example.com"},
+		{name: "host with the http port over http loses the port", path: "/dex-authenticator/sign_in", host: "a.example.com:80", forwardedProto: "http", expectClient: "a", expectForwardedHost: "a.example.com"},
+		{name: "host with the http port over https keeps the port", path: "/dex-authenticator/sign_in", host: "a.example.com:80", forwardedProto: "https", expectClient: "a", expectForwardedHost: "a.example.com:80"},
+		{name: "host with another port over https keeps the port", path: "/dex-authenticator/sign_in", host: "A.example.com.:8443", forwardedProto: "HTTPS", expectClient: "a", expectForwardedHost: "a.example.com:8443"},
+		{name: "forged scheme does not choose the client", path: "/dex-authenticator/sign_in", host: "b.example.com:443", forwardedProto: "https://a.example.com", expectClient: "b", expectForwardedHost: "b.example.com:443"},
+		{name: "unknown host in mixed case with a trailing dot and a port", path: "/dex-authenticator/callback", host: "App.Example.com.:8443"},
+		{name: "known host in mixed case with a trailing dot and a port", path: "/dex-authenticator/callback", host: "B.Example.Com.:8443", expectClient: "b", expectForwardedHost: "b.example.com:8443"},
+		{name: "host in upper case", path: "/dex-authenticator/sign_in", host: "A.Example.COM", expectClient: "a", expectForwardedHost: "a.example.com"},
+		{name: "host with a trailing dot", path: "/dex-authenticator/sign_in", host: "a.example.com.", expectClient: "a", expectForwardedHost: "a.example.com"},
+		{name: "unknown host", path: "/dex-authenticator/sign_in", host: "c.example.com"},
+		{name: "empty host", path: "/dex-authenticator/sign_in", host: ""},
+		{name: "host that only ends with a known host", path: "/dex-authenticator/sign_in", host: "evil.a.example.com"},
+		{name: "host that only starts with a known host", path: "/dex-authenticator/sign_in", host: "a.example.com.evil.test"},
+		{name: "host with userinfo of a known host", path: "/dex-authenticator/sign_in", host: "a.example.com@b.example.com"},
+		{name: "host with a port and userinfo", path: "/dex-authenticator/sign_in", host: "b.example.com:443@a.example.com"},
+		{name: "host with two ports", path: "/dex-authenticator/sign_in", host: "a.example.com:443:80"},
+		{name: "host with an empty port", path: "/dex-authenticator/sign_in", host: "a.example.com:"},
+		{name: "host with a port that is not a number", path: "/dex-authenticator/sign_in", host: "a.example.com:https"},
+		{name: "host with a query", path: "/dex-authenticator/sign_in", host: "a.example.com?b.example.com"},
+		{name: "host with a space", path: "/dex-authenticator/sign_in", host: "a.example.com b.example.com"},
+		{name: "host with two trailing dots", path: "/dex-authenticator/sign_in", host: "a.example.com.."},
+		{name: "host with an empty label", path: "/dex-authenticator/sign_in", host: "a..example.com"},
+		{name: "host that is an address in brackets", path: "/dex-authenticator/sign_in", host: "[::1]:8443"},
+		{
+			name: "forged x-forwarded-host does not choose the client and is overwritten",
+			path: "/dex-authenticator/sign_in", host: "b.example.com", forwardedHost: []string{"a.example.com"},
+			expectClient: "b", expectForwardedHost: "b.example.com",
+		},
+		{
+			name: "several forged x-forwarded-host values are overwritten by one",
+			path: "/dex-authenticator/callback", host: "b.example.com", forwardedHost: []string{"a.example.com", "w.example.com"},
+			expectClient: "b", expectForwardedHost: "b.example.com",
+		},
+		{
+			name: "forged x-forwarded-host does not rescue an unknown host",
+			path: "/dex-authenticator/sign_in", host: "c.example.com", forwardedHost: []string{"a.example.com"},
+		},
+		{
+			name: "forged x-original-url does not choose the client of a browser path",
+			path: "/dex-authenticator/userinfo", host: "b.example.com", originalURL: []string{"https://a.example.com/"},
+			expectClient: "b", expectForwardedHost: "b.example.com",
+		},
+		{
+			name: "forged x-original-url does not rescue an unknown host on a browser path",
+			path: "/dex-authenticator/sign_in", host: "c.example.com", originalURL: []string{"https://a.example.com/"},
+		},
+
+		// The auth subrequest: nginx sets Host to the Service and X-Original-URL to the request.
+		{
+			name: "x-original-url chooses the client of an auth subrequest",
+			path: "/dex-authenticator/auth", host: serviceHost, originalURL: []string{"https://a.example.com/some/page?x=1"},
+			expectClient: "a", expectForwardedHost: "a.example.com",
+		},
+		{
+			name: "x-original-url over http with the http port",
+			path: "/dex-authenticator/auth", host: serviceHost, originalURL: []string{"http://b.example.com:80/"},
+			expectClient: "b", expectForwardedHost: "b.example.com",
+		},
+		{
+			name: "x-original-url over https with the http port",
+			path: "/dex-authenticator/auth", host: serviceHost, originalURL: []string{"https://b.example.com:80/"},
+			expectClient: "b", expectForwardedHost: "b.example.com:80",
+		},
+		{
+			// ingress-nginx removes X-Forwarded-Proto from its subrequest: with it the request
+			// came another way, and its X-Original-URL is what the sender wrote.
+			name: "auth path with x-forwarded-proto is chosen by the host header, not by x-original-url",
+			path: "/dex-authenticator/auth", host: serviceHost, originalURL: []string{"https://b.example.com:80/"}, forwardedProto: "http",
+		},
+		{
+			name: "x-original-url over http",
+			path: "/dex-authenticator/auth", host: serviceHost, originalURL: []string{"http://b.example.com/"},
+			expectClient: "b", expectForwardedHost: "b.example.com",
+		},
+		{
+			name: "x-original-url with a port keeps the port for the client",
+			path: "/dex-authenticator/auth", host: serviceHost, originalURL: []string{"https://a.example.com:8443/page"},
+			expectClient: "a", expectForwardedHost: "a.example.com:8443",
+		},
+		{
+			name: "x-original-url with the https port",
+			path: "/dex-authenticator/auth", host: serviceHost, originalURL: []string{"https://a.example.com:443/page"},
+			expectClient: "a", expectForwardedHost: "a.example.com",
+		},
+		{
+			// nginx copies the Host of the browser into X-Original-URL as it came.
+			name: "x-original-url in mixed case with a trailing dot and a port",
+			path: "/dex-authenticator/auth", host: serviceHost, originalURL: []string{"https://A2.Example.com.:8443/page"},
+			expectClient: "a", expectForwardedHost: "a2.example.com:8443",
+		},
+		{
+			name: "x-original-url in upper case",
+			path: "/dex-authenticator/auth", host: serviceHost, originalURL: []string{"https://B.EXAMPLE.COM/"},
+			expectClient: "b", expectForwardedHost: "b.example.com",
+		},
+		{
+			name: "x-original-url without a path",
+			path: "/dex-authenticator/auth", host: serviceHost, originalURL: []string{"https://b.example.com"},
+			expectClient: "b", expectForwardedHost: "b.example.com",
+		},
+		{
+			name: "auth subrequest with a query",
+			path: "/dex-authenticator/auth?allowed_groups=admins", host: serviceHost, originalURL: []string{"https://b.example.com/"},
+			expectClient: "b", expectForwardedHost: "b.example.com",
+		},
+		{
+			name: "forged host header does not choose the client of an auth subrequest",
+			path: "/dex-authenticator/auth", host: "a.example.com", originalURL: []string{"https://b.example.com/"},
+			expectClient: "b", expectForwardedHost: "b.example.com",
+		},
