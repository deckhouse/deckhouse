+// TestClientTable_sharedHost runs two real clients with applications on one host behind the
+// dispatcher, as two DexAuthenticator objects publish one domain through two Ingress classes. Each
+// client answers the requests that came through its own Service, and the session of one is no
+// session for the other, whatever Service, host and headers the request names.
+func TestClientTable_sharedHost(t *testing.T) {
+	builder := newTestClientBuilder(t)
+	p := newTestTableProxy(t, builder.build)
+
+	const sharedHost = "shared.example.com"
+
+	// a is chosen by the shared host; b shares it and has a host of its own.
+	specA := testServiceSpec("a", sharedHost, "a.example.com")
+	specA.CookieSecret = testCookieSecretA
+	specB := testServiceSpec("b", "b.example.com")
+	specB.SharedHosts = []string{sharedHost}
+	specB.CookieSecret = testCookieSecretB
+	writeTable(t, p, specA, specB)
+	p.reload()
+	require.Empty(t, p.status.Load().Failed)
+
+	serviceA, serviceB := testServiceName("a"), testServiceName("b")
+
+	// signIn saves a session at the client name for the shared host and returns its cookies.
+	signIn := func(t *testing.T, name, user string) []*http.Cookie {
+		t.Helper()
+
+		proxy, ok := p.dispatcher.table.Load().byName[testNamespace+"/"+name].handler.(*OAuthProxy)
+		require.True(t, ok)
+
+		created := time.Now()
+		req := httptest.NewRequest(http.MethodGet, "https://"+sharedHost+"/", nil)
+		rw := httptest.NewRecorder()
+		require.NoError(t, proxy.sessionStore.Save(rw, req, &sessions.SessionState{
+			User:         user,
+			Email:        user + "@example.com",
+			AccessToken:  "access-token",
+			RefreshToken: "refresh-token-of-" + user,
+			CreatedAt:    &created,
+		}))
+
+		return rw.Result().Cookies()
+	}
+
+	cookiesA := signIn(t, "a", "alice")
+	cookiesB := signIn(t, "b", "bob")
+	require.Equal(t, cookiesA[0].Name, cookiesB[0].Name, "the clients use the same cookie name on the same host")
+
+	type request struct {
+		path           string
+		host           string
+		originalURL    string
+		forwardedHost  string
+		forwardedProto string
+		cookies        []*http.Cookie
+	}
+	do := func(t *testing.T, r request) *httptest.ResponseRecorder {
+		t.Helper()
+
+		req := httptest.NewRequest(http.MethodGet, "http://placeholder.test"+r.path, nil)
+		req.Host = r.host
+		if r.originalURL != "" {
+			req.Header.Set("X-Original-URL", r.originalURL)
+		}
+		if r.forwardedHost != "" {
+			req.Header.Set("X-Forwarded-Host", r.forwardedHost)
+		}
+		if r.forwardedProto != "" {
+			req.Header.Set("X-Forwarded-Proto", r.forwardedProto)
+		}
+		for _, cookie := range r.cookies {
+			req.AddCookie(cookie)
+		}
+		rw := httptest.NewRecorder()
+		p.dispatcher.ServeHTTP(rw, req)
+
+		return rw
+	}
+
+	const (
+		authPath     = "/dex-authenticator/auth"
+		userinfoPath = "/dex-authenticator/userinfo"
+		sharedURL    = "https://" + sharedHost + "/page"
+	)
+
+	accepted := []struct {
+		name       string
+		request    request
+		expectUser string
+	}{
+		{
+			name:       "session of a on the auth subrequest through the service of a",
+			request:    request{path: authPath, host: serviceA, originalURL: sharedURL, cookies: cookiesA},
+			expectUser: "alice@example.com",
+		},
+		{
+			name:       "session of b on the auth subrequest through the service of b",
+			request:    request{path: authPath, host: serviceB, originalURL: sharedURL, cookies: cookiesB},
+			expectUser: "bob@example.com",
+		},
+		{
+			name:       "session of b on the route of b, which names its service in host",
+			request:    request{path: userinfoPath, host: serviceB, forwardedHost: sharedHost, forwardedProto: "https", cookies: cookiesB},
+			expectUser: "bob@example.com",
+		},
+		{
+			name:       "session of a on the route of a, which names its service in host",
+			request:    request{path: userinfoPath, host: serviceA, forwardedHost: sharedHost, forwardedProto: "https", cookies: cookiesA},
+			expectUser: "alice@example.com",
