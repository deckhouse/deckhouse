+func TestDispatcher_EmptyTable(t *testing.T) {
+	t.Parallel()
+
+	d := newDispatcher("/dex-authenticator", newTestMetrics(t))
+
+	for path, expected := range map[string]int{
+		"/":                          http.StatusNotFound,
+		"/dex-authenticator/sign_in": http.StatusNotFound,
+		"/dex-authenticator/auth":    http.StatusForbidden,
+	} {
+		req := httptest.NewRequest(http.MethodGet, "http://a.example.com"+path, nil)
+		req.Header.Set("X-Original-URL", "https://a.example.com/")
+		rw := httptest.NewRecorder()
+
+		d.ServeHTTP(rw, req)
+
+		assert.Equal(t, expected, rw.Code, path)
+	}
+}
