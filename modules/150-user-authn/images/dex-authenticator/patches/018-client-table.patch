+func newTestTableProxy(t *testing.T, build func(clientSpec) (http.Handler, error)) *clientTableProxy {
+	t.Helper()
+
+	path := filepath.Join(t.TempDir(), "clients.json")
+
+	return newClientTableProxy(path, "/dex-authenticator", build, newTestMetrics(t))
+}
+
+func writeTable(t *testing.T, p *clientTableProxy, specs ...clientSpec) {
+	t.Helper()
+
+	// A rename puts the whole file in place at once, as the kubelet does with a Secret.
+	tmp := p.path + ".tmp"
+	require.NoError(t, os.WriteFile(tmp, encodeTable(t, specs...), 0o600))
+	require.NoError(t, os.Rename(tmp, p.path))
+}
