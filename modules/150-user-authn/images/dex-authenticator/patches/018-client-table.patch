+			req := httptest.NewRequest(http.MethodGet, "http://placeholder.test"+tt.path, nil)
+			req.Host = tt.host
+			for _, value := range tt.originalURL {
+				req.Header.Add("X-Original-URL", value)
+			}
+			for _, value := range tt.forwardedHost {
+				req.Header.Add("X-Forwarded-Host", value)
+			}
+			if tt.forwardedProto != "" {
+				req.Header.Set("X-Forwarded-Proto", tt.forwardedProto)
+			}
+			rw := httptest.NewRecorder()
+
+			d.ServeHTTP(rw, req)
+
+			reached := recorder.requests()
+			if tt.expectClient == "" {
+				// ingress-nginx passes 403 of the auth subrequest on and turns 404 into its own 500.
+				expectedStatus := http.StatusNotFound
+				if tt.path == "/dex-authenticator/auth" || strings.HasPrefix(tt.path, "/dex-authenticator/auth?") {
+					expectedStatus = http.StatusForbidden
+				}
+				assert.Equal(t, expectedStatus, rw.Code)
+				assert.Empty(t, reached, "no handler of a client may run")
+				assert.Empty(t, rw.Header().Values("Set-Cookie"))
+				assert.NotContains(t, rw.Body.String(), "example.com", "the answer must not repeat the request")
+				return
+			}
+
+			require.Len(t, reached, 1, "exactly one handler of a client must run")
+			assert.Equal(t, tt.expectClient, reached[0].client)
+			assert.Equal(t, tt.expectClient, rw.Header().Get("X-Test-Client"))
+			assert.Equal(t, http.StatusOK, rw.Code)
+			assert.Equal(t, []string{tt.expectForwardedHost}, reached[0].forwardedHosts,
+				"the client must see only the host it was chosen by")
+			assert.Equal(t, tt.host, reached[0].host)
+		})
+	}
