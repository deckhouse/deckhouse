+// FuzzDispatcherRoute checks on arbitrary Host, X-Original-URL and X-Forwarded-Host that a client
+// is chosen only by a plain host name that is exactly one of its hosts.
+func FuzzDispatcherRoute(f *testing.F) {
+	f.Add("/dex-authenticator/auth", "svc.local", "https://a.example.com/", "b.example.com")
+	f.Add("/dex-authenticator/auth", "a.example.com", "https://b.example.com:443@a.example.com/", "")
+	f.Add("/dex-authenticator/sign_in", "a.example.com:443@b.example.com", "https://a.example.com/", "a.example.com")
+	f.Add("/dex-authenticator/auth/", "B.example.com.", "", "")
+
+	recorder := &requestRecorder{}
