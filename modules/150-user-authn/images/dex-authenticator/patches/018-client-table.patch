+// TestDispatcher_ServeHTTP_goneObject checks what is left of an object the table no longer has.
+// Two objects published one host; one of them is gone with its Service, while the Ingress of its
+// application still sends the auth subrequest to that Service and the ingress controller still
+// resolves the name. The client of the object that stays is chosen by the host now, and it must
+// not answer for the gone one: a user it has signed in would get into the application of the
+// gone object past the users and groups that object allowed.
+func TestDispatcher_ServeHTTP_goneObject(t *testing.T) {
+	t.Parallel()
+
+	const authPath = "/dex-authenticator/auth"
+
+	tests := []struct {
+		name        string
+		host        string
+		originalURL string
+
+		// expectClient is the client whose handler runs; empty expects 403 and no handler.
+		expectClient string
+	}{
+		{
+			name: "service of the gone object for the host the object that stays is chosen by",
+			host: serviceOfB, originalURL: "https://shared.example.com/page",
+		},
+		{
+			name: "service of the gone object under another cluster domain",
+			host: "b-dex-authenticator.ns-b.svc.other.local", originalURL: "https://shared.example.com/page",
+		},
+		{
+			name: "service of the gone object for a host no client has",
+			host: serviceOfB, originalURL: "https://b.example.com/page",
+		},
+		{
+			name: "service of the object that stays",
+			host: serviceOfA, originalURL: "https://shared.example.com/page",
+			expectClient: "a",
+		},
+		{
+			name: "host of the application in host",
+			host: "shared.example.com", originalURL: "https://shared.example.com/page",
+			expectClient: "a",
+		},
+		{
+			name: "service that is not of an authenticator",
+			host: "auth.gateway.svc.cluster.local", originalURL: "https://shared.example.com/page",
+			expectClient: "a",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			recorder := &requestRecorder{}
+			table := newClientTable()
+			a := &tableClient{
+				name: "a", hosts: []string{"a.example.com", "shared.example.com"},
+				recordServices: []string{serviceOfA}, services: []string{serviceOfA},
+				applications: []string{"a.example.com", "shared.example.com"},
+				handler:      recorder.handler("a"),
+			}
+			table.byName[a.name] = a
+			for _, host := range a.hosts {
+				table.byHost[host] = a
+			}
+			table.byService[serviceOfA] = a
+			object, _ := serviceObject(serviceOfA)
+			table.byObject[object] = a
+			d := newDispatcher("/dex-authenticator", newTestMetrics(t))
+			d.table.Store(table)
+
+			req := httptest.NewRequest(http.MethodGet, "http://placeholder.test"+authPath, nil)
+			req.Host = tt.host
+			req.Header.Set("X-Original-URL", tt.originalURL)
+			// The session the object that stays has given the user.
+			req.AddCookie(&http.Cookie{Name: "_oauth2_proxy", Value: "session-of-a"})
+			rec := httptest.NewRecorder()
+			d.ServeHTTP(rec, req)
+
+			reached := recorder.requests()
+			if tt.expectClient == "" {
+				assert.Equal(t, http.StatusForbidden, rec.Code)
+				assert.Empty(t, reached, "no client may see the request")
+				return
+			}
+			assert.Equal(t, http.StatusOK, rec.Code)
+			require.Len(t, reached, 1)
+			assert.Equal(t, tt.expectClient, reached[0].client)
+		})
+	}
+}
