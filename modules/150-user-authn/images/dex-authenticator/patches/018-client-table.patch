+
+const (
+	fingerprintSize = sha256.Size
+
+	// clientTablePollInterval is how often the table file is read besides the file events: it
+	// finds a file that did not exist at the start and covers an event that was missed.
+	clientTablePollInterval = 10 * time.Second
+)
+
+// kubernetesScopes are the scopes that put the audience of the Kubernetes API into the ID token of
+// a client the provider trusts for it.
+const kubernetesScopes = "federated:id audience:server:client_id:kubernetes"
+
+// clientTableFile is the file --client-table names (Deckhouse patch 018): a JSON object with the
+// list of the clients of the process.
+type clientTableFile struct {
+	// Generation is the number the writer of the table gives each version of it, a larger one
+	// every time. The process reports the generation it serves, so the writer knows when a
+	// version has been loaded.
+	Generation int64        `json:"generation"`
+	Clients    []clientSpec `json:"clients"`
+}
+
+// clientSpec is one client of the table: a DexAuthenticator object. A client is built from the
+// flags of the process followed by the flags these fields stand for. The fields are all a client
+// may set: every other setting is that of the process.
+type clientSpec struct {
+	// Name and Namespace are those of the DexAuthenticator object. Together they tell the clients
+	// apart in the logs, in the session store and between two versions of the table: a client
+	// whose record did not change is not built again. Unique in the table.
+	Name      string `json:"name"`
+	Namespace string `json:"namespace"`
+	// Hosts are the hosts of the applications of the client: DNS names without a port. A request
+	// is given to the client by them, and a redirect is allowed to them. Unique in the table.
+	Hosts []string `json:"hosts"`
+	// ClientID and ClientSecret are the client at the provider: --client-id, --client-secret.
+	ClientID     string `json:"clientID"`
+	ClientSecret string `json:"clientSecret"`
+	// CookieSecret signs the cookies of the client: --cookie-secret.
+	CookieSecret string `json:"cookieSecret"`
+	// CookieExpire is --cookie-expire, a duration such as "168h".
+	CookieExpire string `json:"cookieExpire,omitempty"`
+	// AllowAccessToKubernetes adds kubernetesScopes to the scope of the process.
+	AllowAccessToKubernetes bool `json:"allowAccessToKubernetes,omitempty"`
+	// SendAuthorizationHeader is --set-authorization-header.
+	SendAuthorizationHeader bool `json:"sendAuthorizationHeader,omitempty"`
+	// ProviderLogout tells that the provider knows the hosts of the client as the addresses to
+	// return to after a sign-out. A process that signs out through the provider
+	// (--provider-logout-url) serves no client without it: the provider would answer the
+	// sign-out of such a client with an error page and keep its own session.
+	ProviderLogout bool `json:"providerLogout,omitempty"`
+}
+
+// key names the client in the table, in the logs and in the session store.
+func (c *clientSpec) key() string {
+	return c.Namespace + "/" + c.Name
+}
+
+// normalize checks the record and brings its hosts to the form the dispatcher looks them up in.
+func (c *clientSpec) normalize() error {
+	if c.Name == "" || c.Namespace == "" {
+		return errors.New("name and namespace are required")
+	}
+	if strings.Contains(c.Name, "/") || strings.Contains(c.Namespace, "/") {
+		return errors.New("name and namespace must not contain a slash")
+	}
+	if c.ClientID == "" || c.ClientSecret == "" || c.CookieSecret == "" {
+		return errors.New("clientID, clientSecret and cookieSecret are required")
+	}
+	if len(c.Hosts) == 0 {
+		return errors.New("at least one host is required")
+	}
+	if c.CookieExpire != "" {
+		if _, err := time.ParseDuration(c.CookieExpire); err != nil {
+			return fmt.Errorf("cookieExpire is not a duration: %w", err)
+		}
+	}
+
+	for i, raw := range c.Hosts {
+		host, port, ok := requestutil.ServerName(raw)
+		if !ok || port != "" || len(host) != len(raw) {
+			return fmt.Errorf("host %q is not a DNS name without a port", raw)
+		}
+		c.Hosts[i] = host
+	}
+
+	return nil
+}
+
+// args returns the flags of the client that follow the flags of the process; scope is the scope
+// of the process.
+func (c *clientSpec) args(scope string) []string {
+	args := []string{
+		"--client-id=" + c.ClientID,
+		"--client-secret=" + c.ClientSecret,
+		"--cookie-secret=" + c.CookieSecret,
+		"--set-authorization-header=" + strconv.FormatBool(c.SendAuthorizationHeader),
+	}
+	if c.CookieExpire != "" {
+		args = append(args, "--cookie-expire="+c.CookieExpire)
+	}
+	if c.AllowAccessToKubernetes {
+		args = append(args, "--scope="+strings.TrimSpace(scope+" "+kubernetesScopes))
+	}
+	for _, host := range c.Hosts {
+		args = append(args, "--whitelist-domain="+host)
+	}
+
+	return args
+}
+
+// fingerprint changes when anything in the record changes.
+func (c *clientSpec) fingerprint() ([fingerprintSize]byte, error) {
+	encoded, err := json.Marshal(c)
+	if err != nil {
+		return [fingerprintSize]byte{}, fmt.Errorf("could not encode the client: %w", err)
+	}
+
+	return sha256.Sum256(encoded), nil
+}
+
+// parsedTable is a table file as it was read: the records that passed the checks, in the order of
+// the file, and the records that did not, by the key of their client, with the reason.
+type parsedTable struct {
+	generation int64
+	clients    []clientSpec
+	refused    map[string]string
+}
+
+// parseClientTable reads the table and checks what the isolation of the clients relies on: every
+// client has a name, hosts and a cookie secret of its own. The clients share the session store, so
+// two clients with one cookie secret would take the sessions of each other.
+//
+// A record that fails a check is refused alone: the other clients are served by the new table,
+// and that client by the record it had (see apply). Of two records that claim one name, one host
+// or one cookie secret, the first in the file keeps it. Only a file that is not a table at all,
+// an unknown field included, is refused as a whole.
+func parseClientTable(data []byte, needsProviderLogout bool) (*parsedTable, error) {
+	var file clientTableFile
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&file); err != nil {
+		return nil, fmt.Errorf("could not decode the client table: %w", err)
+	}
+	// A file cut in the middle of a write, or one that is not a table, must not empty the table.
+	if _, err := decoder.Token(); !errors.Is(err, io.EOF) {
+		return nil, errors.New("could not decode the client table: the file has more than one JSON value")
+	}
+	if file.Clients == nil {
+		return nil, errors.New("could not decode the client table: the list of clients is missing")
+	}
+
+	table := &parsedTable{
+		generation: file.Generation,
+		clients:    make([]clientSpec, 0, len(file.Clients)),
+		refused:    map[string]string{},
+	}
+	keys := make(map[string]struct{}, len(file.Clients))
+	hosts := make(map[string]string, len(file.Clients))
+	cookieSecrets := make(map[[fingerprintSize]byte]string, len(file.Clients))
+
+	for i := range file.Clients {
+		spec := &file.Clients[i]
+		key := spec.key()
+		// The first record of a client is its record, refused or not: a second one is dropped.
+		if _, ok := keys[key]; ok {
+			logger.Errorf("Record %d of the client table is dropped: the client %q has a record already", i, key)
+			continue
+		}
+		keys[key] = struct{}{}
+
+		if reason := checkClientSpec(spec, needsProviderLogout, hosts, cookieSecrets); reason != "" {
+			table.refused[key] = reason
+			logger.Errorf("Record %d of the client table, client %q, is refused: %s", i, key, reason)
+			continue
+		}
+
+		for _, host := range spec.Hosts {
+			hosts[host] = key
+		}
+		cookieSecrets[cookieSecretHash(spec.CookieSecret)] = key
+		table.clients = append(table.clients, *spec)
+	}
+
+	return table, nil
+}
+
+// checkClientSpec returns why the record cannot be served next to the records accepted before it,
+// whose hosts and cookie secrets are given, or an empty string.
+func checkClientSpec(spec *clientSpec, needsProviderLogout bool, hosts map[string]string, cookieSecrets map[[fingerprintSize]byte]string) string {
+	if err := spec.normalize(); err != nil {
+		return err.Error()
+	}
+	if needsProviderLogout && !spec.ProviderLogout {
+		return "the process signs out through the provider, and the provider has no address to return to for this client"
+	}
+	seen := make(map[string]struct{}, len(spec.Hosts))
+	for _, host := range spec.Hosts {
+		if owner, ok := hosts[host]; ok {
+			return fmt.Sprintf("the host %q belongs to the client %q", host, owner)
+		}
+		if _, ok := seen[host]; ok {
+			return fmt.Sprintf("the host %q is named twice", host)
+		}
+		seen[host] = struct{}{}
+	}
+	if owner, ok := cookieSecrets[cookieSecretHash(spec.CookieSecret)]; ok {
+		return fmt.Sprintf("its cookie secret is the cookie secret of the client %q", owner)
+	}
+
+	return ""
+}
+
+// cookieSecretHash is the hash of a cookie secret as the proxy reads it: a secret and its base64
+// form are one key.
+func cookieSecretHash(secret string) [fingerprintSize]byte {
+	return sha256.Sum256(encryption.SecretBytes(secret))
+}
+
+// clientBuilder builds the OAuthProxy of a client the way main builds the only one: the flags of
+// the process and of the client go through the same option loading and validation.
+type clientBuilder struct {
+	config      string
+	alphaConfig string
+	flagSet     *pflag.FlagSet
+	args        []string
+	// scope is the scope of the process, which a client may add to.
+	scope  string
+	shared *sharedResources
+}
+
+func (b *clientBuilder) build(spec clientSpec) (http.Handler, error) {
+	args := append(slices.Clone(b.args), spec.args(b.scope)...)
+
+	// The flag set of the options exits the process on a flag it cannot parse. A client of the
+	// table must not be able to do that, so its flags are parsed here first.
+	probe := options.NewLegacyFlagSet()
+	probe.Init("client", pflag.ContinueOnError)
+	probe.SetOutput(io.Discard)
+	probe.AddFlagSet(b.flagSet)
+	if err := probe.Parse(args); err != nil {
+		return nil, fmt.Errorf("could not parse the flags: %w", err)
+	}
+
+	opts, err := loadConfiguration(b.config, b.alphaConfig, b.flagSet, args)
+	if err != nil {
+		return nil, err
+	}
+	if err := validation.ValidateClient(opts); err != nil {
+		return nil, err
+	}
+
+	proxy, err := newOAuthProxy(opts, NewValidator(opts.EmailDomains, opts.AuthenticatedEmailsFile), b.shared, spec.key())
+	if err != nil {
+		return nil, err
+	}
+
+	return proxy, nil
+}
+
+// clientTableProxy is a process that serves a table of clients (Deckhouse patch 018): the
+// dispatcher on the application server, and the table file read again when it changes.
+type clientTableProxy struct {
+	path         string
+	pollInterval time.Duration
+	// needsProviderLogout: the process signs out through the provider (--provider-logout-url).
+	needsProviderLogout bool
+	// revocationFeed is the subscription of the process to the revocation feed, nil without it.
+	revocationFeed *revocation.Feed
+	build          func(clientSpec) (http.Handler, error)
+	dispatcher     *dispatcher
+	metrics        *clientTableMetrics
+	server         proxyhttp.Server
+
+	// The state of the table file. Only one goroutine reloads: main before the servers start,
+	// the watcher after that.
+	hasSeen bool
+	seen    [sha256.Size]byte
+	lastErr string
+
+	// status is what the process reports of the table it serves.
+	status atomic.Pointer[clientTableStatus]
+}
+
+// clientTableStatus is the answer of clientTableStatusPath: the generation of the table the
+// process serves and the clients of that table whose record was refused or could not be built,
+// which are served by the record they had before, if they had one.
+type clientTableStatus struct {
+	Generation int64    `json:"generation"`
+	Clients    int      `json:"clients"`
+	Failed     []string `json:"failed"`
+}
+
+// clientTableStatusPath is where the process reports the table it serves. It is not under the
+// proxy prefix, so the routes of the applications do not lead to it: the names of the clients are
+// not for the users of the applications.
+const clientTableStatusPath = "/client-table"
+
+// serveStatus answers clientTableStatusPath and passes every other request on.
+func (p *clientTableProxy) serveStatus(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		if req.Method != http.MethodGet || req.URL.EscapedPath() != clientTableStatusPath {
+			next.ServeHTTP(rw, req)
+			return
+		}
+
+		rw.Header().Set("Content-Type", "application/json")
+		if err := json.NewEncoder(rw).Encode(p.status.Load()); err != nil {
+			logger.Errorf("Could not write the status of the client table: %v", err)
+		}
+	})
+}
+
+// runClientTable serves the table of clients opts.ClientTable names until the process is told to
+// stop. opts are the options of the process: they name no client.
+func runClientTable(opts *options.Options, builder *clientBuilder) error {
+	if err := checkClientTableOptions(opts); err != nil {
+		return err
+	}
+	if err := validation.ValidateProcess(opts); err != nil {
+		return err
+	}
+
+	// Every client verifies its ID tokens with the keys of the same provider.
+	internaloidc.ShareRemoteKeySets()
+
+	sessionStore, err := sessions.NewPersistenceStore(&opts.Session)
+	if err != nil {
+		return fmt.Errorf("error initialising session store: %w", err)
+	}
+	builder.shared = &sharedResources{sessionStore: sessionStore, refreshWindows: middleware.NewRefreshWindows()}
+	if opts.RevocationFeedURL != "" && !opts.RevocationFeedDisable {
+		builder.shared.revocationFeed, err = revocation.New(revocation.Options{
+			URL:       opts.RevocationFeedURL,
+			CAFile:    opts.RevocationFeedCAFile,
+			TokenFile: opts.RevocationFeedTokenFile,
+		})
+		if err != nil {
+			return fmt.Errorf("could not build the revocation feed: %w", err)
+		}
+		logger.Printf("Refusing the sessions revoked by the revocation feed %s", opts.RevocationFeedURL)
+	}
+	if len(opts.Providers) > 0 {
+		builder.scope = opts.Providers[0].Scope
+	}
+
+	metrics, err := newClientTableMetrics(prometheus.DefaultRegisterer)
+	if err != nil {
+		return err
+	}
+
+	p := newClientTableProxy(opts.ClientTable, opts.ProxyPrefix, builder.build, metrics)
+	p.revocationFeed = builder.shared.revocationFeed
+	p.needsProviderLogout = opts.ProviderLogoutURL != ""
+
+	// The process answers the health checks itself: they name no client. It is ready with an
+	// empty table too, so that it does not wait for the first client to appear.
+	handler := alice.New(
+		middleware.NewHealthCheck([]string{opts.PingPath}, []string{opts.PingUserAgent}),
+		middleware.NewReadynessCheck(opts.ReadyPath, sessionStore),
+		p.serveStatus,
+	).Then(p.dispatcher)
+
+	p.server, err = newServerGroup(opts, handler)
+	if err != nil {
+		return fmt.Errorf("error setting up server: %w", err)
+	}
+
+	p.reload()
+
+	return p.start()
+}
+
+func newClientTableProxy(path, proxyPrefix string, build func(clientSpec) (http.Handler, error), metrics *clientTableMetrics) *clientTableProxy {
+	p := &clientTableProxy{
+		path:         path,
+		pollInterval: clientTablePollInterval,
+		build:        build,
+		dispatcher:   newDispatcher(proxyPrefix, metrics),
+		metrics:      metrics,
+	}
+	p.status.Store(&clientTableStatus{Failed: []string{}})
+
+	return p
+}
+
+// checkClientTableOptions refuses the options of the process that do not work with a table of
+// clients.
+func checkClientTableOptions(opts *options.Options) error {
+	switch {
+	case opts.RevocationFeedURL != "" && !opts.RevocationFeedDisable && opts.RevocationFeedTokenFile == "":
+		// So that a process never runs without the feed unnoticed.
+		return errors.New("with --client-table the revocation feed is one subscription of the process: set --revocation-feed-token-file, or --revocation-feed-disable to run without the feed")
+	case opts.AuthenticatedEmailsFile != "" || opts.HtpasswdFile != "":
+		return errors.New("--authenticated-emails-file and --htpasswd-file are not supported with --client-table")
+	case len(opts.Providers) == 0 || !ptr.Deref(opts.Providers[0].OIDCConfig.SkipDiscovery, false):
+		// A client is built while the table is loaded: a provider that is asked for its
+		// configuration and does not answer would hold the load, and every later one.
+		return errors.New("--client-table needs --skip-oidc-discovery")
+	case opts.Cookie.Refresh <= 0:
+		// Without a refresh period the stub of a session restored from its cookie is trusted as
+		// it is (patch 002). With it the stub is refreshed through the provider, which refuses
+		// the refresh token of another client: that is what keeps a cookie of one client from
+		// opening a session of another whose cookie secret it has got by a mistake of the table.
+		return errors.New("--client-table needs --cookie-refresh above zero")
+	}
+
+	return nil
+}
+
+func (p *clientTableProxy) start() error {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	go p.watch(ctx)
+	if p.revocationFeed != nil {
+		go p.revocationFeed.Run(ctx)
+	}
+
+	return p.server.Start(ctx)
+}
+
+// watch reloads the table when its file changes, until ctx is done.
+func (p *clientTableProxy) watch(ctx context.Context) {
+	changed := make(chan struct{}, 1)
+	notify := func() {
+		select {
+		case changed <- struct{}{}:
+		default:
+		}
+	}
+
+	done := make(chan bool)
+	defer close(done)
+
+	ticker := time.NewTicker(p.pollInterval)
+	defer ticker.Stop()
+
+	isWatching := false
+	for {
+		// The file may appear after the process has started: the watch is set once it is there.
+		if !isWatching && fileExists(p.path) {
+			if err := watcher.WatchFileForUpdates(p.path, done, notify); err != nil {
+				logger.Errorf("Could not watch the client table, it is read every %s: %v", p.pollInterval, err)
+			}
+			// A watch that failed is not tried again: every try leaves a goroutine behind.
+			isWatching = true
+		}
+
+		select {
+		case <-ctx.Done():
+			return
+		case <-changed:
+		case <-ticker.C:
+		}
+
+		p.reload()
+	}
+}
+
+func fileExists(path string) bool {
+	_, err := os.Stat(path)
+	return err == nil
+}
+
+// reload reads the table file and, when its content is new, applies it. A file that cannot be
+// read or parsed leaves the table as it is; before the first table it leaves the table empty.
+func (p *clientTableProxy) reload() {
+	start := time.Now()
+
+	data, err := os.ReadFile(p.path)
+	if err != nil {
+		// Every failed read is a point of the metric, so a file that stays missing shows as a
+		// rate of errors; the log has it once.
+		p.metrics.reloads.WithLabelValues(reloadError).Observe(time.Since(start).Seconds())
+		p.reportError(fmt.Sprintf("could not read the client table: %v", err))
+		return
+	}
+
+	sum := sha256.Sum256(data)
+	if p.hasSeen && sum == p.seen {
+		return
+	}
+	p.hasSeen, p.seen = true, sum
+
+	table, err := parseClientTable(data, p.needsProviderLogout)
+	if err != nil {
+		p.metrics.reloads.WithLabelValues(reloadError).Observe(time.Since(start).Seconds())
+		p.reportError(err.Error())
+		return
+	}
+	p.lastErr = ""
+
+	changes := p.apply(table)
+
+	result := reloadOK
+	if changes.failed > 0 {
+		result = reloadPartial
+	}
+	p.metrics.reloads.WithLabelValues(result).Observe(time.Since(start).Seconds())
+	p.metrics.lastReload.SetToCurrentTime()
+	p.metrics.generation.Set(float64(table.generation))
+
+	logger.Printf("Client table of generation %d loaded in %s: %d clients, %d hosts; built %d, kept %d, failed %d, removed %d",
+		table.generation, time.Since(start).Round(time.Millisecond), changes.clients, changes.hosts,
+		changes.built, changes.reused, changes.failed, changes.removed)
+}
+
+// reportError logs a failure to load the table once, not on every poll.
+func (p *clientTableProxy) reportError(msg string) {
+	if msg == p.lastErr {
+		return
+	}
+	p.lastErr = msg
+	logger.Errorf("Client table %s is not loaded, the table in use stays: %s", p.path, msg)
+}
+
+// tableChanges is what a reload did.
+type tableChanges struct {
+	clients, hosts                 int
+	built, reused, failed, removed int
+}
+
+// apply builds the clients of table and swaps them in. A client whose record is the same as in
+// the current table keeps its OAuthProxy, and with it everything the proxy remembers. A client
+// whose record was refused or cannot be built is served as before: by its previous OAuthProxy, on
+// the hosts it had that no client of the new table has taken. A new client that fails is left out.
+func (p *clientTableProxy) apply(table *parsedTable) tableChanges {
+	current := p.dispatcher.table.Load()
+	next := newClientTable()
+	var changes tableChanges
+	failed := []string{}
+
+	cookieSecrets := map[[fingerprintSize]byte]struct{}{}
+	add := func(client *tableClient) {
+		next.byName[client.name] = client
+		cookieSecrets[client.cookieSecret] = struct{}{}
+		for _, host := range client.hosts {
+			next.byHost[host] = client
+		}
+	}
+
+	// The clients that are built get their hosts first: a client served as before keeps only
+	// the hosts they leave.
+	kept := []*tableClient{}
+	for _, spec := range table.clients {
+		client, change := p.client(spec, current.byName[spec.key()])
+		switch change {
+		case changeBuilt:
+			changes.built++
+			add(client)
+		case changeReused:
+			changes.reused++
+			add(client)
+		default:
+			changes.failed++
+			failed = append(failed, spec.key())
+			if client != nil {
+				kept = append(kept, client)
+			}
+		}
+		p.metrics.changes.WithLabelValues(change).Inc()
+	}
+	for key := range table.refused {
+		changes.failed++
+		failed = append(failed, key)
+		p.metrics.changes.WithLabelValues(changeFailed).Inc()
+		if previous := current.byName[key]; previous != nil {
+			kept = append(kept, previous)
+		}
+	}
+	for _, previous := range kept {
+		// The cookie secret of the record a client had may be the one a client of the new table
+		// has now: served together, they would take the cookies of each other.
+		if _, isTaken := cookieSecrets[previous.cookieSecret]; isTaken {
+			logger.Errorf("Client %q of the client table is not served by its previous record: a client of the new table has its cookie secret", previous.name)
+			continue
+		}
+		// The hosts of its record, not only those it is served on now: a host that a client of
+		// an earlier table took and has given up since comes back.
+		hosts := make([]string, 0, len(previous.record))
+		for _, host := range previous.record {
+			if _, isTaken := next.byHost[host]; !isTaken {
+				hosts = append(hosts, host)
+			}
+		}
+		add(previous.on(hosts))
+	}
+
+	for name := range current.byName {
+		if _, ok := next.byName[name]; !ok {
+			changes.removed++
+			p.metrics.changes.WithLabelValues(changeRemoved).Inc()
+		}
+	}
+
+	p.dispatcher.table.Store(next)
+
+	// A client kept without a host stays in the table for its hosts to come back, and is not
+	// counted as served.
+	for _, client := range next.byName {
+		if len(client.hosts) > 0 {
+			changes.clients++
+		}
+	}
+	changes.hosts = len(next.byHost)
+	p.metrics.clients.Set(float64(changes.clients))
+	p.metrics.hosts.Set(float64(changes.hosts))
+	slices.Sort(failed)
+	p.status.Store(&clientTableStatus{Generation: table.generation, Clients: changes.clients, Failed: failed})
+
+	return changes
+}
+
+// client returns the client of spec for the next table and what was done to get it. previous is
+// the client of that name in the current table, if there is one. A client that cannot be built is
+// returned as it was, or nil when it is new.
+func (p *clientTableProxy) client(spec clientSpec, previous *tableClient) (*tableClient, string) {
+	fingerprint, err := spec.fingerprint()
+	if err == nil && previous != nil && previous.fingerprint == fingerprint {
+		// The record is the one the client was built from: it is served on all its hosts again,
+		// also after a table that had left it only some of them.
+		return previous.on(previous.record), changeReused
+	}
+
+	var handler http.Handler
+	if err == nil {
+		handler, err = p.build(spec)
+	}
+	if err != nil {
+		logger.Errorf("Client %q of the client table is not built: %v", spec.key(), err)
+		return previous, changeFailed
+	}
+
+	logger.Printf("Client %q of the client table is built: client ID %s, hosts %s",
+		spec.key(), spec.ClientID, strings.Join(spec.Hosts, ","))
+
+	return &tableClient{
+		name:         spec.key(),
+		fingerprint:  fingerprint,
+		cookieSecret: cookieSecretHash(spec.CookieSecret),
+		record:       spec.Hosts,
+		hosts:        spec.Hosts,
+		handler:      handler,
+	}, changeBuilt
+}
+
+const (
+	reloadOK      = "ok"
+	reloadPartial = "partial"
+	reloadError   = "error"
+
+	changeBuilt   = "built"
+	changeReused  = "reused"
+	changeFailed  = "failed"
+	changeRemoved = "removed"
+
+	outcomeHit     = "hit"
+	outcomeUnknown = "unknown"
+)
+
+// clientTableMetrics are the metrics of the dispatcher and of the table. No label carries a host,
+// a client or anything of a user.
+type clientTableMetrics struct {
+	hit        prometheus.Observer
+	unknown    prometheus.Observer
+	clients    prometheus.Gauge
+	hosts      prometheus.Gauge
+	reloads    *prometheus.HistogramVec
+	changes    *prometheus.CounterVec
+	lastReload prometheus.Gauge
+	generation prometheus.Gauge
+}
+
+func newClientTableMetrics(registerer prometheus.Registerer) (*clientTableMetrics, error) {
+	requests := prometheus.NewHistogramVec(
+		prometheus.HistogramOpts{
+			Name:    "oauth2_proxy_dispatch_request_duration_seconds",
+			Help:    "Time to serve a request by the outcome of choosing its client: hit (a client of the table served it) or unknown (no client has the host, answered 403 on the auth path and 404 elsewhere). The count of the histogram is the number of requests.",
+			Buckets: []float64{0.00025, 0.0005, 0.001, 0.0025, 0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10},
+		},
+		[]string{"outcome"},
+	)
+	m := &clientTableMetrics{
+		hit:     requests.WithLabelValues(outcomeHit),
+		unknown: requests.WithLabelValues(outcomeUnknown),
+		clients: prometheus.NewGauge(prometheus.GaugeOpts{
+			Name: "oauth2_proxy_client_table_clients",
+			Help: "Number of clients in the client table.",
+		}),
+		hosts: prometheus.NewGauge(prometheus.GaugeOpts{
+			Name: "oauth2_proxy_client_table_hosts",
+			Help: "Number of hosts in the client table.",
+		}),
+		reloads: prometheus.NewHistogramVec(
+			prometheus.HistogramOpts{
+				Name:    "oauth2_proxy_client_table_reload_duration_seconds",
+				Help:    "Time to load a new client table by result: ok, partial (the record of some clients was refused or could not be built) or error (the file was refused).",
+				Buckets: []float64{0.001, 0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10, 30},
+			},
+			[]string{"result"},
+		),
+		changes: prometheus.NewCounterVec(
+			prometheus.CounterOpts{
+				Name: "oauth2_proxy_client_table_client_changes_total",
+				Help: "Clients by what a load of the client table did to them: built, reused (not changed, kept as is), failed (not built) or removed.",
+			},
+			[]string{"change"},
+		),
+		lastReload: prometheus.NewGauge(prometheus.GaugeOpts{
+			Name: "oauth2_proxy_client_table_last_reload_timestamp_seconds",
+			Help: "Unix time of the last load of a new client table.",
+		}),
+		generation: prometheus.NewGauge(prometheus.GaugeOpts{
+			Name: "oauth2_proxy_client_table_generation",
+			Help: "Generation of the client table in use, as its writer numbered it.",
+		}),
+	}
+
+	for _, collector := range []prometheus.Collector{requests, m.clients, m.hosts, m.reloads, m.changes, m.lastReload, m.generation} {
+		if err := registerer.Register(collector); err != nil {
+			return nil, fmt.Errorf("could not register the metrics of the client table: %w", err)
+		}
+	}
+
+	return m, nil
+}
