+// TestClientTableProxy_reloadConcurrent serves requests while the table changes; the race detector
+// checks the swap.
+func TestClientTableProxy_reloadConcurrent(t *testing.T) {
+	t.Parallel()
+
+	builder := newStubBuilder()
+	p := newTestTableProxy(t, builder.build)
+
+	specs := []clientSpec{testSpec("a", "a.example.com"), testSpec("b", "b.example.com"), testSpec("c", "c.example.com")}
+	writeTable(t, p, specs...)
+	p.reload()
+
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Go(func() {
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				for _, host := range []string{"a.example.com", "b.example.com"} {
+					req := httptest.NewRequest(http.MethodGet, "http://"+host+"/", nil)
+					rw := httptest.NewRecorder()
+					p.dispatcher.ServeHTTP(rw, req)
+					if rw.Code != http.StatusOK || !strings.HasPrefix(rw.Body.String(), host[:1]+"#") {
+						t.Errorf("%s answered %d %q", host, rw.Code, rw.Body.String())
+						return
+					}
+				}
+			}
+		})
+	}
+
+	for i := range 200 {
+		specs[i%2].CookieExpire = fmt.Sprintf("%dh", i+1)
+		if i%3 == 0 {
+			writeTable(t, p, specs[:2]...)
+		} else {
+			writeTable(t, p, specs...)
+		}
+		p.reload()
+	}
+	close(stop)
+	wg.Wait()
+
+	assert.Equal(t, 101, builder.count("a"))
+	assert.Equal(t, 101, builder.count("b"))
+}
