+		{
+			name: "name of the service in x-forwarded-host does not choose the client",
+			path: signInPath, host: "a.example.com", forwardedHost: []string{serviceOfB}, forwardedProto: "https",
+			expectClient: "a", expectForwardedHost: "a.example.com",
+		},
+		{
+			name: "name of the service in x-original-url does not choose the client",
+			path: authPath, host: "a.example.com", originalURL: []string{"https://" + serviceOfB + "/"},
+		},
