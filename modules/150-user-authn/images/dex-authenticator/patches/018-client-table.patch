+			table: `{"generation":1,"clients":[{"name":"app","namespace":"ns","hosts":["app.example.com","app2.example.com"],"clientID":"id",
+				"clientSecret":"` + testClientSecret + `","cookieSecret":"` + testCookieSecretA + `","cookieExpire":"24h",
+				"allowAccessToKubernetes":true,"sendAuthorizationHeader":true,"providerLogout":true}]}`,
+			expectedClients: []string{"ns/app"},
+		},
+		{name: "empty file", table: ``, expectedErr: "could not decode"},
+		{name: "not json", table: `clients: []`, expectedErr: "could not decode"},
+		{name: "unknown field", table: `{"clients":[{"name":"app","host":"app.example.com"}]}`, expectedErr: "unknown field"},
+		{name: "flags of the process are no field of a client", table: `{"clients":[` + record(`"name":"app"`, `"name":"app","extraArgs":["--cookie-refresh=1m"]`) + `]}`, expectedErr: "unknown field"},
+
+		{name: "no name", table: `{"clients":[` + record(`"name":"app",`, ``) + `,` + other + `]}`, expectedClients: []string{"ns/other"}, expectedRefused: map[string]string{"ns/": "name and namespace are required"}},
+		{name: "no namespace", table: `{"clients":[` + record(`"namespace":"ns",`, ``) + `]}`, expectedRefused: map[string]string{"/app": "name and namespace are required"}},
+		{name: "slash in the name", table: `{"clients":[` + record(`"name":"app"`, `"name":"a/pp"`) + `]}`, expectedRefused: map[string]string{"ns/a/pp": "must not contain a slash"}},
+		{name: "no client id", table: `{"clients":[` + record(`"clientID":"id",`, ``) + `]}`, expectedRefused: map[string]string{"ns/app": "are required"}},
+		{name: "no client secret", table: `{"clients":[` + record(`"clientSecret":"`+testClientSecret+`",`, ``) + `]}`, expectedRefused: map[string]string{"ns/app": "are required"}},
+		{name: "no cookie secret", table: `{"clients":[` + record(`,"cookieSecret":"`+testCookieSecretA+`"`, ``) + `]}`, expectedRefused: map[string]string{"ns/app": "are required"}},
+		{name: "no hosts", table: `{"clients":[` + record(`["app.example.com"]`, `[]`) + `]}`, expectedRefused: map[string]string{"ns/app": "at least one host"}},
+		{name: "host with a port", table: `{"clients":[` + record("app.example.com", "app.example.com:443") + `]}`, expectedRefused: map[string]string{"ns/app": "not a DNS name"}},
+		{name: "host with a scheme", table: `{"clients":[` + record("app.example.com", "https://app.example.com") + `]}`, expectedRefused: map[string]string{"ns/app": "not a DNS name"}},
+		{name: "host with a trailing dot", table: `{"clients":[` + record("app.example.com", "app.example.com.") + `]}`, expectedRefused: map[string]string{"ns/app": "not a DNS name"}},
+		{name: "wildcard host", table: `{"clients":[` + record("app.example.com", "*.example.com") + `]}`, expectedRefused: map[string]string{"ns/app": "not a DNS name"}},
+		{name: "empty host", table: `{"clients":[` + record("app.example.com", "") + `]}`, expectedRefused: map[string]string{"ns/app": "not a DNS name"}},
+		{name: "bad cookie expire", table: `{"clients":[` + record(`"clientID"`, `"cookieExpire":"week","clientID"`) + `]}`, expectedRefused: map[string]string{"ns/app": "cookieExpire is not a duration"}},
+
+		// A host or a Service that two records claim and no client is served by goes to none of
+		// them, whatever the order of the file, and the other clients of the table are not
+		// touched. Of two records with one cookie secret the first keeps it.
+		{
+			name:            "host used twice",
+			table:           `{"clients":[` + record() + `,` + record(`"name":"app"`, `"name":"second"`, testCookieSecretA, testCookieSecretC) + `,` + other + `]}`,
+			expectedClients: []string{"ns/other"},
+			expectedRefused: map[string]string{
+				"ns/app":    `the host "app.example.com" is claimed by the client "ns/second" too, and no client is served by it`,
+				"ns/second": `the host "app.example.com" is claimed by the client "ns/app" too, and no client is served by it`,
+			},
+		},
+		{
+			name:            "host used twice in another case",
+			table:           `{"clients":[` + record() + `,` + record(`"name":"app"`, `"name":"second"`, "app.example.com", "APP.example.com", testCookieSecretA, testCookieSecretC) + `]}`,
+			expectedRefused: map[string]string{"ns/app": `is claimed by the client "ns/second"`, "ns/second": `is claimed by the client "ns/app"`},
+		},
+		{
+			name:            "cookie secret used twice",
+			table:           `{"clients":[` + record() + `,` + record(`"name":"app"`, `"name":"second"`, "app.example.com", "second.example.com") + `]}`,
+			expectedClients: []string{"ns/app"},
+			expectedRefused: map[string]string{"ns/second": `is the cookie secret of the client "ns/app"`},
+		},
+		{
+			name:            "host named twice by one client",
+			table:           `{"clients":[` + record(`["app.example.com"]`, `["app.example.com","APP.example.com"]`) + `]}`,
+			expectedRefused: map[string]string{"ns/app": `the host "app.example.com" is named twice`},
+		},
+		{
+			// The second record of a client is dropped, and the client is served by the first.
+			name:            "client with two records",
+			table:           `{"clients":[` + record() + `,` + record("app.example.com", "second.example.com", testCookieSecretA, testCookieSecretC) + `]}`,
+			expectedClients: []string{"ns/app"},
+		},
+		{
+			// The first record of a client is its record even when it is refused: a second one
+			// does not bring the client in next to the record it is kept on.
+			name:            "client whose first record is refused and second is valid",
+			table:           `{"clients":[` + record(`"clientID":"id",`, ``) + `,` + record() + `]}`,
+			expectedRefused: map[string]string{"ns/app": "are required"},
+		},
+		{
+			// The proxy reads a cookie secret that is base64 of 16, 24 or 32 bytes as those bytes:
+			// the secret and its padded form are one key.
+			name:            "cookie secret used twice in another form",
+			table:           `{"clients":[` + record(testCookieSecretA, testBase64Secret) + `,` + record(`"name":"app"`, `"name":"second"`, "app.example.com", "second.example.com", testCookieSecretA, testBase64Secret+"=") + `]}`,
+			expectedClients: []string{"ns/app"},
+			expectedRefused: map[string]string{"ns/second": `is the cookie secret of the client "ns/app"`},
+		},
+		// The names of the Service and the shared hosts.
+		{
+			name:            "names of the service and shared hosts",
+			table:           `{"clients":[` + record(`"clientID"`, `"services":["app-dex-authenticator.ns.svc.cluster.local"],"sharedHosts":["shared.example.com"],"clientID"`) + `]}`,
+			expectedClients: []string{"ns/app"},
+		},
+		{
+			name:            "shared hosts only",
+			table:           `{"clients":[` + record(`["app.example.com"]`, `[]`, `"clientID"`, `"services":["app-dex-authenticator.ns.svc.cluster.local"],"sharedHosts":["shared.example.com"],"clientID"`) + `]}`,
+			expectedClients: []string{"ns/app"},
+		},
+		{
+			name:            "shared host without a name of the service",
+			table:           `{"clients":[` + record(`"clientID"`, `"sharedHosts":["shared.example.com"],"clientID"`) + `,` + other + `]}`,
+			expectedClients: []string{"ns/other"},
+			expectedRefused: map[string]string{"ns/app": "a shared host needs a name of the Service"},
+		},
+		{
+			name: "shared host named by two clients",
+			table: `{"clients":[` + record(`"clientID"`, `"services":["app.ns.svc"],"sharedHosts":["shared.example.com"],"clientID"`) + `,` +
+				record(`"name":"app"`, `"name":"second"`, "app.example.com", "second.example.com", testCookieSecretA, testCookieSecretC, `"clientID"`, `"services":["second.ns.svc"],"sharedHosts":["shared.example.com"],"clientID"`) + `]}`,
+			expectedClients: []string{"ns/app", "ns/second"},
+		},
+		{
+			name: "shared host that is the host of another client",
+			table: `{"clients":[` + record() + `,` +
+				record(`"name":"app"`, `"name":"second"`, "app.example.com", "second.example.com", testCookieSecretA, testCookieSecretC, `"clientID"`, `"services":["second.ns.svc"],"sharedHosts":["app.example.com"],"clientID"`) + `]}`,
+			expectedClients: []string{"ns/app", "ns/second"},
+		},
+		{
+			name:            "shared host that is a host of the client itself",
+			table:           `{"clients":[` + record(`"clientID"`, `"services":["app.ns.svc"],"sharedHosts":["APP.example.com"],"clientID"`) + `]}`,
+			expectedRefused: map[string]string{"ns/app": `the host "app.example.com" is named twice`},
+		},
+		{
+			name:            "shared host with a port",
+			table:           `{"clients":[` + record(`"clientID"`, `"services":["app.ns.svc"],"sharedHosts":["shared.example.com:443"],"clientID"`) + `]}`,
+			expectedRefused: map[string]string{"ns/app": `shared host "shared.example.com:443" is not a DNS name`},
+		},
+		{
+			name:            "name of the service with a port",
+			table:           `{"clients":[` + record(`"clientID"`, `"services":["app.ns.svc:443"],"clientID"`) + `]}`,
+			expectedRefused: map[string]string{"ns/app": `name of the Service "app.ns.svc:443" is not a DNS name`},
+		},
+		{
+			name: "name of the service used twice",
+			table: `{"clients":[` + record(`"clientID"`, `"services":["app.ns.svc"],"clientID"`) + `,` +
+				record(`"name":"app"`, `"name":"second"`, "app.example.com", "second.example.com", testCookieSecretA, testCookieSecretC, `"clientID"`, `"services":["APP.ns.svc"],"clientID"`) + `,` + other + `]}`,
+			expectedClients: []string{"ns/other"},
+			expectedRefused: map[string]string{
+				"ns/app":    `the Service "app.ns.svc" is claimed by the client "ns/second" too`,
+				"ns/second": `the Service "app.ns.svc" is claimed by the client "ns/app" too`,
+			},
+		},
+		{
+			name:            "name of the service named twice by one client",
+			table:           `{"clients":[` + record(`"clientID"`, `"services":["app.ns.svc","app.ns.svc"],"clientID"`) + `]}`,
+			expectedRefused: map[string]string{"ns/app": `the name of the Service "app.ns.svc" is named twice`},
+		},
+		{
+			name: "one service under two domains by two clients",
+			table: `{"clients":[` + record(`"clientID"`, `"services":["app.ns.svc.cluster.local"],"clientID"`) + `,` +
+				record(`"name":"app"`, `"name":"second"`, "app.example.com", "second.example.com", testCookieSecretA, testCookieSecretC, `"clientID"`, `"services":["app.ns.svc.alias.local"],"clientID"`) + `,` + other + `]}`,
+			expectedClients: []string{"ns/other"},
+			expectedRefused: map[string]string{
+				"ns/app":    `the Service "app.ns.svc.cluster.local" is claimed by the client "ns/second" too`,
+				"ns/second": `the Service "app.ns.svc.alias.local" is claimed by the client "ns/app" too`,
+			},
+		},
+		{
+			name:            "one service under two domains by one client",
+			table:           `{"clients":[` + record(`"clientID"`, `"services":["app.ns.svc.cluster.local","app.ns.svc.alias.local","app.ns"],"clientID"`) + `]}`,
+			expectedClients: []string{"ns/app"},
+		},
+		{name: "two json values", table: `{"clients":[` + record() + `]}{`, expectedErr: "more than one JSON value"},
+		{name: "null", table: `null`, expectedErr: "the list of clients is missing"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			table, err := parseClientTable([]byte(tt.table), false, servedNames{})
+			if tt.expectedErr != "" {
+				require.ErrorContains(t, err, tt.expectedErr)
+				assert.Nil(t, table)
+				assert.NotContains(t, err.Error(), "dh-test-secret", "an error must not carry a secret")
+				return
+			}
+			require.NoError(t, err)
+
+			keys := []string{}
+			for i := range table.clients {
+				keys = append(keys, table.clients[i].key())
+			}
+			assert.ElementsMatch(t, tt.expectedClients, keys)
+			require.Len(t, table.refused, len(tt.expectedRefused))
+			for key, reason := range tt.expectedRefused {
+				assert.Contains(t, table.refused[key], reason)
+				assert.NotContains(t, table.refused[key], "dh-test-secret", "a reason must not carry a secret")
+			}
+		})
+	}
+
+	t.Run("the generation is read", func(t *testing.T) {
+		t.Parallel()
+
+		table, err := parseClientTable([]byte(`{"generation":7,"clients":[`+record()+`]}`), false, servedNames{})
+		require.NoError(t, err)
+		assert.EqualValues(t, 7, table.generation)
+	})
+
+	t.Run("hosts are brought to lower case", func(t *testing.T) {
+		t.Parallel()
+
+		table, err := parseClientTable(encodeTable(t, testSpec("app", "App.Example.COM")), false, servedNames{})
+		require.NoError(t, err)
+		require.Len(t, table.clients, 1)
+		assert.Equal(t, []string{"app.example.com"}, table.clients[0].Hosts)
+	})
+
+	t.Run("names of the service and shared hosts are brought to lower case", func(t *testing.T) {
+		t.Parallel()
+
+		spec := testSpec("app", "app.example.com")
+		spec.Services = []string{"App-Dex-Authenticator.NS.svc.Cluster.Local"}
+		spec.SharedHosts = []string{"Shared.Example.COM"}
+		table, err := parseClientTable(encodeTable(t, spec), false, servedNames{})
+		require.NoError(t, err)
+		require.Len(t, table.clients, 1)
+		assert.Equal(t, []string{"app-dex-authenticator.ns.svc.cluster.local"}, table.clients[0].Services)
+		assert.Equal(t, []string{"shared.example.com"}, table.clients[0].SharedHosts)
+	})
+
+	t.Run("a process that signs out through the provider refuses a client without a return address", func(t *testing.T) {
+		t.Parallel()
+
+		withLogout := testSpec("with", "with.example.com")
+		withLogout.ProviderLogout = true
+		data := encodeTable(t, testSpec("without", "without.example.com"), withLogout)
+
+		table, err := parseClientTable(data, true, servedNames{})
+		require.NoError(t, err)
+		require.Len(t, table.clients, 1)
+		assert.Equal(t, "ns/with", table.clients[0].key())
+		assert.Contains(t, table.refused["ns/without"], "no address to return to")
+
+		table, err = parseClientTable(data, false, servedNames{})
+		require.NoError(t, err)
+		assert.Len(t, table.clients, 2, "a process without the sign-out through the provider serves both")
+	})
+}
