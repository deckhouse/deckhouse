+// reloadCount returns how many reloads of the table ended with result.
+func reloadCount(t *testing.T, p *clientTableProxy, result string) uint64 {
+	t.Helper()
+
+	histogram, ok := p.metrics.reloads.WithLabelValues(result).(prometheus.Histogram)
+	require.True(t, ok)
+	var metric dto.Metric
+	require.NoError(t, histogram.Write(&metric))
+
+	return metric.GetHistogram().GetSampleCount()
+}
