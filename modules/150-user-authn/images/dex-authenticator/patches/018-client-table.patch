+			name:       "no session past the ingress with the service of b and the shared host",
+			request:    request{path: authPath, host: serviceB, originalURL: sharedURL},
+			expectCode: http.StatusUnauthorized,
+		},
+		{
+			name:       "session of a past the ingress with the service of b and the host of a",
+			request:    request{path: authPath, host: serviceB, originalURL: "https://a.example.com/", cookies: cookiesA},
+			expectCode: http.StatusForbidden,
