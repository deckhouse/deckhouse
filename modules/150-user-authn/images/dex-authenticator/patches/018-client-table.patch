+// testServiceSpec returns a client with the name of its Service, as the controller writes it.
+func testServiceSpec(name string, hosts ...string) clientSpec {
+	spec := testSpec(name, hosts...)
+	spec.Services = []string{testServiceName(name)}
+
+	return spec
+}
+
+func testServiceName(name string) string {
+	return name + "-dex-authenticator." + testNamespace + ".svc.cluster.local"
+}
+
+// getThrough asks the dispatcher for the auth subrequest ingress-nginx sends through the Service
+// service for a request to host, and returns the status and the body.
+func getThrough(t *testing.T, d *dispatcher, service, host string) (int, string) {
+	t.Helper()
+
+	req := httptest.NewRequest(http.MethodGet, "http://"+service+"/dex-authenticator/auth", nil)
+	req.Header.Set("X-Original-URL", "https://"+host+"/")
+	rw := httptest.NewRecorder()
+	d.ServeHTTP(rw, req)
+
+	return rw.Code, rw.Body.String()
+}
