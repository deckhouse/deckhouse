+// The Redis sidecar of the Deckhouse dex-authenticator may start after the proxy, so the
+// connection test retries for about 20 seconds before the proxy gives up.
+var (
+	redisConnectionTestAttempts = 10
+	redisConnectionTestInterval = 2 * time.Second
+)
+
 func validateSessionCookieMinimal(o *options.Options) []string {
 	if !o.Session.Cookie.Minimal {
 		return []string{}
@@ -65,7 +73,7 @@ func sendRedisConnectionTest(client redis.Client, key string, val string) []stri
 	msgs := []string{}
 	ctx := context.Background()
 
-	err := client.Set(ctx, key, []byte(val), time.Duration(60)*time.Second)
+	err := setRedisInitializationKey(ctx, client, key, val)
 	if err != nil {
 		msgs = append(msgs, fmt.Sprintf("unable to set a redis initialization key: %v", err))
 	} else {
@@ -86,3 +94,19 @@ func sendRedisConnectionTest(client redis.Client, key string, val string) []stri
 	}
 	return msgs
 }
+
+// setRedisInitializationKey sets the initialization key, retrying while Redis is not reachable yet.
+func setRedisInitializationKey(ctx context.Context, client redis.Client, key string, val string) error {
+	var err error
+	for attempt := range redisConnectionTestAttempts {
+		if attempt > 0 {
+			time.Sleep(redisConnectionTestInterval)
+		}
+		logger.Printf("testing connection to redis...")
+		err = client.Set(ctx, key, []byte(val), time.Duration(60)*time.Second)
+		if err == nil {
+			return nil
+		}
+	}
+	return err
+}
