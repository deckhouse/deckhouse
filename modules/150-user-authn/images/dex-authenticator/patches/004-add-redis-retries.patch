+package validation
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/apis/sessions"
+	"github.com/stretchr/testify/assert"
+)
+
+func init() {
+	// The upstream tests of an unreachable Redis expect a single attempt: each one waits for a dial
+	// timeout. TestSendRedisConnectionTestRetries sets the attempts it needs.
+	redisConnectionTestAttempts = 1
+	redisConnectionTestInterval = time.Millisecond
+}
+
+// startingRedis fails every Set until it has been asked failures times, like a Redis sidecar that
+// starts after the proxy.
+type startingRedis struct {
+	failures int
+	sets     int
+	data     map[string][]byte
+}
+
+func (r *startingRedis) Get(_ context.Context, key string) ([]byte, error) {
+	return r.data[key], nil
+}
+
+func (r *startingRedis) Lock(string) sessions.Lock {
+	return &sessions.NoOpLock{}
+}
+
+func (r *startingRedis) Set(_ context.Context, key string, value []byte, _ time.Duration) error {
+	r.sets++
+	if r.sets <= r.failures {
+		return errors.New("connection refused")
+	}
+	r.data[key] = value
+	return nil
+}
+
+func (r *startingRedis) Del(_ context.Context, key string) error {
+	delete(r.data, key)
+	return nil
+}
+
+func (r *startingRedis) Ping(context.Context) error {
+	return nil
+}
+
+func TestSendRedisConnectionTestRetries(t *testing.T) {
+	attempts := redisConnectionTestAttempts
+	redisConnectionTestAttempts = 10
+	t.Cleanup(func() { redisConnectionTestAttempts = attempts })
+
+	tests := []struct {
+		name         string
+		failures     int
+		expectedSets int
+		expectedMsgs []string
+	}{
+		{
+			name:         "redis is up",
+			failures:     0,
+			expectedSets: 1,
+			expectedMsgs: []string{},
+		},
+		{
+			name:         "redis comes up before the last attempt",
+			failures:     redisConnectionTestAttempts - 1,
+			expectedSets: redisConnectionTestAttempts,
+			expectedMsgs: []string{},
+		},
+		{
+			name:         "redis never comes up",
+			failures:     redisConnectionTestAttempts,
+			expectedSets: redisConnectionTestAttempts,
+			expectedMsgs: []string{"unable to set a redis initialization key: connection refused"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			client := &startingRedis{failures: tt.failures, data: map[string][]byte{}}
+
+			msgs := sendRedisConnectionTest(client, "key", "value")
+
+			assert.Equal(t, tt.expectedMsgs, msgs)
+			assert.Equal(t, tt.expectedSets, client.sets)
+			assert.Empty(t, client.data, "the initialization key must be deleted")
+		})
+	}
+}
