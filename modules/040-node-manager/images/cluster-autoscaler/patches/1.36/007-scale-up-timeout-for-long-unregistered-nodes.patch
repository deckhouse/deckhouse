+func TestScaleUpCompletionWithDeletedNodes(t *testing.T) {
+	testCases := []struct {
+		name                      string
+		hasInstanceNotImplemented bool
+	}{
+		{
+			name: "HasInstance implemented",
+		},
+		{
+			name:                      "HasInstance not implemented",
+			hasInstanceNotImplemented: true,
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			now := time.Now()
+
+			ng1_1 := BuildTestNode("ng1-1", 1000, 1000)
+			SetNodeReadyState(ng1_1, true, now.Add(-time.Hour))
+			ng1_2 := BuildTestNode("ng1-2", 1000, 1000)
+			SetNodeReadyState(ng1_2, true, now.Add(-time.Hour))
+			ng1_2.Spec.Taints = []apiv1.Taint{{Key: taints.ToBeDeletedTaint, Effect: apiv1.TaintEffectNoSchedule}}
+
+			provider := testprovider.NewTestCloudProviderBuilder().
+				WithHasInstance(func(name string) (bool, error) {
+					if tc.hasInstanceNotImplemented {
+						return false, cloudprovider.ErrNotImplemented
+					}
+					return name != ng1_2.Name, nil
+				}).
+				WithOnScaleUp(func(nodeGroup string, delta int) error { return nil }).
+				Build()
+			provider.AddNodeGroup("ng1", 1, 10, 2)
+			ng1 := provider.GetNodeGroup("ng1")
+			provider.AddNode("ng1", ng1_1)
+			provider.AddNode("ng1", ng1_2)
+
+			fakeClient := &fake.Clientset{}
+			fakeLogRecorder, _ := utils.NewStatusMapRecorder(fakeClient, "kube-system", kube_record.NewFakeRecorder(5), false, "my-cool-configmap")
+			registry := newMockTemplateNodeInfoRegistry(map[string]*framework.NodeInfo{"ng1": framework.NewTestNodeInfo(ng1_1)})
+			nodeGroupConfigProcessor := nodegroupconfig.NewDefaultNodeGroupConfigProcessor(config.NodeGroupAutoscalingOptions{MaxNodeProvisionTime: 15 * time.Minute})
+			clusterstate := NewNotifiedClusterStateRegistry(provider, fakeLogRecorder, newBackoff(), nodeGroupConfigProcessor, registry)
+
+			// ng1-2 is being deleted, so it can't fulfill the request.
+			clusterstate.RegisterScaleUp(ng1, 1, now)
+			err := clusterstate.UpdateNodes([]*apiv1.Node{ng1_1, ng1_2}, now.Add(time.Second))
+			assert.NoError(t, err)
+			assert.True(t, clusterstate.HasNodeGroupStartedScaleUp("ng1"))
+			upcoming, _ := clusterstate.GetUpcomingNodes()
+			assert.Equal(t, 1, upcoming["ng1"])
+
+			// A completed scale-up still succeeds when observed after its deadline.
+			ng1_3 := BuildTestNode("ng1-3", 1000, 1000)
+			SetNodeReadyState(ng1_3, true, now.Add(time.Minute))
+			provider.AddNode("ng1", ng1_3)
+			expired := now.Add(15*time.Minute + time.Second)
+			err = clusterstate.UpdateNodes([]*apiv1.Node{ng1_1, ng1_2, ng1_3}, expired)
+			assert.NoError(t, err)
+			assert.False(t, clusterstate.HasNodeGroupStartedScaleUp("ng1"))
+			assert.False(t, clusterstate.BackoffStatusForNodeGroup(ng1, expired).IsBackedOff)
+			upcoming, _ = clusterstate.GetUpcomingNodes()
+			assert.NotContains(t, upcoming, "ng1")
+		})
+	}
+}
