            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [
            {
              "options": {
                "4": {
                  "index": 0,
                  "text": "4 s+"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "from": 4.09,
                "result": {
                  "index": 1,
                  "text": "4 s+ (metric ceiling)"
                }
              },
              "type": "range"
            }
          ],
