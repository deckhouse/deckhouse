        },
        "enable": false,
        "expr": "max (etcd_server_leader_changes_seen_total{job=\"kube-etcd3\", node=~\"$node\"}) - max (etcd_server_leader_changes_seen_total{job=\"kube-etcd3\", node=~\"$node\"} offset $__interval) > bool 0",
        "iconColor": "red",
        "name": "Leader change",
        "titleFormat": "etcd leader change"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "$ds_prometheus"
        },
        "enable": false,
        "expr": "sum by (node) (etcd_disk_backend_defrag_duration_seconds_count{job=\"kube-etcd3\", node=~\"$node\"}) - sum by (node) (etcd_disk_backend_defrag_duration_seconds_count{job=\"kube-etcd3\", node=~\"$node\"} offset $__interval) > bool 0",
        "iconColor": "orange",
        "name": "Defrag",
        "tagKeys": "node",
        "textFormat": "{{node}}",
        "titleFormat": "etcd defrag"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "$ds_prometheus"
        },
        "enable": false,
        "expr": "sum by (node) ({__name__=~\"etcd_network_snapshot_send_(success|failures)\", job=\"kube-etcd3\", node=~\"$node\"}) - sum by (node) ({__name__=~\"etcd_network_snapshot_send_(success|failures)\", job=\"kube-etcd3\", node=~\"$node\"} offset $__interval) > bool 0",
        "iconColor": "blue",
        "name": "Snapshot",
        "tagKeys": "node",
        "textFormat": "{{node}}",
        "titleFormat": "raft snapshot sent"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "$ds_prometheus"
        },
        "enable": false,
        "expr": "max by (node) (process_start_time_seconds{job=\"kube-etcd3\", node=~\"$node\"}) != bool max by (node) (process_start_time_seconds{job=\"kube-etcd3\", node=~\"$node\"} offset $__interval)",
        "iconColor": "purple",
        "name": "Restart",
        "tagKeys": "node",
        "textFormat": "{{node}}",
        "titleFormat": "etcd restart"
