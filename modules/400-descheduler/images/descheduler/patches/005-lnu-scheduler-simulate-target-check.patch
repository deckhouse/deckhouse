+// TestLowNodeUtilizationSimulateTargetCheck runs the plugin on n1 (8 of 10
+// pods, overutilized) and n2, n3 (underutilized). Without the check the
+// plugin evicts exactly one pod from n1.
+func TestLowNodeUtilizationSimulateTargetCheck(t *testing.T) {
+	tests := []struct {
+		name             string
+		disabled         bool
+		reply            func(n int, req simulateRequest, w http.ResponseWriter)
+		timeout          time.Duration
+		expectedEvicted  uint
+		expectedRequests int
+	}{
+		{
+			name:             "env unset, no simulation",
+			disabled:         true,
+			reply:            statusReply(http.StatusInternalServerError),
+			expectedEvicted:  1,
+			expectedRequests: 0,
+		},
+		{
+			name:             "target underutilized, eviction allowed",
+			reply:            bestNodesReply("n2"),
+			expectedEvicted:  1,
+			expectedRequests: 1,
+		},
+		{
+			name:             "all best nodes underutilized, eviction allowed",
+			reply:            bestNodesReply("n2", "n3"),
+			expectedEvicted:  1,
+			expectedRequests: 1,
+		},
+		{
+			name:             "one best node not underutilized, every candidate denied up to the limit",
+			reply:            bestNodesReply("n2", "n4"),
+			expectedEvicted:  0,
+			expectedRequests: maxSimulationsPerSourceNode,
+		},
+		{
+			name:             "no best nodes, skipped",
+			reply:            bestNodesReply(),
+			expectedEvicted:  0,
+			expectedRequests: maxSimulationsPerSourceNode,
+		},
+		{
+			name: "first candidate denied, next one allowed",
+			reply: func(n int, req simulateRequest, w http.ResponseWriter) {
+				if n == 1 {
+					bestNodesReply("n4")(n, req, w)
+					return
+				}
+				bestNodesReply("n3")(n, req, w)
+			},
+			expectedEvicted:  1,
+			expectedRequests: 2,
+		},
+		{
+			name:             "server error, fail closed",
+			reply:            statusReply(http.StatusInternalServerError),
+			expectedEvicted:  0,
+			expectedRequests: maxSimulationsPerSourceNode,
+		},
+		{
+			name:             "pod not found, fail closed",
+			reply:            statusReply(http.StatusNotFound),
+			expectedEvicted:  0,
+			expectedRequests: maxSimulationsPerSourceNode,
+		},
+		{
+			name: "undecodable answer, fail closed",
+			reply: func(_ int, _ simulateRequest, w http.ResponseWriter) {
+				_, _ = w.Write([]byte("{not json"))
+			},
+			expectedEvicted:  0,
+			expectedRequests: maxSimulationsPerSourceNode,
+		},
+		{
+			name: "busy once, retried and allowed",
+			reply: func(n int, req simulateRequest, w http.ResponseWriter) {
+				if n == 1 {
+					statusReply(http.StatusTooManyRequests)(n, req, w)
+					return
+				}
+				bestNodesReply("n2")(n, req, w)
+			},
+			expectedEvicted:  1,
+			expectedRequests: 2,
+		},
+		{
+			name:             "busy twice, skipped; one retry per candidate",
+			reply:            statusReply(http.StatusTooManyRequests),
+			expectedEvicted:  0,
+			expectedRequests: 2 * maxSimulationsPerSourceNode,
+		},
+		{
+			name: "endpoint hangs, one timeout per cycle",
+			reply: func(n int, req simulateRequest, w http.ResponseWriter) {
+				time.Sleep(300 * time.Millisecond)
+				bestNodesReply("n2")(n, req, w)
+			},
+			timeout:          50 * time.Millisecond,
+			expectedEvicted:  0,
+			expectedRequests: 1,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			server := &fakeSimulateServer{reply: tc.reply}
+			ts := httptest.NewServer(server)
+			defer ts.Close()
+			if tc.timeout > 0 {
+				previous := simulateRequestTimeout
+				simulateRequestTimeout = tc.timeout
+				defer func() { simulateRequestTimeout = previous }()
+			}
+			if tc.disabled {
+				setupSimulateEnv(t, "")
+			} else {
+				setupSimulateEnv(t, ts.URL)
+			}
+
+			nodes := []*v1.Node{
+				test.BuildTestNode("n1", 2000, 3000, 10, nil),
+				test.BuildTestNode("n2", 1000, 3000, 10, nil),
+				test.BuildTestNode("n3", 1000, 3000, 10, nil),
+			}
+			var objs []runtime.Object
+			for _, node := range nodes {
+				objs = append(objs, node)
+			}
+			pods := map[string]*v1.Pod{}
+			for i := 1; i <= 8; i++ {
+				pod := test.BuildTestPod(fmt.Sprintf("pod_%d_n1", i), 200, 0, "n1", test.SetRSOwnerRef)
+				pods[pod.Name] = pod
+				objs = append(objs, pod)
+			}
+			objs = append(objs, test.BuildTestPod("pod_9_n2", 200, 0, "n2", test.SetRSOwnerRef))
+
+			fakeClient := fake.NewSimpleClientset(objs...)
+			var evicted []string
+			fakeClient.Fake.AddReactor("create", "pods", func(action core.Action) (bool, runtime.Object, error) {
+				if eviction, ok := action.(core.CreateAction).GetObject().(*policy.Eviction); ok {
+					evicted = append(evicted, eviction.Name)
+				}
+				return true, nil, nil
+			})
+
+			handle, podEvictor, err := frameworktesting.InitFrameworkHandle(ctx, fakeClient, nil, defaultevictor.DefaultEvictorArgs{NodeFit: true}, nil)
+			if err != nil {
+				t.Fatalf("Unable to initialize a framework handle: %v", err)
+			}
+			plugin, err := NewLowNodeUtilization(ctx, &LowNodeUtilizationArgs{
+				Thresholds:       api.ResourceThresholds{v1.ResourcePods: 20},
+				TargetThresholds: api.ResourceThresholds{v1.ResourcePods: 70},
+			}, handle)
+			if err != nil {
+				t.Fatalf("Unable to initialize the plugin: %v", err)
+			}
+			plugin.(frameworktypes.BalancePlugin).Balance(ctx, nodes)
+
+			if got := podEvictor.TotalEvicted(); got != tc.expectedEvicted {
+				t.Errorf("Expected %v evictions, got %v (%v)", tc.expectedEvicted, got, evicted)
+			}
+			if got := server.count(); got != tc.expectedRequests {
+				t.Errorf("Expected %v simulate requests, got %v", tc.expectedRequests, got)
+			}
+
+			for i, req := range server.requests {
+				if server.tokens[i] != "Bearer "+simulateTestToken {
+					t.Errorf("request %d: unexpected Authorization header %q", i, server.tokens[i])
+				}
+				pod := pods[req.Name]
+				if pod == nil || req.Namespace != pod.Namespace {
+					t.Fatalf("request %d: unexpected pod %s/%s", i, req.Namespace, req.Name)
+				}
+				if !slices.Equal(req.ExcludeNodes, []string{"n1"}) {
+					t.Errorf("request %d: excludeNodes = %v, want [n1]", i, req.ExcludeNodes)
+				}
+				want := []simulatePodRef{{Namespace: pod.Namespace, Name: pod.Name, UID: string(pod.UID)}}
+				if !slices.Equal(req.RemovePods, want) {
+					t.Errorf("request %d: removePods = %v, want %v", i, req.RemovePods, want)
+				}
+			}
+			// the denied first candidate must not be the evicted one.
+			if tc.name == "first candidate denied, next one allowed" && len(evicted) == 1 && evicted[0] == server.requests[0].Name {
+				t.Errorf("denied pod %q was evicted", evicted[0])
+			}
+		})
+	}
+}
