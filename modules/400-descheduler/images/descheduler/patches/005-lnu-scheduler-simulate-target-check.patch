+// newResultsTestCheck serves bestNodes by pod name prefix: allowed* -> [n2],
+// denied* -> [n4], empty* -> [], hang* sleeps past the timeout, anything
+// else 503. n2 and n3 are the destinations.
+func newResultsTestCheck(t *testing.T) (*fakeSimulateServer, func(profile string) *simulateTargetCheck) {
+	t.Helper()
+	server := &fakeSimulateServer{reply: func(n int, req simulateRequest, w http.ResponseWriter) {
+		switch {
+		case strings.HasPrefix(req.Name, "allowed"):
+			bestNodesReply("n2")(n, req, w)
+		case strings.HasPrefix(req.Name, "denied"):
+			bestNodesReply("n4")(n, req, w)
+		case strings.HasPrefix(req.Name, "empty"):
+			bestNodesReply()(n, req, w)
+		case strings.HasPrefix(req.Name, "hang"):
+			time.Sleep(200 * time.Millisecond)
+			bestNodesReply("n2")(n, req, w)
+		default:
+			statusReply(http.StatusServiceUnavailable)(n, req, w)
+		}
+	}}
+	ts := httptest.NewServer(server)
+	t.Cleanup(ts.Close)
+	setupSimulateEnv(t, ts.URL)
+	destinations := []NodeInfo{
+		{NodeUsage: NodeUsage{node: test.BuildTestNode("n2", 1000, 3000, 10, nil)}},
+		{NodeUsage: NodeUsage{node: test.BuildTestNode("n3", 1000, 3000, 10, nil)}},
+	}
+	return server, func(profile string) *simulateTargetCheck {
+		client, err := newSimulateClientFromEnv()
+		if err != nil || client == nil {
+			t.Fatalf("newSimulateClientFromEnv() = %v, %v", client, err)
+		}
+		return newSimulateTargetCheck(client, profile, destinations)
+	}
+}
