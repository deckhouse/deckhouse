+func TestNewSimulateClientFromEnv(t *testing.T) {
+	ts := httptest.NewTLSServer(&fakeSimulateServer{reply: bestNodesReply("n2")})
+	defer ts.Close()
+	pod := test.BuildTestPod("p", 100, 0, "n1", nil)
+
+	setupSimulateEnv(t, "")
+	if client, err := newSimulateClientFromEnv(); client != nil || err != nil {
+		t.Fatalf("unset env: got %v, %v, want nil, nil", client, err)
+	}
+
+	for _, bad := range []string{"control-plane-proxy:8080/scheduler/simulate", "ftp://host/x", "https://"} {
+		setupSimulateEnv(t, bad)
+		if _, err := newSimulateClientFromEnv(); err == nil {
+			t.Errorf("URL %q: expected an error", bad)
+		}
+	}
+
+	// the self-signed test certificate fails verification by default.
+	setupSimulateEnv(t, ts.URL)
+	client, err := newSimulateClientFromEnv()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := client.bestNodes(context.Background(), pod, "n1"); err == nil {
+		t.Error("expected a TLS verification error without the insecure env")
+	}
+
+	t.Setenv(SchedulerSimulateInsecureSkipVerifyEnv, "true")
+	client, err = newSimulateClientFromEnv()
+	if err != nil {
+		t.Fatal(err)
+	}
+	nodes, _, err := client.bestNodes(context.Background(), pod, "n1")
+	if err != nil || !slices.Equal(nodes, []string{"n2"}) {
+		t.Errorf("insecure env: got %v, %v, want [n2]", nodes, err)
+	}
+
+	simulateTokenFile = filepath.Join(t.TempDir(), "missing")
+	if _, err := newSimulateClientFromEnv(); err == nil {
+		t.Error("expected an error for a missing token file")
+	}
+}
