+const simulateTestToken = "simulate-test-token"
+
+// fakeSimulateServer answers with the reply function and records requests.
+type fakeSimulateServer struct {
+	mu       sync.Mutex
+	requests []simulateRequest
+	tokens   []string
+	reply    func(n int, req simulateRequest, w http.ResponseWriter)
+}
+
+func (f *fakeSimulateServer) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	var req simulateRequest
+	_ = json.NewDecoder(r.Body).Decode(&req)
+	f.mu.Lock()
+	f.requests = append(f.requests, req)
+	f.tokens = append(f.tokens, r.Header.Get("Authorization"))
+	n := len(f.requests)
+	f.mu.Unlock()
+	f.reply(n, req, w)
+}
+
+func (f *fakeSimulateServer) count() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return len(f.requests)
+}
