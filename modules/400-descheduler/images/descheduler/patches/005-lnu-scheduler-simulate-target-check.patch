+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package nodeutilization
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/sets"
+	"k8s.io/client-go/transport"
+	"k8s.io/klog/v2"
+
+	"sigs.k8s.io/descheduler/metrics"
+	frameworktypes "sigs.k8s.io/descheduler/pkg/framework/types"
+)
+
+const (
+	// SchedulerSimulateURLEnv is the full URL of the kube-scheduler simulate
+	// endpoint. When it is set, LowNodeUtilization evicts a pod only if the
+	// scheduler would place it on an underutilized node. Unset keeps the
+	// upstream behaviour.
+	SchedulerSimulateURLEnv = "DESCHEDULER_SCHEDULER_SIMULATE_URL"
+	// SchedulerSimulateInsecureSkipVerifyEnv turns off the TLS verification of
+	// the simulate endpoint when set to a true value, for an in-cluster proxy
+	// with a self-signed serving certificate.
+	SchedulerSimulateInsecureSkipVerifyEnv = "DESCHEDULER_SCHEDULER_SIMULATE_INSECURE_SKIP_VERIFY"
+
+	// maxSimulationsPerSourceNode bounds the simulations of one source node in
+	// one cycle that do not allow an eviction. kube-scheduler pauses real
+	// scheduling while a simulation runs, so a node whose candidates keep
+	// failing the check must not hold the scheduler for long; it is left for
+	// the next cycle. Allowed simulations do not count: each one leads to an
+	// eviction the strategy wants, bounded by its own logic and evictionLimits.
+	maxSimulationsPerSourceNode = 5
+	// maxSimulationsPerCycle bounds all simulations of one profile in one
+	// cycle. Every simulation pauses real scheduling and profiles run one
+	// after another, so the per-node bound alone grows with the number of
+	// overutilized nodes. After the cap the rest of the cycle evicts nothing.
+	maxSimulationsPerCycle = 100
+	// simulateUnreachableBackoff is how long every profile skips the check
+	// after a request got no HTTP answer. It covers the rest of the cycle
+	// (profiles run one after another within seconds) and is shorter than
+	// any descheduling interval Deckhouse sets, so the next cycle tries again.
+	simulateUnreachableBackoff = time.Minute
+	// maxSimulateRetryWait caps the wait after a 429 before the single retry.
+	maxSimulateRetryWait = time.Second
+	// maxSimulateResponseBytes bounds the response body; it lists every node.
+	maxSimulateResponseBytes = 16 << 20
+
+	simulateResultAllowed                = "allowed"
+	simulateResultTargetNotUnderutilized = "target_not_underutilized"
+	simulateResultNoTarget               = "no_target"
+	simulateResultError                  = "error"
+	simulateResultLimitReached           = "limit_reached"
+	simulateResultSkippedSameOwner       = "skipped_same_owner"
+	simulateResultSkippedUnreachable     = "skipped_unreachable"
+)
+
+var (
+	// simulateTokenFile is the ServiceAccount token sent as the bearer token.
+	// A variable so tests can point it to a temporary file.
+	simulateTokenFile = "/var/run/secrets/kubernetes.io/serviceaccount/token"
+	// simulateRequestTimeout is the per-request timeout. It is well below the
+	// 30 seconds the endpoint itself allows, so a slow scheduler delays a
+	// cycle by seconds, not minutes. A variable for tests.
+	simulateRequestTimeout = 5 * time.Second
+)
+
+type simulatePodRef struct {
+	Namespace string `json:"namespace"`
+	Name      string `json:"name"`
+	UID       string `json:"uid,omitempty"`
+}
+
+type simulateRequest struct {
+	Namespace    string           `json:"namespace"`
+	Name         string           `json:"name"`
+	ExcludeNodes []string         `json:"excludeNodes"`
+	RemovePods   []simulatePodRef `json:"removePods"`
+}
+
+type simulateResponse struct {
+	Leader    bool     `json:"leader"`
+	BestNodes []string `json:"bestNodes"`
+}
+
+// simulateBusyError is a 429: another simulation runs on that replica.
+type simulateBusyError struct {
+	retryAfter time.Duration
+}
+
+func (e *simulateBusyError) Error() string {
+	return fmt.Sprintf("scheduler simulate endpoint is busy, retry after %v", e.retryAfter)
+}
+
+// simulateUnreachableError is a request that got no HTTP answer: a network
+// error or the request timeout.
+type simulateUnreachableError struct {
+	err error
+}
+
+func (e *simulateUnreachableError) Error() string {
+	return fmt.Sprintf("scheduler simulate endpoint is unreachable: %v", e.err)
+}
+
+func (e *simulateUnreachableError) Unwrap() error { return e.err }
+
+type simulateClient struct {
+	url        string
+	httpClient *http.Client
+
+	mu               sync.Mutex
+	unreachableUntil time.Time
+}
+
+func (c *simulateClient) markUnreachable() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.unreachableUntil = time.Now().Add(simulateUnreachableBackoff)
+}
+
+func (c *simulateClient) isUnreachable() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return time.Now().Before(c.unreachableUntil)
+}
+
+// sharedSimulateClient is the one client of the process: every
+// LowNodeUtilization profile shares its transport, token source and
+// unreachable state. It is keyed by its configuration so tests with another
+// env get their own client.
+var sharedSimulateClient struct {
+	sync.Mutex
+	key    string
+	client *simulateClient
+}
+
+// newSimulateClientFromEnv returns nil when SchedulerSimulateURLEnv is unset,
+// otherwise the shared client for the current configuration.
+func newSimulateClientFromEnv() (*simulateClient, error) {
+	rawURL := os.Getenv(SchedulerSimulateURLEnv)
+	if rawURL == "" {
+		return nil, nil
+	}
+	key := rawURL + "\x00" + os.Getenv(SchedulerSimulateInsecureSkipVerifyEnv) + "\x00" + simulateTokenFile
+	sharedSimulateClient.Lock()
+	defer sharedSimulateClient.Unlock()
+	if sharedSimulateClient.client != nil && sharedSimulateClient.key == key {
+		return sharedSimulateClient.client, nil
+	}
+	client, err := buildSimulateClient(rawURL)
+	if err != nil {
+		return nil, err
+	}
+	sharedSimulateClient.key, sharedSimulateClient.client = key, client
+	return client, nil
+}
+
+func buildSimulateClient(rawURL string) (*simulateClient, error) {
+	u, err := url.Parse(rawURL)
+	if err != nil || (u.Scheme != "https" && u.Scheme != "http") || u.Host == "" {
+		return nil, fmt.Errorf("%s must be an absolute http(s) URL, got %q", SchedulerSimulateURLEnv, rawURL)
+	}
+	insecure, _ := strconv.ParseBool(os.Getenv(SchedulerSimulateInsecureSkipVerifyEnv))
+
+	base := http.DefaultTransport.(*http.Transport).Clone()
+	base.TLSClientConfig = &tls.Config{InsecureSkipVerify: insecure} //nolint:gosec // opt-in, see SchedulerSimulateInsecureSkipVerifyEnv
+	// the token file is re-read every minute, as client-go does for the
+	// in-cluster config, so a rotated projected token is picked up.
+	rt, err := transport.NewBearerAuthWithRefreshRoundTripper("", simulateTokenFile, base)
+	if err != nil {
+		return nil, fmt.Errorf("unable to read the ServiceAccount token for the scheduler simulate endpoint: %v", err)
+	}
+	return &simulateClient{url: rawURL, httpClient: &http.Client{Transport: rt}}, nil
+}
+
+// bestNodes asks kube-scheduler where the pod would go if it were evicted
+// from sourceNode now. On a 429 it waits once, at most maxSimulateRetryWait,
+// and retries once.
+func (c *simulateClient) bestNodes(ctx context.Context, pod *v1.Pod, sourceNode string) ([]string, bool, error) {
+	body, err := json.Marshal(simulateRequest{
+		Namespace:    pod.Namespace,
+		Name:         pod.Name,
+		ExcludeNodes: []string{sourceNode},
+		RemovePods:   []simulatePodRef{{Namespace: pod.Namespace, Name: pod.Name, UID: string(pod.UID)}},
+	})
+	if err != nil {
+		return nil, false, err
+	}
+
+	resp, err := c.post(ctx, body)
+	var busy *simulateBusyError
+	if errors.As(err, &busy) {
+		timer := time.NewTimer(min(busy.retryAfter, maxSimulateRetryWait))
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return nil, false, ctx.Err()
+		case <-timer.C:
+		}
+		resp, err = c.post(ctx, body)
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	return resp.BestNodes, resp.Leader, nil
+}
+
+func (c *simulateClient) post(ctx context.Context, body []byte) (*simulateResponse, error) {
+	ctx, cancel := context.WithTimeout(ctx, simulateRequestTimeout)
+	defer cancel()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.url, bytes.NewReader(body))
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, &simulateUnreachableError{err: err}
+	}
+	defer func() {
+		// drain the rest so the connection can be reused.
+		_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, maxSimulateResponseBytes))
+		resp.Body.Close()
+	}()
+
+	switch resp.StatusCode {
+	case http.StatusOK:
+		var out simulateResponse
+		if err := json.NewDecoder(io.LimitReader(resp.Body, maxSimulateResponseBytes)).Decode(&out); err != nil {
+			return nil, fmt.Errorf("unable to decode the scheduler simulate response: %v", err)
+		}
+		return &out, nil
+	case http.StatusTooManyRequests:
+		// Retry-After is an integer number of seconds; without it the
+		// capped wait is used.
+		retryAfter := maxSimulateRetryWait
+		if s, err := strconv.Atoi(resp.Header.Get("Retry-After")); err == nil && s >= 0 {
+			retryAfter = time.Duration(s) * time.Second
+		}
+		return nil, &simulateBusyError{retryAfter: retryAfter}
+	default:
+		msg, _ := io.ReadAll(io.LimitReader(resp.Body, 512))
+		return nil, fmt.Errorf("scheduler simulate endpoint answered %d: %s", resp.StatusCode, bytes.TrimSpace(msg))
+	}
+}
+
+// simulateTargetCheck lives for one LowNodeUtilization cycle of one profile.
+// It allows an eviction only if every best node of the simulation is in the
+// destination set: the nodes the strategy itself classified as
+// underutilized in this cycle. There is no threshold of its own, so with
+// deviation thresholds the target must be at or below the average minus the
+// lower deviation.
+type simulateTargetCheck struct {
+	client       *simulateClient
+	profile      string
+	destinations sets.Set[string]
+	// simulations counts all requests of the cycle (maxSimulationsPerCycle).
+	simulations int
+	// refused counts per source node the requests that did not allow an
+	// eviction (maxSimulationsPerSourceNode).
+	refused map[string]int
+	// deniedOwners remembers "<source node>/<controller UID>" of denied pods:
+	// their siblings on the same node get the same answer and are skipped.
+	deniedOwners sets.Set[string]
+	errorLogged  bool
+}
+
+func newSimulateTargetCheck(client *simulateClient, profile string, destinationNodes []NodeInfo) *simulateTargetCheck {
+	destinations := sets.New[string]()
+	for _, node := range destinationNodes {
+		destinations.Insert(node.node.Name)
+	}
+	return &simulateTargetCheck{
+		client:       client,
+		profile:      profile,
+		destinations: destinations,
+		refused:      map[string]int{},
+		deniedOwners: sets.New[string](),
+	}
+}
+
+// check returns one of the simulateResult* values. Only "allowed" lets the
+// caller evict the pod; "limit_reached" means the caller should stop with
+// this source node. Errors fail closed: the pod is skipped.
+func (t *simulateTargetCheck) check(ctx context.Context, pod *v1.Pod, sourceNode string) string {
+	logger := klog.FromContext(ctx)
+	result, bestNodes, leader := t.decide(ctx, pod, sourceNode)
+	metrics.SimulateTargetCheckTotal.With(map[string]string{"profile": t.profile, "result": result}).Inc()
+	logger.V(3).Info("Scheduler simulation target check",
+		"pod", klog.KObj(pod), "sourceNode", sourceNode, "bestNodes", bestNodes, "leader", leader, "result", result)
+	return result
+}
+
+// ownerKey is empty for a pod without a controller: such pods are never
+// deduplicated.
+func ownerKey(pod *v1.Pod, sourceNode string) string {
+	if ref := metav1.GetControllerOf(pod); ref != nil && ref.UID != "" {
+		return sourceNode + "/" + string(ref.UID)
+	}
+	return ""
+}
+
+func (t *simulateTargetCheck) decide(ctx context.Context, pod *v1.Pod, sourceNode string) (string, []string, bool) {
+	if t.simulations >= maxSimulationsPerCycle || t.refused[sourceNode] >= maxSimulationsPerSourceNode {
+		return simulateResultLimitReached, nil, false
+	}
+	owner := ownerKey(pod, sourceNode)
+	if owner != "" && t.deniedOwners.Has(owner) {
+		return simulateResultSkippedSameOwner, nil, false
+	}
+	if t.client.isUnreachable() {
+		return simulateResultSkippedUnreachable, nil, false
+	}
+
+	t.simulations++
+	bestNodes, leader, err := t.client.bestNodes(ctx, pod, sourceNode)
+	result := simulateResultAllowed
+	switch {
+	case err != nil:
+		var unreachable *simulateUnreachableError
+		if errors.As(err, &unreachable) {
+			t.client.markUnreachable()
+		}
+		if !t.errorLogged {
+			t.errorLogged = true
+			klog.FromContext(ctx).Error(err, "Scheduler simulation failed, the pod is not evicted; further failures in this cycle are logged at level 3 only",
+				"pod", klog.KObj(pod), "sourceNode", sourceNode)
+		} else {
+			klog.FromContext(ctx).V(3).Info("Scheduler simulation failed", "pod", klog.KObj(pod), "err", err)
+		}
+		result = simulateResultError
+	case len(bestNodes) == 0:
+		result = simulateResultNoTarget
+	case !t.destinations.HasAll(bestNodes...):
+		result = simulateResultTargetNotUnderutilized
+	}
+	if result != simulateResultAllowed {
+		t.refused[sourceNode]++
+	}
+	if (result == simulateResultNoTarget || result == simulateResultTargetNotUnderutilized) && owner != "" {
+		t.deniedOwners.Insert(owner)
+	}
+	return result, bestNodes, leader
+}
+
+// evictorProfileName returns the profile name of the evictor handle, or ""
+// for an evictor that does not expose it (test fakes).
+func evictorProfileName(evictor frameworktypes.Evictor) string {
+	if p, ok := evictor.(interface{ ProfileName() string }); ok {
+		return p.ProfileName()
+	}
+	return ""
+}
