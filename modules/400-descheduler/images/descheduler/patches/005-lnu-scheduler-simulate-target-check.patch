+type checkStep struct {
+	pod, source string
+	apply       func(*v1.Pod)
+	want        string
+}
+
+func runCheckSteps(t *testing.T, check *simulateTargetCheck, steps []checkStep) {
+	t.Helper()
+	for i, step := range steps {
+		pod := test.BuildTestPod(step.pod, 100, 0, step.source, step.apply)
+		if got := check.check(context.Background(), pod, step.source); got != step.want {
+			t.Errorf("step %d (%s on %s): got %q, want %q", i, step.pod, step.source, got, step.want)
+		}
+	}
+}
