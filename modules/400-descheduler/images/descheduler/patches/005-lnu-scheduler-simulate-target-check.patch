+func TestSimulateTargetCheckResults(t *testing.T) {
+	server, newCheck := newResultsTestCheck(t)
+	runCheckSteps(t, newCheck("p"), []checkStep{
+		{"allowed-1", "n1", nil, simulateResultAllowed},
+		{"denied-1", "n1", nil, simulateResultTargetNotUnderutilized},
+		{"empty-1", "n1", nil, simulateResultNoTarget},
+		{"unavailable-1", "n1", nil, simulateResultError},
+		// allowed simulations do not count toward the per-node limit.
+		{"allowed-2", "n1", nil, simulateResultAllowed},
+		{"allowed-3", "n1", nil, simulateResultAllowed},
+		{"allowed-4", "n1", nil, simulateResultAllowed},
+		{"denied-2", "n1", nil, simulateResultTargetNotUnderutilized},
+		{"denied-3", "n1", nil, simulateResultTargetNotUnderutilized},
+		// 5 refused simulations on n1: the node is done for this cycle.
+		{"allowed-5", "n1", nil, simulateResultLimitReached},
+		// the limit is per source node.
+		{"allowed-6", "n5", nil, simulateResultAllowed},
+	})
+	if got, want := server.count(), 10; got != want {
+		t.Errorf("Expected %d requests, got %d", want, got)
+	}
+}
+
+func TestSimulateTargetCheckSkipsSiblingsOfDeniedOwner(t *testing.T) {
+	server, newCheck := newResultsTestCheck(t)
+	runCheckSteps(t, newCheck("p"), []checkStep{
+		{"denied-a1", "n1", ownedBy("a"), simulateResultTargetNotUnderutilized},
+		// a sibling gets no request, whatever it would have answered.
+		{"allowed-a2", "n1", ownedBy("a"), simulateResultSkippedSameOwner},
+		{"empty-b1", "n1", ownedBy("b"), simulateResultNoTarget},
+		{"allowed-b2", "n1", ownedBy("b"), simulateResultSkippedSameOwner},
+		// the same owner on another source node is simulated.
+		{"allowed-a3", "n6", ownedBy("a"), simulateResultAllowed},
+		// an allowed or failed result is not remembered.
+		{"allowed-c1", "n1", ownedBy("c"), simulateResultAllowed},
+		{"allowed-c2", "n1", ownedBy("c"), simulateResultAllowed},
+		{"unavailable-d1", "n1", ownedBy("d"), simulateResultError},
+		{"allowed-d2", "n1", ownedBy("d"), simulateResultAllowed},
+		// pods without a controller are never deduplicated.
+		{"denied-x", "n7", nil, simulateResultTargetNotUnderutilized},
+		{"allowed-x", "n7", nil, simulateResultAllowed},
+	})
+	if got, want := server.count(), 9; got != want {
+		t.Errorf("Expected %d requests, got %d", want, got)
+	}
+	// a new cycle forgets the denied owners.
+	runCheckSteps(t, newCheck("p"), []checkStep{{"allowed-a4", "n1", ownedBy("a"), simulateResultAllowed}})
+}
+
+func TestSimulateTargetCheckCycleLimit(t *testing.T) {
+	server, newCheck := newResultsTestCheck(t)
+	check := newCheck("p")
+	var steps []checkStep
+	for i := 0; i < maxSimulationsPerCycle; i++ {
+		steps = append(steps, checkStep{fmt.Sprintf("allowed-%d", i), fmt.Sprintf("src-%d", i%7), nil, simulateResultAllowed})
+	}
+	steps = append(steps,
+		checkStep{"allowed-x", "src-0", nil, simulateResultLimitReached},
+		checkStep{"allowed-y", "fresh", nil, simulateResultLimitReached},
+	)
+	runCheckSteps(t, check, steps)
+	if got := server.count(); got != maxSimulationsPerCycle {
+		t.Errorf("Expected %d requests, got %d", maxSimulationsPerCycle, got)
+	}
+	// the next cycle starts over.
+	runCheckSteps(t, newCheck("p"), []checkStep{{"allowed-z", "src-0", nil, simulateResultAllowed}})
+}
+
+func TestSimulateClientSharedUnreachable(t *testing.T) {
+	previous := simulateRequestTimeout
+	simulateRequestTimeout = 20 * time.Millisecond
+	defer func() { simulateRequestTimeout = previous }()
+
+	server, newCheck := newResultsTestCheck(t)
+	first, second := newCheck("first"), newCheck("second")
+	if first.client != second.client {
+		t.Fatal("profiles must share one simulate client")
+	}
+	runCheckSteps(t, first, []checkStep{
+		{"hang-1", "n1", nil, simulateResultError},
+		{"allowed-1", "n1", nil, simulateResultSkippedUnreachable},
+	})
+	// a later profile of the same cycle skips too, without a request.
+	runCheckSteps(t, second, []checkStep{{"allowed-2", "n8", nil, simulateResultSkippedUnreachable}})
+	if got := server.count(); got != 1 {
+		t.Errorf("Expected 1 request, got %d", got)
+	}
+	// after the backoff the endpoint is tried again.
+	first.client.mu.Lock()
+	first.client.unreachableUntil = time.Time{}
+	first.client.mu.Unlock()
+	runCheckSteps(t, newCheck("third"), []checkStep{{"allowed-3", "n1", nil, simulateResultAllowed}})
+}
