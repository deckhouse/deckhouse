+// setupSimulateEnv points the plugin to the server and the token file to a
+// temporary file. An empty serverURL leaves the check disabled.
+func setupSimulateEnv(t *testing.T, serverURL string) {
+	t.Helper()
+	tokenFile := filepath.Join(t.TempDir(), "token")
+	if err := os.WriteFile(tokenFile, []byte(simulateTestToken), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	previous := simulateTokenFile
+	simulateTokenFile = tokenFile
+	t.Cleanup(func() { simulateTokenFile = previous })
+	t.Setenv(SchedulerSimulateURLEnv, serverURL)
+	t.Setenv(SchedulerSimulateInsecureSkipVerifyEnv, "")
