+func bestNodesReply(nodes ...string) func(int, simulateRequest, http.ResponseWriter) {
+	return func(_ int, _ simulateRequest, w http.ResponseWriter) {
+		_ = json.NewEncoder(w).Encode(map[string]any{"leader": true, "bestNodes": nodes})
+	}
+}
+
+func statusReply(code int) func(int, simulateRequest, http.ResponseWriter) {
+	return func(_ int, _ simulateRequest, w http.ResponseWriter) {
+		if code == http.StatusTooManyRequests {
+			w.Header().Set("Retry-After", "0")
+		}
+		http.Error(w, http.StatusText(code), code)
+	}
+}
