+func TestGetUpdateMode(t *testing.T) {
+	testCases := []struct {
+		name              string
+		defaultUpdateMode string
+		updatePolicy      *vpa_types.PodUpdatePolicy
+		expected          vpa_types.UpdateMode
+	}{
+		{
+			name:         "no update policy without the env var",
+			updatePolicy: nil,
+			expected:     vpa_types.UpdateModeRecreate,
+		},
+		{
+			name:              "no update policy with InPlaceOrRecreate default",
+			defaultUpdateMode: "InPlaceOrRecreate",
+			updatePolicy:      nil,
+			expected:          vpa_types.UpdateModeInPlaceOrRecreate,
+		},
+		{
+			name:              "update policy without update mode with InPlaceOrRecreate default",
+			defaultUpdateMode: "InPlaceOrRecreate",
+			updatePolicy:      &vpa_types.PodUpdatePolicy{MinReplicas: ptr.To(int32(2))},
+			expected:          vpa_types.UpdateModeInPlaceOrRecreate,
+		},
+		{
+			name:              "empty update mode with InPlaceOrRecreate default",
+			defaultUpdateMode: "InPlaceOrRecreate",
+			updatePolicy:      &vpa_types.PodUpdatePolicy{UpdateMode: ptr.To(vpa_types.UpdateMode(""))},
+			expected:          vpa_types.UpdateModeInPlaceOrRecreate,
+		},
+		{
+			name:              "unknown env var value",
+			defaultUpdateMode: "Unknown",
+			updatePolicy:      nil,
+			expected:          vpa_types.UpdateModeRecreate,
+		},
+		{
+			name:              "explicit Recreate with InPlaceOrRecreate default",
+			defaultUpdateMode: "InPlaceOrRecreate",
+			updatePolicy:      &vpa_types.PodUpdatePolicy{UpdateMode: ptr.To(vpa_types.UpdateModeRecreate)},
+			expected:          vpa_types.UpdateModeRecreate,
+		},
+		{
+			name:              "explicit Off with InPlaceOrRecreate default",
+			defaultUpdateMode: "InPlaceOrRecreate",
+			updatePolicy:      &vpa_types.PodUpdatePolicy{UpdateMode: ptr.To(vpa_types.UpdateModeOff)},
+			expected:          vpa_types.UpdateModeOff,
+		},
+	}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("VPA_DEFAULT_UPDATE_MODE", tc.defaultUpdateMode)
+			vpa := &vpa_types.VerticalPodAutoscaler{
+				Spec: vpa_types.VerticalPodAutoscalerSpec{UpdatePolicy: tc.updatePolicy},
+			}
+			assert.Equal(t, tc.expected, GetUpdateMode(vpa))
+		})
+	}
