+// defaultUpdateModeEnv names the environment variable read by DefaultUpdateMode.
+const defaultUpdateModeEnv = "VPA_DEFAULT_UPDATE_MODE"
+
+// DefaultUpdateMode returns the update mode for VPAs that do not set one:
+// UpdateModeInPlaceOrRecreate if the VPA_DEFAULT_UPDATE_MODE environment variable
+// is set to it, and UpdateModeRecreate otherwise.
+func DefaultUpdateMode() vpa_types.UpdateMode {
+	if vpa_types.UpdateMode(os.Getenv(defaultUpdateModeEnv)) == vpa_types.UpdateModeInPlaceOrRecreate {
+		return vpa_types.UpdateModeInPlaceOrRecreate
+	}
+	return vpa_types.UpdateModeRecreate
+}
+
 // GetUpdateMode returns the updatePolicy.updateMode for a given VPA.
-// If the mode is not specified it returns the default (UpdateModeRecreate).
+// If the mode is not specified it returns DefaultUpdateMode().
 func GetUpdateMode(vpa *vpa_types.VerticalPodAutoscaler) vpa_types.UpdateMode {
 	if vpa.Spec.UpdatePolicy == nil || vpa.Spec.UpdatePolicy.UpdateMode == nil || *vpa.Spec.UpdatePolicy.UpdateMode == "" {
-		return vpa_types.UpdateModeRecreate
+		return DefaultUpdateMode()
 	}
 	return *vpa.Spec.UpdatePolicy.UpdateMode
 }
