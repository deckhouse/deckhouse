+package vpa
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	admissionv1 "k8s.io/api/admission/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+)
+
+func TestGetPatchesDefaultUpdateMode(t *testing.T) {
+	testCases := []struct {
+		name              string
+		defaultUpdateMode string
+		vpaJSON           string
+		expectedPatches   string
+	}{
+		{
+			name:            "VPA without update policy gets Recreate without the env var",
+			vpaJSON:         `{"spec":{"targetRef":{"apiVersion":"apps/v1","kind":"Deployment","name":"app"}}}`,
+			expectedPatches: `[{"op":"add","path":"/spec/updatePolicy","value":{"updateMode":"Recreate"}}]`,
+		},
+		{
+			name:              "VPA without update policy gets InPlaceOrRecreate default",
+			defaultUpdateMode: "InPlaceOrRecreate",
+			vpaJSON:           `{"spec":{"targetRef":{"apiVersion":"apps/v1","kind":"Deployment","name":"app"}}}`,
+			expectedPatches:   `[{"op":"add","path":"/spec/updatePolicy","value":{"updateMode":"InPlaceOrRecreate"}}]`,
+		},
+		{
+			name:              "VPA with explicit update mode is not patched",
+			defaultUpdateMode: "InPlaceOrRecreate",
+			vpaJSON:           `{"spec":{"targetRef":{"apiVersion":"apps/v1","kind":"Deployment","name":"app"},"updatePolicy":{"updateMode":"Recreate"}}}`,
+			expectedPatches:   `[]`,
+		},
+	}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("VPA_DEFAULT_UPDATE_MODE", tc.defaultUpdateMode)
+			handler := NewResourceHandler(NewDefaultPreProcessor())
+			patches, errs := handler.GetPatches(context.Background(), &admissionv1.AdmissionRequest{
+				Operation: admissionv1.Create,
+				Object:    runtime.RawExtension{Raw: []byte(tc.vpaJSON)},
+			})
+			assert.Empty(t, errs)
+			actual, err := json.Marshal(patches)
+			assert.NoError(t, err)
+			assert.JSONEq(t, tc.expectedPatches, string(actual))
+		})
+	}
+}
