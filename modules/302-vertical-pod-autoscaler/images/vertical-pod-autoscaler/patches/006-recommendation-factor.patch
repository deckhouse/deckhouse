+func TestMapToListOfRecommendedContainerResourcesUncappedTarget(t *testing.T) {
+	// With a CPU rounding step of 10m, the target of 114m is exported as 120m and the uncapped target of 95m as 100m.
+	rec := RecommendedContainerResources{
+		Target:         model.Resources{model.ResourceCPU: model.CPUAmountFromCores(0.114), model.ResourceMemory: model.MemoryAmountFromBytes(1e6)},
+		UncappedTarget: model.Resources{model.ResourceCPU: model.CPUAmountFromCores(0.095), model.ResourceMemory: model.MemoryAmountFromBytes(5e5)},
+	}
+	cases := map[string]RecommendedPodResources{
+		"single container (fast path)": {"a": rec},
+		"two containers":               {"a": rec, "b": rec},
+	}
+	for name, resources := range cases {
+		t.Run(name, func(t *testing.T) {
+			out := MapToListOfRecommendedContainerResources(resources, RecommendationFormat{RoundCPUMillicores: 10, RoundMemoryBytes: 1})
+
+			assert.Len(t, out.ContainerRecommendations, len(resources))
+			for _, got := range out.ContainerRecommendations {
+				assert.Equal(t, int64(120), got.Target.Cpu().MilliValue(), got.ContainerName)
+				assert.Equal(t, int64(1e6), got.Target.Memory().Value(), got.ContainerName)
+				assert.Equal(t, int64(100), got.UncappedTarget.Cpu().MilliValue(), got.ContainerName)
+				assert.Equal(t, int64(5e5), got.UncappedTarget.Memory().Value(), got.ContainerName)
+			}
+		})
+	}
+}
