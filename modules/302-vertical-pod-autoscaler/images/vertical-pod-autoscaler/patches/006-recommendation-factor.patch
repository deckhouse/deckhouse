+// GetRecommendationFactor returns the recommendation factor of the resource, or 1 when none is set.
+func (a *AggregateContainerState) GetRecommendationFactor(name ResourceName) float64 {
+	if factor, found := a.RecommendationFactor[name]; found {
+		return factor
+	}
+	return 1
+}
+
+// updateRecommendationFactorFromPolicy sets the recommendation factors from the resource policy.
+// The factors are dropped first, so a factor removed from the policy stops applying. Only the
+// supported resources are read. Other keys are skipped silently, and an invalid value is logged
+// and leaves its resource without a factor; the admission controller rejects both, so they reach
+// the recommender only if it was bypassed.
+func (a *AggregateContainerState) updateRecommendationFactorFromPolicy(resourcePolicy *vpa_types.ContainerResourcePolicy) {
+	a.RecommendationFactor = nil
+	if resourcePolicy == nil || len(resourcePolicy.RecommendationFactor) == 0 {
+		return
+	}
+	for _, name := range recommendationfactor.SupportedResources {
+		q, found := resourcePolicy.RecommendationFactor[name]
+		if !found {
+			continue
+		}
+		factor, err := recommendationfactor.Parse(q)
+		if err != nil {
+			klog.InfoS("Ignoring invalid recommendationFactor", "containerName", resourcePolicy.ContainerName, "resource", name, "value", recommendationfactor.ValueOf(err), "err", err)
+			continue
+		}
+		if a.RecommendationFactor == nil {
+			a.RecommendationFactor = make(map[ResourceName]float64, len(recommendationfactor.SupportedResources))
+		}
+		a.RecommendationFactor[ResourceName(name)] = factor
+	}
+}
