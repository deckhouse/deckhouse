+// Package recommendationfactor parses the per-resource factor that scales VPA recommendations.
+package recommendationfactor
+
+import (
+	"errors"
+	"fmt"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+)
+
+// MaxFactor is the largest accepted recommendation factor.
+const MaxFactor = 10.0
+
+// SupportedResources are the resources a recommendation factor can be set for.
+var SupportedResources = []corev1.ResourceName{corev1.ResourceCPU, corev1.ResourceMemory}
+
+const centiScale = resource.Scale(-2)
+
+// plainDecimalScaleLimit is the exclusive bound on the absolute decimal scale (the number of
+// fractional digits, or the number of trailing zeros) for which a rejected quantity is rendered in
+// its exact decimal form.
+const plainDecimalScaleLimit = 100
+
+var (
+	errNotPositive = errors.New("must be greater than 0")
+	errTooLarge    = fmt.Errorf("must be less than or equal to %g", MaxFactor)
+	errTooPrecise  = errors.New("must have at most two decimal places")
+)
+
+// InvalidError is the error Parse returns for a quantity that is not a valid recommendation
+// factor. Value is a short rendering of the quantity, safe to put into messages and logs
+// whatever the quantity looks like; Reason says why the quantity was rejected.
+type InvalidError struct {
+	Value  string
+	Reason error
+}
+
+func (e *InvalidError) Error() string { return e.Reason.Error() }
+
+func (e *InvalidError) Unwrap() error { return e.Reason }
+
+// ValueOf returns the rendering of the rejected quantity carried by an error from Parse, or an
+// empty string for any other error.
+func ValueOf(err error) string {
+	var invalid *InvalidError
+	if errors.As(err, &invalid) {
+		return invalid.Value
+	}
+	return ""
+}
+
+// Parse returns the recommendation factor encoded in q. The factor must be greater than 0,
+// at most MaxFactor, and have at most two decimal places. Every error is an *InvalidError.
+func Parse(q resource.Quantity) (float64, error) {
+	if q.Sign() <= 0 {
+		return 0, newInvalidError(q, errNotPositive)
+	}
+	// Range and precision are checked on the exact quantity, because MilliValue() rounds sub-milli
+	// values up and wraps on int64 overflow. Exact comparison rescales inf.Dec values, which takes
+	// minutes for inputs such as 1e1000000000, so a cheap float64 estimate rejects extreme magnitudes
+	// first. It decides only values far from the limits: more than 5% above MaxFactor, or below
+	// 0.009 (every value in (0, 0.01) has more than two decimal places).
+	approx := q.AsApproximateFloat64()
+	if approx > MaxFactor*1.05 {
+		return 0, newInvalidError(q, errTooLarge)
+	}
+	if approx < 0.009 {
+		return 0, newInvalidError(q, errTooPrecise)
+	}
+	if q.CmpInt64(int64(MaxFactor)) > 0 {
+		return 0, newInvalidError(q, errTooLarge)
+	}
+	if _, exact := q.AsScale(centiScale); !exact {
+		return 0, newInvalidError(q, errTooPrecise)
+	}
+	return float64(q.MilliValue()) / 1000, nil
+}
+
+func newInvalidError(q resource.Quantity, reason error) error {
+	return &InvalidError{Value: displayValue(q), Reason: reason}
+}
+
+// displayValue renders q for human-readable messages. Unlike AsDec().String(), which allocates
+// gigabytes for an exponent such as 1e1000000000, it returns a short string at a cost that does not
+// grow with the exponent:
+//   - a mantissa beyond int64 prints as an approximate float formatted with %g;
+//   - otherwise, a quantity with an absolute decimal scale below plainDecimalScaleLimit prints as an
+//     exact decimal;
+//   - any other quantity prints in the canonical exponent form, for example 10e99.
+func displayValue(q resource.Quantity) string {
+	dec := q.AsDec()
+	if !dec.UnscaledBig().IsInt64() {
+		return fmt.Sprintf("%g", q.AsApproximateFloat64())
+	}
+	if scale := dec.Scale(); scale > -plainDecimalScaleLimit && scale < plainDecimalScaleLimit {
+		return dec.String()
+	}
+	// q.String() is not used here: it echoes the input string cached by ParseQuantity, which can be
+	// arbitrarily long, and for the DecimalSI format it drops an exponent that has no SI suffix.
+	return resource.NewDecimalQuantity(*dec, resource.DecimalExponent).String()
+}
