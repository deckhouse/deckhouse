+// newRecommendationFactorTestRecommender returns a recommender whose estimators are all constant
+// (cpuCores and memoryBytes), with the pod minimums set to 25m CPU and 250Mi memory.
+func newRecommendationFactorTestRecommender(cpuCores, memoryBytes float64) *podResourceRecommender {
+	constCPU := NewConstCPUEstimator(model.CPUAmountFromCores(cpuCores))
+	constMemory := NewConstMemoryEstimator(model.MemoryAmountFromBytes(memoryBytes))
+	return &podResourceRecommender{
+		targetCPU:        constCPU,
+		targetMemory:     constMemory,
+		lowerBoundCPU:    constCPU,
+		lowerBoundMemory: constMemory,
+		upperBoundCPU:    constCPU,
+		upperBoundMemory: constMemory,
+		minCPUMillicores: 25,
+		minMemoryMb:      250,
+	}
+}
+
+func TestRecommendationFactorApplied(t *testing.T) {
+	recommender := newRecommendationFactorTestRecommender(0.1, 1000*1024*1024)
+	states := model.ContainerNameToAggregateStateMap{
+		"container-1": &model.AggregateContainerState{RecommendationFactor: map[model.ResourceName]float64{model.ResourceCPU: 1.2, model.ResourceMemory: 0.1}},
+	}
+
+	got := recommender.GetRecommendedPodResources(states)["container-1"]
+
+	wantCPU := model.CPUAmountFromCores(0.12)                    // 100m * 1.2
+	wantMemory := model.MemoryAmountFromBytes(250 * 1024 * 1024) // 1000Mi * 0.1 = 100Mi, so the 250Mi floor wins
+	for _, bound := range []struct {
+		name string
+		res  model.Resources
+	}{
+		{"Target", got.Target},
+		{"LowerBound", got.LowerBound},
+		{"UpperBound", got.UpperBound},
+	} {
+		assert.Equal(t, wantCPU, bound.res[model.ResourceCPU], bound.name)
+		assert.Equal(t, wantMemory, bound.res[model.ResourceMemory], bound.name)
+	}
+	// The raw target is computed without the factor, but with the same floor.
+	assert.Equal(t, model.CPUAmountFromCores(0.1), got.UncappedTarget[model.ResourceCPU])
+	assert.Equal(t, model.MemoryAmountFromBytes(1000*1024*1024), got.UncappedTarget[model.ResourceMemory])
+}
+
+func TestRecommendationFactorDefault(t *testing.T) {
