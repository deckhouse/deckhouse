+func TestRecommendationFactorUncappedTargetKeepsMinResources(t *testing.T) {
+	recommender := newRecommendationFactorTestRecommender(0.001, 1e6)
+	// Even the doubled estimations stay below the minimums of 25m and 250Mi.
+	states := model.ContainerNameToAggregateStateMap{
+		"container-1": &model.AggregateContainerState{RecommendationFactor: map[model.ResourceName]float64{model.ResourceCPU: 2, model.ResourceMemory: 2}},
+	}
+
+	got := recommender.GetRecommendedPodResources(states)["container-1"]
+
+	// The uncapped target differs from the target only by the factor, so the minimums are a floor for it too.
+	assert.Equal(t, model.CPUAmountFromCores(0.025), got.UncappedTarget[model.ResourceCPU])
+	assert.Equal(t, model.MemoryAmountFromBytes(250*1024*1024), got.UncappedTarget[model.ResourceMemory])
+	assert.Equal(t, got.Target, got.UncappedTarget)
