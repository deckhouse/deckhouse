+// mustReturnQuickly runs f and fails the test if it does not return within a few seconds, so that a
+// regression to an unbounded computation shows up as a failure instead of a hung test run.
+func mustReturnQuickly(t *testing.T, f func()) {
+	t.Helper()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		f()
+	}()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("did not return within 5s")
+	}
+}
+
+func parse(t *testing.T, q resource.Quantity) (factor float64, err error) {
+	t.Helper()
+	mustReturnQuickly(t, func() { factor, err = Parse(q) })
+	return factor, err
+}
+
+func display(t *testing.T, q resource.Quantity) (s string) {
+	t.Helper()
+	mustReturnQuickly(t, func() { s = displayValue(q) })
+	return s
+}
+
+func TestParse(t *testing.T) {
+	valid := map[string]float64{
+		"1": 1, "1.2": 1.2, "0.87": 0.87, "1.25": 1.25, "10": 10, "0.01": 0.01,
+		"100m": 0.1, "1.20000000000000000000": 1.2,
+	}
+	for in, want := range valid {
+		got, err := parse(t, resource.MustParse(in))
+		assert.NoError(t, err, in)
+		assert.InDelta(t, want, got, 1e-9, in)
+	}
+	invalid := map[string]string{
+		"0":      "must be greater than 0",
+		"-1":     "must be greater than 0",
+		"-1.234": "must be greater than 0",
+		"11":     "must be less than or equal to 10",
+		"10.001": "must be less than or equal to 10",
+		"1Gi":    "must be less than or equal to 10",
+		"1.234":  "must have at most two decimal places",
+		"0.004":  "must have at most two decimal places",
+		"5m":     "must have at most two decimal places",
+		// Sub-milli fractions just below a valid factor, and magnitudes beyond the int64 milli range.
+		"1.1999":                 "must have at most two decimal places",
+		"0.0099":                 "must have at most two decimal places",
+		"9.9999":                 "must have at most two decimal places",
+		"1.00000000000000000001": "must have at most two decimal places",
+		"1106804644422573097":    "must be less than or equal to 10",
+		"-9223372036854775807":   "must be greater than 0",
+		// An exponent this large makes exact comparisons take minutes, so it has to be rejected up front.
+		"1e1000000000": "must be less than or equal to 10",
+	}
+	for in, want := range invalid {
+		_, err := parse(t, resource.MustParse(in))
+		assert.EqualError(t, err, want, in)
+		assert.LessOrEqual(t, len(ValueOf(err)), 64, in)
+	}
+
+	// ParseQuantity itself needs minutes for "1e-1000000000", so build the quantity directly.
+	_, err := parse(t, *resource.NewScaledQuantity(1, -1000000000))
+	assert.EqualError(t, err, "must have at most two decimal places")
+	assert.LessOrEqual(t, len(ValueOf(err)), 64)
+}
+
+func TestValueOf(t *testing.T) {
+	_, err := Parse(resource.MustParse("1.234"))
+	assert.Equal(t, "1.234", ValueOf(err))
+	assert.Equal(t, "", ValueOf(assert.AnError))
+	assert.Equal(t, "", ValueOf(nil))
+}
+
+func TestDisplayValue(t *testing.T) {
+	cases := map[string]string{
+		"1.234":  "1.234",
+		"0":      "0",
+		"-1":     "-1",
+		"1Gi":    "1073741824",
+		"10.001": "10.001",
+		// A decimal scale of 100 or more switches to the canonical form.
+		"1e100":  "10e99",
+		"1e1000": "10e999",
+		// A mantissa beyond int64 is shown as an approximate float.
+		"12345678901234567890123": "1.2345678901234568e+22",
+	}
+	for in, want := range cases {
+		assert.Equal(t, want, display(t, resource.MustParse(in)), in)
+	}
+
+	// The exact decimal form is used while the decimal scale is strictly between -100 and 100.
+	assert.Equal(t, "1"+strings.Repeat("0", 99), display(t, *resource.NewScaledQuantity(1, 99)))
+	assert.Equal(t, "0."+strings.Repeat("0", 98)+"1", display(t, *resource.NewScaledQuantity(1, -99)))
+
+	// The boundary itself switches to the canonical exponent form. A quantity built in code has the
+	// DecimalSI format, whose own String() has no suffix for such an exponent and drops it.
+	assert.Equal(t, "10e99", display(t, *resource.NewScaledQuantity(1, 100)))
+	// ParseQuantity rounds every non-zero value below 1n up to 1n, so "1e-100" parses to 1n and cannot
+	// stand for the negative boundary. 100e-102 is 100 * 10^-102, which is 10^-100.
+	assert.Equal(t, "100e-102", display(t, *resource.NewScaledQuantity(1, -100)))
+
+	// An input string cached in the quantity must not be echoed back: this exponent is padded with
+	// 100000 zeros, and the canonical form of the value is short.
+	assert.Equal(t, "1e999", display(t, resource.MustParse("1e"+strings.Repeat("0", 100000)+"999")))
+
+	// The exact decimal form of these two takes gigabytes, so the rendering has to stay short and fast.
+	// ParseQuantity itself needs minutes for "1e-1000000000", so build that quantity directly.
+	assert.LessOrEqual(t, len(display(t, *resource.NewScaledQuantity(1, -1000000000))), 64)
+	assert.LessOrEqual(t, len(display(t, resource.MustParse("1e1000000000"))), 64)
+}
