+// validateRecommendationFactor validates the keys and values of a container policy's recommendationFactor.
+// Keys are visited in sorted order so that the errors are reported in a deterministic order.
+func validateRecommendationFactor(factors corev1.ResourceList, fldPath *field.Path) field.ErrorList {
+	allErrs := field.ErrorList{}
+
+	for _, name := range slices.Sorted(maps.Keys(factors)) {
+		keyPath := fldPath.Key(string(name))
+		if !slices.Contains(recommendationfactor.SupportedResources, name) {
+			allErrs = append(allErrs, field.NotSupported(keyPath, string(name), recommendationfactor.SupportedResources))
+			continue
+		}
+
+		if _, err := recommendationfactor.Parse(factors[name]); err != nil {
+			allErrs = append(allErrs, field.Invalid(keyPath, recommendationfactor.ValueOf(err), err.Error()))
+		}
+	}
+
+	return allErrs
+}
