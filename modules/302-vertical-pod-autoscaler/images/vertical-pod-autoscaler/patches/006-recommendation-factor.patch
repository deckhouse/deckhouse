+	assert.Equal(t, model.CPUAmountFromCores(0.1), got.Target[model.ResourceCPU])
+	assert.Equal(t, model.MemoryAmountFromBytes(1000*1024*1024), got.Target[model.ResourceMemory])
+	assert.Equal(t, got.UncappedTarget, got.Target)
+}
+
