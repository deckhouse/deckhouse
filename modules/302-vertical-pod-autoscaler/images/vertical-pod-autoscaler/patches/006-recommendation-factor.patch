+// vpaWithRecommendationFactor returns a valid VPA whose single wildcard container policy carries the given factors.
+func vpaWithRecommendationFactor(mode *vpa_types.ContainerScalingMode, factors corev1.ResourceList) vpa_types.VerticalPodAutoscaler {
+	updateMode := vpa_types.UpdateModeOff
+	return vpa_types.VerticalPodAutoscaler{
+		Spec: vpa_types.VerticalPodAutoscalerSpec{
+			TargetRef: &autoscalingv1.CrossVersionObjectReference{
+				Kind: "Deployment",
+				Name: "my-app",
+			},
+			UpdatePolicy: &vpa_types.PodUpdatePolicy{
+				UpdateMode: &updateMode,
+			},
+			ResourcePolicy: &vpa_types.PodResourcePolicy{
+				ContainerPolicies: []vpa_types.ContainerResourcePolicy{
+					{
+						ContainerName:        "*",
+						Mode:                 mode,
+						RecommendationFactor: factors,
+					},
+				},
+			},
+		},
+	}
+}
+
+func TestValidateRecommendationFactorErrorOrder(t *testing.T) {
+	vpa := vpaWithRecommendationFactor(nil, corev1.ResourceList{
+		memory:                 resource.MustParse("0"),
+		cpu:                    resource.MustParse("11"),
+		corev1.ResourceStorage: resource.MustParse("2"),
+		"hugepages-2Mi":        resource.MustParse("2"),
+	})
+	opts := VPAValidationOptions{IsVPACreate: true}
+	expected := []string{
+		"spec.resourcePolicy.containerPolicies[0].recommendationFactor[cpu]",
+		"spec.resourcePolicy.containerPolicies[0].recommendationFactor[hugepages-2Mi]",
+		"spec.resourcePolicy.containerPolicies[0].recommendationFactor[memory]",
+		"spec.resourcePolicy.containerPolicies[0].recommendationFactor[storage]",
+	}
+
+	// Map iteration order is random, so repeat to make an unsorted implementation fail reliably.
+	for range 20 {
+		var got []string
+		for _, err := range validateVPA(&vpa, opts) {
+			got = append(got, err.Field)
+		}
+		assert.Equal(t, expected, got)
+	}
+}
