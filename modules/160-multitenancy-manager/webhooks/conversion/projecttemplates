source /shell_lib.sh

# v1alpha1 is served and deprecated, v1alpha2 is the storage version, and the CRD declares a
# conversion webhook, so the apiserver asks for a conversion whenever a client uses the version that
# is not stored and whenever it reads an object still stored at the other one. A CRD pointing at a
# webhook that cannot convert is a CRD whose objects can stop being readable. Removing the hook made
# every such request fail: a live cluster answered about one a second, all of them counted as
# conversion failures.
#
# The conversion is the version bump and nothing else. Both versions name description,
# parametersSchema and resourcesTemplate identically, so a Helm template survives the round trip.
# The structured fields v1alpha2 added exist only there: they are pruned on the way down and cannot
# come back, so a write through v1alpha1 would erase them, and the template webhook refuses one to a
# template that has them.
function __config__() {
  cat <<EOF
configVersion: v1
kubernetesCustomResourceConversion:
  - name: v1alpha1_to_v1alpha2
    crdName: projecttemplates.deckhouse.io
    conversions:
    - fromVersion: deckhouse.io/v1alpha1
      toVersion: deckhouse.io/v1alpha2
  - name: v1alpha2_to_v1alpha1
    crdName: projecttemplates.deckhouse.io
    conversions:
    - fromVersion: deckhouse.io/v1alpha2
      toVersion: deckhouse.io/v1alpha1
EOF
}

function __on_conversion::v1alpha1_to_v1alpha2() {
  if converted=$(context::jq -rc '.review.request.objects//[] | map(
     if .apiVersion == "deckhouse.io/v1alpha1" then .apiVersion = "deckhouse.io/v1alpha2" else . end
  )'); then
    cat <<EOF >"$CONVERSION_RESPONSE_PATH"
{"convertedObjects": $converted}
EOF
  else
    cat <<EOF >"$CONVERSION_RESPONSE_PATH"
{"failedMessage":"Conversion of projecttemplates.deckhouse.io failed"}
EOF
  fi
}

# The two fields the v1alpha1 schema requires are backfilled when a structured template omits them.
# The apiserver checks only the metadata of what a conversion returns, but a client that reads a
# template through v1alpha1 and writes it back is validated against the v1alpha1 schema, which
# requires both, so a template that never had a resourcesTemplate would read back as an object that
# cannot be written.
function __on_conversion::v1alpha2_to_v1alpha1() {
  if converted=$(context::jq -rc '.review.request.objects//[] | map(
     if .apiVersion == "deckhouse.io/v1alpha2" then
       .apiVersion = "deckhouse.io/v1alpha1" |
       .spec = ((.spec // {})
         | (.resourcesTemplate //= "")
         | (.parametersSchema //= {"openAPIV3Schema": {}})
         | (.parametersSchema.openAPIV3Schema //= {}))
     else . end
  )'); then
    cat <<EOF >"$CONVERSION_RESPONSE_PATH"
{"convertedObjects": $converted}
EOF
  else
    cat <<EOF >"$CONVERSION_RESPONSE_PATH"
{"failedMessage":"Conversion of projecttemplates.deckhouse.io failed"}
EOF
  fi
}

hook::run "$@"
