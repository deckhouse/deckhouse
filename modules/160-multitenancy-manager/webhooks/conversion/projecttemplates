source /shell_lib.sh

# v1alpha1 is no longer served, but it is still a version of the CRD and still listed in
# status.storedVersions, and the CRD still declares a conversion webhook -- so the apiserver keeps
# asking for the conversion, and a CRD pointing at a webhook that cannot convert is a CRD whose
# objects can stop being readable. Removing the hook made every such request fail: a live cluster
# answered about one a second, all of them counted as conversion failures.
#
# Up: the version bump, minus resourcesTemplate. v1alpha2 describes a template with structured fields
# and has no Helm string; a v1alpha1 template that carried one is marked with the
# projects.deckhouse.io/legacy-helm-template annotation instead, so the controller refuses to render
# its projects rather than render the empty structured shape over the release the Helm string built
# -- that render would delete every object the string produced. The mark is set on the way up only:
# the stored object is v1alpha1 (the apiserver asks for the conversion because that is what it
# reads), and it stays marked until an administrator rewrites the template and removes the mark.
#
# Down: the structured fields v1alpha2 added exist only there -- they are pruned on the way down and
# cannot come back, which is precisely why v1alpha1 is not served: no client can write a template
# back through it and erase them.
function __config__() {
  cat <<EOF
configVersion: v1
kubernetesCustomResourceConversion:
  - name: v1alpha1_to_v1alpha2
    crdName: projecttemplates.deckhouse.io
    conversions:
    - fromVersion: deckhouse.io/v1alpha1
      toVersion: deckhouse.io/v1alpha2
  - name: v1alpha2_to_v1alpha1
    crdName: projecttemplates.deckhouse.io
    conversions:
    - fromVersion: deckhouse.io/v1alpha2
      toVersion: deckhouse.io/v1alpha1
EOF
}

function __on_conversion::v1alpha1_to_v1alpha2() {
  if converted=$(context::jq -rc '.review.request.objects//[] | map(
     if .apiVersion == "deckhouse.io/v1alpha1" then
       .apiVersion = "deckhouse.io/v1alpha2" |
       (if (((.spec // {}).resourcesTemplate // "") | tostring | test("\\S")) then
          .metadata.annotations["projects.deckhouse.io/legacy-helm-template"] = "true"
        else . end) |
       (if .spec then del(.spec.resourcesTemplate) else . end)
     else . end
  )'); then
    cat <<EOF >"$CONVERSION_RESPONSE_PATH"
{"convertedObjects": $converted}
EOF
  else
    cat <<EOF >"$CONVERSION_RESPONSE_PATH"
{"failedMessage":"Conversion of projecttemplates.deckhouse.io failed"}
EOF
  fi
}

# The two fields the v1alpha1 schema requires are backfilled: v1alpha2 has no resourcesTemplate at
# all and a template may omit parametersSchema, while the apiserver validates what a conversion
# returns, so the object would otherwise come back as one v1alpha1 cannot describe.
function __on_conversion::v1alpha2_to_v1alpha1() {
  if converted=$(context::jq -rc '.review.request.objects//[] | map(
     if .apiVersion == "deckhouse.io/v1alpha2" then
       .apiVersion = "deckhouse.io/v1alpha1" |
       .spec = ((.spec // {})
         | (.resourcesTemplate //= "")
         | (.parametersSchema //= {"openAPIV3Schema": {}})
         | (.parametersSchema.openAPIV3Schema //= {}))
     else . end
  )'); then
    cat <<EOF >"$CONVERSION_RESPONSE_PATH"
{"convertedObjects": $converted}
EOF
  else
    cat <<EOF >"$CONVERSION_RESPONSE_PATH"
{"failedMessage":"Conversion of projecttemplates.deckhouse.io failed"}
EOF
  fi
}

hook::run "$@"
