+
+const intOrStringHint = "io.k8s.apimachinery.pkg.util.intstr.IntOrString"
+
+// kinV3Type converts schema `Root` of a minimal OpenAPI 3 doc built from the given schemas JSON object body.
+func kinV3Type(t *testing.T, schemasJSON string) (tftypes.Type, map[string]string) {
+	t.Helper()
+	doc, err := loadV3Doc([]byte(`{"openapi":"3.0.0","info":{"title":"t","version":"1"},"paths":{},"components":{"schemas":` + schemasJSON + `}}`))
+	if err != nil {
+		t.Fatalf("load: %v", err)
+	}
+	defs := doc.Components.Schemas
+	root, err := resolveSchemaRef(defs["Root"], defs)
+	if err != nil {
+		t.Fatalf("resolve: %v", err)
+	}
+	hints := map[string]string{}
+	var cache sync.Map
+	ty, err := getTypeFromSchema(root, 50, &cache, defs, tftypes.AttributePath{}, hints)
+	if err != nil {
+		t.Fatalf("getTypeFromSchema: %v", err)
+	}
+	return ty, hints
+}
+
+func attrPath(name string) string {
+	return tftypes.NewAttributePath().WithAttributeName(name).String()
+}
+
+func TestSchemaExtensionsDecodedAsBool(t *testing.T) {
+	cases := map[string]struct {
+		schemas  string
+		wantType tftypes.Type
+		wantHint map[string]string
+	}{
+		"preserve-unknown-fields true": {
+			schemas:  `{"Root":{"type":"object","properties":{"spec":{"type":"object","x-kubernetes-preserve-unknown-fields":true}}}}`,
+			wantType: tftypes.Object{AttributeTypes: map[string]tftypes.Type{"spec": tftypes.DynamicPseudoType}},
+			wantHint: map[string]string{attrPath("spec"): manifest.PreserveUnknownFieldsLabel},
+		},
+		"preserve-unknown-fields false": {
+			schemas:  `{"Root":{"type":"object","properties":{"spec":{"type":"object","x-kubernetes-preserve-unknown-fields":false}}}}`,
+			wantType: tftypes.Object{AttributeTypes: map[string]tftypes.Type{"spec": tftypes.DynamicPseudoType}},
+			wantHint: map[string]string{},
+		},
+		"int-or-string true": {
+			schemas:  `{"Root":{"type":"object","properties":{"port":{"x-kubernetes-int-or-string":true}}}}`,
+			wantType: tftypes.Object{AttributeTypes: map[string]tftypes.Type{"port": tftypes.String}},
+			wantHint: map[string]string{attrPath("port"): intOrStringHint},
+		},
+		"int-or-string format": {
+			schemas:  `{"Root":{"type":"object","properties":{"port":{"type":"string","format":"int-or-string"}}}}`,
+			wantType: tftypes.Object{AttributeTypes: map[string]tftypes.Type{"port": tftypes.String}},
+			wantHint: map[string]string{attrPath("port"): intOrStringHint},
+		},
+		"untyped without extension": {
+			schemas:  `{"Root":{"type":"object","properties":{"x":{}}}}`,
+			wantType: tftypes.Object{AttributeTypes: map[string]tftypes.Type{"x": tftypes.DynamicPseudoType}},
+			wantHint: map[string]string{},
+		},
+	}
+	for name, c := range cases {
+		t.Run(name, func(t *testing.T) {
+			ty, hints := kinV3Type(t, c.schemas)
+			if !ty.Equal(c.wantType) {
+				t.Fatalf("type: got %#v want %#v", ty, c.wantType)
+			}
+			if fmt.Sprint(hints) != fmt.Sprint(c.wantHint) {
+				t.Fatalf("hints: got %v want %v", hints, c.wantHint)
+			}
+		})
+	}
+}
+
+func TestSchemaTypeVariants(t *testing.T) {
+	obj := func() tftypes.Type {
+		return tftypes.Object{AttributeTypes: map[string]tftypes.Type{"a": tftypes.String, "b": tftypes.Number}}
+	}
+	cases := map[string]struct {
+		schemas string
+		want    tftypes.Type
+	}{
+		"type list string+null": {
+			`{"Root":{"type":["string","null"]}}`, tftypes.String,
+		},
+		"type list null+number": {
+			`{"Root":{"type":["null","number"]}}`, tftypes.Number,
+		},
+		"nullable string": {
+			`{"Root":{"type":"string","nullable":true}}`, tftypes.String,
+		},
+		"type list only null": {
+			`{"Root":{"type":["null"]}}`, tftypes.DynamicPseudoType,
+		},
+		"no type": {
+			`{"Root":{}}`, tftypes.DynamicPseudoType,
+		},
+		"additionalProperties schema": {
+			`{"Root":{"type":"object","additionalProperties":{"type":"string"}}}`, tftypes.Map{ElementType: tftypes.String},
+		},
+		"additionalProperties true": {
+			`{"Root":{"type":"object","additionalProperties":true}}`, tftypes.DynamicPseudoType,
+		},
+		"additionalProperties false": {
+			`{"Root":{"type":"object","additionalProperties":false}}`, tftypes.DynamicPseudoType,
+		},
+		"properties with additionalProperties true": {
+			`{"Root":{"type":"object","additionalProperties":true,"properties":{"a":{"type":"string"},"b":{"type":"number"}}}}`, obj(),
+		},
+		"properties only": {
+			`{"Root":{"type":"object","properties":{"a":{"type":"string"},"b":{"type":"number"}}}}`, obj(),
+		},
+		"array items": {
+			`{"Root":{"type":"array","items":{"type":"string"}}}`, tftypes.List{ElementType: tftypes.String},
+		},
+		"array items ref": {
+			`{"Root":{"type":"array","items":{"$ref":"#/components/schemas/Item"}},"Item":{"type":"object","properties":{"a":{"type":"string"},"b":{"type":"number"}}}}`,
+			tftypes.List{ElementType: obj()},
+		},
+		"array items dynamic is tuple": {
+			`{"Root":{"type":"array","items":{"type":"object","x-kubernetes-preserve-unknown-fields":true}}}`,
+			tftypes.Tuple{ElementTypes: []tftypes.Type{tftypes.DynamicPseudoType}},
+		},
+		"array additionalProperties schema is tuple": {
+			`{"Root":{"type":"array","additionalProperties":{"type":"string"}}}`,
+			tftypes.Tuple{ElementTypes: []tftypes.Type{tftypes.String}},
+		},
+		"property ref": {
+			`{"Root":{"type":"object","properties":{"item":{"$ref":"#/components/schemas/Item"}}},"Item":{"type":"string"}}`,
+			tftypes.Object{AttributeTypes: map[string]tftypes.Type{"item": tftypes.String}},
+		},
+	}
+	for name, c := range cases {
+		t.Run(name, func(t *testing.T) {
+			ty, _ := kinV3Type(t, c.schemas)
+			if !ty.Equal(c.want) {
+				t.Fatalf("got %#v want %#v", ty, c.want)
+			}
+		})
+	}
+}
