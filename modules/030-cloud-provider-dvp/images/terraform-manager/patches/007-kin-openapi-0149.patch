+func TestSchemaTypeUnsupportedIsError(t *testing.T) {
+	doc, err := loadV3Doc([]byte(`{"openapi":"3.0.0","info":{"title":"t","version":"1"},"paths":{},"components":{"schemas":{"Root":{"type":"boolean2"}}}}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defs := doc.Components.Schemas
+	root, _ := resolveSchemaRef(defs["Root"], defs)
+	var cache sync.Map
+	if _, err := getTypeFromSchema(root, 50, &cache, defs, tftypes.AttributePath{}, map[string]string{}); err == nil {
+		t.Fatal("expected error for unknown type")
+	}
+}
+
+func TestFoundryV2GVKExtensionAndHints(t *testing.T) {
+	spec := `{"swagger":"2.0","info":{"title":"t","version":"1"},"paths":{},"definitions":{
+		"io.example.v1.Foo":{"type":"object","properties":{
+			"a":{"type":"string"},
+			"free":{"type":"object","x-kubernetes-preserve-unknown-fields":true},
+			"port":{"x-kubernetes-int-or-string":true}},
+		 "x-kubernetes-group-version-kind":[{"group":"example.io","version":"v1","kind":"Foo"}]}}}`
+	f, err := NewFoundryFromSpecV2([]byte(spec))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ty, hints, err := f.GetTypeByGVK(schema.GroupVersionKind{Group: "example.io", Version: "v1", Kind: "Foo"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := tftypes.Object{AttributeTypes: map[string]tftypes.Type{
+		"a": tftypes.String, "free": tftypes.DynamicPseudoType, "port": tftypes.String,
+	}}
+	if !ty.Equal(want) {
+		t.Fatalf("got %#v want %#v", ty, want)
+	}
+	wantHints := map[string]string{attrPath("free"): manifest.PreserveUnknownFieldsLabel, attrPath("port"): intOrStringHint}
+	if fmt.Sprint(hints) != fmt.Sprint(wantHints) {
+		t.Fatalf("hints: got %v want %v", hints, wantHints)
+	}
+}
+
+func TestMultiV3BuildIndexAndNilComponents(t *testing.T) {
+	doc, err := loadV3Doc([]byte(`{"openapi":"3.0.0","info":{"title":"t","version":"1"},"paths":{}}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if doc.Components == nil {
+		t.Fatal("loadV3Doc must normalize nil Components")
+	}
+	g := &v3Group{doc: doc, gvkIndex: map[schema.GroupVersionKind]string{}}
+	if err := g.buildIndex(); err != nil {
+		t.Fatal(err)
+	}
+	if len(g.gvkIndex) != 0 {
+		t.Fatalf("unexpected index: %v", g.gvkIndex)
+	}
+
+	doc, err = loadV3Doc([]byte(`{"openapi":"3.0.0","info":{"title":"t","version":"1"},"paths":{},"components":{"schemas":{
+		"io.example.v1.Foo":{"type":"object","x-kubernetes-group-version-kind":[{"group":"example.io","version":"v1","kind":"Foo"}]}}}}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	g = &v3Group{doc: doc, gvkIndex: map[schema.GroupVersionKind]string{}}
+	if err := g.buildIndex(); err != nil {
+		t.Fatal(err)
+	}
+	if id := g.gvkIndex[schema.GroupVersionKind{Group: "example.io", Version: "v1", Kind: "Foo"}]; id != "io.example.v1.Foo" {
+		t.Fatalf("GVK extension not indexed: %v", g.gvkIndex)
+	}
+}
+
+// Golden lines are "<sha256 of 'gvk|err|type|hints'> <gvk>" generated with kin-openapi v0.111.0 (UPDATE_GOLDEN=1 rewrites them).
+func TestSwaggerFixtureTypesMatchGolden(t *testing.T) {
+	data, err := os.ReadFile(filepath.Join("testdata", "k8s-swagger.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, err := NewFoundryFromSpecV2(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fo := f.(*foapiv2)
+	got := map[string]string{}
+	fo.gkvIndex.Range(func(k, _ any) bool {
+		gvk := k.(schema.GroupVersionKind)
+		ty, h, err := f.GetTypeByGVK(gvk)
+		hs := []string{}
+		for a, b := range h {
+			hs = append(hs, a+"="+b)
+		}
+		sort.Strings(hs)
+		sum := sha256.Sum256([]byte(fmt.Sprintf("%s|%v|%v|%v", gvk.String(), err, ty, hs)))
+		got[gvk.String()] = hex.EncodeToString(sum[:])
+		return true
+	})
+	goldenPath := filepath.Join("testdata", "gvk-types.golden")
+	if os.Getenv("UPDATE_GOLDEN") == "1" {
+		keys := make([]string, 0, len(got))
+		for k := range got {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var sb strings.Builder
+		for _, k := range keys {
+			sb.WriteString(got[k] + " " + k + "\n")
+		}
+		if err := os.WriteFile(goldenPath, []byte(sb.String()), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		return
+	}
+	fh, err := os.Open(goldenPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer fh.Close()
+	want := map[string]string{}
+	sc := bufio.NewScanner(fh)
+	for sc.Scan() {
+		parts := strings.SplitN(sc.Text(), " ", 2)
+		if len(parts) == 2 {
+			want[parts[1]] = parts[0]
+		}
+	}
+	if len(want) != len(got) {
+		t.Fatalf("GVK count: got %d golden %d", len(got), len(want))
+	}
+	for k, w := range want {
+		if got[k] != w {
+			t.Errorf("type for %s differs from golden", k)
+		}
+	}
+}
