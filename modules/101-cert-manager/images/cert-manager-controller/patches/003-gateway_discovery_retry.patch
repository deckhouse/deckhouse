+// discoveryRetryTimeout bounds how long the controller waits for the API server at startup before it
+// exits. It matches the longest back-off of kubelet, so waiting in the process is never slower than a
+// restart.
+const discoveryRetryTimeout = 5 * time.Minute
+
+// discoveryNotFoundGrace is how long a NotFound answer is retried. A kube-apiserver that has just
+// started answers NotFound for a served CRD group until its discovery controller has caught up with the
+// CRD informer, so a NotFound right after an API server restart is transient; a NotFound that lasts
+// longer means the Gateway API CRDs are really absent.
+const discoveryNotFoundGrace = time.Minute
+
+// discoveryMaxRetryDelay caps the back-off between discovery retries.
+const discoveryMaxRetryDelay = 10 * time.Second
+
+// serverResourcesWithRetry retries discovery while the API server is unreachable or failing, so that
+// a controller started during an API server outage starts as soon as the API server returns instead
+// of exiting and waiting for the growing CrashLoopBackOff delay. The retries stop as soon as ctx is
+// cancelled, so a controller that is shut down while it waits exits at once.
+func serverResourcesWithRetry(ctx context.Context, d discovery.DiscoveryInterface, groupVersion string) (*metav1.APIResourceList, error) {
+	return retryServerResources(ctx, d, groupVersion, discoveryRetryTimeout, discoveryNotFoundGrace, time.Second)
+}
+
+func retryServerResources(ctx context.Context, d discovery.DiscoveryInterface, groupVersion string, timeout, notFoundGrace, delay time.Duration) (*metav1.APIResourceList, error) {
+	start := time.Now()
+	deadline := start.Add(timeout)
+	for {
+		resources, err := d.ServerResourcesForGroupVersion(groupVersion)
+		if err == nil {
+			return resources, nil
+		}
+		if apierrors.IsNotFound(err) && time.Since(start)+delay > notFoundGrace {
+			return resources, err
+		}
+		if time.Now().Add(delay).After(deadline) {
+			return resources, err
+		}
+		logf.Log.Error(err, "Gateway API discovery failed, retrying", "groupVersion", groupVersion, "retryIn", delay)
+		select {
+		case <-ctx.Done():
+			return resources, context.Cause(ctx)
+		case <-time.After(delay):
+		}
+		delay = min(delay*2, discoveryMaxRetryDelay)
+	}
+}
