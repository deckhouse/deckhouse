+package controller
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	fakediscovery "k8s.io/client-go/discovery/fake"
+	k8stesting "k8s.io/client-go/testing"
+)
+
+func newFakeDiscovery(failures int, failWith error) (*fakediscovery.FakeDiscovery, *int) {
+	calls := 0
+	fake := &k8stesting.Fake{}
+	fake.Resources = []*metav1.APIResourceList{{
+		GroupVersion: "gateway.networking.k8s.io/v1",
+		APIResources: []metav1.APIResource{{Name: "gateways", Kind: "Gateway"}},
+	}}
+	fake.AddReactor("get", "resource", func(k8stesting.Action) (bool, runtime.Object, error) {
+		calls++
+		if calls <= failures {
+			return true, nil, failWith
+		}
+		return false, nil, nil
+	})
+	return &fakediscovery.FakeDiscovery{Fake: fake}, &calls
+}
+
+func TestServerResourcesWithRetryWaitsForAPIServer(t *testing.T) {
+	d, calls := newFakeDiscovery(2, errors.New("dial tcp 10.0.0.1:443: connect: connection refused"))
+
+	resources, err := retryServerResources(context.Background(), d, "gateway.networking.k8s.io/v1", time.Minute, time.Minute, time.Millisecond)
+	if err != nil {
+		t.Fatalf("expected success after transient errors, got %v", err)
+	}
+	if len(resources.APIResources) != 1 {
+		t.Fatalf("expected the Gateway resource, got %v", resources.APIResources)
+	}
+	if *calls != 3 {
+		t.Fatalf("expected 3 discovery calls, got %d", *calls)
+	}
+}
+
+// A NotFound right after an API server restart is transient and is retried.
+func TestServerResourcesWithRetryRetriesTransientNotFound(t *testing.T) {
+	notFound := apierrors.NewNotFound(schema.GroupResource{Group: "gateway.networking.k8s.io"}, "v1")
+	d, calls := newFakeDiscovery(2, notFound)
+
+	if _, err := retryServerResources(context.Background(), d, "gateway.networking.k8s.io/v1", time.Minute, time.Minute, time.Millisecond); err != nil {
+		t.Fatalf("expected success after a transient NotFound, got %v", err)
+	}
+	if *calls != 3 {
+		t.Fatalf("expected 3 discovery calls, got %d", *calls)
+	}
+}
+
+// A NotFound that outlasts the grace period means the CRDs are absent and is returned.
+func TestServerResourcesWithRetryReturnsLastingNotFound(t *testing.T) {
+	notFound := apierrors.NewNotFound(schema.GroupResource{Group: "gateway.networking.k8s.io"}, "v1")
+	d, _ := newFakeDiscovery(1000, notFound)
+
+	start := time.Now()
+	_, err := retryServerResources(context.Background(), d, "gateway.networking.k8s.io/v1", time.Minute, 20*time.Millisecond, time.Millisecond)
+	if !apierrors.IsNotFound(err) {
+		t.Fatalf("expected NotFound, got %v", err)
+	}
+	if time.Since(start) > 5*time.Second {
+		t.Fatalf("NotFound was retried past its grace period")
+	}
+}
+
+// A shutdown while the API server is unreachable stops the retries at once.
+func TestServerResourcesWithRetryStopsOnShutdown(t *testing.T) {
+	d, _ := newFakeDiscovery(1000, errors.New("dial tcp 10.0.0.1:443: connect: connection refused"))
+
+	ctx, cancel := context.WithCancel(context.Background())
+	time.AfterFunc(20*time.Millisecond, cancel)
+
+	start := time.Now()
+	_, err := retryServerResources(ctx, d, "gateway.networking.k8s.io/v1", time.Minute, time.Minute, 10*time.Millisecond)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("expected context.Canceled, got %v", err)
+	}
+	if time.Since(start) > 5*time.Second {
+		t.Fatalf("the retries did not stop on shutdown")
+	}
+}
