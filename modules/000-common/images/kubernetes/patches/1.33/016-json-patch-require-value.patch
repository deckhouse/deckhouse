+
+package jsonpatch
+
+import (
+	"strings"
+	"testing"
+
+	jsonpatch "gopkg.in/evanphx/json-patch.v4"
+)
+
+func TestValidateRequiredValue(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		patch         string
+		expectedError string
+	}{
+		{
+			name:          "replace root without value",
+			patch:         `[{"op": "replace", "path": ""}]`,
+			expectedError: `json patch operation 0 ("replace") at path "": missing required field "value"`,
+		},
+		{
+			name:          "add root without value",
+			patch:         `[{"op": "add", "path": ""}]`,
+			expectedError: `json patch operation 0 ("add") at path "": missing required field "value"`,
+		},
+		{
+			name:          "test root without value",
+			patch:         `[{"op": "test", "path": ""}]`,
+			expectedError: `json patch operation 0 ("test") at path "": missing required field "value"`,
+		},
+		{
+			name:          "test non-root without value",
+			patch:         `[{"op": "test", "path": "/a"}]`,
+			expectedError: `json patch operation 0 ("test") at path "/a": missing required field "value"`,
+		},
+		{
+			name:          "reports index of the offending operation",
+			patch:         `[{"op": "add", "path": "/a", "value": 1}, {"op": "test", "path": "/b"}]`,
+			expectedError: `json patch operation 1 ("test") at path "/b"`,
+		},
+		{
+			name:  "replace root with object value",
+			patch: `[{"op": "replace", "path": "", "value": {"a": 1}}]`,
+		},
+		{
+			name:  "replace root with null value",
+			patch: `[{"op": "replace", "path": "", "value": null}]`,
+		},
+		{
+			name:  "test root with null value",
+			patch: `[{"op": "test", "path": "", "value": null}]`,
+		},
+		{
+			name:  "test non-root with null value",
+			patch: `[{"op": "test", "path": "/a", "value": null}]`,
+		},
+		{
+			name:  "add without value on non-root path is left as is",
+			patch: `[{"op": "add", "path": "/a"}]`,
+		},
+		{
+			name:  "replace without value on non-root path is left as is",
+			patch: `[{"op": "replace", "path": "/a"}]`,
+		},
+		{
+			name:  "remove does not require value",
+			patch: `[{"op": "remove", "path": ""}]`,
+		},
+		{
+			name:  "missing path is left to Apply",
+			patch: `[{"op": "test"}]`,
+		},
+		{
+			name:  "malformed path is left to Apply",
+			patch: `[{"op": "replace", "path": 1}]`,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			patch, err := jsonpatch.DecodePatch([]byte(tc.patch))
+			if err != nil {
+				t.Fatalf("unexpected decode error: %v", err)
+			}
+			err = ValidateRequiredValue(patch)
+			if len(tc.expectedError) == 0 {
+				if err != nil {
+					t.Fatalf("unexpected error: %v", err)
+				}
+				return
+			}
+			if err == nil {
+				t.Fatalf("expected error %q, got nil", tc.expectedError)
+			}
+			if !strings.Contains(err.Error(), tc.expectedError) {
+				t.Fatalf("expected error %q, got %q", tc.expectedError, err.Error())
+			}
+		})
+	}
+}
