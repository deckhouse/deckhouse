+// Package jsonpatch contains helpers for validating RFC 6902 JSON Patch
+// documents before they are applied with gopkg.in/evanphx/json-patch.v4.
+package jsonpatch
+
+import (
+	"fmt"
+
+	jsonpatch "gopkg.in/evanphx/json-patch.v4"
+)
+
+// ValidateRequiredValue rejects operations that lack the "value" member
+// required by RFC 6902 sections 4.1, 4.3 and 4.6 where json-patch v4 would
+// dereference a nil value and panic:
+//
+//   - "test" operations with any path: comparing against a missing value is
+//     meaningless, and json-patch v4.12.0 panics when the target is missing
+//     or null;
+//   - "add" and "replace" operations that target the whole document (empty
+//     path).
+//
+// Key presence is checked, not the value itself: an explicit "value": null is
+// a valid JSON value and is accepted. "add" and "replace" operations with a
+// non-empty path are not checked to keep the historical behaviour of the
+// library, which treats a missing value as null there. Operations with a
+// missing or malformed path are left to Patch.Apply to report.
+func ValidateRequiredValue(patch jsonpatch.Patch) error {
+	for i, op := range patch {
+		kind := op.Kind()
+		switch kind {
+		case "add", "replace", "test":
+		default:
+			continue
+		}
+		if _, ok := op["value"]; ok {
+			continue
+		}
+		path, err := op.Path()
+		if err != nil {
+			continue
+		}
+		if kind != "test" && path != "" {
+			continue
+		}
+		return fmt.Errorf("json patch operation %d (%q) at path %q: missing required field \"value\"", i, kind, path)
+	}
+	return nil
+}
