+
+package checkpointselfheal
+
+import (
+	"k8s.io/component-base/metrics"
+	"k8s.io/component-base/metrics/legacyregistry"
+)
+
+// Registered here rather than in pkg/kubelet/metrics so this change does not
+// touch that file. legacyregistry is the registry kubelet serves on /metrics.
+
+// A gauge, because this is a state that lasts until a human acts on it. No
+// series up front -- absent already reads as healthy for "> 0" -- and each is
+// deleted once its container is gone, or it hangs at its last value. The reset
+// itself is not counted separately: it is already a log line and a Pod event.
+var unpinnedContainers = metrics.NewGaugeVec(
+	&metrics.GaugeOpts{
+		Subsystem:      "kubelet",
+		Name:           "checkpoint_state_unpinned_containers",
+		Help:           "Running containers whose NUMA zone may differ from the one the memory manager state records for them, after the kubelet reset that checkpoint.",
+		StabilityLevel: metrics.ALPHA,
+	},
+	[]string{"namespace", "pod", "container"},
+)
+
+func init() {
+	legacyregistry.MustRegister(unpinnedContainers)
+}
diff --git a/pkg/kubelet/cm/checkpointselfheal/selfheal.go b/pkg/kubelet/cm/checkpointselfheal/selfheal.go
