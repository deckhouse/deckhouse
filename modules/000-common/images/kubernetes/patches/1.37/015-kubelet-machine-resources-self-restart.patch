+
+package kubelet
+
+import (
+	"testing"
+
+	cadvisorapi "github.com/google/cadvisor/lib/model"
+)
+
+func TestMachineResourcesGrewShrunk(t *testing.T) {
+	const (
+		mib = 1024 * 1024
+		gib = 1024 * mib
+	)
+	base := &cadvisorapi.MachineInfo{NumCores: 4, MemoryCapacity: 8 * gib}
+
+	tests := []struct {
+		name   string
+		cpus   int
+		mem    uint64
+		grown  bool
+		shrunk bool
+	}{
+		{"same", 4, 8 * gib, false, false},
+		{"memory below threshold", 4, 8*gib + 99*mib, false, false},
+		{"memory at threshold", 4, 8*gib + 100*mib, true, false},
+		{"memory +1Gi", 4, 9 * gib, true, false},
+		{"cpu +1", 5, 8 * gib, true, false},
+		{"cpu +1 memory +50Mi", 5, 8*gib + 50*mib, true, false},
+		{"cpu +1 memory +1Gi", 5, 9 * gib, true, false},
+		{"memory -1Mi", 4, 8*gib - mib, false, true},
+		{"cpu -1", 3, 8 * gib, false, true},
+		{"cpu +1 memory -1Mi", 5, 8*gib - mib, true, true},
+		{"memory +1Gi cpu -1", 3, 9 * gib, true, true},
+		// cadvisor reports 0 cores when topology read fails
+		{"cpu unreadable", 0, 9 * gib, true, true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			cur := &cadvisorapi.MachineInfo{NumCores: tc.cpus, MemoryCapacity: tc.mem}
+			if got := machineResourcesGrew(base, cur); got != tc.grown {
+				t.Errorf("machineResourcesGrew(4 CPUs 8Gi -> %d CPUs %d bytes) = %v, want %v", tc.cpus, tc.mem, got, tc.grown)
+			}
+			if got := machineResourcesShrunk(base, cur); got != tc.shrunk {
+				t.Errorf("machineResourcesShrunk(4 CPUs 8Gi -> %d CPUs %d bytes) = %v, want %v", tc.cpus, tc.mem, got, tc.shrunk)
+			}
+		})
+	}
+}
