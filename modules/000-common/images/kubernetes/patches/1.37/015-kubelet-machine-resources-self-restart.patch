+package kubelet
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"time"
+
+	cadvisorapi "github.com/google/cadvisor/lib/model"
+	"k8s.io/apimachinery/pkg/util/wait"
+	"k8s.io/klog/v2"
+)
+
+const (
+	// cadvisor refreshes machine info at this rate (checking faster sees the same cache)
+	machineResourcesCheckInterval   = 5 * time.Minute
+	machineResourcesMemoryThreshold = 100 * 1024 * 1024
+	machineResourcesDisableFile     = "machine-resources-restart-disabled"
+	// 1 is kubelet fatal error, keep self-restart observable
+	machineResourcesExitCode = 75
+)
+
+// Exits on CPU/memory growth since start, systemd restarts kubelet with new capacity.
+// Baseline = snapshot taken at construction by the same cadvisor code, so equal readings mean no change.
+func (kl *Kubelet) exitOnMachineResourcesGrowth(ctx context.Context) {
+	logger := klog.FromContext(ctx)
+	base, err := kl.GetCachedMachineInfo()
+	if err != nil || base == nil {
+		return
+	}
+	disableFile := filepath.Join(kl.getRootDir(), machineResourcesDisableFile)
+	// log only on state change
+	disabled := false
+	var lastCores int
+	var lastMem uint64
+	wait.UntilWithContext(ctx, func(ctx context.Context) {
+		if _, err := os.Stat(disableFile); err == nil {
+			if !disabled {
+				disabled = true
+				logger.Info("Kubelet restart on machine resources growth disabled", "file", disableFile)
+			}
+			return
+		}
+		if disabled {
+			disabled = false
+			logger.Info("Kubelet restart on machine resources growth enabled", "file", disableFile)
+		}
+		cur, err := kl.cadvisor.MachineInfo(logger)
+		if err != nil {
+			return
+		}
+		switch {
+		case machineResourcesShrunk(base, cur):
+			if cur.NumCores != lastCores || cur.MemoryCapacity != lastMem {
+				lastCores, lastMem = cur.NumCores, cur.MemoryCapacity
+				logger.Info("Skipping kubelet restart: machine resources decreased",
+					"cpusBefore", base.NumCores, "cpusNow", cur.NumCores,
+					"memoryBefore", base.MemoryCapacity, "memoryNow", cur.MemoryCapacity)
+			}
+		case !machineResourcesGrew(base, cur):
+			lastCores, lastMem = 0, 0
+		default:
+			logger.Info("Restarting kubelet: machine resources grew",
+				"cpusBefore", base.NumCores, "cpusNow", cur.NumCores,
+				"memoryBefore", base.MemoryCapacity, "memoryNow", cur.MemoryCapacity)
+			klog.FlushAndExit(klog.ExitFlushTimeout, machineResourcesExitCode)
+		}
+	}, machineResourcesCheckInterval)
+}
+
+func machineResourcesShrunk(base, cur *cadvisorapi.MachineInfo) bool {
+	return cur.NumCores < base.NumCores || cur.MemoryCapacity < base.MemoryCapacity
+}
+
+func machineResourcesGrew(base, cur *cadvisorapi.MachineInfo) bool {
+	return cur.NumCores > base.NumCores || cur.MemoryCapacity >= base.MemoryCapacity+machineResourcesMemoryThreshold
+}
