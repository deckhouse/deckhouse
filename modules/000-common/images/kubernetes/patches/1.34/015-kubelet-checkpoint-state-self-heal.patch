+func TestStartHealsChangedZoneCount(t *testing.T) {
+	// A VM migrated to a host with a different memory map, or an NPS change in
+	// firmware: the checkpoint describes zones that no longer exist.
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	_, tCtx := ktesting.NewTestContext(t)
+	f := newSelfHealFixture(t, twoZoneMachine(), twoZoneReserved(), containermap.NewContainerMap())
+
+	fourZones := &cadvisorapi.MachineInfo{
+		Topology: []cadvisorapi.Node{
+			{Id: 0, Memory: 2 * gib}, {Id: 1, Memory: 2 * gib},
+			{Id: 2, Memory: 2 * gib}, {Id: 3, Memory: 2 * gib},
+		},
+	}
+	stale := newSelfHealFixture(t, fourZones, systemReservedMemory{
+		0: map[v1.ResourceName]uint64{v1.ResourceMemory: 256 * mib},
+		1: map[v1.ResourceName]uint64{v1.ResourceMemory: 256 * mib},
+		2: map[v1.ResourceName]uint64{v1.ResourceMemory: 256 * mib},
+		3: map[v1.ResourceName]uint64{v1.ResourceMemory: 256 * mib},
+	}, containermap.NewContainerMap())
+
+	seedCheckpoint(t, f.manager.stateFileDirectory, f.policy.Name(), stale.policy.getDefaultMachineState(), nil)
+
+	if err := f.manager.Start(tCtx, func() []*v1.Pod { return nil }, &sourcesReadyStub{},
+		mockPodStatusProvider{}, mockRuntimeService{}, containermap.NewContainerMap()); err != nil {
+		t.Fatalf("Start returned %v, want nil", err)
+	}
+
+	if got := checkpointselfheal.Pending(); got != 1 {
+		t.Fatalf("recorded %d resets, want 1", got)
+	}
+	if got := len(f.manager.state.GetMachineState()); got != 2 {
+		t.Errorf("machine state describes %d zones, want 2 (the machine we actually have)", got)
+	}
+}
