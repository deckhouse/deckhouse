index 00000000000..88976866c56
--- /dev/null
+++ b/pkg/kubelet/cm/checkpointselfheal/checkpoint.go
@@ -0,0 +1,109 @@
+/*
+Copyright 2026 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package checkpointselfheal
+
+import (
+	"k8s.io/klog/v2"
+	"k8s.io/kubernetes/pkg/kubelet/checkpointmanager"
+	cpustate "k8s.io/kubernetes/pkg/kubelet/cm/cpumanager/state"
+	memorystate "k8s.io/kubernetes/pkg/kubelet/cm/memorymanager/state"
+)
+
+// inspectCheckpoint reports the policy that wrote a manager's checkpoint and
+// the containers it holds assignments for, reading it with that manager's own
+// checkpoint type through upstream's own reader.
+//
+// # Why the error is discarded
+//
+// checkpointmanager.GetCheckpoint unmarshals the file first and verifies the
+// checksum afterwards, so a checkpoint that fails verification is already fully
+// populated by the time the error comes back. That is the property this relies
+// on, and upstream relies on it too: restoreState resets its own struct "back
+// to 0" after a failed read precisely because the failed read left data in it.
+//
+// Reading past the failure is the entire point. The file is about to be
+// deleted, and its contents are the only record of which containers hold
+// assignments. A file that cannot be decoded at all yields no refs, which
+// degrades to "reset without naming victims" rather than to an error.
+//
+// # Why upstream's types instead of our own
+//
+// The on-disk format is versioned and has changed more than once: the CPU
+// manager has had a v1 (entries keyed by container id), a v2 (keyed by pod UID
+// and container name) and, with the pod-level resource managers gate in 1.36, a
+// v3 that adds podEntries; the memory manager has had two. Parsing that by hand
+// would mean re-checking the format on every rebase, and getting it wrong would
+// be silent -- a struct that no longer matches simply yields no victims, and
+// nothing would be stopped.
+//
+// CPUManagerCheckpoint and MemoryManagerCheckpoint always name the *current*
+// format on every branch (in 1.34 CPUManagerCheckpointV2 is an alias of
+// CPUManagerCheckpoint; in 1.36 CPUManagerCheckpoint became the v3 shape and V2
+// was demoted to its own type). So this one source file works unchanged across
+// 1.32 through 1.36, and if a future release reshapes the format, the build
+// breaks here instead of the patch quietly doing nothing.
+//
+// Only PolicyName and Entries are read, and both have been stable across every
+// format so far. Pod-level assignments (podEntries, 1.36, alpha and off by
+// default) are deliberately not read: the field does not exist on the older
+// branches, so touching it would fork this file per version for a feature that
+// is not enabled.
+func inspectCheckpoint(manager ManagerName, stateDir, checkpointName string) (policyName string, refs []ContainerRef) {
+	mgr, err := checkpointmanager.NewCheckpointManager(stateDir)
+	if err != nil {
+		klog.V(2).InfoS(LogMarker+" could not open the checkpoint directory for inspection",
+			"manager", manager, "stateDir", stateDir, "err", err)
+		debug("checkpoint directory could not be opened",
+			"manager", manager, "stateDir", stateDir, "err", err)
+		return "", nil
+	}
+
+	switch manager {
+	case ManagerCPU:
+		cp := cpustate.NewCPUManagerCheckpoint()
+		readErr := mgr.GetCheckpoint(checkpointName, cp)
+		debug("cpu checkpoint read",
+			"stateDir", stateDir, "checkpointName", checkpointName,
+			"policyName", cp.PolicyName, "defaultCPUSet", cp.DefaultCPUSet,
+			"pods", len(cp.Entries), "readErr", readErr)
+		return cp.PolicyName, refsFromEntries(cp.Entries)
+
+	case ManagerMemory:
+		cp := memorystate.NewMemoryManagerCheckpoint()
+		readErr := mgr.GetCheckpoint(checkpointName, cp)
+		debug("memory checkpoint read",
+			"stateDir", stateDir, "checkpointName", checkpointName,
+			"policyName", cp.PolicyName, "numaNodes", len(cp.MachineState),
+			"pods", len(cp.Entries), "readErr", readErr)
+		return cp.PolicyName, refsFromEntries(cp.Entries)
+	}
+
+	klog.ErrorS(nil, LogMarker+" no checkpoint reader for manager", "manager", manager)
+	return "", nil
+}
+
+// refsFromEntries is RefsFrom with a debug line, so that the mapping from the
+// file's contents to the refs it produced is visible while this is being
+// checked on a cluster.
+func refsFromEntries[T any](entries map[string]map[string]T) []ContainerRef {
+	refs := RefsFrom(entries)
+	for _, ref := range refs {
+		debug("checkpoint holds an assignment",
+			"podUID", ref.PodUID, "containerName", ref.ContainerName)
+	}
+	return refs
+}
