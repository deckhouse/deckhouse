+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package checkpointselfheal
+
+import (
+	"context"
+	"path/filepath"
+	"sync"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/tools/record"
+	internalapi "k8s.io/cri-api/pkg/apis"
+	runtimeapi "k8s.io/cri-api/pkg/apis/runtime/v1"
+	"k8s.io/klog/v2"
+	kubelettypes "k8s.io/kubelet/pkg/types"
+)
+
+const (
+	// stopGracePeriodSeconds is handed to the runtime as the graceful stop
+	// timeout. Pod specs are not available this early, so each pod's own
+	// terminationGracePeriodSeconds cannot be honoured and a single value has
+	// to serve. It is kept short on purpose: kubelet start is blocked while
+	// this runs, and every second spent here is a second in which the node is
+	// not reconciling anything.
+	stopGracePeriodSeconds = int64(15)
+
+	// stopDeadline bounds the whole operation. Containers are stopped in
+	// parallel, so this is roughly the grace period plus runtime overhead
+	// rather than a per-container budget. Exceeding it is reported loudly:
+	// a victim left running still holds CPUs or a NUMA zone the state now
+	// thinks are free.
+	stopDeadline = 30 * time.Second
+
+	// eventReason is used for the pod events emitted for stopped containers.
+	// Without it the restart is indistinguishable from an ordinary container
+	// crash in kubectl describe.
+	eventReason = "NUMACheckpointReset"
+)
+
+// Deps is what the stopper needs from the container manager. Both fields are
+// already present at the call site, so wiring this in adds no plumbing.
+type Deps struct {
+	// Runtime is the CRI runtime service. It is used to list containers (to
+	// learn which victims are actually running and which pod they belong to)
+	// and to stop them.
+	Runtime internalapi.RuntimeService
+
+	// Recorder emits pod events. May be nil in standalone mode, in which case
+	// the metric and the log remain.
+	Recorder record.EventRecorder
+}
+
+// StopVictims stops the containers whose assignments were dropped by a reset,
+// so that the kubelet lifecycle recreates them and the managers pin them again
+// from a clean state.
+//
+// It must be called from containerManagerImpl.Start, before Start returns:
+// kubelet marks the runtime synced only afterwards and syncLoop skips every
+// iteration until then, so nothing can be admitted while this runs. That is
+// what keeps a freshly admitted Guaranteed pod from being handed CPUs that a
+// victim is still using.
+//
+// It is a no-op when nothing was reset, which is the overwhelmingly common
+// case, and it never returns an error: by the time it runs, the state has
+// already been reset, so there is nothing a caller could usefully do besides
+// what is already being logged and counted.
+func StopVictims(ctx context.Context, deps Deps) {
+	records := Take()
+	if len(records) == 0 {
+		return
+	}
+
+	klog.InfoS(LogMarker+" bringing containers in line with the reset state",
+		"resets", len(records), "patchVersion", Version)
+	debug("stop phase starting",
+		"resets", len(records), "gracePeriodSeconds", stopGracePeriodSeconds,
+		"deadline", stopDeadline, "hasRuntime", deps.Runtime != nil,
+		"hasRecorder", deps.Recorder != nil)
+	for i := range records {
+		debug("reset to act on",
+			"index", i, "manager", records[i].Manager, "reason", records[i].Reason,
+			"stateFile", records[i].StateFile, "victims", len(records[i].Victims),
+			"cause", records[i].Cause)
+	}
+
+	stateDir := markerDir(records)
+
+	if deps.Runtime == nil {
+		// Nothing can be stopped without a runtime. Say so plainly and still
+		// leave the marker: the operator needs to know the node is in this
+		// state even though we could do nothing about it.
+		for i := range records {
+			for j := range records[i].Victims {
+				records[i].Victims[j].Error = "no runtime service available"
+				stopFailuresTotal.WithLabelValues(string(records[i].Manager)).Inc()
+			}
+		}
+		klog.ErrorS(nil, LogMarker+" no runtime service, victims left running")
+		writeMarker(stateDir, records)
+		return
+	}
+
+	running, meta, live := inspectRuntime(ctx, deps.Runtime)
+
+	stopCtx, cancel := context.WithTimeout(ctx, stopDeadline)
+	defer cancel()
+
+	tracker := newStopTracker()
+	for i := range records {
+		stopRecord(stopCtx, deps, &records[i], running, meta, live, tracker)
+	}
+
+	writeMarker(stateDir, records)
+
+	klog.InfoS(LogMarker+" finished, kubelet start continues", "resets", len(records))
+	debug("stop phase finished", "resets", len(records))
+}
+
+// podMeta is the pod identity carried in CRI container labels. The managers key
+// assignments by pod UID only, so the name and namespace have to come from the
+// runtime -- the API is not necessarily reachable this early, and the pod specs
+// certainly are not loaded yet.
+type podMeta struct {
+	name      string
+	namespace string
+}
+
+// stopTracker makes sure a container is stopped once per run even when it is a
+// victim of more than one manager.
+//
+// Both managers can lose the same container's assignment in the same start --
+// a corrupt checkpoint on each, or a policy change that invalidates both. Each
+// reset legitimately records the container as its victim, but the container
+// itself must be stopped only once: a second StopContainer is a no-op at the
+// runtime, yet it still counted a stop and emitted a second pod event, so
+// summing stopped_containers_total across managers reported two containers
+// where one had been restarted.
+type stopTracker struct {
+	mu    sync.Mutex
+	owner map[string]ManagerName
+}
+
+func newStopTracker() *stopTracker {
+	return &stopTracker{owner: map[string]ManagerName{}}
+}
+
+// claim reserves a container for stopping. It reports the manager that already
+// claimed it, and whether this caller got the claim.
+func (t *stopTracker) claim(containerID string, manager ManagerName) (ManagerName, bool) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if prev, taken := t.owner[containerID]; taken {
+		return prev, false
+	}
+	t.owner[containerID] = manager
+	return manager, true
+}
+
+// containerRef keys a container the way the managers key their assignments.
+type containerRef struct {
+	podUID        string
+	containerName string
+}
+
+// inspectRuntime returns the set of container ids the runtime reports as
+// running, the pod identity for each container it knows about, and an index
+// from assignment key to the *running* container for that key.
+//
+// The running set is what enforces "victims are only containers that are really
+// running": an assignment left over for a container that has already exited but
+// has not been garbage collected yet must not produce a spurious stop.
+//
+// The index exists because containerMap holds a single container id per
+// (pod, container name) pair while the runtime can report several -- a
+// recreated container leaves its predecessor behind until garbage collection,
+// and which of the two ends up in containerMap depends on the order
+// ListContainers happened to return them. Trusting that order means sometimes
+// aiming at a container that has already exited and leaving the live one
+// running with an assignment that no longer exists in the state.
+func inspectRuntime(ctx context.Context, runtime internalapi.RuntimeService) (map[string]bool, map[string]podMeta, map[containerRef]string) {
+	running := map[string]bool{}
+	meta := map[string]podMeta{}
+	live := map[containerRef]string{}
+
+	containers, err := runtime.ListContainers(ctx, nil)
+	if err != nil {
+		// Without the listing we cannot tell running from exited. Stopping an
+		// already-exited container is harmless, while skipping a running one
+		// leaves the isolation broken, so on error we treat every victim as
+		// running and let the runtime reject the ones that are already gone.
+		klog.ErrorS(err, LogMarker+" could not list containers, will attempt to stop every victim")
+		return nil, meta, live
+	}
+
+	for _, c := range containers {
+		if c.State == runtimeapi.ContainerState_CONTAINER_RUNNING {
+			running[c.Id] = true
+		}
+		meta[c.Id] = podMeta{
+			name:      c.Labels[kubelettypes.KubernetesPodNameLabel],
+			namespace: c.Labels[kubelettypes.KubernetesPodNamespaceLabel],
+		}
+		if c.State == runtimeapi.ContainerState_CONTAINER_RUNNING {
+			key := containerRef{
+				podUID:        c.Labels[kubelettypes.KubernetesPodUIDLabel],
+				containerName: c.GetMetadata().GetName(),
+			}
+			if key.podUID != "" && key.containerName != "" {
+				live[key] = c.Id
+			}
+		}
+		// This is the snapshot that explains every "not running, skipped"
+		// decision below, which is otherwise impossible to second-guess.
+		debug("runtime reported a container",
+			"containerID", c.Id, "state", c.State,
+			"containerName", c.GetMetadata().GetName(),
+			"pod", c.Labels[kubelettypes.KubernetesPodNameLabel],
+			"namespace", c.Labels[kubelettypes.KubernetesPodNamespaceLabel])
+	}
+	debug("runtime snapshot complete",
+		"containers", len(containers), "running", len(running), "liveByAssignment", len(live))
+	return running, meta, live
+}
+
+func stopRecord(ctx context.Context, deps Deps, rec *ResetRecord, running map[string]bool, meta map[string]podMeta, live map[containerRef]string, tracker *stopTracker) {
+	manager := string(rec.Manager)
+
+	var wg sync.WaitGroup
+	for i := range rec.Victims {
+		victim := &rec.Victims[i]
+
+		// The id that came out of containerMap can belong to a container that
+		// has already been replaced: the map keeps one id per (pod, container
+		// name) and the runtime reports both the old and the new one. Aim at
+		// the container that is actually running for this assignment, so that
+		// a recreated container is not skipped while it still holds the CPUs
+		// or the NUMA zone the state has just given up.
+		if id, ok := live[containerRef{podUID: victim.PodUID, containerName: victim.ContainerName}]; ok && id != victim.ContainerID {
+			klog.InfoS(LogMarker+" retargeting victim to the running container for this assignment",
+				"manager", manager, "podUID", victim.PodUID, "containerName", victim.ContainerName,
+				"fromContainerID", victim.ContainerID, "toContainerID", id)
+			victim.SupersededID = victim.ContainerID
+			victim.ContainerID = id
+		}
+
+		if m, ok := meta[victim.ContainerID]; ok {
+			victim.PodName = m.name
+			victim.PodNamespace = m.namespace
+		}
+
+		// running == nil means the listing failed and we deliberately try
+		// everything; see inspectRuntime.
+		if running != nil && !running[victim.ContainerID] {
+			debug("victim skipped",
+				"manager", manager, "containerID", victim.ContainerID,
+				"inRunningSet", running[victim.ContainerID], "runtimeListingUsable", running != nil)
+			victim.Skipped = "container not running"
+			klog.InfoS(LogMarker+" victim is not running, nothing to stop",
+				"manager", manager, "podUID", victim.PodUID,
+				"containerName", victim.ContainerName, "containerID", victim.ContainerID)
+			continue
+		}
+
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			stopOne(ctx, deps, rec.Manager, rec.Reason, victim, tracker)
+		}()
+	}
+	wg.Wait()
+}
+
+func stopOne(ctx context.Context, deps Deps, manager ManagerName, reason Reason, victim *Victim, tracker *stopTracker) {
+	if owner, claimed := tracker.claim(victim.ContainerID, manager); !claimed {
+		// Another manager already stopped this container in this run. Recording
+		// it as a victim here is still correct -- this manager did lose its
+		// assignment -- but stopping, counting and reporting it again would
+		// describe one restart as two.
+		victim.Skipped = "already stopped for the " + string(owner) + " manager"
+		klog.InfoS(LogMarker+" victim already stopped for another manager, not stopping again",
+			"manager", manager, "stoppedBy", owner,
+			"pod", klog.KRef(victim.PodNamespace, victim.PodName),
+			"podUID", victim.PodUID, "containerName", victim.ContainerName,
+			"containerID", victim.ContainerID)
+		return
+	}
+
+	klog.InfoS(LogMarker+" stopping container so it is recreated and pinned again",
+		"manager", manager, "reason", reason,
+		"pod", klog.KRef(victim.PodNamespace, victim.PodName), "podUID", victim.PodUID,
+		"containerName", victim.ContainerName, "containerID", victim.ContainerID,
+		"gracePeriodSeconds", stopGracePeriodSeconds)
+
+	started := time.Now()
+	debug("calling StopContainer",
+		"manager", manager, "containerID", victim.ContainerID,
+		"gracePeriodSeconds", stopGracePeriodSeconds)
+
+	if err := deps.Runtime.StopContainer(ctx, victim.ContainerID, stopGracePeriodSeconds); err != nil {
+		debug("StopContainer returned an error",
+			"manager", manager, "containerID", victim.ContainerID,
+			"took", time.Since(started), "err", err)
+		victim.Error = err.Error()
+		stopFailuresTotal.WithLabelValues(string(manager)).Inc()
+		klog.ErrorS(err, LogMarker+" failed to stop container, it may still hold CPUs or a NUMA zone the state considers free",
+			"manager", manager, "pod", klog.KRef(victim.PodNamespace, victim.PodName),
+			"podUID", victim.PodUID, "containerName", victim.ContainerName,
+			"containerID", victim.ContainerID)
+		return
+	}
+
+	victim.Stopped = true
+	stoppedContainersTotal.WithLabelValues(string(manager)).Inc()
+	debug("StopContainer succeeded",
+		"manager", manager, "containerID", victim.ContainerID, "took", time.Since(started))
+	klog.InfoS(LogMarker+" container stopped",
+		"manager", manager, "pod", klog.KRef(victim.PodNamespace, victim.PodName),
+		"podUID", victim.PodUID, "containerName", victim.ContainerName,
+		"containerID", victim.ContainerID)
+
+	emitEvent(deps.Recorder, manager, reason, victim)
+}
+
+// emitEvent puts the reason on the pod itself. Without it the restart looks
+// like an ordinary container crash to whoever runs kubectl describe, and the
+// one piece of information they need -- that the kubelet did this on purpose,
+// and why -- is only in the node's journal.
+//
+// The reference is built by hand because the pod object is not available yet.
+// Name and namespace come from the runtime labels; if they are missing the
+// event would attach to nothing useful, so it is skipped and the log stands.
+func emitEvent(recorder record.EventRecorder, manager ManagerName, reason Reason, victim *Victim) {
+	if recorder == nil || victim.PodName == "" || victim.PodNamespace == "" {
+		return
+	}
+	ref := &v1.ObjectReference{
+		Kind:      "Pod",
+		Name:      victim.PodName,
+		Namespace: victim.PodNamespace,
+		UID:       types.UID(victim.PodUID),
+	}
+	recorder.Eventf(ref, v1.EventTypeWarning, eventReason,
+		"Stopped container %s: the %s manager checkpoint was reset (%s), so the container is recreated to be assigned again",
+		victim.ContainerName, manager, reason)
+}
+
+// markerDir is the directory the marker file goes into: the same directory the
+// manager state files live in, which follows --root-dir.
+func markerDir(records []ResetRecord) string {
+	for _, rec := range records {
+		if rec.StateFile != "" {
+			return filepath.Dir(rec.StateFile)
+		}
+	}
+	return ""
+}
diff --git a/pkg/kubelet/cm/container_manager_linux.go b/pkg/kubelet/cm/container_manager_linux.go
index 64fe7df63b4..145d7897727 100644
--- a/pkg/kubelet/cm/container_manager_linux.go
+++ b/pkg/kubelet/cm/container_manager_linux.go
@@ -50,6 +50,7 @@ import (
 	podresourcesapi "k8s.io/kubelet/pkg/apis/podresources/v1"
 	kubefeatures "k8s.io/kubernetes/pkg/features"
 	"k8s.io/kubernetes/pkg/kubelet/cadvisor"
+	"k8s.io/kubernetes/pkg/kubelet/cm/checkpointselfheal"
 	"k8s.io/kubernetes/pkg/kubelet/cm/cpumanager"
