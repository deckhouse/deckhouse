+// cpuCheckpoint is the on-disk shape of a v2 CPU manager checkpoint. It is
+// written out by hand rather than through the state package so that the tests
+// exercise the same thing production does: reading a file somebody else wrote,
+// possibly with a checksum that no longer matches.
+const cpuCheckpoint = `{
+  "policyName": "static",
+  "defaultCpuSet": "0-1",
+  "entries": {
+    "pod-a": {"app": "2-3"},
+    "pod-b": {"app": "4", "sidecar": "5"}
+  },
+  "checksum": 1
+}`
+
+const memoryCheckpoint = `{
+  "policyName": "Static",
+  "machineState": {},
+  "entries": {
+    "pod-a": {"app": [{"numaAffinity": [0], "type": "memory", "size": 1024}]}
+  },
+  "checksum": 1
+}`
+
+func writeFile(t *testing.T, dir, name, content string) string {
+	t.Helper()
+	path := filepath.Join(dir, name)
+	if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+		t.Fatalf("writing %s: %v", path, err)
+	}
+	return path
+}
+
+func TestInspectCheckpoint(t *testing.T) {
+	// The checksum in every fixture is wrong on purpose. Reading anyway is the
+	// whole point: checkpointmanager.GetCheckpoint unmarshals before it
+	// verifies, so the struct is populated by the time the error comes back,
+	// and the file is the only record of which containers hold assignments
+	// before it is deleted.
+	testCases := []struct {
+		name       string
+		manager    ManagerName
+		fileName   string
+		content    string
+		absent     bool
+		wantPolicy string
+		wantRefs   []ContainerRef
+	}{
+		{
+			name:       "cpu checkpoint yields policy and every assignment",
+			manager:    ManagerCPU,
+			fileName:   "cpu_manager_state",
+			content:    cpuCheckpoint,
+			wantPolicy: "static",
+			wantRefs: []ContainerRef{
+				{PodUID: "pod-a", ContainerName: "app"},
+				{PodUID: "pod-b", ContainerName: "app"},
+				{PodUID: "pod-b", ContainerName: "sidecar"},
+			},
+		},
+		{
+			name:       "memory checkpoint yields policy and assignments",
+			manager:    ManagerMemory,
+			fileName:   "memory_manager_state",
+			content:    memoryCheckpoint,
+			wantPolicy: "Static",
+			wantRefs:   []ContainerRef{{PodUID: "pod-a", ContainerName: "app"}},
+		},
+		{
+			name:       "truncated file yields nothing rather than an error",
+			manager:    ManagerCPU,
+			fileName:   "cpu_manager_state",
+			content:    `{"policyName":"static","entries":{"pod-a"`,
+			wantPolicy: "",
+			wantRefs:   nil,
+		},
+		{
+			// A v1 CPU checkpoint keys entries by container id, so it does not
+			// fit the current type. It predates 1.13 and carries no pod UIDs to
+			// recover, so degrading to "reset without naming victims" is the
+			// only thing left to do.
+			name:       "v1 style flat entries yield no assignments",
+			manager:    ManagerCPU,
+			fileName:   "cpu_manager_state",
+			content:    `{"policyName":"static","defaultCpuSet":"0","entries":{"containerid":"1-2"}}`,
+			wantPolicy: "static",
+			wantRefs:   nil,
+		},
+		{
+			name:       "missing file yields nothing",
+			manager:    ManagerCPU,
+			fileName:   "cpu_manager_state",
+			absent:     true,
+			wantPolicy: "",
+			wantRefs:   nil,
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			if !tc.absent {
+				writeFile(t, dir, tc.fileName, tc.content)
+			}
+
+			policy, refs := inspectCheckpoint(tc.manager, dir, tc.fileName)
+			if policy != tc.wantPolicy {
+				t.Errorf("policy: got %q, want %q", policy, tc.wantPolicy)
+			}
+			if len(refs) != len(tc.wantRefs) {
+				t.Fatalf("refs: got %v, want %v", refs, tc.wantRefs)
+			}
+			for i := range refs {
+				if refs[i] != tc.wantRefs[i] {
+					t.Errorf("refs[%d]: got %v, want %v", i, refs[i], tc.wantRefs[i])
+				}
+			}
+		})
+	}
+}
