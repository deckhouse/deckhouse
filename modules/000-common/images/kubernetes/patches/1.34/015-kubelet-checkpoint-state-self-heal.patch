+func TestResetAndStopEndToEnd(t *testing.T) {
+	// The whole flow over a checkpoint that belongs to another policy: read it
+	// past the load that upstream refuses, name the victim, remove the file,
+	// stop the container and leave a marker behind.
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+	writeFile(t, dir, "cpu_manager_state", cpuCheckpoint)
+
+	cm := containermap.NewContainerMap()
+	cm.Add("pod-a", "app", "cid-a")
+
+	runtime := apitest.NewFakeRuntimeService()
+	runtime.Containers = map[string]*apitest.FakeContainer{
+		"cid-a": fakeContainerForPod("cid-a", "pod-a", "pod-a", "ns", runtimeapi.ContainerState_CONTAINER_RUNNING),
+	}
+
+	if ok := ResetCheckpointFile(ManagerCPU, dir, "cpu_manager_state", "none", errors.New("boom")); !ok {
+		t.Fatal("ResetCheckpointFile reported failure")
+	}
+	StopVictims(context.Background(), Deps{Runtime: runtime})
+
+	if got := runtime.Containers["cid-a"].State; got != runtimeapi.ContainerState_CONTAINER_EXITED {
+		t.Errorf("victim state: got %v, want EXITED", got)
+	}
+	marker := readMarker(t, dir)
+	if len(marker.Resets) != 1 {
+		t.Fatalf("marker: %+v", marker)
+	}
+	if marker.Resets[0].Reason != ReasonPolicyMismatch {
+		t.Errorf("reason: got %q, want %q", marker.Resets[0].Reason, ReasonPolicyMismatch)
+	}
+	// All three assignments in the file are recorded; only pod-a has a
+	// container to stop, and the marker says so for each of them.
+	byRef := map[ContainerRef]Victim{}
+	for _, v := range marker.Resets[0].Victims {
+		byRef[ContainerRef{PodUID: v.PodUID, ContainerName: v.ContainerName}] = v
+	}
+	if len(byRef) != 3 {
+		t.Fatalf("victims: %+v, want all three assignments", marker.Resets[0].Victims)
+	}
+	if v := byRef[ContainerRef{PodUID: "pod-a", ContainerName: "app"}]; !v.Stopped || v.ContainerID != "cid-a" {
+		t.Errorf("pod-a victim: %+v, want stopped cid-a", v)
+	}
+	for _, ref := range []ContainerRef{{PodUID: "pod-b", ContainerName: "app"}, {PodUID: "pod-b", ContainerName: "sidecar"}} {
+		if v := byRef[ref]; v.Stopped || v.Skipped == "" {
+			t.Errorf("%v victim: %+v, want skipped and not stopped", ref, v)
+		}
+	}
+}
