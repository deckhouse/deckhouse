+// TestInspectCheckpointUsesUpstreamTypes guards the reason this reader is built
+// the way it is. If a future release reshapes the on-disk format, the intent is
+// that the build breaks rather than this silently returning no victims -- so
+// the types below are the upstream ones on purpose, and this test fails to
+// compile if they stop existing.
+func TestInspectCheckpointUsesUpstreamTypes(t *testing.T) {
+	var (
+		_ = cpustate.NewCPUManagerCheckpoint().Entries
+		_ = memorystate.NewMemoryManagerCheckpoint().Entries
+	)
+}
