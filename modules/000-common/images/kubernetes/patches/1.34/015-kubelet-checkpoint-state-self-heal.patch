+// fakeContainerForPod builds a running or exited container as the runtime would
+// report it. The pod UID label matters: it is half of the key the stopper
+// resolves an assignment by. The name and namespace labels are what the stopper
+// reads to name the pod in the log, the marker and the event.
+func fakeContainerForPod(id, podUID, podName, podNamespace string, state runtimeapi.ContainerState) *apitest.FakeContainer {
+	c := &apitest.FakeContainer{SandboxID: "sandbox-" + id}
+	c.Id = id
+	c.State = state
+	c.Metadata = &runtimeapi.ContainerMetadata{Name: "app"}
+	c.Labels = map[string]string{
+		kubelettypes.KubernetesPodUIDLabel:       podUID,
+		kubelettypes.KubernetesPodNameLabel:      podName,
+		kubelettypes.KubernetesPodNamespaceLabel: podNamespace,
+	}
+	return c
+}
