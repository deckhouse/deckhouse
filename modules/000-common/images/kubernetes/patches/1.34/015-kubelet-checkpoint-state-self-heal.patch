+func TestRefsFromIsDeterministic(t *testing.T) {
+	// Map iteration order is random, so without sorting the marker file and the
+	// logs would differ between runs for identical input, which makes them
+	// useless for comparing two nodes.
+	assignments := map[string]map[string]string{
+		"pod-b": {"z": "", "a": ""},
+		"pod-a": {"app": ""},
+	}
+	want := []ContainerRef{
+		{PodUID: "pod-a", ContainerName: "app"},
+		{PodUID: "pod-b", ContainerName: "a"},
+		{PodUID: "pod-b", ContainerName: "z"},
+	}
+	for i := 0; i < 20; i++ {
+		got := RefsFrom(assignments)
+		if len(got) != len(want) {
+			t.Fatalf("got %v, want %v", got, want)
+		}
+		for j := range got {
+			if got[j] != want[j] {
+				t.Fatalf("iteration %d: got %v, want %v", i, got, want)
+			}
+		}
+	}
