+func TestResetCheckpointFileClassifiesReason(t *testing.T) {
+	testCases := []struct {
+		name             string
+		content          string
+		configuredPolicy string
+		wantReason       Reason
+		// Every dropped assignment is recorded as a victim; what became of the
+		// container behind it is decided later, by the stopper.
+		wantVictimCount int
+	}{
+		{
+			// The file is perfectly readable; it just belongs to another
+			// policy. That is an operator action, not a broken node, and it is
+			// detected by comparing policy names rather than by matching error
+			// text.
+			name:             "policy name differs",
+			content:          cpuCheckpoint,
+			configuredPolicy: "none",
+			wantReason:       ReasonPolicyMismatch,
+			wantVictimCount:  3,
+		},
+		{
+			name:             "same policy, so the file itself is the problem",
+			content:          cpuCheckpoint,
+			configuredPolicy: "static",
+			wantReason:       ReasonCheckpointCorrupt,
+			wantVictimCount:  3,
+		},
+		{
+			name:             "unreadable file cannot be classified further",
+			content:          "{{{",
+			configuredPolicy: "static",
+			wantReason:       ReasonCheckpointCorrupt,
+			wantVictimCount:  0,
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			Clear()
+			t.Cleanup(Clear)
+
+			dir := t.TempDir()
+			path := writeFile(t, dir, "cpu_manager_state", tc.content)
+
+			if ok := ResetCheckpointFile(ManagerCPU, dir, "cpu_manager_state", tc.configuredPolicy, errors.New("boom")); !ok {
+				t.Fatal("ResetCheckpointFile reported failure, want success")
+			}
+			if _, err := os.Stat(path); !os.IsNotExist(err) {
+				t.Errorf("checkpoint still present after reset (stat err %v)", err)
+			}
+
+			records := Take()
+			if len(records) != 1 {
+				t.Fatalf("recorded %d resets, want 1", len(records))
+			}
+			if records[0].Reason != tc.wantReason {
+				t.Errorf("reason: got %q, want %q", records[0].Reason, tc.wantReason)
+			}
+			if records[0].Manager != ManagerCPU {
+				t.Errorf("manager: got %q, want %q", records[0].Manager, ManagerCPU)
+			}
+			if records[0].Cause != "boom" {
+				t.Errorf("cause: got %q, want %q", records[0].Cause, "boom")
+			}
+			// cpuCheckpoint holds three assignments, and all three are lost.
+			if len(records[0].Victims) != tc.wantVictimCount {
+				t.Errorf("victims: got %d (%v), want %d", len(records[0].Victims), records[0].Victims, tc.wantVictimCount)
+			}
+		})
+	}
+}
