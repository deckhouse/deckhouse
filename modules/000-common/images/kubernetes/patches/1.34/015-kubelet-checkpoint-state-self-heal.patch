 	"k8s.io/kubernetes/pkg/kubelet/cm/dra"
@@ -631,6 +632,18 @@ func (cm *containerManagerImpl) Start(ctx context.Context, node *v1.Node,
 		return fmt.Errorf("start memory manager error: %w", err)
 	}
 
+	// If either manager had to reset its checkpoint above, the containers that
+	// held assignments in it are still running with CPUs and memory zones that
+	// the fresh state considers free. Stop them here, synchronously, while
+	// nothing can be admitted: kubelet marks the runtime synced only after this
+	// function returns, and syncLoop skips every iteration until it does. Doing
+	// it after Start returns would leave a window in which a new Guaranteed pod
+	// could be handed CPUs another container is still using.
+	checkpointselfheal.StopVictims(ctx, checkpointselfheal.Deps{
+		Runtime:  runtimeService,
+		Recorder: cm.recorder,
+	})
+
 	// cache the node Info including resource capacity and
 	// allocatable of the node
 	cm.nodeInfo = node
