+func TestStopVictimsPicksTheRunningContainerWhenAPairHasSeveral(t *testing.T) {
+	// Found on a cluster: after one heal the pod's container is recreated, so
+	// the runtime reports two containers for the same (pod, container name) --
+	// the exited predecessor and the live replacement. An assignment key with
+	// several containers is the one ambiguity there is, and the running one has
+	// to win: it is the container physically holding the CPUs and the NUMA zone
+	// the state has just released, so skipping it as "not running" would leave
+	// exactly the divergence being repaired.
+	//
+	// This used to be a correction rather than a choice. The victim was
+	// resolved while the managers were still starting, by asking containermap
+	// for the container of a pair -- a map keyed by container id, walked until
+	// the first match, so with two candidates it answered at random -- and the
+	// wrong answer was then retargeted in the stop phase. Now the resolution
+	// happens once, from the runtime snapshot, in the direction where the
+	// answer is unique.
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+
+	const podUID = "pod-recreated"
+	runtime := apitest.NewFakeRuntimeService()
+	runtime.Containers = map[string]*apitest.FakeContainer{
+		"cid-old": fakeContainerForPod("cid-old", podUID, "numa-pinned", "default", runtimeapi.ContainerState_CONTAINER_EXITED),
+		"cid-new": fakeContainerForPod("cid-new", podUID, "numa-pinned", "default", runtimeapi.ContainerState_CONTAINER_RUNNING),
+	}
+
+	RecordStateReset(ManagerCPU, dir, "cpu_manager_state",
+		[]ContainerRef{{PodUID: podUID, ContainerName: "app"}}, errors.New("checkpoint is corrupted"))
+
+	StopVictims(context.Background(), Deps{Runtime: runtime})
+
+	if got := runtime.Containers["cid-new"].State; got != runtimeapi.ContainerState_CONTAINER_EXITED {
+		t.Errorf("live container was not stopped, state %v", got)
+	}
+
+	victims := readMarker(t, dir).Resets[0].Victims
+	if len(victims) != 1 {
+		t.Fatalf("victims: %+v", victims)
+	}
+	v := victims[0]
+	if v.ContainerID != "cid-new" {
+		t.Errorf("victim aimed at %q, want the running container cid-new", v.ContainerID)
+	}
+	if !v.Stopped || v.Error != "" {
+		t.Errorf("victim: %+v, want stopped without error", v)
+	}
+}
