+// cpuCheckpoint is the on-disk shape of a v2 CPU manager checkpoint. It is
+// written out by hand rather than through the state package so that the tests
+// exercise the same thing production does: reading a file somebody else wrote,
+// possibly with a checksum that no longer matches.
+const cpuCheckpoint = `{
+  "policyName": "static",
+  "defaultCpuSet": "0-1",
+  "entries": {
+    "pod-a": {"app": "2-3"},
+    "pod-b": {"app": "4", "sidecar": "5"}
+  },
+  "checksum": 1
+}`
+
+const memoryCheckpoint = `{
+  "policyName": "Static",
+  "machineState": {},
+  "entries": {
+    "pod-a": {"app": [{"numaAffinity": [0], "type": "memory", "size": 1024}]}
+  },
+  "checksum": 1
+}`
+
+func writeFile(t *testing.T, dir, name, content string) string {
+	t.Helper()
+	path := filepath.Join(dir, name)
+	if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+		t.Fatalf("writing %s: %v", path, err)
+	}
+	return path
+}
