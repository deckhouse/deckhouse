+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package checkpointselfheal
+
+import (
+	"k8s.io/klog/v2"
+)
+
+// TEMPORARY -- bring-up tracing, to be deleted once this patch has been
+// validated on a cluster.
+//
+// There are two tiers of logging, and they answer different questions:
+//
+//   - LogMarker, permanent. Which manager reset what, why, which containers
+//     were stopped, and one line per manager when nothing was wrong. Small
+//     enough to keep in production forever.
+//     grep: journalctl -u kubelet | grep d8-numa-selfheal
+//
+//   - DebugMarker, this file. The evidence behind each of those decisions: what
+//     the checkpoint held before it was deleted, every container the runtime
+//     reported and in what state, the per-victim reasoning, how long each stop
+//     took, the marker file as written.
+//     grep: journalctl -u kubelet | grep d8-numa-selfheal-debug
+//
+// These lines are logged unconditionally, at Info, with no switch to turn them
+// on. That is on purpose: they exist for the period in which this patch is
+// being checked on real nodes, and they get deleted afterwards, so a runtime
+// control for them would be a knob nobody ever turns and one more thing to
+// remove later. Info rather than a V level for the same reason -- a V level
+// only shows up if the whole kubelet is run verbosely, which buries these lines
+// among everything else and makes the tracing useless exactly when it is
+// needed.
+//
+// # How to remove
+//
+//	rm pkg/kubelet/cm/checkpointselfheal/debug.go
+//	grep -rn ebug pkg/kubelet/cm/checkpointselfheal/   # delete every hit
+//
+// Nothing outside this package calls into it, so removal cannot break a caller.
+// The manager state before and after a reset deliberately has no line here:
+// upstream already logs it (state_mem's "Updated default CPUSet" when the
+// checkpoint is restored, and the policy's "Static policy initialized" once it
+// re-runs against the empty state), so duplicating it would mean touching the
+// patched upstream files for no new information.
+
+// DebugMarker prefixes this tier. It contains LogMarker's text, so a grep for
+// the permanent marker still finds these lines too, while a grep for this one
+// finds only them.
+const DebugMarker = "[d8-numa-selfheal-debug]"
+
+// debug logs one line of the temporary tier. Values are passed as key/value
+// pairs rather than interpolated into the message, so the lines stay
+// machine-readable like the rest of the kubelet log.
+func debug(msg string, keysAndValues ...interface{}) {
+	klog.InfoS(DebugMarker+" "+msg, keysAndValues...)
+}
+
+// debugBlob returns a bounded rendering of file content. Checkpoints are small,
+// but a corrupt one can hold anything at all, so the size is capped rather than
+// trusted.
+func debugBlob(blob []byte) string {
+	const limit = 2048
+	if len(blob) <= limit {
+		return string(blob)
+	}
+	return string(blob[:limit]) + "...[truncated]"
+}
diff --git a/pkg/kubelet/cm/checkpointselfheal/doc.go b/pkg/kubelet/cm/checkpointselfheal/doc.go
new file mode 100644
index 00000000000..0747600fe92
--- /dev/null
+++ b/pkg/kubelet/cm/checkpointselfheal/doc.go
@@ -0,0 +1,70 @@
+/*
+Copyright 2026 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// Package checkpointselfheal lets the kubelet start when the CPU manager or the
+// memory manager finds its checkpoint unusable, instead of exiting.
+//
+// Upstream behaviour is to refuse to start: staticPolicy.Start returns an error,
+// containerManagerImpl.Start propagates it and kubelet calls os.Exit(1) from
+// initializeRuntimeDependentModules, relying on the service manager to retry
+// forever. A node in that state needs a human. The causes are ordinary: a minor
+// upgrade that tightened validation, a changed online-CPU set, changed
+// pre-allocated hugepages, a changed NUMA zone count, a torn checkpoint write,
+// or per-NUMA MemTotal drift across reboots (kubernetes/kubernetes#131253).
+//
+// This package implements the other half of the upstream advice ("drain this
+// node and remove the policy state file"): the affected manager drops its
+// state, and the containers whose assignments lived in that state are stopped
+// so that the normal kubelet lifecycle recreates them and the manager pins them
+// again from a clean state. Only the affected manager is touched -- the causes
+// are independent, and memory drifts on its own while CPU only changes on
+// hotplug.
+//
+// # Ordering contract
+//
+// Victims are collected *before* anything is cleared. After a reset there is no
+// place left to read the old assignments from, so the order is part of the
+// contract rather than an implementation detail.
+//
+// # Why the stop is synchronous
+//
+// StopVictims runs inside containerManagerImpl.Start, before it returns. That
+// matters: kubelet marks the runtime synced only after Start returns, and
+// syncLoop skips every iteration while the runtime is not synced, so no pod can
+// be admitted while we are stopping containers. Between clearing the state and
+// stopping the containers there is a window in which CPUs and memory zones look
+// free in the state while still being physically occupied; a Guaranteed pod
+// admitted in that window would be handed CPUs that another container is still
+// using, turning a restored isolation into a lost one for two pods at once.
+// Doing the stop synchronously closes that window by construction instead of
+// relying on the upstream initialisation order staying the way it is today.
+//
+// The cost is paid knowingly: pod specs are not available that early, so
+// preStop hooks do not run and a fixed grace period is used instead of each
+// pod's terminationGracePeriodSeconds, and kubelet start is delayed by at most
+// stopDeadline on this path. Classifying which victims cannot restart
+// themselves (restartPolicy: Never, pods without a controller) also needs the
+// spec, so it is left to the consumer of the marker file rather than guessed
+// here.
+//
+// # Registry
+//
+// The victim registry is package level. That is deliberate: it keeps the change
+// to the upstream managers down to a few lines each with no interface changes
+// and no test fakes to update, which is what makes this patch cheap to rebase.
+// The kubelet is a single process and both managers are singletons, so there is
+// nothing to disambiguate. Tests use Clear.
+package checkpointselfheal
diff --git a/pkg/kubelet/cm/checkpointselfheal/metrics.go b/pkg/kubelet/cm/checkpointselfheal/metrics.go
new file mode 100644
index 00000000000..c6cba65c043
--- /dev/null
+++ b/pkg/kubelet/cm/checkpointselfheal/metrics.go
@@ -0,0 +1,84 @@
+/*
+Copyright 2026 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package checkpointselfheal
+
+import (
+	"k8s.io/component-base/metrics"
+	"k8s.io/component-base/metrics/legacyregistry"
+)
+
+// The metrics are registered here rather than in pkg/kubelet/metrics so that
+// this patch does not touch that file: it is large, shared, and rewritten every
+// release, which makes it the most expensive place to carry a downstream
+// change. legacyregistry is the same registry kubelet serves on /metrics, so
+// self-registering changes nothing about how these are exposed.
+//
+// Alerting on these is not optional. This patch turns a loud refusal to start
+// into a quiet self-repair, which means a bug in whatever generates the kubelet
+// config would restart pinned workload across a whole NodeGroup instead of
+// failing visibly. Without an alert nobody would notice.
+
+const subsystem = "kubelet"
+
+var (
+	// resetsTotal counts resets by manager and by reason. Reason is a closed
+	// set derived from the code path, never error text, so it is safe to alert
+	// on and cannot blow up the label cardinality.
+	resetsTotal = metrics.NewCounterVec(
+		&metrics.CounterOpts{
+			Subsystem:      subsystem,
+			Name:           "checkpoint_state_reset_total",
+			Help:           "Cumulative number of times the kubelet reset a CPU or memory manager checkpoint instead of refusing to start. Any increase is a real event.",
+			StabilityLevel: metrics.ALPHA,
+		},
+		[]string{"manager", "reason"},
+	)
+
+	// stoppedContainersTotal counts containers actually stopped to bring
+	// reality back in line with the reset state. Separate from resetsTotal
+	// because a reset right after a reboot stops nothing, while a reset on a
+	// live node is a workload restart.
+	stoppedContainersTotal = metrics.NewCounterVec(
+		&metrics.CounterOpts{
+			Subsystem:      subsystem,
+			Name:           "checkpoint_state_reset_stopped_containers_total",
+			Help:           "Cumulative number of running containers stopped by the kubelet after resetting a CPU or memory manager checkpoint, so that they are recreated and pinned again.",
+			StabilityLevel: metrics.ALPHA,
+		},
+		[]string{"manager"},
+	)
+
+	// stopFailuresTotal counts victims that could not be stopped. Each one is a
+	// container still physically holding CPUs or a NUMA zone that the reset
+	// state now believes to be free, so this is the metric that means the node
+	// needs a human.
+	stopFailuresTotal = metrics.NewCounterVec(
+		&metrics.CounterOpts{
+			Subsystem:      subsystem,
+			Name:           "checkpoint_state_reset_stop_failures_total",
+			Help:           "Cumulative number of containers the kubelet failed to stop after resetting a CPU or memory manager checkpoint. Any increase means a container may still hold CPUs or a NUMA zone that the state considers free.",
+			StabilityLevel: metrics.ALPHA,
+		},
+		[]string{"manager"},
+	)
+)
+
+func init() {
+	legacyregistry.MustRegister(resetsTotal)
+	legacyregistry.MustRegister(stoppedContainersTotal)
+	legacyregistry.MustRegister(stopFailuresTotal)
+}
diff --git a/pkg/kubelet/cm/checkpointselfheal/selfheal.go b/pkg/kubelet/cm/checkpointselfheal/selfheal.go
new file mode 100644
index 00000000000..e2091d174a8
--- /dev/null
+++ b/pkg/kubelet/cm/checkpointselfheal/selfheal.go
@@ -0,0 +1,331 @@
+/*
+Copyright 2026 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package checkpointselfheal
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sort"
+	"sync"
+	"time"
+
+	"k8s.io/klog/v2"
+)
+
+// LogMarker prefixes every log line this package emits, so that one grep finds
+// the whole story on a node:
+//
+//	journalctl -u kubelet | grep d8-numa-selfheal
+//
+// The marker sits in the message text rather than in a structured field on
+// purpose: klog writes the text as msg="...", so the marker survives any
+// --logging-format, while searching by field does not.
+const LogMarker = "[d8-numa-selfheal]"
+
+// Version identifies this patch in the kubelet log. Bump it when the behaviour
+// changes, so that a log from a node says which build produced it.
+const Version = "1"
+
+// MarkerFileName is the machine-readable trace left next to the manager state
+// files. Its directory is the kubelet state directory, so the path follows
+// --root-dir and is never hardcoded.
+const MarkerFileName = "d8-numa-selfheal.json"
+
+// ManagerName is the manager whose checkpoint was reset. Only the affected
+// manager is ever touched.
+type ManagerName string
+
+const (
+	ManagerCPU    ManagerName = "cpu"
+	ManagerMemory ManagerName = "memory"
+)
+
+// Reason is why the checkpoint had to go. It is a closed set derived from the
+// code path taken, never from the text of an error, so that it is safe to use
+// as a metric label and to alert on.
+type Reason string
+
+const (
+	// ReasonPolicyMismatch means the checkpoint on disk was written by a
+	// different policy than the one now configured. Detected structurally, by
+	// comparing the policy name in the file with the configured one.
+	ReasonPolicyMismatch Reason = "policy_mismatch"
+	// ReasonCheckpointCorrupt means the checkpoint could not be restored at all:
+	// a bad checksum, a torn write, unparsable content. Named to match the
+	// enum in the task description.
+	ReasonCheckpointCorrupt Reason = "checkpoint_corrupt"
+	// ReasonStateValidation means the checkpoint was read fine but does not
+	// describe this machine any more: changed CPU topology, changed NUMA zones,
+	// changed hugepages, changed reserved memory, per-NUMA MemTotal drift.
+	ReasonStateValidation Reason = "state_validation"
+)
+
+// ContainerRef identifies a container the way the managers key their
+// assignments: by pod UID and container name, not by container id. A recreated
+// container gets a new id but keeps the same ref, which is exactly why clearing
+// the state is required and stopping alone would not be enough -- the manager
+// would see the pair already present and skip it.
+//
+// Two comparable string fields, so this doubles as a map key -- the stopper
+// indexes the runtime's containers by it.
+type ContainerRef struct {
+	PodUID        string `json:"podUID"`
+	ContainerName string `json:"containerName"`
+}
+
+// Victim is an assignment that a reset dropped, and what became of the
+// container that held it. Only PodUID and ContainerName are known when the
+// reset is recorded; everything else is filled in by the stopper, which is
+// where the runtime is available and where the assignment is resolved to a
+// container id.
+type Victim struct {
+	PodUID        string `json:"podUID"`
+	ContainerName string `json:"containerName"`
+	ContainerID   string `json:"containerID"`
+
+	PodName      string `json:"podName,omitempty"`
+	PodNamespace string `json:"podNamespace,omitempty"`
+
+	// Stopped reports whether the container was actually stopped. A victim that
+	// was already gone by the time we looked is reported as skipped, not
+	// stopped, and is not counted as a stop.
+	Stopped bool   `json:"stopped"`
+	Skipped string `json:"skipped,omitempty"`
+	Error   string `json:"error,omitempty"`
+}
+
+// ResetRecord is one manager's reset, as it happened.
+type ResetRecord struct {
+	Manager    ManagerName `json:"manager"`
+	Reason     Reason      `json:"reason"`
+	Cause      string      `json:"cause"`
+	StateFile  string      `json:"stateFile"`
+	DetectedAt time.Time   `json:"detectedAt"`
+	Victims    []Victim    `json:"victims"`
+}
+
+// Marker is the JSON written to MarkerFileName. Consumers (bashible, an
+// operator, a node controller) read it to learn that this node healed itself
+// and which workload was disturbed. Whether a victim can restart on its own
+// needs the pod spec, which is not available this early in kubelet start, so
+// that classification is deliberately left to the reader of this file.
+type Marker struct {
+	Version   string        `json:"version"`
+	WrittenAt time.Time     `json:"writtenAt"`
+	Resets    []ResetRecord `json:"resets"`
+}
+
+var registry struct {
+	mu      sync.Mutex
+	records []ResetRecord
+}
+
+// Clear drops everything recorded so far. Only for tests.
+func Clear() {
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	registry.records = nil
+}
+
+// Take returns everything recorded so far and empties the registry.
+func Take() []ResetRecord {
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	records := registry.records
+	registry.records = nil
+	return records
+}
+
+// Pending reports how many resets are waiting to be acted on. Only for tests
+// and for logging.
+func Pending() int {
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	return len(registry.records)
+}
+
+// LogHealthy emits one line per manager whose checkpoint validated cleanly.
+//
+// This line is not decoration. Without it there is no way to tell "the patch
+// ran and found nothing wrong" from "this node is running an unpatched binary",
+// which is the single most common way to waste time debugging this on a
+// cluster.
+func LogHealthy(manager ManagerName) {
+	klog.InfoS(LogMarker+" checkpoint validated, nothing to do",
+		"manager", manager, "patchVersion", Version)
+}
+
+// RefsFrom turns a manager's assignment map into container refs. Both managers
+// key assignments as podUID -> containerName -> something, so one helper covers
+// both and neither state package needs to be imported here.
+func RefsFrom[T any](assignments map[string]map[string]T) []ContainerRef {
+	var refs []ContainerRef
+	for podUID, containers := range assignments {
+		for containerName := range containers {
+			refs = append(refs, ContainerRef{PodUID: podUID, ContainerName: containerName})
+		}
+	}
+	sortRefs(refs)
+	return refs
+}
+
+func sortRefs(refs []ContainerRef) {
+	sort.Slice(refs, func(i, j int) bool {
+		if refs[i].PodUID != refs[j].PodUID {
+			return refs[i].PodUID < refs[j].PodUID
+		}
+		return refs[i].ContainerName < refs[j].ContainerName
+	})
+}
+
+// RecordStateReset remembers the assignments a manager is about to drop with
+// ClearState, and must therefore be called *before* ClearState.
+//
+// It cannot fail and does not block: at this point in kubelet start there is
+// nothing safe to wait for, and a failure here would put us back to refusing to
+// start, which is the whole thing being fixed.
+func RecordStateReset(manager ManagerName, stateDir, checkpointName string, refs []ContainerRef, cause error) {
+	recordReset(manager, ReasonStateValidation, filepath.Join(stateDir, checkpointName), refs, cause)
+}
+
+// ResetCheckpointFile removes a checkpoint the manager could not restore, so
+// that the next attempt starts from scratch, and records what was lost. It
+// reads the file before removing it, so the victims are known even though the
+// manager itself never managed to load them.
+//
+// It reports whether the file is gone. False means the caller must fail exactly
+// as it did before this patch: we could not make progress, so pretending
+// otherwise would only hide the problem.
+func ResetCheckpointFile(manager ManagerName, stateDir, checkpointName, configuredPolicy string, cause error) bool {
+	path := filepath.Join(stateDir, checkpointName)
+
+	filePolicy, refs := inspectCheckpoint(manager, stateDir, checkpointName)
+	reason := ReasonCheckpointCorrupt
+	if filePolicy != "" && filePolicy != configuredPolicy {
+		// The file itself is fine; it just belongs to another policy. Worth
+		// separating, because this one is an operator action rather than a
+		// broken node.
+		reason = ReasonPolicyMismatch
+	}
+
+	debug("classified an unusable checkpoint",
+		"manager", manager, "stateFile", path,
+		"policyInFile", filePolicy, "policyConfigured", configuredPolicy,
+		"reason", reason, "assignmentsFound", len(refs))
+
+	if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+		klog.ErrorS(err, LogMarker+" could not remove unusable checkpoint, kubelet will fail as before",
+			"manager", manager, "stateFile", path)
+		return false
+	}
+
+	debug("checkpoint removed", "manager", manager, "stateFile", path)
+	recordReset(manager, reason, path, refs, cause)
+	return true
+}
+
+func recordReset(manager ManagerName, reason Reason, stateFile string, refs []ContainerRef, cause error) {
+	// Every dropped assignment becomes a victim, named by the only thing known
+	// here. Which container -- if any -- is behind each of them is decided by
+	// the stopper, from the runtime snapshot it takes anyway.
+	victims := make([]Victim, 0, len(refs))
+	for _, ref := range refs {
+		victims = append(victims, Victim{PodUID: ref.PodUID, ContainerName: ref.ContainerName})
+	}
+
+	rec := ResetRecord{
+		Manager:    manager,
+		Reason:     reason,
+		StateFile:  stateFile,
+		DetectedAt: time.Now(),
+		Victims:    victims,
+	}
+	if cause != nil {
+		rec.Cause = cause.Error()
+	}
+
+	registry.mu.Lock()
+	registry.records = append(registry.records, rec)
+	pending := len(registry.records)
+	registry.mu.Unlock()
+
+	debug("reset recorded",
+		"manager", manager, "reason", reason, "stateFile", stateFile,
+		"assignmentsInOldState", len(refs),
+		"pendingResets", pending)
+
+	resetsTotal.WithLabelValues(string(manager), string(reason)).Inc()
+
+	klog.ErrorS(cause, LogMarker+" checkpoint unusable, resetting manager state",
+		"manager", manager, "reason", reason, "stateFile", stateFile,
+		"patchVersion", Version)
+	klog.InfoS(LogMarker+" collected victims before clearing state",
+		"manager", manager, "reason", reason, "victims", len(rec.Victims),
+		"assignmentsInOldState", len(refs))
+	for _, v := range rec.Victims {
+		klog.InfoS(LogMarker+" victim",
+			"manager", manager, "podUID", v.PodUID, "containerName", v.ContainerName)
+	}
+}
+
+// markerHistoryLimit caps how many resets the marker file keeps, so that a node
+// healing on every restart cannot grow it without end. The newest are kept.
+const markerHistoryLimit = 16
+
+// writeMarker leaves the machine-readable trace for whoever has to decide
+// whether this node needs a drain. A failure to write it is logged and
+// otherwise ignored: the containers have already been dealt with, and refusing
+// to start over a missing marker file would defeat the purpose.
+func writeMarker(dir string, records []ResetRecord) {
+	if dir == "" {
+		klog.ErrorS(nil, LogMarker+" no state directory known, skipping marker file")
+		return
+	}
+	path := filepath.Join(dir, MarkerFileName)
+
+	// Resets already in the file are carried forward. Nothing but the consumer
+	// removes this file, so whatever is still in it describes a heal nobody has
+	// acted on yet -- possibly one whose victim could not be stopped, which is
+	// the single signal meaning the node needs a human. Replacing the file
+	// would drop that silently on the next heal. Content that cannot be decoded
+	// is dropped instead: reporting the reset that just happened matters more.
+	var previous Marker
+	if blob, err := os.ReadFile(path); err == nil {
+		if err := json.Unmarshal(blob, &previous); err != nil {
+			klog.ErrorS(err, LogMarker+" existing marker file cannot be decoded, replacing it", "path", path)
+		}
+	}
+	resets := append(previous.Resets, records...)
+	if len(resets) > markerHistoryLimit {
+		resets = resets[len(resets)-markerHistoryLimit:]
+	}
+	marker := Marker{Version: Version, WrittenAt: time.Now(), Resets: resets}
+
+	blob, err := json.MarshalIndent(marker, "", "  ")
+	if err != nil {
+		klog.ErrorS(err, LogMarker+" could not encode marker file", "path", path)
+		return
+	}
+	if err := os.WriteFile(path, append(blob, '\n'), 0600); err != nil {
+		klog.ErrorS(err, LogMarker+" could not write marker file", "path", path)
+		return
+	}
+	klog.InfoS(LogMarker+" wrote marker file",
+		"path", path, "resets", len(records), "carriedForward", len(previous.Resets))
+	debug("marker file content", "path", path, "content", debugBlob(blob))
+}
