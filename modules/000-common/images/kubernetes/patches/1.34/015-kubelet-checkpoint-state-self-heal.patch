+func TestStopVictimsWithoutRuntimeStillLeavesAMarker(t *testing.T) {
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+	cm := containermap.NewContainerMap()
+	cm.Add("pod", "app", "cid")
+
+	RecordStateReset(ManagerCPU, dir, "cpu_manager_state",
+		[]ContainerRef{{PodUID: "pod", ContainerName: "app"}}, errors.New("x"))
+
+	StopVictims(context.Background(), Deps{})
+
+	marker := readMarker(t, dir)
+	if len(marker.Resets) != 1 || len(marker.Resets[0].Victims) != 1 {
+		t.Fatalf("unexpected marker: %+v", marker)
+	}
+	if marker.Resets[0].Victims[0].Error == "" {
+		t.Error("victim should carry an error when there is no runtime to stop it with")
+	}
+}
