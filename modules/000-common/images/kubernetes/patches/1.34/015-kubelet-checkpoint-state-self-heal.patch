+	}
+	if _, err := os.Stat(filepath.Join(dir, MarkerFileName)); !os.IsNotExist(err) {
+		t.Error("a marker file was written even though nothing was reset")
+	}
+}
+
+func readMarker(t *testing.T, dir string) Marker {
+	t.Helper()
+	blob, err := os.ReadFile(filepath.Join(dir, MarkerFileName))
+	if err != nil {
+		t.Fatalf("reading marker: %v", err)
+	}
+	var marker Marker
+	if err := json.Unmarshal(blob, &marker); err != nil {
+		t.Fatalf("decoding marker: %v", err)
+	}
+	return marker
+}
+
+func TestResetAndStopEndToEnd(t *testing.T) {
+	// The whole flow over a checkpoint that belongs to another policy: read it
+	// past the load that upstream refuses, name the victim, remove the file,
+	// stop the container and leave a marker behind.
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+	writeFile(t, dir, "cpu_manager_state", cpuCheckpoint)
+
+	cm := containermap.NewContainerMap()
+	cm.Add("pod-a", "app", "cid-a")
+
+	runtime := apitest.NewFakeRuntimeService()
+	runtime.Containers = map[string]*apitest.FakeContainer{
+		"cid-a": fakeContainer("cid-a", "pod-a", "ns", runtimeapi.ContainerState_CONTAINER_RUNNING),
+	}
+
+	if ok := ResetCheckpointFile(ManagerCPU, dir, "cpu_manager_state", "none", cm, errors.New("boom")); !ok {
+		t.Fatal("ResetCheckpointFile reported failure")
+	}
+	StopVictims(context.Background(), Deps{Runtime: runtime})
+
+	if got := runtime.Containers["cid-a"].State; got != runtimeapi.ContainerState_CONTAINER_EXITED {
+		t.Errorf("victim state: got %v, want EXITED", got)
+	}
+	marker := readMarker(t, dir)
+	if len(marker.Resets) != 1 || len(marker.Resets[0].Victims) != 1 {
+		t.Fatalf("marker: %+v", marker)
+	}
+	if !marker.Resets[0].Victims[0].Stopped {
+		t.Error("victim not marked stopped")
+	}
+	if marker.Resets[0].Reason != ReasonPolicyMismatch {
+		t.Errorf("reason: got %q, want %q", marker.Resets[0].Reason, ReasonPolicyMismatch)
+	}
+}
+
+func TestStopVictimsRetargetsARecreatedContainer(t *testing.T) {
+	// Found on a cluster: after one heal the pod's container is recreated, so
+	// the runtime reports two containers for the same (pod, container name) --
+	// the exited predecessor and the live replacement. containerMap keeps only
+	// one id per pair and which one it keeps depends on the order
+	// ListContainers returned them, so the victim can point at the container
+	// that has already exited. Skipping it as "not running" would leave the
+	// live container holding the CPUs and the NUMA zone that the state has
+	// just given up, which is exactly the divergence being repaired.
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+
+	const podUID = "pod-recreated"
+	runtime := apitest.NewFakeRuntimeService()
+	runtime.Containers = map[string]*apitest.FakeContainer{
+		"cid-old": fakeContainerForPod("cid-old", podUID, "numa-pinned", "default", runtimeapi.ContainerState_CONTAINER_EXITED),
+		"cid-new": fakeContainerForPod("cid-new", podUID, "numa-pinned", "default", runtimeapi.ContainerState_CONTAINER_RUNNING),
+	}
+
+	// containerMap resolved the pair to the stale container, as it did on the
+	// cluster.
+	cm := containermap.NewContainerMap()
+	cm.Add(podUID, "app", "cid-old")
+
+	RecordStateReset(ManagerCPU, dir, "cpu_manager_state",
+		[]ContainerRef{{PodUID: podUID, ContainerName: "app"}}, cm, errors.New("checkpoint is corrupted"))
+
+	StopVictims(context.Background(), Deps{Runtime: runtime})
+
+	if got := runtime.Containers["cid-new"].State; got != runtimeapi.ContainerState_CONTAINER_EXITED {
+		t.Errorf("live container was not stopped, state %v", got)
+	}
+
+	victims := readMarker(t, dir).Resets[0].Victims
+	if len(victims) != 1 {
+		t.Fatalf("victims: %+v", victims)
+	}
+	v := victims[0]
+	if v.ContainerID != "cid-new" {
+		t.Errorf("victim aimed at %q, want the running container cid-new", v.ContainerID)
+	}
+	if v.SupersededID != "cid-old" {
+		t.Errorf("supersededID = %q, want cid-old so the correction is visible", v.SupersededID)
+	}
+	if !v.Stopped || v.Error != "" {
+		t.Errorf("victim: %+v, want stopped without error", v)
+	}
+}
+
+// fakeContainerForPod is fakeContainer with an explicit pod UID label, which is
+// what the retargeting index is built from.
+func fakeContainerForPod(id, podUID, podName, podNamespace string, state runtimeapi.ContainerState) *apitest.FakeContainer {
+	c := fakeContainer(id, podName, podNamespace, state)
+	c.Labels[kubelettypes.KubernetesPodUIDLabel] = podUID
+	return c
+}
+
+func TestStopVictimsStopsAContainerOnceAcrossManagers(t *testing.T) {
+	// Found on a cluster: corrupting both checkpoints while a Guaranteed pod was
+	// running made each manager record the same container as its victim, and the
+	// container was stopped twice. The second stop is a no-op at the runtime, but
+	// it counted a stop and emitted a second pod event, so
+	// stopped_containers_total summed to two while restartCount showed one
+	// restart. Each reset must still record the victim -- both managers really
+	// did lose the assignment -- but the stop happens once.
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+
+	const podUID = "pod-shared"
+	runtime := apitest.NewFakeRuntimeService()
+	runtime.Containers = map[string]*apitest.FakeContainer{
+		"cid": fakeContainerForPod("cid", podUID, "numa-pinned", "default", runtimeapi.ContainerState_CONTAINER_RUNNING),
+	}
+
+	cm := containermap.NewContainerMap()
+	cm.Add(podUID, "app", "cid")
+
+	refs := []ContainerRef{{PodUID: podUID, ContainerName: "app"}}
+	RecordStateReset(ManagerCPU, dir, "cpu_manager_state", refs, cm, errors.New("checkpoint is corrupted"))
+	RecordStateReset(ManagerMemory, dir, "memory_manager_state", refs, cm, errors.New("checkpoint is corrupted"))
+
+	recorder := record.NewFakeRecorder(10)
+	StopVictims(context.Background(), Deps{Runtime: runtime, Recorder: recorder})
+
+	stops := 0
+	for _, call := range runtime.Called {
+		if call == "StopContainer" {
+			stops++
+		}
+	}
+	if stops != 1 {
+		t.Errorf("StopContainer called %d times, want exactly 1", stops)
+	}
+
+	events := 0
+	for {
+		select {
+		case <-recorder.Events:
+			events++
+			continue
+		default:
+		}
+		break
+	}
+	if events != 1 {
+		t.Errorf("emitted %d pod events, want exactly 1", events)
+	}
+
+	// Both resets keep the victim, but only one of them reports a stop.
+	marker := readMarker(t, dir)
+	if len(marker.Resets) != 2 {
+		t.Fatalf("marker has %d resets, want 2", len(marker.Resets))
+	}
+	stopped, skipped := 0, 0
+	for _, r := range marker.Resets {
+		if len(r.Victims) != 1 {
+			t.Fatalf("reset %s has %d victims, want 1", r.Manager, len(r.Victims))
+		}
+		switch v := r.Victims[0]; {
+		case v.Stopped:
+			stopped++
+		case v.Skipped != "":
+			skipped++
+		default:
+			t.Errorf("victim of %s is neither stopped nor skipped: %+v", r.Manager, v)
+		}
+	}
+	if stopped != 1 || skipped != 1 {
+		t.Errorf("marker reports stopped=%d skipped=%d, want 1 and 1", stopped, skipped)
+	}
+}
diff --git a/pkg/kubelet/cm/checkpointselfheal/stop.go b/pkg/kubelet/cm/checkpointselfheal/stop.go
new file mode 100644
index 00000000000..68c1ac0df42
--- /dev/null
+++ b/pkg/kubelet/cm/checkpointselfheal/stop.go
@@ -0,0 +1,372 @@
+/*
