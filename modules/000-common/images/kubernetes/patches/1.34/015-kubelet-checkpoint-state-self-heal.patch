+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package cm
+
+import (
+	"bytes"
+	"go/ast"
+	"go/parser"
+	"go/printer"
+	"go/token"
+	"strings"
+	"testing"
+)
+
+// TestStopVictimsRunsSynchronouslyInsideStart guards the one property that
+// keeps a checkpoint reset from losing isolation instead of restoring it.
+//
+// A reset leaves containers running on CPUs and memory zones that the fresh
+// state reports as free, so a Guaranteed pod admitted in that window would be
+// handed CPUs another container is still using. What closes the window is that
+// the stop happens inside containerManagerImpl.Start, before it returns:
+// kubelet calls setRuntimeSync only after
+// oneTimeInitializer.Do(initializeRuntimeDependentModules), and syncLoop skips
+// every iteration until it does, so nothing can be admitted while we stop.
+//
+// That is a property of one call site, and nothing else in the tree fails if
+// the call is moved after the return, put behind a condition or handed to a
+// goroutine: it would still compile, still pass every other test, and break
+// only under load on a real node. Hence this test, against the source.
+func TestStopVictimsRunsSynchronouslyInsideStart(t *testing.T) {
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, "container_manager_linux.go", nil, 0)
+	if err != nil {
+		t.Fatalf("parsing container_manager_linux.go: %v", err)
+	}
+
+	var body *ast.BlockStmt
+	for _, decl := range file.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if ok && fn.Name.Name == "Start" && fn.Recv != nil && fn.Body != nil &&
+			strings.Contains(render(fset, fn.Recv.List[0].Type), "containerManagerImpl") {
+			body = fn.Body
+		}
+	}
+	if body == nil {
+		t.Fatal("containerManagerImpl.Start not found")
+	}
+
+	managersAt, stopAt := -1, -1
+	for i, stmt := range body.List {
+		src := render(fset, stmt)
+		if strings.Contains(src, "cm.cpuManager.Start(") || strings.Contains(src, "cm.memoryManager.Start(") {
+			managersAt = i
+		}
+		// Required to be a plain expression statement of the function body.
+		// That is what rules out "go StopVictims(...)", a call behind an if,
+		// and a call moved into a helper Start may or may not reach.
+		if _, ok := stmt.(*ast.ExprStmt); ok && strings.HasPrefix(src, "checkpointselfheal.StopVictims(") {
+			stopAt = i
+		}
+	}
+
+	if stopAt < 0 {
+		t.Fatal("checkpointselfheal.StopVictims is not a plain statement of containerManagerImpl.Start; " +
+			"the reset could then leave victims running while pods are already being admitted")
+	}
+	if managersAt < 0 {
+		t.Fatal("neither manager's Start found in containerManagerImpl.Start")
+	}
+	if stopAt < managersAt {
+		t.Errorf("StopVictims is at statement %d, before the managers at %d: "+
+			"the managers are what record the victims, so stopping earlier stops nothing", stopAt, managersAt)
+	}
+}
+
+func render(fset *token.FileSet, node ast.Node) string {
+	var buf bytes.Buffer
+	if err := printer.Fprint(&buf, fset, node); err != nil {
+		return ""
+	}
+	return buf.String()
+}
diff --git a/pkg/kubelet/cm/container_manager_linux.go b/pkg/kubelet/cm/container_manager_linux.go
index 64fe7df63b4..04d18d61724 100644
--- a/pkg/kubelet/cm/container_manager_linux.go
+++ b/pkg/kubelet/cm/container_manager_linux.go
@@ -50,6 +50,7 @@ import (
 	podresourcesapi "k8s.io/kubelet/pkg/apis/podresources/v1"
 	kubefeatures "k8s.io/kubernetes/pkg/features"
 	"k8s.io/kubernetes/pkg/kubelet/cadvisor"
+	"k8s.io/kubernetes/pkg/kubelet/cm/checkpointselfheal"
 	"k8s.io/kubernetes/pkg/kubelet/cm/cpumanager"
 	"k8s.io/kubernetes/pkg/kubelet/cm/devicemanager"
 	"k8s.io/kubernetes/pkg/kubelet/cm/dra"
@@ -631,6 +632,16 @@ func (cm *containerManagerImpl) Start(ctx context.Context, node *v1.Node,
 		return fmt.Errorf("start memory manager error: %w", err)
 	}
 
+	// If either manager reset its checkpoint above, the containers that held
+	// assignments in it still hold CPUs and memory zones the fresh state
+	// considers free. Stopping them here, before this function returns, keeps
+	// them from being handed to a newly admitted pod: kubelet marks the runtime
+	// synced only afterwards.
+	checkpointselfheal.StopVictims(ctx, checkpointselfheal.Deps{
+		Runtime:  runtimeService,
+		Recorder: cm.recorder,
+	})
+
 	// cache the node Info including resource capacity and
 	// allocatable of the node
 	cm.nodeInfo = node
