+
+package checkpointselfheal
+
+import (
+	"k8s.io/klog/v2"
+	"k8s.io/kubernetes/pkg/kubelet/checkpointmanager"
+	cpustate "k8s.io/kubernetes/pkg/kubelet/cm/cpumanager/state"
+	memorystate "k8s.io/kubernetes/pkg/kubelet/cm/memorymanager/state"
+)
+
+// inspectCheckpoint reports the policy that wrote a manager's checkpoint and the
+// assignment keys it holds.
+//
+// The read error is discarded on purpose: checkpointmanager.GetCheckpoint
+// unmarshals before it verifies the checksum, so a checkpoint that fails
+// verification is still populated -- and its contents are the only record of
+// which containers hold assignments before the file is deleted. A file that
+// cannot be decoded at all yields no keys, degrading to "reset without naming
+// the containers".
+//
+// The managers' own checkpoint types are used rather than a local struct: they
+// always name the current on-disk format, so one source works across releases
+// and a future format change breaks the build instead of silently finding
+// nothing. They are constructed directly because the upstream constructors are
+// not exported on every branch; the maps they pre-allocate are filled in by
+// Unmarshal anyway.
+func inspectCheckpoint(manager ManagerName, stateDir, checkpointName string) (policyName string, keys []AssignmentKey) {
+	mgr, err := checkpointmanager.NewCheckpointManager(stateDir)
+	if err != nil {
+		klog.ErrorS(err, "Could not open the checkpoint directory for inspection",
+			"manager", manager, "stateDir", stateDir)
+		return "", nil
+	}
+
+	switch manager {
+	case ManagerCPU:
+		cp := &cpustate.CPUManagerCheckpoint{}
+		_ = mgr.GetCheckpoint(checkpointName, cp)
+		return cp.PolicyName, AssignmentKeysFrom(cp.Entries)
+	case ManagerMemory:
+		cp := &memorystate.MemoryManagerCheckpoint{}
+		_ = mgr.GetCheckpoint(checkpointName, cp)
+		return cp.PolicyName, AssignmentKeysFrom(cp.Entries)
+	}
+	return "", nil
+}
