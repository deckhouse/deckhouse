+func readMarker(t *testing.T, dir string) Marker {
+	t.Helper()
+	blob, err := os.ReadFile(filepath.Join(dir, MarkerFileName))
+	if err != nil {
+		t.Fatalf("reading marker: %v", err)
+	}
+	var marker Marker
+	if err := json.Unmarshal(blob, &marker); err != nil {
+		t.Fatalf("decoding marker: %v", err)
+	}
+	return marker
+}
