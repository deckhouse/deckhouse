+package memorymanager
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	cadvisorapi "github.com/google/cadvisor/info/v1"
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/klog/v2/ktesting"
+	"k8s.io/kubernetes/pkg/kubelet/cm/checkpointselfheal"
+	"k8s.io/kubernetes/pkg/kubelet/cm/containermap"
+	"k8s.io/kubernetes/pkg/kubelet/cm/memorymanager/state"
+	"k8s.io/kubernetes/pkg/kubelet/cm/topologymanager"
+)
+
+// These tests cover what a single-NUMA-zone test node cannot reproduce at all:
+// per-zone memory drift, a changed zone count, and a victim holding a zone the
+// reset state believes to be free. On one zone cpuset.mems is always "0", so
+// there is nothing to observe there -- the coverage has to live here.
+
+const (
+	mib = uint64(1024 * 1024)
+	gib = 1024 * mib
+)
+
+// twoZoneMachine is the smallest machine that can drift: two NUMA nodes with
+// equal memory, so that a change on one of them is unambiguous.
+func twoZoneMachine() *cadvisorapi.MachineInfo {
+	return &cadvisorapi.MachineInfo{
+		Topology: []cadvisorapi.Node{
+			{Id: 0, Memory: 4 * gib},
+			{Id: 1, Memory: 4 * gib},
+		},
+	}
+}
+
+func twoZoneReserved() systemReservedMemory {
+	return systemReservedMemory{
+		0: map[v1.ResourceName]uint64{v1.ResourceMemory: 512 * mib},
+		1: map[v1.ResourceName]uint64{v1.ResourceMemory: 512 * mib},
+	}
+}
+
+type selfHealFixture struct {
+	manager  *manager
+	policy   *staticPolicy
+	stateDir string
+}
+
+func newSelfHealFixture(t *testing.T, machineInfo *cadvisorapi.MachineInfo, reserved systemReservedMemory, cm containermap.ContainerMap) *selfHealFixture {
+	t.Helper()
+	_, tCtx := ktesting.NewTestContext(t)
+
+	policy, err := NewPolicyStatic(tCtx, machineInfo, reserved, topologymanager.NewFakeManager())
+	if err != nil {
+		t.Fatalf("building static policy: %v", err)
+	}
+
+	return &selfHealFixture{
+		manager: &manager{
+			policy:             policy,
+			stateFileDirectory: t.TempDir(),
+			containerMap:       cm,
+		},
+		policy: policy.(*staticPolicy),
+	}
+}
+
+// seedCheckpoint writes a checkpoint with a *valid* checksum through the real
+// state package. That matters: writing a broken file would exercise the
+// "cannot read the checkpoint" path, while the drift this file is about is only
+// reachable with a file that reads back perfectly and simply no longer
+// describes the machine.
+func seedCheckpoint(t *testing.T, dir, policyName string, machineState state.NUMANodeMap, assignments state.ContainerMemoryAssignments) {
+	t.Helper()
+	logger, _ := ktesting.NewTestContext(t)
+
+	seed, err := state.NewCheckpointState(logger, dir, memoryManagerStateFileName, policyName)
+	if err != nil {
+		t.Fatalf("seeding checkpoint: %v", err)
+	}
+	seed.SetMachineState(machineState)
+	if assignments != nil {
+		seed.SetMemoryAssignments(assignments)
+	}
+}
+
+func TestStartHealsPerZoneMemoryDrift(t *testing.T) {
+	// The kubernetes/kubernetes#131253 shape: the kernel frees a varying amount
+	// of boot-time reserved memory each boot, so a zone's MemTotal comes back a
+	// few tens of MiB different from what the checkpoint recorded. Upstream
+	// refuses to start; the node then needs a human for a difference that
+	// changes nothing about whether the assignments still fit.
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	_, tCtx := ktesting.NewTestContext(t)
+	f := newSelfHealFixture(t, twoZoneMachine(), twoZoneReserved(), containermap.NewContainerMap())
+
+	drifted := f.policy.getDefaultMachineState()
+	drifted[0].MemoryMap[v1.ResourceMemory].TotalMemSize -= 40 * mib
+	seedCheckpoint(t, f.manager.stateFileDirectory, f.policy.Name(), drifted, nil)
+
+	err := f.manager.Start(tCtx, func() []*v1.Pod { return nil }, &sourcesReadyStub{},
+		mockPodStatusProvider{}, mockRuntimeService{}, containermap.NewContainerMap())
+	if err != nil {
+		t.Fatalf("Start returned %v, want nil: kubelet must come up despite the drift", err)
+	}
+
+	records := checkpointselfheal.Take()
+	if len(records) != 1 {
+		t.Fatalf("recorded %d resets, want exactly 1", len(records))
+	}
+	if records[0].Manager != checkpointselfheal.ManagerMemory {
+		t.Errorf("manager: got %q, want %q", records[0].Manager, checkpointselfheal.ManagerMemory)
+	}
+	if records[0].Reason != checkpointselfheal.ReasonStateValidation {
+		t.Errorf("reason: got %q, want %q", records[0].Reason, checkpointselfheal.ReasonStateValidation)
+	}
+	// Right after a reboot -- which is when drift shows up -- there are no
+	// containers, so the reset is free and nothing is stopped.
+	if len(records[0].Victims) != 0 {
+		t.Errorf("victims: got %v, want none", records[0].Victims)
+	}
+
+	// The state the manager ends up with must describe the machine as it is
+	// now, otherwise the next restart hits the same wall.
+	got := f.manager.state.GetMachineState()
+	want := f.policy.getDefaultMachineState()
+	for _, nodeID := range []int{0, 1} {
+		gotSize := got[nodeID].MemoryMap[v1.ResourceMemory].TotalMemSize
+		wantSize := want[nodeID].MemoryMap[v1.ResourceMemory].TotalMemSize
+		if gotSize != wantSize {
+			t.Errorf("node %d TotalMemSize after heal: got %d, want %d", nodeID, gotSize, wantSize)
+		}
+	}
+}
