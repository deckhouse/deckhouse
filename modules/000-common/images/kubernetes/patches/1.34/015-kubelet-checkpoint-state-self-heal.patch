+)
+
+// notReadyStub keeps the reconcile loop that Start spawns from purging state
+// while the assertions run. removeStaleState returns early unless the sources
+// are ready, so this makes the test deterministic without changing what is
+// under test.
+type notReadyStub struct{}
+
+func (notReadyStub) AddSource(source string) {}
+func (notReadyStub) AllReady() bool          { return false }
+
+type cpuSelfHealFixture struct {
+	manager *manager
+	policy  Policy
+}
+
+// newCPUSelfHealFixture builds a manager around the real static policy: the
+// point of these tests is that the policy's own "state is empty, initialise"
+// path is what recovers after a reset, so a stub policy would prove nothing.
+func newCPUSelfHealFixture(t *testing.T, cm containermap.ContainerMap) *cpuSelfHealFixture {
+	t.Helper()
+
+	policy, err := NewStaticPolicy(topoSingleSocketHT, 0, cpuset.New(), topologymanager.NewFakeManager(), nil)
+	if err != nil {
+		t.Fatalf("building static policy: %v", err)
+	}
+
+	return &cpuSelfHealFixture{
+		manager: &manager{
+			policy:             policy,
+			stateFileDirectory: t.TempDir(),
+			lastUpdateState:    state.NewMemoryState(),
+			// Long enough that the periodic tick never fires during a test;
+			// wait.Until still runs it once immediately, which notReadyStub
+			// makes harmless.
+			reconcilePeriod: time.Hour,
+			topology:        topoSingleSocketHT,
+		},
+		policy: policy,
+	}
+}
+
+func (f *cpuSelfHealFixture) start(t *testing.T, cm containermap.ContainerMap) error {
+	t.Helper()
+	return f.manager.Start(func() []*v1.Pod { return nil }, notReadyStub{},
+		mockPodStatusProvider{}, mockRuntimeService{}, cm)
+}
+
+// seedCPUCheckpoint writes a checkpoint with a valid checksum through the real
+// state package, so that the failure under test is "this no longer describes
+// the machine" rather than "this file is broken".
+func seedCPUCheckpoint(t *testing.T, dir, policyName string, defaultCPUSet cpuset.CPUSet, assignments state.ContainerCPUAssignments) {
+	t.Helper()
+	seed, err := state.NewCheckpointState(dir, cpuManagerStateFileName, policyName, containermap.NewContainerMap())
+	if err != nil {
+		t.Fatalf("seeding checkpoint: %v", err)
+	}
+	seed.SetDefaultCPUSet(defaultCPUSet)
+	if assignments != nil {
+		seed.SetCPUAssignments(assignments)
+	}
+}
+
+func TestStartHealsChangedCPUTopology(t *testing.T) {
+	// A CPU came online while kubelet was down (chcpu -e, a resized VM), so the
+	// CPUs recorded in the checkpoint no longer add up to the CPUs the machine
+	// reports. Upstream refuses to start; the node then needs a human before it
+	// can run anything at all.
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	f := newCPUSelfHealFixture(t, containermap.NewContainerMap())
+
+	// topoSingleSocketHT has CPUs 0-7; the state knows only 0-6.
+	seedCPUCheckpoint(t, f.manager.stateFileDirectory, f.policy.Name(), cpuset.New(0, 1, 2, 3, 4, 5, 6), nil)
+
+	if err := f.start(t, containermap.NewContainerMap()); err != nil {
+		t.Fatalf("Start returned %v, want nil: kubelet must come up", err)
+	}
+
+	records := checkpointselfheal.Take()
+	if len(records) != 1 {
+		t.Fatalf("recorded %d resets, want exactly 1", len(records))
+	}
+	if records[0].Manager != checkpointselfheal.ManagerCPU {
+		t.Errorf("manager: got %q, want %q", records[0].Manager, checkpointselfheal.ManagerCPU)
+	}
+	if records[0].Reason != checkpointselfheal.ReasonStateValidation {
+		t.Errorf("reason: got %q, want %q", records[0].Reason, checkpointselfheal.ReasonStateValidation)
+	}
+
+	// The policy's empty-state branch has to have run, otherwise the next
+	// restart hits the same wall: every CPU the machine has must be in the
+	// shared pool now.
+	if got := f.manager.state.GetDefaultCPUSet(); !got.Equals(topoSingleSocketHT.CPUDetails.CPUs()) {
+		t.Errorf("defaultCPUSet after heal: got %q, want %q", got, topoSingleSocketHT.CPUDetails.CPUs())
+	}
+}
+
+func TestStartCollectsVictimsBeforeClearingState(t *testing.T) {
+	// The ordering contract: victims are collected first, because after the
+	// reset there is nowhere left to read the old assignments from.
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	cm := containermap.NewContainerMap()
+	cm.Add("pod-pinned", "app", "cid-pinned")
+
+	f := newCPUSelfHealFixture(t, cm)
+	f.manager.containerMap = cm
+
+	seedCPUCheckpoint(t, f.manager.stateFileDirectory, f.policy.Name(),
+		cpuset.New(0, 1, 2, 3, 4, 5),
+		state.ContainerCPUAssignments{
+			"pod-pinned": map[string]cpuset.CPUSet{"app": cpuset.New(6)},
+		})
+
+	if err := f.start(t, cm); err != nil {
+		t.Fatalf("Start returned %v, want nil", err)
+	}
+
+	records := checkpointselfheal.Take()
+	if len(records) != 1 {
+		t.Fatalf("recorded %d resets, want exactly 1", len(records))
+	}
+	if len(records[0].Victims) != 1 {
+		t.Fatalf("victims: got %v, want exactly the pinned container", records[0].Victims)
+	}
+	// The victim is named by the assignment key, which is all the recording
+	// phase knows: which container is behind it is resolved later, by the
+	// stopper, from its own runtime snapshot.
+	victim := records[0].Victims[0]
+	if victim.PodUID != "pod-pinned" || victim.ContainerName != "app" {
+		t.Errorf("victim: got %+v, want pod-pinned/app", victim)
+	}
+	if victim.ContainerID != "" {
+		t.Errorf("victim carries container id %q; resolving is the stopper's job", victim.ContainerID)
+	}
+	if len(f.manager.state.GetCPUAssignments()) != 0 {
+		t.Errorf("assignments survived the reset: %v", f.manager.state.GetCPUAssignments())
+	}
+}
+
+func TestStartHealsPolicyChange(t *testing.T) {
+	// Flipping the policy leaves a checkpoint written by the previous one.
+	// Detected structurally, by comparing policy names, rather than by matching
+	// the text of an error.
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	cm := containermap.NewContainerMap()
+	cm.Add("pod-a", "app", "cid-a")
+
+	f := newCPUSelfHealFixture(t, cm)
+	f.manager.containerMap = cm
+
+	seedCPUCheckpoint(t, f.manager.stateFileDirectory, string(PolicyNone),
+		cpuset.New(0, 1, 2, 3, 4, 5, 6),
+		state.ContainerCPUAssignments{
+			"pod-a": map[string]cpuset.CPUSet{"app": cpuset.New(7)},
+		})
+
+	if err := f.start(t, cm); err != nil {
+		t.Fatalf("Start returned %v, want nil", err)
+	}
+
+	records := checkpointselfheal.Take()
+	if len(records) != 1 {
+		t.Fatalf("recorded %d resets, want exactly 1", len(records))
+	}
+	if records[0].Reason != checkpointselfheal.ReasonPolicyMismatch {
+		t.Errorf("reason: got %q, want %q", records[0].Reason, checkpointselfheal.ReasonPolicyMismatch)
+	}
+	if len(records[0].Victims) != 1 || records[0].Victims[0].PodUID != "pod-a" {
+		t.Errorf("victims: got %v, want pod-a recovered from the old policy's checkpoint", records[0].Victims)
+	}
+}
+
+func TestStartHealsUnreadableCheckpoint(t *testing.T) {
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	cm := containermap.NewContainerMap()
+	cm.Add("pod-a", "app", "cid-a")
+
+	f := newCPUSelfHealFixture(t, cm)
+	f.manager.containerMap = cm
+
+	path := filepath.Join(f.manager.stateFileDirectory, cpuManagerStateFileName)
+	blob := `{"policyName":"static","defaultCpuSet":"0-7","entries":{"pod-a":{"app":"6"}},"checksum":42}`
+	if err := os.WriteFile(path, []byte(blob), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := f.start(t, cm); err != nil {
+		t.Fatalf("Start returned %v, want nil", err)
+	}
+
+	records := checkpointselfheal.Take()
+	if len(records) != 1 {
+		t.Fatalf("recorded %d resets, want exactly 1", len(records))
+	}
+	if records[0].Reason != checkpointselfheal.ReasonCheckpointCorrupt {
+		t.Errorf("reason: got %q, want %q", records[0].Reason, checkpointselfheal.ReasonCheckpointCorrupt)
+	}
+	if len(records[0].Victims) != 1 || records[0].Victims[0].PodUID != "pod-a" {
+		t.Errorf("victims: got %v, want pod-a recovered from the unreadable file", records[0].Victims)
+	}
+}
+
+func TestStartLeavesHealthyCheckpointAlone(t *testing.T) {
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	f := newCPUSelfHealFixture(t, containermap.NewContainerMap())
+	seedCPUCheckpoint(t, f.manager.stateFileDirectory, f.policy.Name(), topoSingleSocketHT.CPUDetails.CPUs(), nil)
+
+	if err := f.start(t, containermap.NewContainerMap()); err != nil {
+		t.Fatalf("Start returned %v, want nil", err)
+	}
+	if got := checkpointselfheal.Pending(); got != 0 {
+		t.Errorf("recorded %d resets on a healthy node, want 0", got)
+	}
+}
+
+func TestStartOnlyTouchesTheAffectedManager(t *testing.T) {
+	// Decision: the causes are independent -- memory drifts on its own, CPU
+	// only changes on hotplug -- so a broken CPU checkpoint must not cost the
+	// memory manager its state. Here that is visible as exactly one record,
+	// tagged cpu.
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	f := newCPUSelfHealFixture(t, containermap.NewContainerMap())
+	seedCPUCheckpoint(t, f.manager.stateFileDirectory, f.policy.Name(), cpuset.New(0, 1), nil)
+
+	if err := f.start(t, containermap.NewContainerMap()); err != nil {
+		t.Fatalf("Start returned %v, want nil", err)
+	}
+
+	records := checkpointselfheal.Take()
+	if len(records) != 1 || records[0].Manager != checkpointselfheal.ManagerCPU {
+		t.Fatalf("records: got %v, want a single cpu record", records)
+	}
+	if filepath.Base(records[0].StateFile) != cpuManagerStateFileName {
+		t.Errorf("stateFile: got %q, want the CPU manager state file", records[0].StateFile)
+	}
+}
