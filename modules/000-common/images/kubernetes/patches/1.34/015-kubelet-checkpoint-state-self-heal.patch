+func TestResetCheckpointFileFailsWhenFileCannotBeRemoved(t *testing.T) {
+	Clear()
+	t.Cleanup(Clear)
+
+	// A directory in place of the checkpoint file cannot be removed by
+	// os.Remove once it has content, which stands in for any unremovable file.
+	// The caller must then fail exactly as it did before this patch: we could
+	// not make progress, and pretending otherwise would hide the problem.
+	dir := t.TempDir()
+	stateDir := filepath.Join(dir, "state")
+	if err := os.MkdirAll(filepath.Join(stateDir, "cpu_manager_state", "child"), 0700); err != nil {
+		t.Fatal(err)
+	}
+
+	if ok := ResetCheckpointFile(ManagerCPU, stateDir, "cpu_manager_state", "static", errors.New("boom")); ok {
+		t.Error("ResetCheckpointFile reported success, want failure")
+	}
+	if got := Pending(); got != 0 {
+		t.Errorf("pending resets: got %d, want 0 - nothing should be recorded when the reset did not happen", got)
+	}
+}
