+// fakeContainer builds a running or exited container as the runtime would
+// report it, with the pod labels the stopper reads to name the pod.
+func fakeContainer(id, podName, podNamespace string, state runtimeapi.ContainerState) *apitest.FakeContainer {
+	c := &apitest.FakeContainer{SandboxID: "sandbox-" + id}
+	c.Id = id
+	c.State = state
+	c.Metadata = &runtimeapi.ContainerMetadata{Name: "app"}
+	c.Labels = map[string]string{
+		kubelettypes.KubernetesPodNameLabel:      podName,
+		kubelettypes.KubernetesPodNamespaceLabel: podNamespace,
+	}
+	return c
+}
