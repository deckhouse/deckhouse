+func TestStopVictims(t *testing.T) {
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+
+	runtime := apitest.NewFakeRuntimeService()
+	runtime.Containers = map[string]*apitest.FakeContainer{
+		"cid-running": fakeContainerForPod("cid-running", "pod-running", "pod-running", "ns", runtimeapi.ContainerState_CONTAINER_RUNNING),
+		// Already finished but not yet garbage collected. Stopping it would be
+		// a spurious action, so it must be skipped.
+		"cid-exited": fakeContainerForPod("cid-exited", "pod-exited", "pod-exited", "ns", runtimeapi.ContainerState_CONTAINER_EXITED),
+	}
+
+	cm := containermap.NewContainerMap()
+	cm.Add("pod-running", "app", "cid-running")
+	cm.Add("pod-exited", "app", "cid-exited")
+
+	RecordStateReset(ManagerCPU, dir, "cpu_manager_state", []ContainerRef{
+		{PodUID: "pod-running", ContainerName: "app"},
+		{PodUID: "pod-exited", ContainerName: "app"},
+	}, errors.New("topology changed"))
+
+	recorder := record.NewFakeRecorder(10)
+	StopVictims(context.Background(), Deps{Runtime: runtime, Recorder: recorder})
+
+	if got := runtime.Containers["cid-running"].State; got != runtimeapi.ContainerState_CONTAINER_EXITED {
+		t.Errorf("running victim was not stopped, state %v", got)
+	}
+
+	marker := readMarker(t, dir)
+	if len(marker.Resets) != 1 {
+		t.Fatalf("marker has %d resets, want 1", len(marker.Resets))
+	}
+	byID := map[string]Victim{}
+	for _, v := range marker.Resets[0].Victims {
+		byID[v.ContainerID] = v
+	}
+
+	if v := byID["cid-running"]; !v.Stopped || v.Error != "" {
+		t.Errorf("running victim: got %+v, want stopped without error", v)
+	}
+	if v := byID["cid-running"]; v.PodName != "pod-running" || v.PodNamespace != "ns" {
+		t.Errorf("running victim was not named from runtime labels: %+v", v)
+	}
+	if v := byID["cid-exited"]; v.Stopped || v.Skipped == "" {
+		t.Errorf("exited victim: got %+v, want skipped and not stopped", v)
+	}
+
+	select {
+	case ev := <-recorder.Events:
+		if ev == "" {
+			t.Error("empty event")
+		}
+	default:
+		t.Error("no pod event emitted for the stopped container")
+	}
+
+	// The registry is drained, so a second call must do nothing at all.
+	runtime.Called = nil
+	StopVictims(context.Background(), Deps{Runtime: runtime, Recorder: recorder})
+	if len(runtime.Called) != 0 {
+		t.Errorf("second StopVictims called the runtime: %v", runtime.Called)
+	}
+}
