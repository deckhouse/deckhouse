+func TestRecordStateResetRecordsEveryDroppedAssignment(t *testing.T) {
+	// The recording phase does not know, and does not ask, which container is
+	// behind an assignment: the managers run before the stop phase takes its
+	// runtime snapshot, and the only source available that early answers
+	// "which container for this pair" at random once a container has been
+	// recreated. So every dropped assignment is recorded, and the stopper says
+	// what became of it.
+	Clear()
+	t.Cleanup(Clear)
+
+	refs := []ContainerRef{
+		{PodUID: "pod-live", ContainerName: "app"},
+		// Left over from before a reboot: the assignment is in the state but
+		// the container is long gone.
+		{PodUID: "pod-gone", ContainerName: "app"},
+	}
+
+	RecordStateReset(ManagerCPU, "/var/lib/kubelet", "cpu_manager_state", refs, errors.New("topology changed"))
+
+	records := Take()
+	if len(records) != 1 {
+		t.Fatalf("recorded %d resets, want 1", len(records))
+	}
+	if records[0].Reason != ReasonStateValidation {
+		t.Errorf("reason: got %q, want %q", records[0].Reason, ReasonStateValidation)
+	}
+	if records[0].StateFile != "/var/lib/kubelet/cpu_manager_state" {
+		t.Errorf("stateFile: got %q", records[0].StateFile)
+	}
+	if len(records[0].Victims) != 2 {
+		t.Fatalf("victims: got %v, want both assignments", records[0].Victims)
+	}
+	for _, v := range records[0].Victims {
+		if v.ContainerID != "" {
+			t.Errorf("victim %+v carries a container id; resolving is the stopper's job", v)
+		}
+		if v.Stopped || v.Skipped != "" || v.Error != "" {
+			t.Errorf("victim %+v already has an outcome before the stop phase ran", v)
+		}
+	}
+}
