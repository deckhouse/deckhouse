+
+	dir := t.TempDir()
+	if ok := ResetCheckpointFile(ManagerMemory, dir, "memory_manager_state", "Static", errors.New("boom")); !ok {
+		t.Fatal("ResetCheckpointFile reported failure for an absent file, want success")
