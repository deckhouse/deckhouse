+package checkpointselfheal
+
+import (
+	"context"
+	"path/filepath"
+	"sync"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/tools/record"
+	internalapi "k8s.io/cri-api/pkg/apis"
+	runtimeapi "k8s.io/cri-api/pkg/apis/runtime/v1"
+	"k8s.io/klog/v2"
+	kubelettypes "k8s.io/kubelet/pkg/types"
+)
+
+const (
+	// stopGracePeriodSeconds is handed to the runtime as the graceful stop
+	// timeout. Pod specs are not available this early, so each pod's own
+	// terminationGracePeriodSeconds cannot be honoured and a single value has
+	// to serve. It is kept short on purpose: kubelet start is blocked while
+	// this runs, and every second spent here is a second in which the node is
+	// not reconciling anything.
+	stopGracePeriodSeconds = int64(15)
+
+	// stopDeadline bounds the whole operation. Every victim of every reset is
+	// stopped in the same pass, so this is the grace period plus runtime
+	// overhead rather than a per-container or per-manager budget. Exceeding it
+	// is reported loudly: a victim left running still holds CPUs or a NUMA
+	// zone the state now thinks are free.
+	stopDeadline = 30 * time.Second
+
+	// eventReason is used for the pod events emitted for stopped containers.
+	// Without it the restart is indistinguishable from an ordinary container
+	// crash in kubectl describe.
+	eventReason = "NUMACheckpointReset"
+)
+
+// Deps is what the stopper needs from the container manager. Both fields are
+// already present at the call site, so wiring this in adds no plumbing.
+type Deps struct {
+	// Runtime is the CRI runtime service. It is used to list containers (to
+	// learn which victims are actually running and which pod they belong to)
+	// and to stop them.
+	Runtime internalapi.RuntimeService
+
+	// Recorder emits pod events. May be nil in standalone mode, in which case
+	// the metric and the log remain.
+	Recorder record.EventRecorder
+}
+
+// StopVictims stops the containers whose assignments were dropped by a reset,
+// so that the kubelet lifecycle recreates them and the managers pin them again
+// from a clean state.
+//
+// It must be called from containerManagerImpl.Start, before Start returns:
+// kubelet marks the runtime synced only afterwards and syncLoop skips every
+// iteration until then, so nothing can be admitted while this runs. That is
+// what keeps a freshly admitted Guaranteed pod from being handed CPUs that a
+// victim is still using.
+//
+// It is a no-op when nothing was reset, which is the overwhelmingly common
+// case, and it never returns an error: by the time it runs, the state has
+// already been reset, so there is nothing a caller could usefully do besides
+// what is already being logged and counted.
+func StopVictims(ctx context.Context, deps Deps) {
+	records := Take()
+	if len(records) == 0 {
+		return
+	}
+
+	klog.InfoS(LogMarker+" bringing containers in line with the reset state",
+		"resets", len(records), "patchVersion", Version)
+	debug("stop phase starting",
+		"resets", len(records), "gracePeriodSeconds", stopGracePeriodSeconds,
+		"deadline", stopDeadline, "hasRuntime", deps.Runtime != nil,
+		"hasRecorder", deps.Recorder != nil)
+	for i := range records {
+		debug("reset to act on",
+			"index", i, "manager", records[i].Manager, "reason", records[i].Reason,
+			"stateFile", records[i].StateFile, "victims", len(records[i].Victims),
+			"cause", records[i].Cause)
+	}
+
+	stateDir := markerDir(records)
+
+	if deps.Runtime == nil {
+		// Nothing can be stopped, and nothing can even be identified, without
+		// a runtime. Say so plainly and still leave the marker: the operator
+		// needs to know the node is in this state even though we could do
+		// nothing about it.
+		giveUp(stateDir, records, "no runtime service available")
+		klog.ErrorS(nil, LogMarker+" no runtime service, victims left running")
+		return
+	}
+
+	byRef, meta, listed := inspectRuntime(ctx, deps.Runtime)
+	if !listed {
+		// The listing is the only thing that turns an assignment into a
+		// container id, so without it there is nothing to aim at. Saying so is
+		// better than the alternative: StopContainer succeeds on a container
+		// that has already exited, so guessing would report a stop that never
+		// restarted anything, in the very file a drain decision is made from.
+		giveUp(stateDir, records, "runtime listing failed, victim could not be identified")
+		klog.ErrorS(nil, LogMarker+" could not list containers, victims left running")
+		return
+	}
+
+	stopCtx, cancel := context.WithTimeout(ctx, stopDeadline)
+	defer cancel()
+
+	// One pass over every reset, waited on once. Draining the resets one after
+	// another shared the deadline in sequence instead, so a manager whose
+	// containers used their whole grace period left nothing for the next one --
+	// and the resets come in the order the managers started, which makes the
+	// starved one memory, the manager with no reconcile loop, where a victim
+	// left running goes on holding a NUMA zone the state now believes free.
+	// The victim sets are not the same set either: memory holds an assignment
+	// for every Guaranteed pod, the CPU manager only for those asking for
+	// whole CPUs.
+	var wg sync.WaitGroup
+	stopped := map[string]ManagerName{}
+	for i := range records {
+		stopRecord(stopCtx, deps, &records[i], byRef, meta, stopped, &wg)
+	}
+	wg.Wait()
+
+	writeMarker(stateDir, records)
+
+	klog.InfoS(LogMarker+" finished, kubelet start continues", "resets", len(records))
+	debug("stop phase finished", "resets", len(records))
+}
+
+// giveUp marks every victim as unhandled and leaves the marker anyway. Reached
+// when the runtime cannot be talked to at all: the containers are still out
+// there holding CPUs and NUMA zones the state has just given up, and the
+// marker is the only thing that will tell anyone.
+func giveUp(stateDir string, records []ResetRecord, reason string) {
+	for i := range records {
+		for j := range records[i].Victims {
+			records[i].Victims[j].Error = reason
+			stopFailuresTotal.WithLabelValues(string(records[i].Manager)).Inc()
+		}
+	}
+	writeMarker(stateDir, records)
+}
+
+// podMeta is the pod identity carried in CRI container labels. The managers key
+// assignments by pod UID only, so the name and namespace have to come from the
+// runtime -- the API is not necessarily reachable this early, and the pod specs
+// certainly are not loaded yet.
+type podMeta struct {
+	name      string
+	namespace string
+}
+
+// containerAtRef is what the runtime has for one assignment key.
+type containerAtRef struct {
+	id      string
+	running bool
+}
+
+// inspectRuntime indexes the runtime's containers by the key the managers use
+// for their assignments, and reports the pod identity of each container.
+//
+// The index is built by walking the containers, because that is the direction
+// in which the answer is unique: a container belongs to exactly one (pod,
+// container name) pair, while a pair can have several containers. Asking the
+// other way round -- give me the container for this pair -- is what
+// containermap.GetContainerID does, and it walks a map keyed by container id
+// and returns whichever match it meets first, so with a recreated container it
+// answers at random. Nothing upstream depends on which id comes back from it;
+// this package used to, and got the already exited predecessor, skipped it as
+// "not running", and left the live container holding the CPUs the state had
+// just released.
+//
+// Where a pair does have several containers -- a recreated one leaves its
+// predecessor behind until garbage collection -- the running one wins, since
+// that is the one physically holding the CPUs and the NUMA zone. That rule is
+// the only ambiguity there is, and it is stated here rather than left to the
+// order something happened to be listed in.
+//
+// The bool reports whether the listing succeeded at all. It has to be handled
+// by the caller: without it no assignment can be turned into a container id.
+func inspectRuntime(ctx context.Context, runtime internalapi.RuntimeService) (map[ContainerRef]containerAtRef, map[string]podMeta, bool) {
+	byRef := map[ContainerRef]containerAtRef{}
+	meta := map[string]podMeta{}
+
+	containers, err := runtime.ListContainers(ctx, nil)
+	if err != nil {
+		klog.ErrorS(err, LogMarker+" could not list containers, victims cannot be identified")
+		return byRef, meta, false
+	}
+
+	for _, c := range containers {
+		running := c.State == runtimeapi.ContainerState_CONTAINER_RUNNING
+		meta[c.Id] = podMeta{
+			name:      c.Labels[kubelettypes.KubernetesPodNameLabel],
+			namespace: c.Labels[kubelettypes.KubernetesPodNamespaceLabel],
+		}
+		// This is the snapshot that explains every "skipped" decision below,
+		// which is otherwise impossible to second-guess.
+		debug("runtime reported a container",
+			"containerID", c.Id, "state", c.State, "running", running,
+			"containerName", c.GetMetadata().GetName(),
+			"pod", c.Labels[kubelettypes.KubernetesPodNameLabel],
+			"namespace", c.Labels[kubelettypes.KubernetesPodNamespaceLabel])
+
+		key := ContainerRef{
+			PodUID:        c.Labels[kubelettypes.KubernetesPodUIDLabel],
+			ContainerName: c.GetMetadata().GetName(),
+		}
+		if key.PodUID == "" || key.ContainerName == "" {
+			continue
+		}
+		if prev, seen := byRef[key]; seen && prev.running && !running {
+			continue
+		}
+		byRef[key] = containerAtRef{id: c.Id, running: running}
+	}
+
+	debug("runtime snapshot complete", "containers", len(containers), "assignmentKeys", len(byRef))
+	return byRef, meta, true
+}
+
+// stopRecord queues one reset's victims for stopping. stopped is shared across
+// resets and carries the manager that owns each container; it is only ever
+// touched from here, and StopVictims calls this for one reset at a time, so it
+// needs no lock.
+func stopRecord(ctx context.Context, deps Deps, rec *ResetRecord, byRef map[ContainerRef]containerAtRef, meta map[string]podMeta, stopped map[string]ManagerName, wg *sync.WaitGroup) {
+	manager := string(rec.Manager)
+
+	for i := range rec.Victims {
+		victim := &rec.Victims[i]
+
+		// The assignment is resolved to a container here and nowhere else, from
+		// the one snapshot taken above. Doing it earlier, while the managers
+		// were still starting, meant asking containermap for the container of a
+		// pair -- a question with no single answer once a container has been
+		// recreated -- and then correcting the answer at this point.
+		at, ok := byRef[ContainerRef{PodUID: victim.PodUID, ContainerName: victim.ContainerName}]
+		if !ok {
+			// An assignment left over for a container that no longer exists at
+			// all: the common case right after a reboot.
+			victim.Skipped = "no container for this assignment"
+			klog.InfoS(LogMarker+" assignment has no container, nothing to stop",
+				"manager", manager, "podUID", victim.PodUID, "containerName", victim.ContainerName)
+			continue
+		}
+
+		victim.ContainerID = at.id
+		if m, ok := meta[at.id]; ok {
+			victim.PodName = m.name
+			victim.PodNamespace = m.namespace
+		}
+
+		// "Victims are only containers that are really running": an assignment
+		// whose container has already exited but has not been garbage collected
+		// yet must not produce a spurious stop.
+		if !at.running {
+			victim.Skipped = "container not running"
+			klog.InfoS(LogMarker+" victim is not running, nothing to stop",
+				"manager", manager, "podUID", victim.PodUID,
+				"containerName", victim.ContainerName, "containerID", victim.ContainerID)
+			continue
+		}
+
+		// Both managers can lose the same container's assignment in the same
+		// start -- a corrupt checkpoint on each, or a policy change that
+		// invalidates both. Recording it as a victim of each is still correct,
+		// but the container must be stopped only once: a second StopContainer
+		// is a no-op at the runtime, yet it still counted a stop and emitted a
+		// second pod event, so summing stopped_containers_total across managers
+		// reported two containers where one had been restarted.
+		if owner, taken := stopped[victim.ContainerID]; taken {
+			victim.Skipped = "already stopped for the " + string(owner) + " manager"
+			klog.InfoS(LogMarker+" victim already stopped for another manager, not stopping again",
+				"manager", manager, "stoppedBy", owner,
+				"pod", klog.KRef(victim.PodNamespace, victim.PodName),
+				"podUID", victim.PodUID, "containerName", victim.ContainerName,
+				"containerID", victim.ContainerID)
+			continue
+		}
+		stopped[victim.ContainerID] = rec.Manager
+
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			stopOne(ctx, deps, rec.Manager, rec.Reason, victim)
+		}()
+	}
+}
+
+func stopOne(ctx context.Context, deps Deps, manager ManagerName, reason Reason, victim *Victim) {
+	klog.InfoS(LogMarker+" stopping container so it is recreated and pinned again",
+		"manager", manager, "reason", reason,
+		"pod", klog.KRef(victim.PodNamespace, victim.PodName), "podUID", victim.PodUID,
+		"containerName", victim.ContainerName, "containerID", victim.ContainerID,
+		"gracePeriodSeconds", stopGracePeriodSeconds)
+
+	started := time.Now()
+	debug("calling StopContainer",
+		"manager", manager, "containerID", victim.ContainerID,
+		"gracePeriodSeconds", stopGracePeriodSeconds)
+
+	if err := deps.Runtime.StopContainer(ctx, victim.ContainerID, stopGracePeriodSeconds); err != nil {
+		debug("StopContainer returned an error",
+			"manager", manager, "containerID", victim.ContainerID,
+			"took", time.Since(started), "err", err)
+		victim.Error = err.Error()
+		stopFailuresTotal.WithLabelValues(string(manager)).Inc()
+		klog.ErrorS(err, LogMarker+" failed to stop container, it may still hold CPUs or a NUMA zone the state considers free",
+			"manager", manager, "pod", klog.KRef(victim.PodNamespace, victim.PodName),
+			"podUID", victim.PodUID, "containerName", victim.ContainerName,
+			"containerID", victim.ContainerID)
+		return
+	}
+
+	victim.Stopped = true
+	stoppedContainersTotal.WithLabelValues(string(manager)).Inc()
+	debug("StopContainer succeeded",
+		"manager", manager, "containerID", victim.ContainerID, "took", time.Since(started))
+	klog.InfoS(LogMarker+" container stopped",
+		"manager", manager, "pod", klog.KRef(victim.PodNamespace, victim.PodName),
+		"podUID", victim.PodUID, "containerName", victim.ContainerName,
+		"containerID", victim.ContainerID)
+
+	emitEvent(deps.Recorder, manager, reason, victim)
+}
+
+// emitEvent puts the reason on the pod itself. Without it the restart looks
+// like an ordinary container crash to whoever runs kubectl describe, and the
+// one piece of information they need -- that the kubelet did this on purpose,
+// and why -- is only in the node's journal.
+//
+// The reference is built by hand because the pod object is not available yet.
+// Name and namespace come from the runtime labels; if they are missing the
+// event would attach to nothing useful, so it is skipped and the log stands.
+func emitEvent(recorder record.EventRecorder, manager ManagerName, reason Reason, victim *Victim) {
+	if recorder == nil || victim.PodName == "" || victim.PodNamespace == "" {
+		return
+	}
+	ref := &v1.ObjectReference{
+		Kind:      "Pod",
+		Name:      victim.PodName,
+		Namespace: victim.PodNamespace,
+		UID:       types.UID(victim.PodUID),
+	}
+	recorder.Eventf(ref, v1.EventTypeWarning, eventReason,
+		"Stopped container %s: the %s manager checkpoint was reset (%s), so the container is recreated to be assigned again",
+		victim.ContainerName, manager, reason)
+}
+
+// markerDir is the directory the marker file goes into: the same directory the
+// manager state files live in, which follows --root-dir.
+func markerDir(records []ResetRecord) string {
+	for _, rec := range records {
+		if rec.StateFile != "" {
+			return filepath.Dir(rec.StateFile)
+		}
+	}
+	return ""
+}
