+package memorymanager
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	cadvisorapi "github.com/google/cadvisor/info/v1"
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/klog/v2/ktesting"
+	"k8s.io/kubernetes/pkg/kubelet/cm/checkpointselfheal"
+	"k8s.io/kubernetes/pkg/kubelet/cm/containermap"
+	"k8s.io/kubernetes/pkg/kubelet/cm/memorymanager/state"
+	"k8s.io/kubernetes/pkg/kubelet/cm/topologymanager"
+)
+
+// These tests cover what a single-NUMA-zone test node cannot reproduce at all:
+// per-zone memory drift, a changed zone count, and a victim holding a zone the
+// reset state believes to be free. On one zone cpuset.mems is always "0", so
+// there is nothing to observe there -- the coverage has to live here.
+
+const (
+	mib = uint64(1024 * 1024)
+	gib = 1024 * mib
+)
+
+// twoZoneMachine is the smallest machine that can drift: two NUMA nodes with
+// equal memory, so that a change on one of them is unambiguous.
+func twoZoneMachine() *cadvisorapi.MachineInfo {
+	return &cadvisorapi.MachineInfo{
+		Topology: []cadvisorapi.Node{
+			{Id: 0, Memory: 4 * gib},
+			{Id: 1, Memory: 4 * gib},
+		},
+	}
+}
+
+func twoZoneReserved() systemReservedMemory {
+	return systemReservedMemory{
+		0: map[v1.ResourceName]uint64{v1.ResourceMemory: 512 * mib},
+		1: map[v1.ResourceName]uint64{v1.ResourceMemory: 512 * mib},
+	}
+}
+
+type selfHealFixture struct {
+	manager  *manager
+	policy   *staticPolicy
+	stateDir string
+}
+
+func newSelfHealFixture(t *testing.T, machineInfo *cadvisorapi.MachineInfo, reserved systemReservedMemory, cm containermap.ContainerMap) *selfHealFixture {
+	t.Helper()
+	_, tCtx := ktesting.NewTestContext(t)
+
+	policy, err := NewPolicyStatic(tCtx, machineInfo, reserved, topologymanager.NewFakeManager())
+	if err != nil {
+		t.Fatalf("building static policy: %v", err)
+	}
+
+	return &selfHealFixture{
+		manager: &manager{
+			policy:             policy,
+			stateFileDirectory: t.TempDir(),
+			containerMap:       cm,
+		},
+		policy: policy.(*staticPolicy),
+	}
+}
+
+// seedCheckpoint writes a checkpoint with a *valid* checksum through the real
+// state package. That matters: writing a broken file would exercise the
+// "cannot read the checkpoint" path, while the drift this file is about is only
+// reachable with a file that reads back perfectly and simply no longer
+// describes the machine.
+func seedCheckpoint(t *testing.T, dir, policyName string, machineState state.NUMANodeMap, assignments state.ContainerMemoryAssignments) {
+	t.Helper()
+	logger, _ := ktesting.NewTestContext(t)
+
+	seed, err := state.NewCheckpointState(logger, dir, memoryManagerStateFileName, policyName)
+	if err != nil {
+		t.Fatalf("seeding checkpoint: %v", err)
+	}
+	seed.SetMachineState(machineState)
+	if assignments != nil {
+		seed.SetMemoryAssignments(assignments)
+	}
+}
+
+func TestStartHealsPerZoneMemoryDrift(t *testing.T) {
+	// The kubernetes/kubernetes#131253 shape: the kernel frees a varying amount
+	// of boot-time reserved memory each boot, so a zone's MemTotal comes back a
+	// few tens of MiB different from what the checkpoint recorded. Upstream
+	// refuses to start; the node then needs a human for a difference that
+	// changes nothing about whether the assignments still fit.
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	_, tCtx := ktesting.NewTestContext(t)
+	f := newSelfHealFixture(t, twoZoneMachine(), twoZoneReserved(), containermap.NewContainerMap())
+
+	drifted := f.policy.getDefaultMachineState()
+	drifted[0].MemoryMap[v1.ResourceMemory].TotalMemSize -= 40 * mib
+	seedCheckpoint(t, f.manager.stateFileDirectory, f.policy.Name(), drifted, nil)
+
+	err := f.manager.Start(tCtx, func() []*v1.Pod { return nil }, &sourcesReadyStub{},
+		mockPodStatusProvider{}, mockRuntimeService{}, containermap.NewContainerMap())
+	if err != nil {
+		t.Fatalf("Start returned %v, want nil: kubelet must come up despite the drift", err)
+	}
+
+	records := checkpointselfheal.Take()
+	if len(records) != 1 {
+		t.Fatalf("recorded %d resets, want exactly 1", len(records))
+	}
+	if records[0].Manager != checkpointselfheal.ManagerMemory {
+		t.Errorf("manager: got %q, want %q", records[0].Manager, checkpointselfheal.ManagerMemory)
+	}
+	if records[0].Reason != checkpointselfheal.ReasonStateValidation {
+		t.Errorf("reason: got %q, want %q", records[0].Reason, checkpointselfheal.ReasonStateValidation)
+	}
+	// Right after a reboot -- which is when drift shows up -- there are no
+	// containers, so the reset is free and nothing is stopped.
+	if len(records[0].Victims) != 0 {
+		t.Errorf("victims: got %v, want none", records[0].Victims)
+	}
+
+	// The state the manager ends up with must describe the machine as it is
+	// now, otherwise the next restart hits the same wall.
+	got := f.manager.state.GetMachineState()
+	want := f.policy.getDefaultMachineState()
+	for _, nodeID := range []int{0, 1} {
+		gotSize := got[nodeID].MemoryMap[v1.ResourceMemory].TotalMemSize
+		wantSize := want[nodeID].MemoryMap[v1.ResourceMemory].TotalMemSize
+		if gotSize != wantSize {
+			t.Errorf("node %d TotalMemSize after heal: got %d, want %d", nodeID, gotSize, wantSize)
+		}
+	}
+}
+
+func TestStartStopsContainerHoldingADriftedZone(t *testing.T) {
+	// The dangerous case, and the one a single-zone node cannot show: a running
+	// container is pinned to a zone, the state is reset, and nothing in the
+	// memory manager will ever rewrite that container's cpuset.mems -- there is
+	// no reconcile loop here, unlike the CPU manager. Left alone it would hold
+	// a zone the state reports as free for as long as it lives, and new pods
+	// would be admitted against memory that is not actually there.
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	_, tCtx := ktesting.NewTestContext(t)
+
+	cm := containermap.NewContainerMap()
+	cm.Add("pod-pinned", "app", "cid-pinned")
+
+	f := newSelfHealFixture(t, twoZoneMachine(), twoZoneReserved(), cm)
+
+	assignments := state.ContainerMemoryAssignments{
+		"pod-pinned": map[string][]state.Block{
+			"app": {{NUMAAffinity: []int{0}, Type: v1.ResourceMemory, Size: gib}},
+		},
+	}
+
+	// Build the state the way validateState would expect it for this
+	// assignment, then drift one zone. The assignment accounting is therefore
+	// correct and the drift is the only divergence.
+	machineState := f.policy.getDefaultMachineState()
+	node0 := machineState[0]
+	node0.NumberOfAssignments++
+	node0.Cells = []int{0}
+	node0.MemoryMap[v1.ResourceMemory].Reserved += gib
+	node0.MemoryMap[v1.ResourceMemory].Free -= gib
+	node0.MemoryMap[v1.ResourceMemory].TotalMemSize -= 40 * mib
+
+	seedCheckpoint(t, f.manager.stateFileDirectory, f.policy.Name(), machineState, assignments)
+
+	err := f.manager.Start(tCtx, func() []*v1.Pod { return nil }, &sourcesReadyStub{},
+		mockPodStatusProvider{}, mockRuntimeService{}, cm)
+	if err != nil {
+		t.Fatalf("Start returned %v, want nil", err)
+	}
+
+	records := checkpointselfheal.Take()
+	if len(records) != 1 {
+		t.Fatalf("recorded %d resets, want exactly 1", len(records))
+	}
+	if len(records[0].Victims) != 1 {
+		t.Fatalf("victims: got %v, want exactly the pinned container", records[0].Victims)
+	}
+	// The victim is named by the assignment key, which is all the recording
+	// phase knows: which container is behind it is resolved later, by the
+	// stopper, from its own runtime snapshot.
+	victim := records[0].Victims[0]
+	if victim.PodUID != "pod-pinned" || victim.ContainerName != "app" {
+		t.Errorf("victim: got %+v, want pod-pinned/app", victim)
+	}
+	if victim.ContainerID != "" {
+		t.Errorf("victim carries container id %q; resolving is the stopper's job", victim.ContainerID)
+	}
+
+	// Collecting victims has to happen before clearing, because afterwards
+	// there is nowhere left to read the assignments from.
+	if len(f.manager.state.GetMemoryAssignments()) != 0 {
+		t.Errorf("assignments survived the reset: %v", f.manager.state.GetMemoryAssignments())
+	}
+}
+
+func TestStartHealsChangedZoneCount(t *testing.T) {
+	// A VM migrated to a host with a different memory map, or an NPS change in
+	// firmware: the checkpoint describes zones that no longer exist.
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	_, tCtx := ktesting.NewTestContext(t)
+	f := newSelfHealFixture(t, twoZoneMachine(), twoZoneReserved(), containermap.NewContainerMap())
+
+	fourZones := &cadvisorapi.MachineInfo{
+		Topology: []cadvisorapi.Node{
+			{Id: 0, Memory: 2 * gib}, {Id: 1, Memory: 2 * gib},
+			{Id: 2, Memory: 2 * gib}, {Id: 3, Memory: 2 * gib},
+		},
+	}
+	stale := newSelfHealFixture(t, fourZones, systemReservedMemory{
+		0: map[v1.ResourceName]uint64{v1.ResourceMemory: 256 * mib},
+		1: map[v1.ResourceName]uint64{v1.ResourceMemory: 256 * mib},
+		2: map[v1.ResourceName]uint64{v1.ResourceMemory: 256 * mib},
+		3: map[v1.ResourceName]uint64{v1.ResourceMemory: 256 * mib},
+	}, containermap.NewContainerMap())
+
+	seedCheckpoint(t, f.manager.stateFileDirectory, f.policy.Name(), stale.policy.getDefaultMachineState(), nil)
+
+	if err := f.manager.Start(tCtx, func() []*v1.Pod { return nil }, &sourcesReadyStub{},
+		mockPodStatusProvider{}, mockRuntimeService{}, containermap.NewContainerMap()); err != nil {
+		t.Fatalf("Start returned %v, want nil", err)
+	}
+
+	if got := checkpointselfheal.Pending(); got != 1 {
+		t.Fatalf("recorded %d resets, want 1", got)
+	}
+	if got := len(f.manager.state.GetMachineState()); got != 2 {
+		t.Errorf("machine state describes %d zones, want 2 (the machine we actually have)", got)
+	}
+}
+
+func TestStartHealsUnreadableCheckpoint(t *testing.T) {
+	// A torn write leaves a file whose checksum does not match. The victims are
+	// still recoverable from it, which is why the file is read before it is
+	// removed.
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	_, tCtx := ktesting.NewTestContext(t)
+
+	cm := containermap.NewContainerMap()
+	cm.Add("pod-a", "app", "cid-a")
+
+	f := newSelfHealFixture(t, twoZoneMachine(), twoZoneReserved(), cm)
+	path := filepath.Join(f.manager.stateFileDirectory, memoryManagerStateFileName)
+	blob := `{"policyName":"Static","machineState":{},"entries":{"pod-a":{"app":[{"numaAffinity":[0],"type":"memory","size":1024}]}},"checksum":42}`
+	if err := os.WriteFile(path, []byte(blob), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := f.manager.Start(tCtx, func() []*v1.Pod { return nil }, &sourcesReadyStub{},
+		mockPodStatusProvider{}, mockRuntimeService{}, cm); err != nil {
+		t.Fatalf("Start returned %v, want nil", err)
+	}
+
+	records := checkpointselfheal.Take()
+	if len(records) != 1 {
+		t.Fatalf("recorded %d resets, want 1", len(records))
+	}
+	if records[0].Reason != checkpointselfheal.ReasonCheckpointCorrupt {
+		t.Errorf("reason: got %q, want %q", records[0].Reason, checkpointselfheal.ReasonCheckpointCorrupt)
+	}
+	if len(records[0].Victims) != 1 || records[0].Victims[0].PodUID != "pod-a" {
+		t.Errorf("victims: got %v, want pod-a recovered from the unreadable file", records[0].Victims)
+	}
+}
+
+func TestStartLeavesAHealthyCheckpointAlone(t *testing.T) {
+	checkpointselfheal.Clear()
+	t.Cleanup(checkpointselfheal.Clear)
+
+	_, tCtx := ktesting.NewTestContext(t)
+	f := newSelfHealFixture(t, twoZoneMachine(), twoZoneReserved(), containermap.NewContainerMap())
+	seedCheckpoint(t, f.manager.stateFileDirectory, f.policy.Name(), f.policy.getDefaultMachineState(), nil)
+
+	if err := f.manager.Start(tCtx, func() []*v1.Pod { return nil }, &sourcesReadyStub{},
+		mockPodStatusProvider{}, mockRuntimeService{}, containermap.NewContainerMap()); err != nil {
+		t.Fatalf("Start returned %v, want nil", err)
+	}
+	if got := checkpointselfheal.Pending(); got != 0 {
+		t.Errorf("recorded %d resets on a healthy node, want 0", got)
+	}
+}
