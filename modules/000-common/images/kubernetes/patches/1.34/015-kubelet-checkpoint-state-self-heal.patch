+func TestStopVictimsEventsDistinguishSuccessFromFailure(t *testing.T) {
+	// The two outcomes must not share a reason: "the workload was restarted" is
+	// routine, "this container still holds resources the state gave away" needs
+	// a human, and only the second one is worth alerting on. Same reasoning as
+	// the split between stopped_containers_total and stop_failures_total.
+	for _, tc := range []struct {
+		name       string
+		injectErr  bool
+		wantReason string
+	}{
+		{name: "stopped", injectErr: false, wantReason: eventReason},
+		{name: "could not stop", injectErr: true, wantReason: eventReasonFailed},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			Clear()
+			t.Cleanup(Clear)
+
+			dir := t.TempDir()
+			runtime := apitest.NewFakeRuntimeService()
+			runtime.Containers = map[string]*apitest.FakeContainer{
+				"cid": fakeContainerForPod("cid", "pod", "pod", "ns", runtimeapi.ContainerState_CONTAINER_RUNNING),
+			}
+			if tc.injectErr {
+				runtime.InjectError("StopContainer", errors.New("runtime is busy"))
+			}
+
+			cm := containermap.NewContainerMap()
+			cm.Add("pod", "app", "cid")
+			RecordStateReset(ManagerCPU, dir, "cpu_manager_state",
+				[]ContainerRef{{PodUID: "pod", ContainerName: "app"}}, errors.New("boom"))
+
+			recorder := record.NewFakeRecorder(10)
+			StopVictims(context.Background(), Deps{Runtime: runtime, Recorder: recorder})
+
+			select {
+			case ev := <-recorder.Events:
+				if !strings.Contains(ev, tc.wantReason) {
+					t.Errorf("event %q, want reason %q", ev, tc.wantReason)
+				}
+				// The reasons must not be prefixes of each other in a way that
+				// makes a filter match both.
+				if tc.wantReason == eventReason && strings.Contains(ev, eventReasonFailed) {
+					t.Errorf("success event %q also matches the failure reason", ev)
+				}
+			default:
+				t.Fatal("no event emitted")
+			}
+		})
+	}
+}
