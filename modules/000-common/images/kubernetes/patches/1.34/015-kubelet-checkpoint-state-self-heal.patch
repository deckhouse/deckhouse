+func TestStopVictimsRecordsStopFailures(t *testing.T) {
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+
+	runtime := apitest.NewFakeRuntimeService()
+	runtime.Containers = map[string]*apitest.FakeContainer{
+		"cid": fakeContainerForPod("cid", "pod", "pod", "ns", runtimeapi.ContainerState_CONTAINER_RUNNING),
+	}
+	runtime.InjectError("StopContainer", errors.New("runtime is busy"))
+
+	cm := containermap.NewContainerMap()
+	cm.Add("pod", "app", "cid")
+
+	RecordStateReset(ManagerMemory, dir, "memory_manager_state",
+		[]ContainerRef{{PodUID: "pod", ContainerName: "app"}}, errors.New("machine state differs"))
+
+	StopVictims(context.Background(), Deps{Runtime: runtime})
+
+	marker := readMarker(t, dir)
+	victims := marker.Resets[0].Victims
+	if len(victims) != 1 {
+		t.Fatalf("marker has %d victims, want 1", len(victims))
+	}
+	// A victim that could not be stopped is the case that matters most: it is
+	// still holding a NUMA zone the reset state believes to be free, and the
+	// marker is what tells the operator the node needs attention.
+	if victims[0].Stopped || victims[0].Error == "" {
+		t.Errorf("failed victim: got %+v, want not stopped with an error", victims[0])
+	}
+}
