@@ -0,0 +1,73 @@
+/*
+Copyright 2026 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package checkpointselfheal
+
+import (
+	"k8s.io/component-base/metrics"
+	"k8s.io/component-base/metrics/legacyregistry"
+)
+
+// Registered here rather than in pkg/kubelet/metrics so this change does not
+// touch that file. legacyregistry is the registry kubelet serves on /metrics.
+//
+// Alerting on resetsTotal is not optional: this turns a loud refusal to start
+// into a quiet repair, so a bug in kubelet config generation would restart
+// pinned workload across a whole NodeGroup instead of failing visibly. The
+// counters live in the kubelet process and reset with it, so alert on
+// increase() rather than an absolute value.
+
+const subsystem = "kubelet"
+
+var (
+	resetsTotal = metrics.NewCounterVec(
+		&metrics.CounterOpts{
+			Subsystem:      subsystem,
+			Name:           "checkpoint_state_reset_total",
+			Help:           "Cumulative number of times the kubelet reset a CPU or memory manager checkpoint instead of refusing to start. Any increase is a real event.",
+			StabilityLevel: metrics.ALPHA,
+		},
+		[]string{"manager", "reason"},
+	)
+
+	stoppedContainersTotal = metrics.NewCounterVec(
+		&metrics.CounterOpts{
+			Subsystem:      subsystem,
+			Name:           "checkpoint_state_reset_stopped_containers_total",
+			Help:           "Cumulative number of running containers stopped by the kubelet after resetting a CPU or memory manager checkpoint, so that they are recreated and pinned again.",
+			StabilityLevel: metrics.ALPHA,
+		},
+		[]string{"manager"},
+	)
+
+	// Any increase means a container may still hold CPUs or a NUMA zone that
+	// the reset state believes to be free.
+	stopFailuresTotal = metrics.NewCounterVec(
+		&metrics.CounterOpts{
+			Subsystem:      subsystem,
+			Name:           "checkpoint_state_reset_stop_failures_total",
+			Help:           "Cumulative number of containers the kubelet failed to stop after resetting a CPU or memory manager checkpoint. Any increase means a container may still hold CPUs or a NUMA zone that the state considers free.",
+			StabilityLevel: metrics.ALPHA,
+		},
+		[]string{"manager"},
+	)
+)
+
+func init() {
+	legacyregistry.MustRegister(resetsTotal)
+	legacyregistry.MustRegister(stoppedContainersTotal)
+	legacyregistry.MustRegister(stopFailuresTotal)
+}
diff --git a/pkg/kubelet/cm/checkpointselfheal/selfheal.go b/pkg/kubelet/cm/checkpointselfheal/selfheal.go
new file mode 100644
index 00000000000..08461a3f735
--- /dev/null
+++ b/pkg/kubelet/cm/checkpointselfheal/selfheal.go
@@ -0,0 +1,248 @@
+/*
+Copyright 2026 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package checkpointselfheal
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sort"
+	"sync"
+	"time"
+
+	"k8s.io/klog/v2"
+)
+
+// MarkerFileName is the machine-readable trace left in the kubelet state
+// directory, so its path follows --root-dir.
+const MarkerFileName = "d8-numa-selfheal.json"
+
+// markerHistoryLimit caps how many resets the marker keeps; the newest win.
+const markerHistoryLimit = 16
+
+// ManagerName is the manager whose checkpoint was reset.
+type ManagerName string
+
+const (
+	ManagerCPU    ManagerName = "cpu"
+	ManagerMemory ManagerName = "memory"
+)
+
+// Reason is derived from the code path taken, never from error text, so it is
+// safe to use as a metric label.
+type Reason string
+
+const (
+	ReasonPolicyMismatch    Reason = "policy_mismatch"
+	ReasonCheckpointCorrupt Reason = "checkpoint_corrupt"
+	ReasonStateValidation   Reason = "state_validation"
+)
+
+// ContainerRef identifies a container the way the managers key their
+// assignments: by pod UID and container name, not by container id. A recreated
+// container keeps the same ref, which is why clearing the state is required and
+// stopping alone would not be enough.
+type ContainerRef struct {
+	PodUID        string `json:"podUID"`
+	ContainerName string `json:"containerName"`
+}
+
+// Victim is a dropped assignment and what became of the container that held it.
+// Only PodUID and ContainerName are known when the reset is recorded; the rest
+// is filled in by the stopper.
+type Victim struct {
+	PodUID        string `json:"podUID"`
+	ContainerName string `json:"containerName"`
+	ContainerID   string `json:"containerID"`
+
+	PodName      string `json:"podName,omitempty"`
+	PodNamespace string `json:"podNamespace,omitempty"`
+
+	Stopped bool   `json:"stopped"`
+	Skipped string `json:"skipped,omitempty"`
+	Error   string `json:"error,omitempty"`
+}
+
+// ResetRecord is one manager's reset.
+type ResetRecord struct {
+	Manager    ManagerName `json:"manager"`
+	Reason     Reason      `json:"reason"`
+	Cause      string      `json:"cause"`
+	StateFile  string      `json:"stateFile"`
+	DetectedAt time.Time   `json:"detectedAt"`
+	Victims    []Victim    `json:"victims"`
+}
+
+// Marker is the JSON written to MarkerFileName. Whether a victim can restart on
+// its own needs the pod spec, which is not available this early, so that
+// classification is left to the reader of this file.
+type Marker struct {
+	Version   string        `json:"version"`
+	WrittenAt time.Time     `json:"writtenAt"`
+	Resets    []ResetRecord `json:"resets"`
+}
+
+// markerVersion identifies the marker format.
+const markerVersion = "1"
+
+// registry carries what the managers found to StopVictims, which acts on it.
+// manager.Start returns only an error, so nothing can travel up the call stack
+// without changing the upstream manager interfaces. Package level because
+// kubelet is one process and both managers are singletons.
+var registry struct {
+	mu      sync.Mutex
+	records []ResetRecord
+}
+
+// Clear drops everything recorded so far. Only for tests.
+func Clear() {
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	registry.records = nil
+}
+
+// Take returns everything recorded so far and empties the registry, so a second
+// StopVictims call is a no-op.
+func Take() []ResetRecord {
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	records := registry.records
+	registry.records = nil
+	return records
+}
+
+// Pending reports how many resets are waiting to be acted on.
+func Pending() int {
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	return len(registry.records)
+}
+
+// LogHealthy records that a manager's checkpoint validated cleanly, which is
+// how "nothing was wrong" is told apart from "this code did not run".
+func LogHealthy(manager ManagerName) {
+	klog.V(4).InfoS("Checkpoint validated, nothing to do", "manager", manager)
+}
+
+// RefsFrom turns a manager's assignment map into container refs. Both managers
+// key assignments as podUID -> containerName -> something.
+func RefsFrom[T any](assignments map[string]map[string]T) []ContainerRef {
+	var refs []ContainerRef
+	for podUID, containers := range assignments {
+		for containerName := range containers {
+			refs = append(refs, ContainerRef{PodUID: podUID, ContainerName: containerName})
+		}
+	}
+	sort.Slice(refs, func(i, j int) bool {
+		if refs[i].PodUID != refs[j].PodUID {
+			return refs[i].PodUID < refs[j].PodUID
+		}
+		return refs[i].ContainerName < refs[j].ContainerName
+	})
+	return refs
+}
+
+// RecordStateReset remembers the assignments a manager is about to drop with
+// ClearState, and must therefore be called before it. It cannot fail and does
+// not block.
+func RecordStateReset(manager ManagerName, stateDir, checkpointName string, refs []ContainerRef, cause error) {
+	recordReset(manager, ReasonStateValidation, filepath.Join(stateDir, checkpointName), refs, cause)
+}
+
+// ResetCheckpointFile removes a checkpoint the manager could not restore and
+// records what was lost, reading the file before removing it. It reports whether
+// the file is gone; false means the caller must fail as it did before.
+func ResetCheckpointFile(manager ManagerName, stateDir, checkpointName, configuredPolicy string, cause error) bool {
+	path := filepath.Join(stateDir, checkpointName)
+
+	filePolicy, refs := inspectCheckpoint(manager, stateDir, checkpointName)
+	reason := ReasonCheckpointCorrupt
+	if filePolicy != "" && filePolicy != configuredPolicy {
+		reason = ReasonPolicyMismatch
+	}
+
+	if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+		klog.ErrorS(err, "Could not remove unusable checkpoint, kubelet will fail as before",
+			"manager", manager, "stateFile", path)
+		return false
+	}
+
+	recordReset(manager, reason, path, refs, cause)
+	return true
+}
+
+func recordReset(manager ManagerName, reason Reason, stateFile string, refs []ContainerRef, cause error) {
+	victims := make([]Victim, 0, len(refs))
+	for _, ref := range refs {
+		victims = append(victims, Victim{PodUID: ref.PodUID, ContainerName: ref.ContainerName})
+	}
+
+	rec := ResetRecord{
+		Manager:    manager,
+		Reason:     reason,
+		StateFile:  stateFile,
+		DetectedAt: time.Now(),
+		Victims:    victims,
+	}
+	if cause != nil {
+		rec.Cause = cause.Error()
+	}
+
+	registry.mu.Lock()
+	registry.records = append(registry.records, rec)
+	registry.mu.Unlock()
+
+	resetsTotal.WithLabelValues(string(manager), string(reason)).Inc()
+	klog.ErrorS(cause, "Checkpoint unusable, resetting manager state",
+		"manager", manager, "reason", reason, "stateFile", stateFile,
+		"lostAssignments", len(refs))
+}
+
+// writeMarker leaves the trace for whoever has to decide whether this node needs
+// a drain. Resets already in the file are carried forward: nothing but the
+// consumer removes it, so what is still there describes a heal nobody has acted
+// on -- possibly one whose victim could not be stopped. A write failure is
+// logged and ignored; the containers have already been dealt with.
+func writeMarker(dir string, records []ResetRecord) {
+	if dir == "" {
+		return
+	}
+	path := filepath.Join(dir, MarkerFileName)
+
+	var previous Marker
+	if blob, err := os.ReadFile(path); err == nil {
+		if err := json.Unmarshal(blob, &previous); err != nil {
+			klog.ErrorS(err, "Existing marker file cannot be decoded, replacing it", "path", path)
+		}
+	}
+	resets := append(previous.Resets, records...)
+	if len(resets) > markerHistoryLimit {
+		resets = resets[len(resets)-markerHistoryLimit:]
+	}
+
+	blob, err := json.MarshalIndent(Marker{Version: markerVersion, WrittenAt: time.Now(), Resets: resets}, "", "  ")
+	if err != nil {
+		klog.ErrorS(err, "Could not encode marker file", "path", path)
+		return
+	}
+	if err := os.WriteFile(path, append(blob, '\n'), 0600); err != nil {
+		klog.ErrorS(err, "Could not write marker file", "path", path)
+		return
+	}
+	klog.V(2).InfoS("Wrote checkpoint reset marker",
+		"path", path, "resets", len(records), "carriedForward", len(previous.Resets))
+}
diff --git a/pkg/kubelet/cm/checkpointselfheal/stop.go b/pkg/kubelet/cm/checkpointselfheal/stop.go
new file mode 100644
index 00000000000..ac02fe74c14
--- /dev/null
+++ b/pkg/kubelet/cm/checkpointselfheal/stop.go
@@ -0,0 +1,283 @@
+/*
+Copyright 2026 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package checkpointselfheal
+
+import (
+	"context"
+	"path/filepath"
+	"sync"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/tools/record"
+	internalapi "k8s.io/cri-api/pkg/apis"
+	runtimeapi "k8s.io/cri-api/pkg/apis/runtime/v1"
+	"k8s.io/klog/v2"
+	kubelettypes "k8s.io/kubelet/pkg/types"
+)
+
+const (
+	// stopGracePeriodSeconds is handed to the runtime. Pod specs are not
+	// available this early, so each pod's own terminationGracePeriodSeconds
+	// cannot be honoured and a single short value has to serve.
+	stopGracePeriodSeconds = int64(15)
+
+	// stopDeadline bounds the whole stop phase. Every victim of every reset is
+	// stopped in the same pass, so this is the grace period plus runtime
+	// overhead rather than a per-manager budget.
+	stopDeadline = 30 * time.Second
+
+	eventReason = "NUMACheckpointReset"
+
+	// eventReasonFailed marks the outcome that needs a human, kept separate so
+	// it can be alerted on.
+	eventReasonFailed = "NUMACheckpointResetFailed"
+)
+
+// Deps is what the stop phase needs; both are already present at the call site.
+type Deps struct {
+	Runtime  internalapi.RuntimeService
+	Recorder record.EventRecorder
+}
+
+// StopVictims stops the containers whose assignments were dropped by a reset, so
+// that the kubelet lifecycle recreates them and the managers pin them again.
+//
+// It must be called from containerManagerImpl.Start, before Start returns:
+// kubelet marks the runtime synced only afterwards and syncLoop skips every
+// iteration until then, so nothing can be admitted while this runs. It never
+// returns an error -- the state is already reset, and everything a caller could
+// do is logged and counted here.
+func StopVictims(ctx context.Context, deps Deps) {
+	records := Take()
+	if len(records) == 0 {
+		return
+	}
+
+	stateDir := markerDir(records)
+
+	if deps.Runtime == nil {
+		giveUp(stateDir, records, "no runtime service available")
+		klog.ErrorS(nil, "No runtime service, checkpoint reset victims left running")
+		return
+	}
+
+	byRef, meta, listed := inspectRuntime(ctx, deps.Runtime)
+	if !listed {
+		// Without the listing an assignment cannot be turned into a container
+		// id. Saying so beats guessing: StopContainer succeeds on an already
+		// exited container, so a guess would report a stop that never happened.
+		giveUp(stateDir, records, "runtime listing failed, victim could not be identified")
+		return
+	}
+
+	stopCtx, cancel := context.WithTimeout(ctx, stopDeadline)
+	defer cancel()
+
+	var wg sync.WaitGroup
+	stopped := map[string]ManagerName{}
+	for i := range records {
+		stopRecord(stopCtx, deps, &records[i], byRef, meta, stopped, &wg)
+	}
+	wg.Wait()
+
+	writeMarker(stateDir, records)
+}
+
+// giveUp marks every victim as unhandled and leaves the marker anyway: the
+// containers are still out there holding resources the state has given up.
+func giveUp(stateDir string, records []ResetRecord, reason string) {
+	for i := range records {
+		for j := range records[i].Victims {
+			records[i].Victims[j].Error = reason
+			stopFailuresTotal.WithLabelValues(string(records[i].Manager)).Inc()
+		}
+	}
+	writeMarker(stateDir, records)
+}
+
+// podMeta is the pod identity carried in CRI container labels; the managers key
+// assignments by pod UID only, and the API is not necessarily reachable yet.
+type podMeta struct {
+	name      string
+	namespace string
+}
+
+// containerAtRef is what the runtime has for one assignment key.
+type containerAtRef struct {
+	id      string
+	running bool
+}
+
+// inspectRuntime indexes the runtime's containers by assignment key.
+//
+// The index is built by walking containers, the direction in which the answer is
+// unique: a container belongs to exactly one (pod, container name) pair, while a
+// pair can have several containers -- a recreated one leaves its predecessor
+// behind until garbage collection. Where a pair does have several, the running
+// one wins, since that is the one physically holding the CPUs and the zone.
+//
+// The bool reports whether the listing succeeded; without it no assignment can
+// be resolved at all.
+func inspectRuntime(ctx context.Context, runtime internalapi.RuntimeService) (map[ContainerRef]containerAtRef, map[string]podMeta, bool) {
+	byRef := map[ContainerRef]containerAtRef{}
+	meta := map[string]podMeta{}
+
+	containers, err := runtime.ListContainers(ctx, nil)
+	if err != nil {
+		klog.ErrorS(err, "Could not list containers, checkpoint reset victims cannot be identified")
+		return byRef, meta, false
+	}
+
+	for _, c := range containers {
+		running := c.State == runtimeapi.ContainerState_CONTAINER_RUNNING
+		meta[c.Id] = podMeta{
+			name:      c.Labels[kubelettypes.KubernetesPodNameLabel],
+			namespace: c.Labels[kubelettypes.KubernetesPodNamespaceLabel],
+		}
+
+		key := ContainerRef{
+			PodUID:        c.Labels[kubelettypes.KubernetesPodUIDLabel],
+			ContainerName: c.GetMetadata().GetName(),
+		}
+		if key.PodUID == "" || key.ContainerName == "" {
+			continue
+		}
+		if prev, seen := byRef[key]; seen && prev.running && !running {
+			continue
+		}
+		byRef[key] = containerAtRef{id: c.Id, running: running}
+	}
+	return byRef, meta, true
+}
+
+// stopRecord queues one reset's victims for stopping. stopped is shared across
+// resets and is only touched from here, which StopVictims calls one reset at a
+// time, so it needs no lock.
+func stopRecord(ctx context.Context, deps Deps, rec *ResetRecord, byRef map[ContainerRef]containerAtRef, meta map[string]podMeta, stopped map[string]ManagerName, wg *sync.WaitGroup) {
+	for i := range rec.Victims {
+		victim := &rec.Victims[i]
+
+		at, ok := byRef[ContainerRef{PodUID: victim.PodUID, ContainerName: victim.ContainerName}]
+		if !ok {
+			// An assignment left over for a container that no longer exists:
+			// the common case right after a reboot.
+			victim.Skipped = "no container for this assignment"
+			continue
+		}
+
+		victim.ContainerID = at.id
+		if m, ok := meta[at.id]; ok {
+			victim.PodName = m.name
+			victim.PodNamespace = m.namespace
+		}
+
+		if !at.running {
+			victim.Skipped = "container not running"
+			continue
+		}
+
+		// Both managers can lose the same container's assignment in one start.
+		// Recording it for each is correct, but stopping it twice would count
+		// two restarts and emit two events where one container was restarted.
+		if owner, taken := stopped[victim.ContainerID]; taken {
+			victim.Skipped = "already stopped for the " + string(owner) + " manager"
+			continue
+		}
+		stopped[victim.ContainerID] = rec.Manager
+
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			stopOne(ctx, deps, rec.Manager, rec.Reason, victim)
+		}()
+	}
+}
+
+func stopOne(ctx context.Context, deps Deps, manager ManagerName, reason Reason, victim *Victim) {
+	if err := deps.Runtime.StopContainer(ctx, victim.ContainerID, stopGracePeriodSeconds); err != nil {
+		victim.Error = err.Error()
+		stopFailuresTotal.WithLabelValues(string(manager)).Inc()
+		klog.ErrorS(err, "Failed to stop container, it may still hold CPUs or a NUMA zone the state considers free",
+			"manager", manager, "pod", klog.KRef(victim.PodNamespace, victim.PodName),
+			"containerName", victim.ContainerName, "containerID", victim.ContainerID)
+		emitStopFailedEvent(deps.Recorder, manager, reason, victim, err)
+		return
+	}
+
+	victim.Stopped = true
+	stoppedContainersTotal.WithLabelValues(string(manager)).Inc()
+	klog.InfoS("Stopped container after checkpoint reset, it will be recreated and pinned again",
+		"manager", manager, "reason", reason, "pod", klog.KRef(victim.PodNamespace, victim.PodName),
+		"containerName", victim.ContainerName, "containerID", victim.ContainerID)
+
+	emitEvent(deps.Recorder, manager, reason, victim)
+}
+
+// emitEvent puts the reason on the pod. The stop goes straight to the runtime,
+// bypassing kubelet's kill path, so kubelet emits no Killing event of its own
+// and nothing would explain the restart between Created and Started.
+func emitEvent(recorder record.EventRecorder, manager ManagerName, reason Reason, victim *Victim) {
+	ref := podRef(recorder, victim)
+	if ref == nil {
+		return
+	}
+	recorder.Eventf(ref, v1.EventTypeWarning, eventReason,
+		"Stopped container %s: the %s manager checkpoint was reset (%s), so the container is recreated to be assigned again",
+		victim.ContainerName, manager, reason)
+}
+
+// emitStopFailedEvent reports the one outcome that needs a human: the container
+// still runs while its CPUs or zone are already given away, and without this
+// event kubectl describe shows nothing at all for this case.
+func emitStopFailedEvent(recorder record.EventRecorder, manager ManagerName, reason Reason, victim *Victim, cause error) {
+	ref := podRef(recorder, victim)
+	if ref == nil {
+		return
+	}
+	recorder.Eventf(ref, v1.EventTypeWarning, eventReasonFailed,
+		"Failed to stop container %s after the %s manager checkpoint was reset (%s): %v. "+
+			"The container is still running with an assignment the reset state no longer has, "+
+			"so it may hold CPUs or a NUMA zone that the state now considers free. This node needs attention.",
+		victim.ContainerName, manager, reason, cause)
+}
+
+// podRef builds the reference by hand, because the pod object is not loaded this
+// early. A nil recorder is standalone mode, where there is no API at all.
+func podRef(recorder record.EventRecorder, victim *Victim) *v1.ObjectReference {
+	if recorder == nil || victim.PodName == "" || victim.PodNamespace == "" {
+		return nil
+	}
+	return &v1.ObjectReference{
+		Kind:      "Pod",
+		Name:      victim.PodName,
+		Namespace: victim.PodNamespace,
+		UID:       types.UID(victim.PodUID),
+	}
+}
+
+// markerDir is the directory the manager state files live in, which follows
+// --root-dir.
+func markerDir(records []ResetRecord) string {
+	for _, rec := range records {
+		if rec.StateFile != "" {
+			return filepath.Dir(rec.StateFile)
+		}
+	}
+	return ""
+}
