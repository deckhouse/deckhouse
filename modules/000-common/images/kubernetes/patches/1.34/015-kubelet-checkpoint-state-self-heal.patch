+func TestStopVictimsStopsAContainerOnceAcrossManagers(t *testing.T) {
+	// Found on a cluster: corrupting both checkpoints while a Guaranteed pod was
+	// running made each manager record the same container as its victim, and the
+	// container was stopped twice. The second stop is a no-op at the runtime, but
+	// it counted a stop and emitted a second pod event, so
+	// stopped_containers_total summed to two while restartCount showed one
+	// restart. Each reset must still record the victim -- both managers really
+	// did lose the assignment -- but the stop happens once.
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+
+	const podUID = "pod-shared"
+	runtime := apitest.NewFakeRuntimeService()
+	runtime.Containers = map[string]*apitest.FakeContainer{
+		"cid": fakeContainerForPod("cid", podUID, "numa-pinned", "default", runtimeapi.ContainerState_CONTAINER_RUNNING),
+	}
+
+	cm := containermap.NewContainerMap()
+	cm.Add(podUID, "app", "cid")
+
+	refs := []ContainerRef{{PodUID: podUID, ContainerName: "app"}}
+	RecordStateReset(ManagerCPU, dir, "cpu_manager_state", refs, errors.New("checkpoint is corrupted"))
+	RecordStateReset(ManagerMemory, dir, "memory_manager_state", refs, errors.New("checkpoint is corrupted"))
+
+	recorder := record.NewFakeRecorder(10)
+	StopVictims(context.Background(), Deps{Runtime: runtime, Recorder: recorder})
+
+	stops := 0
+	for _, call := range runtime.Called {
+		if call == "StopContainer" {
+			stops++
+		}
+	}
+	if stops != 1 {
+		t.Errorf("StopContainer called %d times, want exactly 1", stops)
+	}
+
+	events := 0
+	for {
+		select {
+		case <-recorder.Events:
+			events++
+			continue
+		default:
+		}
+		break
+	}
+	if events != 1 {
+		t.Errorf("emitted %d pod events, want exactly 1", events)
+	}
+
+	// Both resets keep the victim, but only one of them reports a stop.
+	marker := readMarker(t, dir)
+	if len(marker.Resets) != 2 {
+		t.Fatalf("marker has %d resets, want 2", len(marker.Resets))
+	}
+	stopped, skipped := 0, 0
+	for _, r := range marker.Resets {
+		if len(r.Victims) != 1 {
+			t.Fatalf("reset %s has %d victims, want 1", r.Manager, len(r.Victims))
+		}
+		switch v := r.Victims[0]; {
+		case v.Stopped:
+			stopped++
+		case v.Skipped != "":
+			skipped++
+		default:
+			t.Errorf("victim of %s is neither stopped nor skipped: %+v", r.Manager, v)
+		}
+	}
+	if stopped != 1 || skipped != 1 {
+		t.Errorf("marker reports stopped=%d skipped=%d, want 1 and 1", stopped, skipped)
+	}
+}
+
+// gateRuntime holds every StopContainer call until the expected number of them
+// are in flight together, which is how "one pass over every victim" is
+// asserted without depending on timing.
+type gateRuntime struct {
+	internalapi.RuntimeService
+
+	want int
+	mu   sync.Mutex
+	seen int
+	once sync.Once
+	all  chan struct{}
+}
+
+func (g *gateRuntime) StopContainer(ctx context.Context, containerID string, timeout int64) error {
+	g.mu.Lock()
+	g.seen++
+	reached := g.seen >= g.want
+	g.mu.Unlock()
+	if reached {
+		g.once.Do(func() { close(g.all) })
+	}
+	select {
+	case <-g.all:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	return g.RuntimeService.StopContainer(ctx, containerID, timeout)
+}
+
+func TestStopVictimsStopsEveryResetsVictimsInOnePass(t *testing.T) {
+	// The two managers do not hold the same set of assignments: memory holds
+	// one for every Guaranteed pod, the CPU manager only for those asking for
+	// whole CPUs, so a Guaranteed pod with a fractional CPU request is a victim
+	// of memory alone. Draining the resets one after another made them share
+	// the deadline in sequence, and since the resets come in the order the
+	// managers started, the starved one was memory -- the manager with no
+	// reconcile loop, where a victim left running goes on holding a NUMA zone
+	// the reset state believes to be free.
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+
+	fake := apitest.NewFakeRuntimeService()
+	fake.Containers = map[string]*apitest.FakeContainer{
+		"cid-cpu": fakeContainerForPod("cid-cpu", "pod-cpu", "pinned-cpu", "ns", runtimeapi.ContainerState_CONTAINER_RUNNING),
+		"cid-mem": fakeContainerForPod("cid-mem", "pod-mem", "pinned-mem", "ns", runtimeapi.ContainerState_CONTAINER_RUNNING),
+	}
+	runtime := &gateRuntime{RuntimeService: fake, want: 2, all: make(chan struct{})}
+
+	cm := containermap.NewContainerMap()
+	cm.Add("pod-cpu", "app", "cid-cpu")
+	cm.Add("pod-mem", "app", "cid-mem")
+
+	RecordStateReset(ManagerCPU, dir, "cpu_manager_state",
+		[]ContainerRef{{PodUID: "pod-cpu", ContainerName: "app"}}, errors.New("topology changed"))
+	RecordStateReset(ManagerMemory, dir, "memory_manager_state",
+		[]ContainerRef{{PodUID: "pod-mem", ContainerName: "app"}}, errors.New("machine state differs"))
+
+	// Shorter than stopDeadline, so a regression fails here quickly instead of
+	// waiting out the real budget.
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	StopVictims(ctx, Deps{Runtime: runtime})
+
+	for _, rec := range readMarker(t, dir).Resets {
+		for _, v := range rec.Victims {
+			if !v.Stopped {
+				t.Errorf("victim of the %s manager was not stopped: %+v", rec.Manager, v)
+			}
+		}
+	}
+}
+
+func TestWriteMarkerCarriesForwardResetsNobodyConsumed(t *testing.T) {
+	// Only the consumer removes the marker, so a marker still on disk describes
+	// a heal nobody has acted on. Replacing it on the next heal threw the older
+	// record away -- including a victim that could not be stopped, the one case
+	// that means the node needs a drain.
+	Clear()
+	t.Cleanup(Clear)
+
+	dir := t.TempDir()
+
+	failing := apitest.NewFakeRuntimeService()
+	failing.Containers = map[string]*apitest.FakeContainer{
+		"cid-first": fakeContainerForPod("cid-first", "pod-first", "first", "ns", runtimeapi.ContainerState_CONTAINER_RUNNING),
+	}
+	failing.InjectError("StopContainer", errors.New("runtime is busy"))
+
+	cmFirst := containermap.NewContainerMap()
+	cmFirst.Add("pod-first", "app", "cid-first")
+	RecordStateReset(ManagerMemory, dir, "memory_manager_state",
+		[]ContainerRef{{PodUID: "pod-first", ContainerName: "app"}}, errors.New("machine state differs"))
+	StopVictims(context.Background(), Deps{Runtime: failing})
+
+	// A later kubelet start heals again, this time without trouble.
+	healthy := apitest.NewFakeRuntimeService()
+	healthy.Containers = map[string]*apitest.FakeContainer{
+		"cid-second": fakeContainerForPod("cid-second", "pod-second", "second", "ns", runtimeapi.ContainerState_CONTAINER_RUNNING),
+	}
+	cmSecond := containermap.NewContainerMap()
+	cmSecond.Add("pod-second", "app", "cid-second")
+	RecordStateReset(ManagerCPU, dir, "cpu_manager_state",
+		[]ContainerRef{{PodUID: "pod-second", ContainerName: "app"}}, errors.New("topology changed"))
+	StopVictims(context.Background(), Deps{Runtime: healthy})
+
+	marker := readMarker(t, dir)
+	if len(marker.Resets) != 2 {
+		t.Fatalf("marker holds %d resets, want 2 - the unconsumed one must survive: %+v", len(marker.Resets), marker.Resets)
+	}
+	if marker.Resets[0].Manager != ManagerMemory || marker.Resets[0].Victims[0].Error == "" {
+		t.Errorf("first reset: got %+v, want the carried-forward memory reset with its stop failure", marker.Resets[0])
+	}
+	if marker.Resets[1].Manager != ManagerCPU {
+		t.Errorf("second reset: got %q, want %q", marker.Resets[1].Manager, ManagerCPU)
+	}
+}
+
+func TestWriteMarkerCapsCarriedHistory(t *testing.T) {
+	dir := t.TempDir()
+	var seeded []ResetRecord
+	for i := 0; i < markerHistoryLimit+5; i++ {
+		seeded = append(seeded, ResetRecord{Manager: ManagerCPU, StateFile: filepath.Join(dir, "cpu_manager_state")})
+	}
+	blob, err := json.MarshalIndent(Marker{Version: markerVersion, Resets: seeded}, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, MarkerFileName), blob, 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	writeMarker(dir, []ResetRecord{{Manager: ManagerMemory, StateFile: filepath.Join(dir, "memory_manager_state")}})
+
+	marker := readMarker(t, dir)
+	if len(marker.Resets) != markerHistoryLimit {
+		t.Fatalf("marker holds %d resets, want the cap of %d", len(marker.Resets), markerHistoryLimit)
+	}
+	if last := marker.Resets[len(marker.Resets)-1]; last.Manager != ManagerMemory {
+		t.Errorf("newest reset: got %q, want %q - the newest must never be dropped", last.Manager, ManagerMemory)
+	}
+}
