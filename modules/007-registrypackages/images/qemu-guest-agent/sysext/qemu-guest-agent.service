# The QEMU guest agent, so the hypervisor can ask this node to shut down, read
# its addresses, freeze its filesystems for a snapshot and set its clock after
# a restore.
#
# Deliberately without a single Condition, ConditionVirtualization included.
# nodelet starts every unit it finds in an extension and treats a unit systemd
# skipped over an unmet condition as "pending"; a pass whose errors are all
# pending rolls the published generation back to the last successful one
# (internal/reconcile/loop.go). On a bare-metal node the condition would never
# be met, appliedGeneration would never move, and a rollout would stop at the
# first such node. So the unit always runs and always succeeds, and the script
# decides whether there is anything to start.
[Unit]
Description=QEMU Guest Agent
# Ordering, not a requirement: on bare metal this device unit does not exist,
# and After does not ask for it.
After=dev-virtio\x2dports-org.qemu.guest_agent.0.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/deckhouse-engine/qemu-ga-launch

[Install]
WantedBy=node.target
