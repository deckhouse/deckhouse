  "version": 1,
  "statements": [
    {
      "vulnerability": {
        "name": "CVE-2025-47911"
      },
      "products": [
        {"@id": "pkg:golang/golang.org/x/net@v0.42.0"}
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Квадратичная сложность разбора в golang.org/x/net/html. yq v4.47.1 импортирует из модуля golang.org/x/net единственный пакет html/charset и использует из него только charset.NewReaderLabel в качестве CharsetReader для encoding/xml; путь до парсера (charset.NewReader -> prescan -> html.NewTokenizer) не вызывается, и в поставляемом бинаре /usr/bin/yq из пакета golang.org/x/net/html присутствует только html.init. На узлах yq запускается из bashible для чтения TOML-конфигурации containerd (yq -ptoml -oy) и HTML не разбирает.",
      "timestamp": "2026-09-14T08:32:44Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2025-58190"
      },
      "products": [
        {"@id": "pkg:golang/golang.org/x/net@v0.42.0"}
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Зацикливание разбора в golang.org/x/net/html. yq v4.47.1 импортирует из модуля golang.org/x/net единственный пакет html/charset и использует из него только charset.NewReaderLabel в качестве CharsetReader для encoding/xml; путь до парсера (charset.NewReader -> prescan -> html.NewTokenizer) не вызывается, и в поставляемом бинаре /usr/bin/yq из пакета golang.org/x/net/html присутствует только html.init. На узлах yq запускается из bashible для чтения TOML-конфигурации containerd (yq -ptoml -oy) и HTML не разбирает.",
      "timestamp": "2026-09-14T08:32:44Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-25680"
      },
