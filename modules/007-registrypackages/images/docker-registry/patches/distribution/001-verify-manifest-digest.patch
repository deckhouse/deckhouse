+	byDigest := digestOrTag == ""
 	if digestOrTag == "" {
 		digestOrTag = dgst.String()
 		ref, err = reference.WithDigest(ms.name, dgst)
@@ -502,6 +504,24 @@ func (ms *manifests) Get(ctx context.Context, dgst digest.Digest, options ...dis
 		if err != nil {
 			return nil, err
 		}
+		// GHSA-685w-q87j-wqw3: content fetched by digest must hash to that digest.
+		// A schema1 digest covers the payload without signatures.
+		if byDigest {
+			content := body
+			if sm, ok := m.(*schema1.SignedManifest); ok {
+				content = sm.Canonical
+			}
+			if err := dgst.Validate(); err != nil {
+				return nil, err
+			}
+			verifier := dgst.Verifier()
+			if _, err := verifier.Write(content); err != nil {
+				return nil, err
+			}
+			if !verifier.Verified() {
+				return nil, fmt.Errorf("manifest digest mismatch: requested %s but received content does not match", dgst)
+			}
+		}
 		return m, nil
 	}
 	return nil, HandleErrorResponse(resp)
