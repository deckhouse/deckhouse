 }
+
+// TestManifestFetchByDigestVerifies is a regression test for GHSA-685w-q87j-wqw3:
+// content returned for a digest-pinned manifest must hash to that digest,
+// even when the server forges the Docker-Content-Digest header.
+func TestManifestFetchByDigestVerifies(t *testing.T) {
+	ctx := context.Background()
+	repo, _ := reference.WithName("test.example.com/repo")
+	_, pinnedDgst, _ := newRandomSchemaV1Manifest(repo, "latest", 6)
+	evil, _, _ := newRandomSchemaV1Manifest(repo, "latest", 6)
+	_, evilPayload, err := evil.Payload()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var m testutil.RequestResponseMap
+	m = append(m, testutil.RequestResponseMapping{
+		Request: testutil.Request{
+			Method: "GET",
+			Route:  "/v2/" + repo.Name() + "/manifests/" + pinnedDgst.String(),
+		},
+		Response: testutil.Response{
+			StatusCode: http.StatusOK,
+			Body:       evilPayload,
+			Headers: http.Header(map[string][]string{
+				"Content-Length":        {fmt.Sprint(len(evilPayload))},
+				"Last-Modified":         {time.Now().Add(-1 * time.Second).Format(time.ANSIC)},
+				"Content-Type":          {schema1.MediaTypeSignedManifest},
+				"Docker-Content-Digest": {pinnedDgst.String()},
+			}),
+		},
+	})
+
+	e, c := testServer(m)
+	defer c()
+
+	r, err := NewRepository(repo, e, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ms, err := r.Manifests(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := ms.Get(ctx, pinnedDgst); err == nil {
+		t.Fatal("expected digest mismatch error, but Get accepted substituted content")
+	}
+}
