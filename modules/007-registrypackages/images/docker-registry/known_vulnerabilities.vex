  "author": "Deckhouse <contact@deckhouse.io>",
  "version": 2,
  "statements": [
    {
      "vulnerability": {
        "@id": "https://pkg.go.dev/vuln/GO-2026-5932",
        "description": "The golang.org/x/crypto/openpgp package is unmaintained, unsafe by design, and has known security issues that will not be fixed.",
        "name": "GO-2026-5932"
      },
      "products": [
        {
          "@id": "pkg:golang/golang.org/x/crypto"
        },
        {
          "@id": "pkg:golang/golang.org/x/crypto@v0.55.0"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "GO-2026-5932 affects unmaintained golang.org/x/crypto/openpgp with no fixed version. The auth_server binary resolves only acme, bcrypt, blowfish, chacha20, chacha20poly1305, cryptobyte, hkdf, ocsp, pbkdf2 and scrypt from x/crypto; openpgp is not in its build graph and is neither imported nor executed.",
      "timestamp": "2026-08-31T08:43:21Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-85747",
        "aliases": [
          "GHSA-685w-q87j-wqw3"
        ]
      },
      "products": [
        {
          "@id": "pkg:golang/github.com/docker/distribution@v2.8.2-beta.1+incompatible"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_present",
      "impact_statement": "CVE-2026-85747 относится к пакету github.com/docker/distribution/registry/client: функция (*manifests).Get не сверяет полученный манифест с запрошенным дайджестом, а прокси registry/proxy может раздавать подменённый манифест из кэша. auth_server (cesanta/docker_auth) импортирует из модуля только пакет registry/auth/token и его зависимости registry/auth, context и uuid. Пакетов registry/client и registry/proxy в бинарнике auth_server нет, это показывает go list -deps. Исправление вышло только в модуле distribution/v3, для v2 исправленной версии нет.",
      "timestamp": "2026-11-10T07:17:46Z"
    }
  ],
  "timestamp": "2026-08-31T08:43:21Z",
  "last_updated": "2026-11-10T07:17:46Z"
}
