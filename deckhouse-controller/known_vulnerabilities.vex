    {
      "vulnerability": {
        "name": "CVE-2026-81871"
      },
      "products": [
        {
          "@id": "pkg:golang/go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc@v0.19.0"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "otlploggrpc v0.19.0 попадает в deckhouse-controller транзитивно через dhctl/pkg/telemetry (deckhouse-controller/internal/dhctlcli → dhctl/pkg/telemetry), из которого контроллер использует только telemetry.SpanFromContext. OTLP-экспортер логов создаётся исключительно в telemetry.Bootstrap, которая вызывается только из точки входа бинаря dhctl (dhctl/cmd/dhctl/main.go) и дополнительно требует переменную DHCTL_TRACE. В deckhouse-controller otlploggrpc.New не вызывается, gRPC-соединение с коллектором логов не устанавливается, переменные OTEL_EXPORTER_OTLP_*CERTIFICATE не читаются — уязвимый код не в пути выполнения. Исправление в v0.21.0 требует go.opentelemetry.io/otel/log v0.21.0 с несовместимым API, под который не собирается github.com/090809/oteljsonl v0.0.2.",
      "timestamp": "2026-10-02T12:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-81872"
      },
      "products": [
        {
          "@id": "pkg:golang/go.opentelemetry.io/otel/sdk/log@v0.19.0"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "go.opentelemetry.io/otel/sdk/log v0.19.0 попадает в deckhouse-controller транзитивно через dhctl/pkg/telemetry (deckhouse-controller/internal/dhctlcli → dhctl/pkg/telemetry), из которого контроллер использует только telemetry.SpanFromContext. LoggerProvider с BatchProcessor создаётся исключительно в telemetry.Bootstrap, которая вызывается только из точки входа бинаря dhctl (dhctl/cmd/dhctl/main.go) и дополнительно требует переменную DHCTL_TRACE. В deckhouse-controller BatchProcessor не создаётся и логи через OTel SDK не экспортируются — уязвимый цикл опроса буфера не в пути выполнения. Исправление в v0.21.0 требует go.opentelemetry.io/otel/log v0.21.0 с несовместимым API, под который не собирается github.com/090809/oteljsonl v0.0.2.",
      "timestamp": "2026-10-02T12:00:00Z"
